!img/sea_monkeys.png

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# SLURM job files
*.sbatch
!scripts/sbatch/*.sbatch
slurm-*.out

# Temporary files
*.tmp
*.temp
.cache/

