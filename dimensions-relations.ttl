@prefix meme: <http://example.org/meme#> .
@prefix rel: <http://example.org/relation#> .


# ========================================
# CORE DIMENSIONS - Meme frame
# ========================================

meme:Meme meme:hasVisualMaterial meme:VisualMaterial .
meme:Meme meme:hasTextualMaterial meme:TextualMaterial .
meme:Meme meme:hasBackgroundKnowledge meme:BackgroundKnowledge .
meme:Meme meme:hasScene meme:Scene .
meme:Meme meme:hasEmotion meme:Emotion .
meme:Meme meme:hasMetadata meme:Metadata .
meme:Meme meme:hasAnalogicalMapping meme:AnalogicalMapping .
meme:Meme meme:hasOverallIntent meme:OverallIntent .
meme:Meme meme:hasSemioticInterpretation meme:SemioticInterpretation .
meme:Meme meme:hasTargetCommunity meme:TargetCommunity .
meme:Meme meme:hasTemplateStructure meme:TemplateStructure .
meme:Meme meme:hasToxicity meme:Toxicity .
meme:Meme meme:hasColorComposition meme:ColorComposition .


# ========================================
# CORE DIMENSIONS - Foundation
# ========================================

# VisualMaterial relations
meme:VisualMaterial rel:visualComponentOf meme:Meme .
#meme:VisualMaterial rel:requiresInterpretationBy meme:BackgroundKnowledge .
meme:VisualMaterial rel:roleOf meme:Scene .
#meme:VisualMaterial rel:mapsOnto meme:TextualMaterial .
meme:VisualMaterial rel:hasColor meme:Color .

# TextualMaterial relations
meme:TextualMaterial rel:textualComponentOf meme:Meme .
#meme:TextualMaterial rel:requiresInterpretationBy meme:BackgroundKnowledge .
#meme:TextualMaterial rel:references meme:Scene .
#meme:TextualMaterial rel:mapsOnto meme:VisualMaterial .

# BackgroundKnowledge relations
meme:BackgroundKnowledge rel:referredIn meme:VisualMaterial . # example: "the image of Bill Cosby"
meme:BackgroundKnowledge rel:referredIn meme:TextualMaterial . # example: "the text 'when you see Bill Cosby'"
meme:BackgroundKnowledge rel:referredIn meme:Scene . # example: "a man telling another man <<try this bat meat, what could go wrong?>> --> ref to Covid-19"
#meme:BackgroundKnowledge rel:contextualizes meme:AnalogicalMapping .

# Scene relations
meme:Scene rel:hasRole meme:VisualMaterial . # example: "distracted boyfriend situation hasRole boyfriend"
meme:Scene rel:augmentedBy meme:TextualMaterial . # example: "distracted boyfriend situation augmentedBy text <<when you're a Linux user and you see a new distro>>"
meme:Scene rel:refersTo meme:BackgroundKnowledge . # example: Lego reproduction of an existing meme template, or some real-world event happened in the past
meme:Scene rel:expressorOf meme:Emotion . # example: "distracted boyfriend situation expressorOf <<concern>>"

# ========================================
# CORE TO ADDITIONAL DIMENSIONS
# ========================================

# VisualMaterial to Additional
meme:VisualMaterial rel:hasColor meme:Color .
meme:VisualMaterial rel:expresses meme:Emotion .
meme:VisualMaterial rel:roleOf meme:AnalogicalMapping .
meme:VisualMaterial rel:projectionOf meme:SemioticInterpretation .
meme:VisualMaterial rel:instantiates meme:TemplateStructure .
meme:VisualMaterial rel:mayContribute meme:Toxicity .

# TextualMaterial to Additional
meme:TextualMaterial rel:roleOf meme:AnalogicalMapping .
meme:TextualMaterial rel:reveals meme:OverallIntent .
meme:TextualMaterial rel:projectionOf meme:SemioticInterpretation .
meme:TextualMaterial rel:identifiesTarget meme:TargetCommunity .
meme:TextualMaterial rel:mayContribute meme:Toxicity .
meme:TextualMaterial rel:complements meme:Emotion .

# BackgroundKnowledge to Additional
meme:BackgroundKnowledge rel:necessaryFor meme:AnalogicalMapping .
meme:BackgroundKnowledge rel:revealsIntent meme:OverallIntent .
meme:BackgroundKnowledge rel:enablesInterpretation meme:SemioticInterpretation .
meme:BackgroundKnowledge rel:identifiesAudience meme:TargetCommunity .
meme:BackgroundKnowledge rel:recognizes meme:TemplateStructure .
meme:BackgroundKnowledge rel:assessesContext meme:Toxicity .

# Scene to Additional
meme:Scene rel:expresses meme:Emotion .
meme:Scene rel:settingFor meme:AnalogicalMapping .
meme:Scene rel:supportsInterpretation meme:SemioticInterpretation .
meme:Scene rel:conformsTo meme:TemplateStructure .

# ========================================
# ADDITIONAL DIMENSION INTER-RELATIONS
# ========================================

# ColorComposition relations
meme:ColorComposition rel:derivedFrom meme:VisualMaterial .
meme:ColorComposition rel:influences meme:Emotion .
meme:ColorComposition rel:constrainedBy meme:TemplateStructure .
meme:ColorComposition rel:contributesTo meme:SemioticInterpretation .
meme:ColorComposition rel:includesColor meme:Color .

# Emotion relations
meme:Emotion rel:expressedsThrough meme:VisualMaterial .
meme:Emotion rel:reinforcedBy meme:TextualMaterial .
meme:Emotion rel:modulatedBy meme:ColorComposition .
meme:Emotion rel:derivedFrom meme:Scene .
meme:Emotion rel:indicatesIntent meme:OverallIntent .
meme:Emotion rel:shapesInterpretation meme:SemioticInterpretation .
meme:Emotion rel:contributes meme:Toxicity .

# Metadata relations
meme:Metadata rel:providesContext meme:OverallIntent .
meme:Metadata rel:identifiesAudience meme:TargetCommunity .
meme:Metadata rel:influences meme:SemioticInterpretation .
meme:Metadata rel:augments meme:Toxicity .
meme:Metadata rel:preservesOrigin meme:TemplateStructure .
meme:Metadata rel:supplementsUnderstanding meme:BackgroundKnowledge .

# AnalogicalMapping relations
meme:AnalogicalMapping rel:hasRole meme:VisualMaterial .
meme:AnalogicalMapping rel:hasRole meme:TextualMaterial .
#meme:AnalogicalMapping rel:requiresUnderstanding meme:BackgroundKnowledge .
meme:AnalogicalMapping rel:groundedIn meme:Scene .
meme:AnalogicalMapping rel:expresses meme:OverallIntent .
meme:AnalogicalMapping rel:enablesProjection meme:SemioticInterpretation .
meme:AnalogicalMapping rel:typical meme:TemplateStructure .

# OverallIntent relations
meme:OverallIntent rel:expressedThrough meme:TextualMaterial .
meme:OverallIntent rel:expressedThrough meme:VisualMaterial .
meme:OverallIntent rel:revealedBy meme:AnalogicalMapping .
meme:OverallIntent rel:decodedUsing meme:BackgroundKnowledge .
meme:OverallIntent rel:manifestedIn meme:Emotion .
meme:OverallIntent rel:directed meme:TargetCommunity .
meme:OverallIntent rel:determines meme:Toxicity .
meme:OverallIntent rel:influencedBy meme:Metadata .

# SemioticInterpretation relations
meme:SemioticInterpretation rel:projectsOnto meme:VisualMaterial .
meme:SemioticInterpretation rel:projectsOnto meme:TextualMaterial .
meme:SemioticInterpretation rel:shapedBy meme:BackgroundKnowledge .
meme:SemioticInterpretation rel:influencedBy meme:Emotion .
meme:SemioticInterpretation rel:enabledBy meme:AnalogicalMapping .
meme:SemioticInterpretation rel:variesBy meme:TargetCommunity .
meme:SemioticInterpretation rel:contextualizedBy meme:Metadata .
meme:SemioticInterpretation rel:affects meme:Toxicity .

# TargetCommunity relations
meme:TargetCommunity rel:identifiedThrough meme:TextualMaterial .
meme:TargetCommunity rel:identifiedThrough meme:BackgroundKnowledge .
meme:TargetCommunity rel:targetedBy meme:OverallIntent .
meme:TargetCommunity rel:sharesUnderstanding meme:TemplateStructure .
meme:TargetCommunity rel:interpretsUsing meme:SemioticInterpretation .
meme:TargetCommunity rel:identifiedIn meme:Metadata .
meme:TargetCommunity rel:affectedBy meme:Toxicity .

# TemplateStructure relations
meme:TemplateStructure rel:manifestedIn meme:VisualMaterial .
meme:TemplateStructure rel:constrains meme:TextualMaterial .
meme:TemplateStructure rel:recognizedThrough meme:BackgroundKnowledge .
meme:TemplateStructure rel:defines meme:Scene .
meme:TemplateStructure rel:prescribes meme:ColorComposition .
meme:TemplateStructure rel:structures meme:AnalogicalMapping .
meme:TemplateStructure rel:sharedWithin meme:TargetCommunity .
meme:TemplateStructure rel:documentedIn meme:Metadata .

# Toxicity relations
meme:Toxicity rel:evaluates meme:VisualMaterial .
meme:Toxicity rel:evaluates meme:TextualMaterial .
meme:Toxicity rel:dependsOn meme:BackgroundKnowledge .
meme:Toxicity rel:considers meme:Emotion .
meme:Toxicity rel:assessesMapping meme:AnalogicalMapping .
meme:Toxicity rel:derivedFrom meme:OverallIntent .
meme:Toxicity rel:variesBy meme:SemioticInterpretation .
meme:Toxicity rel:considersTarget meme:TargetCommunity .
meme:Toxicity rel:informedBy meme:Metadata .