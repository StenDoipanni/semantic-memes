    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_43505a2a",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_intelligence",
      "label": "Anti-Black Stereotype: Intelligence-related slurs",
      "description": "The meme uses the text 'do you hate yourself?' and 'doubt science & established historical records?' to imply that the Black man is unintelligent or irrational, which is a direct reference to the anti-Black stereotype that Black people are less intelligent or incapable of understanding complex concepts like science or history. This stereotype is used to demean and dehumanize the individual based on his race.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3d32d208"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5614d776",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_racial_slur",
      "label": "Anti-Black Stereotype: Racial slur via phonetic mimicry",
      "description": "The top panel mocks the pronunciation of '1-800-abos-r-dum' as a racial slur by juxtaposing it with an image of a person in Native American regalia. This is a form of racial stereotyping that uses phonetic mimicry to imply that the Black man in the bottom panel is also being mocked for his race, reinforcing a hateful message. The use of 'abos-r-dum' as a slur is a real-world reference to the racial slur 'nigger' (phonetically similar to 'nigga' or 'nigger'), which is a deeply offensive and racist term.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3d32d208"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d43ef408",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_hate_self",
      "label": "Anti-Black Stereotype: 'Do you hate yourself?'",
      "description": "The text 'do you hate yourself?' is a rhetorical question used to imply that the Black man is self-hating or has low self-esteem, which is a common anti-Black stereotype. This stereotype suggests that Black people are inherently flawed or inferior, and that their struggles are due to their own internal issues rather than systemic racism or societal oppression.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3d32d208"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
