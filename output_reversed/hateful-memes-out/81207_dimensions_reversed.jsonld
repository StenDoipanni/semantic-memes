    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b5e9f0ce",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who hold or are exposed to anti-Black racist ideologies, particularly those who may benefit from or reinforce racist tropes by using historical imagery of slavery to justify present-day racial hierarchies. The meme is designed to appeal to communities that normalize or perpetuate anti-Black stereotypes, such as the belief that Black people are inherently suited only for manual labor or are biologically inferior. It targets those who may interpret the visual and textual content as a legitimate or historical justification for racialized labor assumptions, thereby reinforcing systemic racism. The audience is likely to be individuals who engage with or share content that weaponizes historical trauma to legitimize contemporary racial stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6a2a185d"
