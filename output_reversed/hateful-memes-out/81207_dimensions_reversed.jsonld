      "@id": "http://example.org/multimodal-taxonomy#dimension_8663dc43",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Textual description of historical slavery mapped onto visual depiction of enslaved labor",
      "description": "The text 'years ago slaves would be used for farming' is directly mapped onto the visual scene of enslaved people being forced to work under an overseer. The text explicitly labels the visual content as depicting a historical practice of slavery for agricultural labor, thereby anchoring the entire visual narrative within the context of the text. This mapping establishes that the visual material is being interpreted as an illustration of the textual claim, reinforcing the stereotype that Black people were historically and inherently suited only for manual labor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6a2a185d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_59176a55",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the historical scene of enslaved labor",
      "description": "The user is projected onto the visual scene of forced labor, where the viewer is implicitly positioned as an observer of historical oppression. The meme does not use explicit deictic pronouns like 'you' or 'me', but the framing of the image and the text 'years ago slaves would be used for farming' invites the user to mentally inhabit the perspective of someone who is either perpetuating or reflecting on this historical narrative. The user is thus projected onto the 'forced_labor_scene' as a passive witness or participant in the dehumanizing portrayal of Black people as inherently suited for manual labor. This projection reinforces the racist stereotypes embedded in the visual and textual material.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6a2a185d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
