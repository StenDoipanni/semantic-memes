    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0b3b56a8",
      "@type": "BackgroundKnowledge",
      "instance_name": "Holocaust",
      "label": "Holocaust",
      "description": "The systematic, state-sponsored persecution and murder of six million Jews by Nazi Germany and its collaborators during World War II. It is also known as the Shoah. The Holocaust is one of the most horrific genocides in human history.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ad375b0d"
