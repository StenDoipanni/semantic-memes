    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_26f67ecd",
      "@type": "BackgroundKnowledge",
      "instance_name": "World_War_II",
      "label": "World War II",
      "description": "A global conflict that lasted from 1939 to 1945, involving most of the world's nations. It was primarily fought between the Allied Powers and the Axis Powers, led by Nazi Germany under Adolf Hitler. The war resulted in unprecedented destruction and loss of life, including the Holocaust.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ad375b0d"
