    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4cbc1033",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Hitler is not a hero (as implied by the text)",
      "description": "The text 'not all heroes wear capes' is used sarcastically to imply that Adolf Hitler, depicted in the visual material, is not a hero. The meme maps the concept of 'hero' (as represented by the superhero trope) onto Hitler, who is visually presented as a public speaker in a Nazi uniform, thereby creating an analogical mapping where Hitler is contrasted with the heroic archetype. The text explicitly denies Hitler's hero status, projecting the textual concept of 'hero' onto the visual entity of Hitler to create irony.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ad375b0d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b8e63ab3",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material to interpret the ironic message",
      "description": "The user is projected onto the textual material 'not all heroes wear capes' to understand the sarcastic commentary that Hitler is not a hero. The text explicitly denies Hitler's hero status, and the user is expected to interpret this irony as part of the meme's meaning.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ad375b0d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d5b62232",
