    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c9face7c",
      "@type": "BackgroundKnowledge",
      "instance_name": "Adolf_Hitler",
      "label": "Adolf Hitler",
      "description": "Historical figure who was the dictator of Nazi Germany from 1933 until his death in 1945. He is responsible for initiating World War II and orchestrating the Holocaust, the systematic genocide of six million Jews and millions of others, including Roma, disabled people, and others. His public speeches and Nazi salutes were central to his propaganda machine.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ad375b0d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3782858a",
      "@type": "BackgroundKnowledge",
      "instance_name": "Nazi_Salute",
      "label": "Nazi Salute",
      "description": "A gesture of greeting or respect used by members of the Nazi Party and its supporters. It involves raising the right arm with the palm facing forward. It is universally recognized as a symbol of fascism and totalitarianism, and is associated with the atrocities committed under Hitler's regime.",
      "belongsToAnalysis": {
