      "@type": "BackgroundKnowledge",
      "instance_name": "white_supremacist_ideology",
      "label": "White Supremacist Ideology",
      "description": "A belief system that promotes the superiority of the white race and seeks to maintain or establish white dominance over other racial groups. The meme's claim that the South African flag represents 'white genocide' is a common trope used by white supremacist groups to incite fear and hatred against white South Africans, often as a way to justify their own racist agendas.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4957aef4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
