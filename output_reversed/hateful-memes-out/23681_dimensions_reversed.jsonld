    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6f0dcd7c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The flag is mapped as representing 'white genocide'",
      "description": "The textual claim 'this flag represents white genocide' is directly overlaid on the visual material (the South African national flag), creating an analogical mapping where the flag is being explicitly identified as symbolizing 'white genocide'. This is a false and hateful assertion, and the mapping is between the text and the visual flag, projecting the meaning of the text onto the flag.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4957aef4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f8b97bd5",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the hateful textual claim",
      "description": "The user is projected onto the textual material 'white genocide' overlaid on the South African flag, as the meme's overall intent is to incite racial hatred by falsely attributing genocidal intent to the national symbol. The user is implicitly positioned as the one who must understand or accept this false narrative, even though the text does not contain explicit deictic pronouns like 'you' or 'me'. The projection is onto the textual material because the hateful message is the core semiotic element being communicated and internalized by the viewer.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4957aef4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
