      "@type": "BackgroundKnowledge",
      "instance_name": "genocide",
      "label": "Genocide",
      "description": "The deliberate and systematic destruction, in whole or in part, of an ethnic, racial, religious, or national group. The term 'genocide' is used in the meme to falsely imply that the South African flag represents a genocidal intent against white South Africans, which is a gross distortion of historical facts and a form of hate speech.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4957aef4"
      },
      "extractionMethod": "llm_extraction_huggingface"
