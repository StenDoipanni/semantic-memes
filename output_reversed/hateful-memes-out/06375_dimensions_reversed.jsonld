    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2c6b2abb",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Peace blessing ritual mapped to the concept of peace",
      "description": "The text 'we have peace' is directly mapped onto the visual of the priest performing a peace blessing, implying that the ritual symbolizes or represents peace. The priest's solemn gesture and the religious context reinforce this mapping.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_78778c25"
