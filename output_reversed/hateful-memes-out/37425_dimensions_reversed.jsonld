    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cf571649",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Michelle Obama is mapped onto the monkey",
      "description": "The text 'clint eastwood and michelle obama' explicitly names Michelle Obama, who is a Black woman. The visual material shows a monkey being held by a man. The meme uses this juxtaposition to map Michelle Obama onto the monkey, invoking the racist stereotype of equating Black people with primates. This mapping is central to the meme's hateful intent, as it dehumanizes Michelle Obama by associating her with an animal.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_63d4b723"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_90b3200e",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the racist stereotype being enacted in the meme",
      "description": "The user is not explicitly projected onto a specific visual, textual, or scene element via deictic pronouns like 'me' or 'you'. However, the meme's hateful intent and the user's engagement with it imply a projection of the user's own perspective onto the dehumanizing act of mapping Michelle Obama onto the monkey. The user is implicitly projected onto the act of consuming and perpetuating this racist trope, which is embodied in the visual material (man holding monkey) and textual material (text_chunk: 'clint eastwood and michelle obama'). The projection is onto the entire hateful scene, where the user is positioned as a participant in the racist narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_63d4b723"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
