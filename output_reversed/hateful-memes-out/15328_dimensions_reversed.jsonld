    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ae92d0aa",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The man in distress is mapped as an example of why OSHA regulations are unnecessary in this context",
      "description": "The text 'osha is there for a reason' is mapped onto the visual of the man in distress (man_on_left) and the observer (man_in_white_shirt) in the rural setting. The meme implies that because the environment appears impoverished or non-industrial, OSHA regulations are irrelevant or unnecessary, thereby projecting the visual of the distressed man as a symbol of the supposed 'reason' OSHA exists — i.e., to address unsafe conditions — which is then mocked by suggesting such conditions are not present or are not worth regulating. This is an analogical mapping where the visual entity (man_in_distress_and_observer) is mapped onto the textual concept (osha) to create a sarcastic, racially charged argument.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0686f111"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_64c36105",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the distressed man as a symbol of unnecessary OSHA regulation",
      "description": "The user is projected onto the man in the black shirt (man_on_left) who is depicted in distress, implying that the user sees themselves as the 'reason' OSHA exists — i.e., as someone who is inherently unsafe or in need of regulation — which is then mocked by the meme's text. This projection is implicit, using the visual of the distressed man as a stand-in for the user's perceived 'dangerous' or 'unregulated' state, which the meme sarcastically claims OSHA is meant to address. The projection is onto the VisualMaterial entity 'man_on_left' and is reinforced by the textual material 'osha is there for a reason', which frames the user's identity as the 'reason' for OSHA's existence — a racially charged and demeaning projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0686f111"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
