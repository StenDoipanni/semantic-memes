    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_356455e2",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The man is mapped as the embodiment of the violent, morally corrupt 'Islam' described in the text.",
      "description": "The text explicitly states 'then islam is definitely the religion for you' in response to the hypothetical question about wanting to commit violent acts. The visual of the man with a stern, menacing expression and crossed arms is used to represent or symbolize the 'Islam' that the text claims is suitable for such individuals. This is an analogical mapping where the visual entity (the man) is projected as the textual entity (Islam) in the context of the meme's hateful message. The man's appearance and demeanor are used to visually instantiate the stereotype of Islam as violent and morally bankrupt.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_84621147"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2d81c3d9",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the textual material through the use of second-person address in the text. The text poses a hypothetical question ('want to rape, steal & murder...?') and then directly addresses the user with 'then islam is definitely the religion for you', creating an implicit 'you' that the user is meant to identify with. This projection is onto the textual material, which is the primary vehicle for the hateful message and the deictic address.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_84621147"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
