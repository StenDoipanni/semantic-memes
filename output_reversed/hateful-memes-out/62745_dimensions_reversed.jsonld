    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0df16800",
      "@type": "EmotionExpression",
      "instance_name": "happiness",
      "label": "forced happiness expression",
      "description": "The prisoners are depicted with wide smiles and raised hands, conveying an expression of joy or celebration. However, this happiness is contextually inappropriate and deeply problematic, as it is juxtaposed with the horrific reality of concentration camp imprisonment, making it appear as a forced or performative emotion rather than genuine joy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_447ab577"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fdfedb04",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'you can be happy and' is mapped onto the prisoners smiling and raising their hands.",
      "description": "The textual phrase 'you can be happy and' is juxtaposed with the visual of prisoners in striped uniforms smiling and raising their hands. This creates an analogical mapping where the text implies that the prisoners are an example of 'you' (the viewer) being happy, despite their grim context. The mapping equates the prisoners' forced or performative happiness with the universal ideal of happiness, ignoring the horrific reality of their situation. This is a harmful mapping that trivializes their suffering and promotes a form of Holocaust minimization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_447ab577"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_83f0952e",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the prisoners as an example of happiness",
      "description": "The user is projected onto the prisoners in the image, who are depicted smiling and raising their hands. The text 'you can be happy and' directly addresses the user ('you'), implying that the viewer should emulate the prisoners' happiness, despite the horrific context of their imprisonment. This projection equates the viewer with the prisoners, suggesting the viewer can adopt their demeanor as a model for happiness in any situation, which is a harmful and misleading interpretation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_447ab577"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
