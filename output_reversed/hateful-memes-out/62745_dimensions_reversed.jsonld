    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a58674f3",
      "@type": "BackgroundKnowledge",
      "instance_name": "Holocaust",
      "label": "Holocaust",
      "description": "The Holocaust was the systematic, state-sponsored persecution and murder of six million Jews by Nazi Germany and its collaborators during World War II. The image depicts prisoners in striped uniforms, characteristic of concentration camp inmates, which directly references this historical atrocity. Understanding the meme requires knowledge of the Holocaust to recognize the profound suffering and genocide depicted, which the text attempts to trivialize.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_447ab577"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dfcc3ae4",
      "@type": "BackgroundKnowledge",
      "instance_name": "Holocaust_denial_minimization_themes",
      "label": "Holocaust denial/minimization themes",
      "description": "This is a disparaging stereotype or harmful concept that involves downplaying or denying the scale and horror of the Holocaust. The meme's text, 'you can be happy and smiling in any situation,' when juxtaposed with the image of concentration camp prisoners, implicitly promotes a form of Holocaust minimization by suggesting their happiness is a virtue or coping mechanism, thereby ignoring the horrific context of their imprisonment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_447ab577"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b7b8b502",
      "@type": "BackgroundKnowledge",
      "instance_name": "Inspiration_porn_pity_narratives",
      "label": "Inspiration porn/pity narratives",
      "description": "This is a form of ableism that involves portraying people with disabilities or trauma as inspirational or heroic for enduring suffering, often to evoke pity or admiration. The meme's message of forced positivity ('you can be happy and smiling in any situation') can be seen as a form of inspiration porn, as it frames the prisoners' happiness as admirable or virtuous, rather than acknowledging the trauma and suffering they endured.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_447ab577"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2a6b53fe",
      "@type": "BackgroundKnowledge",
      "instance_name": "Concentration_camps",
      "label": "Concentration camps",
      "description": "Concentration camps were camps established by Nazi Germany during World War II to imprison, torture, and murder millions of people, primarily Jews, but also other groups deemed undesirable by the regime. The image of prisoners in striped uniforms behind barbed wire is a direct reference to these camps, which are central to understanding the historical context of the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_447ab577"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
