    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d5077038",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Hitler is mapped as a person who just met someone and is offering a number for camping",
      "description": "The text 'hey, i just met you and this is crazy but here's your number.. so camping, maybe?' is mapped onto Adolf_Hitler. The meme implies that Adolf_Hitler is the 'person' who just met someone and is offering a 'number' (a phone number) for 'camping'. This is an absurd and offensive analogical mapping that trivializes Hitler's monstrous legacy by associating him with a mundane, harmless activity. The mapping is created through the juxtaposition of the text with the visual material, where the text's casual tone and content are projected onto the image of Hitler, who is a historical figure associated with genocide and the Holocaust.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_29d63255"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aaac8c25",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material as the 'person' initiating the interaction",
      "description": "The user is projected onto the textual material ('hey, i just met you...') which frames the user as the 'person' who just met someone and is offering a number for camping. This projection is implicit through the first-person perspective of the text, which the user identifies with when viewing the meme. The user is not explicitly deictic (e.g., 'me' or 'you'), but the text's casual, conversational tone and the meme's structure create a direct identification with the speaker of the text, making the user the 'you' in the scenario. The user is projected onto the text_chunk entity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_29d63255"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
