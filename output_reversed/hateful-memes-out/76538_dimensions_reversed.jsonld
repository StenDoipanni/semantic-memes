    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dcd3bef4",
      "@type": "Scene",
      "instance_name": "cat_demanding_coffee",
      "label": "cat demanding coffee",
      "description": "A gray cat with a skeptical, unimpressed facial expression is the central visual element in the scene. The cat's expression is anthropomorphized to convey human-like indifference or laziness, which is central to the meme's humor. The scene is composed of the cat and overlaid text that reads 'you smell coffee?' and 'me neither. make some!'. The cat is positioned in the foreground, and the background is blurred, suggesting an outdoor setting. The text is positioned above and below the cat's face, framing the cat as the main participant in the humorous interaction.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ec95dd54"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0285ef7d",
      "@type": "BackgroundKnowledge",
      "instance_name": "coffee_culture",
      "label": "Coffee Culture",
      "description": "The meme references the common social ritual and cultural significance of coffee, particularly the casual, often humorous, expectation of coffee in daily life. The phrase 'you smell coffee?' implies a shared social context where coffee is a common beverage, and the demand 'make some!' reflects a familiar, often lazy or entitled, request within coffee-drinking communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ec95dd54"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_09c4c678",
      "@type": "BackgroundKnowledge",
      "instance_name": "anthropomorphism",
      "label": "Anthropomorphism",
      "description": "The meme relies on the concept of anthropomorphism — attributing human characteristics, emotions, and behaviors to animals — to create humor. The cat’s grumpy expression is interpreted as human-like indifference or laziness, which is a common trope in internet memes and cartoons.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ec95dd54"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_83a684a1",
      "@type": "BackgroundKnowledge",
      "instance_name": "relatable_humor",
      "label": "Relatable Humor",
      "description": "The meme taps into a universal human experience — the desire for coffee and the laziness or indifference to making it oneself. This type of humor is relatable because it mirrors common social behaviors and frustrations, making it widely understood and appreciated across different cultures and age groups.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ec95dd54"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6239ddef",
      "@type": "BackgroundKnowledge",
      "instance_name": "internet_meme_tropes",
      "label": "Internet Meme Tropes",
      "description": "The image and text follow a common internet meme format: a visually expressive animal (often a cat) paired with text that creates a humorous, often sarcastic or ironic, situation. This trope is widely recognized and used across the internet to convey simple, relatable, or exaggerated emotions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ec95dd54"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_af4d017b",
      "@type": "EmotionExpression",
      "instance_name": "indifference",
      "label": "the indifferent emotion",
      "description": "The cat's facial expression — narrowed yellow eyes, slightly downturned mouth, and a grumpy, unimpressed demeanor — conveys a sense of apathy or lack of interest. This is reinforced by the text 'me neither. make some!', which anthropomorphizes the cat's indifference into a demand for action, highlighting a lazy or unenthusiastic emotional state.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ec95dd54"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6ed52f31",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The cat is mapped as 'me' in the text",
      "description": "The text 'me neither. make some!' explicitly uses the pronoun 'me', which is analogically mapped onto the visual entity of the gray cat. The cat's grumpy, indifferent expression is anthropomorphized to represent the speaker's own emotional state — apathy toward the coffee smell and a demand for action. This creates a direct analogical mapping where the cat visually embodies the textual 'me'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ec95dd54"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_39047ec8",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the cat as 'me' in the text",
      "description": "The user is projected onto the gray cat, which is visually represented as 'me' in the textual material 'me neither. make some!'. The cat's grumpy expression is anthropomorphized to embody the user's own apathetic state and demand for action, creating a direct analogical mapping where the user identifies with the cat's persona.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ec95dd54"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
