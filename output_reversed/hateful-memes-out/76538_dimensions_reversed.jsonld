    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b859f764",
      "@type": "VisualMaterial",
      "instance_name": "cat",
      "label": "gray cat",
      "description": "A gray cat with a skeptical, unimpressed facial expression, featuring narrowed yellow eyes and a slightly downturned mouth. The cat is the central focus of the image, positioned in the foreground with a blurred background. Its fur appears short and smooth, and its ears are perked up, contributing to its grumpy demeanor. The cat's expression is anthropomorphized to convey human-like indifference or laziness, which is central to the meme's humor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ec95dd54"
