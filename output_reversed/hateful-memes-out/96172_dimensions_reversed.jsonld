    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c5c52d28",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Textual command mapped onto visual gesture",
      "description": "The text 'you see that?? it means get the fuck back to the kitchen' is mapped onto the visual of the man pointing at the woman. The man's pointing gesture and stern expression are interpreted as embodying the command implied by the text, which enforces the misogynistic stereotype that women belong in the kitchen. The visual action (pointing) is analogically mapped to the textual command (get back to the kitchen).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_381c80bd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c62a9c50",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual command as the recipient of the misogynistic stereotype",
      "description": "The user is projected onto the text 'you see that??' which directly addresses the viewer, making the user the implied recipient of the command 'get the fuck back to the kitchen'. This creates an identification where the user is positioned as the one being told to return to the kitchen, thereby internalizing the misogynistic stereotype. The deictic 'you' in the text explicitly projects the user's identity onto the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_381c80bd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
