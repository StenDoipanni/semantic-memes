    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ed77e32a",
      "@type": "VisualMaterial",
      "instance_name": "child",
      "label": "a young Black child",
      "description": "A small, bald Black child is holding a metal cup, looking up toward the camera. The child's expression is neutral to curious. This child is the central human subject and is visually juxtaposed with the adult and the coolant bottle, forming the core of the meme's dehumanizing metaphor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7aee73f"
