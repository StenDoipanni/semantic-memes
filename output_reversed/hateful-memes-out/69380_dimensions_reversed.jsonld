      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks Black people by equating them with malfunctioning farm equipment that requires coolant, reinforcing harmful stereotypes of inferiority and dehumanization.",
