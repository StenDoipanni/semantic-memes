    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cfae66bd",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "child is mapped as farm equipment",
      "description": "The text 'adding coolant when the farm equipment overheats' explicitly maps the visual entity 'child' onto the metaphorical entity 'farm equipment'. The child's role in the scene—being held, having coolant poured into a cup they are holding—is visually analogous to servicing machinery. This mapping is central to the meme's hateful intent, reducing the child to a tool that requires maintenance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7aee73f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_574927a8",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the child as a primitive tool requiring maintenance",
      "description": "The user is projected onto the visual material of the child, who is metaphorically equated with 'farm equipment' that overheats and requires coolant. This projection implies the user identifies with or is meant to see themselves as the child — a passive, replaceable, and inferior tool needing external intervention to function. The meme's hateful intent relies on this projection to dehumanize Black people by forcing the viewer to internalize the metaphor of being a broken machine.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7aee73f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
