    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ca528937",
      "@type": "Scene",
      "instance_name": "coolant_adding_scene",
      "label": "child_adding_coolant",
      "description": "A scene where a child is holding a metal cup while an adult pours coolant from a bottle into it, visually representing the metaphor of 'adding coolant when the farm equipment overheats'. The child is positioned centrally, looking up, while the adult's hand and the coolant bottle are above, indicating an act of maintenance or servicing. The scene is framed to emphasize the child's role as a tool or object being used for a mechanical task.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7aee73f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e2fa56a1",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_primitive_tool",
      "label": "Anti-Black Stereotype: Primitive Tool",
      "description": "The meme relies on the racist trope of equating Black people with malfunctioning farm equipment, implying they are inferior, unthinking, and only useful for labor or maintenance tasks. This stereotype dehumanizes Black individuals by reducing them to objects or tools that require constant 'cooling' or repair.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7aee73f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_51998d42",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_dehumanizing_mechanism",
      "label": "Anti-Black Stereotype: Dehumanizing Mechanism",
      "description": "The meme uses the metaphor of 'adding coolant' to a 'farm equipment' to imply that Black people are replaceable, subservient, and only valuable when performing manual labor. This is a dehumanizing mechanism that reduces human beings to mechanical parts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7aee73f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5c143952",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_inferiority_complex",
      "label": "Anti-Black Stereotype: Inferiority Complex",
      "description": "The meme reinforces the harmful stereotype that Black people are inherently inferior and incapable of independent thought or function, requiring external intervention (like coolant) to 'operate' properly. This perpetuates a systemic belief in Black inferiority.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7aee73f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2501c070",
      "@type": "BackgroundKnowledge",
      "instance_name": "farm_equipment_metaphor",
      "label": "Farm Equipment Metaphor",
      "description": "The phrase 'farm equipment overheats' is a metaphor for machinery that breaks down and requires maintenance. In the meme, this metaphor is applied to Black people, suggesting they are broken, in need of constant repair, and only useful when functioning as tools.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7aee73f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_99e0cbd6",
      "@type": "BackgroundKnowledge",
      "instance_name": "coolant_as_maintenance",
      "label": "Coolant as Maintenance",
      "description": "Coolant is a real-world substance used to regulate temperature in machinery. In the meme, its use is metaphorically extended to imply that Black people are 'maintained' or 'cooled down' by others, reinforcing their role as passive recipients of care or control.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7aee73f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
