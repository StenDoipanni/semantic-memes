    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_271d9516",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "children are mapped as child survivors of the Holocaust",
      "description": "The text 'child survivors of holocaust' explicitly identifies the visual entities (children) as survivors of the Holocaust. This is a direct analogical mapping where the textual label 'child survivors of holocaust' is projected onto the visual group of children, establishing their identity and historical context. The mapping is reinforced by the visual context of striped uniforms and barbed wire, which are iconic symbols of Holocaust concentration camps, aligning the text with the visual material.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9d9a5540"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e834ea16",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the children behind barbed wire",
      "description": "The user is projected onto the visual material of the children standing behind barbed wire. This projection occurs because the image depicts child survivors of the Holocaust, and the user, by viewing the meme, is implicitly positioned as an observer of this historical trauma. The lack of explicit deictic pronouns like 'you' or 'me' means the projection is indirect, through the act of viewing and the contextual framing of the image and text. The user is not directly addressed, but the scene and text create a powerful, immersive experience that places the viewer in a position of witnessing the suffering of the children, which can evoke emotional or moral responses. This projection is reinforced by the visual material (children in striped uniforms behind barbed wire) and the textual material ('child survivors of holocaust'), which together establish the identity and context of the subjects, making the user's perspective a central part of the meme's semiotic structure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9d9a5540"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2da3ea8f",
