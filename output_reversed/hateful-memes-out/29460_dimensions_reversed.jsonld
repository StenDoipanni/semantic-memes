    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_63ce326c",
      "@type": "VisualMaterial",
      "instance_name": "children",
      "label": "group of child survivors",
      "description": "A group of approximately 12 to 15 children, appearing to be between 5 and 15 years old, are standing behind barbed wire. They are dressed in striped prison uniforms, characteristic of concentration camp attire. Their expressions are somber and varied, ranging from stoic to fearful. The children are positioned in front of a wooden fence or wall, suggesting a confined or institutional setting. Their physical appearance and clothing indicate they are survivors of the Holocaust.",
      "belongsToAnalysis": {
