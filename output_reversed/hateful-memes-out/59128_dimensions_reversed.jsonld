    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8ff060b9",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'a head diaper is required when you have shit for brains' is mapped onto the woman (Ms. Omar) in the image.",
      "description": "The meme uses the visual of Ms. Omar, a Black woman wearing a headscarf in a formal setting, to represent the target of the insult. The text 'a head diaper is required when you have shit for brains' is an intelligence-related slur that is projected onto her, implying she is intellectually inferior. This mapping is based on the juxtaposition of the text with her image, creating a hateful and degrading association. The mapping involves the textual insult being applied to the visual entity (Ms. Omar), who is the subject of the insult. This is a clear case of analogical mapping where the text explicitly identifies or attributes a negative quality to the visual entity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_da9e6ee5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_200d95b6",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual insult",
      "description": "The user is projected onto the textual material 'a head diaper is required when you have shit for brains' as the object of the hateful projection. The text explicitly attributes the degrading quality to the visual entity (Ms. Omar), and the user, by consuming and interpreting the meme, is positioned as the one who is projecting this insult onto her. There are no explicit deictic pronouns like 'me' or 'you' in the text, but the act of viewing the meme and the hateful intent of the text create an implicit projection where the user is the one who is 'seeing' or 'imagining' the insult being applied to the target. The projection is onto the textual material, which serves as the vehicle for the hate speech.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_da9e6ee5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_09c4500e",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks Ms. Omar based on her race, gender, and religion, using vulgar and degrading language to insult her intelligence and competence. The text 'a head diaper is required when you have shit for brains' is a hateful insult targeting her cognitive abilities, which is a form of racism, ableism, and misogyny. The analogical mapping of this insult onto her image constitutes a direct attack on her identity and perceived competence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_da9e6ee5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
