      "@id": "http://example.org/multimodal-taxonomy#dimension_717df936",
      "@type": "VisualMaterial",
      "instance_name": "George_Washington",
      "label": "historical figure",
      "description": "A black-and-white engraved portrait of George Washington, the first President of the United States, depicted in 18th-century attire with a powdered wig and formal coat. The image is central to the meme and is used to juxtapose with the offensive text, creating a satirical or hateful context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5af4f566"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f7630309",
      "@type": "Scene",
      "instance_name": "hateful_text_juxtaposition",
      "label": "hateful_text_juxtaposition",
      "description": "A scene where a historical portrait of George Washington is overlaid with offensive text that uses racist and historically inaccurate analogies to justify slavery. The text falsely claims that enslaved people were made slaves because they are 'idiots' who are 'drinking beer, smoking weed, and shooting off Chinese fireworks' instead of protesting. The juxtaposition of Washington's image with this offensive text is intended to mock and insult Black people by implying they are inherently inferior and undeserving of freedom, while also misrepresenting the historical context of slavery.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5af4f566"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_70e53577",
      "@type": "BackgroundKnowledge",
      "instance_name": "racist_analogy",
      "label": "Racist Analogy Justifying Slavery",
      "description": "The meme uses a false and hateful analogy to justify slavery by claiming enslaved people were made slaves because they are 'idiots' who are 'drinking beer, smoking weed, and shooting off Chinese fireworks' instead of protesting. This is a historically inaccurate and dehumanizing trope that relies on racist stereotypes about Black people's supposed laziness, incompetence, and criminality.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5af4f566"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
