    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d21aa7f2",
      "@type": "EmotionExpression",
      "instance_name": "contempt",
      "label": "contemptuous emotion",
      "description": "The emotion expressed is contempt, conveyed through the juxtaposition of George Washington's stern, unsmiling portrait with the hateful, dehumanizing text. The text implies superiority and disdain toward the group it targets, suggesting they are unworthy of freedom due to their perceived laziness and incompetence. The visual of Washington, a symbol of American founding, is used to mock and insult, evoking a sense of scorn and superiority.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5af4f566"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2a95e94e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "George Washington is mapped as the speaker of the hateful text",
      "description": "The text 'like me you idiots...' is presented as if spoken by George Washington, who is visually depicted in the portrait. The meme uses Washington's image to represent the voice of the speaker, implying he is the one making the racist and historically inaccurate claim about enslaved people being made slaves due to their perceived laziness and incompetence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5af4f566"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f2c4ae7f",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material as the target of the hateful analogy",
      "description": "The user is projected onto the 'you' in the text, which refers to the modern audience being mocked for their perceived laziness and lack of protest. The text 'like me you idiots...' directly addresses the viewer, making them the subject of the dehumanizing comparison. The user is thus projected onto the textual material, specifically the 'you' in the text_chunk, which is the target of the racist analogy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5af4f566"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_30981270",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme uses a racist and historically inaccurate analogy to justify slavery by claiming enslaved people were made slaves because they are 'idiots' who are 'drinking beer, smoking weed, and shooting off Chinese fireworks' instead of protesting. This is a hateful meme that uses dehumanizing stereotypes and false historical justification to demean Black people, invoking racist tropes about laziness, criminality, and incompetence. The juxtaposition of Washington's image with this offensive text is intended to mock and insult Black people by implying they are inherently inferior and undeserving of freedom, while also misrepresenting the historical context of slavery.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5af4f566"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c0a2ca40",
