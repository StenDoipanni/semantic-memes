    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ebee2902",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "sheep are mapped to ISIS members at a strip club",
      "description": "The top text 'meanwhile' sets up a contrast, and the bottom text 'at the isis strip club' maps the visual of the sheep (which are being herded and shown in a line, rear ends exposed) onto the stereotype of ISIS members engaging in sexualized behavior. The sheep are visually analogous to ISIS members in this false and offensive mapping, implying that the sheep's exposed rear ends represent the 'strip club' scenario for ISIS members. This is a clear analogical mapping where the visual material (sheep) is mapped onto the textual stereotype (ISIS strip club).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab62b1af"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f05b7f92",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual stereotype of ISIS members at a strip club",
      "description": "The user is projected onto the bottom textual material 'at the isis strip club' and the associated visual material of the men in traditional attire, which together form the stereotypical scene being mocked. The meme uses this projection to imply that the user (or the viewer) is imagining or identifying with the degrading stereotype being portrayed, thereby internalizing the offensive framing. There are no explicit deictic pronouns like 'me' or 'you', but the juxtaposition and the overall intent create an implicit projection where the viewer is positioned as the one observing or participating in the mockery of the ISIS stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab62b1af"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
