    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8c1c1030",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The target community is individuals who are familiar with or sensitive to Islamophobic stereotypes, particularly those who may be exposed to or propagate derogatory portrayals of ISIS and Muslims. The meme relies on cultural references to ISIS and hypersexualization tropes, which are commonly understood within Western media contexts that perpetuate Islamophobia. The audience is likely to include people who consume internet memes, especially those that use crude humor and visual juxtaposition to mock or demean specific groups. The meme’s toxicity and reliance on false stereotypes suggest it is designed to provoke laughter or shock among those who find such dehumanizing content amusing or acceptable, often reinforcing existing prejudices against Muslims and ISIS.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab62b1af"
      },
