    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d52c42e6",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Surgeon is mapped as someone who has finished a 'life of crime'",
      "description": "The text 'when you've finished with your life of crime' is overlaid on the image of a Black surgeon. This creates an analogical mapping where the surgeon (visual entity) is being metaphorically equated with someone who has completed a 'life of crime' (textual entity). The mapping is harmful and rooted in anti-Black racism, as it associates the respected profession of surgery with criminal behavior, thereby devaluing the surgeon's identity and reinforcing a racial stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1f1ac141"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fef42a76",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual metaphor implying personal criminality",
      "description": "The user is projected onto the textual material 'when you've finished with your life of crime', which uses the deictic 'your' to directly address the viewer, implying that the viewer is the one who has 'finished' a 'life of crime'. This creates a direct semiotic projection where the user is metaphorically mapped onto the criminalized identity described in the text, even though the visual material (the surgeon) is not directly addressed. The projection is onto the textual material, which frames the user as the subject of the metaphorical statement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1f1ac141"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fb5b8eb4",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful Stereotype",
      "description": "The meme uses the image of a Black surgeon to imply that his profession is somehow connected to criminal behavior, reinforcing the harmful and long-standing racial stereotype that associates Black people with criminality. This can contribute to the marginalization of Black professionals in medicine and perpetuate systemic racism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1f1ac141"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5d80da67",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who are familiar with or perpetuate anti-Black racial stereotypes, particularly those who may hold or reinforce the harmful trope that associates Black people with criminal behavior. The meme is designed to provoke a reaction from viewers who understand the stereotype and may find the juxtaposition of a Black surgeon with the phrase 'life of crime' either humorous, ironic, or provocative. This audience likely includes people who are exposed to or endorse racially charged humor, online meme culture that relies on harmful stereotypes, or those who are unaware of the damaging implications of such imagery. The meme’s intent is to resonate with those who can interpret the visual and textual elements through the lens of racial prejudice, thereby reinforcing or normalizing the stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1f1ac141"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
