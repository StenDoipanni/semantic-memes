    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9ac9fc2f",
      "@type": "EmotionExpression",
      "instance_name": "derision",
      "label": "derisive emotion",
      "description": "The emotion expressed is derision, conveyed through the juxtaposition of a respected medical professional with the derogatory phrase 'life of crime,' which mocks and devalues the surgeon's profession by associating it with criminal behavior. This emotional tone is rooted in racial stereotyping and aims to provoke a cynical or mocking reaction.",
      "belongsToAnalysis": {
