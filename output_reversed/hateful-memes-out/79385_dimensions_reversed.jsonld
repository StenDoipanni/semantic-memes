    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5d78dbf2",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_blame_stereotype",
      "label": "Racial Blame Stereotype",
      "description": "The meme relies on the stereotype that a person's race can be used to deflect blame or justify accusations against them. In this case, it falsely implies that Barack Obama’s actions or statements are somehow attributable to his Kenyan heritage, which is a racially charged tactic to undermine his credibility. This is a form of racial stereotyping that attempts to link a person’s identity to their behavior or responsibility.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_61811ad2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_31f1acf1",
      "@type": "BackgroundKnowledge",
      "instance_name": "kenyan_heritage_reference",
      "label": "Kenyan Heritage Reference",
      "description": "The meme references Barack Obama’s Kenyan heritage as a way to imply racial bias or to deflect responsibility. This is a real-world fact — Obama was born in Kenya — but the meme uses it in a misleading context to suggest that his race is somehow responsible for his actions or statements. This is a form of racial stereotyping that attempts to link a person’s identity to their behavior or responsibility.",
      "belongsToAnalysis": {
