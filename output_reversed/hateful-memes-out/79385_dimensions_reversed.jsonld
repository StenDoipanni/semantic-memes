    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2d20fce6",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material via deictic pronouns",
      "description": "The user is projected onto the textual material through the use of deictic pronouns 'me' and 'you' implied in the meme's text. The top text 'well judge, made me do it all' projects the user as the 'me' being blamed, while the bottom text 'remember it was me who first said was kenyan' projects the user as the 'me' who made the claim about Kenyan heritage. This creates an identification of the user with the speaker (Clinton) and the accused (Obama), embedding the user into the false narrative of racial blame.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_61811ad2"
      },
      "extractionMethod": "llm_extraction_huggingface"
