    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_72342ea9",
      "@type": "BackgroundKnowledge",
      "instance_name": "stereotype_black_people_swimming_ability",
      "label": "Stereotype: Black people are natural swimmers or 'water people'",
      "description": "This stereotype, often used in a racially charged context, implies that Black people have an innate or superior ability to swim or interact with water. The meme's text 'kids enjoying some underwater diving' misrepresents the girls' activity and implicitly reinforces this stereotype, potentially exoticizing or mocking their engagement with water. This stereotype is part of a broader pattern of racialized assumptions about physical competence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_68decdc6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_da06fba2",
      "@type": "BackgroundKnowledge",
      "instance_name": "concept_underwater_diving",
      "label": "Concept: Underwater diving as a specific activity",
      "description": "Underwater diving is a structured, often technical activity requiring specialized equipment (like scuba gear) and training. The meme falsely equates casual swimming or playing in shallow water with 'underwater diving,' which is a key element of the meme's irony and misleading intent. This conceptual mismatch is central to understanding the meme's humor and its potential harmful implications.",
      "belongsToAnalysis": {
