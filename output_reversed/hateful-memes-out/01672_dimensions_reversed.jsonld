      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fbb531bb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cbce551e",
      "@type": "TextualMaterial",
