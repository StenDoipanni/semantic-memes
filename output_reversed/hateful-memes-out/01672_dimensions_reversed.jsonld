    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d54d61df",
      "@type": "BackgroundKnowledge",
      "instance_name": "call_of_duty",
      "label": "Call of Duty",
      "description": "A popular first-person shooter video game franchise developed by Infinity Ward, Treyarch, and Sledgehammer Games, published by Activision. The franchise is known for its military-themed gameplay, large-scale multiplayer modes, and annual releases that generate significant hype and player anticipation. The meme references the release of a new installment, implying the player's eagerness or frustration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fbb531bb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6f77fed6",
      "@type": "BackgroundKnowledge",
      "instance_name": "camping",
      "label": "Gaming term: Camping",
      "description": "In video games, particularly first-person shooters like Call of Duty, 'camping' refers to a gameplay tactic where a player remains stationary in one location, often with a weapon aimed outward, to ambush or attack opponents who pass by. It is often seen as a defensive or aggressive strategy, and the term is used humorously here to imply the player is already deeply engaged in this behavior when a new game is released.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fbb531bb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6a665b80",
      "@type": "BackgroundKnowledge",
      "instance_name": "gaming_culture",
      "label": "Gaming Culture",
      "description": "The collective behaviors, norms, and practices of video game players, including community interactions, in-game strategies, and reactions to game releases. The meme relies on shared understanding within gaming culture, particularly among first-person shooter enthusiasts, to convey humor about anticipation and immersion in gameplay.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fbb531bb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eb4ca416",
      "@type": "BackgroundKnowledge",
      "instance_name": "first_person_shooter",
      "label": "First-Person Shooter (FPS) Genre",
      "description": "A video game genre where the player views the game world through the eyes of the character, typically holding a weapon. FPS games like Call of Duty emphasize combat, aiming, and strategy, making them a natural fit for the visual metaphor of aiming a rifle out a window.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fbb531bb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_be43ca91",
      "@type": "BackgroundKnowledge",
      "instance_name": "video_game_release_hype",
      "label": "Video Game Release Hype",
      "description": "The intense excitement and anticipation generated by the announcement or release of a major video game, especially in franchises with large fanbases like Call of Duty. This phenomenon drives player behavior, including pre-ordering, streaming, and immediate gameplay, which the meme humorously exaggerates.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fbb531bb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c8617ed4",
      "@type": "EmotionExpression",
      "instance_name": "anticipation",
      "label": "the anticipatory emotion",
      "description": "The person's focused posture and the act of aiming the rifle out the window, combined with the text about eagerly waiting for a new Call of Duty release, convey a strong sense of eager anticipation. The visual and textual elements together express excitement and readiness for the upcoming game.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fbb531bb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a1beee34",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The gamer's readiness to play is mapped to the person aiming the rifle.",
      "description": "The text 'when the new call of duty comes out and you're already camping' describes a gamer's state of being deeply immersed in the game (camping) upon the release of a new Call of Duty. The visual of the person aiming a rifle out the window is mapped to this state, symbolizing the gamer's focused, anticipatory, and ready-to-engage posture. The act of aiming the weapon visually represents the gamer's mental state of being 'camped out' and prepared to play immediately.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fbb531bb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_64d721df",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of aiming out the window",
      "description": "The user is projected onto the visual scene of the person aiming a rifle out of the window, as the text 'when the new call of duty comes out and you're already camping' uses 'you' to directly address the viewer, implying the user is the gamer who is already 'camping' in anticipation of the new game release. The visual of aiming the weapon is mapped to the user's mental state of readiness and immersion in gaming culture.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fbb531bb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_046508e6",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "gaming_culture",
      "description": "The meme is designed for the gaming community, specifically fans of first-person shooters like Call of Duty. The humor relies on shared cultural knowledge of gaming terms such as 'camping' and the intense hype surrounding major game releases. The visual metaphor of aiming a rifle out a window directly maps to the gamer's state of readiness and immersion in the game, making it relatable to those familiar with FPS gameplay and community behaviors.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fbb531bb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
