      "instance_name": "emotional_manipulation",
      "label": "Emotional Manipulation",
      "description": "A rhetorical or psychological technique that uses emotional appeals (such as fear, pity, or outrage) to influence attitudes or behaviors. The meme manipulates viewers’ emotions by juxtaposing a child’s innocence with the threat of a firearm, aiming to sway public opinion toward gun control.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bddd2d18"
