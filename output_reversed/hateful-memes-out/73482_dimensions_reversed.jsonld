    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d9bc3096",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Child is mapped as the target of gun control policy",
      "description": "The text 'put them out of the reach of our children' explicitly maps the visual entity 'child' as the intended beneficiary or protected party of the gun control policy. The child holding the gun is analogically mapped as the 'child' referenced in the text, symbolizing the need to protect children from firearms. This mapping is central to the meme's propagandistic intent, using the visual of a child with a gun to represent the danger that gun control aims to mitigate.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bddd2d18"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_24af6237",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the child holding the gun as the target of gun control policy",
      "description": "The user is projected onto the visual entity 'child' (the young girl holding the gun) as the intended beneficiary of the gun control policy. The text 'put them out of the reach of our children' implicitly addresses the viewer ('you') as the guardian or parent responsible for protecting children, thereby projecting the user's role onto the child in the image. The child is the focal point of the emotional appeal and the policy target, making the user feel personally responsible for the child's safety and thus aligned with the meme's call to action.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bddd2d18"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
