      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5f93b937",
      "@type": "VisualMaterial",
      "instance_name": "Michelle_Obama",
      "label": "person",
      "description": "A woman with dark skin, wearing a black dress and pearl necklace, smiling at the camera. She is seated in an ornate chair, with her hands clasped. This is a recognizable portrait of former First Lady Michelle Obama. The image is used in the meme to represent a high-profile Black woman, juxtaposed with a degrading comparison.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_025eb6ee"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3f64f2d2",
      "@type": "Scene",
      "instance_name": "juxtaposed_comparison_scene",
      "label": "juxtaposed_comparison_scene",
      "description": "A scene that juxtaposes a portrait of Michelle Obama with an image of a person wearing a primate mask, both labeled with salary comparisons for personal stylist and makeup artist roles. The bottom text reads 'i can't tell the difference,' implying that Michelle Obama is indistinguishable from a monkey. This visual and textual combination is a direct and offensive racial stereotype, specifically comparing Black people to primates, which is a well-documented form of anti-Black racism. The intent is to demean Michelle Obama and, by extension, Black people, by suggesting her appearance is so 'animal-like' that she is indistinguishable from a primate, thereby dehumanizing her and reinforcing harmful racist tropes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_025eb6ee"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e1c371b7",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_primate_comparison",
      "label": "Anti-Black Stereotype: Comparing Black People to Primates",
      "description": "A well-documented and deeply harmful racial stereotype that dehumanizes Black individuals by likening them to animals, particularly primates. This trope has historical roots in slavery and colonialism and is used to justify discrimination, violence, and systemic racism. In this meme, the juxtaposition of Michelle Obama with a primate mask and the text 'i can't tell the difference' explicitly invokes this stereotype to demean her and, by extension, all Black people.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_025eb6ee"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_997d5d19",
      "@type": "BackgroundKnowledge",
      "instance_name": "michelle_obama",
      "label": "Michelle Obama",
      "description": "Former First Lady of the United States, known for her public persona, advocacy work, and high-profile appearance. She is a prominent Black woman in American politics and culture. The meme uses her image to target a specific high-profile Black individual, making the racial stereotype more personal and impactful.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_025eb6ee"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ef22ebb4",
      "@type": "BackgroundKnowledge",
      "instance_name": "salary_comparison_context",
      "label": "Salary Comparison Context",
      "description": "The text overlay 'personal stylist $15,000 / week makeup artist $4,000 / month' is a fabricated or exaggerated comparison designed to create a false equivalence. It is not a factual representation of industry standards but is used as a rhetorical device to imply that Michelle Obama's appearance is 'worth' less than a white person's, thereby reinforcing the dehumanizing message. This requires knowledge of wage disparities and racialized labor value assumptions in society.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_025eb6ee"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_35c3bb11",
      "@type": "BackgroundKnowledge",
      "instance_name": "dehumanization_trope",
      "label": "Dehumanization Trope",
      "description": "The broader concept of dehumanization, where individuals are stripped of their humanity to justify mistreatment or discrimination. In this meme, the comparison to a primate is a form of dehumanization that reduces Michelle Obama to an animal, making her appear less worthy of respect or dignity. This trope is often used in racist discourse to justify violence or exclusion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_025eb6ee"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aa3f1f25",
      "@type": "EmotionExpression",
      "instance_name": "dehumanization",
      "label": "dehumanizing emotion",
      "description": "The emotion expressed is one of dehumanization, conveyed through the visual juxtaposition of Michelle Obama with a primate mask and the accompanying text 'i can't tell the difference'. This creates an emotional state of contempt and degradation, reducing Michelle Obama to an animal-like status to diminish her humanity and worth. The emotion is rooted in racial prejudice and is intended to provoke disgust or ridicule.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_025eb6ee"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d6e245f1",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Michelle Obama is mapped as indistinguishable from a primate",
      "description": "The bottom text 'i can't tell the difference' explicitly maps Michelle Obama (the visual entity) onto the person wearing the primate mask (the visual entity), implying they are visually identical. This mapping is reinforced by the juxtaposition of the two images and the salary comparison text above, which sets up the false equivalence that makes the comparison seem plausible. The mapping is an analogical one where the textual claim 'i can't tell the difference' is projected onto the visual pairing of Michelle Obama and the primate-masked person.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_025eb6ee"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_41775ff3",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the dehumanizing comparison scene",
      "description": "The user is projected onto the overall juxtaposed_comparison_scene, which functions as a dehumanizing visual and textual construct. The meme's structure, particularly the bottom text 'i can't tell the difference', implicitly invites the user to adopt the perspective of the stereotype — to see Michelle Obama as visually indistinguishable from a primate. This projection is not explicit with deictic pronouns like 'you' or 'me', but it is implicit in the meme's rhetorical framing, which forces the viewer to confront the racist trope and potentially internalize or endorse the dehumanizing comparison. The user is thus projected onto the scene as the one who must 'see' the equivalence, making them complicit in the projection of the anti-Black primate stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_025eb6ee"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8e48f74e",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks Michelle Obama based on her race by comparing her to a primate, which is a well-documented anti-Black racist trope. The intent is to demean her and dehumanize her, making it a hateful meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_025eb6ee"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c831a53c",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who are familiar with Michelle Obama and may be exposed to or propagate racist stereotypes, particularly those who engage in or support anti-Black racism. The meme is designed to appeal to or provoke those who hold or are willing to entertain the dehumanizing trope of comparing Black people to primates, often rooted in historical racial prejudice. The use of a high-profile Black woman as the subject makes the meme particularly targeted at audiences who may be influenced by or reinforce racial hierarchies, and who might find the false salary comparison and the 'i can't tell the difference' text amusing or provocative, despite its deeply offensive nature. The meme's intent is to elicit a reaction from those who either endorse or are indifferent to such racist imagery, thereby reinforcing the stereotype within their community.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_025eb6ee"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
