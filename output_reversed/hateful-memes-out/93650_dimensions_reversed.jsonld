    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_98ad1e2a",
      "@type": "BackgroundKnowledge",
      "instance_name": "Black_magic_in_Harry_Potter",
      "label": "Black magic in Harry Potter",
      "description": "In the Harry Potter universe, 'black magic' refers to dark, dangerous, and often morally reprehensible magic that is forbidden by the Ministry of Magic and Hogwarts. The concept is central to the series' plot and character development, and understanding this term's specific meaning in the context of the series is crucial to the meme's joke.",
      "belongsToAnalysis": {
