    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8528e13c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "Voldemort is mapped as someone expelled from Hogwarts for using black magic",
      "description": "The text 'i got kicked out of hogwarts for using black magic' is juxtaposed with the visual of Lord Voldemort, who is known in the Harry Potter universe for using black magic. The meme humorously maps the character's identity and actions (using black magic) onto the textual claim of being expelled for that very reason, creating an ironic and absurd situation. The visual of Voldemort's rage reinforces the comedic contrast between his villainous nature and the mundane consequence of expulsion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e413fafb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ba81fb3e",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the text 'i got kicked out of hogwarts for using black magic' as if this statement is being made by the user, creating an ironic self-referential projection. The text uses first-person pronouns ('i', 'my') which directly anchor the projection onto the user.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e413fafb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_62b737cb",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "Harry Potter fans",
      "description": "The meme is designed for fans of the Harry Potter franchise who are familiar with the characters, settings, and lore. The humor relies on inside knowledge of Lord Voldemort's character, his use of dark magic, and the fictional context of Hogwarts and its disciplinary system. The audience understands the absurdity of the premise, which is central to the meme's comedic effect.",
