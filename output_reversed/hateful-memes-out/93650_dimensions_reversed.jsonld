    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_70a85926",
      "@type": "BackgroundKnowledge",
      "instance_name": "Meme_format",
      "label": "Meme format",
      "description": "The meme format involves juxtaposing a dramatic or intense image with ironic or absurd text to create humor. Understanding this format is necessary to interpret the meme's intent, which is to mock the idea of being expelled for using 'black magic' by using a character known for using it.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e413fafb"
