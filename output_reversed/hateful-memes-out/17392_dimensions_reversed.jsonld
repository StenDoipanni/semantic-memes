    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_719aa134",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Divine Plan Mocked by Wildness",
      "description": "The text 'we are all apart of god's plan' is mapped onto the visual of the man and woman holding a tiger cub, implying that the divine plan is as chaotic or unpredictable as the wild animal. The tiger cub, symbolizing wildness and danger, is used to satirize the idea of a divine, orderly plan, creating an absurd contrast.",
      "belongsToAnalysis": {
