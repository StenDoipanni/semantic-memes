    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2c1be071",
      "@type": "BackgroundKnowledge",
      "instance_name": "political_meme_format",
      "label": "Political Meme Format",
      "description": "The meme follows a common format in political satire and online discourse: using a serious or somber image of a political figure with accusatory or emotionally charged text. This format is used to convey a message of criticism or blame, often amplified by the juxtaposition of the image and text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02b7a3a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
