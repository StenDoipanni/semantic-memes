    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f7758f77",
      "@type": "BackgroundKnowledge",
      "instance_name": "hateful_political_rhetoric",
      "label": "Hateful Political Rhetoric",
      "description": "The meme's language, particularly phrases like 'you built that!' and 'make us hate one another,' reflects a style of political rhetoric that is emotionally charged and accusatory. This rhetoric is often used to vilify political opponents and is considered hateful as it attacks an individual's character and legacy rather than engaging in reasoned debate.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02b7a3a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a244cb29",
      "@type": "EmotionExpression",
      "instance_name": "sadness",
      "label": "sad emotional expression",
      "description": "Barack Obama's facial expression conveys a somber, melancholic, or sorrowful emotion, characterized by downturned mouth, heavy eyelids, and a serious gaze. This expression is visually aligned with the accusatory text overlay, which frames his presidency as a failure to foster unity, thereby amplifying the emotional weight of the scene.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02b7a3a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1bcc9cee",
      "@type": "AnalogicalMapping",
      "instance_name": "obama_bridge_mapping",
      "label": "Barack Obama is mapped as the one who built the bridge of division",
      "description": "The text 'it's sad obama you had the chance of a lifetime to build a bridge...' and 'instead you did everything you could in your power to divide us...' directly maps Barack Obama (the visual entity) as the agent responsible for constructing the metaphorical 'bridge' of division. The visual of Obama, with his somber expression, is juxtaposed with the text to imply he is the one who 'built that' bridge of division, creating an analogical mapping where the textual accusation is projected onto the visual representation of Obama.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02b7a3a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fc69b9dc",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual accusation directed at Barack Obama",
      "description": "The user is projected onto the accusatory text in the meme, which uses second-person address ('you', 'your') to directly blame Barack Obama for building division. The text 'it's sad obama you had the chance...' and 'instead you did everything you could...' explicitly addresses the viewer as 'you', making the user the target of the accusation and the one who is being asked to identify with the moral judgment being made. The user is thus projected onto the textual material as the one who is being called to hold Obama accountable for the 'bridge of division'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02b7a3a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bebd1c9d",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful Political Rhetoric",
      "description": "The meme uses emotionally charged, accusatory language to vilify former President Barack Obama, directly blaming him for fostering national division and hatred. This constitutes hateful rhetoric targeting a specific political figure based on his identity and leadership, aiming to provoke negative sentiment and reinforce partisan narratives.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02b7a3a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_63fbbd45",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is politically conservative Americans who are critical of former President Barack Obama's presidency, particularly those who believe he exacerbated political division in the United States. The meme’s accusatory tone, use of the 'bridge' metaphor, and the phrase 'you built that!' are designed to resonate with individuals who hold a negative view of Obama’s leadership and who identify with the narrative of national division during his term. The visual of Obama with a somber expression against the White House backdrop reinforces the political context and appeals to those who perceive his policies or rhetoric as divisive. The meme leverages partisan political discourse and emotionally charged language to provoke agreement among its intended audience, which is likely composed of right-leaning voters or supporters of the Republican Party who are disillusioned with Obama’s legacy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02b7a3a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
