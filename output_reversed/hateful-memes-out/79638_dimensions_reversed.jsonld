    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c58478ae",
      "@type": "BackgroundKnowledge",
      "instance_name": "metaphor_bridge_of_division",
      "label": "Metaphor: Bridge as Symbol of Unity or Division",
      "description": "The meme uses the metaphor of 'building a bridge' to represent efforts at national unity and cooperation, while 'building a bridge of division' implies the opposite. This metaphor is culturally and politically significant in American discourse, often used to describe attempts to reconcile opposing sides in a conflict.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02b7a3a6"
