    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e25741d0",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Activism Risk Metaphor mapped onto Pride Celebration Scene",
      "description": "The text 'you either die a hero, or live long enough to become the villain' (text_chunk) is mapped onto the visual scene of the Pride Celebration (pride_celebration). The metaphor describes the risks faced by activists, and the visual of two joyful individuals at a Pride event, a movement rooted in activism, serves as the visual instantiation of this metaphor. The celebratory scene, while joyful, is contextually linked to the historical and ongoing struggles of the LGBTQ+ movement, making the metaphor applicable to the visual material.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f5d36e82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d6efc4fd",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message and the scene of activism",
      "description": "The user is projected onto the textual material ('you either die a hero, or live long enough to become the villain') and the visual scene (pride_celebration) as a whole. The text directly addresses the viewer with a universal, personalizable statement about activism and sacrifice, inviting the user to identify with the risks and potential vilification faced by activists. The joyful scene of the Pride celebration, while celebratory, is contextually linked to the historical struggles of the LGBTQ+ movement, allowing the user to project themselves onto the activists depicted or onto the broader activist experience described by the text. The metaphor is not directed at a specific individual but at the viewer as a potential participant or observer of social movements.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f5d36e82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c041c493",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Propaganda",
      "description": "The meme uses the metaphor 'you either die a hero, or live long enough to become the villain' to frame activism as inherently risky and potentially vilifying, which is propagandistic in nature. It aims to influence viewers to reflect on the sacrifices made by activists and the potential consequences of their actions, particularly within the context of the LGBTQ+ Pride Movement. This framing can be seen as a form of propaganda that seeks to shape perception and encourage identification with the activist experience.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f5d36e82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c07a59c7",
      "@type": "TargetCommunity",
      "instance_name": "LGBTQ_Pride_Movement",
      "label": "LGBTQ+ Pride Movement",
      "description": "The meme is designed for individuals who identify with or are active in the LGBTQ+ Pride Movement. The visual elements — the rainbow flag, the celebratory scene, and the participants’ attire — are direct markers of this community. The text metaphor, while universal in its application to activism, is specifically contextualized within the historical and ongoing struggles of LGBTQ+ rights, making it particularly resonant for this audience. The meme invites reflection on the risks faced by LGBTQ+ activists, which is a core concern of the movement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f5d36e82"
      },
      "extractionMethod": "llm_extraction_huggingface"
