    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b16f5677",
      "@type": "BackgroundKnowledge",
      "instance_name": "activism_risk_metaphor",
      "label": "Activism Risk Metaphor",
      "description": "The phrase 'you either die a hero, or live long enough to become the villain' is a well-known metaphor in political and social activism, often used to describe the risks activists face. It implies that those who fight for change may be celebrated as heroes if they die in the cause, but if they survive, they may be vilified as villains due to the controversial nature of their cause becoming mainstream or politically inconvenient. This metaphor is rooted in historical and contemporary activist movements, including civil rights, anti-war, and LGBTQ+ rights movements.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f5d36e82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c98961b3",
      "@type": "BackgroundKnowledge",
      "instance_name": "LGBTQ_Pride_Movement",
      "label": "LGBTQ+ Pride Movement",
      "description": "The rainbow flag, prominently displayed in the image, is a globally recognized symbol of the LGBTQ+ Pride Movement. It represents the diversity and visibility of LGBTQ+ individuals and communities. Pride events are celebrations of LGBTQ+ identity and achievements, often accompanied by protests and activism for equal rights. The context of the image — two individuals joyfully participating in what appears to be a Pride event — relies on external knowledge of this movement to be fully understood.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f5d36e82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a41d96b3",
      "@type": "BackgroundKnowledge",
      "instance_name": "villain_stereotype_in_activism",
      "label": "Villain Stereotype in Activism",
      "description": "The concept of becoming a 'villain' after surviving activism is a stereotype that reflects how society can turn against activists when their causes gain traction or become politically contentious. This stereotype is often used to critique how movements are co-opted, how activists are demonized, or how their efforts are framed as disruptive or threatening to the status quo. It is a real-world phenomenon that requires external knowledge to interpret the meme’s message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f5d36e82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9c0d827c",
      "@type": "BackgroundKnowledge",
      "instance_name": "rainbow_flag_symbolism",
      "label": "Rainbow Flag Symbolism",
      "description": "The rainbow flag is not just a colorful banner; it is a specific symbol with deep cultural and political meaning. Its stripes represent diversity and inclusion within the LGBTQ+ community. Understanding the flag’s symbolism — as a symbol of pride, resistance, and identity — is essential to interpreting the image’s context and the meme’s message. Without this background knowledge, the visual element might be seen merely as festive decor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f5d36e82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a8d7c74c",
      "@type": "EmotionExpression",
      "instance_name": "joy",
      "label": "joyful expression",
      "description": "The person on top is holding a rainbow flag aloft with both arms raised, smiling broadly with glitter or paint on their face, conveying a sense of celebration and happiness. The person below is looking up with a wide, joyful smile, indicating shared happiness and excitement. The overall scene is festive and celebratory, reinforcing the emotion of joy.",
