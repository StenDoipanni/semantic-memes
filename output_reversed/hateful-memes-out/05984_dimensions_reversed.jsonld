      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b4dac69f",
      "@type": "BackgroundKnowledge",
      "instance_name": "social_double_standard",
      "label": "Social Double Standard",
      "description": "The meme critiques the social phenomenon where the same behavior is judged differently based on the perceived social role or status of the actor — in this case, a child versus an adult. This concept is central to understanding the humor and underlying message of the meme.",
      "belongsToAnalysis": {
