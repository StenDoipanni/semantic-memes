    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9f3cb409",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Child innocence mapped to mild societal reaction",
      "description": "The top text 'removes polish with chemicals nobody bats an eye' is analogically mapped onto the visual entity 'child_on_scooter'. The child, depicted in motion with protective gear and youthful energy, represents the 'innocent actor' whose actions (removing polish) are trivialized by society. The visual material of the child embodies the stereotype of childhood innocence, which the text explicitly references by stating that 'nobody bats an eye' — implying societal leniency.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5e0db7a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a5245d9a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the child_on_scooter scene as the innocent actor",
      "description": "The user is projected onto the visual entity 'child_on_scooter' as the embodiment of the 'innocent actor' whose actions (removing polish with chemicals) are trivialized by society ('nobody bats an eye'). This projection is implicit, drawing on the cultural stereotype of childhood innocence and the meme's contrast with the adult scenario. The user identifies with the child's perceived exemption from social consequences, which is the core of the meme's humor and message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5e0db7a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
