      "@id": "http://example.org/multimodal-taxonomy#dimension_46d8f19f",
      "@type": "BackgroundKnowledge",
      "instance_name": "child_innocence_stereotype",
      "label": "Child Innocence Stereotype",
      "description": "The meme relies on the widespread cultural stereotype that children are inherently innocent and therefore excused for misbehavior or rule-breaking, while adults are held to higher standards and face greater social consequences for similar actions. This stereotype is used to highlight the double standard in societal reactions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5e0db7a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e057291f",
      "@type": "BackgroundKnowledge",
      "instance_name": "adult_responsibility_stereotype",
      "label": "Adult Responsibility Stereotype",
      "description": "The meme implicitly references the societal expectation that adults are responsible for their actions and should be held accountable for rule-breaking or harmful behavior, contrasting this with the perceived leniency afforded to children. This stereotype is used to underscore the hypocrisy in social reactions.",
      "belongsToAnalysis": {
