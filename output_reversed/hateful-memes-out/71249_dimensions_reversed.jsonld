    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_50de4fc9",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The text 'islamic warrior's funeral in palestine' maps to the visual depiction of armed individuals in military-style attire holding flags with Islamic symbols.",
      "description": "The textual phrase 'islamic warrior's funeral in palestine' is directly projected onto the visual material of the armed individuals. The text explicitly labels the scene as a 'funeral' for an 'islamic warrior', which is an analogical mapping that frames the visual material (the militant procession) as a ritualistic event associated with violence and extremism. This mapping is central to the meme's hateful intent, as it uses the term 'warrior' to glorify or normalize armed conflict, and 'funeral' to imply a ritual that legitimizes or celebrates violence, all within the context of Palestine. The visual material is thus mapped as the embodiment of the textual concept.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7ad69789"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_34e1e8f9",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the text_chunk 'islamic warrior's funeral in palestine', which frames the visual material as a ritualistic event associated with violence and extremism. The text acts as a deictic label that directs the user's interpretation of the visual scene, imposing a hateful stereotype onto the image. There are no explicit deictic pronouns like 'me' or 'you', but the text functions as an implicit projection by commanding the viewer to interpret the visual material through the lens of the stereotype it provides.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7ad69789"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
