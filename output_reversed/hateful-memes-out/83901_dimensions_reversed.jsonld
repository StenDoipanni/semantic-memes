    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7c8d15b7",
      "@type": "EmotionExpression",
      "instance_name": "exasperation",
      "label": "exasperated emotion",
      "description": "The woman's skeptical, questioning facial expression, combined with her weary posture and the text 'dafuq else im'a do', conveys a strong sense of exasperation. This emotion arises from the humorous implication that wishing someone a happy birthday is the only socially acceptable or logical action in that context, reflecting a feeling of being overwhelmed by a mundane social obligation.",
      "belongsToAnalysis": {
