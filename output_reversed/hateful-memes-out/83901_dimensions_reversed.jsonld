    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0ea322ad",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The woman is mapped as the speaker of the text",
      "description": "The text 'am i gonna wish you happy birthday?' and 'dafuq else im'a do' is presented as if spoken by the woman in the image. Her skeptical, questioning expression and posture visually represent the speaker's exasperated, weary resignation, creating an analogical mapping where the visual entity (the woman) embodies the textual entity (the speaker of the dialogue).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d3f0ce6f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_71d3c1be",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the skeptical woman as the speaker of the text",
      "description": "The user is projected onto the visual material of the woman, who is depicted as the speaker of the text 'am i gonna wish you happy birthday?' and 'dafuq else im'a do'. The meme uses the woman's skeptical expression and posture to embody the speaker's exasperated, weary resignation, creating an analogical mapping where the user identifies with the speaker's perspective. The text 'am i gonna wish you happy birthday?' is a direct address to the user, implying the user is the recipient of the birthday wish, and the speaker is questioning whether they should do it, which projects the user onto the role of the recipient. The phrase 'dafuq else im'a do' reinforces this projection by implying the speaker (and by extension, the user) is limited to this social obligation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d3f0ce6f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
