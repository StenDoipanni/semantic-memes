    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_573d2169",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_context",
      "label": "Meme Context: Social Obligation Humor",
      "description": "The meme relies on the real-world understanding that wishing someone a happy birthday is a common, expected social ritual. The humor stems from the exaggerated, weary resignation implied by the text and the woman's expression, suggesting that this is the only socially acceptable or logical thing to do in that context. This requires knowledge of social norms around birthday greetings.",
      "belongsToAnalysis": {
