    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_36c37abc",
      "@type": "BackgroundKnowledge",
      "instance_name": "cultural_reference",
      "label": "Cultural Reference: 'Happy Birthday' Social Norm",
      "description": "The meme references the universal social norm of wishing someone a happy birthday as a gesture of goodwill and acknowledgment. This is a deeply ingrained cultural practice in many societies, and the meme's humor arises from the exaggerated implication that this is the only possible response to the situation.",
      "belongsToAnalysis": {
