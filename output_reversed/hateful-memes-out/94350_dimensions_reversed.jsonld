    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_371779f8",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme depicts a woman imagining a man is thinking about her, while the man is shown using Siri to search for 'find me interracial kinky amputee midget fisting porn.' The intent is to portray the man as hypersexualized, degrading, and objectifying, using derogatory and offensive language that targets multiple marginalized groups (including people with disabilities and racial minorities). The juxtaposition of the woman's innocent thought with the man's explicit, degrading search query is meant to mock or shame the man's behavior, but it does so by invoking harmful stereotypes and language that is inherently hateful and offensive. The meme relies on the degradation of the man's character through the use of slurs and dehumanizing terms, which constitutes a hateful intent targeting individuals based on protected characteristics such as disability and race.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_008b5175"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bc0e404b",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The meme is designed for an audience familiar with internet humor, particularly those who understand the use of Siri as a comedic device and the juxtaposition of innocent thoughts with degrading content. The target audience likely includes individuals who find humor in mocking hypersexualized stereotypes, especially those targeting Black men, people with disabilities, and women. The meme relies on the audience's recognition of the offensive search query and its implications, suggesting the audience is aware of and possibly complicit in or entertained by the degradation of marginalized groups. The use of derogatory terms like 'interracial', 'kinky', 'amputee', 'midget', and 'fisting' indicates the meme is aimed at an audience that either finds these terms humorous or is indifferent to their harmful impact, potentially reinforcing harmful stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_008b5175"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
