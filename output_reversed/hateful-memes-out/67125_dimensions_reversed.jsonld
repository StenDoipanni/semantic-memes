    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7369207b",
      "@type": "Scene",
      "instance_name": "anne_frank_at_desk",
      "label": "Anne Frank seated at a wooden desk",
      "description": "A stylized representation of Anne Frank is seated at a wooden desk, appearing to write or draw. She is positioned in front of a green door and next to a shelf with books and a hanging pink dress. The scene is framed by interior elements suggesting a personal space, possibly a room in a hiding place. The text overlay 'just ordered the new anne frank puzzle' implies a commercial context, contrasting with the solemn historical significance of Anne Frank.",
      "belongsToAnalysis": {
