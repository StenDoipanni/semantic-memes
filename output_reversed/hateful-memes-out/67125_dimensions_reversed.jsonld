    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fe2a6686",
      "@type": "VisualMaterial",
      "instance_name": "Anne_Frank",
      "label": "person",
      "description": "A young girl with dark, wavy hair, wearing a white dress with red embroidery, seated at a wooden desk. She is smiling and appears to be writing or drawing. This is a stylized representation of Anne Frank, based on historical photographs and depictions.",
      "belongsToAnalysis": {
