      "instance_name": "social_media_ban_impact",
      "label": "Impact of Social Media Bans",
      "description": "The real-world consequences of being banned from major social media platforms, which can include loss of communication channels, professional repercussions, emotional distress, and disruption of personal or business networks. The meme humorously downplays this impact by suggesting the user is unaffected due to a backup account.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_35ee7307"
      },
