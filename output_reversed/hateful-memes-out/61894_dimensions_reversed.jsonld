    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d41e7878",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The person in the image is mapped as someone who is not sweating due to having a backup account",
      "description": "The text 'when your put in fb jail ..but your not... even sweatin cause of your back up account' implies that the person being described (the subject of the meme) is unaffected by being 'in fb jail'. This person is visually represented by Steve Harvey, whose cheerful, nonchalant expression (broad smile) is mapped onto the textual description of someone who is 'not even sweatin'. The visual entity (Steve Harvey) is thus analogically mapped to the textual entity (the person who has a backup account and is therefore unaffected).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_35ee7307"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_039a22a2",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the person described in the text",
      "description": "The user is projected onto the person who is humorously depicted as being 'in fb jail' but not sweating because they have a backup account. This is implied by the text 'when your put in fb jail ..but your not... even sweatin cause of your back up account', which uses 'your' to directly address the viewer/user. The visual material of Steve Harvey, with his nonchalant smile, is used to represent this person. The projection is onto the textual material's subject and the visual material's subject.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_35ee7307"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
