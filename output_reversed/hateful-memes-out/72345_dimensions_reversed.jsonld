    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_428e30e4",
      "@type": "VisualMaterial",
      "instance_name": "man_in_kkk_robe",
      "label": "person wearing Ku Klux Klan-style attire",
      "description": "A man is depicted wearing a white hooded robe with a blue cape and white gloves. The robe features two circular patches: one green with a red cross and another red with a white cross. The hood covers his hair and ears, leaving only his face visible. He has a neutral to slightly smug facial expression. The attire is clearly identifiable as a Ku Klux Klan costume, symbolizing white supremacist hate groups. This is the central and most salient visual element in the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_21daa678"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e2eb57b1",
      "@type": "Scene",
      "instance_name": "racist_hate_scene",
      "label": "racist_hate_scene",
      "description": "A scene depicting a man in a Ku Klux Klan-style robe and hood, juxtaposed with text that expresses hatred toward Black people ('I hate when I see a black out in my neighborhood') while simultaneously offering a 'candle' — a symbol of appeasement or passive tolerance. The visual of the KKK imagery directly maps onto the hateful sentiment expressed in the text, creating an analogical link between the wearer's identity and the racist message. The scene is designed to convey and reinforce anti-Black racism by using the KKK as a symbol of white supremacist hate, while the 'offering a candle' is a sarcastic or ironic gesture that implies a false sense of moral superiority or reconciliation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_21daa678"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d58f17d5",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_racism_stereotype",
      "label": "Anti-Black Racism Stereotype",
      "description": "The meme relies on the stereotype that Black people are inherently associated with criminality, violence, or social disorder, which is reflected in the text 'I hate when I see a black out in my neighborhood' — a phrase that implies fear or hatred toward Black people. This stereotype is a core component of the meme's hateful message and is not visible in the image but is required to understand the context.",
      "belongsToAnalysis": {
