    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_41825451",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The man in the KKK robe is mapped as the speaker of the hateful text",
      "description": "The visual of the man in the Ku Klux Klan-style robe and hood is directly mapped onto the textual message 'i hate when i see a black out in my neighborhood' and 'but i still offer my neighbors a candle'. The man's identity and attire symbolize the hateful sentiment expressed in the text, creating an analogical link where the wearer's persona (the KKK member) is the agent of the racist message. The smug expression reinforces the hateful tone. This mapping is central to the meme's intent, as the visual entity (man_in_kkk_robe) embodies the hateful speaker described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_21daa678"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e7b292c1",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man in the KKK robe as the speaker of the hateful text",
      "description": "The user is projected onto the visual entity 'man_in_kkk_robe' because the meme uses the man's attire and persona as the direct embodiment of the hateful message in the text. The text 'i hate when i see a black out in my neighborhood' and 'but i still offer my neighbors a candle' is presented as if spoken by the man in the robe, making the user identify with or project themselves onto this hateful speaker. The visual material of the man in the KKK robe is the focal point onto which the user's perspective is projected, as the meme's intent is to make the viewer see themselves as the agent of the racist sentiment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_21daa678"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
