    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_65c4c4e4",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_phrase",
      "label": "Meme Phrase: 'when nobody knew who you were until you got on your knees'",
      "description": "This phrase is a common internet meme used to mock or belittle individuals who gain popularity or recognition only after performing a humiliating or submissive act, often implying their value is derived solely from their physical appearance or sexual appeal. It is a form of objectification and reinforces harmful stereotypes about gender roles and the value of individuals based on appearance or sexual appeal.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4c526b85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e2823f84",
      "@type": "BackgroundKnowledge",
      "instance_name": "objectification_stereotype",
      "label": "Objectification Stereotype",
      "description": "The meme relies on the stereotype that individuals are only valued for their physical appearance or sexual appeal, and that their worth is contingent on performing a submissive or humiliating act. This is a form of misogyny and reinforces the idea that women (and sometimes men) are objects to be consumed or admired based on their looks rather than their character or achievements.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4c526b85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a9c6d221",
      "@type": "BackgroundKnowledge",
      "instance_name": "gendered_dynamic_stereotype",
      "label": "Gendered Dynamic Stereotype",
      "description": "The meme reinforces a gendered dynamic where the woman is portrayed as the 'object' of attention and the man as the 'subject' who 'gets' the attention. This reflects and perpetuates harmful stereotypes about gender roles, where women are seen as passive and men as assertive or dominant, and where a woman's value is tied to her physicality and sexual availability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4c526b85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d2d7a408",
      "@type": "BackgroundKnowledge",
      "instance_name": "harmful_content",
      "label": "Harmful Content",
      "description": "The meme contains harmful content that can be damaging to individuals' self-esteem and perpetuates negative stereotypes about gender and appearance. It is considered harmful because it promotes objectification and reinforces stereotypes that devalue individuals based on their appearance or sexual appeal, rather than their character or achievements.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4c526b85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_01e65f46",
      "@type": "EmotionExpression",
      "instance_name": "mocking_contempt",
      "label": "mocking contempt emotion",
      "description": "The emotion expressed is mocking contempt, conveyed through the juxtaposition of the two individuals and the meme phrase. The phrase 'when nobody knew who you were until you got on your knees' implies that the individuals are only valued for their physical appearance or sexual appeal, and that their worth is contingent on performing a humiliating or submissive act. This is a form of objectification and reinforces harmful stereotypes about gender roles and the value of individuals based on appearance or sexual appeal. The visual pairing of the woman and the man, with the woman appearing to be in a more traditionally 'feminine' or 'approachable' role and the man in a more 'masculine' or 'assertive' role, reinforces a gendered dynamic where the woman is portrayed as the 'object' of attention and the man as the 'subject' who 'gets' the attention. The overall intent is to ridicule the individuals for their perceived lack of prior recognition or status, and to imply that their value is derived solely from their physical appearance or sexual appeal. This can be harmful as it perpetuates objectification and reinforces harmful stereotypes about gender roles and the value of individuals based on their appearance or sexual appeal.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4c526b85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ab469ca5",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The woman is mapped as 'who you were' before gaining recognition",
      "description": "The top text 'when nobody knew who you were until you got on' is spatially positioned above the woman's image, implying that she represents the 'you' who was unknown before gaining attention. The visual material of the woman is mapped onto the textual concept of 'who you were' in the phrase.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4c526b85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_faecb49e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_2",
      "label": "The man is mapped as 'your knees' after gaining recognition",
      "description": "The bottom text 'your knees.' is spatially positioned below the man's image, implying that he represents the 'knees' — the submissive or humiliating act that led to his recognition. The visual material of the man is mapped onto the textual concept of 'your knees' in the phrase.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4c526b85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_838387ec",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual phrase and the visual representation of the individuals",
      "description": "The user is projected onto the meme's textual phrase 'when nobody knew who you were until you got on your knees.' The phrase uses 'you' and 'your knees', which are deictic pronouns directing the user to imagine themselves as the subject of the action. The visual material of the woman is mapped onto 'who you were' (the unknown state), and the visual material of the man is mapped onto 'your knees' (the act that led to recognition). The user is thus projected onto the entire scene, imagining themselves as the person who gained recognition through a humiliating act, with the woman representing their past self and the man representing the act or the person who 'got' them.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4c526b85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
