    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0b05a1b9",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Childhood innocence mapped onto a racialized question about familial roles",
      "description": "The visual of the joyful, innocent child is juxtaposed with the text asking if it's okay for a child to call another man 'daddy.' This creates an analogical mapping where the child's innocence is used as a rhetorical tool to frame the question as morally urgent or potentially harmful, implicitly reinforcing racialized stereotypes about Black family structures. The child's expression and posture are mapped onto the textual question to evoke an emotional response that supports the meme's underlying racialized assumption.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f4afd739"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eca9d305",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material questioning familial roles",
      "description": "The user is projected onto the text chunk 'is it ok for your son or daughter to call another man \"daddy?\"', which uses the deictic 'your' to directly address the viewer. This creates an implicit 'you' as the subject of the question, making the user feel personally implicated in the moral judgment being posed. The projection is onto the textual material, which frames the viewer as the one who must decide or evaluate the appropriateness of the child's behavior, thereby personalizing the racialized assumption embedded in the meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f4afd739"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
