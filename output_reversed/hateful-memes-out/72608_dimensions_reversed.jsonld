    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bc93aaf8",
      "@type": "EmotionExpression",
      "instance_name": "humorous_sarcasm",
      "label": "sarcastic and humorous emotion",
      "description": "The emotion expressed is a blend of humor and sarcasm, conveyed through the juxtaposition of a child's innocent, reverent prayer pose with the absurd, satirical text that mocks the biblical story of Noah's Ark by listing modern game animals like turkey, white-tail deer, and elk as if they were on the ark. The tone is intentionally ironic and comedic, derived from the contrast between the sacred context and the ridiculous content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b034de06"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_75318bca",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "child is mapped as a praying figure in a religious parody",
      "description": "The visual entity 'child' is mapped onto the textual entity 'dear lord,' through the juxtaposition of the child's prayerful pose with the religious language in the text. The child's innocent, reverent posture is used to ironically represent the speaker of the prayer, creating an analogical mapping where the child embodies the role of the person praying in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b034de06"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8be83fee",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the child in cowboy attire",
      "description": "The user is projected onto the visual material of the child, who is depicted in a prayerful pose. The child's innocent and reverent posture, combined with the cowboy attire, creates a humorous and ironic contrast with the satirical religious text. The user sees themselves as the child, embodying the role of the person praying in the text, which is an implicit projection of the user's identity onto the child figure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b034de06"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d0314841",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme uses religious parody to mock the biblical story of Noah's Ark by humorously claiming that Noah included modern game animals like turkey, white-tail deer, and elk on the ark. While not targeting any specific group with abuse or hate, this satirical content may be seen as disrespectful or mocking to viewers who hold strong religious beliefs, potentially causing offense or harm to those communities. The juxtaposition of a child's innocent prayer pose with the absurd, factually incorrect religious text creates a tone that could be interpreted as trivializing sacred narratives.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b034de06"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3b882663",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "general internet audience familiar with religious parody",
      "description": "The meme is designed for a broad online audience that understands religious references, biblical narratives, and the conventions of internet humor, particularly satire and parody. The target community includes viewers who appreciate absurdity and irony, especially when juxtaposed with religious imagery or language. The humor relies on the audience's knowledge of the Noah's Ark story and the common cultural association of 'turkey, white-tail deer, elk' with modern hunting culture, which contrasts with the traditional biblical narrative. The meme's effectiveness depends on the audience recognizing the satirical deviation from scripture, making it primarily aimed at those who are culturally literate in religious texts and internet meme formats.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b034de06"
