    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a29d849b",
      "@type": "BackgroundKnowledge",
      "instance_name": "biblical_noahs_ark",
      "label": "Biblical Story of Noah's Ark",
      "description": "The meme references the biblical narrative of Noah's Ark, where Noah was instructed by God to build an ark and bring pairs of every kind of animal onto it to survive the Great Flood. The text humorously misrepresents this by claiming Noah included animals like turkey, white-tail deer, and elk, which are not traditionally associated with the biblical account. This requires knowledge of the biblical story to understand the absurdity and parody.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b034de06"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bab49570",
      "@type": "BackgroundKnowledge",
      "instance_name": "religious_parody",
      "label": "Religious Parody",
      "description": "The meme uses satire and humor to mock or trivialize religious traditions, specifically the biblical story of Noah's Ark. This requires understanding that religious narratives can be the subject of parody, which may be offensive to some viewers. The juxtaposition of a child's innocent prayer with the satirical text is central to the meme's intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b034de06"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fdc71a07",
      "@type": "BackgroundKnowledge",
      "instance_name": "noahs_ark_animal_list",
      "label": "Traditional Animal List on Noah's Ark",
      "description": "The meme references a specific, traditional list of animals that are commonly associated with Noah's Ark in religious and cultural contexts, such as pairs of land animals, birds, and sea creatures. The text's claim that Noah included 'turkey, white tail deer, elk' is a humorous deviation from this traditional list, requiring knowledge of what animals are typically considered part of the biblical narrative.",
      "belongsToAnalysis": {
