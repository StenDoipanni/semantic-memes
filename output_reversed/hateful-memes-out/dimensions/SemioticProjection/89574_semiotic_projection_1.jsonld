  "@id": "http://example.org/multimodal-taxonomy#semiotic_projection_1",
  "@type": "SemioticProjection",
  "instance_name": "semiotic_projection_1",
  "label": "User projected onto the textual material",
  "description": "The user is projected onto the textual material 'i'm cute' because the text explicitly assigns an infantilizing attribute to the visual subject. The phrase 'i'm cute' functions as a direct projection of the user's perspective onto the text, which then becomes the vehicle for the ableist infantilization of the person depicted. The user is not directly addressed by deictic pronouns like 'you' or 'me', but the text's assertion of 'cute' is a projection of the user's (or meme's) framing onto the subject, making the text the focal point of the semiotic projection.",
  "extractionMethod": "llm_extraction_huggingface",
