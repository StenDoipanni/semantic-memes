  "@id": "http://example.org/multimodal-taxonomy#semiotic_projection_1",
  "@type": "SemioticProjection",
  "instance_name": "semiotic_projection_1",
  "label": "User projected onto the textual material describing the scenario",
  "description": "The user is projected onto the textual material 'when cops see an unarmed black youth:' because the meme invites the viewer to imagine themselves as the observer of the scenario described — the 'cops' in the visual are the agents performing the action, and the text sets up a hypothetical situation that the user is expected to mentally inhabit. The user is not explicitly addressed with 'you' or 'me', but the framing of the meme (the visual of officers pointing, the loaded text, and the extreme quote) creates an implicit projection where the user is positioned as the one witnessing or interpreting the scenario, thereby internalizing the stereotype and the violent implication. This projection is onto the textual material that defines the scenario.",
  "extractionMethod": "llm_extraction_huggingface",
  "extractedFrom": "89745",
