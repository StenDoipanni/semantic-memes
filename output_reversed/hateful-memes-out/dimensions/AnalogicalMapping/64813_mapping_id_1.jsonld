  "@id": "http://example.org/multimodal-taxonomy#mapping_id_1",
  "@type": "AnalogicalMapping",
  "instance_name": "mapping_id_1",
  "label": "The teenager is mapped as the consequence of calling someone 'ugly' in high school",
  "description": "The text 'be careful who you call ugly in high school' implies that calling someone 'ugly' could lead to them being perceived as a gorilla. The visual material of the smiling Black teenager is juxtaposed with the gorilla to create an analogical mapping where the teenager is being mapped onto the gorilla as the result of being called 'ugly'. This mapping is part of the harmful anti-Black stereotype of comparing Black people to primates, which is the core of the meme's hateful intent.",
  "extractionMethod": "llm_extraction_huggingface",
