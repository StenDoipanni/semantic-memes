    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9e054dc8",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_stereotype",
      "label": "Misogynous Stereotype: 'Women Belong in the Kitchen'",
      "description": "This stereotype implies that women's appropriate and natural place is in domestic roles, particularly cooking and cleaning, and not in positions of power, leadership, or public influence. It is a historically rooted and harmful belief that reduces women's capabilities and societal roles to domestic labor, often used to demean or belittle women's achievements and ambitions. The meme explicitly invokes this stereotype by suggesting that women 'running the world' is absurd and should be corrected by sending them 'back in the kitchen'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2de97c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ee404456",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_humor",
      "label": "Misogynous Humor",
      "description": "A form of humor that relies on sexist or misogynistic stereotypes to entertain, often at the expense of women. It perpetuates harmful gender norms by mocking women's competence, intelligence, or societal roles. The meme uses this type of humor to mock the idea of women having power by suggesting it's absurd and should be corrected by returning women to domestic roles.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2de97c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_af546e19",
      "@type": "BackgroundKnowledge",
      "instance_name": "gender_role_stereotype",
      "label": "Gender Role Stereotype",
      "description": "A societal belief that assigns specific roles, behaviors, and expectations to individuals based on their gender. These stereotypes often dictate that men should be the breadwinners and leaders, while women should be caregivers and homemakers. The meme reinforces this by implying that women's 'running the world' is a deviation from their 'natural' role in the kitchen.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2de97c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3f67fab5",
      "@type": "EmotionExpression",
      "instance_name": "mocking_humor",
      "label": "mocking and belittling emotion",
      "description": "The emotion expressed is one of mocking and belittling, conveyed through the juxtaposition of the cheerful, lighthearted visual of two men laughing together and the overlaid text that promotes a misogynistic stereotype. The humor is not genuine or celebratory but rather sarcastic and demeaning, aimed at undermining the idea of women having power by suggesting they should be confined to the kitchen. This emotion is rooted in the misogynous stereotype and the misogynous humor trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2de97c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f0c2652c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Textual entity 'girls' mapped onto visual entity 'women' in the stereotype",
      "description": "The text 'she said girls run the world...' is mapped onto the visual representation of two men, who are the subjects of the joke. The meme uses the visual of two men laughing together to represent the 'correcting' or 'reclaiming' of societal roles for women, implying that men are the ones who 'correct' or 'reclaim' societal roles for women, which is a common trope in misogynistic humor. The visual of the two men reinforces the idea that men are the ones who 'correct' or 'reclaim' societal roles for women, which is a common trope in misogynistic humor. The text 'she said girls run the world...' is mapped onto the visual of the two men, who are the subjects of the joke, and the text 'so i told her get back in the kitchen' is mapped onto the visual of the two men, who are the subjects of the joke. The visual of the two men is mapped onto the textual entity 'girls' in the stereotype 'Women Belong in the Kitchen'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2de97c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d03b5ac9",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material as the speaker of the joke",
      "description": "The user is projected onto the textual material (text_chunk_1 and text_chunk_2) because the meme presents a first-person narrative ('she said... so I told her...'), inviting the viewer to identify with the speaker who is making the misogynistic statement. The user is not explicitly deictic (e.g., 'me' or 'you'), but the framing of the joke as a personal retort creates an implicit projection of the user as the one who 'told her' to get back in the kitchen, thereby aligning the user with the speaker of the misogynistic sentiment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2de97c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f66ec2bd",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Mysogynous",
      "description": "The meme promotes a harmful stereotype that reduces women's roles to domestic labor, implying they are only suited for the kitchen and not for positions of power or influence in society.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2de97c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f52170fd",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who are familiar with and may find humor in misogynistic stereotypes, particularly those who endorse or are comfortable with traditional gender role expectations that confine women to domestic roles. The meme appeals to an audience that finds amusement in reinforcing the 'women belong in the kitchen' trope, often used in misogynistic humor to belittle women's capabilities and societal roles. The visual of two men laughing together reinforces the idea that the 'correcting' of women's roles is a male-centric or male-validated perspective, which may resonate with audiences who identify with or support patriarchal norms. The meme's intent to mock and demean women's achievements and ambitions suggests it is designed for an audience that either does not challenge or actively reinforces these harmful gender norms.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2de97c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
