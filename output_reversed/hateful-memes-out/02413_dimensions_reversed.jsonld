    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fc3249e8",
      "@type": "BackgroundKnowledge",
      "instance_name": "individual_victimhood",
      "label": "Individual Victimhood",
      "description": "The idea that personal suffering or trauma is the primary or sole reason for social or political change. The meme reduces the complex issue of gender inequality to individual victimhood, which is a common but potentially reductive narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41478b0b"
