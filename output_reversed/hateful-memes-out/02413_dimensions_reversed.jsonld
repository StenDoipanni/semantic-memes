    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_167a7e07",
      "@type": "EmotionExpression",
      "instance_name": "suffering",
      "label": "the suffering emotion",
      "description": "The woman's facial expression, combined with visible physical injuries (bruising around the mouth and eye), conveys a state of pain, trauma, and distress. Her direct gaze and serious expression suggest resilience but also the weight of her suffering. This emotional state is central to the meme's message, framing her experience as the reason for the demand for equal rights.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41478b0b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_77b0aa83",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The woman's suffering is mapped as the reason for women's demand for equal rights",
      "description": "The text 'women ask for equal rights, and this is why' explicitly maps the visual entity 'woman_with_injuries_and_text' (specifically her injuries and suffering) as the causal or explanatory reason for the demand for equal rights. The visual material (the injured woman) is presented as the direct analogical representation of the textual claim (the 'why' behind the demand). This mapping is reinforced by the juxtaposition of the text with the image of trauma, creating a direct analogy: 'the suffering of this woman = the reason why women ask for equal rights'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41478b0b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_069689ac",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the injured woman as the embodiment of the 'why' behind women's demands for equal rights",
      "description": "The user is projected onto the visual material of the woman with injuries, as the meme frames her suffering as the direct reason for the demand for equal rights. The text 'and this is why' explicitly directs the viewer to interpret the woman's trauma as the causal explanation, thereby projecting the user's perspective onto her as the symbolic representation of the justification for women's rights activism. This projection is reinforced by the direct gaze of the woman, which creates an implicit connection between the viewer and the subject of suffering.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41478b0b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5b3407e3",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Mysogynous",
      "description": "The meme frames the demand for women's equal rights as a direct consequence of individual trauma and suffering, reducing the complex, systemic issue of gender inequality to personal victimhood. This reinforces harmful stereotypes that portray women as inherently vulnerable and in need of protection, thereby objectifying and pathologizing women's experiences. The visual of the injured woman is used as a symbolic representation of the 'why' behind the demand, which can be interpreted as a misogynous framing that equates women's activism with personal victimization rather than broader social and political movements.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41478b0b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_39af15a3",
      "@type": "TargetCommunity",
      "instance_name": "person",
      "label": "woman with visible injuries",
      "description": "The central visual entity, a woman with physical injuries, is presented as the symbolic representation of the suffering that motivates the demand for equal rights. This framing targets audiences who may be sympathetic to the plight of women experiencing violence, or who are familiar with narratives that link personal trauma to social justice movements. The image leverages emotional appeal to evoke empathy and validate the call for equal rights, suggesting the target audience is likely to be individuals who resonate with or support gender equality causes, but also potentially those who are susceptible to pity narratives or misogynous framing that reduces systemic issues to individual victimhood.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41478b0b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
