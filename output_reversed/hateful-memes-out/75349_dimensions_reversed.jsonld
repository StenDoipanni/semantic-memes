    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c1c55fd1",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_stereotype",
      "label": "Antisemitic Stereotype",
      "description": "A derogatory and false belief or trope about Jewish people, often used to justify hatred and violence. The meme relies on the antisemitic stereotype that Jews are 'cheap' or 'penny-pinching' (implied by 'well done' as a cheap meal) and that their extermination is a 'normal' or 'acceptable' act. This stereotype is part of a broader historical pattern of antisemitic propaganda used by the Nazis.",
      "belongsToAnalysis": {
