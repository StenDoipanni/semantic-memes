    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d8277673",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The phrase 'allah akbar!' is mapped onto the Black Muslim woman speaking at the podium.",
      "description": "The text 'allah akbar!' is overlaid on the image of the Black Muslim woman speaking. This creates an analogical mapping where the woman is being represented as the source or embodiment of the phrase 'allah akbar!'. The meme weaponizes this phrase by associating it with imminent violence, thereby projecting the stereotype that Muslims (represented by this woman) are inherently violent or associated with terrorism. This mapping is central to the meme's hateful intent, as it misrepresents the religious phrase and links it to the visual representation of a Muslim woman, thereby stigmatizing her and her community.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f29f4b9a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6980f406",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material implying imminent violence",
      "description": "The user is projected onto the text 'next thing you know everyone is dead', which uses a deictic-like framing ('next thing you know') to imply that the user (or anyone who hears 'allah akbar!') will witness mass death. This creates a direct projection of the user's potential experience or consequence onto the textual material, making the user feel personally implicated in the violent outcome.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f29f4b9a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
