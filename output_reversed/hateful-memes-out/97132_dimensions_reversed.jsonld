    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_48dd7efc",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The man in the image is mapped as a representative of the stereotype described in the text.",
      "description": "The textual material 'in the muslim world all gay men are well hung' explicitly generalizes and sexualizes gay men in the Muslim world. The visual material, a well-dressed, conventionally attractive man, is used to visually represent and reinforce this harmful stereotype. The man's appearance (dark hair, beard, formal suit, serious expression) is mapped onto the textual description of 'well hung' gay men, creating an analogical mapping where the visual entity serves as a symbolic representation of the stereotype described in the text. This mapping is spatially reinforced by the man's central position and the text's placement at the bottom, directly associating the visual with the harmful generalization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_57625b4f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4f1c7560",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the stereotypical representation of gay men in the Muslim world",
      "description": "The user is projected onto the scene where the visually attractive man is used to represent the harmful stereotype described in the text. The user is implicitly invited to identify with or project their own biases onto this representation, which is constructed to reinforce the stereotype of hypersexualized gay men in the Muslim world. There are no explicit deictic pronouns like 'me' or 'you', but the meme's structure (visual + text) creates an implicit projection where the viewer is positioned as the one who 'sees' or 'understands' the stereotype, thereby internalizing or being complicit in its perpetuation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_57625b4f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
