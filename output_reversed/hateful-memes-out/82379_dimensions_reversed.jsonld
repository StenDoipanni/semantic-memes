    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f95a985f",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The text 'white trash' is mapped onto the visual appearance of the man and woman.",
      "description": "The overlaid text 'there's so much white trash in this picture i barely know where to start!' uses the derogatory stereotype 'white trash' to mock the visual presentation of the man and woman. The text explicitly labels their appearance (e.g., the man's gold chains, hat, and the woman's shiny top and patterned pants) as 'white trash', creating an analogical mapping between the stereotype and their visual material. This mapping is based on the juxtaposition of the text with the visual subjects, projecting the stereotype onto them.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7dffa989"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e1bc2846",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material mocking the subjects",
      "description": "The user is projected onto the overlaid text 'there's so much white trash in this picture i barely know where to start!' which serves as the primary semiotic anchor for the meme's intent. The text functions as a direct address to the viewer, inviting them to share the user's perspective of the subjects as 'white trash'. This projection is not deictic (e.g., 'you' or 'me') but is implied through the user's identification with the meme's judgmental stance, making the text the focal point of the user's projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7dffa989"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
