    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6d49e4bc",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_stereotype",
      "label": "Misogynous Stereotype",
      "description": "The meme relies on the stereotype that women's emotional expressions (like pouting) should compel men to submit or concede arguments, reducing women's emotional states to a tool for male behavioral control. This is a misogynistic trope that objectifies women by focusing on their bodies and linking their emotional displays to male submission.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fd36db13"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_817865d1",
      "@type": "BackgroundKnowledge",
      "instance_name": "homophobic_slur",
      "label": "Homophobic Slur",
      "description": "The use of the slur 'motherfucker you gay' is a homophobic insult used to shame or demean men who do not immediately concede to a woman's emotional display. This leverages the fear of being labeled gay as a social punishment to enforce gendered behavioral norms.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fd36db13"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_04522d3d",
      "@type": "BackgroundKnowledge",
      "instance_name": "gendered_behavior_norm",
      "label": "Gendered Behavior Norm",
      "description": "The meme implicitly references the social expectation that men should be submissive to women's emotional cues, particularly in domestic or interpersonal settings. This norm is enforced through ridicule and shame, using gendered stereotypes to reinforce male compliance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fd36db13"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3627b16c",
      "@type": "BackgroundKnowledge",
      "instance_name": "objectification",
      "label": "Objectification",
      "description": "The visual focus on the woman's backside and underwear, combined with the text, objectifies her body as a cue for male behavior rather than as a person with agency or emotional depth. This is a common tactic in misogynistic memes to reduce women to physical attributes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fd36db13"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
