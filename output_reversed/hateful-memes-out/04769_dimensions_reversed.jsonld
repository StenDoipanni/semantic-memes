    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3c61422e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The woman's pouting expression is mapped as the trigger for male submission",
      "description": "The text 'if she's pouting like this' directly maps onto the visual depiction of the woman viewed from behind, suggesting her posture and expression (pouting) are the key visual cue that should compel the male viewer to immediately drop the argument. The visual entity (woman_pouting_at_window) is the subject of the textual condition, establishing an analogical mapping where the woman's emotional state (pouting) is the trigger for the behavioral norm described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fd36db13"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_08e56cea",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the viewer's expected behavioral response to the woman's pouting",
      "description": "The user is projected onto the implied 'you' in the text, which commands the viewer to immediately drop the argument if the woman is pouting. This creates a direct address to the user, positioning them as the male figure expected to comply with the misogynistic norm. The projection is onto the textual material that demands action from the viewer, making the user the subject of the behavioral expectation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fd36db13"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
