    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f887f257",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "target_community",
      "description": "The intended audience is individuals who may be exposed to or propagate racist stereotypes, particularly those who hold or are influenced by anti-Black racist ideologies. The meme is designed to resonate with or reinforce harmful beliefs about Black people being inherently criminal or primitive, targeting communities that normalize or perpetuate systemic racism and racialized dehumanization. The visual and textual elements are crafted to appeal to those who interpret the skeleton as a metaphor for Black inferiority, thereby validating or reinforcing existing prejudices against Black people.",
      "belongsToAnalysis": {
