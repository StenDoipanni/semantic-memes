    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_762e2b7c",
      "@type": "VisualMaterial",
      "instance_name": "human_skeleton",
      "label": "a human skeleton partially buried in dirt",
      "description": "The central visual element is a human skeleton, likely of an adult, partially unearthed from soil. The skull, ribcage, spine, and limbs are visible, covered in dirt and sediment. The skeleton is positioned upright, suggesting it was buried in a standing or seated posture. The visual is stark and macabre, evoking themes of death, decay, and primitiveness. Its prominence and context are critical to the meme's message, as it is used as a visual metaphor for dehumanization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04602346"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b45c1403",
      "@type": "Scene",
      "instance_name": "dehumanizing_metaphor",
      "label": "dehumanizing_metaphor",
      "description": "The scene depicts a human skeleton as a visual metaphor for dehumanization, used to imply that Black people are inherently primitive or animal-like. The skeleton is positioned upright in dirt, and overlaid text reinforces the harmful stereotype that 'not all black people are criminals'. The visual and textual elements are directly related to create a racially charged message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04602346"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_271c953f",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_criminality",
      "label": "Anti-Black Stereotype: Criminal Behavior Associations",
      "description": "This stereotype falsely associates Black people with criminality, implying they are inherently more prone to crime. It is a well-documented racist trope used to justify systemic discrimination, mass incarceration, and racial profiling. The meme uses this stereotype as its core message, even though the text explicitly denies it, creating a paradoxical and dangerous framing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04602346"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b7595a91",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_primitiveness",
      "label": "Anti-Black Stereotype: Primitiveness/Animal-like Metaphors",
      "description": "This stereotype dehumanizes Black people by comparing them to animals or primitive beings, often using imagery like skeletons, apes, or savages. It is used to imply inferiority, lack of civilization, and biological inferiority. The image of the skeleton directly invokes this trope, visually reinforcing the idea that Black people are 'primitive' or 'animal-like'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04602346"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dcbff38c",
      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_dehumanization",
      "label": "Racialized Dehumanization",
      "description": "The process of denying human dignity and rights to a racial group by portraying them as subhuman, animalistic, or less evolved. This is a core mechanism of systemic racism and is often used to justify violence, exploitation, and institutional oppression. The meme uses the skeleton image and the text to create a racially charged message of dehumanization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04602346"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a6387545",
      "@type": "BackgroundKnowledge",
      "instance_name": "systemic_racism",
      "label": "Systemic Racism",
      "description": "The systemic and institutionalized oppression of racial minorities, often through laws, policies, and social structures that disadvantage them. The meme implicitly references systemic racism by using a harmful stereotype to reinforce the idea that Black people are biologically predisposed to criminal behavior, which is a false narrative used to justify racial prejudice and inequality.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04602346"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e73b13f1",
      "@type": "EmotionExpression",
      "instance_name": "racialized_dehumanization",
      "label": "dehumanizing emotion",
      "description": "The emotion expressed is one of dehumanization, conveyed through the visual metaphor of a human skeleton, which evokes death, decay, and primitiveness. This visual is used to strip Black people of their humanity and portray them as subhuman or animal-like, reinforcing systemic racism and racialized prejudice. The emotion is not an affective state of the subject but a socially constructed and harmful sentiment embedded in the image's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04602346"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8a91ba76",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "skeleton as metaphor for Black people",
      "description": "The visual entity 'human_skeleton' is mapped onto the textual entity 'not all black people' to imply that Black people are inherently primitive or animal-like, reinforcing the harmful stereotype of racialized dehumanization. The skeleton serves as a visual metaphor for the dehumanizing trope that Black people are 'primitive' or 'animal-like', which is directly linked to the text's claim about criminality and racial inferiority.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04602346"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b35460e2",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the dehumanizing metaphor scene",
      "description": "The user is projected onto the scene where the human skeleton is used as a visual metaphor for dehumanization, implying that Black people are inherently primitive or animal-like. This projection is implicit, as the user is not directly addressed with deictic pronouns like 'you' or 'me', but the entire meme is constructed to make the viewer internalize the racist message by associating the visual of the skeleton with the targeted group. The user is thus projected onto the scene of racialized dehumanization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04602346"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
