      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dc8edeef",
      "@type": "BackgroundKnowledge",
      "instance_name": "1992_Los_Angeles_Riots",
      "label": "1992 Los Angeles Riots",
      "description": "A series of civil disorders that erupted in Los Angeles, California, following the acquittal of police officers involved in the beating of Rodney King. The riots lasted for several days and resulted in widespread destruction, over 50 deaths, and thousands of injuries. The event is historically significant as a major expression of racial injustice and police brutality in the United States. The meme falsely claims that 'African American leaders' were 'organizing' the riots, which is a racist distortion of the legitimate anger and protest of the Black community.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f0bd0c07"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4086b671",
      "@type": "BackgroundKnowledge",
      "instance_name": "Rodney_King",
      "label": "Rodney King",
      "description": "An African American man who was severely beaten by Los Angeles police officers on March 3, 1991. The incident was captured on video and sparked national outrage. The subsequent acquittal of the officers in April 1992 was a catalyst for the 1992 Los Angeles riots. His case became a symbol of systemic racism and police brutality in America.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f0bd0c07"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_55cbd994",
      "@type": "BackgroundKnowledge",
      "instance_name": "Anti_Black_Stereotype_Aggressive_Violent_Nature",
      "label": "Anti-Black Stereotype: Aggressive/Violent Nature",
      "description": "A racist trope that falsely claims Black people are inherently violent or criminal, often used to justify discrimination, police brutality, or to scapegoat Black communities for civil unrest. This stereotype is central to the meme's hateful intent, as it attempts to delegitimize the legitimate protest of the Black community by implying that African American leaders were orchestrating violence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f0bd0c07"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0d4afbbd",
      "@type": "BackgroundKnowledge",
      "instance_name": "Racial_Scapegoating",
      "label": "Racial Scapegoating",
      "description": "The practice of blaming a racial or ethnic group for societal problems or events, often to deflect responsibility or to incite division. In this meme, the false claim that 'African American leaders' organized the riots is an example of racial scapegoating, which attempts to shift blame onto Black communities for the chaos of the riots, ignoring the root causes of systemic racism and police brutality.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f0bd0c07"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_16a5b914",
      "@type": "BackgroundKnowledge",
      "instance_name": "Historical_Inaccuracy",
      "label": "Historical Inaccuracy",
      "description": "The meme's claim that 'African American leaders' were 'organizing' the 1992 Los Angeles riots is historically inaccurate. The riots were a spontaneous outburst of anger and protest by the Black community, not a coordinated effort by leaders. This inaccuracy is used to promote a false narrative that blames Black leadership for the riots, which is both historically inaccurate and racially charged.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f0bd0c07"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d3cd5185",
      "@type": "BackgroundKnowledge",
      "instance_name": "Racist_Trope",
      "label": "Racist Trope",
      "description": "A widely circulated and often harmful stereotype or narrative that is used to demean or dehumanize a group. The meme relies on the racist trope that Black people are inherently violent or criminal, which is used to justify the false claim that African American leaders were organizing the riots. This trope is a key element of the meme's hateful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f0bd0c07"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_09e88aec",
      "@type": "EmotionExpression",
      "instance_name": "hate",
      "label": "hateful emotion",
      "description": "The emotion expressed is hate, conveyed through the false and racially charged text overlay that falsely claims 'African American leaders organizing the la riots', which is a hateful distortion of historical events. This emotion is directed at African Americans and aims to delegitimize their legitimate protest by implying they were orchestrating violence, promoting a racist trope that scapegoats Black communities for civil unrest.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f0bd0c07"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_838a6a82",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Text falsely claims African American leaders are organizing the riots, mapped onto the chaotic riot scene",
      "description": "The top text overlay 'african american leaders organizing the la riots' is analogically mapped onto the visual material of the chaotic riot scene. The text falsely attributes organization and leadership to African American leaders, while the visual material depicts the actual riots — a spontaneous outburst of protest and violence — thereby creating a false equivalence. This mapping is central to the meme's hateful intent, as it uses the visual chaos to imply that African American leaders were orchestrating the violence, which is a racist trope that scapegoats Black communities for civil unrest.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f0bd0c07"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c3b3eb1d",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the chaotic riot scene",
      "description": "The user is projected onto the chaotic riot scene (chaotic_riot_scene) as the target of the meme's hateful message. The meme visually depicts the riots and overlays text falsely attributing organization to African American leaders, thereby projecting the user's perception onto the scene as a site of racialized blame and violence. The user is implicitly positioned as someone who might accept or be influenced by the false narrative, making the scene the focal point of the projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f0bd0c07"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a28811c0",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme falsely claims that 'African American leaders' were 'organizing' the 1992 Los Angeles riots, which is a direct attack on African Americans based on race. It promotes a false narrative that blames Black leadership for the riots, which is both historically inaccurate and racially charged. The intent is to incite racial division and reinforce harmful stereotypes about Black people being inherently violent or criminal.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f0bd0c07"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eb4e5fde",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who may be exposed to racially charged misinformation, particularly those who hold or are susceptible to anti-Black stereotypes, such as the belief that Black people are inherently violent or criminal. The meme is designed to appeal to or reinforce these prejudiced views by falsely attributing the 1992 Los Angeles riots to 'African American leaders,' thereby promoting racial scapegoating. It likely targets audiences who are already predisposed to racial division, misinformation, or who benefit from or are entertained by narratives that delegitimize Black protest and community anger. The meme’s hateful intent suggests it is crafted to incite racial tension and reinforce harmful stereotypes, making its primary target community those who consume and share such content without critical analysis.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f0bd0c07"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
