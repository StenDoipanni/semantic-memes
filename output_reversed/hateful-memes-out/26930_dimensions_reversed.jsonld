    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_83699847",
      "@type": "Scene",
      "instance_name": "chaotic_riot_scene",
      "label": "chaotic riot scene",
      "description": "A scene depicting the 1992 Los Angeles riots, featuring a burning car as the central focal point, with people scattered around in various states of movement and observation, creating a sense of disorder and unrest. The scene is overlaid with text claiming 'african american leaders organizing the la riots april 29, 1992', which is historically inaccurate and racially charged.",
      "belongsToAnalysis": {
