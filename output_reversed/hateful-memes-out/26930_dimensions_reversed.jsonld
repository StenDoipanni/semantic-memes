    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e62a7e49",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: african american leaders organizing the la riots april 29, 1992; hasOverallIntent: Hateful; overall-intent-description: The image depicts a scene from the 1992 Los Angeles riots, with a burning car and people in the background. The overlaid text falsely claims that 'African American leaders' were 'organizing' the riots. This is a harmful and hateful distortion of historical events. It attempts to delegitimize the legitimate anger and protest of the Black community following the acquittal of police officers involved in the beating of Rodney King. The meme uses the visual chaos of the riots to imply that African American leaders were orchestrating violence, which is a racist trope that scapegoats Black communities for civil unrest. This is a direct attack on African Americans based on race, promoting a false narrative that blames Black leadership for the riots, which is both historically inaccurate and racially charged. The intent is to incite racial division and reinforce harmful stereotypes about Black people being inherently violent or criminal, which falls under the category of hateful content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f0bd0c07"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
