    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5878386d",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Chevy truck mapped as 'owner' in the joke",
      "description": "The textual joke 'what do chevy trucks have in common with their owners? they've both blown a tranny.' creates an analogical mapping where the vintage_blue_Chevrolet_truck is implicitly mapped as the 'owner' in the pun. The joke equates the truck (a vehicle) with its owner, suggesting both have experienced a transmission failure. This mapping is established through the pun's structure, where the truck is personified as if it were an owner, creating a humorous analogy between the mechanical failure of the truck and the implied failure of the owner (via the slur 'tranny').",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1b481df2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b74ee3c6",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual joke as the implied 'owner'",
      "description": "The user is projected onto the textual material (text_chunk) through the pun 'they've both blown a tranny.' The joke implicitly equates the user (as the owner) with the vintage_blue_Chevrolet_truck, suggesting the user is the 'owner' who has 'blown a tranny.' This projection is not explicit with deictic pronouns like 'you' or 'me,' but is inferred through the rhetorical structure of the joke, where the user is positioned as the 'owner' in the analogy. The user is thus projected onto the text_chunk, which frames them as the subject of the implied comparison.",
      "belongsToAnalysis": {
