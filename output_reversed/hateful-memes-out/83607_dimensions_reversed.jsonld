      "@id": "http://example.org/multimodal-taxonomy#dimension_7e1c64b1",
      "@type": "BackgroundKnowledge",
      "instance_name": "harmful_intent",
      "label": "Harmful Intent",
      "description": "The meme is classified as having a 'harmful' intent because it can be psychologically distressing or alienating to the recipient. It damages self-esteem or social standing by labeling humor as 'dark' and 'worrying'. Understanding the concept of 'harmful intent' is necessary to interpret the meme's potential negative psychological impact, which is amplified by the visual of Ramsay's intense expression.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_18b6345a"
      },
      "extractionMethod": "llm_extraction_huggingface"
