    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dead1d08",
      "@type": "BackgroundKnowledge",
      "instance_name": "gordon_ramsay",
      "label": "Gordon Ramsay",
      "description": "Gordon Ramsay is a well-known British chef, television personality, and restaurateur. He is famous for his fiery temper and confrontational style on television shows like 'Hell's Kitchen' and 'MasterChef'. His public persona is often associated with intense criticism and scolding, which makes his angry expression in the image a recognizable and culturally resonant visual cue for harsh judgment or criticism. The meme leverages his real-world reputation to amplify the perceived severity of the message.",
      "belongsToAnalysis": {
