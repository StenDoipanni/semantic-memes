    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e7125621",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The recipient of the criticism is mapped onto the person facing Gordon Ramsay.",
      "description": "The text 'your sense of humor is so dark, people are worried about you.' directly addresses an individual whose humor is being criticized. This individual is visually represented by the person whose back is turned to the camera, facing Gordon Ramsay. The meme uses this visual to project the 'you' in the text onto this specific person, making them the target of the criticism. The confrontational scene reinforces this mapping by showing the recipient in the context of being scolded.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_18b6345a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b0f16b3a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the recipient of the criticism",
      "description": "The user is projected onto the person facing Gordon Ramsay, who is visually represented as the target of the criticism. The text 'your sense of humor is so dark, people are worried about you.' directly addresses 'you', which is deictically linked to the person whose back is turned to the camera. The confrontational scene reinforces this projection by situating the user as the recipient of the scolding. The user sees themselves as the 'you' in the text, and the visual of the person facing Ramsay becomes the embodied representation of that 'you'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_18b6345a"
      },
      "extractionMethod": "llm_extraction_huggingface"
