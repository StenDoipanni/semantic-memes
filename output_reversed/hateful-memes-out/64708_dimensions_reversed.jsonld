    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_539ea07d",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The man is mapped as 'dad' in the context of 'spending quality time with dad'",
      "description": "The text 'spending quality time with dad' explicitly refers to the man as 'dad'. The visual material (the man) is thus mapped onto the textual role of 'dad'. This mapping is direct and explicit, as the text directly assigns the role of 'dad' to the person depicted. The mugshot format adds a layer of irony or mockery to this mapping, implying that being 'dad' is somehow criminal or suspect.",
      "belongsToAnalysis": {
