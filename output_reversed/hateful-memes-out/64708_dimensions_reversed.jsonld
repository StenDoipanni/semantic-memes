    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2e06dec4",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man as 'dad'",
      "description": "The user is projected onto the visual material of the Black man, who is explicitly labeled as 'dad' by the textual material 'spending quality time with dad'. The user identifies with or imagines themselves in the role of 'dad' as depicted, even though the meme uses a mugshot format to mock this familial role. The projection is implicit, not deictic, but the user is invited to see themselves as the 'dad' in the scene, making the man a stand-in for the user's own father or self-identification as a father.",
      "belongsToAnalysis": {
