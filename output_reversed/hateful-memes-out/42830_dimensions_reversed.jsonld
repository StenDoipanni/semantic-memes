    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e65ed4f0",
      "@type": "BackgroundKnowledge",
      "instance_name": "tornado",
      "label": "Tornado",
      "description": "A violent, rotating column of air extending from a thunderstorm to the ground. Tornadoes are natural meteorological phenomena, not man-made. The meme's absurd premise hinges on the false notion that such powerful natural events can be artificially created and controlled by human agencies.",
      "belongsToAnalysis": {
