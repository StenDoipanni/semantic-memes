    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_410253f9",
      "@type": "BackgroundKnowledge",
      "instance_name": "conspiracy_theory",
      "label": "Conspiracy Theory",
      "description": "A theory that a secret group or organization is responsible for events that are officially explained as natural or accidental. The meme is a satirical example of this genre, using absurdity to highlight the irrationality of such theories. It relies on the cultural phenomenon of conspiracy thinking, which is prevalent in certain online communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2ea7eb0a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8ad6ac47",
      "@type": "BackgroundKnowledge",
      "instance_name": "satirical_meme",
      "label": "Satirical Meme",
      "description": "A form of internet humor that uses irony, exaggeration, or absurdity to critique or mock a subject. This meme uses the juxtaposition of a real-world insect swarm with a ludicrous government conspiracy to create humor and provoke skepticism about baseless theories. It is a common meme format used to expose the illogical nature of certain conspiracy narratives.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2ea7eb0a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_60af879b",
      "@type": "EmotionExpression",
      "instance_name": "skepticism",
      "label": "skeptical emotion",
      "description": "The emotion expressed is skepticism, conveyed through the absurd and implausible premise of the text overlay suggesting that tornadoes are secretly created by the government to destroy grasshoppers. This juxtaposition of a real-world phenomenon (grasshopper swarm) with a ludicrous conspiracy theory is designed to provoke doubt and mockery toward baseless theories.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2ea7eb0a"
