    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5739ce9b",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_slavery_comparison",
      "label": "Anti-Black Stereotype: Equating Black people with slavery",
      "description": "The meme explicitly uses a racist metaphor by equating the preference for 'extra dark' coffee with owning enslaved people. This is a direct invocation of the historical trauma of chattel slavery in the United States and other regions, which was a system of forced labor and human bondage. The visual of chained feet reinforces this comparison, making it a dehumanizing and hateful stereotype that reduces Black people to the historical context of slavery.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_af1093e9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2e8c4e4c",
      "@type": "BackgroundKnowledge",
      "instance_name": "chattel_slavery",
      "label": "Chattel Slavery",
      "description": "The meme references the historical institution of chattel slavery, where human beings were treated as property and forced into labor. The visual of shackled feet and the text 'i like my slaves' directly invoke this brutal system, which was central to the economies of the Americas and the United States, and caused immense suffering and racial trauma. Understanding this historical context is essential to comprehend the hateful nature of the meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_af1093e9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7d4f3441",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_trauma",
      "label": "Racial Trauma",
      "description": "The meme taps into the deep-seated racial trauma experienced by Black communities due to the legacy of slavery and systemic racism. By trivializing slavery as a 'choice' or 'taste', the meme attempts to normalize and downplay the horrors of human bondage, which is a form of psychological and cultural harm that continues to affect Black people today.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_af1093e9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8bb119f3",
      "@type": "BackgroundKnowledge",
      "instance_name": "dehumanizing_metaphor",
      "label": "Dehumanizing Metaphor",
      "description": "The meme uses a dehumanizing metaphor to equate a personal preference (coffee) with the ownership of enslaved people. This metaphor is inherently racist and offensive because it reduces human beings to objects of consumption or preference, thereby denying their inherent dignity and humanity. This is a common tactic in racist discourse to normalize oppression.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_af1093e9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7994a92a",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_context_of_slavery",
      "label": "Historical Context of Slavery",
      "description": "The meme relies on the historical context of slavery in the United States and other regions, where millions of Africans were forcibly brought to the Americas and enslaved. The visual of shackled feet and the text 'i like my slaves' directly reference this history, which is a foundational part of the racial and social fabric of many countries. Understanding this history is necessary to grasp the full impact of the meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_af1093e9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c8662ead",
      "@type": "BackgroundKnowledge",
      "instance_name": "racist_metaphor",
      "label": "Racist Metaphor",
      "description": "The meme employs a racist metaphor by comparing the consumption of dark coffee to the ownership of enslaved people. This is a form of racialized language that uses a benign or mundane activity to justify or normalize a horrific historical and ongoing injustice. This metaphor is a tool of racist ideology and is deeply offensive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_af1093e9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
