    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_793c1e37",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Slaves are mapped to the chained person",
      "description": "The text 'i like my slaves' directly maps to the visual of the chained person, equating the enslaved person with a commodity or object of preference, as referenced in the racist metaphor. The visual of the shackled feet reinforces the metaphor of human bondage, making the chained person the visual instantiation of 'slaves' in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_af1093e9"
