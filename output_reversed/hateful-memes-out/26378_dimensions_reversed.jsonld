    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6d73eb36",
      "@type": "BackgroundKnowledge",
      "instance_name": "anthropomorphism",
      "label": "Anthropomorphism",
      "description": "The attribution of human characteristics, emotions, or behaviors to non-human entities, such as animals. In this meme, the squirrel is portrayed as having human-like thoughts and existential dilemmas, which is a common comedic device in internet culture.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_79264468"
