      "@id": "http://example.org/multimodal-taxonomy#dimension_7c490cc7",
      "@type": "BackgroundKnowledge",
      "instance_name": "existential_confusion",
      "label": "Existential confusion",
      "description": "A human concept referring to the feeling of uncertainty, lack of purpose, or questioning one's life direction. This is a common social and psychological experience, often humorously anthropomorphized in memes to relate to everyday life struggles.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_79264468"
      },
