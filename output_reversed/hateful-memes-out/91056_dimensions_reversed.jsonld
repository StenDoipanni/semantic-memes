    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f6120f36",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_ernie_as_minority_in_oven",
      "label": "Ernie is mapped as the minority locked in his oven",
      "description": "The hateful text overlay explicitly states 'what type of minority is locked in his oven', directly mapping the visual entity Ernie to the role of 'minority locked in his oven'. This is a deliberate and harmful analogical mapping that weaponizes Ernie's innocent, childlike appearance to deliver an antisemitic stereotype. The text positions Ernie as the subject of the metaphor, creating a jarring juxtaposition where the non-threatening Muppet character is equated with a persecuted minority group in a violent, dehumanizing context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d959eebf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6eac93a3",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the hateful text overlay scene",
      "description": "The user is projected onto the hateful text overlay scene, which contains the explicit antisemitic message 'ernie leaves letter clues about what type of minority is locked in his oven.' The meme does not contain any explicit deictic pronouns like 'me' or 'you,' but the user is implicitly projected onto the scene by being the recipient of the hateful message and the intended audience for the antisemitic stereotype being deployed. The user is expected to interpret the image and text as a provocative, hateful statement directed at them or society at large.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d959eebf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
