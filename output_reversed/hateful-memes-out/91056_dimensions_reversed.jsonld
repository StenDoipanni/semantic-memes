  "dimensions": [
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_98f943e8",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: ernie_leaves_letter_clues_about_what_type_of_minority_is_locked_in_his_oven; hasOverallIntent: Hateful; overall-intent-description: The image features the Muppet character Ernie, with overlaid text that reads: 'ernie leaves letter clues about what type of minority is locked in his oven.' This is a deliberately offensive and hateful meme that uses the character of Ernie (a white, non-disabled, non-LGBTQ+ male Muppet) to imply that a racial or ethnic minority is being metaphorically 'locked in an oven,' which is a violent and dehumanizing metaphor. The phrase 'locked in his oven' is a direct reference to the historical and ongoing antisemitic trope of 'the Jew in the oven,' which is a hateful and dangerous stereotype. The meme weaponizes this imagery to target a minority group, using the innocent, childlike character of Ernie to create a jarring and disturbing juxtaposition. The intent is to provoke discomfort and to spread hate by associating a protected group with a violent, antisemitic metaphor. The meme is not merely humorous or satirical; it is explicitly hateful and potentially harmful, as it promotes antisemitic imagery and stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d959eebf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
