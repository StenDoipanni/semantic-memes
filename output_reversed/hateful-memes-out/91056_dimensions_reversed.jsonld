    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_72e5e54b",
      "@type": "Scene",
      "instance_name": "hateful_text_overlay_scene",
      "label": "Ernie with hateful text overlay",
      "description": "The scene features the Muppet character Ernie as the central visual element, positioned against a dark background. Overlaid on the image is hateful text that reads: 'ernie leaves letter clues about what type of minority is locked in his oven.' The text is directly related to Ernie, using his innocent, childlike appearance to deliver a violent antisemitic message. The spatial arrangement places Ernie centrally, with the text positioned above and below him, creating a jarring juxtaposition.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d959eebf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e76cef0e",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_stereotype",
      "label": "Antisemitic Stereotype: 'Jew in the Oven'",
      "description": "This is a historically rooted antisemitic trope that depicts Jews as being metaphorically or literally locked in an oven, often used to evoke imagery of persecution, genocide, or dehumanization. The meme weaponizes this stereotype by associating it with the Muppet character Ernie, creating a jarring and hateful juxtaposition. This trope is deeply tied to the Holocaust and has been used to incite hatred against Jewish people.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d959eebf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c94677a0",
      "@type": "BackgroundKnowledge",
      "instance_name": "erased_context_of_ernie",
      "label": "Ernie as a Non-Threatening, Innocent Character",
      "description": "Ernie is a well-known, childlike, and non-threatening Muppet character from Sesame Street, typically associated with innocence, cheerfulness, and childlike curiosity. The meme exploits this perception by using his innocent appearance to contrast with the hateful message, thereby amplifying the shock and harm of the stereotype. This contrast is central to the meme’s intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d959eebf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0f620b14",
      "@type": "BackgroundKnowledge",
      "instance_name": "holocaust_denial_minimization",
      "label": "Holocaust Denial or Minimization Themes",
      "description": "The meme implicitly references the Holocaust by invoking the 'oven' metaphor, which is historically associated with the gas chambers of Nazi concentration camps. By using this imagery in a hateful context, the meme may be attempting to trivialize or minimize the horror of the Holocaust, which is a form of historical revisionism and antisemitic propaganda.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d959eebf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3ee302de",
      "@type": "BackgroundKnowledge",
      "instance_name": "puppet_master_imagery",
      "label": "Puppet Master Imagery as Antisemitic Tropes",
      "description": "The term 'puppet master' is an antisemitic trope that implies Jewish people control global events or media. While not explicitly stated, the use of a puppet (Ernie) in the meme may be a subtle reference to this trope, suggesting that the 'minority' being locked in the oven is being manipulated or controlled — a dangerous and dehumanizing stereotype.",
      "belongsToAnalysis": {
