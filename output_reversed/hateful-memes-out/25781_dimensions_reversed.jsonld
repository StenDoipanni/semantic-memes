    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_36ddc7f8",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Racial slur metaphor mapped onto the Black man running",
      "description": "The text 'do you have any idea how black you were going' is an analogical mapping that projects the derogatory racial slur 'black' (implying criminality or menace) onto the visual entity 'Black_man_running'. This mapping equates the man's dark skin with a negative stereotype, reducing his identity to a racialized caricature. The text explicitly uses 'black' as a metaphor for danger or criminality, which is visually represented by the man being chased by police in a confrontational scene.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3cd7f289"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ec05ff35",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the text 'do you have any idea how black you were going' because the text uses the second-person pronoun 'you', directly addressing the viewer and inviting them to identify with the rhetorical question. This creates a semiotic projection where the user is positioned as the subject of the rhetorical inquiry, making them feel personally implicated in the meme's racially charged message.",
      "belongsToAnalysis": {
