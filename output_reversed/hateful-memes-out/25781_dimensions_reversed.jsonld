    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_96c00dcb",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The target community is individuals who may be familiar with or perpetuate anti-Black racist stereotypes, particularly those who find humor or validation in racially charged metaphors that equate dark skin with criminality or danger. The meme is designed to resonate with audiences who either endorse or are indifferent to systemic racism, and who may interpret the visual of a Black man being chased by police as a justification for the derogatory text. This includes communities that engage with or circulate hate-based content, often online, where such memes are used to reinforce harmful narratives about Black people. The audience is likely to be those who are not directly targeted by the stereotype but who may find the meme’s message amusing, provocative, or relatable within a context of racial prejudice.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3cd7f289"
      },
      "extractionMethod": "llm_extraction_huggingface"
