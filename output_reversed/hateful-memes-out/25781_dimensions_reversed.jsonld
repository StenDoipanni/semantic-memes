    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a32d244e",
      "@type": "Scene",
      "instance_name": "chasing_scene",
      "label": "Black man being chased by police officers",
      "description": "A Black man is running away from a group of police officers who are in pursuit. The scene takes place on a city street with a building in the background. The police officers are equipped with riot gear, including helmets and shields, suggesting a tense or confrontational situation. The man appears to be in a state of urgency or fear. The text overlay 'do you have any idea how black you were going' adds a racially charged context to the scene, implying a derogatory stereotype about Blackness.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3cd7f289"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_02f59225",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_criminal_behavior",
      "label": "Anti-Black Stereotype: Criminal Behavior Associations",
      "description": "The meme relies on the harmful stereotype that Black people are inherently criminal or dangerous, which is reinforced by the text 'do you have any idea how black you were going'. This phrase uses 'black' as a racial slur implying criminality or menace, reducing the individual to a racialized caricature. This stereotype is a core component of systemic racism and is not visible in the image but is essential to understanding the meme's hateful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3cd7f289"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3d520d56",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_slur_metaphor",
      "label": "Racial Slur Metaphor",
      "description": "The phrase 'how black you were going' is a derogatory racial metaphor that equates dark skin with criminality or danger. This is not a literal description but a loaded, offensive trope rooted in historical racism. It is essential background knowledge to interpret the meme's intent, which is to demean and dehumanize Black individuals by reducing their identity to a racialized, negative caricature.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3cd7f289"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4d5d8691",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_context_racial_tension",
      "label": "Historical Context of Racial Tension",
      "description": "The image, though not explicitly dated, depicts a scene of racialized police pursuit, which is a common trope in historical and contemporary narratives of anti-Black racism in Western societies. The visual of a Black man being chased by police in riot gear evokes real-world incidents of racial profiling and police brutality, which are not directly visible but are necessary to understand the meme's context and its reinforcement of systemic racism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3cd7f289"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_afdfdd95",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_aggressive_nature",
      "label": "Anti-Black Stereotype: Aggressive/Violent Nature Claims",
      "description": "The meme implicitly relies on the stereotype that Black people are inherently aggressive or violent, which is used to justify the portrayal of the Black man as a threat. This stereotype is not visible in the image but is essential to understanding the meme's intent to dehumanize and justify racialized fear or hostility toward Black individuals.",
      "belongsToAnalysis": {
