    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2ab2fa1b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_racing_for_pink_slips_in_africa",
      "label": "The joyful, active Black individuals on the beach are mapped as 'racing for pink slips in Africa'.",
      "description": "The text 'racing for pink slips in Africa' is juxtaposed with the visual of two Black men carrying women on their backs in a joyful, recreational setting on a beach. This creates an analogical mapping where the visual material (the happy, active individuals) is mapped onto the textual concept of 'racing for pink slips in Africa'. This mapping is harmful and misleading, as it falsely implies that the individuals are engaged in a competitive, economically-driven pursuit of jobs or employment, which is both inaccurate and reductive. The meme uses the visual of happiness and playfulness to contrast with the stereotype of economic desperation or 'racing' for jobs, potentially reinforcing negative racial stereotypes about Black people's economic status or work ethic. The phrase 'pink slips' (a term for termination notices) combined with 'in Africa' further implies a context of job insecurity or economic struggle, which is not only factually inaccurate but also perpetuates harmful racialized narratives about African economies and Black people's place within them.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7d366b14"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
