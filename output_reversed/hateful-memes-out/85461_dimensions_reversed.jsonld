    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_860c49b5",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience for this meme is likely individuals who are familiar with or perpetuate harmful racial stereotypes about Black people in Africa, particularly those who may hold or reinforce the stereotype of economic desperation or 'racing' for jobs. The meme is designed to appeal to viewers who understand the metaphorical use of 'pink slips' and the geographical reference to 'Africa' as a shorthand for economic struggle, often associated with anti-Black stereotypes. The audience may include those who find humor in juxtaposing joyful, active Black individuals with the stereotype of economic competition, potentially reinforcing or mocking the 'lazy/unemployed' or 'racialized economic desperation' tropes. The meme's intent to create a false equivalence suggests it targets an audience that is either unaware of the harmful implications or deliberately uses such imagery to perpetuate misinformation and racialized narratives.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7d366b14"
      },
      "extractionMethod": "llm_extraction_huggingface"
