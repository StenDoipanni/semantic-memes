    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_850450f8",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the authoritative figure as the speaker of the hateful analogy",
      "description": "The user is projected onto the visual material of the elderly man (Richard Nixon) in the image, who is implicitly identified as the speaker of the text 'i like my coffee like i like my slaves' and 'extra dark'. The user sees themselves as the person who holds this preference or identifies with the speaker, projecting their own identity or viewpoint onto the authoritative figure. This projection is reinforced by the man's stern, authoritative posture and expression, which aligns with the hateful tone of the statement. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the act of viewing the meme and identifying with the speaker's perspective constitutes a semiotic projection onto the visual material of the man.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6c7cc473"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7426bd31",
      "@type": "ToxicityAssessment",
