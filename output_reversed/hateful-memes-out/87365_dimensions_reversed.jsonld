    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ba0faed4",
      "@type": "VisualMaterial",
      "instance_name": "three_men",
      "label": "people",
      "description": "Three men are walking along a dirt path next to a fence in a desert-like environment. They are dressed in casual clothing, including t-shirts, jeans, and backpacks. Their posture and direction suggest movement, possibly walking away from the viewer. The men appear to be of Mexican descent, as implied by the meme's text overlay. Their presence is central to the visual material and is the primary subject of the image.",
      "belongsToAnalysis": {
