    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eb6bcf18",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Mexicans are mapped onto the walking men",
      "description": "The text 'mexicans road trip' explicitly maps the visual entities 'three_men' onto the category 'mexicans'. This is an analogical mapping where the visual depiction of the men walking along a fence line is interpreted as a 'road trip' for 'mexicans', which in the context of the meme, refers to undocumented migration. The mapping is reinforced by the visual context (desert, fence, walking) which aligns with the stereotype of border crossing, and the text directly labels the subjects as 'mexicans'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_668acc60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e5cd8248",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the text 'mexicans road trip' as the primary interpretive lens for the entire meme. The text explicitly labels the visual scene, forcing the user to interpret the walking men through the stereotypical and hateful framework of 'Mexicans on a road trip' — which in this context implies undocumented migration. The user's understanding of the image is mediated by this text, which acts as a deictic anchor for the entire semiotic projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_668acc60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
