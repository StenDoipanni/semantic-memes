    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_23b4ef4f",
      "@type": "Scene",
      "instance_name": "walking_men_along_fence",
      "label": "Three men walking along a fence line in a desert-like environment",
      "description": "The scene depicts three men walking in a line along a dirt path next to a barbed wire fence in a dry, desert-like landscape with cacti and sparse vegetation. The men are dressed casually in t-shirts, jeans, and backpacks, suggesting a journey or migration. Their movement is directed away from the viewer, and their posture indicates purposeful walking. The fence runs parallel to their path, creating a visual boundary. The overall composition suggests a narrative of movement across a border or through a harsh environment, reinforced by the meme's text overlay 'mexicans road trip', which frames the scene as a stereotypical depiction of undocumented migration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_668acc60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3317ef56",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_latino_hispanic_stereotypes",
      "label": "Anti-Latino/Hispanic Stereotypes",
      "description": "The meme relies on the stereotype that Mexicans are undocumented migrants who illegally cross borders, often portrayed as 'on the run' or 'undocumented.' This stereotype is used to dehumanize and vilify a specific ethnic group, associating them with criminality and danger. It is a form of racialized xenophobia that frames migration as inherently illegal and threatening.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_668acc60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_51585e3f",
      "@type": "BackgroundKnowledge",
      "instance_name": "border_crossing_imagery",
      "label": "Border Crossing Imagery",
      "description": "The visual of people walking along a fence line in a desert environment is culturally coded as 'border crossing' imagery. This imagery is often used in media and political discourse to represent undocumented immigration, particularly from Mexico to the United States. It implies danger, illegality, and a journey fraught with peril, which is a common trope in anti-immigrant rhetoric.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_668acc60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7b44c585",
