      "@id": "http://example.org/multimodal-taxonomy#dimension_dd7376f7",
      "@type": "EmotionExpression",
      "instance_name": "dehumanization",
      "label": "dehumanizing emotion",
      "description": "The image and text together portray the men as faceless, stereotypical 'undocumented migrants' on a dangerous journey, stripping them of individual humanity and reducing them to a racialized trope. This emotional expression is rooted in xenophobic fear and racial prejudice.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_668acc60"
      },
