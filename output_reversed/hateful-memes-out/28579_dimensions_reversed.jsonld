    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5fe75cb0",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the chimpanzee visual and the textual claim about Michelle Obama",
      "description": "The user is not explicitly projected onto any deictic pronoun like 'me' or 'you' in the text. However, the meme's structure and intent create an implicit projection where the user is positioned as the one interpreting the racist stereotype and the absurdity of the claim. The user is projected onto the visual material (chimp_shock_scene) and the textual material (text_chunk_1, text_chunk_2) as the recipient of the hateful message. The user is expected to recognize the chimpanzee as a symbol of the anti-Black stereotype and the text as a racist attack on Michelle Obama, thus internalizing the meme's projection of racialized hate speech.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f63d7f13"
      },
      "extractionMethod": "llm_extraction_huggingface"
