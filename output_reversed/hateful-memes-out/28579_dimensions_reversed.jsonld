    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0351eb79",
      "@type": "BackgroundKnowledge",
      "instance_name": "fundraising_event",
      "label": "Fundraising Event",
      "description": "A fundraising event is a public gathering or activity organized to raise money for a cause, organization, or individual. In this meme, the text implies Michelle Obama is holding a fundraising event for 'studying animal intelligence,' which is a satirical and absurd twist meant to mock her. The concept of fundraising is real-world knowledge needed to understand the meme’s setup.",
