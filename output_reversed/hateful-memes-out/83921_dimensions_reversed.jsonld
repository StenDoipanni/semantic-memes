    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ff9f7843",
      "@type": "BackgroundKnowledge",
      "instance_name": "Osama_bin_Laden",
      "label": "Osama bin Laden",
      "description": "Osama bin Laden was the founder and leader of the terrorist organization al-Qaeda. He was responsible for orchestrating the September 11, 2001 attacks on the United States, which killed nearly 3,000 people. He was widely regarded as one of the most wanted terrorists in history and was killed in a U.S. military operation in Pakistan in 2011. His image is globally recognized and associated with terrorism, extremism, and global conflict.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c2074ae2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eb182dda",
      "@type": "BackgroundKnowledge",
      "instance_name": "FaceApp",
      "label": "FaceApp",
      "description": "FaceApp is a mobile application that uses artificial intelligence to alter facial features in photos, including aging, gender-swapping, and applying filters. It gained widespread popularity for its ability to generate humorous or surreal images, but has also been criticized for enabling the creation of misleading or offensive content, such as generating images of real people with altered appearances or creating deepfake images of public figures.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c2074ae2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f0b97d1b",
      "@type": "BackgroundKnowledge",
      "instance_name": "Terrorism_associations",
      "label": "Terrorism associations",
      "description": "A stereotype that links certain religious or ethnic groups, particularly Muslims, with terrorism and violent extremism. This association is often used to justify political actions, discriminatory policies, or social prejudice against Muslim communities. It is a form of Islamophobia that oversimplifies complex geopolitical issues and ignores the diversity within Muslim populations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c2074ae2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eb112978",
      "@type": "BackgroundKnowledge",
      "instance_name": "Islamophobia",
      "label": "Islamophobia",
      "description": "A fear or prejudice against Islam and Muslims, often manifesting as stereotypes, discrimination, or hostility. It can include the belief that Islam is inherently violent or incompatible with Western values, or that Muslims are more likely to engage in terrorism. This is a form of systemic discrimination that can lead to social exclusion, hate crimes, and policy discrimination against Muslim communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c2074ae2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_874b3163",
      "@type": "BackgroundKnowledge",
      "instance_name": "AI_face_swapping_technology",
      "label": "AI face-swapping technology",
      "description": "A technology that uses artificial intelligence to digitally alter or swap faces in images or videos. This technology has been used for creative purposes, but also for malicious purposes such as creating deepfakes, which can be used to spread misinformation, impersonate individuals, or generate offensive or harmful content. The meme references the potential for this technology to produce absurd or inappropriate results.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c2074ae2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
