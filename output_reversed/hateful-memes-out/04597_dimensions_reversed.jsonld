    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5cdde2ad",
      "@type": "BackgroundKnowledge",
      "instance_name": "political_propaganda",
      "label": "Political Propaganda",
      "description": "Information, especially of a biased or misleading nature, used to promote a political agenda or ideology. The meme is an example of political propaganda designed to sway public opinion on gun control by associating it with increased danger and vulnerability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c5702f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_58daea9c",
      "@type": "EmotionExpression",
      "instance_name": "fear",
      "label": "fearful emotion",
      "description": "The emotion of fear is expressed through the text overlay claiming that 'leaders want innocent people to give up their guns and become even more defenseless,' which implies vulnerability and danger. This fear is reinforced by the visual of a gun on the Constitution, suggesting that losing gun rights equates to losing personal safety, and the mention of 'terrorist attacks innocent people with guns' evokes anxiety about external threats.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c5702f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cf83f4e2",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Gun as symbol of self-defense against terrorism",
      "description": "The top text 'terrorist attacks innocent people with guns' is mapped onto the visual entity 'revolver' to imply that the gun is the tool used by terrorists, thereby framing gun ownership as a necessary defense against such threats. The revolver, as a visual representation of firearms, is analogically mapped to the textual concept of 'guns' used by terrorists.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c5702f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_58f8106b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message as the target of gun control policy",
      "description": "The user is implicitly projected onto the audience of the meme, who are framed as 'innocent people' who are being targeted by political leaders to surrender their guns. The text 'leaders want innocent people to give up their guns' directly addresses the user as part of the group being affected by gun control policies, making the user a subject of the political narrative presented. The user is not explicitly addressed with 'you' or 'your', but the phrasing 'innocent people' creates an inclusive projection where the viewer identifies with the group being threatened, thus projecting themselves as the 'innocent people' in the meme's narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c5702f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4ee28059",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful Propaganda",
      "description": "The meme promotes a divisive political narrative that can be harmful by polarizing public discourse and potentially inciting violence or fear against those advocating for gun control. It frames gun control as a threat to personal safety and national security, implicitly blaming government leaders for encouraging vulnerability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c5702f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6e82b6f8",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "gun rights advocates",
      "description": "The meme is designed to resonate with individuals who support the right to bear arms, particularly those who view gun ownership as essential for self-defense against terrorism and who are skeptical of gun control measures. The visual elements (revolver on the Constitution, American flag) and text ('leaders want innocent people to give up their guns') are tailored to appeal to this community by invoking constitutional rights, patriotism, and fear of vulnerability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c5702f"
