    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_86ee2e94",
      "@type": "Scene",
      "instance_name": "name_introduction_scene",
      "label": "man_introducing_himself",
      "description": "A middle-aged man with gray hair and a gray beard, wearing a light-colored collared shirt, is positioned centrally against a plain gray background. He is looking directly at the camera with a neutral expression. A text overlay at the bottom of the image reads 'the name's todd... retodd,' which is a pun on the classic James Bond introduction, using a derogatory term related to intellectual disability. The scene represents the man introducing himself with a humorous or mocking intent, leveraging the juxtaposition of his ordinary appearance with the offensive text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ec781e5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ac649a79",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism_intelligence_slur",
      "label": "Intelligence-related slurs",
      "description": "The meme relies on the use of the word 'retard' as a derogatory slur targeting individuals with intellectual disabilities. This is a form of ableism that mocks or devalues people based on their cognitive abilities, which is a harmful stereotype and real-world concept outside the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ec781e5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4bdbcc9b",
      "@type": "BackgroundKnowledge",
      "instance_name": "james_bond_introduction",
      "label": "Classic James Bond introduction",
      "description": "The phrase 'the name's Todd... retodd' is a parody of the iconic James Bond character's self-introduction ('the name's Bond... James Bond'). This cultural reference is necessary to understand the humor or irony of the meme, as it juxtaposes a sophisticated spy persona with a derogatory term.",
      "belongsToAnalysis": {
