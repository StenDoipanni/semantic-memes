    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5eb0260e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The man is mapped as 'Todd... retodd'",
      "description": "The textual material 'the name's todd... retodd' is an analogical mapping that identifies the visual entity 'man' as the character 'Todd... retodd'. This mapping is established through the juxtaposition of the text with the man's image, creating a direct association where the man is being presented as the person named 'Todd... retodd'. The mapping is reinforced by the visual material (the man) being the subject of the text, and the text explicitly naming him, even though the name is a pun on a derogatory term.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ec781e5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_26ac7027",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man as 'Todd... retodd'",
      "description": "The user is projected onto the visual material of the man, as the meme uses the text 'the name's todd... retodd' to identify him. The user is invited to imagine themselves as the man being introduced, or to identify with the character 'Todd... retodd' who is being mocked. This projection is implicit, as there are no explicit deictics like 'me' or 'you', but the meme's structure (a self-introduction) and the user's role as the viewer of the meme create a projection onto the man as the subject of the joke.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ec781e5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
