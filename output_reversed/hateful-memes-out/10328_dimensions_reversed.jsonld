    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_45f17cd6",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The woman in the foreground is mapped as 'how dikes look' when paying for pads",
      "description": "The text 'how dikes look when they're in line paying for their pads' explicitly maps the visual entity 'woman_in_foreground' as the stereotypical representation of a 'dike' (a derogatory term for lesbians) in the context of purchasing feminine hygiene products. The woman's stern, disdainful expression and crossed arms are used to visually embody the stereotype of being frugal or overly concerned with cost, which the text attributes to lesbians. This is a direct analogical mapping where the visual subject is identified by the text as the embodiment of the stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8be65b56"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
