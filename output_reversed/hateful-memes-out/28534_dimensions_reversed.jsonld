    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b4e9793d",
      "@type": "AnalogicalMapping",
      "instance_name": "cowboy_way_of_doin_things_mapping",
      "label": "The cowboy is mapped as the embodiment of the 'cowboy way of doin things'",
      "description": "The text 'it's the cowboy way of doin things' explicitly maps the visual entity 'man' (the cowboy) onto the concept of the 'cowboy way'. The man's appearance (cowboy hat, leather jacket, rifle) and demeanor (serious, intense expression) are presented as the visual instantiation of the textual concept. This mapping reinforces the stereotype that the cowboy's behavior (holding a rifle) is characteristic and justified within the 'cowboy way' framework, which is associated with aggression, toughness, and gun violence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3cbb3fdc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_60502593",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the cowboy stereotype",
      "description": "The user is projected onto the visual material of the man (cowboy) and the textual material 'it's the cowboy way of doin things', which together construct the cowboy stereotype. The meme implicitly invites the user to identify with or adopt the persona of the cowboy, associating the user with the projected traits of ruggedness, aggression, and the romanticized 'cowboy way' of handling situations, even if it involves violence or gun use. There are no explicit deictics like 'me' or 'you', but the projection is implicit through identification with the visual and textual stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3cbb3fdc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
