    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cc1b3276",
      "@type": "EmotionExpression",
      "instance_name": "aggressive_resilience",
      "label": "aggressive resilience emotion",
      "description": "The man's serious, intense facial expression, combined with his rugged appearance and the way he holds the rifle over his shoulder, conveys a sense of hardened determination and readiness for confrontation. This expression aligns with the stereotype of a cowboy as tough, stoic, and unyielding in the face of danger or conflict.",
