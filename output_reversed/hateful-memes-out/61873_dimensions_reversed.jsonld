    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f5c1624b",
      "@type": "BackgroundKnowledge",
      "instance_name": "cinco_de_mayo",
      "label": "Cinco de Mayo",
      "description": "A holiday commemorating the Mexican army's victory over French forces at the Battle of Puebla on May 5, 1862. It is widely celebrated in Mexico, especially in Puebla, and has become a popular cultural event in the United States, often associated with Mexican food, music, and festivities. The meme falsely claims it is not celebrated by most Mexicans and is an excuse for white Americans to get drunk, which is a harmful stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_386c1efd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fe80e15c",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_latino_hispanic_stereotypes",
      "label": "Anti-Latino/Hispanic Stereotypes",
      "description": "Stereotypes that devalue or misrepresent Latino and Hispanic communities, often portraying them as lazy, criminal, or culturally inferior. The meme's claim that Cinco de Mayo is 'just an excuse for white Americans to get drunk' is a form of anti-Latino racism that implies Mexican culture is not authentic or meaningful to Mexicans themselves, and that it is only valued by white Americans for superficial or exploitative reasons.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_386c1efd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_065f5bbf",
      "@type": "BackgroundKnowledge",
      "instance_name": "racially_charged_hate_message",
      "label": "Racially Charged Hate Message",
      "description": "A message that uses racial or ethnic slurs or stereotypes to demean a group of people. The meme's text is a racially charged hate message that attacks Mexican and Latino communities by framing their cultural celebration as something that is not authentic or meaningful to them, and instead as a tool for white American consumption, which is a form of racial superiority and cultural appropriation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_386c1efd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f7c000d8",
      "@type": "BackgroundKnowledge",
      "instance_name": "cultural_appropriation",
      "label": "Cultural Appropriation",
      "description": "The act of taking elements from a culture that is not one's own and using them without permission or understanding, often in a way that is disrespectful or exploitative. The meme implies that Cinco de Mayo is a cultural event that is only valued by white Americans for their own purposes, which is a form of cultural appropriation that devalues Mexican culture.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_386c1efd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_59906802",
      "@type": "BackgroundKnowledge",
      "instance_name": "white_supremacist_rhetoric",
      "label": "White Supremacist Rhetoric",
      "description": "Language or ideas that promote the superiority of white people over other races. The meme's claim that Cinco de Mayo is 'just an excuse for white Americans to get drunk' is a form of white supremacist rhetoric that implies that non-white people are not legitimate celebrators of their own heritage, and that white Americans are the only ones who can legitimately celebrate it.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_386c1efd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_13bd1c65",
      "@type": "EmotionExpression",
      "instance_name": "hatefulness",
      "label": "hateful emotion expression",
      "description": "The emotion expressed is hateful, conveyed through the racially charged and culturally insensitive text that devalues Mexican culture and implies racial superiority by white Americans. The juxtaposition of the innocent-looking child with the offensive text amplifies the insult, making it more impactful and derogatory.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_386c1efd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9281e2b0",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The young girl is mapped as the embodiment of the stereotype that Cinco de Mayo is an excuse for white Americans to get drunk.",
      "description": "The meme uses the innocent-looking young girl as a visual anchor to represent the 'white American' who is supposedly the only one who celebrates Cinco de Mayo for the wrong reasons (to get drunk). This is a harmful analogical mapping that projects the stereotype onto the visual subject, implying that the girl represents the stereotypical white American consumer of the holiday. The juxtaposition of her innocent appearance with the hateful text amplifies the insult, making the stereotype more impactful.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_386c1efd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_004beae8",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the young girl as a representation of the stereotypical 'white American' consumer of Cinco de Mayo",
      "description": "The user is projected onto the visual material of the young girl, who is used as a visual anchor to represent the 'white American' who is supposedly the only one who celebrates Cinco de Mayo for the wrong reasons (to get drunk). This projection is implicit, as the meme uses the girl's innocent appearance to contrast with the hateful text, thereby implying that the user (as a viewer or participant in the stereotype) is identifying with or projecting themselves onto this stereotypical figure. The projection is not explicit with deictic pronouns like 'you' or 'me', but it is implied through the framing of the girl as the embodiment of the stereotype being criticized.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_386c1efd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7c33797d",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme contains a racially charged and culturally insensitive claim that devalues Mexican culture and implies racial superiority by white Americans, which is a direct attack on Mexican and Latino communities based on their cultural practices.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_386c1efd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7e6adf10",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "white americans",
      "description": "The meme targets white Americans by implying they are the only ones who celebrate Cinco de Mayo for the wrong reasons (to get drunk), framing them as the legitimate consumers of the holiday while devaluing Mexican cultural authenticity. This is a form of white supremacist rhetoric that positions white Americans as superior in cultural consumption.",
