      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_43d4cba5",
      "@type": "BackgroundKnowledge",
      "instance_name": "mueller_report",
      "label": "Mueller Report",
      "description": "The special counsel investigation led by Robert Mueller, appointed by the U.S. Department of Justice in 2017 to investigate Russian interference in the 2016 U.S. presidential election and any potential collusion with the Trump campaign. The report was released in April 2019 and concluded there was no evidence of a criminal conspiracy between the Trump campaign and Russia, though it found obstruction of justice by President Trump.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ab15ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b2fca85e",
      "@type": "BackgroundKnowledge",
      "instance_name": "obama_silence_accusation",
      "label": "Accusation of Obama's Silence on Mueller Report",
      "description": "A false and politically motivated claim that former President Barack Obama has remained silent or avoided commenting on the Mueller Report. This is used in the meme to imply disloyalty or complicity, despite Obama having publicly supported the investigation and expressed concern over the report's findings, particularly regarding obstruction of justice by Trump.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ab15ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6c6ab7a0",
      "@type": "BackgroundKnowledge",
      "instance_name": "racist_meme_scene",
      "label": "Racist Meme Scene",
      "description": "The overall meme scene that combines the image of Barack Obama with the text 'notice how the kenyan skidmark has been silent about the mueller report?'. This scene relies on external knowledge of Obama's race, the Mueller Report, and the racist stereotype to convey its hateful message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ab15ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ff85e8bd",
      "@type": "EmotionExpression",
      "instance_name": "contempt",
      "label": "contemptuous expression",
      "description": "Barack Obama's facial expression, characterized by a slight downturn of the lips and a look of disapproval or disdain, conveys a sense of contempt or disdain toward the subject of the meme. This expression is often interpreted as a subtle form of mockery or scorn, aligning with the meme's tone of accusation and derision.",
      "belongsToAnalysis": {
