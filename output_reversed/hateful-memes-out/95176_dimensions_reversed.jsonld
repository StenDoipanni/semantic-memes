    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aa1efd60",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Barack Obama is mapped as 'the kenyan skidmark'",
      "description": "The top text overlay 'notice how the kenyan skidmark' explicitly maps the visual entity 'Barack_Obama' onto the derogatory racial stereotype 'kenyan skidmark'. This is an analogical mapping where the textual label 'kenyan skidmark' is projected onto the visual representation of Barack Obama, using his race (Kenyan heritage) as the basis for the degrading metaphor. The mapping is reinforced by the meme's overall intent to demean Obama using racist tropes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ab15ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d10fc7fb",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the meme's accusatory text",
      "description": "The user is projected onto the textual material of the meme, specifically the accusatory phrase 'notice how the kenyan skidmark has been silent about the mueller report?'. This text implicitly addresses the viewer, inviting them to notice and judge Obama's silence, thereby projecting the user's role as an observer and accuser. The deictic 'notice' functions as an implicit 'you' or 'the viewer', directing the user to engage with the meme's hateful message and to project their own judgment onto the scene.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ab15ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6f69d152",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks Barack Obama based on his race (Kenyan heritage) using the derogatory term 'skidmark', which is a racist stereotype. It also falsely accuses him of silence regarding the Mueller Report to question his loyalty, combining racial dehumanization with political slander.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ab15ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1860811f",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "racist_meme_scene",
      "description": "The intended audience for this meme is individuals who are familiar with and receptive to racially charged stereotypes, particularly those that target Barack Obama based on his Kenyan heritage. The meme relies on the audience's understanding of the 'kenyan skidmark' stereotype and the political context of the Mueller Report to convey its hateful message. This audience likely includes those who hold or are exposed to anti-Black racist tropes and who may be politically motivated to question or attack Obama's integrity based on his race and perceived silence on the Mueller Report. The meme is designed to resonate with communities that use or propagate such racist and politically charged content, often found in far-right or alt-right online spaces.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ab15ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
