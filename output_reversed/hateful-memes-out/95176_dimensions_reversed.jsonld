    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_18f3af16",
      "@type": "Scene",
      "instance_name": "racist_meme_scene",
      "label": "racist_meme_scene",
      "description": "A scene depicting a racially charged meme using a close-up image of Barack Obama with overlaid text that invokes racist stereotypes and political accusations. The scene is composed of the visual material entity 'Barack_Obama' and the textual element 'text' that contains the hateful message. The text is positioned above and below the image of Barack_Obama, creating a visual composition that frames the image as a target of the hateful message. The scene's intent is to demean Obama by invoking racist tropes and questioning his integrity based on his race and political stance.",
      "belongsToAnalysis": {
