    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a1491b06",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_welcome_to_melbourne",
      "label": "The welcoming family scene is mapped as a representation of 'welcome to melbourne'",
      "description": "The text 'welcome to melbourne' is overlaid on the image of a family and dog in a sunny, happy outdoor setting. This creates an analogical mapping where the visual scene (family_welcoming_with_dog) is interpreted as embodying the concept of a welcoming environment for Melbourne. The wholesome, happy family scene serves as a visual metaphor for the city's hospitality, mapping the abstract idea of 'welcome to melbourne' onto the concrete visual of domestic warmth and joy.",
      "belongsToAnalysis": {
