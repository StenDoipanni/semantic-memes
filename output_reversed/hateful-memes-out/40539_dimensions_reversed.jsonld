      "instance_name": "baboon_congress_metaphor",
      "label": "Metaphor linking 'congress' to baboon genitalia",
      "description": "The meme relies on the real-world knowledge that 'a group of baboons is called a congress' (a true zoological term) and then juxtaposes it with the visual of baboons displaying their red genitalia to create a crude, vulgar pun. This requires understanding that 'congress' can refer to a legislative body (e.g., U.S. Congress) and that the term is being used ironically to imply a connection between legislative bodies and genitalia, which is offensive and mocking.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d49b873c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
