    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2643300a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The screaming soldier is mapped as the 'commander' needing reinforcements for the 'transgender battalion'.",
      "description": "The text 'commander! our transgender battalion needs reinforcements!' explicitly refers to a 'commander' who is in need of support. The visual material shows a soldier in an intense, aggressive state (screaming, gripping a rifle), which is mapped onto the role of 'commander'. This mapping is not literal but metaphorical and pejorative, using the soldier's rage and perceived incompetence to represent the 'commander' of the 'transgender battalion' as someone who is overwhelmed or incapable of leading, thus needing reinforcements. The soldier's visual state (rage, aggression) is projected onto the textual role of 'commander' to imply that the commander is in a state of crisis or failure, thereby reinforcing the stereotype that the transgender battalion is weak and in need of constant support.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bbb154b0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4a9616bd",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the soldier as the commander needing reinforcements",
      "description": "The user is projected onto the visual material of the soldier (person) who is screaming and holding a rifle, interpreting this figure as the 'commander' who is overwhelmed and in need of reinforcements for the 'transgender battalion'. This projection is metaphorical and pejorative, using the soldier's intense emotional state to represent the commander's perceived incompetence or crisis, thereby aligning the user's perspective with the hateful stereotype being conveyed.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bbb154b0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
