    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2a52ecff",
      "@type": "BackgroundKnowledge",
      "instance_name": "dehumanization",
      "label": "Dehumanization",
      "description": "The process of stripping away the humanity of a group, often by portraying them as less than human, incompetent, or in need of constant support. This meme uses dehumanizing language and imagery to portray transgender individuals as weak or incapable.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bbb154b0"
      },
      "extractionMethod": "llm_extraction_huggingface"
