    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_17677f8e",
      "@type": "BackgroundKnowledge",
      "instance_name": "mockery_of_independence",
      "label": "Mockery of Independence",
      "description": "The act of ridiculing or belittling a group for being perceived as dependent or unable to function without external support. In this meme, the phrase 'needs reinforcements' is used to mock the perceived lack of independence of the transgender community.",
