    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2d0adc1d",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "Nancy Pelosi is mapped as the source of the hateful rhetoric attributed to Democrats",
      "description": "The visual of Nancy Pelosi, depicted speaking and gesturing authoritatively in a formal political setting, is juxtaposed with text that falsely attributes hateful and racist rhetoric to Democratic politicians. The meme uses her image to imply she is the originator or representative of this alleged hatred, creating an analogical mapping where the visual entity (Nancy Pelosi) is mapped onto the textual claim (the hateful rhetoric). This is a false attribution designed to delegitimize the Democratic Party and its members by associating them with the visual of a powerful political figure who is then falsely portrayed as their source.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_47aad064"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b4db16c9",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene as the target of the hateful rhetoric",
      "description": "The meme uses the text 'we hate you!' and 'we hate whites, jews, christians, conservatives, republicans,' which directly addresses the viewer ('you') as the target of the alleged hatred. The user is projected onto the scene as the recipient of this false and hateful claim, making them the implied 'you' being hated by the attributed Democratic politicians. This projection is reinforced by the visual of Nancy Pelosi, who is used to imply she is the source or representative of this hatred, thereby positioning the user as the object of the hate speech.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_47aad064"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0de1026d",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme falsely attributes hateful and racist rhetoric to Democratic politicians, including Ilhan Omar, Alexandria Ocasio-Cortez, and Ayanna Pressley, claiming they 'hate whites, jews, christians, conservatives, republicans.' This is a direct and false attack on these individuals and their political affiliation, invoking harmful stereotypes and targeting protected characteristics. The meme uses Nancy Pelosi's image to imply she is the source or representative of this alleged hatred, which is a form of political demonization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_47aad064"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1deb4175",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who hold right-wing, conservative, or Republican political views in the United States. The meme is designed to appeal to those who are politically opposed to the Democratic Party and its prominent members (Ilhan Omar, Alexandria Ocasio-Cortez, Ayanna Pressley, Rashida Tlaib), by falsely attributing hateful and racist rhetoric to them. The use of Nancy Pelosi’s image, a well-known and often vilified figure among conservatives, serves as a visual anchor to signal that the meme is intended for those who perceive her as a symbol of Democratic extremism. The meme leverages existing political divisions and stereotypes (anti-white, anti-Jewish, anti-Christian, anti-conservative, anti-Republican) to incite fear, anger, and division among its intended audience, who are likely to be motivated by partisan animosity and a desire to delegitimize Democratic politicians. The formal setting (U.S. flag, microphone) is used to lend false credibility to the false claims, further appealing to audiences who value political authority and official narratives.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_47aad064"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
