    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f9f53dc5",
      "@type": "BackgroundKnowledge",
      "instance_name": "criminal_behavior_associations",
      "label": "Criminal Behavior Associations",
      "description": "The phrase 'play your cards right' in the context of 'skip prison' implies manipulation or deceit to avoid legal consequences, which is a stereotype often associated with certain groups, particularly Black people, in popular culture and media. This stereotype suggests that individuals from these groups are more likely to engage in or be perceived as engaging in criminal behavior, even when they are not directly involved in it.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_854d22f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_269d4c9a",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotypes",
      "label": "Anti-Black Stereotypes",
      "description": "The meme's implication that the man used manipulation to avoid prison taps into broader societal stereotypes that associate Black people with criminal behavior. This is a harmful stereotype that has been historically used to justify systemic racism and discrimination against Black communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_854d22f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0e1ae1ab",
      "@type": "BackgroundKnowledge",
      "instance_name": "man",
      "label": "Man in the Image",
      "description": "The man in the image is Jussie Smollett, an actor known for his role in 'Empire'. The meme references his 2019 hoax case, where he falsely claimed to be the victim of a hate crime. The text 'if you play your cards right you can skip prison' is a reference to the public perception that he manipulated the situation to avoid legal consequences, which led to his conviction for felony obstruction of justice. This background knowledge is essential to understand the meme's context and intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_854d22f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0541c2bf",
      "@type": "EmotionExpression",
      "instance_name": "cynical_smile",
      "label": "cynical or mocking expression",
      "description": "The man's slight smile, combined with his direct gaze, conveys a sense of self-assuredness or smugness, which in this context is interpreted as mocking or cynical, especially given the overlaid text suggesting he manipulated a situation to avoid punishment. The expression does not appear genuine or warm but rather calculated and dismissive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_854d22f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_874d4bc7",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The man is mapped as someone who can skip prison by playing his cards right",
      "description": "The overlaid text 'if you play your cards right you can skip prison' is directly mapped onto the visual entity 'man'. The text implies that the man is the one who used manipulation or deceit to avoid legal consequences, thereby projecting the textual concept of 'someone who can skip prison by playing their cards right' onto the visual representation of the man. This is an analogical mapping where the man is the entity being described by the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_854d22f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a8370997",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man in the image",
      "description": "The user is projected onto the visual material of the man (Jussie Smollett) through the textual material's implication that he is the one who 'plays his cards right' to 'skip prison'. The meme frames the man as the subject of the cynical statement, projecting the user's interpretation of his actions and moral character onto him. There are no explicit deictic pronouns like 'you' or 'me' in the text, but the implied subject of the statement is the man, creating a projection of the user's judgment onto him.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_854d22f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d89b2386",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme implies the man manipulated a situation to avoid legal consequences, which is harmful as it may contribute to public perception of the individual as dishonest or morally compromised, potentially damaging his reputation.",
      "belongsToAnalysis": {
