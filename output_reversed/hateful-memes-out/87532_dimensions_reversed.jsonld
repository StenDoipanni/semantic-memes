    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cdb3a1fb",
      "@type": "BackgroundKnowledge",
      "instance_name": "shower_metaphor",
      "label": "Shower Metaphor",
      "description": "The phrase 'shower' is used metaphorically to represent cleansing, release, or emotional/physical purification. In this context, it refers to a necessary but unpleasant experience — often used in discussions of trauma, systemic injustice, or personal hardship. The metaphor is culturally embedded in Western discourse, particularly in contexts of mental health, social commentary, and political resistance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_df4422ac"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0b7b6708",
      "@type": "BackgroundKnowledge",
      "instance_name": "prison_or_bunker_setting",
      "label": "Prison or Bunker Setting",
      "description": "The visual of a grimy, underground, dilapidated space is commonly associated with prisons, concentration camps, or wartime bunkers. This setting evokes historical and cultural associations with suffering, confinement, and systemic oppression. The imagery is used to imply a context of institutionalized hardship or trauma.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_df4422ac"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fd9b62d8",
      "@type": "BackgroundKnowledge",
      "instance_name": "resilience_through_adversity",
      "label": "Resilience Through Adversity",
      "description": "The meme's core message — accepting a harsh reality as necessary for survival or healing — is a common theme in social commentary, trauma narratives, and political resistance. It draws on cultural understandings of endurance, coping mechanisms, and the psychological process of 'making peace' with difficult circumstances.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_df4422ac"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_513af755",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_shower_reference",
      "label": "Historical Shower Reference",
      "description": "The phrase 'shower' in this context may implicitly reference the 'shower' scenes in historical atrocities, such as the Holocaust, where showers were used as a euphemism for gas chambers. While not explicitly shown, the imagery and metaphor can evoke this dark historical association, making the meme's message more potent and somber.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_df4422ac"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7fee685f",
      "@type": "BackgroundKnowledge",
      "instance_name": "systemic_injustice",
      "label": "Systemic Injustice",
      "description": "The meme resonates with audiences who have experienced or witnessed systemic injustice — such as racial, economic, or political oppression. The phrase 'not the shower we deserved' implies a failure of societal systems to provide justice or dignity, while 'but the shower we needed' suggests a grim necessity born from systemic failure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_df4422ac"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_85989b97",
      "@type": "BackgroundKnowledge",
      "instance_name": "trauma_and_healing",
      "label": "Trauma and Healing",
      "description": "The meme uses the metaphor of a 'shower' to represent the process of trauma and healing — the cleansing of pain, the release of emotional burdens, or the necessary but painful steps toward recovery. This concept is rooted in psychological and therapeutic discourse, particularly in trauma-informed care.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_df4422ac"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f0fbe4ce",
      "@type": "EmotionExpression",
      "instance_name": "resignation",
      "label": "resigned emotion",
      "description": "The emotion of accepting a harsh or unpleasant reality as unavoidable, despite it not being ideal. This is conveyed through the juxtaposition of 'not the shower we deserved' with 'but the shower we needed,' suggesting a weary acceptance of necessary suffering.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_df4422ac"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_57666238",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The grimy underground space is mapped as 'the shower we needed'",
      "description": "The visual entity 'dimly_lit_underground_shower' is analogically mapped to the textual phrase 'the shower we needed'. The text explicitly uses the metaphor of a 'shower' to represent a necessary but unpleasant cleansing or release, and the visual of the grimy, dilapidated space embodies this metaphor by evoking a harsh, unsanitary environment. This mapping is central to the meme's message of resilience through adversity, where the 'shower' is not ideal but essential for survival or healing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_df4422ac"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0330cd89",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene as the experiencer of the metaphorical 'shower'",
      "description": "The user is implicitly projected onto the scene (dimly_lit_underground_shower) as the individual who has undergone or is undergoing the metaphorical 'shower' — a necessary but undeserved hardship. The text 'not the shower we deserved but the shower we needed' uses the first-person plural 'we', which creates an inclusive projection where the viewer/user identifies with the collective experience. The scene visually embodies the 'shower' as a grim, necessary cleansing, and the user is projected onto this scene as the one who must endure it. This projection is not explicit with deictic pronouns like 'you' or 'me', but it is implied through the collective 'we' and the universalizing tone of the message, making the user feel personally connected to the experience.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_df4422ac"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_86d74905",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme uses a grim, prison-like setting and the metaphor of a 'shower' to evoke trauma and systemic injustice. While not explicitly targeting any group, the imagery and metaphor can be interpreted as referencing historical atrocities (e.g., Holocaust gas chambers) and may cause distress or discomfort to viewers, particularly those who have experienced or are aware of institutionalized suffering. The overall message, while framed as resilience, carries the potential to normalize or trivialize severe suffering, which can be psychologically harmful.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_df4422ac"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f2ed8019",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who have experienced or are aware of systemic injustice, trauma, or institutionalized suffering. The meme resonates with audiences familiar with the metaphor of a 'shower' representing cleansing or release in the context of hardship, particularly those who have endured or witnessed oppressive systems. The imagery of a grimy, underground space evokes associations with historical atrocities (e.g., Holocaust gas chambers) and modern-day systemic oppression, making it particularly impactful for communities affected by trauma, social injustice, or political resistance. The message of resilience through adversity — accepting a harsh reality as necessary for survival or healing — appeals to those navigating difficult circumstances, including survivors of abuse, marginalized groups, or individuals coping with mental health challenges. The meme’s somber tone and cultural references to trauma and healing make it relevant to audiences engaged in psychological discourse, social commentary, or political resistance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_df4422ac"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
