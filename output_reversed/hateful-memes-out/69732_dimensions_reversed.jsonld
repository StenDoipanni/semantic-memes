    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_343a5730",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Latinos are mapped to roaches",
      "description": "The textual analogy 'that's like roaches for raid!' maps the group 'Latinos' (implied by the top text 'latinos for me!') onto the visual metaphor of 'roaches' (pests) that should be 'raided' (exterminated). The visual material of Donald Trump shouting is used to convey the intensity of this hateful analogy, where the text explicitly equates Latinos with roaches, creating a dehumanizing and racist mapping.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7d5f3327"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_109d02ce",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual entity 'latinos for me!'",
      "description": "The user is projected onto the top textual material 'latinos for me!' which contains the deictic pronoun 'me', implying the user is identifying with or adopting the perspective of the speaker (Donald Trump) who is expressing a hateful sentiment. This creates a direct projection where the viewer is invited to imagine themselves as the one who would say 'latinos for me!' — a statement that is inherently dehumanizing and racist. The projection is onto the textual material because the deictic 'me' is embedded within the text, and the user is being invited to mentally inhabit that position.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7d5f3327"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
