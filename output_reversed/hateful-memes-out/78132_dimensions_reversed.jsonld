    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e77385d9",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia",
      "label": "Islamophobia",
      "description": "The meme promotes hostility toward Muslims by calling for 'all races' to unite against 'islam'. This implicitly references the real-world stereotype that Muslims are inherently violent or incompatible with Western values, which is a core component of Islamophobia. The phrase 'against islam!' frames the entire religious group as a monolithic enemy, ignoring diversity within Islam and promoting fear and division.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6c3c2a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_da229565",
      "@type": "BackgroundKnowledge",
      "instance_name": "terrorism_associations",
      "label": "Terrorism Associations",
      "description": "The meme implicitly relies on the real-world stereotype that Muslims are associated with terrorism. This is a common and harmful trope used to justify prejudice and hostility toward Muslims. The phrase 'against islam!' leverages this association to incite fear and unity against a religious group based on a false and dangerous generalization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6c3c2a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_689fb40c",
      "@type": "BackgroundKnowledge",
      "instance_name": "sharia_law_fearmongering",
      "label": "Sharia Law Fearmongering",
      "description": "The meme implicitly references the stereotype that Sharia law is incompatible with Western values and is inherently oppressive or barbaric. This fearmongering is used to justify hostility toward Muslims, portraying them as a threat to societal norms. The phrase 'against islam!' leverages this fear to promote division.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6c3c2a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_339b0475",
      "@type": "BackgroundKnowledge",
      "instance_name": "incompatibility_with_western_values",
      "label": "Incompatibility with Western Values",
      "description": "The meme implicitly references the stereotype that Islam is fundamentally incompatible with Western values, such as democracy, freedom, or secularism. This is a common justification for anti-Muslim sentiment and is used here to frame Muslims as an 'enemy' to be united against by all races.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6c3c2a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e018ba7a",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_islam_stereotype",
      "label": "Anti-Islam Stereotype",
      "description": "The meme relies on the real-world stereotype that Islam is inherently violent, oppressive, or incompatible with modern society. This stereotype is used to justify the call for unity against 'islam', which is a direct attack on Muslims based on their religion. The phrase 'against islam!' is a clear invocation of this harmful stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6c3c2a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
