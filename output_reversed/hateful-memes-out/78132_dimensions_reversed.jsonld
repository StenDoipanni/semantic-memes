      "instance_name": "unity_gesture_scene",
      "label": "unity_gesture_scene",
      "description": "A scene depicting two hands clasped together in a gesture of unity or solidarity, juxtaposed with text that promotes division against a specific religious group. The visual metaphor of unity is contrasted with the hateful message, creating a scene of ironic or deceptive solidarity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6c3c2a6"
      },
