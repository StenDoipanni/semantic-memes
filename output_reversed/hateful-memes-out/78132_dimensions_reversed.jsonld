    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1832f3e1",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Unity gesture mapped to call for racial unity",
      "description": "The visual of two hands clasped together, symbolizing unity and solidarity, is mapped onto the textual phrase 'all races unite'. The image visually represents the concept of collective action across racial lines, which the text explicitly invokes, creating an analogical mapping where the gesture stands for the textual message of unity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6c3c2a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3d489dc6",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message calling for unity against Islam",
      "description": "The user is implicitly projected onto the textual material 'all races unite against islam!' as the intended recipient or actor of the call to action. The meme frames the user as part of the collective 'all races' being urged to unite against 'islam', making the user a direct participant in the hateful message. There are no explicit deictics like 'you' or 'me', but the imperative nature of the text ('unite', 'against') and the visual of hands clasped (implying collective action) create an implicit projection of the user onto the call to action.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6c3c2a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9a1ec0d6",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme explicitly calls for 'all races' to unite against 'islam', which is a direct attack on Muslims based on their religion. This promotes division and hostility toward a specific religious group, leveraging the visual metaphor of unity to mask its divisive intent. It is a hateful message that incites prejudice and violence against Muslims.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6c3c2a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e91fef1c",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The target community is individuals who hold or are susceptible to Islamophobic beliefs, particularly those who may be influenced by stereotypes associating Islam with terrorism, incompatibility with Western values, or Sharia law fearmongering. The meme is designed to appeal to people who perceive Muslims as an external threat and who are motivated by divisive rhetoric to unite across racial lines against this perceived threat. The visual of clasped hands, typically a symbol of unity, is used ironically to suggest that the audience should unite against Islam, thereby targeting those who are receptive to this hateful framing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6c3c2a6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
