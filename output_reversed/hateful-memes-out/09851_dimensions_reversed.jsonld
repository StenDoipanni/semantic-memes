    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_71f51b84",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'a cracker' maps onto the crackers in the gourmet dish",
      "description": "The textual phrase 'a cracker' is directly mapped onto the visual entity of the crackers present in the gourmet dish. The crackers are a literal component of the dish, and the text uses them as a visual anchor to deliver the racial slur 'cracker'. This creates an analogical mapping where the crackers (visual) are equated with the slur (textual), reinforcing the derogatory association. The mapping is explicit through juxtaposition: the text identifies the crackers as 'a cracker', thereby projecting the slur onto the visual element.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0e54f5bd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ad60e78a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material addressing them",
      "description": "The user is projected onto the textual material 'hm.. it appears you're' and 'a cracker' because the text directly addresses the viewer with 'you're', indicating the user is the target of the insult. The projection is onto the textual material which contains the deictic pronoun 'you', making the user the subject of the slur. The visual material (gourmet_dish) serves as a contextual anchor for the slur, but the direct projection is onto the text that addresses the user.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0e54f5bd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
