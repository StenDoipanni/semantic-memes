    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_103592d6",
      "@type": "EmotionExpression",
      "instance_name": "derision",
      "label": "derisive emotion",
      "description": "The emotion expressed is derision, conveyed through the use of a racial slur ('cracker') in a mocking context. The juxtaposition of a gourmet dish with crackers, which are historically stereotyped in relation to Black people, reinforces a demeaning and mocking tone. The text 'hm.. it appears you're a cracker' is intended to belittle and insult the person being addressed, expressing contempt and ridicule.",
      "belongsToAnalysis": {
