    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ce38207e",
      "@type": "AnalogicalMapping",
      "instance_name": "boxing_day_pun_mapping",
      "label": "Boxing Day Holiday is mapped onto boxing gloves and gift box",
      "description": "The text 'international boxing day' creates an analogical mapping by conflating the holiday 'Boxing Day' (which involves gift-giving) with the sport of boxing (symbolized by the red boxing gloves). The visual elements — the boxing gloves and the gift box — are mapped onto the dual meaning of 'boxing' in the text. The gift box represents the gift-giving aspect of the holiday, while the boxing gloves represent the sport. This mapping is central to the pun and humor of the meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_99e61754"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3b291ed9",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the text 'international boxing day' as the central element that triggers the pun and humor. The text explicitly sets up the wordplay, and the user is expected to interpret the visual elements (boxing gloves, gift box) in relation to this text to understand the joke. There are no explicit deictic pronouns like 'me' or 'you', but the user is implicitly invited to engage with the text as the anchor point for the entire meme's meaning.",
