    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_31a98921",
      "@type": "BackgroundKnowledge",
      "instance_name": "boxing_day_holiday",
      "label": "Boxing Day Holiday",
      "description": "A public holiday observed in many countries, particularly in the United Kingdom and Commonwealth nations, occurring on December 26th. It traditionally involves gift-giving, charitable donations, and sales, often associated with post-Christmas shopping and festivities. The term 'boxing' historically referred to the practice of placing gifts or money in boxes for servants or the poor, or for giving to tradespeople. This real-world holiday is the basis for the pun in the meme, which conflates the holiday with the sport of boxing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_99e61754"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_769a62d2",
      "@type": "BackgroundKnowledge",
      "instance_name": "sport_of_boxing",
      "label": "Sport of Boxing",
      "description": "A combat sport involving two participants throwing punches at each other with gloved hands, governed by rules and regulations. It is a globally recognized sport with professional and amateur levels, often associated with strength, discipline, and athleticism. The red boxing gloves in the image are a direct visual symbol of this sport, which is the second meaning of 'boxing' in the pun.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_99e61754"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d4320728",
      "@type": "BackgroundKnowledge",
      "instance_name": "wordplay_pun",
      "label": "Wordplay Pun",
      "description": "A form of humor that exploits the multiple meanings of words or phrases. In this meme, the phrase 'International Boxing Day' is a pun that plays on the double meaning of 'boxing' — referring to the holiday (Boxing Day) and the sport (boxing). This requires external knowledge of the holiday and the sport to understand the joke.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_99e61754"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
