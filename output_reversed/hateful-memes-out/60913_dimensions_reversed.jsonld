    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f15f19ad",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text dehumanizes Palestinians by equating them to 'animals', which is mapped onto the visual of the elderly man to create a contrast.",
      "description": "The hateful text overlay explicitly dehumanizes Palestinians by calling them 'animals'. This textual dehumanization is juxtaposed with the visual of an elderly man who appears dignified and peaceful. The mapping is not direct (e.g., 'this man is an animal'), but rather ideological: the text's dehumanizing message is visually anchored to the image of a human being (the elderly man) to create a jarring contrast. This contrast implies that the group being dehumanized (Palestinians) is being compared to the 'animal' label, while the visual of the elderly man represents the 'human' standard being violated. The mapping is therefore between the textual dehumanization and the visual representation of humanity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_478b6f2e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bef85a74",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the dehumanizing text overlay",
      "description": "The user is projected onto the textual material that dehumanizes Palestinians, as the meme's intent is to incite hatred and dehumanization by directly addressing the viewer with hateful rhetoric. The text 'palestinians are not human beings, they don't deserve to live and they are nothing but animals' is presented as a direct statement to the viewer, making the user the implicit recipient of this dehumanizing message. There are no explicit deictic pronouns like 'you' or 'me', but the rhetorical force and hateful intent of the text create a direct projection onto the viewer, who is expected to internalize or be confronted with the message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_478b6f2e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
