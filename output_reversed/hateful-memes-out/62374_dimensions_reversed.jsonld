    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_479f4519",
      "@type": "BackgroundKnowledge",
      "instance_name": "40sec_man",
      "label": "40-second man stereotype",
      "description": "A derogatory term used to describe a man who is perceived as sexually inadequate or unable to maintain sexual performance beyond 40 seconds. This stereotype is often used in misogynistic humor to mock male sexual stamina and is rooted in patriarchal attitudes that equate male value with sexual prowess.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_46b31617"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_621b52aa",
      "@type": "BackgroundKnowledge",
      "instance_name": "bride_price",
      "label": "Bride price concept",
      "description": "A traditional practice in some cultures where the groom or his family pays a sum of money or goods to the bride's family as part of the marriage arrangement. This concept is often misunderstood or misrepresented in Western contexts, and in some cases, it is used to imply transactional or commodified relationships, which can be misogynistic when framed as a woman 'paying' for marriage.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_46b31617"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
