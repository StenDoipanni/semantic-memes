      "@type": "BackgroundKnowledge",
      "instance_name": "pink_turban",
      "label": "Pink turban stereotype",
      "description": "A visual trope often used in memes to represent a stereotypical or caricatured version of a Sikh man, sometimes used to imply a certain type of personality or behavior (e.g., 'funny', 'over-the-top', or 'stereotypical'). This can be a form of cultural stereotyping that reduces a complex identity to a visual joke.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_46b31617"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
