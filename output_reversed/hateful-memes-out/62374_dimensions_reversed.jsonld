    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_14456250",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The man is mapped as the '40sec man' being called by her",
      "description": "The top text 'when she calls you a 40sec man' explicitly refers to the man in the image as the subject of this derogatory label. The visual of the man, with his confident and smiling expression, is juxtaposed with this text to create an analogical mapping where the man is identified as the '40sec man' mentioned in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_46b31617"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4f631d14",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man in the image as the subject of the derogatory label",
      "description": "The user is projected onto the man (VisualMaterial entity) who is depicted as the '40sec man' mentioned in the top text. The meme uses the man's image as a stand-in for 'you' in the phrase 'when she calls you a 40sec man', creating a direct identification with the viewer. The user is also implicitly projected onto the scenario described in the bottom text ('but she paid own bride price to marry you'), which frames the man's perceived inadequacy as being compensated for by the woman's financial contribution, thus making the user feel personally implicated in this transactional dynamic.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_46b31617"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
