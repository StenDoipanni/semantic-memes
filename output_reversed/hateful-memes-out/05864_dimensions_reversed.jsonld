    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_58d04700",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia",
      "label": "Islamophobia",
      "description": "The fear, hatred, or prejudice against Muslims, often manifesting in stereotypes, discrimination, or violence. This meme is a clear example of Islamophobia, as it uses the visual of camels (associated with the Middle East) to make a hateful generalization about an entire group of people.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c3e5ebb3"
      },
      "extractionMethod": "llm_extraction_huggingface"
