    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d2dec9ba",
      "@type": "AnalogicalMapping",
      "instance_name": "camel_meme_mapping_1",
      "label": "Camels are mapped as 'terrorists' in the text",
      "description": "The text at the bottom, '...they're re all terrorists', explicitly maps the visual entity 'shouting_camels' (the three camels) onto the concept of 'terrorists'. This is an analogical mapping where the camels, through their visual portrayal of shouting or roaring, are equated with terrorists, leveraging the stereotype that camels (as symbols of the Middle East) represent all Muslims or Middle Easterners who are terrorists. This mapping is central to the meme's hateful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c3e5ebb3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_38a32ab1",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material inviting trust",
      "description": "The top text 'trust me...' projects the user onto the meme's speaker, implying the user should believe the subsequent claim. This creates an implicit 'you' or 'me' as the recipient of the trust request, directing the user's perspective toward accepting the hateful generalization that follows.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c3e5ebb3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
