      "@id": "http://example.org/multimodal-taxonomy#dimension_e62381b4",
      "@type": "BackgroundKnowledge",
      "instance_name": "hateful_meme",
      "label": "Hateful Meme",
      "description": "A meme designed to spread hate, fear, or prejudice by using humor or shock value to promote harmful stereotypes or false equivalences. This meme is hateful because it equates all camels (and by implication, all Middle Easterners or Muslims) with terrorism, which is a dangerous and false generalization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c3e5ebb3"
