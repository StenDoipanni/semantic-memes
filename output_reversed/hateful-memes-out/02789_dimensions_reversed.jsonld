    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1df10e0d",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "Person on the run is mapped to the central figure",
      "description": "The text 'when you got a warrant out for your arrest & you on the run.....' explicitly refers to 'you', which is analogically mapped onto the central visual entity, 'person'. The person's distressed expression and the act of checking their phone while applying makeup are used to visually represent the state of being 'on the run', creating a humorous juxtaposition between the flamboyant appearance and the serious situation. This mapping is central to the meme's intent, as it projects the textual 'you' onto the visual 'person' to create the comedic effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ea42f7b9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_15e009c4",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the central figure in the meme",
      "description": "The text overlay 'when you got a warrant out for your arrest & you on the run.....' explicitly uses the deictic pronoun 'you', projecting the user (the viewer) onto the central visual entity, 'person'. This projection is central to the meme's humor, as it maps the user's imagined scenario onto the visual of the person applying makeup while looking at their phone, creating a comedic juxtaposition between the user's hypothetical situation and the person's flamboyant appearance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ea42f7b9"
      },
      "extractionMethod": "llm_extraction_huggingface"
