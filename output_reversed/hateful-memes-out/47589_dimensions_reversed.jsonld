      "instance_name": "misinformation",
      "label": "Misinformation",
      "description": "The meme is an example of misinformation, as it presents a false claim (Trump's 2011 statement) as fact. Misinformation can have harmful effects, including eroding trust in public discourse, inciting division, and reinforcing negative stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c178f2cf"
      },
      "extractionMethod": "llm_extraction_huggingface"
