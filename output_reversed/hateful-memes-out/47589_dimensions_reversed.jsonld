    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_36115fe7",
      "@type": "EmotionExpression",
      "instance_name": "derogatory_contempt",
      "label": "contemptuous emotion toward Americans",
      "description": "The meme expresses contempt through the false claim that Trump said 'all americans are idiots,' which is a sweeping, derogatory generalization. This is reinforced by the implication that voters 'proved it' in 2016, suggesting a disdainful view of the electorate. The emotion is conveyed through the textual material and the meme's overall intent to dehumanize voters.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c178f2cf"
      },
