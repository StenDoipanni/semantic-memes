    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_71708e7c",
      "@type": "AnalogicalMapping",
      "instance_name": "trump_statement_mapping",
      "label": "Donald Trump is mapped as the speaker of the false statement",
      "description": "The text 'in 2011 trump said, \"all americans are idiots\"' explicitly attributes a statement to Donald Trump, who is visually depicted in the image as the central subject speaking. The visual material (Donald_Trump) is mapped onto the textual material (text_chunk) to represent him as the source of the alleged statement.",
      "belongsToAnalysis": {
