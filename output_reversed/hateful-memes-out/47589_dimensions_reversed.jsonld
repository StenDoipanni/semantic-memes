    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9d66cd20",
      "@type": "BackgroundKnowledge",
      "instance_name": "false_statement_about_trump",
      "label": "False Attribution of Trump's Statement",
      "description": "The meme falsely claims that Donald Trump said in 2011, 'all americans are idiots.' This is a fabrication; no credible evidence or record exists of Trump making this specific statement in 2011. The meme uses this false claim to discredit him by implying his own words were validated by voters in 2016, which is a misleading and inflammatory narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c178f2cf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0c06298b",
      "@type": "BackgroundKnowledge",
      "instance_name": "2016_us_presidential_election",
      "label": "2016 United States Presidential Election",
      "description": "The meme references the 2016 U.S. presidential election as 'proof' that Trump's alleged statement was true. This election saw Donald Trump win the presidency, which the meme uses to imply that voters 'proved' Trump's claim about Americans being idiots. This is a misrepresentation of political discourse and voter behavior, as the election outcome does not validate a derogatory statement about all Americans.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c178f2cf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0eb098fc",
      "@type": "BackgroundKnowledge",
      "instance_name": "derogatory_statement_about_americans",
      "label": "Derogatory Statement About Americans",
      "description": "The phrase 'all americans are idiots' is a sweeping, derogatory generalization that attacks the intelligence of an entire nation. This type of statement is inherently inflammatory and divisive, and its use in the meme serves to dehumanize voters and reinforce negative stereotypes about the American public.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c178f2cf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
