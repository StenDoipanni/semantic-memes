    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_db45e940",
      "@type": "VisualMaterial",
      "instance_name": "man",
      "label": "middle-aged man with gray hair and beard",
      "description": "The central visual element is a man with graying hair, a graying beard, and a slightly furrowed brow, looking directly at the camera with a subtle, knowing smirk. He appears to be in his 50s or 60s. His expression is often interpreted as smug or self-satisfied, fitting the meme's context of someone making a questionable or dishonest choice. He is wearing a light gray collared shirt.",
