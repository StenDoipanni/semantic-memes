    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5ab58571",
      "@type": "Scene",
      "instance_name": "jeopardy_game_show_scene",
      "label": "Jeopardy! game show scene",
      "description": "The scene depicts a man (Brett Kavanaugh) as a contestant on a Jeopardy! game show, making a choice to accept a fictional, fabricated accusation for a large sum of money. The text overlays indicate the names and ages of the two contestants (Brett Kavanaugh 17 and Christina Ford 15), and the man's choice to take 'shit that never happened for 1000'. The scene is satirical, mocking the absurdity of Kavanaugh's denial of the allegations and implying he is willing to accept a false accusation for a large sum of money.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45911718"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_28b4791a",
      "@type": "BackgroundKnowledge",
      "instance_name": "brett_kavanaugh",
      "label": "Brett Kavanaugh",
      "description": "Brett Kavanaugh is an American lawyer and jurist who served as an Associate Justice of the Supreme Court of the United States from 2018 to 2025. He was nominated by President Donald Trump and confirmed by the U.S. Senate. He is known for his conservative judicial philosophy and his controversial confirmation hearings in 2018, during which he faced allegations of sexual assault from Christine Blasey Ford. The meme references this event, distorting his age and implying he is willing to accept a false accusation for money.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45911718"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_443386c5",
      "@type": "BackgroundKnowledge",
      "instance_name": "christina_ford",
      "label": "Christine Blasey Ford",
      "description": "Christine Blasey Ford is an American clinical psychologist and professor who testified before the U.S. Senate Judiciary Committee in 2018 that she was sexually assaulted by Brett Kavanaugh when they were teenagers. Her testimony was a pivotal moment in the confirmation hearings for Kavanaugh's Supreme Court nomination. The meme references her as a contestant in the satirical Jeopardy! game, distorting her age and implying she is a fictional accusation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45911718"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_df020cce",
      "@type": "BackgroundKnowledge",
      "instance_name": "jeopardy_game_show",
      "label": "Jeopardy! Game Show",
      "description": "Jeopardy! is an American television game show where contestants answer trivia questions in the form of clues. The show is known for its format where contestants wager money on answers, and the phrase 'I'll take... for $1000' is a common phrase used by contestants. The meme uses this format to satirize the Kavanaugh-Ford controversy by implying Kavanaugh is willing to accept a false accusation for a large sum of money.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45911718"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1ac7e85b",
      "@type": "BackgroundKnowledge",
      "instance_name": "sexual_assault_allegation",
      "label": "Sexual Assault Allegation",
      "description": "A sexual assault allegation is a claim that someone has been sexually assaulted. In the context of the meme, it refers to the allegations made by Christine Blasey Ford against Brett Kavanaugh during his Supreme Court confirmation hearings. The meme uses the term 'shit that never happened' to mock Kavanaugh's denial of the allegations and to imply that he is willing to accept a false accusation for money.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45911718"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c14f32db",
      "@type": "BackgroundKnowledge",
      "instance_name": "supreme_court_confirmation_hearings",
      "label": "Supreme Court Confirmation Hearings",
      "description": "The Supreme Court confirmation hearings are a series of hearings held by the U.S. Senate Judiciary Committee to review the qualifications of a nominee for a position on the Supreme Court of the United States. The 2018 hearings for Brett Kavanaugh were particularly controversial due to the allegations of sexual assault made by Christine Blasey Ford. The meme references these hearings to satirize the political and legal maneuvering surrounding the allegations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45911718"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8c4bc149",
      "@type": "BackgroundKnowledge",
      "instance_name": "age_distortion",
      "label": "Age Distortion",
      "description": "Age distortion is a technique used in memes and satire to exaggerate or misrepresent the age of individuals to create a humorous or absurd effect. In this meme, the ages of Brett Kavanaugh and Christine Blasey Ford are distorted to 17 and 15, respectively, to imply that the alleged incident occurred when they were teenagers. This distortion is used to mock the seriousness of the allegations and to suggest that Kavanaugh is willing to accept a false accusation for money.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45911718"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_63ff1041",
      "@type": "BackgroundKnowledge",
      "instance_name": "satirical_judgment",
      "label": "Satirical Judgment",
      "description": "Satirical judgment is a form of humor that uses exaggeration, irony, or absurdity to criticize or mock a situation or individual. In this meme, the satirical judgment is directed at Brett Kavanaugh, implying that he is willing to accept a false accusation for money. The judgment is based on the distortion of the ages of the individuals involved and the use of the Jeopardy! game show format to create a humorous and absurd effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45911718"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
