    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_21d97247",
      "@type": "BackgroundKnowledge",
      "instance_name": "Voting_Age",
      "label": "Voting Age",
      "description": "The voting age is the minimum age at which a person is legally allowed to vote in an election. In the U.S., the voting age is 18, but the meme references the age of 16 for voting on gun laws, which is a specific policy proposal or debate point. This requires knowledge of U.S. voting rights and age-based eligibility requirements.",
      "belongsToAnalysis": {
