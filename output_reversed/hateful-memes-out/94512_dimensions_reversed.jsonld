    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5ca04919",
      "@type": "BackgroundKnowledge",
      "instance_name": "Donald_Trump_personality_stereotype",
      "label": "Donald Trump's self-aggrandizing persona",
      "description": "The meme relies on the real-world perception of Donald Trump as a figure known for boastful, self-promoting, and often arrogant rhetoric. His characteristic speaking style — including the use of phrases like 'believe me, no one can...' — is a well-known trait associated with his public persona and political communication. This stereotype is central to the meme's satirical effect, as it juxtaposes his persona with a birthday greeting.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14778119"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_629daa7e",
      "@type": "BackgroundKnowledge",
      "instance_name": "Birthday_wish_satire",
      "label": "Satirical birthday wishes",
      "description": "The meme uses the concept of birthday wishes as a vehicle for satire. In real-world culture, birthday wishes are typically sincere and celebratory. The meme subverts this by using Trump’s persona to deliver a birthday wish that is ironically boastful and self-serving, creating a humorous or mocking effect. This requires understanding the cultural norm of birthday greetings and the contrast with the meme’s message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14778119"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5aea31b5",
      "@type": "BackgroundKnowledge",
      "instance_name": "Political_figure_meme_context",
      "label": "Use of political figures in memes",
      "description": "The meme leverages Donald Trump’s status as a polarizing political figure. His public image, often associated with controversy, divisiveness, and strong personality, is used to create a meme that may be perceived as mocking or inflammatory. This requires background knowledge of Trump’s political career, public reception, and his role in contemporary political discourse.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14778119"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6da6e5ee",
      "@type": "BackgroundKnowledge",
      "instance_name": "Meme_harmful_intent_context",
      "label": "Meme intent as harmful or provocative",
      "description": "The meme is understood as harmful or provocative because it uses a recognizable political figure in a context that may be interpreted as disrespectful or inflammatory. This requires knowledge of how memes function in online culture — particularly how they can be used to ridicule, polarize, or provoke strong reactions — and how Trump’s image is often weaponized in such contexts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14778119"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d638005a",
      "@type": "EmotionExpression",
      "instance_name": "sarcastic_contempt",
      "label": "sarcastic contempt expression",
      "description": "The emotion expressed is sarcastic contempt, conveyed through the juxtaposition of a birthday greeting with Donald Trump's self-aggrandizing persona. The text 'and believe me, no one can wish you a better happy birthday than me' is inherently ironic and mocking, implying that the speaker is not genuinely wishing well but rather boasting about their superiority. This is reinforced by Trump's characteristic speaking style and the visual of him gesturing emphatically, which in this context suggests arrogance rather than sincerity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14778119"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f14394cd",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The speaker 'me' is mapped onto Donald Trump",
      "description": "The text 'and believe me, no one can wish you a better happy birthday than me' explicitly uses the pronoun 'me'. This pronoun is analogically mapped onto the visual entity Donald_Trump, as he is the only person depicted in the image and is the subject of the birthday wish. The mapping is reinforced by the context of the meme, which relies on Trump's self-aggrandizing persona to deliver the boastful birthday message. The visual of Trump speaking and gesturing, combined with the text, creates an implicit identification: 'me' = Donald_Trump.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14778119"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_35b7735a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the speaker 'me' in the text",
      "description": "The user is projected onto the pronoun 'me' in the textual material, which is explicitly mapped onto Donald_Trump via the analogical mapping. The text 'and believe me, no one can wish you a better happy birthday than me' uses 'me' to refer to the speaker, who is visually represented by Donald_Trump. This creates a direct projection of the user onto the visual entity Donald_Trump, as the meme's satirical effect relies on the viewer identifying the speaker ('me') with the depicted person (Donald_Trump).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14778119"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_845196e5",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_2",
      "label": "User projected onto the recipient 'you' in the text",
      "description": "The user is projected onto the pronoun 'you' in the textual material, which refers to the person being wished a birthday. The text 'happy birthday' and 'no one can wish you a better happy birthday than me' directly address 'you', implying the viewer of the meme is the recipient. This creates a projection of the user onto the implied recipient of the birthday wish, making the user the target of the satirical message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14778119"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_657f6427",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme leverages Donald Trump's controversial public image and self-aggrandizing persona to deliver a sarcastic birthday wish, which may be perceived as mocking his personality or political style. This can be interpreted as disrespectful or inflammatory by some viewers, especially those with strong political views about him, and may contribute to a hostile or polarized online environment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14778119"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0ac38185",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who are familiar with Donald Trump’s public persona, political career, and media presence. This includes politically engaged viewers, particularly those who follow or critique U.S. politics, and internet users who consume satirical or sarcastic political memes. The meme relies on cultural knowledge of Trump’s self-aggrandizing rhetoric and his polarizing status, making it most effective for audiences who recognize these traits and understand the irony in juxtaposing them with a birthday wish. The meme is designed to provoke reaction, often through ridicule, and thus targets communities that are politically aware and active in online discourse, especially those who find humor in mocking or satirizing controversial public figures.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14778119"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
