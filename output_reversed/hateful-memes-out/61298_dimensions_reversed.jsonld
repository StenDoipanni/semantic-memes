    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_809aed31",
      "@type": "Scene",
      "instance_name": "child_with_text",
      "label": "child juxtaposed with contrasting text",
      "description": "A young girl with green-dyed hair is centrally positioned in the image, looking at the camera with a slight smile. Superimposed over the image are two blocks of text: one at the top stating 'not old enough to choose own bed time or daily diet', and another at the bottom stating 'but old enough to choose to be trans or gender fluid or non-binary or..'. The scene uses the child's visual presence to contrast with the text, creating a meme that implies a perceived contradiction in age-appropriate decision-making.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_38dc0250"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b786776e",
      "@type": "BackgroundKnowledge",
      "instance_name": "gender_identity_choices",
      "label": "Gender Identity Choices",
      "description": "The concept that gender identity (such as being transgender, gender fluid, or non-binary) is a deeply personal and complex aspect of identity, often not a 'choice' in the simplistic sense implied by the meme. This knowledge is necessary to understand the meme's false equivalence and the harm in framing gender identity as a choice made by a child.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_38dc0250"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ec25c7ff",
      "@type": "BackgroundKnowledge",
      "instance_name": "age_appropriate_decision_making",
      "label": "Age-Appropriate Decision-Making",
      "description": "The societal understanding that children are not expected to make certain life decisions (like choosing their own bedtime or diet) because they lack the maturity or cognitive capacity to do so. This is contrasted with the meme's implication that gender identity is a 'choice' that requires more maturity, which is a false equivalence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_38dc0250"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d817f7ad",
      "@type": "BackgroundKnowledge",
      "instance_name": "infantilization",
      "label": "Infantilization",
      "description": "The act of portraying someone as immature or childlike, often to diminish their perceived agency or seriousness. The meme uses the image of a young girl to infantilize the discussion of gender identity, implying that those who identify as trans or non-binary are somehow 'too young' or 'not mature enough' to make such choices, which is a harmful stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_38dc0250"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1aac492a",
      "@type": "BackgroundKnowledge",
      "instance_name": "lgbtq_plus_discrimination",
      "label": "LGBTQ+ Discrimination",
      "description": "The broader social phenomenon of prejudice and discrimination against LGBTQ+ individuals, including the use of harmful stereotypes such as framing gender identity as a 'lifestyle choice' or 'confused' decision. This background knowledge is necessary to understand the meme's intent to stigmatize and mock the LGBTQ+ community.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_38dc0250"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e8b84592",
      "@type": "BackgroundKnowledge",
      "instance_name": "false_equivalence",
      "label": "False Equivalence",
      "description": "A logical fallacy that occurs when two things are presented as being equivalent or comparable when they are not. The meme falsely equates the maturity required to choose one's bedtime with the maturity required to choose one's gender identity, which is a misleading and harmful comparison.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_38dc0250"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c5790fdb",
      "@type": "BackgroundKnowledge",
      "instance_name": "stereotype_of_childhood",
      "label": "Stereotype of Childhood",
      "description": "The societal stereotype that children are inherently immature and incapable of making complex decisions. The meme relies on this stereotype to frame the discussion of gender identity as something that requires 'maturity' that a child lacks, which is a harmful oversimplification.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_38dc0250"
