    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bb9c4eb8",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Goats are mapped as Muslims",
      "description": "The visual material of scavenging goats is mapped onto the textual entity 'the muslims' in the phrase 'the muslims won't rape you now'. This is an analogical mapping where the image of dirty, scavenging animals is used to represent Muslims as 'uncivilized' or 'dangerous', aligning with the islamophobic stereotype of Muslims as rapists and 'backwards culture'. The goats' behavior (eating trash) is metaphorically equated with the perceived 'uncleanliness' or 'danger' of Muslims, creating a dehumanizing visual association.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_540c2d0b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5c2f798d",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual claim addressing 'you'",
      "description": "The user is projected onto the textual material 'the muslims won't rape you now', which directly addresses 'you' as the recipient of the false safety claim. This creates a direct semiotic projection where the viewer is positioned as the 'you' being addressed by the meme's message, making them the target of the implied threat and the recipient of the false reassurance. The projection is explicit through the deictic pronoun 'you' in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_540c2d0b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
