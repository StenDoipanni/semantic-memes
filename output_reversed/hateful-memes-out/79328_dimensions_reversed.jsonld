    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5a2225b9",
      "@type": "EmotionExpression",
      "instance_name": "mocking_humor",
      "label": "mocking and sarcastic expression",
      "description": "The image combines John McCain's broad, open-mouthed smile with overlaid text that sarcastically apologizes to Trump while implying he was 'captured' by Putin. The expression is not genuine happiness but rather a performative, exaggerated grin used to convey ironic amusement or derision toward the political situation described in the text. The visual and textual elements together create a mocking tone, suggesting the speaker is laughing at the absurdity or weakness implied by the claim.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9f065e8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ba718afc",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "John McCain is mapped as the speaker of the sarcastic apology",
      "description": "The text 'sorry, trump...' is overlaid on John McCain's image, implying that he is the one apologizing to Trump. His smiling expression is used to convey sarcastic or mocking humor, projecting the persona of a speaker delivering the text. The visual material (John McCain) is mapped onto the textual material (the apology) to create the illusion that he is the source of the statement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9f065e8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d8b295ef",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material expressing a sarcastic preference",
      "description": "The user is projected onto the bottom textual material ('i just prefer presidents who weren't captured by putin!') as the implied speaker of the sarcastic statement. The meme uses John McCain's image to visually represent this speaker, creating a projection where the user identifies with or imagines themselves as the person making this politically charged, mocking preference. The text directly addresses the user's perspective by framing the statement as a personal, subjective choice, thereby projecting the user's identity onto the textual content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9f065e8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
