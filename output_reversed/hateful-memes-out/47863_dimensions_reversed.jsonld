    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2dc9bfdd",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "Boy is mapped as the winner in a female sport",
      "description": "The top text 'he won because he is a boy' explicitly maps the visual entity 'boy' (the central child athlete kicking the ball) as the subject who 'won'. This mapping is reinforced by the bottom text 'competing in a female sport', which contextualizes the boy's victory within a space traditionally associated with women, creating an analogical mapping where the boy's gender is presented as the causal factor for his success. The visual material (the boy) is thus mapped onto the textual concept of 'he won because he is a boy'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cc21361e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a9be2e8a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the boy as the winner in a female sport",
      "description": "The user is projected onto the visual entity 'boy' (the central child athlete kicking the ball) as the subject of the victory, with the textual material 'he won because he is a boy' and 'competing in a female sport' framing this projection. The meme implicitly invites the user to identify with or see themselves as the boy who 'won' due to his gender, reinforcing the misogynistic message by projecting the user's potential identification onto the boy's gendered triumph.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cc21361e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
