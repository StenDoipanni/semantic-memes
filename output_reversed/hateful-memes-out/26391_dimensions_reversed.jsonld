    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_46b2e896",
      "@type": "Scene",
      "instance_name": "sarcastic_response_scene",
      "label": "woman delivering sarcastic comeback",
      "description": "The scene depicts a woman with a bruised eye, who is visually positioned as the victim of domestic abuse, delivering a sarcastic comeback in response to her husband's request for a sandwich. The text overlays frame her response as a punchline, juxtaposing her physical suffering with a humorous, yet deeply problematic, retort. The composition places her in the foreground, emphasizing her emotional and physical state as central to the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f20df397"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_72ce96a3",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_stereotype",
      "label": "Misogynous Stereotype",
      "description": "The stereotype that women 'belong in the kitchen' and are expected to be submissive, often portrayed as physically harmed or emotionally dependent in domestic settings. This is reinforced by the meme's framing of the woman's bruise as a punchline to her sarcastic comeback, trivializing domestic violence and reinforcing gendered power dynamics.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f20df397"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eaf144e1",
      "@type": "BackgroundKnowledge",
      "instance_name": "domestic_abuse_tradition",
      "label": "Domestic Abuse as a Cultural Trope",
      "description": "The implicit cultural understanding that domestic abuse is often normalized or trivialized in humor, particularly when it involves women. The meme uses the visual of a bruised eye to imply abuse, which is a common trope in misogynistic humor that frames suffering as a punchline or joke.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f20df397"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f8c2ef45",
      "@type": "BackgroundKnowledge",
      "instance_name": "sarcastic_response_trope",
      "label": "Sarcastic Comeback Trope",
      "description": "The trope of using sarcasm or irony as a 'comeback' in response to an unreasonable or demeaning request, often used to mask deeper emotional or physical distress. In this meme, the sarcastic response 'I would come back with a sandwich' is used to imply the woman is being punished or abused, making the joke darkly ironic.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f20df397"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f53dd43d",
      "@type": "BackgroundKnowledge",
      "instance_name": "domestic_violence_normative_stereotype",
      "label": "Normative Stereotype of Domestic Violence",
      "description": "The stereotype that domestic violence is a private, often unspoken, and normalized part of relationships, particularly in patriarchal structures. The meme implies that the woman's suffering is accepted or expected, and her sarcastic response is framed as a 'comeback' rather than a plea for help or an expression of trauma.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f20df397"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9041c855",
      "@type": "BackgroundKnowledge",
      "instance_name": "gendered_power_dynamics",
      "label": "Gendered Power Dynamics",
      "description": "The implicit understanding that power imbalances in relationships are often gendered, with men holding dominant roles and women expected to be submissive or caretakers. The meme reinforces this by framing the husband's request as a trivial task and the woman's response as a sarcastic 'comeback' that implies she is being punished for not complying.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f20df397"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ba0664a4",
      "@type": "EmotionExpression",
      "instance_name": "sarcastic_irony",
      "label": "sarcastic and ironic emotional expression",
      "description": "The woman with the bruised eye delivers a sarcastic comeback, 'I would come back with a sandwich,' which is emotionally ironic given her physical state. The expression is not genuine amusement but a darkly humorous mask for pain or resignation, implying the husband's request is a form of abuse or control. The text overlays frame this as a punchline, reinforcing the emotional weight of the sarcasm.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f20df397"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9d3d4038",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The sarcastic comeback is mapped onto the woman with the bruised eye",
      "description": "The text 'i would come back with a sandwich' is presented as a sarcastic response from the woman with the bruised eye. The visual of her bruised face is mapped onto this textual element to imply that her physical suffering is the 'comeback' to her husband's request, creating an analogical mapping where her pain is framed as a punchline. This mapping reinforces the misogynous stereotype that women are expected to be submissive and that their suffering is a form of 'revenge' or 'comeback' in domestic settings.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f20df397"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c32cf419",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman with the bruised eye as the victim of domestic abuse",
      "description": "The user is projected onto the visual material of the woman with the bruised eye, who is depicted as the victim of domestic abuse. The meme's overall intent and textual content frame her suffering as a punchline to her sarcastic comeback, which implies the user (as a viewer) is meant to identify with her position of victimhood and the dark humor of her response. The projection is implicit, not explicit with deictic pronouns, but the visual and textual framing invites the user to see themselves as the recipient of the joke — the one who might be in a similar situation or who is laughing at the absurdity of the 'comeback' while ignoring the abuse. The user is projected onto the scene of sarcastic response and the visual material of the bruised woman, who embodies the trope of the abused woman in a domestic setting.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f20df397"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3dc7c069",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Mysogynous",
      "description": "The meme trivializes domestic violence by framing a woman's physical suffering as a punchline to a sarcastic comeback, reinforcing the harmful stereotype that women 'belong in the kitchen' and are expected to be submissive or physically harmed in domestic settings.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f20df397"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_98c853a8",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who consume and appreciate darkly humorous, misogynistic content that trivializes domestic violence by framing a woman's physical suffering as a punchline to a sarcastic comeback. This audience likely identifies with or enjoys internet memes that rely on gendered power dynamics, where women are expected to be submissive and 'belong in the kitchen,' and their distress or abuse is used for comedic effect. The meme appeals to those who find irony or sarcasm in situations involving domestic abuse, often normalizing or mocking the victim’s pain as a form of 'revenge' or 'comeback.' The audience may also be drawn to the visual trope of a bruised woman juxtaposed with text that implies her suffering is humorous, reinforcing the misogynous stereotype that women are emotionally or physically dependent in domestic settings.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f20df397"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
