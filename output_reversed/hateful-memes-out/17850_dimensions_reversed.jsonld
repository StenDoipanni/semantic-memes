      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6af7f561",
      "@type": "BackgroundKnowledge",
      "instance_name": "martin_luther_king_jr",
      "label": "Martin Luther King Jr.",
      "description": "Martin Luther King Jr. was a Baptist minister and activist who became the most visible spokesperson and leader in the civil rights movement from 1955 until his assassination in 1968. His legacy is deeply associated with nonviolent resistance and racial equality. The blurred portrait in the background symbolizes his historical significance and the weight of his legacy.",
      "belongsToAnalysis": {
