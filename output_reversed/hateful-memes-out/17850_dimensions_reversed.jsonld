    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7da90fdb",
      "@type": "BackgroundKnowledge",
      "instance_name": "civil_rights_movement",
      "label": "Civil Rights Movement",
      "description": "The Civil Rights Movement was a social movement in the United States that aimed to end racial segregation and discrimination against African Americans. It was a pivotal period in American history, led by figures like Martin Luther King Jr. and organizations such as the NAACP and SCLC. The meme uses this movement's legacy to frame the speaker's political stance, implying that the speaker's decision to leave is a reaction to perceived threats to civil rights.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab13f37b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9da22232",
      "@type": "BackgroundKnowledge",
      "instance_name": "political_polarization",
      "label": "Political Polarization",
      "description": "Political polarization refers to the increasing ideological divide between political parties or groups in a society. The meme's call to 'like and share' encourages engagement based on a divisive political stance, which can amplify polarization and misinformation. This concept is implicit in the meme's structure and intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab13f37b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_310c43a1",
      "@type": "BackgroundKnowledge",
      "instance_name": "social_media_engagement",
      "label": "Social Media Engagement",
      "description": "Social media engagement refers to the interaction and participation of users on social media platforms, such as liking, sharing, and commenting. The meme's call to 'like and share' is a common tactic used to encourage user interaction and virality, which is a key aspect of modern meme culture.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab13f37b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9e8b3e2a",
      "@type": "BackgroundKnowledge",
      "instance_name": "performative_outrage",
      "label": "Performative Outrage",
      "description": "Performative outrage is a rhetorical strategy where individuals or groups express strong emotional reactions to issues in order to gain attention or support, often without genuine intent to act. The meme's use of a revered civil rights leader to frame a political decision as a personal, existential choice can be seen as performative outrage, as it weaponizes historical symbolism for emotional effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab13f37b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c0d8ac45",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_symbolism",
      "label": "Historical Symbolism",
      "description": "Historical symbolism refers to the use of historical figures, events, or artifacts to convey meaning or evoke emotion. In this meme, the blurred portrait of Martin Luther King Jr. serves as a symbol of civil rights history, which is used to frame the speaker's political statement and add weight to the message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab13f37b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_04c97bef",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_culture",
      "label": "Meme Culture",
      "description": "Meme culture refers to the creation, sharing, and modification of internet memes, which are often humorous, satirical, or provocative images or videos. The meme's structure, including the use of text overlays and the call to action, is typical of meme culture, which often relies on irony, exaggeration, and audience participation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab13f37b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d3067bc1",
      "@type": "EmotionExpression",
      "instance_name": "urgent_concern",
      "label": "urgent concern emotion",
      "description": "The man's facial expression, with furrowed brows, wide eyes, and an open mouth, conveys a sense of urgency and deep concern. His pointing gesture reinforces this emotional state, suggesting a strong, immediate reaction to the political statement. The overall expression is one of alarm and seriousness regarding the potential election of Trump.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab13f37b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_89f01d81",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The speaker (the man in the suit) is mapped as 'me' in the text",
      "description": "The text 'if trump gets elected, i'm leaving the country!' uses the first-person pronoun 'i', which directly maps to the visual entity 'man' (Al Sharpton) in the foreground. The speaker is explicitly identifying himself as 'i' in the statement, making the visual man the embodiment of the textual 'me'. This is a direct analogical mapping where the visual person is projected as the subject of the personal statement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab13f37b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3ec46813",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the speaker (man in suit) as 'me'",
      "description": "The user is projected onto the visual entity 'man' (Al Sharpton) through the first-person pronoun 'i' in the text overlay 'if trump gets elected, i'm leaving the country!'. This creates a direct analogical mapping where the user identifies with the speaker, making the visual man the embodiment of the textual 'me'. The user is thus projected onto the man as the subject of the personal statement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab13f37b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c77dbf89",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_2",
      "label": "User projected onto the call to action as 'you'",
      "description": "The user is projected onto the textual material 'like and share if you think i should leave' through the second-person pronoun 'you'. This invites the user to engage with the meme by making a personal judgment ('you think i should leave'), thereby projecting the user's identity onto the audience role within the meme's interactive structure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab13f37b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_89375412",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme weaponizes the image of Martin Luther King Jr. to frame a political decision as a personal, existential choice, potentially undermining the legacy of MLK and reducing complex political discourse to a simplistic, emotionally charged statement. The juxtaposition of the serious historical figure with the absurdity of 'leaving the country' creates a tone of performative outrage that can be seen as disrespectful to the civil rights movement and its leaders. The meme also encourages engagement ('like and share') based on a potentially divisive political stance, which can amplify polarization and misinformation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab13f37b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f60d3ea1",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals who are politically engaged, particularly those who identify with or follow civil rights leaders like Al Sharpton and Martin Luther King Jr., and who are active on social media platforms. The meme is designed to resonate with people who feel strongly about political polarization and social justice issues, especially those who view Donald Trump's presidency as a threat to civil rights and social progress. The call to 'like and share' indicates the meme is intended for an audience that participates in online political discourse and seeks to amplify their views through social media engagement. The use of historical symbolism and performative outrage suggests the target audience values emotional and symbolic expressions of political dissent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ab13f37b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
