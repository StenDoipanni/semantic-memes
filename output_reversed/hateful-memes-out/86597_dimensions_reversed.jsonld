    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_10df1358",
      "@type": "AnalogicalMapping",
      "instance_name": "baboon_congress_mapping",
      "label": "Political body metaphor mapping",
      "description": "The text 'a group of baboons is called a congress' maps the visual entity 'baboons' (a group of primates) onto the textual concept 'congress' (a human political body). This creates an analogical mapping where the visual group of baboons is equated with a political institution, forming the core pun and humorous comparison in the meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e58cc306"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_289c9fd6",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material expressing personal realization",
      "description": "The user is projected onto the bottom textual material 'it's all clear to me now', which uses the first-person pronoun 'me' to indicate a personal epiphany or understanding. This creates a semiotic projection where the viewer identifies with the speaker of the text, imagining themselves as the one who has suddenly understood the pun or the underlying message. The projection is onto the textual material, not the visual material or scene, as the deictic 'me' explicitly anchors the experience to the user's own perspective.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e58cc306"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
