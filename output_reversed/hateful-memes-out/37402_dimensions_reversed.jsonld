    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f1113120",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Stoner friend is mapped onto the goat",
      "description": "The text 'when your stoner friend' explicitly refers to a person (the stoner friend) whose behavior is being humorously depicted. The visual material, the goat staring judgmentally, is used as an analogical stand-in for this stoner friend. The goat's expression and direct gaze are mapped onto the perceived demeanor of the stoner friend, creating a visual metaphor. This mapping is central to the meme's humor and intent, as the goat represents the 'weird' or 'mischievous' nature of the stoner friend described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_33daed2a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_44294af2",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of the goat staring",
      "description": "The user is projected onto the scene where the goat is staring directly at the viewer, as the text 'when your stoner friend looks in your fridge' implies the user is the one whose fridge is being accessed. The goat's direct gaze and judgmental expression are used to represent the stoner friend's behavior, and the user is implicitly positioned as the person whose fridge was looked into. This projection is reinforced by the deictic 'your' in the text, which directs the viewer to identify with the owner of the fridge (the user).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_33daed2a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
