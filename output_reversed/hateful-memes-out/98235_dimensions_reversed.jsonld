      "@id": "http://example.org/multimodal-taxonomy#dimension_d5b8227c",
      "@type": "Scene",
      "instance_name": "fashionable_woman_leaning",
      "label": "woman leaning against railing",
      "description": "A woman wearing a hijab, sunglasses, a Nike sweatshirt, leather jacket, and studded gloves is leaning against a metal railing in an urban setting. She appears confident and stylish, with the text 'fashion forward!' overlaid on the image.",
      "belongsToAnalysis": {
