    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c94d8493",
      "@type": "EmotionExpression",
      "instance_name": "contempt",
      "label": "contemptuous expression",
      "description": "The man's serious, unsmiling facial expression, combined with the pointing gesture to his head, conveys a sense of disdain or condescension toward the viewer or the subject matter. This is not a neutral 'thinking' pose but one that implies superiority or smugness in presenting a simplistic, provocative idea.",
      "belongsToAnalysis": {
