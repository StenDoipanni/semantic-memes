    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_231249b4",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_context_of_middle_eastern_conflicts",
      "label": "Historical Context of Middle Eastern Conflicts",
      "description": "The meme references the 'west started invading middle eastern countries' as a trigger for terrorism. This requires background knowledge of real-world geopolitical events, including the history of Western military interventions in the Middle East (e.g., Iraq War, Afghanistan War, etc.), which are complex and multifaceted, involving political, economic, and strategic interests, not just religious motivations.",
      "belongsToAnalysis": {
