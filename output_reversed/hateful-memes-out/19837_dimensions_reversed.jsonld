    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ac790be5",
      "@type": "BackgroundKnowledge",
      "instance_name": "donald_trump",
      "label": "Donald Trump",
      "description": "Donald Trump is the 45th President of the United States (2017-2021) and a prominent political figure known for his distinctive public persona, controversial statements, and frequent media presence. His image and actions are widely recognized and often subject to satire or commentary in popular culture. The meme references his public behavior (eating a sandwich under a red umbrella) and associates it with the top image's self-deprecating tone, implying a contrast between private self-awareness and public image.",
