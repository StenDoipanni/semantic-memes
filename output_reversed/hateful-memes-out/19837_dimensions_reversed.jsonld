    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c77483fb",
      "@type": "BackgroundKnowledge",
      "instance_name": "selfie_culture",
      "label": "Selfie Culture",
      "description": "The widespread practice of taking and sharing self-portraits, especially via smartphones, which has become a dominant aspect of modern social media and personal identity expression. The top image's text 'felt cute.. might delete later!' is a direct reference to this cultural phenomenon, where individuals often post photos they feel are flattering or endearing, even if they later regret them. This context is necessary to understand the ironic tone of the top image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c9ae21a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6ca4ea33",
      "@type": "BackgroundKnowledge",
      "instance_name": "political_satire",
      "label": "Political Satire",
      "description": "A genre of humor that uses exaggeration, irony, and ridicule to critique or comment on political figures, institutions, or events. The meme functions as a form of political satire by juxtaposing a mundane, self-aware moment (the selfie) with a public figure known for his controversial persona (Trump eating a sandwich). Understanding this genre is essential to interpret the meme's intent as humorous or critical rather than literal.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c9ae21a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a1164ecb",
      "@type": "BackgroundKnowledge",
      "instance_name": "public_figure_behavior",
      "label": "Public Figure Behavior",
      "description": "The actions, appearances, and public statements of individuals who are widely known and often scrutinized by the media and the public. The meme relies on the audience's knowledge of Donald Trump as a public figure whose behavior (e.g., eating a sandwich in public, wearing campaign gear) is often commented on or satirized. The contrast between the top image's casual self-awareness and the bottom image's public persona is a key element of the meme's humor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c9ae21a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_15fd2e57",
      "@type": "BackgroundKnowledge",
      "instance_name": "irony",
      "label": "Irony",
      "description": "A rhetorical device where the intended meaning is the opposite of the literal meaning, often used for humor or emphasis. The meme uses irony by contrasting the top image's self-deprecating text ('felt cute.. might delete later!') with the bottom image of Trump, implying that his public behavior might be seen as 'cute' or endearing in a self-aware, ironic way, but potentially 'delete later' due to its controversial nature. This requires understanding the concept of irony to interpret the meme's humor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c9ae21a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f1fcfad4",
      "@type": "EmotionExpression",
      "instance_name": "self_awareness",
      "label": "self-aware emotional expression",
      "description": "The man in the top image is posing for a selfie while touching his hair and looking at the camera, with text overlay 'felt cute.. might delete later!' This conveys a self-aware, slightly humorous, and self-deprecating emotion, acknowledging that the photo might be perceived as endearing but also potentially regrettable or unflattering.",
      "belongsToAnalysis": {
