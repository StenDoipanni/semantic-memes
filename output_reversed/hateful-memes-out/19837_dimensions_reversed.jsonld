    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1326e379",
      "@type": "BackgroundKnowledge",
      "instance_name": "make_america_great_again",
      "label": "Make America Great Again",
      "description": "A political slogan and campaign promise used by Donald Trump during his 2016 presidential campaign and subsequent presidency. It became a widely recognized and often parodied symbol of his political brand, associated with his populist messaging and conservative base. The phrase is visible on the red cap worn by Trump in the bottom image, making it a key identifier of the scene.",
      "belongsToAnalysis": {
