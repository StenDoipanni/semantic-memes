    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a920065a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Trump's public behavior is mapped as 'cute' and 'might delete later'",
      "description": "The top image's text 'felt cute.. might delete later!' is used to analogically map Donald Trump's public behavior (as shown in the bottom image) to a self-deprecating, private moment. The meme implies that Trump's public persona or actions (like eating a sandwich under a red umbrella while wearing a MAGA hat) might be seen as 'cute' or endearing in a self-aware, ironic way, but potentially 'delete later' due to its controversial nature. This mapping is established through the juxtaposition of the two images and the ironic tone of the text overlay.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c9ae21a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a2f5ad7a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the self-deprecating selfie scene",
      "description": "The user is projected onto the top image's scene (man_taking_selfie) and its textual material (text_overlay), as the meme uses the phrase 'felt cute.. might delete later!' to imply a self-aware, private moment. The user is invited to imagine themselves in that position, projecting their own potential self-consciousness or social media behavior onto the visual and textual elements. This projection is implicit, not explicit, but it is a core part of the meme's humor and irony, as the user is encouraged to relate to the sentiment of posting something they later regret.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c9ae21a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
