    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4e8d4eec",
      "@type": "Scene",
      "instance_name": "birthday_greeting_scene",
      "label": "Voldemort delivering a menacing birthday message",
      "description": "The scene features Voldemort in a close-up, baring his teeth with a distorted, menacing expression, while overlaid text reads 'happy birthday i nose it will be good'. The text is a pun on his famous line 'I know it will be good', altered to include 'nose' as a play on his distinctive nose. The background is blurred, showing indistinct figures, suggesting a dark, ominous setting. The scene's composition centers on Voldemort as the primary participant, with the text serving as the message being delivered. The spatial arrangement places Voldemort in the foreground, dominating the frame, while the background figures are out of focus, emphasizing his presence and the sinister tone of the greeting.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_32f2b9f6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2c57b1e6",
      "@type": "BackgroundKnowledge",
      "instance_name": "voldemort_character",
      "label": "Lord Voldemort",
      "description": "The character Lord Voldemort from the Harry Potter series, portrayed by actor Ralph Fiennes. His iconic appearance includes a bald, pale-skinned face with a long, pointed nose and sharp, menacing facial features. He is a central figure in the Harry Potter universe as the primary antagonist, known for his dark magic, evil intentions, and association with death and destruction. The meme leverages his villainous persona for dark humor.",
      "belongsToAnalysis": {
