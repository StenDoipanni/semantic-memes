    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5bcb286d",
      "@type": "VisualMaterial",
      "instance_name": "Voldemort",
      "label": "character",
      "description": "A bald, pale-skinned man with a long, pointed nose and sharp, menacing facial features, wearing dark clothing. He is shown in a close-up shot with an intense, distorted expression, baring his teeth. This is the character Lord Voldemort from the Harry Potter series, portrayed by actor Ralph Fiennes. His appearance is iconic for its villainous and supernatural qualities, including his pale skin, dark eyes, and distinctive nose. The character is central to the image and is the primary visual element.",
      "belongsToAnalysis": {
