    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d1532b73",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_comparing_to_primates",
      "label": "Anti-Black Stereotype: Comparing Black People to Primates",
      "description": "This stereotype, historically rooted in racist pseudoscience and colonialism, dehumanizes Black individuals by equating them with animals or primates. It is used to justify oppression, violence, and systemic discrimination. In this meme, the darkened skin and stern expression of the Black woman are used to visually imply animalistic or primitive traits, directly invoking this harmful trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b08a874c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0d41f588",
      "@type": "BackgroundKnowledge",
      "instance_name": "alcohol_consumption_consequence",
      "label": "Alcohol Consumption Consequence",
      "description": "The meme implies that excessive alcohol consumption leads to a dehumanizing, animalistic state. This is a harmful and false generalization that uses alcohol as a proxy for moral decay or loss of humanity, often used to stigmatize individuals who drink heavily. The 'end result' label reinforces this simplistic and dangerous narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b08a874c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_298f25fb",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_stereotype_in_meme",
      "label": "Racial Stereotype in Meme",
      "description": "The meme relies on a racial stereotype that associates Black people with negative, dehumanizing traits. This is not a neutral or factual representation but a form of racial caricature that perpetuates systemic racism. The use of a Black person's face to represent the 'end result' of drinking is a direct and offensive attack based on race, invoking a long-standing and deeply damaging anti-Black trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b08a874c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_47b0c21a",
      "@type": "EmotionExpression",
      "instance_name": "dehumanization",
      "label": "dehumanizing emotion",
      "description": "The emotion expressed is one of dehumanization, conveyed through the visual juxtaposition of alcohol consumption with a Black woman whose skin is darkened and expression is stern, implying she is reduced to an animalistic or primitive state. This is a hateful and racist caricature.",
      "belongsToAnalysis": {
