    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_302d3f9c",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed for an audience that may find racist stereotypes humorous or acceptable, particularly those who are unaware of or indifferent to the historical and systemic harm caused by equating Black people with primates or animals. The target audience likely includes individuals who consume internet memes without critically evaluating their racial implications, and who may be drawn to the shock value or exaggerated visual contrast. The meme’s appeal relies on the audience’s ability to interpret the 'end result' as a consequence of alcohol consumption, without recognizing the dehumanizing racial caricature. This audience may be predominantly white, given the historical context of anti-Black racism in media and the meme’s reliance on racialized visual tropes. The meme’s toxicity and hateful intent suggest it is not intended for audiences who are sensitive to racial injustice or who are educated about the history of anti-Black stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b08a874c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
