    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a5df777b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Alcohol consumption consequence mapped to dehumanized Black woman",
      "description": "The text 'too much alcohol' is mapped onto the visual of the hand holding the beer can, while the text 'end result' is mapped onto the visual of the Black woman with darkened skin and stern expression. This creates an analogical mapping where the visual of the woman is projected as the consequence of excessive alcohol consumption, invoking a harmful racial stereotype that equates Black people with primates or animals. The mapping is explicit through the juxtaposition and labeling, where the woman's appearance is used to represent the 'end result' of drinking, thus linking the textual concept of alcohol consequence to the visual representation of a dehumanized Black person.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b08a874c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_70894d2b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the dehumanizing racial stereotype depicted in the meme",
      "description": "The user is implicitly projected onto the harmful racial stereotype presented in the meme, where the 'end result' of 'too much alcohol' is visually represented by a Black woman with darkened skin and a stern expression, invoking the anti-Black trope of equating Black people with primates or animals. This projection is not explicit through deictic pronouns like 'me' or 'you', but is implied through the meme's structure and the user's engagement with the harmful analogy. The user is projected onto the scene and the visual material that collectively constitute the racist caricature.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b08a874c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2dd79d2b",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks Black individuals through a racist caricature, equating them with primates or animals based on their race, which is a hateful and dehumanizing representation.",
      "belongsToAnalysis": {
