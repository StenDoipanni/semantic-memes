    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9fc40362",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism",
      "label": "ableism",
      "description": "The meme relies on the concept of ableism, specifically the infantilization of people with developmental disabilities. The phrase 'i'm cute' is used to reduce the person's identity to a superficial, childlike aesthetic, which is a form of ableist infantilization. This trope is harmful because it diminishes the person's autonomy, competence, and full humanity by equating their worth with aesthetic appeal rather than their individuality, capabilities, or lived experience. It reinforces the 'inspiration porn' and 'pity narrative' stereotypes that are central to ableism, potentially causing emotional harm to the individual and perpetuating societal devaluation of people with disabilities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b8cea3f6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0d69997a",
      "@type": "BackgroundKnowledge",
      "instance_name": "inspiration_porn",
      "label": "inspiration porn",
      "description": "A term used to describe media portrayals that depict people with disabilities as inspirational or heroic, often in a way that reinforces pity or infantilization rather than celebrating their autonomy and capabilities. The meme's text 'i'm cute' fits into this trope by reducing the person's identity to a superficial, childlike aesthetic, which is a form of ableist infantilization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b8cea3f6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fcb5cf62",
      "@type": "BackgroundKnowledge",
      "instance_name": "pity_narrative",
      "label": "pity narrative",
      "description": "A stereotype that frames people with disabilities as objects of pity or charity, often portraying them as helpless or in need of rescue. The meme's text 'i'm cute' reinforces this narrative by reducing the person's identity to a superficial, childlike aesthetic, which is a form of ableist infantilization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b8cea3f6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b9c8a222",
      "@type": "BackgroundKnowledge",
      "instance_name": "developmental_disability_infantilization",
      "label": "developmental disability infantilization",
      "description": "A form of ableism that involves reducing people with developmental disabilities to childlike or infantile roles, often by using terms like 'cute' or 'adorable' to describe them. This trope is harmful because it diminishes the person's autonomy, competence, and full humanity by equating their worth with aesthetic appeal rather than their individuality, capabilities, or lived experience.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b8cea3f6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ade11482",
      "@type": "EmotionExpression",
      "instance_name": "infantilization",
      "label": "infantilizing emotion expression",
      "description": "The emotion expression is conveyed through the juxtaposition of the person's dignified, neutral-to-slightly-smiling facial expression with the overlaid text 'i'm cute,' which infantilizes her by reducing her identity to a superficial, childlike aesthetic. This creates an emotional tone of devaluation and objectification, rooted in ableist infantilization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b8cea3f6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9b684361",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The person is mapped as 'cute' by the text",
      "description": "The text 'i'm cute' is overlaid on the image of the person with developmental disability, creating an analogical mapping where the person is being represented as 'cute'. This mapping infantilizes the person by reducing her identity to a superficial, childlike aesthetic, which is a form of ableist infantilization. The text explicitly assigns the attribute 'cute' to the visual entity, thereby projecting the textual concept onto the person's visual representation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b8cea3f6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b1c2efba",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the textual material 'i'm cute' because the text explicitly assigns an infantilizing attribute to the visual subject. The phrase 'i'm cute' functions as a direct projection of the user's perspective onto the text, which then becomes the vehicle for the ableist infantilization of the person depicted. The user is not directly addressed by deictic pronouns like 'you' or 'me', but the text's assertion of 'cute' is a projection of the user's (or meme's) framing onto the subject, making the text the focal point of the semiotic projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b8cea3f6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5335ad5a",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme manifests harmful ableist infantilization by reducing a person with developmental disability to a superficial, childlike aesthetic through the text 'i'm cute.' This diminishes the person's autonomy, competence, and full humanity, reinforcing 'inspiration porn' and 'pity narrative' stereotypes that devalue people with disabilities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b8cea3f6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3f98e083",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience for this meme is individuals who may be familiar with or perpetuate ableist stereotypes, particularly those who find humor or aesthetic appeal in infantilizing people with developmental disabilities. The meme is designed to resonate with viewers who understand or enjoy the 'cute' trope applied to people with disabilities, often as a form of 'inspiration porn' or 'pity narrative' humor. This audience may include internet users who engage with memes that rely on reducing human dignity to superficial aesthetics, and who may not recognize the harm in such portrayals. The meme's appeal is likely to those who are not directly affected by ableism but who consume media that reinforces harmful stereotypes without critical reflection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b8cea3f6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
