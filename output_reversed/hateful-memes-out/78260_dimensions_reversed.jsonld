      "@id": "http://example.org/multimodal-taxonomy#dimension_8cb62c1e",
      "@type": "EmotionExpression",
      "instance_name": "hate",
      "label": "hateful emotion",
      "description": "The emotion expressed is hate, conveyed through the provocative text 'this offends me ban them' and the rhetorical question 'do you agree?', which incites hostility and calls for exclusion based on religious attire. The intense gaze of the person wearing the niqab further amplifies the confrontational and hateful tone of the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bb93c89f"
