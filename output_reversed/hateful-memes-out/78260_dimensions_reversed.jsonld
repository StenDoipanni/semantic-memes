    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b5795a67",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The person wearing the niqab is mapped as 'them' in the text 'ban them'",
      "description": "The text 'this offends me ban them' directly maps the visual entity 'person' (wearing the niqab) as the target of the ban. The rhetorical question 'do you agree?' reinforces this mapping by asking the viewer to align with the call to ban 'them', which is visually represented by the person in the niqab. This is a direct analogical mapping where the textual pronoun 'them' is projected onto the visual entity 'person'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bb93c89f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bbf37811",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the rhetorical question inviting agreement",
      "description": "The user is projected onto the textual material 'do you agree?' which directly addresses the viewer, prompting them to identify with the hateful sentiment expressed in the meme. This rhetorical question creates a direct semiotic projection where the viewer is positioned as the one who must decide whether to support the call to ban 'them'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bb93c89f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3c6d1ebd",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_2",
      "label": "User projected onto the call to action 'ban them'",
      "description": "The user is projected onto the textual material 'this offends me ban them', which frames the viewer as the one who experiences offense and therefore has the authority to enact the ban. The pronoun 'me' in 'this offends me' implicitly projects the viewer's identity onto the speaker of the sentiment, making the viewer feel personally implicated in the call to action.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bb93c89f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3a1e2648",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly targets Muslim women who wear the niqab by framing their religious attire as offensive and deserving of prohibition, invoking Islamophobic stereotypes such as oppression of women, backward culture, and incompatibility with Western values. The rhetorical question 'do you agree?' is a manipulative device to normalize and legitimize the hateful sentiment, inciting hostility and calls for exclusion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bb93c89f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_67ce96c5",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals who hold Islamophobic views or are predisposed to support discriminatory policies against Muslim women, particularly those who wear the niqab. The meme is designed to appeal to this audience by invoking stereotypes such as oppression of women, backward culture, and incompatibility with Western values, and by using a provocative call to action ('ban them') and a rhetorical question ('do you agree?') to normalize and legitimize hateful sentiment. The visual of the person wearing the niqab is used as a symbol to represent the group being targeted, and the overall intent is to incite hostility and support for exclusion.",
      "belongsToAnalysis": {
