    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3916f6dc",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Mark Zuckerberg is mapped as the embarrassed patient",
      "description": "The top text 'don't be embarrassed mark' directly addresses Mark Zuckerberg (visual entity) and implies he is the subject of embarrassment, which is then humorously contextualized by the bottom text and scene of a patient undergoing a rectal exam. The meme maps Mark Zuckerberg onto the role of the embarrassed patient in the lower panel, suggesting he is experiencing a common, awkward medical procedure.",
      "belongsToAnalysis": {
