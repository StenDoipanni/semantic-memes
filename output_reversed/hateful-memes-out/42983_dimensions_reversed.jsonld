    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_96891267",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Political protest is mapped onto a maternal feeding scene",
      "description": "The top text 'i protested trump today mommy' maps the act of political protest onto the visual scene of a maternal figure feeding a man spaghetti. The text implies that the man's protest is being 'fed' or 'nurtured' by a maternal figure, thereby infantilizing the political act and associating it with domestic care. The visual material (maternal_feeding_scene) is used to represent the textual concept (political_protest_stereotype).",
      "belongsToAnalysis": {
