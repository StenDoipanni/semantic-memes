    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c816b2d5",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the protestor as the 'big boy' being infantilized",
      "description": "The user is projected onto the man in the image, who is portrayed as the 'big boy' being fed and praised by the maternal figure. The text 'i protested trump today mommy' and 'ooOOOh, who's my big boy' creates an implicit deictic where the user identifies with the protestor, positioning themselves as the 'big boy' whose political action is being infantilized and cared for by a maternal figure. This projection is reinforced by the visual scene of nurturing care and the ironic textual framing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ffe75d48"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_53949671",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme trivializes political protest by infantilizing the protestor and associating it with domestic, maternal care, thereby undermining the seriousness of political engagement and potentially discouraging participation. This is harmful as it frames protest as an immature or emotionally driven activity, reducing adult political discourse to a childish, domestic context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ffe75d48"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3d0c45b4",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals who are familiar with political protest culture, particularly around Donald Trump, and who understand the meme format of ironic juxtaposition. The meme is designed to mock or belittle political activism by infantilizing it, implying that protesting is a childish or overly emotional activity associated with maternal care. This targets those who engage in or observe political protest, and likely those who find humor in satirical depictions of political behavior. The use of 'mommy' and 'big boy' references also targets audiences familiar with domestic infantilization tropes, potentially including those who view political engagement through a lens of emotional or childish behavior. The meme’s humor relies on cultural knowledge of Trump as a polarizing political figure and the meme convention of using maternal feeding scenes to symbolize infantilization, thus appealing to an audience that recognizes and engages with internet satire and political commentary.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ffe75d48"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
