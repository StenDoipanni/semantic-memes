      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_63160620",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitism",
      "label": "Antisemitism",
      "description": "A long-standing form of prejudice, discrimination, and hostility directed against Jewish people. It includes a range of harmful stereotypes and conspiracy theories, such as the idea that Jews control global finance or are responsible for historical atrocities. The meme invokes antisemitism by associating Stephen Miller with Jewish identity and Nazi ideology, which is a form of hate speech.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aebd2348"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7e762a90",
      "@type": "BackgroundKnowledge",
      "instance_name": "jewish_identity",
      "label": "Jewish Identity",
      "description": "The cultural, religious, and ethnic identity of Jewish people, which is often targeted by antisemitic stereotypes. The meme falsely attributes Jewish identity to Stephen Miller, which is a baseless and hateful claim, as Miller is not Jewish. This is a key element of the antisemitic stereotype being invoked.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aebd2348"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a3e2607f",
      "@type": "EmotionExpression",
      "instance_name": "hateful_anger",
      "label": "hateful anger expression",
      "description": "The emotion expressed is hateful anger, conveyed through the juxtaposition of Stephen Miller's smiling, seemingly benign facial expression with the hateful text 'the jew with the soul of a nazi.' The smile is used ironically to contrast with the deeply antisemitic and hateful accusation, creating an emotionally charged and hostile tone. The overall scene is designed to provoke anger and disgust by associating a political figure with a dehumanizing antisemitic stereotype.",
      "belongsToAnalysis": {
