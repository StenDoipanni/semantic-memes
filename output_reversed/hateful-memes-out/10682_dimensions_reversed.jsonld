    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_61bc0b00",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Stephen Miller is mapped as 'the jew with the soul of a nazi'",
      "description": "The textual phrase 'the jew with the soul of a nazi' is directly mapped onto the visual entity Stephen Miller. This mapping is established by the juxtaposition of the text with his image, creating an analogical relationship where the text assigns him the antisemitic stereotype. The mapping is hateful and dehumanizing, falsely attributing Jewish identity and Nazi moral equivalence to him, which is a core element of the meme's overall intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aebd2348"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9b0c227a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the antisemitic stereotype applied to Stephen Miller",
      "description": "The user is not explicitly projected onto a specific deictic pronoun like 'me' or 'you' in the textual material. However, the meme's overall intent and structure create an implicit projection where the user is positioned as the one who is morally outraged or disgusted by Stephen Miller's policies, and thus identifies with the hateful stereotype being applied to him. The user is projected onto the hateful attack scene, which frames Miller as 'the jew with the soul of a nazi,' thereby implicitly aligning the user with the act of vilification and dehumanization. The projection is onto the scene and the textual stereotype, not a direct deictic reference.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aebd2348"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b8e02f49",
