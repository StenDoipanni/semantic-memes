      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4c8abe2f",
      "@type": "BackgroundKnowledge",
      "instance_name": "stephen_miller_policy_separation",
      "label": "Stephen Miller's Role in Family Separation Policy",
      "description": "Stephen Miller is a political advisor who served as a senior policy advisor to the U.S. Department of Homeland Security under the Trump administration. He was a key architect of the controversial 'zero tolerance' policy that led to the separation of children from their parents at the U.S.-Mexico border in 2018. This policy was widely criticized for its humanitarian consequences and is the central factual claim in the top text of the meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aebd2348"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b365fb1b",
      "@type": "BackgroundKnowledge",
      "instance_name": "nazi_ideology",
      "label": "Nazi Ideology",
      "description": "The ideology of the Nazi Party in Germany (1933-1945), characterized by extreme nationalism, racial supremacy (particularly anti-Semitism), totalitarian control, and the Holocaust. The term 'soul of a Nazi' is used in the meme to imply moral equivalence with the perpetrators of genocide and crimes against humanity, which is a hateful and historically inaccurate association.",
      "belongsToAnalysis": {
