    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0a441a7b",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who hold antisemitic beliefs or are sympathetic to hate speech targeting Jewish people, particularly those who support or are influenced by far-right political ideologies that vilify Jewish individuals and associate them with Nazi ideology. The meme is designed to resonate with communities that propagate antisemitic tropes, such as 'the Jew with the soul of a Nazi,' and who may view Stephen Miller as a figure to be attacked based on these stereotypes. The audience likely includes supporters of the Trump administration's immigration policies who are also receptive to hateful rhetoric, as well as those who engage in online discourse that normalizes or amplifies antisemitic content. The meme's use of hateful language and historical antisemitic imagery indicates it is intended for an audience that either accepts or is indifferent to such toxic content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aebd2348"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
