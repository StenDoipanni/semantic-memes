    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fbeff5ca",
      "@type": "BackgroundKnowledge",
      "instance_name": "abusive_police_memes",
      "label": "Abusive Police Memes",
      "description": "A category of internet memes that use the image of police officers in a seemingly benign or friendly context to juxtapose with violent or threatening text, often to provoke fear, justify violence, or critique policing. These memes are considered abusive because they imply or threaten lethal force against civilians without specifying a target group, and use the authority figure's image to dehumanize or incite fear. The phrase 'this is why we shoot you guys' is a common trope in such memes, implying that the officer's demeanor or presence justifies lethal force.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4b44668f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ff4000c3",
      "@type": "BackgroundKnowledge",
      "instance_name": "lethal_force_justification",
      "label": "Lethal Force Justification",
      "description": "The concept that law enforcement officers may use deadly force under certain circumstances, often justified by perceived threats to life or public safety. This concept is central to understanding the meme's message, which implies that the officer's friendly appearance is a reason to justify lethal force against civilians. The meme uses this concept to create a jarring contrast and provoke fear or outrage.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4b44668f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e6bd812f",
      "@type": "BackgroundKnowledge",
      "instance_name": "police_officer_stereotype",
      "label": "Police Officer Stereotype",
      "description": "A stereotype that portrays police officers as inherently dangerous, aggressive, or prone to using excessive force, especially against civilians. This stereotype is often used in memes to create a sense of fear or to justify violence. The meme uses the officer's friendly expression to contrast with the violent message, reinforcing the stereotype that police can be unpredictable and dangerous.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4b44668f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_445fb840",
      "@type": "BackgroundKnowledge",
      "instance_name": "civilian_targeting",
      "label": "Civilian Targeting",
      "description": "The concept that law enforcement may target civilians, often in the context of racial profiling, excessive force, or unjustified shootings. The phrase 'you guys' in the meme implies a broad targeting of civilians, without specifying a particular group, which is a common theme in discussions about police violence and systemic racism. This concept is necessary to understand the meme's message of generalized threat.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4b44668f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_522b517f",
      "@type": "BackgroundKnowledge",
      "instance_name": "juxtaposition_meme_technique",
      "label": "Juxtaposition Meme Technique",
      "description": "A meme technique that involves placing two contrasting images or ideas together to create a jarring effect or to provoke a specific emotional response. In this meme, the contrast between the officer's friendly expression and the threatening text is used to create a sense of unease or fear. This technique is common in internet memes to highlight contradictions or to make a provocative statement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4b44668f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_acf70393",
      "@type": "EmotionExpression",
      "instance_name": "threatening_anger",
      "label": "threatening anger emotion",
      "description": "The emotion expressed is one of implicit threat and anger, conveyed through the juxtaposition of the officer's friendly smile with the violent text 'this is why we shoot you guys'. The smile is used ironically to mask or contrast with the underlying threat, creating a jarring and unsettling emotional effect. The emotion is not directly expressed by the officer's facial expression alone, but is entirely constructed by the combination of his benign appearance and the aggressive text, which implies a violent intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4b44668f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_89e19948",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The text 'this is why we shoot you guys' maps onto the police officer's friendly demeanor.",
      "description": "The meme uses the juxtaposition of the police officer's smiling, approachable appearance with the threatening text 'this is why we shoot you guys' to create an analogical mapping. The text implies that the officer's demeanor or presence is the justification for lethal force, thereby mapping the officer's visual persona onto the concept of being a reason for shooting civilians. This mapping is ironic and jarring, as the officer's benign expression contrasts with the violent message, suggesting that his friendly appearance is the cause of the threat.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4b44668f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_089953f3",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the text message as the target of the threat",
      "description": "The user is projected onto the textual material 'this is why we shoot you guys', where 'you guys' directly addresses the viewer/user as the implied target of the violent threat. The meme uses this deictic pronoun to create an immediate and personal sense of danger, making the user feel targeted by the police officer's implied justification for lethal force.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4b44668f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c29d9848",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Abusive",
      "description": "The meme uses the image of a smiling police officer juxtaposed with the threatening text 'this is why we shoot you guys' to imply that the officer's demeanor justifies lethal force against civilians. This creates a threatening and accusatory tone, potentially inciting fear or violence, and is abusive as it directly threatens a broad group without specifying a target, using authority to dehumanize civilians.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4b44668f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
