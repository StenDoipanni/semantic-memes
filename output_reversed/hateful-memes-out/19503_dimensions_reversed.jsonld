    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8a7138d8",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who are familiar with or sensitive to racialized commentary, particularly regarding Black communities and welfare dependency tropes. The meme is designed to provoke judgment or discomfort by juxtaposing the perceived poverty of a Black child with the travel expense of a white woman making a commercial, appealing to audiences who may hold or be exposed to harmful stereotypes about Black economic circumstances. The rhetorical question implies a moral judgment that relies on the audience's understanding of economic disparity and racialized narratives, making it most effective for those who interpret such imagery through the lens of systemic bias or social critique.",
      "belongsToAnalysis": {
