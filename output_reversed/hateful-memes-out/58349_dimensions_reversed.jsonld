    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a6094ee3",
      "@type": "BackgroundKnowledge",
      "instance_name": "poor_mixing_experience",
      "label": "Poor Mixing Experience",
      "description": "A common, relatable, and mildly frustrating experience when preparing powdered drinks like Nesquik, where the powder doesn't dissolve properly and forms clumps. The meme uses visual exaggeration to highlight this mundane mishap.",
      "belongsToAnalysis": {
