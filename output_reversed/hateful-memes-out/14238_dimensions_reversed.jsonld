    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_861d4643",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The man is mapped as a representative of 'most religions'",
      "description": "The textual phrase 'most religions are religions of peace' is juxtaposed with the visual of a man whose appearance (beard, head covering) is culturally associated with Muslim men. The meme implicitly maps this man as a visual representation of 'most religions' — specifically, as an exemplar of a 'religion of peace'. This mapping relies on the stereotype that 'Muslims are peaceful' and uses the man's visual identity to stand in for the abstract concept of 'religions' in general, creating a false equivalence. The mapping is formalized by projecting the textual concept 'most religions' onto the visual entity 'man'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac12b9ba"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_24292c8c",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man as a representative of 'most religions'",
      "description": "The user is projected onto the visual material of the man (man) who is depicted with a serious expression and crossed arms, wearing a head covering and beard. This projection occurs because the meme uses the man's appearance — culturally associated with Muslim men — as a visual stand-in for the abstract concept of 'most religions' as stated in the text. The user is implicitly invited to see the man as an exemplar of the peaceful nature of 'most religions', thereby projecting their own understanding or identity onto this visual representation. This projection is reinforced by the textual material ('most religions are religions of peace') which frames the man as a symbol of the generalization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac12b9ba"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
