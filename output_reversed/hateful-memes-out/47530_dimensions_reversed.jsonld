    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cd053cad",
      "@type": "BackgroundKnowledge",
      "instance_name": "single_mom_stereotype",
      "label": "Single Mom Stereotype",
      "description": "The meme relies on the stereotype that women, particularly young women or girls, are destined to become single mothers, often implying a lack of agency or a predetermined life path. This stereotype is rooted in societal expectations and gender roles that historically assign women primary responsibility for child-rearing and domestic duties, often at the expense of their personal or professional ambitions. The punchline 'the one on the right' implies that the girl on the far right is the 'future single mom' based on her gender and perhaps perceived 'feminine' traits, which is a reductive and sexist assumption.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_62384b5a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_602b646a",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogyny",
      "label": "Misogyny",
      "description": "The meme implicitly relies on misogynistic tropes that limit women's roles to motherhood and domesticity. It reinforces the idea that a woman's primary value or future is tied to her reproductive capacity and her role as a caregiver, which is a form of gender-based discrimination. The punchline 'the one on the right' is a sexist joke that assumes the girl will inevitably become a single mother, ignoring her potential for independence, career, or other life paths.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_62384b5a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
