      "@type": "BackgroundKnowledge",
      "instance_name": "gender_role_stereotypes",
      "label": "Gender Role Stereotypes",
      "description": "The meme plays on traditional gender role stereotypes that assign specific roles to men and women. It assumes that the girl on the right, due to her gender, is more likely to be a single mother, while the boys are not. This reflects a societal bias that women are more likely to be caregivers and less likely to be financially independent or to choose not to have children, which is a harmful and outdated stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_62384b5a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
