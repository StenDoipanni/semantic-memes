    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b2058b86",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_format",
      "label": "Meme format: text overlay on image with reaction",
      "description": "This meme follows a common internet meme format where a person's facial expression (here, a serious or exasperated look) is juxtaposed with text that creates a humorous or ironic situation. The text provides the context, and the image provides the reaction, which is key to the meme's comedic effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_203f476e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7c50591c",
      "@type": "BackgroundKnowledge",
      "instance_name": "internet_meme_culture",
      "label": "Internet meme culture",
      "description": "The meme is part of a broader internet culture where users create and share humorous images with text overlays. This culture often relies on wordplay, pop culture references, and exaggerated reactions to generate laughs. Understanding this context helps explain why the image is used in this way.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_203f476e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f04ba198",
      "@type": "EmotionExpression",
      "instance_name": "exasperation",
      "label": "exasperated expression",
      "description": "The man's facial expression conveys a sense of mild frustration or disbelief, with furrowed brows, a tight mouth, and direct eye contact, suggesting he is reacting to something absurd or unreasonable. This aligns with the humorous context of the text overlay, which plays on a pun about weight.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_203f476e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_79eac910",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The man is mapped as the person reacting to the absurd claim about the bag's weight.",
      "description": "The text 'hey this bag only weighs .8' and 'it's graam!' creates a humorous context where the man's serious, exasperated expression is mapped onto the role of someone reacting to the absurdity of the statement. The visual material (the man) is the entity being mapped to represent the implied 'person' who is making or reacting to the claim. The text explicitly refers to a 'bag' and its weight, and the man's expression conveys disbelief or mild frustration at the implication that '.8 graam' (a mispronunciation of 'gram') is a significant weight. Thus, the man is analogically mapped as the person who is the subject of the joke — the one whose reaction is being shown.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_203f476e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c2473bcb",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man in the red striped shirt",
      "description": "The user is projected onto the visual material of the man (the person) in the image, as the meme's humor relies on the viewer imagining themselves as the person reacting to the absurd claim about the bag's weight. The man's serious, exasperated expression is used to represent the user's potential reaction to the joke. There are no explicit deictic pronouns like 'me' or 'you' in the text, but the meme format inherently invites the user to identify with the person in the image as the one experiencing or expressing the reaction.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_203f476e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
