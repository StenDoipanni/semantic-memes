    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a2532733",
      "@type": "Scene",
      "instance_name": "text_overlay_scene",
      "label": "text_overlay_scene",
      "description": "A scene where text is overlaid on an image of a man, creating a humorous context. The text reads 'hey this bag only weighs .8' at the top and 'it's graam!' at the bottom, playing on the mispronunciation of 'gram'. The man's serious expression contrasts with the absurdity of the text, forming the core of the meme's humor.",
      "belongsToAnalysis": {
