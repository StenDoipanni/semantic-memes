      "@id": "http://example.org/multimodal-taxonomy#dimension_72fab515",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: meme_file_name; hasOverallIntent: hateful; overall-intent-description: The image depicts a young child with developmental disabilities reading a book, juxtaposed with a hateful text overlay that uses the slur 'retard' and falsely claims the child has been 'accepted into Harvard' as a cruel joke. This constitutes a direct attack on individuals with developmental disabilities, using derogatory language and mocking their abilities. The meme is designed to be offensive and degrading, fitting the definition of hateful content as it targets a protected characteristic (disability) with malicious intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_46ff989e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
