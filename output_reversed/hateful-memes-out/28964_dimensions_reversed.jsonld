    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_18af3c3b",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism",
      "label": "Ableism",
      "description": "Ableism is the discrimination or social prejudice against people with disabilities. The meme relies on ableist stereotypes by mocking the child's perceived inability to read and using derogatory language to demean his intellectual capacity, which is a core component of ableist attitudes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_46ff989e"
