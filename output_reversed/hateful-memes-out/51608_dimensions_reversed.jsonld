    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_424335a2",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The child is mapped as a 'Disney classic' through the text overlay.",
      "description": "The text 'winnie the pooh is a disney classic' is juxtaposed with the visual of a child standing between Disney characters. This creates an analogical mapping where the child is implicitly projected as being 'classic' or 'authentic' in the same way that Winnie the Pooh is a 'Disney classic'. This mapping relies on the stereotype that children are inherently 'classic' or 'authentic' versions of things, which can be seen as infantilizing or objectifying the child. The mapping is established through the ironic or humorous framing of the child as a 'classic' version of the character, using the Disney classic concept as a textual anchor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_293b2f2a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_61c91204",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the child in the scene",
      "description": "The user is projected onto the child standing between the Disney characters, as the meme's text 'winnie the pooh is a disney classic' implicitly frames the child as a 'classic' version of the character. This projection relies on the visual material of the child and the textual material to create an analogical mapping where the user sees themselves as the 'classic' or 'authentic' version of the character, which is a form of infantilization and objectification. The projection is not explicit with deictic pronouns like 'me' or 'you', but it is implied through the ironic juxtaposition of the child with the Disney classic concept.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_293b2f2a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
