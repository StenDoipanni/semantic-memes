    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6d9a6490",
      "@type": "BackgroundKnowledge",
      "instance_name": "infantilization_stereotype",
      "label": "Infantilization Stereotype",
      "description": "The meme uses the image of a child standing between two large costumed characters to imply that the child is 'classic' or 'authentic' in a way that is not appropriate or respectful. This relies on the real-world stereotype that children are inherently 'classic' or 'authentic' versions of things, which can be seen as infantilizing or objectifying the child. This stereotype is part of broader ableist and ageist tropes that reduce individuals to their perceived developmental stage.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_293b2f2a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6f81ea34",
      "@type": "BackgroundKnowledge",
      "instance_name": "objectification_stereotype",
      "label": "Objectification Stereotype",
      "description": "The meme's framing of the child as a 'classic' version of Winnie the Pooh, juxtaposed with the costumed characters, can be interpreted as objectifying the child by reducing them to a symbolic or literal representation of a cartoon character. This relies on the real-world stereotype that children are objects to be used or displayed for entertainment or aesthetic purposes, rather than as autonomous individuals.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_293b2f2a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c35494be",
      "@type": "BackgroundKnowledge",
      "instance_name": "disney_classic_concept",
      "label": "Disney Classic Concept",
      "description": "The text 'winnie the pooh is a disney classic' refers to the real-world concept that 'Disney classics' are films or characters that have been widely recognized and celebrated by Disney as enduring and iconic. This concept is part of Disney's marketing and cultural branding strategy, and understanding it requires knowledge of Disney's history and its role in popular culture. The meme uses this concept ironically or humorously, implying the child is 'classic' in a way that is not appropriate.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_293b2f2a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dd42d24c",
      "@type": "BackgroundKnowledge",
      "instance_name": "disney_character_stereotype",
      "label": "Disney Character Stereotype",
      "description": "The meme relies on the real-world stereotype that Disney characters are iconic, timeless, and often used as symbols of childhood innocence or nostalgia. This stereotype is part of broader cultural phenomena around media franchises and their influence on public perception. The meme uses this to create a humorous or ironic contrast with the child, who is also being framed as 'classic' or 'authentic'.",
      "belongsToAnalysis": {
