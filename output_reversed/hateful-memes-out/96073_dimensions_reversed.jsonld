    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e3a5e15c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Venting anger is mapped onto homicidal rage",
      "description": "The text 'wanna kill her?' and 'there u go wit dat bs' is mapped onto the visual representation of the horror characters Freddy Krueger and Jason Voorhees, who are iconic symbols of homicidal rage and extreme violence. The meme equates the act of venting anger toward a white person with the homicidal intent these characters represent, using their visual presence to symbolize the supposed 'rage' of the venting person.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a9e9a227"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1e951449",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the text_chunk, which contains the phrase 'wanna kill her? there u go wit dat bs'. The use of 'u' (you) directly addresses the viewer, implying that the user is the one who is venting anger and is being mocked for it. The text explicitly uses 'you' to create a direct address to the user, making the user the target of the meme's ridicule. The user is projected onto the text_chunk as the person being mocked for venting anger toward a white person.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a9e9a227"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
