    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_84e1a105",
      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_victimization_stereotype",
      "label": "Racialized victimization stereotype",
      "description": "The meme relies on the stereotype that venting anger toward a white person is equivalent to homicidal rage, which is a racially charged trope that devalues the emotional experiences of people of color by equating their frustration with extreme violence. This stereotype is used to mock and intimidate individuals who express racial or ethnic grievances.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a9e9a227"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_62193d8a",
      "@type": "BackgroundKnowledge",
      "instance_name": "white_supremacist_implicit_rhetoric",
      "label": "White supremacist implicit rhetoric",
      "description": "The meme implicitly references white supremacist ideologies by using the phrase 'white person' as a target of venting anger, which is often used in racist discourse to dehumanize or marginalize non-white individuals. The violent imagery of Freddy Krueger and Jason Voorhees is used to reinforce the idea that venting anger toward white people is inherently violent, which is a common trope in white supremacist rhetoric.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a9e9a227"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d5e94903",
      "@type": "BackgroundKnowledge",
      "instance_name": "violent_horror_character_stereotype",
      "label": "Violent horror character stereotype",
      "description": "The meme uses the visual of iconic horror characters Freddy Krueger and Jason Voorhees to represent extreme violence and rage. This is a common trope in media and internet culture to symbolize uncontrollable anger or homicidal intent, which is used here to trivialize and mock the emotional experience of venting anger toward a white person.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a9e9a227"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c4fef91d",
      "@type": "BackgroundKnowledge",
      "instance_name": "homicidal_rage_stereotype",
      "label": "Homicidal rage stereotype",
      "description": "The meme equates venting anger toward a white person with homicidal rage, which is a stereotype that dehumanizes the venting person by implying their emotional expression is equivalent to extreme violence. This is a common trope in racist discourse to dismiss or mock the emotional experiences of people of color.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a9e9a227"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f14a95db",
      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_emotional_expression_stereotype",
      "label": "Racialized emotional expression stereotype",
      "description": "The meme relies on the stereotype that emotional expression, particularly anger, from people of color is inherently violent or irrational. This is a common trope in racist discourse that devalues the emotional experiences of people of color by equating their frustration with extreme violence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a9e9a227"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c637d079",
      "@type": "EmotionExpression",
      "instance_name": "homicidal_rage",
      "label": "homicidal rage stereotype",
      "description": "The emotion expressed is homicidal rage, symbolized by the violent horror characters Freddy Krueger and Jason Voorhees, who are used to represent extreme, uncontrollable anger and violent intent. This emotion is invoked by the overlaid text which equates venting anger toward a white person with wanting to kill someone, thereby trivializing and weaponizing emotional expression.",
      "belongsToAnalysis": {
