    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_61cb3462",
      "@type": "BackgroundKnowledge",
      "instance_name": "disability_stigma",
      "label": "disability stigma",
      "description": "The meme perpetuates disability stigma by mocking individuals with physical disabilities for their perceived lack of social engagement or 'obedience.' This stigma is rooted in societal attitudes that view disability as a source of weakness or deviation from the norm, which the meme reinforces through its derogatory language.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b0a2614e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cff3bed4",
      "@type": "EmotionExpression",
      "instance_name": "mocking_disgust",
      "label": "derogatory mocking expression",
      "description": "The image conveys a mocking and disgusted emotional tone through the combination of Kevin Hart's earnest facial expression (which contrasts with the hateful text) and the overlaid text that degrades people with physical disabilities. The text 'obedience' and the caption about 'constant painful hip' are designed to elicit contempt and ridicule toward individuals with disabilities, framing their lack of smiling as a sign of passivity or submissiveness. This emotional expression is not visually depicted on Kevin Hart's face but is strongly implied by the textual content and the meme's overall intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b0a2614e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_59f24f1c",
      "@type": "AnalogicalMapping",
      "instance_name": "obedience_mapping",
      "label": "Kevin Hart is mapped as 'obedience'",
      "description": "The top text 'obedience' is mapped onto Kevin Hart, implying that he embodies or represents the concept of 'obedience' as described in the meme's derogatory context. This mapping is based on the juxtaposition of his earnest, engaged expression with the text, which frames his public persona as a symbol of the stereotype being mocked — specifically, the idea that people who don't smile are 'obedient' or passive. The meme uses his image to project this negative concept onto him, even though he is not literally 'obedient' in the context of the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b0a2614e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5a2a72a3",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material and visual material of the meme",
      "description": "The user is projected onto the meme's textual material (the caption 'for those that dont like smiling probably due to their constant painful hip they all seem to grasp') and visual material (Kevin_Hart's image), as the meme implicitly addresses the user by framing the stereotype as a commentary on 'people' in general, and by using Kevin Hart's public persona to represent the targeted group. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the meme's structure and intent project the user as the one who might hold or be exposed to this harmful stereotype, making them a recipient of the message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b0a2614e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ad20cc51",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme perpetuates a harmful ableist stereotype by linking physical disability (specifically hip pain) to a perceived lack of emotional expression or social conformity, and implies that such individuals are 'obedient' or passive. This stereotype degrades people with physical disabilities by associating their condition with passivity or social non-engagement, which can cause harm to individuals and communities with disabilities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b0a2614e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bee63173",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who may find humor in mocking or ridiculing people with physical disabilities, particularly those who do not smile due to hip pain. The meme leverages Kevin Hart’s public persona as a recognizable figure to amplify its message, likely appealing to an audience that enjoys or is familiar with internet memes that use public figures to deliver derogatory stereotypes. The audience is likely to be those who are not directly affected by ableism or disability stigma, and who may not be aware of or insensitive to the harmful implications of the stereotype being portrayed. The meme’s intent to degrade people with disabilities suggests the target audience is not part of the disabled community, but rather individuals who may be entertained by or indifferent to the degrading portrayal of disability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b0a2614e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
