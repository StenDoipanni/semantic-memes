    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_05ccdbda",
      "@type": "BackgroundKnowledge",
      "instance_name": "obedience_concept",
      "label": "obedience concept",
      "description": "The term 'obedience' in the meme is used in a derogatory context to imply that people who do not smile are passive or compliant, which is a harmful and reductive characterization. This concept is not directly visible but is central to the meme's message.",
      "belongsToAnalysis": {
