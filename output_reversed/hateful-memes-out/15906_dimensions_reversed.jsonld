    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eb56bd4a",
      "@type": "BackgroundKnowledge",
      "instance_name": "hip_pain_stereotype",
      "label": "hip pain stereotype",
      "description": "The meme implicitly references a stereotype that people who do not smile are 'due to their constant painful hip they all seem to grasp,' which is a derogatory and inaccurate assumption about physical disability. This stereotype reduces complex human experiences to a simplistic, mocking narrative.",
      "belongsToAnalysis": {
