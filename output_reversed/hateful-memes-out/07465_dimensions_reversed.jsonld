    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_591e5069",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the confrontational statement and the Black man representing the speaker",
      "description": "The user is projected onto the textual material and the visual material of the meme. The text 'everything i post is going to offend you' uses 'i' and 'you', directly addressing the user as 'you' (the white audience) and the speaker as 'i' (the Black person). The user is also projected onto the visual material of the Black man, who is the visual embodiment of the speaker. The user is expected to identify with the speaker's perspective and experience the confrontational tone of the statement as a direct address to their own discomfort or reaction.",
      "belongsToAnalysis": {
