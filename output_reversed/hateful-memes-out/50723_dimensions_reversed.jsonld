    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_46e697d0",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals who are politically engaged, particularly those aligned with right-wing or conservative political ideologies in the United States. The meme leverages inflammatory and false claims about Kamala Harris — including accusations of sexual misconduct, support for illegal immigration, and endorsement of infanticide — which are commonly used in conservative political discourse to incite fear, hatred, and division. The meme’s intent to smear Harris through absurd and violent rhetoric is designed to resonate with audiences who are already predisposed to distrust or oppose her, often due to existing political polarization. The use of extreme, false statements and the juxtaposition of Harris’s smiling expression with grotesque text creates a harmful caricature that appeals to those who seek to delegitimize political opponents through misinformation and emotional manipulation. The reference to Joe Biden as a 'sexual pervert' and the implication of political rivalry within the Democratic Party further target audiences familiar with partisan political dynamics and the culture of political attacks common in conservative media and online communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1dd9893d"
      },
      "extractionMethod": "llm_extraction_huggingface"
