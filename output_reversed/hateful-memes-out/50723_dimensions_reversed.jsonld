    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d69fc9a5",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'I want to be your president!' is mapped onto Kamala Harris as the candidate.",
      "description": "The inflammatory text explicitly states 'I want to be your president!', which directly maps the textual entity 'presidential_candidate' (implied by the phrase) onto the visual entity Kamala Harris, who is a real-world political figure and the Vice President of the United States. The meme uses her image to represent the persona of the 'presidential_candidate' described in the text, creating an analogical mapping where the text's speaker is projected onto her visual form.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1dd9893d"
      },
