    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cb5e9336",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The man is mapped as the person who goes on a date and gets stood up",
      "description": "The visual material of the man, with his resigned and disappointed expression, is mapped onto the textual narrative 'goes on a date' and 'gets stood up'. The man's emotional state and body language are used to represent the experience of dating rejection described in the text. This is an analogical mapping where the visual entity (the man) embodies the textual concept (the person experiencing dating rejection).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_38841b84"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b2875b49",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man experiencing dating rejection",
      "description": "The user is projected onto the visual material of the man, who embodies the experience of going on a date and getting stood up. The man's resigned, frustrated expression and body language (hand on face, eyes closed) are culturally understood as symbols of disappointment and emotional letdown, which are central to the meme's narrative. The user identifies with this emotional state, projecting themselves onto the man as a representation of their own potential experience of dating rejection. This projection is implicit, as there are no explicit deictic pronouns like 'me' or 'you' in the text, but the universal relatability of the scenario and the man's universal expression create a strong implicit identification.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_38841b84"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_df4dcca9",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals who experience or are familiar with modern dating culture, particularly those who have encountered the phenomenon of being 'ghosted' or stood up after a date. The meme uses a universally relatable emotional expression (disappointment, resignation) to connect with anyone who has faced dating rejection, regardless of specific demographic characteristics. The visual of a young Black man is used as a neutral, relatable figure to represent the experience, not as a stereotype or caricature, and the overall intent is to humorously depict a common social experience without targeting any specific group based on race, gender, religion, or other protected characteristics.",
      "belongsToAnalysis": {
