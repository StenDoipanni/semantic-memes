      "instance_name": "man",
      "label": "person",
      "description": "A man with curly brown hair, wearing a dark suit jacket over a blue collared shirt. He appears in two states: top panel shows him smiling broadly, bottom panel shows him with a serious, unsmiling expression. The man is the central visual element and is used to contrast emotional states to deliver the meme's punchline.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_521a5d89"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_73d441ed",
      "@type": "Scene",
      "instance_name": "stress_vs_desserts_pun",
      "label": "man_explaining_pun_through_expression_change",
      "description": "A scene composed of two panels showing the same man in contrasting emotional states to deliver a wordplay joke. The top panel shows him smiling, representing a happy or carefree state, while the bottom panel shows him with a serious, unsmiling expression, representing the 'mind = blown' reaction to the punchline. The text overlays explain the joke: 'when you're stressed, you eat ice cream, cake, chocolate & sweets, why?' followed by 'because stressed spelled backwards is desserts mind = blown.' The scene uses the man's facial expressions as visual cues to enhance the comedic effect of the pun.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_521a5d89"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
