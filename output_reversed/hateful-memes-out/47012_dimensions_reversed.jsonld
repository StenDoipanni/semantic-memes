      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a2b91947",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The baseball player is mapped as the one graduating from catcher to pitcher",
      "description": "The text 'the day you graduate from catcher to pitcher' is overlaid on the image of a baseball player holding a catcher's mitt. This creates an analogical mapping where the visual entity (baseball_player) is interpreted as the subject of the textual metaphor — the person who is transitioning from a catcher to a pitcher. The player's action (holding the ball in the mitt, poised to throw) visually reinforces the metaphor of 'graduating' into a new, more prominent role (pitcher).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14d0977d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5b289575",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the baseball player as the one transitioning from catcher to pitcher",
      "description": "The user is implicitly projected onto the baseball player (visual material) holding the catcher's mitt, as the text 'the day you graduate from catcher to pitcher' uses 'you' to address the viewer, making the viewer the subject of the metaphorical transition. The player's posture and the text create a direct identification with the user as the one undergoing this role change.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14d0977d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_90edc6e5",
