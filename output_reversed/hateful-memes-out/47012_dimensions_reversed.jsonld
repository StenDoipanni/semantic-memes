      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The metaphorical framing of transitioning from a supportive role (catcher) to a more demanding or public role (pitcher) can be perceived as potentially harmful, especially if the transition is interpreted as a loss of comfort or security. The phrase 'graduate from catcher to pitcher' may unintentionally imply a negative or burdensome change, causing discomfort or stress in certain contexts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14d0977d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
