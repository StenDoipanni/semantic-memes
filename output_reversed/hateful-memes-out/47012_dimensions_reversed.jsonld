    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2b100609",
      "@type": "Scene",
      "instance_name": "baseball_transition_scene",
      "label": "transition_from_catcher_to_pitcher",
      "description": "A baseball player in a catcher's mitt holding a ball, with a pitcher in the background, symbolizing a career or role transition from a supportive role (catcher) to a more prominent or demanding role (pitcher). The scene is framed by text overlaying the image that reads 'the day you graduate from catcher to pitcher,' emphasizing the metaphorical transition.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14d0977d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2061bb61",
      "@type": "BackgroundKnowledge",
      "instance_name": "baseball_catcher_role",
      "label": "Baseball Catcher Role",
      "description": "In baseball, the catcher is a defensive position responsible for receiving pitches, calling pitches, and managing the game. They are typically positioned behind home plate and are often seen as a supportive or behind-the-scenes role, contrasting with the pitcher who is more publicly visible and central to the game's offense. This role transition is a metaphor for moving from a supportive to a more prominent or demanding position.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14d0977d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_308c09b4",
      "@type": "BackgroundKnowledge",
      "instance_name": "baseball_pitcher_role",
      "label": "Baseball Pitcher Role",
      "description": "In baseball, the pitcher is the player who throws the ball toward home plate to get batters out. They are often the most visible and central player in the game, and their performance is critical to the team's success. This role is often associated with being the 'star' or primary offensive/defensive force, contrasting with the catcher's more supportive role.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14d0977d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6a63078a",
      "@type": "BackgroundKnowledge",
      "instance_name": "role_transition_metaphor",
      "label": "Role Transition Metaphor",
      "description": "The meme uses a metaphor from baseball to describe a career or social transition where someone moves from a supportive or less visible role (catcher) to a more prominent, demanding, or public role (pitcher). This metaphor is commonly used in professional, academic, or social contexts to describe promotions, leadership changes, or increased responsibilities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14d0977d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_59638c2e",
      "@type": "BackgroundKnowledge",
      "instance_name": "graduate_metaphor",
      "label": "Graduate Metaphor",
      "description": "The phrase 'graduate from X to Y' is a common metaphorical expression used to describe a transition or advancement from one stage or role to another, often implying a formal or significant change. In this context, it suggests a formal or symbolic 'promotion' or 'transition' from one position to another, often with connotations of moving from a less visible to a more visible or demanding role.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14d0977d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_07f5b6b2",
      "@type": "BackgroundKnowledge",
      "instance_name": "sports_analogy_in_meme",
      "label": "Sports Analogy in Meme",
      "description": "Memes often use sports analogies to convey complex ideas or emotions in a relatable and humorous way. In this case, the baseball analogy is used to represent a transition in career or social status, leveraging the familiar structure of sports roles to communicate a metaphorical message about change, responsibility, or pressure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14d0977d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9bc07dd3",
