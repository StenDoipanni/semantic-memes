    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1d169cca",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Children are mapped as 'celebrating the weekend like'",
      "description": "The text 'celebrating the weekend like' is juxtaposed with the visual of two Black children joyfully playing in water. The mapping implies that the children’s spontaneous, uninhibited celebration (as expressed through their joyful poses and play) is being equated with how one might celebrate the weekend — specifically, in a manner that is perceived as primitive, unrefined, or culturally exotic. This mapping is central to the meme’s intent and relies on the visual material to instantiate the textual claim.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75b20e44"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fbc4182e",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the celebratory scene of Black children",
      "description": "The user is projected onto the visual and textual scene of two Black children joyfully playing in water, with the text 'celebrating the weekend like' implying that the user's own weekend celebration is being compared to or equated with the children's spontaneous, uninhibited joy. This projection is implicit, as the meme invites the viewer to imagine themselves in the children's position or to see their own weekend celebration through the lens of the children's 'basic' or 'primitive' play. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the framing of the meme creates a direct identification or comparison, projecting the user's experience onto the scene.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75b20e44"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5eb36977",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme perpetuates harmful stereotypes by equating the spontaneous joy of Black children with a 'primitive' or 'basic' form of celebration, which can devalue their experiences and reinforce racialized narratives about leisure and cultural refinement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75b20e44"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6954747a",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience for this meme is likely individuals who are familiar with and engage with internet meme culture, particularly those who appreciate or enjoy humor derived from cultural stereotypes, especially those involving racialized portrayals of Black joy and leisure. The meme’s intent to juxtapose the children’s spontaneous celebration with the phrase 'celebrating the weekend like' suggests it is designed for an audience that finds humor in the contrast between 'primitive' or 'unrefined' expressions of happiness and more 'civilized' or 'refined' forms of celebration. This audience may include users who are aware of or unconsciously reinforce anti-Black stereotypes, such as the infantilization, exoticization, or racialized lens on leisure, which are central to the meme’s harmful intent. The meme’s appeal likely stems from its ability to evoke a sense of 'relatable' or 'comedic' absurdity through the lens of racialized tropes, targeting those who consume content that relies on such stereotypes for humor, even if unintentionally.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75b20e44"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
