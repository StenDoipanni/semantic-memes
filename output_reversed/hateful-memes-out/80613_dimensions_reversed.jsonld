    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_79902a79",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_racialized_leisure",
      "label": "Anti-Black Stereotype: Racialized Lens on Leisure and Celebration",
      "description": "The meme implicitly reinforces a racialized lens that views Black leisure and celebration as inherently less sophisticated or culturally inferior. This stereotype is often used to devalue Black experiences and to justify the portrayal of Black joy as 'basic' or 'unrefined' in contrast to 'civilized' or 'refined' forms of celebration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75b20e44"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
