    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_448bee7d",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_primitive_celebration",
      "label": "Anti-Black Stereotype: Primitive or Unrefined Celebration",
      "description": "The meme relies on the stereotype that Black children’s spontaneous, uninhibited joy (like dancing or playing in water) is 'primitive' or 'basic' compared to more 'refined' or 'civilized' forms of celebration. This trope reduces complex human emotion to simplistic, culturally exoticized imagery, often implying a lack of sophistication or cultural refinement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75b20e44"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dd5aee1d",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_infantilization",
      "label": "Anti-Black Stereotype: Infantilization of Black Children",
      "description": "The image and text together may imply that the children’s joy is childish or naive, reinforcing the stereotype that Black children are perpetually 'in the moment' or 'unaware' of social norms, which infantilizes them and devalues their experiences as adults or as members of a complex culture.",
      "belongsToAnalysis": {
