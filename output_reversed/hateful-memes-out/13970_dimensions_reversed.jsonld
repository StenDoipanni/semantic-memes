    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2533d7bb",
      "@type": "VisualMaterial",
      "instance_name": "man",
      "label": "man speaking at podium",
      "description": "A man wearing glasses, a black turtleneck, and a black suit jacket, standing behind a wooden podium with a microphone. He appears to be speaking or reacting with an expressive facial expression, possibly mid-sentence or in surprise. His posture and expression suggest he is the central subject of the image, likely intended to represent a person being caught in a lie or reacting to a lie detector test result. The man is positioned in the foreground, making him the most salient visual element.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_861d1c36"
