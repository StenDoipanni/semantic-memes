    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bab86a29",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The lawmakers are mapped as 'the squad'",
      "description": "The text overlay 'the lawmakers known as \"the squad\"' explicitly labels the three female lawmakers in the image as 'the squad'. This creates an analogical mapping where the textual entity 'the squad' is projected onto the visual entities representing the lawmakers. The mapping is direct and explicit, using the text to define the identity of the visual subjects in a derogatory manner.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_467a2178"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9a4dc67a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the derogatory textual label",
      "description": "The user is projected onto the textual material 'the lawmakers known as \"the squad\"', which functions as a dehumanizing label. The meme invites the user to identify with or internalize this pejorative framing, projecting the user's perspective onto the derogatory term that defines the visual subjects. This projection is implicit, as the user is not directly addressed with 'you' or 'me', but the act of viewing and interpreting the meme inherently involves adopting the meme's framing, which dehumanizes the lawmakers by equating them with a criminal or untrustworthy 'squad'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_467a2178"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
