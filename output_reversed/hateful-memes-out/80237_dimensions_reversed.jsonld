    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b457ba65",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_structure",
      "label": "Meme Structure: 'When Nobody Knew Who You Were Until You Got on Your Knees'",
      "description": "This is a common internet meme format that implies a person's public recognition or status was achieved only after they performed a submissive or humiliating act. The phrase 'got on your knees' is a metaphor for submission, often used in a derogatory context to suggest that a person's value or fame is contingent on their willingness to submit or perform a degrading act. This structure relies on cultural understanding of metaphorical language and social dynamics around fame and humiliation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_186ab19c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
