    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_28e31ff5",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_comparing_to_primates",
      "label": "Anti-Black Stereotype: Comparing Black People to Primates",
      "description": "This stereotype, often used in racist contexts, dehumanizes Black individuals by likening them to animals, particularly primates. In this meme, the man’s serious, unamused expression and formal attire are juxtaposed with the absurd accusation of farting, which can be interpreted as a form of racial mockery that reduces his dignity and humanity to a crude, animalistic behavior. The meme relies on the viewer’s implicit understanding of this stereotype to generate its humor, which is rooted in racial prejudice.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b1b996ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d3c5c097",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_stereotyping_through_absurd_accusation",
      "label": "Racial Stereotyping via Absurd Accusation",
      "description": "The meme uses an absurd and trivial accusation ('who farted?') to target a Black man in a formal setting, implying that his race makes him inherently prone to such behavior. This is a form of racial stereotyping that relies on the viewer’s implicit knowledge of racial biases and the historical use of such tropes to demean Black individuals. The humor is derived from the juxtaposition of the man’s dignified appearance with the crude accusation, which is only funny to those who accept the underlying racist premise.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b1b996ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
