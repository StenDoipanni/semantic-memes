    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_77262bae",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'who farted?' is mapped onto the Black man in formal attire.",
      "description": "The textual element 'who farted?' is juxtaposed with the visual material of a Black man in formal attire, creating an analogical mapping where the man is implicitly identified as the subject of the accusation. The humor and intent of the meme rely on this mapping, which projects the absurd accusation onto the individual, using his appearance and context to generate the joke. This mapping is central to the meme's function as a form of racial mockery and cyberbullying, as it maps the text's implied target (the person who farted) directly onto the visual entity (the man).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b1b996ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d237d29c",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual material of the Black man in formal attire",
      "description": "The user is projected onto the visual material entity 'man' (a Black man in formal attire) as the implied subject of the textual accusation 'who farted?'. The meme's humor and intent rely on the viewer projecting themselves as the one who might be accused, or more commonly, projecting the accusation onto the man as the target. This projection is implicit, not explicit, but it is central to the meme's function: the user imagines themselves in the man's position or sees the man as the object of the joke, thereby internalizing the meme's mocking tone. The user is not explicitly addressed with 'you' or 'me', but the visual material of the man is the focal point onto which the user's gaze and judgment are directed, making him the projected entity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b1b996ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
