    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c18e3d17",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Democrats granting rights to migrants is mapped onto the border-crossing scene",
      "description": "The top text 'democrats giving rights to those who have no right to be here' is analogically mapped onto the visual scene of migrants crossing a border fence. The meme equates the political action of granting rights to undocumented immigrants with the visual depiction of people physically crossing a border, implying that this action is somehow 'granting' them a right to be there, despite the text's claim that they 'have no right to be here'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4355d671"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_21589e97",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the border-crossing scene as the target of political action",
      "description": "The user is implicitly projected onto the border-crossing scene (border_crossing_scene) as the recipient of the political framing presented in the text. The meme positions the viewer as someone who perceives the migrants as 'those who have no right to be here,' and thus the user is aligned with the perspective that Democrats are 'giving rights' to them, which is framed as a negative or unfair action. The user is not explicitly addressed with 'you' or 'me', but the emotional and political framing of the scene and text invites the user to identify with the viewpoint that immigration policy is a zero-sum game, making the user a passive recipient of this projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4355d671"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c393ed05",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme equates the legal status of undocumented immigrants with the moral or legal status of a fetus, which is a contentious and often harmful political argument that conflates two distinct social issues. This analogy is intentionally misleading and inflammatory, designed to provoke strong emotional reactions and to frame immigration policy as a zero-sum game, which can contribute to xenophobic and anti-immigrant sentiment and potentially harm immigrant communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4355d671"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f9c73973",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who hold anti-immigrant sentiments and are politically aligned with or sympathetic to conservative or right-wing ideologies in the United States, particularly those who oppose immigration reform and view the Democratic Party as overly permissive toward undocumented immigrants. The meme is designed to resonate with viewers who perceive immigration policy as a zero-sum game and who are likely to be influenced by inflammatory rhetoric that equates granting rights to undocumented immigrants with 'taking rights' from citizens, using the fetus image as a loaded symbol to provoke emotional reactions and reinforce anti-immigrant narratives.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4355d671"
      },
