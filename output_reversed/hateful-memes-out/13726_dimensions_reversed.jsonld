      "@type": "BackgroundKnowledge",
      "instance_name": "zero_sum_game",
      "label": "Political Framing",
      "description": "The meme frames immigration policy as a 'zero-sum game,' implying that granting rights to one group inherently takes rights from another. This is a misleading political framing that ignores the complexities of immigration policy and can contribute to xenophobic sentiment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4355d671"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_375ffb2e",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_immigrant_sentiment",
      "label": "Social Attitude",
      "description": "The meme is designed to provoke strong emotional reactions and to frame immigration policy as inherently unfair or unjust, which can lead to harmful consequences for immigrant communities and contribute to a broader culture of hostility toward immigrants. This is a common social attitude that the meme exploits.",
      "belongsToAnalysis": {
