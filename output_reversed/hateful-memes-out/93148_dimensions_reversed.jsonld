    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_841dd2f9",
      "@type": "BackgroundKnowledge",
      "instance_name": "blackhead_extraction",
      "label": "Skincare Practice",
      "description": "The act of extracting blackheads is a common skincare practice, often done at home or by professionals. It involves removing impurities from pores, and while it can be done safely with proper technique, it is also commonly associated with unhygienic or risky methods. The meme uses this practice to create irony by labeling the depicted method as 'the proper way,' contrasting it with more extreme or unhygienic approaches.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fd8005b7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_01236f59",
      "@type": "BackgroundKnowledge",
      "instance_name": "text_chunk",
      "label": "Meme Text",
      "description": "The text 'the proper way to pop a blackhead' is a satirical or ironic statement. It implies that the depicted action is the 'correct' or 'ideal' method, which is often used humorously to contrast with more extreme, unhygienic, or dangerous methods of popping blackheads. This text is central to the meme's humor and requires understanding of common skincare practices and their associated risks.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fd8005b7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
