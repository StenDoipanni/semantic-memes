    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_168f087f",
      "@type": "VisualMaterial",
      "instance_name": "officer_1",
      "label": "police officer running",
      "description": "A police officer in uniform, wearing a dark jacket, tie, and cap, is captured mid-stride running forward with an expressive, open-mouthed face, suggesting urgency or exertion. He is the central focus of the image and appears to be in motion, possibly falling or being pulled down. His right hand is raised in a gesture that could indicate surprise or effort. The text 'officer down' is overlaid on the image, implying a humorous or sarcastic context of being 'taken down' or 'outsmarted'. His uniform is detailed with badges and insignia, and he is positioned in front of a wall with graffiti.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_feff1c10"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_79996ff8",
      "@type": "Scene",
      "instance_name": "officer_down_scene",
      "label": "officer_down",
      "description": "A scene depicting two police officers in motion, with one appearing to be running or falling, while the text 'officer down' is overlaid. This visual is commonly used as a meme to humorously or sarcastically imply that a situation has gone awry, often in a context where someone is being 'taken down' or 'outsmarted'. The intent is primarily humorous or satirical, but its potential to cause harm arises from the real-world gravity of the phrase, which may be seen as insensitive or disrespectful when used inappropriately.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_feff1c10"
      },
