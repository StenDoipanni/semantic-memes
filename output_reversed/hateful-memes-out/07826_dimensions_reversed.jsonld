      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_economic_behavior",
      "label": "Racialized Economic Behavior",
      "description": "The implicit association of economic behavior (such as reliance on others for work or welfare) with specific racial groups, often used to reinforce negative stereotypes and justify social exclusion or discrimination. In this meme, the Black man is visually coded to represent this racialized trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c3434b08"
      },
