    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e07a8d30",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The Black man in the suit is mapped as the 'enemy' who provides a job",
      "description": "The top text 'any time you have to rely upon your enemy for a job' explicitly identifies the visual entity (the Black man) as the 'enemy'. This creates an analogical mapping where the man is projected as the 'enemy' in the context of the meme's message about economic desperation. The visual material (the man) is mapped onto the textual concept of 'enemy' to reinforce the racialized trope of welfare dependency.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c3434b08"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ee743af0",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of receiving money from the enemy",
      "description": "The user is projected onto the scene where they are the recipient of money being offered by the Black man, who is identified as 'your enemy' in the text. The phrase 'you're in bad shape!' directly addresses the user, implying that the user is the one in a vulnerable position who must rely on the enemy for a job. The visual of the man extending money toward the viewer creates a direct deictic address to the user, making them the subject of the judgment. The user is projected onto the 'money_handing_scene' as the recipient and the target of the meme's moral condemnation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c3434b08"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
