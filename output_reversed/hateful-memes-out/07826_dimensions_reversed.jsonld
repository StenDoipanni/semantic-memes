    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_99240850",
      "@type": "BackgroundKnowledge",
      "instance_name": "welfare_dependency_tropes",
      "label": "Welfare Dependency Tropes",
      "description": "A set of derogatory stereotypes that portray individuals, particularly from certain racial or socioeconomic groups, as morally failing or lazy for relying on government assistance or others for economic support. These tropes are often used to justify social stigma and discrimination against those in need.",
      "belongsToAnalysis": {
