    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a2b9b3c4",
      "@type": "BackgroundKnowledge",
      "instance_name": "lazy_unemployed_characterizations",
      "label": "Lazy/Unemployed Characterizations",
      "description": "Stereotypes that associate economic dependency or unemployment with laziness, moral weakness, or personal failure. These characterizations are often applied to specific groups and are used to shame or dehumanize individuals in need.",
