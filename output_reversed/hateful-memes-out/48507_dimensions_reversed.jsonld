      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_107c0a35",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "White man in prayer is mapped as the 'how black people became christians' narrative",
      "description": "The visual of the white man praying with a rosary is analogically mapped to the text 'how black people became christians'. This mapping implies that the white man represents the 'proper' or 'authentic' form of Christian practice, while the text suggests that Black people were somehow 'converted' or 'forced' into Christianity, reinforcing a racialized hierarchy. The man's posture and the rosary symbolize a white, Catholic, and passive form of Christianity, which is contrasted with the implied active, self-determined Black Christian identity that the text dismisses. This mapping is central to the meme's hateful intent, as it dehumanizes Black religious identity by portraying it as something imposed rather than self-chosen.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_079c5c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ba2c0992",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the white man in prayer",
      "description": "The user is projected onto the visual material of the white man praying with a rosary, as this image is central to the meme's hateful framing. The user is implicitly positioned as the 'observer' or 'questioner' of the narrative presented in the text, which asks 'how black people became christians.' The visual of the white man in prayer is used to represent the 'proper' or 'authentic' form of Christian practice, and the user is projected onto this visual as the one who is 'asking' or 'thinking' the question implied by the text. This projection reinforces the racialized hierarchy by equating the user's perspective with the white, Catholic, passive form of Christianity depicted in the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_079c5c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_22adab58",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks Black people by implying their religious identity is not authentic or self-chosen, and it uses a dehumanizing, stereotypical framing that reduces complex historical and cultural realities to a simplistic, offensive joke. The image of the white man praying reinforces a racialized hierarchy, suggesting that the 'proper' or 'authentic' form of Christian practice is white, while Black people are portrayed as outsiders or converts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_079c5c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6a8a596d",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who hold or are exposed to anti-Black racist ideologies, particularly those who may subscribe to white supremacist tropes that question or devalue Black religious identity. The meme is designed to resonate with people who accept or are influenced by the stereotype that Black people were passive converts to Christianity, and who may find humor or validation in the racialized hierarchy implied by the image of the white man praying with a rosary. This audience likely includes individuals who are culturally or ideologically predisposed to view Black religious expression as inferior, imposed, or not 'authentic' compared to white Christian practices, and who may be drawn to content that reinforces these harmful narratives.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_079c5c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
