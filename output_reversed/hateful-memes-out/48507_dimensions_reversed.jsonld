    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c6c5b2dc",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype",
      "label": "Anti-Black Stereotype: Black people as passive converts to Christianity",
      "description": "This stereotype falsely implies that Black people were not historically active in shaping Christianity but were instead 'converted' or 'forced' into it, often by white missionaries or colonial powers. It dehumanizes Black religious identity by suggesting it is not authentic or self-chosen, and it reinforces a racial hierarchy by implying white Christian practice is 'proper' or 'authentic'. This is a core component of the meme's hateful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_079c5c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_00a33e03",
      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_hierarchy_in_christianity",
      "label": "Racialized Hierarchy in Christian Practice",
      "description": "The meme implicitly references a historical and contemporary racial hierarchy within Christianity, where white Christian practices and identities are often portrayed as 'pure', 'authentic', or 'proper', while Black Christian identities are marginalized or portrayed as 'outsiders' or 'converts'. This hierarchy is rooted in colonialism, slavery, and systemic racism, and the image of the white man praying reinforces this by visually equating white prayer with 'authentic' Christian devotion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_079c5c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_65f94b5b",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_context_of_black_christianity",
      "label": "Historical Context of Black Christianity",
      "description": "Black people have been active, foundational, and transformative participants in the development of Christianity, especially in the Americas, through the establishment of independent Black churches, the development of Black theology, and the leadership of influential figures like Martin Luther King Jr., Sojourner Truth, and many others. The meme ignores this rich, self-determined history and instead frames Black Christianity as something imposed or 'learned', which is historically inaccurate and deeply offensive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_079c5c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_283a55d9",
      "@type": "BackgroundKnowledge",
      "instance_name": "rosary_as_catholic_symbol",
      "label": "Rosary as a Catholic Symbol",
      "description": "The rosary is a devotional tool primarily associated with the Roman Catholic Church, used for prayer and meditation. Its presence in the image, combined with the white man's appearance, reinforces the stereotype that 'proper' or 'authentic' Christian practice is white and Catholic, further marginalizing Black Christian traditions which often include different forms of worship and spiritual expression (e.g., African American Gospel, Pentecostalism, etc.).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_079c5c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a2a2734c",
      "@type": "BackgroundKnowledge",
      "instance_name": "white_supremacist_rhetoric",
      "label": "White Supremacist Rhetoric: 'How did they become Christians?'",
      "description": "This rhetorical question is a classic white supremacist trope used to imply that Black people's religious identity is not 'natural' or 'authentic', but rather something they were 'taught' or 'forced' to adopt. It is used to delegitimize Black religious expression and to reinforce the idea that Black people are culturally inferior or incapable of developing their own religious traditions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_079c5c59"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2a90c2cf",
      "@type": "EmotionExpression",
      "instance_name": "contemplative_sorrow",
      "label": "contemplative sorrow emotion",
      "description": "The man's closed eyes, clasped hands, and solemn posture convey a deep, introspective sorrow or spiritual burden. His expression suggests a heavy, pensive emotional state, possibly reflecting inner turmoil or profound grief, rather than simple prayer or peace.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_079c5c59"
