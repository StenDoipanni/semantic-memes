    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c910d1fb",
      "@type": "BackgroundKnowledge",
      "instance_name": "traditional_relationship_dynamic",
      "label": "Traditional Relationship Dynamic",
      "description": "The meme references the traditional, often outdated, model of relationships where gender roles are clearly defined, with one partner (typically the woman) expected to handle domestic duties and the other (typically the man) expected to handle external responsibilities. This dynamic is used to contrast with modern, more egalitarian relationship models.",
