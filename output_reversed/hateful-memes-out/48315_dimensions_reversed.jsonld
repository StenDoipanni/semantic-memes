    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7eb3c850",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of two women in a relationship",
      "description": "The user is projected onto the scene of two women holding hands and smiling, as the meme implies a universal or relatable scenario about relationships and domestic labor. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the meme invites the user to mentally insert themselves into the scenario, imagining who in their own relationship would make the sandwiches. This projection is onto the visual scene and the textual question, which together create a shared social context.",
      "belongsToAnalysis": {
