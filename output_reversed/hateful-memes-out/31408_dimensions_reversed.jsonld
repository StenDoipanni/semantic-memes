      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_464cf6b9",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed for an audience familiar with or interested in internet humor that relies on crude, degrading stereotypes, particularly those targeting Islam and Muslim men. The target audience likely includes individuals who consume and share memes that use Islamophobic tropes, such as hypersexualization and the 'ISIS strip club' stereotype, often found in online spaces where such content is circulated. The audience is expected to recognize the visual cues (traditional headwear) and textual references ('ISIS strip club') as markers of the meme’s intended target community, which is the Muslim community, and to find the crude analogy humorous or provocative.",
      "belongsToAnalysis": {
