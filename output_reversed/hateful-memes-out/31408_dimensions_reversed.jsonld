    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9f8a3931",
      "@type": "BackgroundKnowledge",
      "instance_name": "isis_strip_club_stereotype",
      "label": "ISIS Strip Club Stereotype",
      "description": "A derogatory and hateful stereotype that equates ISIS members with sexualized or degrading behavior, often implying they are engaging in prostitution or pornography. This is a form of Islamophobia and hate speech targeting Muslim men and the broader Muslim community. The term 'ISIS strip club' is a deliberately provocative and degrading label used to mock and degrade the group.",
      "belongsToAnalysis": {
