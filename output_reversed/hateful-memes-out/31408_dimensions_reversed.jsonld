    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f5dc382c",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia",
      "label": "Islamophobia",
      "description": "A form of prejudice, fear, or hatred directed towards Islam and Muslims. It often manifests as stereotypes that portray Muslims as violent, sexually deviant, or incompatible with Western values. The meme relies on this harmful trope by associating Muslim men with sexual degradation, which is a form of Islamophobic stereotyping.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f2d20ab7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6983e87b",
      "@type": "BackgroundKnowledge",
      "instance_name": "hypersexualization_stereotype",
      "label": "Hypersexualization Stereotype",
      "description": "A harmful stereotype that portrays members of a group (in this case, Muslim men) as inherently sexually deviant or overly sexualized. This stereotype is used in the meme to mock ISIS members by implying they are engaging in sexualized behavior, reducing them to crude, degrading caricatures.",
      "belongsToAnalysis": {
