    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2990d10a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "sheep are mapped to ISIS members at a strip club",
      "description": "The top image of sheep showing their rear ends, labeled 'meanwhile', is juxtaposed with the bottom image of men in traditional headwear reacting with shock, labeled 'at the isis strip club'. This creates an analogical mapping where the sheep (visual entity) are implicitly mapped to ISIS members (implied by the text), and their rear-facing posture is humorously equated with the act of 'stripping' or performing in a strip club. The text 'at the isis strip club' explicitly defines the context for the visual material below, establishing the mapping between the sheep's visual presentation and the degrading stereotype applied to ISIS members.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f2d20ab7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e74349ca",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material and visual material of the meme",
      "description": "The user is projected onto the textual material 'at the isis strip club' and the visual material of the men in traditional headwear, as these elements directly invoke the hateful stereotype being mocked. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the meme's structure and intent require the user to identify with the perspective of the viewer who is interpreting the juxtaposition and the degrading analogy. The user is implicitly projected onto the scene of the men reacting with shock and amusement, as this is the focal point of the bottom panel and the target of the stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f2d20ab7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
