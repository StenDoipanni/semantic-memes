      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "pop culture enthusiasts of 'The Golden Girls'",
      "description": "The meme targets fans of the TV show 'The Golden Girls' who recognize Betty White as the actress who played Rose Nylund, one of the main characters. The humor relies on the audience's familiarity with the show's cast and the affectionate nickname 'Golden Girl' for the characters. The target community includes viewers who appreciate the show's humor, strong female leads, and Betty White's iconic performance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1847e614"
      },
