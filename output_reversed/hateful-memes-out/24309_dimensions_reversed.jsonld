    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_58f335e9",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The person asking about favorite golden girl is mapped onto Betty White",
      "description": "The text 'when people ask me who my favorite golden girl is' implies that the speaker (the person asking) is identifying themselves as the one who has a favorite among the Golden Girls. The visual material shows Betty White, who is widely recognized as the actress who played Rose Nylund, one of the 'Golden Girls'. The meme humorously maps the speaker's self-identification as 'me' onto Betty White, who is the visual representation of the 'favorite golden girl' in this context. The mapping is established through the textual reference to 'my favorite golden girl' and the visual depiction of Betty White, who is the iconic embodiment of that character in popular culture.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1847e614"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_27368c33",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto Betty White as 'my favorite golden girl'",
      "description": "The text 'when people ask me who my favorite golden girl is' explicitly uses the first-person pronoun 'me', projecting the user (the person asking) onto the visual entity Betty White. The user is humorously identifying themselves as the one who has a favorite among the Golden Girls, and Betty White, as the iconic actress who played Rose Nylund, becomes the visual embodiment of that 'favorite'. This projection is established through the deictic 'me' in the text and the visual representation of Betty White as the 'golden girl' in the meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1847e614"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
