    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b3503426",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_conspiracy_stereotype",
      "label": "Antisemitic Conspiracy Stereotype",
      "description": "The meme relies on the historical antisemitic trope that Jews are either not present or are being hidden, often used to imply Jewish people are 'not in the room' or 'not among us'. This stereotype is rooted in centuries of antisemitic propaganda and conspiracy theories, such as the 'Jewish Question' and the 'Protocols of the Elders of Zion'. The text 'do you see them often? are they in the room with us now?' is a direct invocation of this harmful trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7a71a31"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_70d475d2",
      "@type": "BackgroundKnowledge",
      "instance_name": "sigmund_freud_jewish_identity",
      "label": "Sigmund Freud's Jewish Identity",
      "description": "Sigmund Freud was a Jewish psychoanalyst. His Jewish identity is crucial to understanding the meme, as it leverages his association with 'Russians' (a common historical association due to his birthplace and the Russian Empire's influence on his early life) to imply that Jews are not present or are being excluded. The text 'Father of psychoanalysis, Sigmund Freud' is used to anchor the image to his identity, which is then weaponized in the antisemitic context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7a71a31"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_324276de",
      "@type": "BackgroundKnowledge",
      "instance_name": "russian_jewish_association",
      "label": "Historical Association of Russians with Jews",
      "description": "The meme implicitly references the historical and cultural association between Jews and Russia, particularly in the context of the Russian Empire and the Soviet Union, where many Jewish intellectuals and artists lived and worked. This association is used to imply that 'Russians' (in this context, Jews) are not present or are being hidden, which is a form of antisemitic stereotyping.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7a71a31"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_96519af7",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_propaganda",
      "label": "Antisemitic Propaganda",
      "description": "The meme is a form of antisemitic propaganda that uses the image of Sigmund Freud to promote harmful stereotypes about Jewish people. It leverages the historical context of antisemitism, including conspiracy theories about Jewish control of finance and media, to create a hateful message that targets Jewish people based on their ethnicity and national origin.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7a71a31"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ef288bb6",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_trope",
      "label": "Antisemitic Trope: 'Are They in the Room?'",
      "description": "This is a specific antisemitic trope that questions the presence of Jews in a given context, implying they are either not present or are being hidden. It is often used to suggest that Jews are not trustworthy or are not part of the 'mainstream' society. The text 'do you see them often? are they in the room with us now?' is a direct example of this trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7a71a31"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_54780ebf",
      "@type": "EmotionExpression",
      "instance_name": "hatefulness",
      "label": "hateful emotional expression",
      "description": "The overall emotional tone conveyed by the meme is hateful, stemming from the antisemitic propaganda embedded in the image and text. The text questions the presence of 'Russians' (implying Jews) in a room, invoking a harmful conspiracy trope. The serious, stern facial expression of Sigmund Freud, juxtaposed with the accusatory text, reinforces a tone of suspicion and hostility toward Jewish people. This emotion is not an expression of the subject himself but is generated by the meme's content and intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7a71a31"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7a186050",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Sigmund Freud is mapped as 'these \"russians\"'",
      "description": "The text 'about these \"russians\"' is juxtaposed with the image of Sigmund Freud, who is explicitly identified as 'Father of psychoanalysis, Sigmund Freud'. This creates an analogical mapping where the visual entity (Sigmund Freud) is being projected as or equated with the textual entity ('these \"russians\"'), leveraging his Jewish identity and historical association with Russia to imply that Jews (specifically those associated with Russia) are being questioned for their presence. This is a direct mapping from the visual material to the textual material, where the person in the image is being analogically mapped to the group mentioned in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7a71a31"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2017ecab",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the antisemitic propaganda scene",
      "description": "The user is projected onto the overall antisemitic propaganda scene, which includes the visual material of Sigmund Freud and the textual material questioning the presence of 'Russians'. The rhetorical question 'do you see them often? are they in the room with us now?' implicitly addresses the viewer ('you'), inviting them to participate in the antisemitic trope by questioning the presence of Jews. The user is thus projected onto the scene as the one who is supposed to 'see' or 'notice' the absence of 'Russians' (Jews), making them an active participant in the hateful narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7a71a31"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
