    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6dd5fe95",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The woman is mapped as the one who 'openly states that america and americans are both \"immoral\"'",
      "description": "The top text overlay explicitly attributes the statement 'openly states that america and americans are both \"immoral\"' to the woman depicted. This creates an analogical mapping where the textual claim is projected onto the visual entity (the woman), implying she is the source of the statement. The mapping is established through direct textual attribution to the person in the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bd770200"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ceeeddc8",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman as the source of the defamatory claims",
      "description": "The user is projected onto the visual material of the woman, as the meme explicitly attributes the morally charged statements ('openly states that america and americans are both \"immoral\"' and 'boinked her own brother') to her. The user is not directly addressed with deictic pronouns like 'you' or 'me', but the entire meme functions as a projection of the user's hateful intent onto the woman, making her the target of the false accusations. The user is implicitly 'you' — the viewer who is being invited to accept the smear campaign as truth.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bd770200"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_86cdcb69",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks the woman based on her race, gender, and religious identity, using false and defamatory claims to smear her reputation. The text 'openly states that america and americans are both \"immoral\"' is presented as a factual accusation, while the second line 'boinked her own brother' is a vulgar, baseless, and sexually explicit allegation. This combination uses juxtaposition to discredit her character, implying she is both morally corrupt and sexually deviant. The content is designed to provoke outrage and discredit the individual based on protected characteristics, fitting the definition of hateful content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bd770200"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f748cafc",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who hold or are exposed to racist, misogynistic, Islamophobic, and politically motivated hate speech tropes. The meme is designed to appeal to those who are predisposed to dehumanize and smear women of color, particularly those who are religious (wearing a hijab) and critical of U.S. policies. The audience is likely to interpret the false allegations and stereotypes as 'truth' or at least as provocative commentary, and may be drawn to the meme for its inflammatory and sensationalist nature. The meme leverages existing community markers such as anti-Black stereotypes, Islamophobia, misogyny, and political disinformation to resonate with audiences who consume and share such content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bd770200"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
