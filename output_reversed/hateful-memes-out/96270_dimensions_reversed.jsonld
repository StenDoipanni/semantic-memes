      "@id": "http://example.org/multimodal-taxonomy#dimension_a3c86abf",
      "@type": "BackgroundKnowledge",
      "instance_name": "false_allegation",
      "label": "False Allegation",
      "description": "The claim that she 'boinked her own brother' is a baseless, fabricated accusation. This is a common tactic in hate memes to smear a person's reputation by inventing outrageous, sexually explicit lies. The meme relies on the audience's knowledge that such allegations are often false and used to discredit individuals, especially women of color.",
      "belongsToAnalysis": {
