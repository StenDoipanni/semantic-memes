    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_98197e86",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed to target individuals who hold or are susceptible to Islamophobic beliefs, particularly those who may be influenced by or reinforce stereotypes that associate Muslims with terrorism or violence. The visual of a grieving woman is used to evoke emotional sympathy, but the text deliberately misrepresents the victims as 'muslim' by virtue of being killed in mosques, aiming to frame the tragedy as a religiously motivated attack. This appeals to an audience that may already harbor prejudice against Muslims, using the emotional imagery to amplify and legitimize harmful narratives. The meme’s intent is to incite prejudice against Muslims by simplifying a complex tragedy into a religiously charged statement, thus targeting communities or individuals who are predisposed to anti-Muslim sentiment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bce38cde"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
