    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6e5bba8b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Grief is mapped onto the text about Muslim victims",
      "description": "The visual of the grieving woman is juxtaposed with the text 'muslim 49 people were killed at christchurch', creating an analogical mapping where the emotional state of grief (expressed by the woman) is associated with the tragic event described in the text. The text frames the victims as Muslim, and the image of mourning is used to evoke an emotional response to this specific, misleading narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bce38cde"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e9cdb0bc",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the grieving woman in the visual material",
      "description": "The user is projected onto the visual material of the woman in mourning, as the image of grief is used to evoke an emotional response that is then tied to the misleading text about Muslim victims. The user is implicitly invited to identify with the emotional state depicted, even though the text manipulates the context of that emotion.",
      "belongsToAnalysis": {
