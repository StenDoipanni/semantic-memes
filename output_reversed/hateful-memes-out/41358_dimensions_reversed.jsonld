    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_79993fd9",
      "@type": "BackgroundKnowledge",
      "instance_name": "christchurch_mosque_shootings_2019",
      "label": "2019 Christchurch Mosque Shootings",
      "description": "A terrorist attack that occurred on March 15, 2019, in Christchurch, New Zealand, where a gunman killed 51 people, predominantly Muslim, in three mosques. This event is referenced in the text overlay as the context for the deaths mentioned. The meme inaccurately frames the victims as 'muslim' by virtue of being killed in mosques, which is a misrepresentation and potentially incites Islamophobia.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bce38cde"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bafb16a0",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia",
      "label": "Islamophobia",
      "description": "A form of prejudice, fear, or hatred directed towards Muslims. The meme promotes a harmful stereotype by implying that the attack was specifically targeted at Muslims, thereby reinforcing Islamophobic tropes such as 'Muslims are terrorists' or 'Muslims are inherently violent'. This is a key background concept needed to understand the hateful intent of the meme.",
      "belongsToAnalysis": {
