      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2e15c9a2",
      "@type": "BackgroundKnowledge",
      "instance_name": "misinformation",
      "label": "Misinformation",
      "description": "False or inaccurate information that is spread, often unintentionally, but in this case, the text is deliberately misleading. The meme falsely claims 'muslim 49 people were killed' and implies the victims were Muslim solely because they were killed in mosques, which is a distortion of the facts. This is a core background concept for understanding the meme's deceptive nature.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bce38cde"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_504d1146",
      "@type": "BackgroundKnowledge",
      "instance_name": "religion_and_location_confusion",
      "label": "Religion and Location Confusion",
      "description": "The meme conflates the religious identity of the victims with the location of the attack (mosques), implying that being killed in a mosque automatically makes one Muslim. This is a false equivalence that misrepresents the actual victims and is a common tactic in hate speech to simplify complex tragedies into religiously charged narratives.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bce38cde"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5f94946b",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_muslim_stereotype",
      "label": "Anti-Muslim Stereotype",
      "description": "The stereotype that Muslims are inherently violent or terrorist, which is promoted by the meme's framing. The text 'muslim 49 people were killed at christchurch' implies that the attack was specifically targeted at Muslims, reinforcing the harmful stereotype that Muslims are a threat to society, which is a core element of Islamophobia.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bce38cde"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
