    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f9e6001b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The glamorous woman is mapped as the person who removes polish with chemicals and nobody bats an eye",
      "description": "The top panel shows a glamorous woman with red nail polish, and the text 'removes polish with chemicals nobody bats an eye' is directly mapped onto her visual representation. This implies that her appearance and demeanor (calm, confident, glamorous) are being used as an analogy for the mundane, socially accepted act of removing nail polish with chemicals.",
