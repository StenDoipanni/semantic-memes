    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d9e4d08b",
      "@type": "BackgroundKnowledge",
      "instance_name": "shiba_inu_meme_culture",
      "label": "Shiba Inu Meme Culture",
      "description": "The Shiba Inu dog is widely recognized in internet culture as a meme subject, often portrayed with an innocent, mischievous, or 'sassy' expression. This visual trope is frequently used to juxtapose harmless or cute imagery with threatening or hateful text, thereby amplifying the impact of the message. The dog's expression in this image is a key element of the meme's visual language.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5388bb58"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1af79573",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_transgender_discrimination",
      "label": "Anti-Transgender Discrimination",
      "description": "A social and political phenomenon characterized by prejudice, hostility, and systemic oppression against individuals based on their gender identity or expression. This includes hate speech, violence, and exclusionary policies. The meme's text directly references this form of discrimination, making it a critical background concept for understanding the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5388bb58"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ccdca33b",
      "@type": "BackgroundKnowledge",
      "instance_name": "hateful_meme_trope",
      "label": "Hateful Meme Trope",
      "description": "A pattern in internet meme culture where a harmless or cute image is paired with hateful, threatening, or discriminatory text to normalize or amplify hostility toward a marginalized group. This trope is used to spread hate and incite harm, often by exploiting the contrast between the visual and textual elements. The image of the Shiba Inu under the table is a classic example of this visual trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5388bb58"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a1755fde",
      "@type": "EmotionExpression",
      "instance_name": "mischievousness",
      "label": "the mischievous expression",
      "description": "The Shiba Inu dog has large, dark, expressive eyes and perked ears, looking upward with a slight smirk or tilted mouth, conveying an innocent yet sly or playful demeanor. This expression is commonly associated with the 'Shiba Inu meme culture' and is used to juxtapose harmless cuteness with threatening or hateful text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5388bb58"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5ed4dfd9",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_0",
      "label": "The Shiba Inu dog is mapped as the entity performing the 'trans hunting' action.",
      "description": "The text 'im going trans hunting' is juxtaposed with the image of the Shiba Inu dog lying under the table. The dog's innocent yet mischievous expression is used to analogically represent the speaker (the 'I' in the text) as the agent performing the hateful act of 'trans hunting'. This mapping exploits the visual trope of the Shiba Inu to project the speaker's identity and intent onto the dog, thereby normalizing the hateful message by associating it with a harmless, cute animal. The dog becomes the visual stand-in for the speaker's threatening persona.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5388bb58"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_102d50f6",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the Shiba Inu dog as the agent of 'trans hunting'",
      "description": "The user is projected onto the Shiba Inu dog (VisualMaterial entity) through the text 'im going trans hunting'. The first-person pronoun 'im' (a deictic referring to the speaker/user) is mapped onto the dog, which becomes the visual stand-in for the user's identity and intent. This projection normalizes the hateful message by associating the user's threatening persona with a harmless, cute animal, exploiting the Shiba Inu meme culture trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5388bb58"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_57db4ba3",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks individuals based on their gender identity through the text 'im going trans hunting', which is a derogatory and hateful trope implying targeting or persecution of transgender people. The visual of a harmless Shiba Inu dog is used to normalize and amplify hostility toward the transgender community, fitting squarely within the 'hateful' category.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5388bb58"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dc3a047e",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The intended audience is individuals who may be exposed to or share this meme, particularly those who are not members of the transgender community and may be influenced by the hateful message. The meme is designed to incite hostility or fear toward transgender people, so its target audience includes those who hold anti-transgender biases or are susceptible to hate speech normalization. The use of the Shiba Inu meme culture as a visual trope suggests the audience is familiar with internet meme formats, likely online users who consume and share such content. The text 'im going trans hunting' directly targets the transgender community, making them the primary victims of the hate, while the meme's creators and sharers are the intended audience for dissemination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5388bb58"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
