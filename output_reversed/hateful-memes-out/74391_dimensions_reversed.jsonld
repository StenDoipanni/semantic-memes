    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e23c4f35",
      "@type": "BackgroundKnowledge",
      "instance_name": "sarcastic_self_pity",
      "label": "Sarcastic Self-Pity",
      "description": "The meme employs sarcasm to mock the idea of self-pity, where the individual exaggerates their suffering to the point of absurdity. This is a common comedic device in internet culture, often used to highlight the ridiculousness of overreacting to minor problems.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dffcdc76"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_909cea9f",
      "@type": "EmotionExpression",
      "instance_name": "frustration",
      "label": "frustrated emotion",
      "description": "The woman's facial expression and body language—holding her head with both hands, looking downward at the laptop, and displaying a strained, overwhelmed look—visually convey intense frustration. This is compounded by the text overlay that sarcastically frames her situation as one of victimization, amplifying the emotional expression of being overwhelmed by a minor or trivial issue.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dffcdc76"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_25feec4e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The woman is mapped as the victim in the text",
      "description": "The text 'this victimizes me' explicitly maps the woman (the visual entity) as the one being victimized ('me'). The woman's frustrated expression and posture visually represent the state of being victimized as described in the text. This is an analogical mapping where the textual concept of 'me' (the victim) is projected onto the visual entity 'woman'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dffcdc76"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_91a20c3d",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman as the victim",
      "description": "The user is projected onto the woman (visual material) through the explicit deictic pronoun 'me' in the text 'this victimizes me'. This deictic anchors the user's identification with the woman as the victim, creating a direct semiotic projection where the viewer sees themselves as the subject of victimization described in the text. The woman's visual expression and posture reinforce this projection by embodying the state of being victimized.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dffcdc76"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
