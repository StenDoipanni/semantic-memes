    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cc84c00d",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_stereotype",
      "label": "Misogynous Stereotype",
      "description": "The meme relies on the stereotype that women are overly emotional, prone to victimhood, and exhibit 'crazy' or 'hysterical' behavior in response to minor inconveniences or workplace stress. This stereotype is used to frame the woman's frustration as exaggerated self-pity, which is presented humorously but reinforces misogynous tropes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dffcdc76"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d1cab35e",
      "@type": "BackgroundKnowledge",
      "instance_name": "victimhood_meme_trope",
      "label": "Victimhood Meme Trope",
      "description": "The meme uses the trope of exaggerated victimization, where an individual claims to be 'victimized' by a trivial or minor situation. This trope is often used humorously to highlight absurdity, but in this context, it is applied to a woman, reinforcing gendered expectations about emotional expression and self-pity.",
      "belongsToAnalysis": {
