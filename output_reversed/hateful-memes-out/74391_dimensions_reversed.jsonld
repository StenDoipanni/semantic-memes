      "instance_name": "workplace_stress",
      "label": "Workplace Stress",
      "description": "The meme implicitly references the real-world phenomenon of workplace stress, where employees experience frustration, burnout, or overwhelm due to job demands, technology, or interpersonal dynamics. The woman’s posture and expression are visual cues for this common experience.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dffcdc76"
