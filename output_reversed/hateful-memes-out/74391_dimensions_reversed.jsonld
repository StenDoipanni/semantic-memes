    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_99e8bd60",
      "@type": "Scene",
      "instance_name": "frustrated_work_scene",
      "label": "woman_experiencing_workplace_stress",
      "description": "A woman is seated at a desk in an office environment, visibly frustrated or overwhelmed as she looks at a laptop. She is holding her head with both hands, suggesting stress or despair. The scene is framed to emphasize her emotional state in relation to her work task. The overlaid text \"there must be some way this victimizes me\" adds a layer of self-pity or exaggerated victimhood to the visual context.",
      "belongsToAnalysis": {
