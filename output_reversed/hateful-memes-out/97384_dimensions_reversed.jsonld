    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5ea3cdc3",
      "@type": "BackgroundKnowledge",
      "instance_name": "misappropriation_of_respected_figure",
      "label": "Misappropriation of a Respected Figure",
      "description": "The meme uses the image of the Dalai Lama, a respected spiritual leader, to deliver a violent message. This is a form of cultural appropriation and disrespect, as it weaponizes his public persona for a completely unrelated and violent context. This concept is not visible in the image but is essential to understand the meme's harmful intent and the ethical implications of its use.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcc53ba2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5ed50a91",
      "@type": "BackgroundKnowledge",
      "instance_name": "harmful_meme_intent",
      "label": "Harmful Meme Intent",
      "description": "The meme's intent is to mock or satirize the concept of 'double tap' in video games or self-defense, but by using a figure of peace, it creates a jarring and potentially dangerous contrast that could be interpreted as endorsing violence. This concept is not visible in the image but is essential to understand the meme's overall harmful intent and its potential to incite dangerous behavior or desensitize viewers to lethal force.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcc53ba2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a6436ef7",
      "@type": "EmotionExpression",
      "instance_name": "mockery",
      "label": "mocking emotion",
      "description": "The emotion expressed is mockery, conveyed through the juxtaposition of the Dalai Lama's peaceful demeanor with violent, militaristic text that misrepresents his teachings. The text falsely claims 'the double tap is a myth' and advises 'shoot until the threat changes shape or catches fire,' creating a jarring and satirical contrast that mocks both the concept of 'double tap' and the non-violent principles associated with the Dalai Lama.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcc53ba2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_296248d6",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Dalai Lama is mapped as the source of violent advice",
      "description": "The text 'shoot until the threat changes shape or catches fire. only then will your enemies know true peace' is overlaid on the image of the Dalai Lama, creating an analogical mapping where the Dalai Lama is implicitly projected as the speaker or originator of this violent message, despite his actual teachings being fundamentally opposed to such content. This mapping is harmful as it misappropriates his image to endorse violence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcc53ba2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9078604a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the violent textual message",
      "description": "The user is projected onto the textual material that delivers the violent and misleading message, as the meme's intent is to make the viewer identify with or internalize the aggressive advice attributed to the Dalai Lama. The text 'shoot until the threat changes shape or catches fire. only then will your enemies know true peace' uses 'your enemies' which directly addresses the user, creating a deictic projection of the user onto the violent advice.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcc53ba2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
