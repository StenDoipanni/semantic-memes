    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5fd3ed48",
      "@type": "BackgroundKnowledge",
      "instance_name": "double_tap_myth",
      "label": "Double Tap Myth",
      "description": "The 'double tap' refers to a shooting technique in video games and real-world self-defense where a shooter fires two rapid shots to ensure the target is incapacitated. The meme falsely claims this is a 'myth,' implying it's ineffective or unnecessary, which is a misrepresentation of real-world combat tactics and gaming mechanics. This concept is not visible in the image but is essential to understand the meme's satirical or mocking intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcc53ba2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1d29c048",
      "@type": "BackgroundKnowledge",
      "instance_name": "shoot_until_threat_changes_shape",
      "label": "Shoot Until Threat Changes Shape or Catches Fire",
      "description": "This phrase is a violent, militaristic trope that misrepresents real-world combat doctrine. It implies that lethal force should be applied continuously until the threat is neutralized or destroyed, which is a gross distortion of non-violent principles. This concept is not visible in the image but is essential to understand the meme's violent and misleading message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcc53ba2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8bb02cfd",
