    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_be49cf3a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Hillary Clinton is mapped as the subject of abusive accusations",
      "description": "The visual entity 'Hillary_Clinton' is mapped onto the textual accusation in 'text_chunk_1' and subsequent text, which falsely attributes to her the moral reprehensibility of finding humor in violent acts. The meme uses her image as the visual anchor for the abusive text, creating an analogical mapping where the person in the image is the target of the accusation. This mapping is explicit through spatial juxtaposition: her portrait is overlaid with text that directly accuses her, implying she is the 'she' in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f8710277"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_479a2ea7",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the abusive accusation scene",
      "description": "The user is projected onto the abusive accusation scene, which is composed of the visual material of Hillary Clinton and the textual material accusing her of finding humor in violent acts. The meme's structure implies the user is identifying with the moral outrage or the accusatory stance, projecting their own judgment or anger onto the scene. There are no explicit deictic pronouns like 'me' or 'you' in the text, but the accusatory tone and the framing of the scene create an implicit projection where the user sees themselves as the moral arbiter or victim of the situation described. The user is projected onto the scene as the one who is outraged by the alleged behavior, thereby internalizing the meme's moral framework.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f8710277"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
