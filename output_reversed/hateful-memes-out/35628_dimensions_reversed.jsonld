    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_acd78f62",
      "@type": "BackgroundKnowledge",
      "instance_name": "public_trust_in_media",
      "label": "Public Trust in Mainstream Media",
      "description": "A widely discussed social trend and cultural phenomenon in which audiences have become increasingly skeptical of the accuracy, motives, and integrity of traditional news outlets. This trend is often attributed to factors such as political polarization, the rise of social media, misinformation, and perceived bias in reporting. The meme references this erosion of trust as a central theme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7df6db1b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1697c5b0",
      "@type": "BackgroundKnowledge",
      "instance_name": "mainstream_media",
      "label": "Mainstream Media",
      "description": "The collective term for traditional news organizations such as television networks, newspapers, and major news agencies (e.g., CNN, The New York Times, The Hollywood Reporter). These institutions are often contrasted with alternative or social media sources in discussions about information credibility and public perception.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7df6db1b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
