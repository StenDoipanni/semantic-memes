    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ccfae322",
      "@type": "EmotionExpression",
      "instance_name": "cynicism",
      "label": "cynical emotion",
      "description": "The emotion expressed is cynicism, conveyed through the juxtaposition of Anderson Cooper’s neutral, professional demeanor with the sarcastic text 'the people don't believe our bullshit anymore.' This creates a tone of disillusionment and skepticism toward mainstream media narratives, implying that the media’s credibility is now questioned by the public.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7df6db1b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d5499d89",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Anderson Cooper is mapped as a symbol of mainstream media",
      "description": "The visual entity Anderson_Cooper is mapped onto the textual concept of mainstream media. His professional appearance and the context (The Hollywood Reporter backdrop) position him as a representative of traditional news institutions, which the text 'the people don't believe our bullshit anymore' critiques. This mapping implies that Anderson Cooper, as a figurehead of mainstream media, is the subject of public disillusionment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7df6db1b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6f7778bd",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message criticizing media credibility",
      "description": "The user is projected onto the textual material 'the people don't believe our bullshit anymore', which serves as the core message of the meme. The user identifies with the sentiment expressed — the disillusionment of the public toward mainstream media narratives — and sees themselves as part of that collective skepticism. The projection is implicit, not deictic (e.g., no 'you' or 'me'), but the tone and content of the text create a direct psychological alignment with the viewer's own perception of media distrust.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7df6db1b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_31cb1677",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme undermines the credibility of professional journalism and may contribute to a broader erosion of trust in institutions, potentially leading to misinformation or apathy. The tone is cynical and dismissive, which can be damaging to public discourse and the integrity of news reporting.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7df6db1b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d3890209",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals who are critical of or skeptical toward mainstream media, particularly those who perceive a disconnect between media narratives and reality. This includes people who have experienced or witnessed the erosion of public trust in traditional news institutions, and who may be active on social media or in online discourse spaces where such memes circulate. The meme appeals to a demographic that is disillusioned with the perceived bias, sensationalism, or dishonesty of professional journalism, and who may identify with or support alternative information sources. The use of Anderson Cooper as a symbol of mainstream media and the phrase 'the people don't believe our bullshit anymore' directly addresses this community, signaling that the message is intended for those who feel alienated from or distrustful of traditional news outlets.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7df6db1b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
