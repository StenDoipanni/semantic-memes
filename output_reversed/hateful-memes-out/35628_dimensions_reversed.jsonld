    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f995cd44",
      "@type": "BackgroundKnowledge",
      "instance_name": "public_disillusionment",
      "label": "Public Disillusionment",
      "description": "A social and psychological state in which the public loses faith in institutions, leaders, or systems (including media) due to perceived dishonesty, incompetence, or corruption. This concept underpins the meme’s cynical tone and message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7df6db1b"
