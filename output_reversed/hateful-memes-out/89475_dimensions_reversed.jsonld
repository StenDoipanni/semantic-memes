    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c970c5b5",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The man is mapped as 'when you're not fit but you know you're still majestic af'",
      "description": "The text 'when you're not fit but you know you're still majestic af' is directly mapped onto the visual entity 'man'. The man's physical appearance (large belly, not conventionally fit) is contrasted with his pose and the text's assertion of inner majesty, creating an analogical mapping where the man embodies the textual description. The visual material (man in ballet costume) is used to represent the textual concept of someone who is not physically fit but still feels majestic.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c3c1ef9d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6b9d44d5",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man in the ballet pose",
      "description": "The user is projected onto the visual material of the man striking a ballet pose, as the text 'when you're not fit but you know you're still majestic af' directly addresses the viewer's self-identification with the man's situation. The meme invites the user to see themselves in the man's posture and self-perception, creating an identification with the subject. The man embodies the textual description, and the user is encouraged to project their own experience of being unfit yet majestic onto him.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c3c1ef9d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
