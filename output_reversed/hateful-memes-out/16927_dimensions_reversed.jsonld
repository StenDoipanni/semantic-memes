    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_75c09ba0",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Chuck Norris is mapped onto the elderly man",
      "description": "The top text 'chuck norris?' explicitly names the elderly man in the image as Chuck Norris. This creates an analogical mapping where the textual entity 'chuck_norris' is projected onto the visual entity 'elderly_man'. The joke relies on this mapping to then misrepresent Chuck Norris as 'her' (a woman) in the subsequent text, creating a gendered misrepresentation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b00fca7c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_250ef152",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the elderly man in military gear",
      "description": "The user is projected onto the visual material of the elderly man, as the meme's humor and intent are directed at the viewer's interpretation of the image and text. The user is expected to recognize the elderly man as Chuck Norris (via the text) and then interpret the punchline 'never heard of her' as a joke about gender misrepresentation. The user's role is to engage with the visual and textual elements to understand the meme's misogynistic intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b00fca7c"
      },
      "extractionMethod": "llm_extraction_huggingface"
