    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_01cd1f2f",
      "@type": "BackgroundKnowledge",
      "instance_name": "chuck_norris",
      "label": "Chuck Norris",
      "description": "Chuck Norris is a real-world American actor, martial artist, and former professional wrestler, known for his roles in action films and his association with martial arts and toughness. He is a male figure, and the meme humorously misrepresents him as 'her' (a woman) to create a joke based on gendered stereotypes. This requires external knowledge of who Chuck Norris is and his public persona as a male action star.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b00fca7c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_570a7680",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_stereotype",
      "label": "Misogynous Stereotype",
      "description": "The meme relies on the stereotype that women are unfamiliar or unknown to the speaker, and it mocks the idea of a male figure being mistaken for a female one. This is a form of misogynous humor because it uses gender stereotypes and implies that women are less known or less significant than men. This stereotype is not visible in the image but is required to understand the joke's intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b00fca7c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
