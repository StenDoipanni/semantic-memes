    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9e71bda4",
      "@type": "EmotionExpression",
      "instance_name": "disdain",
      "label": "disdainful expression",
      "description": "The elderly man's facial expression, characterized by a stern, unimpressed gaze and a slightly downturned mouth, conveys a sense of disdain or contempt. This expression is directed toward the absurdity of the text overlay, which humorously misrepresents Chuck Norris as 'her' and claims ignorance of her existence. The expression reinforces the meme's tone of dismissive humor, aligning with the implied superiority or indifference of the character portrayed.",
      "belongsToAnalysis": {
