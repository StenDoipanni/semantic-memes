    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a29f7139",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "ISIS members are mapped as patrons at a strip club",
      "description": "The text 'meanwhile at the isis strip club' maps the visual scene of men in traditional attire reacting with shock or amusement onto the conceptual idea of ISIS members being patrons at a strip club. This is an analogical mapping where the visual material (the men's reactions) is projected onto the textual description to imply that ISIS members are engaged in vulgar or absurd behavior, specifically a 'strip club' scenario. This mapping relies on the stereotype that ISIS members are hypersexualized and primitive, reducing their complex reality to a crude caricature.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_55e7238f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a4642809",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material implying participation in the absurd scenario",
      "description": "The user is projected onto the textual material 'meanwhile at the isis strip club', which frames the viewer as an observer or participant in the satirical scenario. The meme invites the user to imagine themselves in the context of the joke, where the absurdity of the ISIS strip club scenario is presented as a humorous contrast to the sheep image. This projection is implicit, as the meme does not use explicit deictic pronouns like 'you' or 'me', but the overall intent and structure of the meme (juxtaposition of images with a caption) create a shared imaginative space where the user is positioned as the one interpreting or experiencing the joke. The user is thus projected onto the textual material that defines the scene's absurd premise.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_55e7238f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0130e735",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme uses a harmful stereotype that portrays ISIS members as engaging in vulgar, sexualized, or absurd behavior (e.g., a 'strip club'), reducing a complex, violent, and ideologically driven group to a crude caricature. This stereotype is used to dehumanize and mock ISIS members, often reinforcing Islamophobic tropes by implying they are primitive, sexually deviant, or incapable of rational thought.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_55e7238f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5cc2baf5",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed for an audience familiar with internet meme culture, particularly those who consume and share satirical or absurdist content. The target community likely includes individuals who find humor in crude, exaggerated, or offensive stereotypes, especially those related to political or religious groups. The meme relies on cultural references to ISIS and the 'sheep-like conformity' metaphor, which may resonate with audiences who are already exposed to or sympathetic to anti-Islamophobic or anti-extremist humor, albeit in a harmful and dehumanizing form. The visual gag involving the sheep and the shocked men in traditional attire is likely to appeal to users who appreciate shock humor or irony, often found in online communities that engage with political satire or dark comedy. The meme’s toxicity and harmful stereotypes suggest it is targeted at audiences who may not be sensitive to the dehumanizing implications of such content, or who may be seeking to provoke or mock specific groups through exaggerated caricatures.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_55e7238f"
      },
      "extractionMethod": "llm_extraction_huggingface"
