    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3fe854b8",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia",
      "label": "Islamophobia",
      "description": "A form of prejudice or discrimination against Muslims, often manifesting as stereotypes that portray them as inherently violent, barbaric, or incompatible with Western values. The meme relies on this stereotype by associating ISIS (a group often conflated with Muslims) with absurd or sexualized imagery, thereby reinforcing negative perceptions of Muslims.",
