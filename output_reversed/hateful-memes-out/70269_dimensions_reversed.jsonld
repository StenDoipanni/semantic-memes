    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_00d2fd95",
      "@type": "BackgroundKnowledge",
      "instance_name": "dehumanization_tropes",
      "label": "Dehumanization Tropes",
      "description": "A set of rhetorical or visual strategies used to strip individuals or groups of their humanity, often by portraying them as animals, monsters, or objects of ridicule. The meme uses the sheep image and the 'strip club' reference to dehumanize ISIS members, making it easier to dismiss or mock their real-world violence and suffering.",
      "belongsToAnalysis": {
