    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_13c1f37d",
      "@type": "BackgroundKnowledge",
      "instance_name": "internet_meme_trope",
      "label": "Internet Meme Trope",
      "description": "The use of ironic or absurd imagery to highlight a common experience or situation, often with text overlay to deliver the punchline. This trope is prevalent in online humor and relies on shared cultural understanding of consumer experiences.",
      "belongsToAnalysis": {
