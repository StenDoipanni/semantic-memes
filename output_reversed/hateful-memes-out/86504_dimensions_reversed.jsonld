    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f6b90a25",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "free dishwasher concept mapped to dishwasher_loading scene",
      "description": "The text 'free dishwasher' is mapped onto the visual scene of a man loading a dishwasher, implying that the dishwasher being loaded is the 'free' item. The visual material (dishwasher_loading) represents the physical act of using the appliance, while the text labels it as 'free', creating an analogical mapping between the textual concept and the visual depiction of the appliance in use.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aa3d57fc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_64d262e5",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of loading a dishwasher with missing parts",
      "description": "The user is projected onto the visual scene of the man loading dishes into the dishwasher, which is humorously labeled as 'free dishwasher' with 'missing parts'. This projection implies the user is identifying with the experience of receiving a free item that is incomplete or defective, a common consumer frustration. The scene (dishwasher_loading) serves as the anchor for this projection, as it visually represents the ironic situation described by the text. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the meme's overall intent and relatable scenario create an implicit projection where the viewer sees themselves in the situation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aa3d57fc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4e895244",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "general internet audience",
      "description": "The meme is designed for a broad, general internet audience familiar with consumer culture and online humor tropes. It leverages relatable experiences such as receiving a free item with missing parts, which is a common source of frustration and humor across demographics. The visual of a domestic kitchen scene with two people is universally accessible, and the text overlay ('free dishwasher', 'missing parts') is a straightforward, widely understood internet meme format. The humor is situational and benign, targeting anyone who has experienced consumer disappointment or irony in promotional offers, without targeting any specific protected group or community.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aa3d57fc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
