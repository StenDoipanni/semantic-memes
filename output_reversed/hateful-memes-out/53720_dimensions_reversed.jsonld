    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_554296f8",
      "@type": "BackgroundKnowledge",
      "instance_name": "forced_religious_indoctrination_stereotype",
      "label": "Stereotype of forced religious indoctrination",
      "description": "The meme relies on the stereotype that religious institutions impose beliefs on children, which is often used in secular or anti-religious discourse to criticize organized religion. This stereotype frames religious upbringing as coercive or unnatural, implying that true belief must be freely chosen, not taught or instilled. The visual of children carrying crosses is used to evoke this stereotype, even though the image may not depict actual religious indoctrination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_83bfe865"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_285fbb55",
      "@type": "BackgroundKnowledge",
      "instance_name": "religion_as_natural_concept",
      "label": "Concept that religion is 'natural'",
      "description": "The meme references the idea that religion is not 'natural' and must be 'taught,' which is a philosophical or sociological stance often held by secular humanists or atheists. This concept is used to argue that religious belief is a learned behavior, not an innate human trait, and thus should be subject to critical examination or education rather than being assumed as inherent or divinely given. This idea is often used to challenge religious authority or promote secular education.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_83bfe865"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a405540a",
      "@type": "BackgroundKnowledge",
      "instance_name": "child_abuse_definition",
      "label": "Definition of child abuse",
      "description": "The meme uses the term 'child abuse' to describe the act of forcing children into religion. This requires background knowledge of legal and social definitions of child abuse, which typically include physical, emotional, sexual, or neglectful harm. The meme implicitly equates religious coercion with these forms of abuse, which is a controversial and contested interpretation in many religious and secular communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_83bfe865"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b3fceb6d",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_religious_discourse",
      "label": "Anti-religious discourse",
      "description": "The meme is part of a broader anti-religious discourse that views religion as a form of control, indoctrination, or social oppression. This discourse often frames religious institutions as authoritarian or harmful, particularly when they involve children. The meme uses the visual metaphor of children carrying crosses to represent this discourse, which is not directly visible in the image but is a common rhetorical device in secular or atheist circles.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_83bfe865"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_192fe166",
      "@type": "BackgroundKnowledge",
      "instance_name": "religious_penitence_stereotype",
      "label": "Stereotype of religious penitence",
      "description": "The image of children carrying crosses evokes the stereotype of religious penitence, particularly associated with Catholic traditions like the Way of the Cross or Holy Week processions. This stereotype is often used to depict religious practice as extreme, self-flagellating, or overly rigid. The meme uses this stereotype to imply that religious upbringing is similarly extreme or harmful, even though the image may not depict actual religious rituals.",
      "belongsToAnalysis": {
