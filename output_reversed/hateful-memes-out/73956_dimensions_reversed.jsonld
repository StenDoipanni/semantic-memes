    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0257562a",
      "@type": "VisualMaterial",
      "instance_name": "woman_on_left",
      "label": "Black woman with dreadlocks",
      "description": "A Black woman with long, reddish-brown dreadlocks, wearing a pink cardigan over a green shirt, holding a beige mug. She is smiling broadly while looking at the other woman, suggesting a moment of shared laughter or conversation. Her presence is central to the image's visual composition and emotional tone.",
