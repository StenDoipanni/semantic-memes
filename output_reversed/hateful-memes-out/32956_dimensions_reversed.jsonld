    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_64df425f",
      "@type": "EmotionExpression",
      "instance_name": "propaganda_emotion",
      "label": "propaganda-driven urgency",
      "description": "The image and text together convey a sense of urgency and mobilization, urging the viewer to take immediate action (join the military) by framing it as a necessary step toward achieving a desirable goal (free college). The visual of disciplined soldiers marching reinforces the message of readiness and collective action, creating an emotional appeal that combines duty with opportunity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1d7d1393"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_42e4a0fd",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Soldiers are mapped as those preparing to march for free college",
      "description": "The text 'we're getting ready to go march for free college' is mapped onto the visual of soldiers marching. The soldiers, as a group in formation, are analogically represented as the 'marching' entity for the purpose of achieving 'free college'. This mapping uses the visual of disciplined military personnel to symbolize the collective action required to obtain free college education, implying that enlisting in the military is the pathway to this goal. The soldiers' readiness and formation visually correspond to the textual concept of 'getting ready to march'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1d7d1393"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5cb50bca",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the invitation to join the military march",
      "description": "The user is projected onto the textual material 'care to join?' which directly addresses the viewer with a rhetorical question, inviting them to participate in the implied action of enlisting in the military for free college. This creates a direct address to the user, making them the potential subject of the action described in the meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1d7d1393"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
