      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cf319f46",
      "@type": "BackgroundKnowledge",
      "instance_name": "military_propaganda",
      "label": "Military Propaganda",
      "description": "The use of media, imagery, or messaging to promote enlistment in the military, often by associating it with desirable outcomes such as education, job security, or national pride. The meme uses the visual of soldiers marching to imply readiness and discipline, which is a common trope in military recruitment propaganda.",
      "belongsToAnalysis": {
