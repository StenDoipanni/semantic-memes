    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_23451bc9",
      "@type": "AnalogicalMapping",
      "instance_name": "weed_man_mapping",
      "label": "The man is mapped as 'the weed man'",
      "description": "The text 'when the weed man' at the top of the image explicitly labels the visual entity (the man) as 'the weed man'. This is an analogical mapping where the textual entity 'weed_man' is projected onto the visual entity 'man'. The term 'weed man' is a slang term for someone who deals or uses marijuana, and in this context, it is used to stereotype the man as a drug dealer, reinforcing a harmful racial trope. The mapping is established through direct textual labeling and contextual juxtaposition.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cd7e6cab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6e5cfc7e",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual material of the man",
      "description": "The user is projected onto the visual material of the elderly Black man in the image. The meme's overall intent and textual content ('when the weed man throw in a little extra') create an implicit identification where the viewer is encouraged to imagine themselves as the 'weed man' or as someone who would react to the scenario described. This projection is not explicit with deictic pronouns like 'you' or 'me', but it is implied through the meme's structure: the viewer is positioned as the recipient of the 'extra' or as the person who is being stereotyped as dishonest or greedy in the context of drug dealing. The visual material (the man) is the focal point onto which the user's identity is projected as the subject of the stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cd7e6cab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5cf3d0c2",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme uses a photo of a Black man, likely intended to be associated with a stereotype of being a 'weed man' (a slang term for someone who deals or uses marijuana), and juxtaposes it with the text 'when the weed man throw in a little extra.' This implies a stereotype that Black people are dishonest or greedy, particularly in the context of drug dealing. The image and text together create a harmful and hateful caricature that reinforces negative racial stereotypes, specifically targeting Black individuals with a derogatory association to criminal behavior and greed. The meme's intent is to demean and stereotype a racial group based on a false and offensive assumption.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cd7e6cab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fab0fb96",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals who are familiar with or perpetuate anti-Black racial stereotypes, particularly those who engage with or enjoy memes that rely on harmful caricatures linking Black people to criminal behavior and greed. This includes audiences who find humor in derogatory racial tropes, such as the 'weed man' stereotype, and who may be exposed to or actively consume content that reinforces these stereotypes. The meme is designed to resonate with those who accept or enjoy the dehumanizing and demeaning portrayal of Black individuals, often rooted in historical racism and systemic bias.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cd7e6cab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
