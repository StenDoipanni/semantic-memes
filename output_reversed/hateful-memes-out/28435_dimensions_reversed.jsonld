      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d3fe5e99",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_stereotype_special_treatment",
      "label": "Antisemitic Stereotype: Jewish people needing special treatment",
      "description": "This stereotype suggests that Jewish people require separate or special accommodations, often implying they are different or problematic enough to warrant exclusion from normal societal structures. The meme's text 'makes special camp spots just for them' reinforces this by implying Jewish children are an 'extra' group needing segregated spaces, which is a form of antisemitic tropes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_88c3a060"
