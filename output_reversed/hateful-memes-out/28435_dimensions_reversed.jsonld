    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6a6682ca",
      "@type": "EmotionExpression",
      "instance_name": "sympathy",
      "label": "sympathetic emotion",
      "description": "The visual material depicts children huddled together, looking at a document with expressions of curiosity or shared focus, which may evoke sympathy from viewers. However, the overlaid text 'they have no where to live' and 'makes special camp spots just for them' manipulates this visual to imply the children are burdensome or problematic, thereby evoking discomfort or pity as a form of emotional manipulation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_88c3a060"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_91c02ac5",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Children are mapped as 'they' who have no where to live",
      "description": "The top text 'they have no where to live' is directly mapped onto the visual entity 'children', implying that the group of young boys depicted are the subjects of this statement. This mapping is explicit through spatial adjacency and contextual juxtaposition, where the text attributes the condition of homelessness to the children in the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_88c3a060"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cb5d1560",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the children as the subject of the hateful message",
      "description": "The user is projected onto the visual material of the children, as the text 'they have no where to live' and 'makes special camp spots just for them' explicitly attributes these conditions to the children depicted. The user is not directly addressed with deictic pronouns like 'you' or 'me', but the entire meme functions as a projection of the user's perspective onto the children as the target of the antisemitic stereotype. The user is implicitly positioned as the one who understands or is conveying this hateful message, thereby projecting themselves onto the children as the 'they' in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_88c3a060"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
