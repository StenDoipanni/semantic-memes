    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_52073b2c",
      "@type": "BackgroundKnowledge",
      "instance_name": "Auschwitz",
      "label": "Auschwitz",
      "description": "Auschwitz was a network of concentration and extermination camps operated by Nazi Germany during World War II. It is the most notorious of these camps and symbolizes the industrialized genocide of the Holocaust. The term is used here to evoke the extreme historical trauma associated with the Holocaust.",
