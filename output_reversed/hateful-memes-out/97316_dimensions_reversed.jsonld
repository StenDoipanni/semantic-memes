    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f4f5fc60",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The cat is mapped as 'everyone else at Auschwitz'",
      "description": "The text 'everyone else at auschwitz:' is juxtaposed with the visual of the cat standing upright. The meme uses the cat as a visual stand-in for 'everyone else at Auschwitz,' creating an analogical mapping where the cat represents the victims or prisoners in the Holocaust context. This mapping is part of the meme's darkly humorous and deeply insensitive intent to trivialize the Holocaust by equating it with a mundane, trivial action (pulling pizza out of an oven).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_593976f4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e76b50ed",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the cat as 'everyone else at Auschwitz'",
      "description": "The user is projected onto the visual material of the cat, which is anthropomorphized and used as a stand-in for 'everyone else at Auschwitz' in the meme's text. The user identifies with the cat's position in the scene, imagining themselves as the one performing the mundane action (pulling pizza out of the oven) while others are suffering in Auschwitz. This projection is implicit, not explicit with deictic pronouns like 'me' or 'you', but is inferred from the meme's structure where the cat represents the user's imagined self in the absurd, darkly humorous scenario.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_593976f4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5e0141e4",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme trivializes the Holocaust by juxtaposing a mundane action (pulling pizza out of an oven) with the horrific context of Auschwitz, reducing the gravity of genocide to a joke. This is deeply insensitive and potentially harmful, as it exploits historical trauma for comedic effect, which can be offensive, triggering, and disrespectful to victims and survivors.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_593976f4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9717ef0d",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "general internet audience",
      "description": "The meme is designed for a broad online audience familiar with internet humor, meme culture, and historical references, particularly those who understand the Holocaust and Auschwitz as significant historical events. The target community includes users who engage with dark humor, shock value, and absurdist juxtapositions, often found in meme communities on platforms like Reddit, Twitter, or imageboards. The meme’s intent to provoke through extreme contrast suggests it targets individuals who appreciate edgy, controversial, or offensive humor, even if it is harmful or insensitive. The use of a cat as a visual metaphor for victims at Auschwitz indicates the meme is likely aimed at an audience that can interpret and process such dark analogies, often found in niche or edgy meme subcultures. The reference to Auschwitz and the Holocaust implies the audience is expected to have some baseline knowledge of WWII history, though the meme’s intent is to exploit that knowledge for shock value rather than education.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_593976f4"
      },
      "extractionMethod": "llm_extraction_huggingface"
