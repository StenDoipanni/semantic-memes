    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_20150903",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Suicide hotline operator mapped onto man in traditional attire",
      "description": "The text 'suicide hotline, how may I help you today sir?' in the first panel establishes the role of the man in traditional attire as the suicide hotline operator. The visual of the man, dressed in culturally specific attire, is mapped onto the textual role of a suicide hotline operator, creating an analogical mapping where the visual entity represents the textual entity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0ba7c00b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0eddce31",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man in traditional attire as the person experiencing suicidal ideation",
      "description": "The user is projected onto the man in traditional attire (man_in_traditional_attire) who is depicted as the person calling the suicide hotline and expressing suicidal ideation. The user identifies with the distressed individual seeking help, imagining themselves in that role. This projection is implicit, as the meme does not use explicit deictic pronouns like 'me' or 'you' directly addressing the user, but the user's engagement with the meme involves identifying with the caller's emotional state and the situation presented.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0ba7c00b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9ddf5648",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme trivializes suicidal ideation by responding to a person in crisis with an absurd joke about flying a plane, which undermines the seriousness of mental health struggles and discourages seeking real help. This is inherently harmful as it normalizes or ridicules genuine emotional and psychological suffering.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0ba7c00b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_01e95bfd",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "general internet audience",
      "description": "The meme is designed for a broad online audience familiar with internet humor, particularly those who understand absurdist or dark comedy. The target community includes individuals who appreciate or are exposed to memes that mock serious topics like mental health crises, often through juxtaposition and irony. The visual of a man in traditional Middle Eastern attire may also appeal to or be understood by audiences familiar with or curious about Middle Eastern culture, though the meme's intent is not to educate or inform about that culture but to use it as a visual framing device for the joke. The meme's toxicity and harmful intent are directed at anyone who might encounter it, regardless of their background, as it trivializes mental health struggles and potentially normalizes harmful behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0ba7c00b"
      },
      "extractionMethod": "llm_extraction_huggingface"
