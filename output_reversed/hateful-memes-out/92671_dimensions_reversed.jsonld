    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e320ca0c",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_appearance_based_evaluation",
      "label": "Anti-Black Stereotype: Appearance-Based Evaluation",
      "description": "The meme relies on the harmful stereotype that Black individuals are often judged or evaluated based on their physical appearance rather than their actual medical condition or needs. This stereotype is rooted in systemic racism and can lead to biased medical care, where Black patients may be perceived as 'improving' based on superficial traits rather than objective clinical metrics. The text 'looking at you your condition is improving' implies this very notion, suggesting the doctor is assessing the patient's 'look' rather than their health status, which is a racially charged and demeaning implication.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_818b3283"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6afda3fc",
      "@type": "BackgroundKnowledge",
      "instance_name": "racism_in_healthcare",
      "label": "Racism in Healthcare",
      "description": "The meme implicitly references the broader social issue of racism within the healthcare system, where racial bias can influence medical decision-making and patient treatment. This includes the potential for implicit bias, where healthcare providers may unconsciously make judgments based on race, leading to disparities in care. The meme's harmful intent lies in normalizing this bias by framing it as a benign or humorous observation, thereby potentially reinforcing systemic racism in medical contexts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_818b3283"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a7eead31",
      "@type": "BackgroundKnowledge",
      "instance_name": "stereotype_of_black_patients_as_superficially_evaluated",
      "label": "Stereotype: Black Patients Are Superficially Evaluated",
      "description": "This stereotype suggests that Black patients are often perceived or evaluated based on how they look — such as their skin tone, facial features, or physical demeanor — rather than their actual medical symptoms or clinical data. This is a form of racial stereotyping that can lead to misdiagnosis, inadequate treatment, or dismissal of legitimate medical concerns. The meme's text directly invokes this stereotype by implying the doctor is assessing the patient's 'look' to determine improvement, which is both inaccurate and demeaning.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_818b3283"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4e2adbe2",
      "@type": "EmotionExpression",
      "instance_name": "racist_implication",
      "label": "racist implication emotion",
      "description": "The emotion expressed is a harmful, racially charged implication that the patient's condition is being judged based on superficial appearance rather than medical metrics. This is conveyed through the text overlay, which suggests the doctor is evaluating the patient's 'look' to determine improvement, invoking a stereotype that reduces Black individuals to physical appearance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_818b3283"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b2c7fd39",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "Doctor's evaluation is mapped onto the patient's appearance",
      "description": "The text 'looking at you your condition is improving' implies that the doctor is assessing the patient's condition based on how they look, rather than objective medical metrics. This creates an analogical mapping where the visual entity 'patient' (specifically, their physical appearance) is being mapped onto the textual concept of 'condition improving' as judged by superficial observation. This mapping reinforces the harmful stereotype that Black patients are evaluated based on appearance rather than medical need.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_818b3283"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_be2b0854",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the patient via the text's deictic reference",
      "description": "The user is projected onto the patient (the Black man in the hospital bed) through the deictic pronoun 'you' in the overlaid text 'looking at you your condition is improving'. This creates a direct semiotic projection where the viewer is positioned as the patient being evaluated based on appearance, reinforcing the harmful stereotype that Black patients are judged superficially. The projection is onto the VisualMaterial entity 'patient' via the TextualMaterial entity 'text_chunk'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_818b3283"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
