    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b1ba81d3",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_haters_to_woman",
      "label": "The text 'haters' is mapped onto the woman in the mirror reflection scene.",
      "description": "The word 'haters' is superimposed above the mirror, which reflects two contrasting portrayals of the woman. The mapping implies that the woman is the subject of the 'haters' stereotype — that is, she is the person who is being criticized or envied by 'haters'. The visual material (the woman in the mirror) is thus mapped onto the textual concept of 'haters' as the target of criticism. This mapping is established through spatial adjacency and contextual contrast: the woman's defiant pose (arms crossed) is juxtaposed with her joyful pose, symbolizing her resilience against the negativity implied by 'haters'. The overall intent of the meme is to portray the woman as unbothered by critics, reinforcing the idea that 'haters' are the critics or envious observers.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_567de58e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b3f80f47",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman in the mirror reflection scene",
      "description": "The user is projected onto the woman depicted in the mirror reflection scene, as the meme invites the viewer to identify with her resilience and self-confidence in the face of 'haters'. The dual portrayal (defiant vs. joyful) and the superimposed text 'haters' create an implicit identification with the woman as the subject who is unbothered by criticism. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the motivational and empowering intent of the meme strongly encourages the viewer to project themselves onto the woman as the confident, unbothered individual.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_567de58e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a0fd25a8",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme uses the term 'haters' to label a group of people who are critical or negative, which can be seen as a generalization and potentially dehumanizing. However, the overall intent is to portray resilience against such critics, not to attack or harm any specific group based on protected characteristics. The term 'haters' is used in a general, non-specific way, and the meme does not target any particular group based on race, gender, religion, or other protected characteristics. The visual content does not contain any abusive, cyberbullying, harmful, or misogynous content. The meme is empowering and motivational, encouraging viewers to ignore critics. Therefore, while the term 'haters' may carry negative connotations, the meme itself does not manifest toxicity in the form of hateful or harmful content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_567de58e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
