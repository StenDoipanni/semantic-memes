    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5e228ff2",
      "@type": "BackgroundKnowledge",
      "instance_name": "Marilyn_Monroe",
      "label": "Marilyn Monroe",
      "description": "Marilyn Monroe was an iconic American actress and model, known for her roles in Hollywood films during the 1950s and 1960s. Her image is often used in memes for its association with glamour, fame, and sometimes as a symbol of pop culture or nostalgia. In this meme, her image is repurposed to deliver an abusive message, which is a form of meme manipulation that leverages her public persona for shock value or intimidation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1c13b72"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_41950095",
      "@type": "BackgroundKnowledge",
      "instance_name": "Felicia",
      "label": "Felicia",
      "description": "Felicia is a name, and in this context, it refers to a specific individual being targeted by the meme. The use of a personal name in a threatening or abusive meme indicates that this is a targeted harassment meme, not a general public meme. The background knowledge required to understand this is that the meme is directed at a real person, and the name 'Felicia' is used to personalize the abuse.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1c13b72"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7a492885",
      "@type": "BackgroundKnowledge",
      "instance_name": "water_truck",
      "label": "Water Truck",
      "description": "A water truck is a vehicle used to transport water, often for emergency, military, or logistical purposes. In this meme, the phrase 'you don't want to miss the water truck' is a euphemism for a threat or warning, implying that the person being targeted is in a desperate situation (possibly metaphorical or literal) and that missing the 'water truck' (a metaphor for help, relief, or escape) will lead to negative consequences. This is a form of coercive language.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1c13b72"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_de4d7555",
      "@type": "BackgroundKnowledge",
      "instance_name": "thirsty_bitch",
      "label": "Thirsty Bitch",
      "description": "The term 'thirsty bitch' is a derogatory slang phrase that combines two elements: 'thirsty' (often implying sexual desire or physical need for water) and 'bitch' (a vulgar term for a woman, often used to demean or insult). This phrase is used to demean the target, implying she is morally or physically deficient, and is a form of misogynistic abuse. The background knowledge required to understand this is the cultural and linguistic context of the term, which is outside the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1c13b72"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_95d5feb2",
      "@type": "BackgroundKnowledge",
      "instance_name": "abusive_meme",
      "label": "Abusive Meme",
      "description": "An abusive meme is a type of internet meme that contains threatening, harassing, or demeaning content directed at a specific individual or group. These memes are often used to intimidate, bully, or harass the target. The background knowledge required to understand this meme is the concept of abusive online behavior and the intent behind such memes, which is not visible in the image but is necessary to interpret the overall intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1c13b72"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a6a472c0",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogyny",
      "label": "Misogyny",
      "description": "Misogyny is the hatred or prejudice against women. The term 'bitch' used in the meme is a misogynistic slur, and the overall tone of the message is demeaning towards the female target. The background knowledge required to understand this is the concept of misogyny and how it manifests in language and social behavior, which is outside the image but necessary to interpret the meme's intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1c13b72"
