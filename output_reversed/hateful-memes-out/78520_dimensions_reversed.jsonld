    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4c7c9bdd",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Felicia is mapped onto Marilyn Monroe",
      "description": "The text 'run along now felicia' directly addresses a person named Felicia, and by juxtaposing her name with the image of Marilyn Monroe, the meme creates an analogical mapping where the visual entity (Marilyn Monroe) is used to represent or stand in for the textual entity (Felicia). This is a common meme technique where the visual subject is projected as the target of the text's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1c13b72"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_41dce873",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_2",
      "label": "The 'thirsty bitch' is mapped onto Marilyn Monroe",
      "description": "The text 'you don't want to miss the water truck.....ya thirsty bitch' uses the visual of Marilyn Monroe to embody the derogatory label 'thirsty bitch'. The image of Marilyn Monroe, who is glamorous and smiling, is contrasted with the demeaning term, creating an analogical mapping where the visual entity (Marilyn Monroe) is mapped onto the textual entity ('thirsty bitch'), implying she is the one being insulted or labeled.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1c13b72"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3446faa0",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual entity addressing Felicia",
      "description": "The user is projected onto the textual material that directly addresses 'Felicia', as the text 'run along now felicia' and 'you don't want to miss the water truck.....ya thirsty bitch' uses 'you' to directly address the target. This creates a direct projection where the user (as the viewer) is positioned as the one who is being addressed or is meant to identify with the target of the abuse. The user is not projected onto the visual material (Marilyn Monroe) or the scene itself, but rather onto the textual material that contains the deictic pronoun 'you' and the personal name 'Felicia'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1c13b72"
      },
