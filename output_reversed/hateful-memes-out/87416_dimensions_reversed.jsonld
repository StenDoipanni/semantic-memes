    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9b3a087a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The group 'us' is mapped onto the armed individuals",
      "description": "The top text 'i was going to make a joke about us' explicitly refers to a group ('us') that the speaker intends to joke about. The visual material, 'armed_individuals', is presented as the target of this joke. The meme's structure implies that 'us' refers to the group depicted — the armed individuals — thereby creating an analogical mapping where the textual entity 'us' is mapped onto the visual entity 'armed_individuals'. This mapping is central to the meme's hateful intent, as it uses the visual representation of armed militants to stereotype and dehumanize the group 'us'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2bd519bc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4d6b7279",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material and visual material through deictic references",
      "description": "The user is projected onto the meme through the deictic pronouns 'us' and 'your face' in the text. The phrase 'i was going to make a joke about us' implies the user is part of the group being referenced ('us'), which is mapped onto the visual material of the armed individuals. The phrase 'they always blow up in your face' projects the user onto the recipient of the violence ('your face'), making the user the implied target of the violence. This creates a dual projection: the user as the speaker/joke-maker ('us') and the user as the victim ('your face').",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2bd519bc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6cf6e2ee",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_2",
      "label": "User projected onto the visual material as the target of violence",
      "description": "The user is projected onto the visual material (armed_individuals) as the target of the violence described in the text. The phrase 'they always blow up in your face' directly implicates the user ('your face') as the recipient of the violence, thereby projecting the user onto the scene where the armed individuals are depicted. The user is not just a passive observer but is positioned as the potential victim of the group's actions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2bd519bc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
