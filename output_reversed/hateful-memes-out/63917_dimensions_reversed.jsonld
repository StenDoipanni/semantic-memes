    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_acb45a62",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogyny_stereotype",
      "label": "Misogynistic Stereotype: Women as Animal-like",
      "description": "The meme relies on the stereotype that women can be reduced to animalistic or 'goat-like' beings, which is a form of objectification and dehumanization. This stereotype is rooted in misogynistic cultural tropes that portray women as sexually available, irrational, or inferior to men, often using animal metaphors to demean them. The phrase 'why's he fucking a goat' implies that the woman is not human but an animal, reinforcing this harmful stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9bf533ef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bb18d5fd",
      "@type": "BackgroundKnowledge",
      "instance_name": "sexual_objectification",
      "label": "Sexual Objectification of Women",
      "description": "The meme uses crude sexual language ('fucking a goat') to objectify the woman being referenced, reducing her to a sexualized, animalistic entity. This reflects broader societal patterns of objectifying women by focusing on their bodies or sexual availability rather than their humanity or agency. The use of 'goat' as a metaphor for a woman is a form of degrading sexualization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9bf533ef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cfa21fb9",
      "@type": "BackgroundKnowledge",
      "instance_name": "infidelity_hypocrisy_stereotype",
      "label": "Stereotype of Hypocrisy in Relationships",
      "description": "The meme implies that if a man is marrying a woman, he should not be engaging in sexual relations with another woman (represented by the goat). This reflects a common, albeit harmful, stereotype that men who are 'married' should be faithful and that infidelity is hypocritical or morally wrong. The meme uses this stereotype to mock or ridicule the man's behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9bf533ef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_139202d8",
      "@type": "BackgroundKnowledge",
      "instance_name": "goat_as_metaphor",
      "label": "Goat as Metaphor for a Woman",
      "description": "The use of 'goat' as a metaphor for a woman is a culturally ingrained trope in some contexts, often used to imply that a woman is 'wild', 'unrefined', or 'animalistic'. This metaphor is not neutral; it carries connotations of degradation and objectification, which are central to the meme's harmful intent. The meme relies on the viewer understanding this metaphor to grasp its crude message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9bf533ef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
