    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c4cc29b4",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Woman is mapped onto the goat",
      "description": "The text 'if he's marrying me then why's he fucking a goat' implies that the woman (the 'me' in the text) is being compared to a goat. The visual material of the goats, particularly the central brown goat looking directly at the camera, is used as a metaphor for the woman. This mapping is central to the meme's harmful intent, as it reduces the woman to an animalistic stereotype, which is a form of objectification and misogyny. The goat_scene serves as the visual context for this metaphorical projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9bf533ef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b3b1ad0b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman referenced in the text",
      "description": "The user is projected onto the 'me' in the text 'if he's marrying me then', which refers to the woman being married. The meme uses the visual of the goats to metaphorically represent this woman, particularly the central brown goat looking at the camera, which is mapped onto the woman. The user sees themselves as the 'me' in the text, and thus is projected onto the woman who is being referenced and metaphorically represented by the goat.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9bf533ef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
