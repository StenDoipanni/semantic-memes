    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f3196c1a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man with vitiligo as a representation of 'Tyrone'",
      "description": "The user is projected onto the visual material of the Black man with vitiligo, who is identified as 'Tyrone' in the text. The meme invites the user to identify with Tyrone's journey — getting a new job, building credit, spending time with kids — and the implied 'amazing' outcome. This projection is implicit, as there are no explicit deictics like 'you' or 'me', but the narrative structure and the framing of Tyrone as a relatable, aspirational figure create a strong identification with the user. The user is projected onto the visual entity 'man' (the Black man with vitiligo) as the embodiment of Tyrone.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_55a85e19"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9eacbba5",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme relies on the visual representation of a Black man with vitiligo, a condition that has historically been used in racist and ableist stereotypes to imply inferiority or 'otherness'. While the text describes positive personal progress, the image of the man with vitiligo is framed within a context that may unintentionally reinforce harmful stereotypes about Black men and their physical appearance. The humor or irony of the meme may depend on the audience recognizing this potential stereotype, which can be harmful by normalizing or trivializing the association between vitiligo and racialized negative connotations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_55a85e19"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_310361c2",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals familiar with and sensitive to racial stereotypes, particularly those involving Black men and vitiligo, who may interpret the meme as ironic or humorous by contrasting positive personal progress with the visual stereotype of a Black man with vitiligo. The meme relies on the audience recognizing the juxtaposition between the positive narrative (Tyrone getting a job, building credit, spending time with kids) and the visual representation of vitiligo, which has historically been used in racist and ableist contexts to imply inferiority or 'otherness'. The humor or irony is contingent on the audience’s awareness of this stereotype, making the target community those who understand this cultural reference and its potential to reinforce harmful associations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_55a85e19"
      },
