    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_51334487",
      "@type": "BackgroundKnowledge",
      "instance_name": "vitiligo_stereotype",
      "label": "Vitiligo as a Stereotype",
      "description": "The image shows a Black man with vitiligo, a skin condition causing depigmentation. In some contexts, vitiligo has been used in racist or ableist stereotypes to imply inferiority, lack of vitality, or 'otherness'. Understanding this meme requires recognizing that vitiligo is not inherently a sign of weakness or abnormality, but has been historically misused in discriminatory ways.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_55a85e19"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f49c5ac7",
      "@type": "BackgroundKnowledge",
      "instance_name": "positive_black_man_stereotype",
      "label": "Positive Black Man Stereotype",
      "description": "The text describes Tyrone as someone who got a new job, built credit, and spent time with his kids — all positive, upwardly mobile behaviors. This contrasts with negative stereotypes that portray Black men as lazy, criminal, or dependent on welfare. The meme relies on the audience recognizing this contrast to create humor or irony, implying that such positive behavior is 'amazing' or unexpected.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_55a85e19"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
