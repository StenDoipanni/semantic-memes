    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_56815e87",
      "@type": "Scene",
      "instance_name": "bully_confrontation",
      "label": "Donald_Trump pointing aggressively",
      "description": "The scene depicts Donald_Trump in a formal suit and red tie, pointing with his right hand in an aggressive manner. His facial expression is confrontational, with an open mouth as if speaking or shouting. The text overlay 'he is proving that grown adults can be a bully' frames the scene as a judgmental portrayal of his behavior as bullying.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f988b201"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b5b782b7",
      "@type": "BackgroundKnowledge",
      "instance_name": "bully_stereotype",
      "label": "Bullying Stereotype",
      "description": "The meme uses the concept of 'bullying' as a moral judgment against Donald Trump. This stereotype is culturally understood as aggressive, intimidating, or coercive behavior typically associated with children or adolescents, but here it is applied to an adult political figure to discredit him. The term 'bully' carries strong negative connotations in public discourse, implying a lack of maturity or ethical behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f988b201"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3c4c69a5",
      "@type": "BackgroundKnowledge",
      "instance_name": "donald_trump_political_figure",
      "label": "Donald Trump as a Political Figure",
      "description": "The meme relies on the public recognition of Donald Trump as a former U.S. President and a highly visible political figure known for his controversial public behavior, rhetoric, and confrontational style. His actions and statements are frequently subject to public scrutiny and moral judgment, making him a suitable subject for memes that label him as a 'bully'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f988b201"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ffbc5e07",
      "@type": "BackgroundKnowledge",
      "instance_name": "adult_behavior_stereotype",
      "label": "Adult Behavior Stereotype",
      "description": "The phrase 'grown adults can be a bully' implies a stereotype that adults, particularly in positions of power, should not exhibit bullying behavior. This is a cultural norm that contrasts with the meme's message, which challenges that norm by suggesting that even adults in power can behave like bullies. This stereotype is used to frame Trump's behavior as deviant or unacceptable.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f988b201"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2c27ec62",
      "@type": "BackgroundKnowledge",
      "instance_name": "political_meme_culture",
      "label": "Political Meme Culture",
      "description": "The meme is part of a broader cultural phenomenon where political figures are frequently depicted and commented on using internet memes. This culture often involves simplifying complex political behavior into easily digestible, often humorous or critical, visual and textual formats. The meme's effectiveness relies on the audience's familiarity with this meme-making tradition.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f988b201"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0a70dd6e",
      "@type": "BackgroundKnowledge",
      "instance_name": "public_figure_reputation",
      "label": "Public Figure Reputation",
      "description": "The meme operates within the context of public opinion and reputation management. It assumes that the public can form judgments about political figures based on their behavior and appearance. The meme's intent to 'prove' Trump is a bully relies on the audience's existing knowledge of his public persona and the cultural narrative surrounding his conduct.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f988b201"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cbf4f03d",
      "@type": "EmotionExpression",
      "instance_name": "aggression",
      "label": "aggressive emotion",
      "description": "The emotion expressed through Donald Trump's confrontational facial expression, open mouth as if shouting, and aggressive pointing gesture with his right hand. This conveys a sense of hostility, intimidation, or dominance, consistent with the meme's labeling of him as a 'bully'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f988b201"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_038de48a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Donald Trump is mapped as a bully",
      "description": "The text overlay 'he is proving that grown adults can be a bully' explicitly labels Donald Trump (the visual entity) as a bully. The visual material of Trump pointing aggressively and shouting is juxtaposed with this text to create an analogical mapping where the textual concept of 'bully' is applied to the visual depiction of Trump. This mapping is central to the meme's intent, which is to discredit Trump by associating him with bullying behavior, a stereotype typically reserved for children or adolescents but here applied to an adult political figure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f988b201"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_48273401",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material labeling Trump as a bully",
      "description": "The user is projected onto the textual material 'he is proving that grown adults can be a bully' because the meme invites the viewer to adopt the judgmental stance expressed in the text, essentially saying 'you are seeing this and agreeing that he is a bully.' The text acts as a direct address to the user's interpretation of the visual material, making the user an active participant in the moral judgment being made. There are no explicit deictic pronouns like 'you' or 'me' in the text, but the framing of the text as a declarative statement that 'he is proving...' implies a shared understanding or agreement from the viewer, projecting the user onto the interpretive act of labeling Trump as a bully.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f988b201"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_978454dd",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme labels Donald Trump as a 'bully' using a confrontational visual and text, which can contribute to a negative public perception of him and potentially incite division or hostility. While not targeting a protected group, it promotes a negative characterization of a public figure, which can influence public opinion and harm his reputation or political standing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f988b201"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f531b691",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "political meme culture",
      "description": "The meme is designed for an audience familiar with internet political meme culture, where public figures are frequently depicted and commented on using simplified, often critical or humorous, visual and textual formats. This audience understands the conventions of meme-making and the use of visual juxtaposition to convey judgmental messages about political behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f988b201"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
