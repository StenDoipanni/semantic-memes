    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a17e1e92",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Black people are mapped onto the woman holding the artifact",
      "description": "The text 'black people' is overlaid directly above the woman's head, visually mapping the textual label 'black people' onto the visual entity 'woman'. This creates an analogical mapping where the woman is being identified or represented as 'black people', despite her visual appearance (light brown hair, etc.). This mapping is central to the meme's hateful message, as it uses the visual of the woman holding the artifact to reinforce the racist trope that Black people are not entitled to cultural artifacts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cb79fdb7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f3d32849",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the racist trope of Black people being denied ownership of cultural artifacts",
      "description": "The user is not explicitly projected onto a specific visual or textual element via deictic pronouns like 'me' or 'you'. However, the meme's hateful intent and the visual-textual mapping create a semiotic projection where the user is implicitly positioned as endorsing or identifying with the racist ideology presented. The user is projected onto the entire hateful message, which is embodied in the visual of the woman holding the artifact and the text 'black people' and 'anything thoat doesn't belong to them'. The projection is onto the scene and textual material that collectively represent the racist trope. The user is not projected onto a specific entity like 'woman' or 'artifact' alone, but onto the hateful narrative constructed by the combination of visual and textual elements.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cb79fdb7"
      },
      "extractionMethod": "llm_extraction_huggingface"
