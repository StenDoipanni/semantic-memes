    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a82677c4",
      "@type": "VisualMaterial",
      "instance_name": "woman",
      "label": "person holding artifact",
      "description": "A woman with light brown hair and dark nail polish is holding an ancient goblet. She is out of focus in the background, suggesting the artifact is the primary subject. Her expression is neutral or serious, and she is wearing small earrings. The text 'black people' is overlaid above her head, and 'anything thoat doesn't belong to them' is overlaid across the artifact, indicating the meme's hateful context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cb79fdb7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
