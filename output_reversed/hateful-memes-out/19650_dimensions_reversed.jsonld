    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1d65f9ac",
      "@type": "BackgroundKnowledge",
      "instance_name": "transatlantic_slave_trade",
      "label": "Transatlantic Slave Trade",
      "description": "The historical system of forced migration of enslaved Africans across the Atlantic Ocean to the Americas between the 16th and 19th centuries. This context is essential to understand the meme's reference to '1600s and you just got here from Africa' and the implied dehumanization of Africans as property ('master looks after us now').",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_86fbf20d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1988c4a5",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_dehumanization",
      "label": "Racial Dehumanization",
      "description": "The process of portraying members of a racial group as less than human, often through animalistic or subhuman metaphors. This is central to understanding the meme's harmful intent, as it equates enslaved Africans with animals (the lion) and frames their subjugation as natural or justified.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_86fbf20d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c07ef9ea",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_primate_comparison",
      "label": "Anti-Black Stereotype: Comparing Black People to Primates",
      "description": "A long-standing racist trope that dehumanizes Black people by likening them to animals, particularly apes or monkeys. This stereotype is directly invoked in the meme by depicting a lion (a big cat, often associated with primates in racist caricatures) being cared for by a 'master', implying enslaved Africans were treated as animals.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_86fbf20d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7be04f8c",
      "@type": "BackgroundKnowledge",
      "instance_name": "slave_owner",
      "label": "Slave Owner",
      "description": "A person who legally owns another human being as property, typically in the context of slavery. The term 'master' in the meme refers to this historical figure, who held absolute power over enslaved people, reinforcing the power dynamic and dehumanization depicted.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_86fbf20d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ee939bfe",
      "@type": "BackgroundKnowledge",
      "instance_name": "enslaved_african",
      "label": "Enslaved African",
      "description": "A person of African descent who was forcibly taken from their homeland and enslaved, typically in the Americas, during the transatlantic slave trade. The meme uses 'us' to refer to this group, implying their status as property and their dependence on the 'master'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_86fbf20d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_86406d95",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_context_1600s",
      "label": "Historical Context: 1600s",
      "description": "The 17th century, specifically the 1600s, was a period of intense European colonial expansion and the height of the transatlantic slave trade. Understanding this era is necessary to interpret the meme's premise of arriving 'from Africa' in this timeframe.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_86fbf20d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6b80a489",
      "@type": "EmotionExpression",
      "instance_name": "dehumanization",
      "label": "dehumanizing emotion",
      "description": "The emotion expressed is one of dehumanization, where the enslaved African is portrayed as an animal (lion) being cared for by a 'master', reducing human beings to the status of property. This is conveyed through the visual of the lion being fed and the text that frames the enslaved person's experience as one of subjugation and objectification.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_86fbf20d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_528f2b39",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Enslaved African mapped onto the lion",
      "description": "The top text 'when it's the 1600s and you just got here from africa' establishes the historical context of an enslaved African person arriving in the Americas. The visual of the lion being cared for by a 'master' is used as an analogical representation of this enslaved person's status as property. The lion, an animal, is mapped onto the enslaved African to convey the dehumanizing stereotype that enslaved Africans were treated as animals or property. The bottom text 'master looks after us now' reinforces this mapping by identifying the person as the 'master' and the lion (as the enslaved African) as 'us'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_86fbf20d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1d0960cf",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the enslaved African (lion)",
      "description": "The user is projected onto the 'us' in the bottom text, which refers to the enslaved African person being depicted as the lion. The meme uses the visual of the lion being cared for by a 'master' to represent the historical experience of enslaved Africans. The user sees themselves as the 'us' in this dehumanizing scenario, identifying with the enslaved person's position of subjugation and dependence on the 'master'. This projection is implicit through the use of 'us' and the visual mapping of the enslaved African onto the lion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_86fbf20d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8e1071f8",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme depicts a person interacting with a lion, with text that reads 'when it's the 1600s and you just got here from Africa' and 'master looks after us now.' This juxtaposition maps the historical context of the transatlantic slave trade onto the visual of a lion being cared for by a human, implying that enslaved Africans were treated as animals or property. The use of 'master' and 'us' reinforces a dehumanizing narrative, portraying enslaved people as subordinate to their captors. This is a harmful and hateful stereotype that reduces human beings to the status of animals, which is a form of racial dehumanization rooted in anti-Black racism. The overall intent is hateful as it directly attacks and dehumanizes a specific racial group based on their historical experience of enslavement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_86fbf20d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6c9f5bf0",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed for an audience familiar with or interested in historical racial stereotypes, particularly those related to the transatlantic slave trade and anti-Black racism. The target community likely includes individuals who may be unaware of the harmful implications of equating enslaved Africans with animals, or who may be seeking to provoke or reinforce racist narratives through historical analogies. The meme's use of 'master' and 'us' implies an audience that understands the power dynamics of slavery and may be engaging with the content in a way that perpetuates racial dehumanization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_86fbf20d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
