    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_388e9714",
      "@type": "AnalogicalMapping",
      "instance_name": "tomato_classification_mapping",
      "label": "tomatoes are mapped as both fruit and vegetable",
      "description": "The text 'proof you can be a fruit and a vegetable' is directly mapped onto the visual entity 'tomatoes'. The meme uses the tomatoes as the visual representation of the concept being explained — that is, tomatoes are both a fruit (botanically) and a vegetable (culinary). The juxtaposition of the text with the image creates an analogical mapping where the tomatoes are the entity being described by the text. This mapping is educational, clarifying a common point of confusion in food classification.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_83944b3b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ec3fc8ea",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the tomatoes as the subject of the educational claim",
      "description": "The user is not explicitly projected onto any deictic pronoun like 'you' or 'me'. However, the meme implicitly projects the user onto the tomatoes as the entity being described — the tomatoes are the subject of the claim 'proof you can be a fruit and a vegetable'. The user is invited to identify with the tomatoes as the example of something that can simultaneously be both a fruit and a vegetable, making the tomatoes the projected entity. The user is not projected onto the text itself, but onto the visual material (tomatoes) which the text is describing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_83944b3b"
      },
