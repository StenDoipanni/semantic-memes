    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5c774f14",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "human interaction is replaced by animal companion",
      "description": "The text 'who needs a human interaction' is mapped onto the visual scene of a couple in bed, implying that the human companionship shown is unnecessary because one has a 'loyal animal companion'. The visual material (the couple) is being mapped as the entity that 'needs' human interaction, which is then contrasted with the idea of having a pet.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3b53176"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8374065d",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_2",
      "label": "the scenario of having a pet is presented as a substitute for human interaction",
      "description": "The text 'when you've got a loyal animal companion' is mapped onto the visual material of the couple in bed, suggesting that the presence of a pet (implied by the text) is sufficient to fulfill the emotional needs that human interaction would otherwise provide. The visual scene of the couple is used to represent the context in which this substitution is being proposed.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3b53176"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0d37289a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scenario of having a pet as a substitute for human interaction",
      "description": "The user is implicitly projected onto the meme's message, which suggests that one does not need human interaction because they have a loyal animal companion. The text 'who needs a human interaction' and 'got a loyal animal companion' frames the scenario as something the user might identify with, even though no explicit 'you' or 'me' is present. The user is projected onto the idea that pet companionship fulfills emotional needs, which is the core message of the meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3b53176"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
