    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_405d880f",
      "@type": "BackgroundKnowledge",
      "instance_name": "pet_companionship_stereotype",
      "label": "Pet companionship as a substitute for human relationships",
      "description": "The meme relies on the cultural stereotype that pets can fulfill emotional and social needs that humans might otherwise seek from other people. This is a common trope in popular culture, often used to portray pets as loyal, comforting, and emotionally supportive companions, sometimes even replacing human interaction. The meme implies that having a pet is sufficient for emotional fulfillment, which is a simplification of human emotional needs and relationships.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3b53176"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_92eb642f",
      "@type": "BackgroundKnowledge",
      "instance_name": "human_companionship_stereotype",
      "label": "Human companionship as essential for emotional well-being",
      "description": "The meme contrasts the idea of human interaction with pet companionship, implying that human relationships are less necessary or less valuable. This is a cultural assumption that human emotional needs are best met through interpersonal relationships, and that pets, while affectionate, cannot fully replace the complexity of human connection. The meme's framing suggests that human companionship is optional or unnecessary if one has a pet.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3b53176"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0fc7fba0",
      "@type": "BackgroundKnowledge",
      "instance_name": "animal_companionship_cultural_tropes",
      "label": "Cultural tropes about animal companionship",
      "description": "The meme draws on widespread cultural tropes that portray pets as loyal, comforting, and emotionally supportive. These tropes are often used in advertising, media, and popular culture to promote pet ownership as a solution to loneliness or emotional distress. The meme uses this trope to suggest that pets are a sufficient substitute for human interaction, which is a simplification of human emotional needs.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3b53176"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1f33f241",
      "@type": "BackgroundKnowledge",
      "instance_name": "emotional_needs_simplification",
      "label": "Simplification of human emotional needs",
      "description": "The meme promotes the idea that human emotional needs can be met by pets, which is a simplification of the complex nature of human emotional needs. Human relationships involve mutual understanding, shared experiences, and emotional reciprocity that pets cannot provide. The meme's message implies that human companionship is less important or unnecessary, which is a potentially harmful oversimplification.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3b53176"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
