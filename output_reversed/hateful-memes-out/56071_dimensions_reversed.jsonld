    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5e6078a4",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'when you can smell shit' is mapped onto the visual scene of prayer",
      "description": "The text overlay 'when you can smell shit' is juxtaposed with the visual of a man in prayer, creating an analogical mapping where the unpleasant sensory experience (smelling shit) is projected onto the context of religious practice. This implies that the act of prayer is associated with an unclean or foul odor, which is a stereotype used to mock religious devotion. The mapping is established through the spatial and contextual relationship between the text and the visual material, where the text describes a condition that is humorously attributed to the scene depicted.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5a792bd6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9d017fb5",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material describing a bodily sensory experience",
      "description": "The user is projected onto the textual material 'when you can smell shit but you're not sure if it's his arse or your hands' because the text uses second-person perspective ('you') to create an immersive, personal experience. The user is invited to imagine themselves in the situation described, experiencing the ambiguity and discomfort of the smell, thereby projecting themselves onto the text. This projection is reinforced by the visual scene of prayer, which provides context for the text's implied scenario.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5a792bd6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
