    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_16eb39f6",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_stereotype",
      "label": "Misogynous Stereotype: 'Women Belong in the Kitchen'",
      "description": "This stereotype implies that women are confined to domestic roles and are not seen as equal participants in decision-making or perspective-sharing. It is a common trope in misogynistic humor and is used here to imply that the man is dismissing the woman's viewpoint by focusing on domestic tasks, while the child (symbolizing the woman) looks out the window, metaphorically ignoring her perspective.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7b6db421"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_872b8845",
      "@type": "BackgroundKnowledge",
      "instance_name": "domestic_role_stereotype",
      "label": "Domestic Role Stereotype",
      "description": "The stereotype that women are primarily responsible for household chores and domestic duties, often leading to their exclusion from other spheres of life or decision-making. This is reinforced by the image of the child (representing the woman) being relegated to the kitchen and looking out the window, symbolizing exclusion from the main activity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7b6db421"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dc92908b",
      "@type": "BackgroundKnowledge",
      "instance_name": "ignoring_perspective",
      "label": "Ignoring Perspective",
      "description": "The concept that one person is deliberately or unconsciously disregarding another's viewpoint or emotional state. This is the core of the meme's message, where the man is metaphorically 'looking out the window' (i.e., ignoring) the woman's request to see things from her point of view.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7b6db421"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_05df18dc",
      "@type": "BackgroundKnowledge",
      "instance_name": "kitchen_as_domestic_space",
      "label": "Kitchen as Domestic Space",
      "description": "The kitchen is culturally and symbolically associated with domesticity, cooking, and caregiving roles, often stereotypically assigned to women. The meme uses this association to reinforce the idea that the woman's perspective is being dismissed because she is in the 'domestic' space, while the man is engaged in 'public' or 'active' tasks.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7b6db421"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5ae8356d",
      "@type": "BackgroundKnowledge",
      "instance_name": "metaphorical_window",
      "label": "Metaphorical Window",
      "description": "The window is used metaphorically to represent a point of view or perspective. Looking out the window implies detachment, distraction, or a failure to engage with the immediate situation or the person speaking. In this context, it symbolizes the man's refusal to engage with the woman's perspective.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7b6db421"
      },
