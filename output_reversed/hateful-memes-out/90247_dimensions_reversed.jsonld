    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_36e665b5",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_slur_nigger",
      "label": "racial slur 'nigger'",
      "description": "The term 'nigger' is a historically and currently offensive racial slur targeting Black individuals. Its use in the meme is a direct and hateful attack, rooted in centuries of racial oppression and dehumanization in the United States and other countries. Understanding the meme requires knowledge of this slur's violent history and its function as a weapon of racial hatred.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c075a370"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f0bfef13",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_racial_stereotype",
      "label": "anti-Black racial stereotype",
      "description": "The meme invokes a racial stereotype by using the slur 'nigger' to demean Black people. This stereotype is part of a broader historical pattern of dehumanizing Black individuals, often portraying them as inferior, dangerous, or hypersexualized. The juxtaposition of the phrase 'long time no see' with the slur implies a reductive and hateful view of Black people as objects of ridicule or contempt.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c075a370"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_87e93ea5",
      "@type": "BackgroundKnowledge",
      "instance_name": "hateful_meme_context",
      "label": "hateful meme context",
      "description": "The meme's context is defined by its use of racial slurs and its intent to demean based on race. This requires background knowledge of how such memes function in online culture to spread hate, reinforce systemic racism, and target marginalized communities. The phrase 'long time no see' is typically used as a benign greeting, but its pairing with the slur creates a jarring and offensive contrast that is only meaningful to those familiar with the history of racial slurs and their impact.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c075a370"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0cdee407",
      "@type": "EmotionExpression",
      "instance_name": "hate",
      "label": "hateful emotion",
      "description": "The emotion expressed is hatred, conveyed through the use of the racial slur 'nigger' and the hateful intent of the meme. The juxtaposition of the seemingly benign phrase 'long time no see' with the slur creates a toxic and offensive message designed to demean and insult based on race.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c075a370"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e1edf0cd",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_long_time_no_see_to_man",
      "label": "The phrase 'long time no see' is mapped onto the man in cowboy attire.",
      "description": "The text 'long time no see' at the top of the image is juxtaposed with the visual of the man standing in front of the wagon. This creates an analogical mapping where the man is implicitly identified as the subject of the greeting 'long time no see'. The phrase implies a reconnection or reunion, but in this hateful context, it is used to frame the man as someone who has been 'seen' or 'reconnected' with in a derogatory manner, setting up the subsequent racial slur. The mapping is spatial and contextual: the text is positioned above the man, directly addressing him as the referent of the phrase.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c075a370"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_60496d75",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man in cowboy attire",
      "description": "The user is projected onto the visual material of the man standing in front of the wagon. The phrase 'long time no see' at the top of the image is implicitly directed at the man, creating a deictic projection where the user sees themselves as the one who has 'seen' or is reconnecting with the man. This projection is reinforced by the hateful context of the racial slur 'nigger' at the bottom, which frames the man as the target of the user's hateful intent. The user is not explicitly addressed with 'you' or 'me', but the spatial and textual framing (text above the man, slur below) creates an implicit projection of the user as the one initiating the 'long time no see' greeting and as the one who is projecting the hateful slur onto the man.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c075a370"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9511b98f",
