      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e498d843",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The target community is individuals who are familiar with the historical and offensive use of the racial slur 'nigger' and who may find the meme's juxtaposition of 'long time no see' with the slur to be provocative or humorous in a hateful context. This includes users of online platforms where such memes circulate, particularly those who engage with or are exposed to racially charged content, often within communities that normalize or perpetuate anti-Black racism. The meme is designed to target and demean Black individuals and communities by invoking a deeply offensive racial stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c075a370"
