      "description": "white text overlay at the top of the image reading: 'when you and ya partner think'",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a46381b1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_93f1bc51",
