    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d473f84a",
      "@type": "Scene",
      "instance_name": "newborn_survival_scene",
      "label": "Newborn baby narrowly escaped harm",
      "description": "A sleeping newborn baby, wrapped in a light blue blanket and wearing a matching light blue hat, lies on a gray textured surface. The text overlay reads 'i made it out alive' and 'the democrats didn't get me,' implying the baby narrowly escaped a dangerous or lethal outcome attributed to 'the democrats.' The scene uses the visual of vulnerability (the baby) to convey a hateful political message.",
      "belongsToAnalysis": {
