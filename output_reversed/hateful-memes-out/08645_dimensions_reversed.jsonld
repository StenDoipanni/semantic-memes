    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_547d13f1",
      "@type": "BackgroundKnowledge",
      "instance_name": "John_Malkovich",
      "label": "Actor John Malkovich",
      "description": "John Malkovich is a well-known American actor recognized for his distinctive appearance, including his gray hair and mustache, and his roles in films that often explore complex, intellectual, or artistic themes. His image is used in the meme to represent a figure associated with sophistication or cultural authority, creating a contrast with the religious scene below. This contrast is central to the meme’s intent, as Malkovich’s persona is juxtaposed with the depiction of religious practice as burdensome or coercive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a5d3d698"
