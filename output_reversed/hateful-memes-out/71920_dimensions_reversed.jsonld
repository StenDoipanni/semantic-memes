    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_249b1fba",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: where_is_the_black_guy; hasOverallIntent: Hateful; overall-intent-description: The image depicts a police officer aiming a gun, with text asking 'where is the black guy?'. This meme is a direct and racially charged reference to the historical and ongoing stereotype that Black people are disproportionately associated with criminal behavior. The juxtaposition of the armed officer with the question implies a racialized assumption that Black individuals are the perpetrators of crime, thereby perpetuating harmful racial stereotypes and implicitly suggesting that Black people are inherently dangerous or criminal. This is a hateful meme that targets Black individuals based on race, reinforcing systemic racism and prejudice.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8cb4c09d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
