    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_272ea97c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'where is the black guy?' maps onto the visual of the police officer",
      "description": "The textual question 'where is the black guy?' is juxtaposed with the visual of a police officer aiming a gun, creating an analogical mapping where the absence of a Black person is implied to be significant and racially charged. The officer's presence and action are mapped onto the textual query, suggesting that the Black person is the expected or feared subject of the officer's attention, reinforcing the stereotype that Black individuals are inherently dangerous or criminal. This mapping is central to the meme's hateful intent and racialized hostility.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8cb4c09d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_25a8e4d5",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the police officer aiming the gun",
      "description": "The user is projected onto the visual of the police officer aiming the gun, as the officer's direct gaze and the confrontational pose create an implicit address to the viewer. The user is positioned as the target or subject of the officer's attention, reinforcing the meme's racialized hostility and the assumption that the user (or the viewer) is expected to be aware of or responsible for the 'missing' Black person. This projection is implicit through the officer's direct gaze and the accusatory tone of the text, which frames the viewer as part of the context where the absence of a Black person is significant.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8cb4c09d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
