    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6382e336",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Hillary Clinton is mapped as 'caught telling the truth'",
      "description": "The text 'hillary clinton caught telling the truth!' is overlaid on the image of Hillary Clinton, creating an analogical mapping where the visual entity (Hillary Clinton) is being identified or characterized by the textual entity. The text implies that she is being 'caught' in the act of telling the truth, which is then humorously juxtaposed with her confident, smiling expression at a campaign rally. This mapping relies on the audience recognizing her as the subject of the text and interpreting the visual context (campaign rally) as a setting where such a 'catch' would be ironic or absurd, especially given the 'april fools!' tag.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2be88f4a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5f84bd5b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material indicating the joke's nature",
      "description": "The user is projected onto the text 'april fools!' which explicitly frames the entire meme as a joke. This text serves as a deictic marker that the user, as the audience, is meant to recognize and internalize the humorous, satirical context of the image. The projection is onto the textual material, which clarifies the intent and prevents the image from being misinterpreted as a serious accusation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2be88f4a"
      },
