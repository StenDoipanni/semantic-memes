    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4a3f5eeb",
      "@type": "EmotionExpression",
      "instance_name": "mocking_humor",
      "label": "mocking and dismissive humor",
      "description": "The emotion expressed is a mocking and dismissive tone, conveyed through the juxtaposition of Gene Wilder's cheerful, innocent expression with the sarcastic text overlay that ridicules people who are 'triggered' and calls them 'special snowflakes'. The humor is intended to belittle and invalidate emotional sensitivity.",
      "belongsToAnalysis": {
