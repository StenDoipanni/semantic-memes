    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_957aee2a",
      "@type": "BackgroundKnowledge",
      "instance_name": "triggered",
      "label": "The term 'triggered'",
      "description": "A psychological and social term referring to a state of emotional or psychological distress caused by exposure to a stimulus that is associated with a traumatic or distressing experience. In contemporary internet culture, it is often used to describe someone who feels emotionally overwhelmed or offended by certain topics, especially in discussions about social justice, politics, or identity. The term is not visible in the image but is central to the meme's text overlay.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e637be5e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e11d38f6",
      "@type": "BackgroundKnowledge",
      "instance_name": "special_snowflake",
      "label": "The derogatory term 'special snowflake'",
      "description": "A pejorative metaphor used to describe someone who is perceived as overly sensitive, fragile, or easily offended, often implying that their emotional reactions are exaggerated or unwarranted. It is used to dismiss or mock individuals who advocate for emotional safety or social awareness. This term is not visible in the image but is central to the meme's second text overlay.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e637be5e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bdc987a7",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism",
      "label": "Ableism",
      "description": "A form of discrimination or prejudice against people with disabilities, often manifesting as the belief that people with disabilities are less capable, less intelligent, or less worthy. The meme uses the term 'special snowflake' to mock people who are sensitive or emotionally reactive, which can be interpreted as a form of ableism by implying that their sensitivity is a flaw or weakness, rather than a legitimate human experience. This concept is not visible in the image but is implied by the meme's intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e637be5e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ccf9bdcb",
      "@type": "BackgroundKnowledge",
      "instance_name": "Gene_Wilder",
      "label": "Gene Wilder",
      "description": "An American actor and comedian, best known for his roles in films such as 'Willy Wonka & the Chocolate Factory' and 'The Producers'. He is a cultural icon associated with humor and charm. His image is used in the meme to create a contrast between his cheerful demeanor and the mocking text, which is a common meme technique. This knowledge is not visible in the image but is required to understand the meme's context and intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e637be5e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_99bb10bb",
      "@type": "BackgroundKnowledge",
      "instance_name": "book_signing_scene",
      "label": "Book signing scene",
      "description": "A common promotional event where authors sign copies of their books for fans. The scene in the image is a book signing, which is a public event that often involves the author interacting with fans. The context of a book signing is not directly visible in the image but is implied by the activity (signing a book) and the posters in the background. This knowledge is required to understand the setting and the nature of the interaction.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e637be5e"
