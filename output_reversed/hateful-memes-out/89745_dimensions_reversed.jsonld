    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3204c253",
      "@type": "EmotionExpression",
      "instance_name": "hateful_anger",
      "label": "hateful anger expressed through violent rhetoric",
      "description": "The emotion is conveyed through the extreme and violent quote 'i want every gun we have to fire on that man,' which expresses a hateful, aggressive, and murderous intent toward an unarmed Black youth. This emotion is not visually depicted on the officers' faces but is powerfully communicated through the text, which frames the officers' actions as justified by a racist and violent worldview.",
