    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d35880c5",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'when cops see an unarmed black youth:' is mapped onto the visual depiction of the two police officers.",
      "description": "The textual phrase 'when cops see an unarmed black youth:' directly refers to the visual entities (the police officers) as the agents performing the action described. The officers are visually depicted as the 'cops' who are 'seeing' (implied by their pointing and attention) an unseen target, which is mapped to the 'unarmed black youth' mentioned in the text. This creates an analogical mapping where the officers are the 'cops' in the scenario described by the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1a9e8813"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f7200cdc",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material describing the scenario",
      "description": "The user is projected onto the textual material 'when cops see an unarmed black youth:' because the meme invites the viewer to imagine themselves as the observer of the scenario described — the 'cops' in the visual are the agents performing the action, and the text sets up a hypothetical situation that the user is expected to mentally inhabit. The user is not explicitly addressed with 'you' or 'me', but the framing of the meme (the visual of officers pointing, the loaded text, and the extreme quote) creates an implicit projection where the user is positioned as the one witnessing or interpreting the scenario, thereby internalizing the stereotype and the violent implication. This projection is onto the textual material that defines the scenario.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1a9e8813"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7be723b9",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme explicitly promotes a hateful and racist worldview by depicting police officers as wanting to kill an unarmed Black youth, leveraging harmful stereotypes that associate Black people with criminality and violence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1a9e8813"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6b2dded0",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who are aware of, or sympathetic to, narratives of systemic racism and police brutality against Black communities in the United States. The meme is designed to resonate with those who recognize the harmful stereotype of Black youth as inherently dangerous, and who are critical of racial profiling and excessive use of force by law enforcement. It leverages cultural references to real-world incidents involving unarmed Black individuals and police violence, appealing to an audience that understands the historical and contemporary context of anti-Black racism in policing. The meme’s toxicity and hateful intent are directed at the broader public, but its primary impact and intended audience are those who are already engaged with or affected by these issues, including activists, educators, and community members involved in movements against racial injustice.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1a9e8813"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
