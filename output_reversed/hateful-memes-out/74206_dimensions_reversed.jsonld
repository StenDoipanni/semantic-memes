  "dimensions": [
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a6b93c26",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: meme_image; hasOverallIntent: Harmful; overall-intent-description: The meme juxtaposes the classic 'evolution of man' image with a pig, implying that if people don't change their diet, they will evolve into pigs. This is a harmful and degrading metaphor that uses animal imagery to insult human behavior and dietary choices. While not targeting a specific protected group like race, religion, or gender, it employs a crude and demeaning analogy that can be offensive and potentially harmful by reducing human dignity to a vulgar animal comparison. The intent is to shock and provoke a reaction by using a crude visual metaphor to criticize unhealthy eating habits, but the method is inherently demeaning and could be seen as promoting a negative stereotype about human nature or dietary choices.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac97477d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5863a717",
      "@type": "TextualMaterial",
      "instance_name": "top_text",
      "label": "text location",
      "description": "this is what we will evolve into",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac97477d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6e1998b1",
      "@type": "VisualMaterial",
      "instance_name": "evolution_of_man_sequence",
      "label": "graphic depicting human evolution",
      "description": "A stylized graphic showing a sequence of five figures representing stages of human evolution, starting from an ape-like creature and progressing to a modern human, walking from left to right. This is a parody of the classic 'March of Progress' illustration. The figures are depicted in a simplified, cartoonish style with a neutral background and reflective ground.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac97477d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4da5211d",
      "@type": "Scene",
      "instance_name": "evolution_juxtaposition_scene",
      "label": "juxtaposition_of_human_evolution_and_pig",
      "description": "The scene presents a visual contrast between the 'evolution of man' graphic and a pig, with text overlaying both images to create a satirical and derogatory message about dietary habits. The top half shows the human evolution sequence, while the bottom half features a pig in a field, symbolizing the meme's claim that humans will evolve into pigs if they don't change their diet.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac97477d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1e2c45e8",
      "@type": "BackgroundKnowledge",
      "instance_name": "pig_as_animal_stereotype",
      "label": "Pig as a derogatory animal stereotype",
      "description": "The meme uses the pig as a symbol of lowliness, gluttony, and moral degradation. In Western culture, pigs are often used in derogatory metaphors to describe people who are considered morally corrupt, lazy, or lacking in self-control — especially in relation to eating habits. This stereotype is not visible in the image but is essential to understanding the meme’s message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac97477d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_04b27190",
      "@type": "BackgroundKnowledge",
      "instance_name": "human_evolution_meme_parody",
      "label": "Parody of the 'March of Progress' evolution graphic",
      "description": "The top image is a well-known parody of the 'March of Progress' illustration, which depicts human evolution from ape-like ancestors to modern humans. This specific version is often used in memes to imply a linear, inevitable progression — here, twisted to suggest a degenerative path toward pigs. The meme relies on the viewer’s familiarity with this visual trope to convey its satirical message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac97477d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7ea72a9a",
      "@type": "BackgroundKnowledge",
      "instance_name": "dietary_choice_stereotype",
      "label": "Stereotype linking poor diet to moral decay",
      "description": "The meme implies that poor dietary choices (e.g., eating unhealthy, processed, or excessive amounts of food) lead to moral and physical degeneration. This is a common cultural trope that equates physical appearance or health with moral character — a stereotype that is not visible in the image but is necessary to interpret the meme’s message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac97477d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f0907f7f",
      "@type": "BackgroundKnowledge",
      "instance_name": "degrading_metaphor",
      "label": "Degrading metaphor of human evolution into animals",
      "description": "The meme employs a degrading metaphor by suggesting that humans will evolve into pigs if they don’t change their diet. This metaphor is inherently demeaning and relies on the viewer’s understanding of animal imagery as a symbol of moral and intellectual inferiority — a concept rooted in historical and cultural biases.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac97477d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_58454947",
      "@type": "BackgroundKnowledge",
      "instance_name": "food_stereotype",
      "label": "Food stereotypes associated with pigs",
      "description": "Pigs are culturally associated with foods like bacon, pork, and fatty, indulgent meals — foods often criticized for being unhealthy or excessive. The meme implicitly references this association to link the pig to gluttony and poor dietary habits, which is not directly visible in the image but is essential to the meme’s message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac97477d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7a5dae29",
      "@type": "EmotionExpression",
      "instance_name": "degrading_contempt",
      "label": "contemptuous emotion toward dietary choices",
      "description": "The meme expresses contempt by using a degrading metaphor — suggesting that humans will evolve into pigs if they don't change their diet — which reduces human dignity to a vulgar animal comparison. This is conveyed through the juxtaposition of the 'evolution of man' graphic with a pig and the accompanying text, which together create a mocking and morally judgmental tone.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac97477d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4b2aa59c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Human evolution sequence mapped to the future state of humans",
      "description": "The top text 'this is what we will evolve into' is mapped onto the 'evolution_of_man_sequence' visual, implying that the sequence represents the future evolutionary state of humans as described by the text. The visual material (the sequence) is being used to represent the textual concept (what humans will evolve into).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac97477d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1d0d75d8",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the pig as a symbol of moral decay",
      "description": "The user is implicitly projected onto the pig in the bottom half of the meme, which serves as the target of the meme's degrading metaphor. The text 'if we don't start watching what we eat' directly addresses the viewer ('we'), implying that the user's own dietary choices are being judged and that they are at risk of becoming like the pig. The pig is the visual embodiment of the consequence described, and the user is projected onto this entity as the potential future state if they fail to change their behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac97477d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_80d0c684",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme uses a degrading metaphor suggesting humans will evolve into pigs if they don't change their diet, which reduces human dignity to a vulgar animal comparison and can be offensive and potentially harmful by promoting a negative stereotype about human nature or dietary choices.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ac97477d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
