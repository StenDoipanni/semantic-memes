    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2ac999b3",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism_stereotype",
      "label": "Developmental disability infantilization",
      "description": "The meme uses a casual, colloquial greeting ('ay man, how ya been?') in conjunction with the visible disabilities of the subjects, which can imply that people with Down syndrome are 'simple' or 'childlike' and thus not worthy of complex social interactions or serious engagement. This reinforces the harmful stereotype that individuals with developmental disabilities are incapable of engaging in normal social discourse.",
      "belongsToAnalysis": {
