    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a7c71a73",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Textual greeting mapped onto visual subjects",
      "description": "The text 'ay man, how ya been?' is overlaid on the image of a man and woman with Down syndrome. The casual, colloquial greeting implies a simplistic or childlike social interaction, which is mapped onto the visual subjects, suggesting they are being addressed as if they are 'simple' or 'childlike' individuals. This creates an analogical mapping where the text's implied social role is projected onto the visual subjects, reinforcing the stereotype of developmental disability infantilization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7c83a4d4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0d014f41",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual greeting",
      "description": "The user is projected onto the text 'ay man, how ya been?' which is overlaid on the image. The casual, colloquial greeting implies a direct address to the viewer, creating a sense of personal interaction. The user is positioned as the one initiating the greeting, projecting themselves onto the text as the speaker. This projection is reinforced by the visual subjects (man and woman with Down syndrome) being depicted as recipients of this greeting, which aligns with the meme's overall intent to normalize or trivialize their condition by reducing their identities to a simple, stereotypical social interaction.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7c83a4d4"
      },
      "extractionMethod": "llm_extraction_huggingface"
