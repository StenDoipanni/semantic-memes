      "@id": "http://example.org/multimodal-taxonomy#dimension_35739e95",
      "@type": "BackgroundKnowledge",
      "instance_name": "world_war_two",
      "label": "World War II",
      "description": "A global military conflict that lasted from 1939 to 1945, initiated by Nazi Germany's invasion of Poland. It resulted in unprecedented destruction, loss of life, and the Holocaust, making it one of the most catastrophic events in human history. The meme equates the act of 'committing crimes against the polish' with starting WW2, which is a gross trivialization of the event and its immense human cost.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ef3e9954"
      },
      "extractionMethod": "llm_extraction_huggingface"
