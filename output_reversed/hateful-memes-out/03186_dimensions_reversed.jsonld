    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_05ca0c95",
      "@type": "BackgroundKnowledge",
      "instance_name": "beauty_industry_stereotype",
      "label": "Beauty Industry Stereotype",
      "description": "The stereotype that beauty and personal care are trivial or superficial, often used to dismiss their importance. The meme plays on this by contrasting the mundane act of removing nail polish with the catastrophic consequences of WWII, implying that beauty is so trivial that its 'crime' is equivalent to global war.",
      "belongsToAnalysis": {
