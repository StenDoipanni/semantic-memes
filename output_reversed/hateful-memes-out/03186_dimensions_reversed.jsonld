    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c26f2260",
      "@type": "BackgroundKnowledge",
      "instance_name": "adolf_hitler",
      "label": "Adolf Hitler",
      "description": "The dictator of Nazi Germany from 1933 until his death in 1945. He was the primary architect of World War II and the Holocaust, responsible for the systematic murder of six million Jews and millions of others. His image is used in the meme to represent the extreme gravity of 'committing crimes against the polish', creating a jarring and offensive comparison.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ef3e9954"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_48f77293",
      "@type": "BackgroundKnowledge",
      "instance_name": "holocaust_minimization",
      "label": "Holocaust Minimization",
      "description": "The act of downplaying, trivializing, or making jokes about the Holocaust, the genocide of six million Jews by Nazi Germany. This meme is a clear example of this, as it equates the Holocaust with a mundane act of removing nail polish, which is deeply offensive and disrespectful to victims and survivors.",
      "belongsToAnalysis": {
