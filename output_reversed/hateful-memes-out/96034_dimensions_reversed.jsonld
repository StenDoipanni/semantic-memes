    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c042d4bf",
      "@type": "Scene",
      "instance_name": "movie_theater_audience",
      "label": "Audience in a movie theater",
      "description": "A scene depicting a group of people seated in a dark movie theater, watching a film. The central focus is a bald man in the foreground holding popcorn and looking directly at the camera with a smirk. Other audience members are visible in the background, some engaged in their own activities or watching the screen. The scene is framed by rows of empty seats and dim lighting, with a bright light source from the screen illuminating the foreground. The text overlay \"i'm just here for the boobs\" adds a humorous or sarcastic context to the scene, implying the man's motivation for attending the movie.",
      "belongsToAnalysis": {
