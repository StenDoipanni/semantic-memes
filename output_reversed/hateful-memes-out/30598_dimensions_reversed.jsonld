    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2f2e6783",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_stereotype",
      "label": "Islamophobia Stereotype",
      "description": "The meme relies on the stereotype that Muslims are inherently violent or terrorist-prone, which is a common and dangerous form of Islamophobia. This stereotype is not visible in the image but is essential to understanding the hateful message that associates the peaceful-looking man with violence and terrorism.",
      "belongsToAnalysis": {
