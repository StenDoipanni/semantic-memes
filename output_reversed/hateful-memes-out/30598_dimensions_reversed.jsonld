    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_22c17da7",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The intended audience is individuals who hold or are susceptible to Islamophobic beliefs, particularly those who support or are influenced by political rhetoric that scapegoats Muslim immigrants or refugees. The meme targets this community by using a visual of a peaceful elderly man wearing a turban (a religious/ethnic marker) juxtaposed with violent text, aiming to incite fear or hatred toward Muslims by falsely associating them with terrorism and violence. The audience is likely politically motivated individuals who are receptive to government scapegoating narratives and religious stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8fa6d3c6"
      },
      "extractionMethod": "llm_extraction_huggingface"
