    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_382d6d19",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The elderly man is mapped as the 'us' or the targeted group being blamed in the text",
      "description": "The text 'we can kill as many as we want and your stupid government keeps bringing us in' explicitly refers to 'us' as the group being blamed for violence and immigration. The visual entity, the elderly man with a turban, is juxtaposed with this text to create an analogical mapping where the man is implicitly identified as representing 'us' — the group being scapegoated. His peaceful appearance is contrasted with the violent message, creating a false association that the man (and by extension, his group) is inherently violent. This mapping is central to the meme's hateful intent, as it projects the violent stereotype onto the visual subject.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8fa6d3c6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_faf00825",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message as the target of blame",
      "description": "The user is projected onto the textual material ('your stupid government') which uses the deictic 'your' to directly address the viewer, making the user the recipient of the blame being directed at the government. This creates a semiotic projection where the user is positioned as the one whose government is being criticized, thereby implicating them in the scapegoating narrative. The projection is onto the text_chunk, which contains the phrase 'your stupid government', making the user feel personally targeted by the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8fa6d3c6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
