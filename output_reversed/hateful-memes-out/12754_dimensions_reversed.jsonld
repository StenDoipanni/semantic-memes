    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aef3d21d",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The women are mapped as the ones who are full and praising the pho.",
      "description": "The text 'i am full! that pho was good!' is directly mapped onto the two women walking and smiling. The visual of the happy, satisfied women is used to represent the emotional state and experience described in the text — specifically, the feeling of being full and pleased after eating pho. The women are the subjects of the text, and their visual depiction (smiling, engaged in conversation) serves as the visual instantiation of the text's content. This is an analogical mapping where the visual entities (the women) are the embodiment of the textual entities (the speaker of the text, who is full and praising the pho).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_319fc75a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f1a5dc48",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of two women enjoying a meal",
      "description": "The user is projected onto the scene of two women walking and talking in an urban setting, as the text 'i am full! that pho was good!' describes a relatable, first-person experience of satisfaction after eating. The visual of the happy, casually dressed women serves as a direct analogical representation of the user's own experience, inviting the viewer to identify with the speaker's state of fullness and enjoyment. There are no explicit deictic pronouns like 'me' or 'you' in the text, but the first-person plural 'I am full!' and the casual, conversational tone create an implicit projection where the user sees themselves as one of the women in the scene, sharing in the moment of satisfaction.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_319fc75a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
