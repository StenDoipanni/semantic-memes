    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5f5d0990",
      "@type": "EmotionExpression",
      "instance_name": "satirical_irony",
      "label": "satirical irony expression",
      "description": "The image conveys a humorous and ironic tone through the juxtaposition of Michelle Obama’s formal public speaking with the trivializing text 'public talking'. This creates a self-deprecating or mocking emotional cue, suggesting the act of public speaking is being humorously reduced to mere talking in public.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_71fa8d86"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e62c1c2d",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "Public Speaking is trivially labeled as 'public talking'",
      "description": "The text 'public talking' is overlaid on the image of Michelle Obama speaking into a microphone. This creates an analogical mapping where the formal activity of public speaking (represented by Michelle Obama in the act of speaking) is mapped onto the trivializing label 'public talking'. The mapping is satirical, reducing the formal context of public speaking to a simple, mundane act of talking in public, thereby creating irony and humor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_71fa8d86"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1bce20fd",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual label as a self-referential or ironic identification",
      "description": "The user is projected onto the textual material 'public talking' as a way to identify with or mock the act of public speaking. The meme invites the user to see themselves in the trivialized label, humorously equating public speaking with 'public talking', which implies the user might be engaging in or reflecting on such an activity. There is no explicit deictic pronoun like 'me' or 'you', but the satirical labeling creates an implicit projection where the viewer is invited to participate in the joke by identifying with the concept being trivialized.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_71fa8d86"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0723ec8a",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "general internet audience",
      "description": "The meme is designed for a broad, general internet audience familiar with public speaking and satirical humor. It leverages the recognizable image of Michelle Obama, a widely known public figure, to create a relatable and humorous scenario. The target community includes individuals who understand the context of public speaking and appreciate ironic or self-deprecating labels, such as 'public talking,' which trivializes the formal act. The humor is accessible and does not rely on niche cultural references or specific demographic markers, making it suitable for a wide range of viewers.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_71fa8d86"
      },
