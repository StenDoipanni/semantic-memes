      "instance_name": "satirical_labeling",
      "label": "Satirical Labeling",
      "description": "The meme uses a satirical or ironic label ('public talking') to mock or trivialize the act of public speaking. This requires background knowledge of satirical humor and the cultural understanding that such labels are used to create comedic effect by highlighting absurdity or over-simplification.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_71fa8d86"
