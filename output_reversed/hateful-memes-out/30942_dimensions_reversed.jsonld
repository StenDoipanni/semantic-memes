    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9b021803",
      "@type": "EmotionExpression",
      "instance_name": "hateful_laughter",
      "label": "hateful, darkly comedic emotion",
      "description": "The meme expresses a grotesque, hateful humor by trivializing the Holocaust and reducing human suffering to a crude, racist joke. The overlaid text 'when the americans pull up outside of auschwitz' and '*jew cooking time stops*' is meant to be darkly comedic, but it is rooted in antisemitic tropes and the normalization of genocide as a punchline. The emotion is not genuine amusement but a calculated, offensive mockery that relies on dehumanization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f23f7807"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bac4211f",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The arrival of American forces at Auschwitz is mapped onto the visual of Nazi leaders",
      "description": "The top text 'when the americans pull up outside of auschwitz' is juxtaposed with the visual of Nazi leaders (including Adolf Hitler) standing before swastika flags. This creates an analogical mapping where the historical event of American forces arriving at Auschwitz (a moment of liberation and the end of Nazi atrocities) is visually represented by the image of the Nazi regime's leaders. The mapping implies that the visual material (Nazi leaders) represents the 'before' state of the event described in the text (American arrival), thereby establishing a direct visual-textual correspondence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f23f7807"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4a64e930",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the antisemitic stereotype and historical scene",
      "description": "The user is projected onto the textual material and visual material that together form the hateful joke. The text '*jew cooking time stops*' directly addresses the user by implying the user is part of the group being stereotyped (Jews) and that their 'cooking time' (a dehumanizing metaphor) is interrupted by the arrival of American forces. The user is also projected onto the scene of Nazi leaders at Auschwitz, which serves as the visual anchor for the joke, making the user feel implicated in the darkly humorous and offensive framing of the Holocaust. The meme does not use explicit deictic pronouns like 'you' or 'me', but the projection is implicit through the user's identification with the target of the stereotype and the historical event being trivialized.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f23f7807"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_183f2b5f",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks Jewish people through antisemitic stereotypes and trivializes the Holocaust, using dark humor to dehumanize victims and normalize genocide as a punchline.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f23f7807"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5344a04b",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who are familiar with or have an interest in World War II history, particularly the Holocaust and the liberation of concentration camps, and who may be exposed to or engage with dark humor, offensive internet memes, or antisemitic tropes. The meme relies on historical knowledge of Auschwitz, American forces in Europe, and Nazi leaders to create its context, suggesting the audience is expected to recognize these references. The content is designed to provoke a reaction from those who understand the gravity of the Holocaust and the Nazi regime, and who may find the crude, hateful joke offensive or darkly humorous. The meme’s toxicity and reliance on antisemitic stereotypes indicate it is intended for an audience that either tolerates or engages with hate speech, or who may be unaware of the harm caused by trivializing genocide.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f23f7807"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
