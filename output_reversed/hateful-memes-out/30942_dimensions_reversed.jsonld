    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f4e41bfd",
      "@type": "BackgroundKnowledge",
      "instance_name": "american_forces_in_europe",
      "label": "American forces in Europe during WWII",
      "description": "The United States Army's involvement in the European Theater of World War II, including the liberation of concentration camps such as Auschwitz in January 1945. The meme references this historical event as the moment when the 'cooking time' stops, implying the end of Nazi atrocities.",
      "belongsToAnalysis": {
