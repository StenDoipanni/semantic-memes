    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3855bd32",
      "@type": "BackgroundKnowledge",
      "instance_name": "auschwitz",
      "label": "Auschwitz concentration camp",
      "description": "A network of Nazi concentration and extermination camps in occupied Poland, including Auschwitz-Birkenau, where over 1.1 million people, mostly Jews, were murdered. The reference to 'pulling up outside of Auschwitz' invokes the historical arrival of Allied forces in 1945, which ended the genocide at that site.",
      "belongsToAnalysis": {
