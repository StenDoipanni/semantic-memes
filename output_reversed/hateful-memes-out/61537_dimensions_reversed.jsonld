    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3358195f",
      "@type": "BackgroundKnowledge",
      "instance_name": "Cultural_appropriation",
      "label": "Cultural appropriation",
      "description": "The act of taking elements from a culture that is not one's own, often without permission or understanding, and using them in a way that can be seen as disrespectful or insensitive. The meme is an example of cultural appropriation because it misrepresents Cinco de Mayo by altering its name and associating it with Puerto Rico and the American flag, which can be seen as disrespectful to those who celebrate the original holiday or to Puerto Rican culture.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e9361a03"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e9bc451b",
      "@type": "BackgroundKnowledge",
      "instance_name": "Cultural_mockery",
      "label": "Cultural mockery",
      "description": "The act of making fun of or ridiculing a culture, often through satire or exaggeration. The meme is an example of cultural mockery because it uses a deliberate misspelling of 'Cinco de Mayo' to imply 'Cinco de Puerto Rico' and uses the American flag to falsely associate the celebration with Puerto Rico, which can be seen as disrespectful or insensitive to those who celebrate Cinco de Mayo or Puerto Rican culture.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e9361a03"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
