    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e8a6632a",
      "@type": "BackgroundKnowledge",
      "instance_name": "michael_jackson",
      "label": "Michael Jackson",
      "description": "Michael Jackson was a globally renowned Black pop singer, dancer, and entertainer who suffered from vitiligo, a skin condition causing loss of pigmentation. His public struggle with vitiligo, especially during his later years, was widely documented and became a significant part of his public image. The meme references him to imply that the person in the image is somehow 'unattractive' or 'unacceptable' due to their race or the condition's association with a Black figure, leveraging a harmful stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bf17e985"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6f675285",
      "@type": "BackgroundKnowledge",
      "instance_name": "vitiligo",
      "label": "Vitiligo",
      "description": "Vitiligo is a long-term autoimmune condition that causes the loss of skin color in patches. It is not contagious, not caused by poor hygiene, and is not a sign of any moral failing. The meme misrepresents this medical condition by linking it to a racial stereotype, implying that the person's appearance is somehow 'wrong' or 'unworthy' due to their race or the condition's association with a Black figure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bf17e985"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_621cde19",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype",
      "label": "Anti-Black Stereotype",
      "description": "The meme leverages the association of vitiligo with Michael Jackson, a Black celebrity, to imply that the person's appearance is somehow 'unacceptable' or 'unworthy' due to their race. This is a form of racial stereotyping that uses the condition to make a disparaging comparison, implying that Black people with vitiligo are somehow 'less than' or 'unattractive' — a harmful and false stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bf17e985"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_88240a98",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_stereotyping",
      "label": "Racial Stereotyping",
      "description": "The meme uses the person's race (implied by their skin tone and the reference to Michael Jackson) to make a negative judgment about their appearance and worth. This is a form of racial stereotyping that links a medical condition to a racial identity to create a disparaging narrative, which is a form of hate speech and discrimination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bf17e985"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_277fd165",
      "@type": "EmotionExpression",
      "instance_name": "distress",
      "label": "distressed emotion",
      "description": "The person's facial expression, including furrowed brows, downturned mouth, and tense facial muscles, conveys a state of emotional discomfort or pain. This is further emphasized by the context of the meme, which frames the person's vitiligo as something shameful or undesirable, amplifying the perceived distress.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bf17e985"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_825ca611",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The person with vitiligo is mapped as suffering from vitiligo, the same disease Michael Jackson suffered from.",
      "description": "The top text 'this is vitiligo,' directly labels the visual entity 'person' as having vitiligo. The bottom text 'the same disease that michael jackson suffered from' creates an analogical mapping by associating the person's condition with Michael Jackson, implying a comparison or equivalence between the person and the celebrity. This mapping is used to frame the person's appearance as undesirable or shameful by linking it to a famous Black figure, which is a form of racial stereotyping and hate speech.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bf17e985"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_537bb348",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the person with vitiligo",
      "description": "The user is projected onto the visual material of the person with vitiligo, as the meme uses the person's appearance and the text to create a judgmental narrative. The user is implicitly invited to see themselves in the person or to judge them based on the meme's framing, which links the condition to Michael Jackson and racial stereotypes. There are no explicit deictic pronouns like 'me' or 'you', but the framing of the person as an object of ridicule and the association with a famous Black figure creates an implicit projection of the user onto the person, encouraging the user to view the person through the lens of the meme's hateful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bf17e985"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8275ff85",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks the individual based on their race and medical condition by linking their appearance to Michael Jackson, implying that the person's vitiligo makes them 'unattractive' or 'unworthy' due to their race. This is a hateful act because it uses the person's protected characteristics (race and medical condition) as a basis for ridicule and stereotyping.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bf17e985"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e1851b9f",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who are familiar with Michael Jackson and his public image, particularly those who may hold or be exposed to anti-Black stereotypes. The meme leverages the association of vitiligo with Michael Jackson—a globally renowned Black celebrity—to imply that the person in the image is somehow 'unattractive' or 'unworthy' due to their race. This targets audiences who may unconsciously or consciously equate Blackness with the condition, reinforcing harmful racial stereotypes. The meme is designed to provoke negative reactions based on the person's appearance and race, appealing to those who may find the condition aesthetically displeasing or socially unacceptable when linked to a Black figure. The cultural reference to Michael Jackson serves as a community-specific element that anchors the meme in a context of racial stereotyping, making it particularly effective for audiences who recognize the celebrity and associate his vitiligo with his Black identity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bf17e985"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
