    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_331cc2f3",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_stereotype",
      "label": "Islamophobia Stereotype",
      "description": "The meme relies on the harmful stereotype that Muslims are inherently associated with terrorism, violence, and barbarism. This is evident in the text's call to 'shoot 'em' when they yell 'allahakbar,' which equates the religious phrase with imminent violence. This stereotype is a core component of Islamophobic discourse and is not visible in the image but is essential to understanding the meme's hateful message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a38971b5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_85526c95",
      "@type": "BackgroundKnowledge",
      "instance_name": "allahakbar_phrase",
      "label": "Allahakbar Phrase",
      "description": "The phrase 'allahakbar' is a religious exclamation used by Muslims, often in the context of prayer or declaration of faith. Its use in the meme is deliberately misinterpreted and weaponized to incite fear and violence against Muslims. This requires external knowledge to understand the phrase's actual religious context versus its distorted use in the meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a38971b5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3e932b82",
      "@type": "BackgroundKnowledge",
      "instance_name": "john_candy_actor",
      "label": "John Candy as Actor",
      "description": "The image features John Candy, a well-known actor and comedian. His use in this meme is ironic and jarring, as he is typically associated with wholesome, comedic roles. The juxtaposition of his benign image with violent, hateful text is a common meme tactic to shock or provoke. This requires knowledge of his public persona and career to fully understand the meme's intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a38971b5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5012909d",
      "@type": "BackgroundKnowledge",
      "instance_name": "terrorism_association",
      "label": "Terrorism Association",
      "description": "The meme explicitly links the phrase 'allahakbar' with terrorism and violence ('blow up a bomb, or start stabbin' and shootin' people'). This is a dangerous and false association that requires external knowledge about the real-world context of terrorism and the diversity of Muslim communities to understand the meme's harmful implications.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a38971b5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1f67fef6",
      "@type": "BackgroundKnowledge",
      "instance_name": "hateful_intent",
      "label": "Hateful Intent",
      "description": "The overall intent of the meme is to incite hatred and violence against Muslims by promoting a false and dangerous stereotype. This requires understanding the broader social and political context of Islamophobia and hate speech to interpret the meme's message accurately.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a38971b5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_edd258c3",
      "@type": "EmotionExpression",
      "instance_name": "contemplative_seriousness",
      "label": "contemplative and serious emotion",
      "description": "The man's facial expression, with his eyes slightly narrowed and his hand holding a cigar near his mouth, conveys a serious, pensive, or contemplative mood. This expression is not inherently emotional in a positive or negative sense but is used here in a jarring contrast to the violent text overlay, amplifying the meme's unsettling tone.",
      "belongsToAnalysis": {
