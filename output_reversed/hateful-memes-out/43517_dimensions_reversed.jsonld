    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f8bf2dcb",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The contemplative man with cigar is mapped as the person who should 'shoot 'em' when hearing 'allahakbar' crap",
      "description": "The visual entity 'contemplative_man_with_cigar' (John Candy) is analogically mapped to the textual role of the person who is instructed to 'shoot 'em' in response to hearing 'allahakbar' crap. This mapping is established by the juxtaposition of the image of a calm, older white man with the violent, hateful text, creating a jarring contrast that implies the man embodies the violent action described. The text does not explicitly say 'you' or 'me', but the visual material is presented as the subject of the instruction, making the man the implicit agent of the violent action described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a38971b5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_72c14d79",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the contemplative man with cigar",
      "description": "The user is projected onto the visual entity 'contemplative_man_with_cigar' (John Candy) because the meme's text instructs 'just shoot 'em' in response to hearing 'allahakbar' crap, implying the viewer (user) should take this violent action. Although the text does not use explicit deictic pronouns like 'you' or 'me', the visual material is presented as the implicit agent of the violent action described, creating a semiotic projection where the user identifies with or is expected to embody the role of the person performing the action. This is reinforced by the juxtaposition of a calm, benign-looking man with violent instructions, which can be interpreted as a call to the viewer to adopt that role.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a38971b5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_848df855",
