      "@type": "BackgroundKnowledge",
      "instance_name": "xenophobia",
      "label": "Xenophobia",
      "description": "Intense or irrational fear or dislike of foreigners or people from other countries. The meme's message implicitly promotes xenophobic views by portraying immigration as a threat to national unity and by using divisive language. This concept is critical to understanding the meme's underlying message and its potential to incite prejudice.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1556a291"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
