      "@type": "BackgroundKnowledge",
      "instance_name": "dehumanization",
      "label": "Dehumanization",
      "description": "The process of stripping away the humanity of a group, often by labeling them as 'illegals' or 'foreigners' to justify discrimination or exclusion. The meme's language implicitly relies on dehumanizing undocumented immigrants to make their exclusion seem morally or politically acceptable, which is a key element of its harmful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1556a291"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
