    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b2dc7458",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Donald Trump is mapped as the speaker of the divisive immigration rhetoric",
      "description": "The text 'yes i'm trying to divide the country i'm dividing the illegals from the actual citizens' is overlaid on the image of Donald Trump speaking at a podium. This creates an analogical mapping where the visual entity (Donald_Trump) is identified as the source or embodiment of the textual message. The meme implies that Donald Trump is the one who is 'trying to divide the country' and is 'dividing the illegals from the actual citizens', projecting the textual claim directly onto the visual figure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1556a291"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_71c06be9",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message as the source of divisive rhetoric",
      "description": "The user is projected onto the textual material ('yes i'm trying to divide the country i'm dividing the illegals from the actual citizens') which is overlaid on the image of Donald Trump. The meme implies that the user (as the viewer) is identifying with or attributing the divisive rhetoric to the political figure, thereby projecting the user's own perspective or judgment onto the text and the visual of Trump. This projection is not explicit through deictic pronouns like 'you' or 'me' in the text itself, but is inferred from the meme's structure: the viewer is positioned as the one interpreting the text as a direct statement from Trump, and thus the user is projected onto the scene as the one who is 'seeing' or 'understanding' the divisive nature of the policy. The projection is onto the textual material which frames the political figure's actions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1556a291"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_18cce666",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme promotes xenophobic and divisive rhetoric by framing immigration policy as a tool to split the country, using dehumanizing language ('illegals') to portray undocumented immigrants as a threat to national unity and social cohesion. This can incite prejudice, hostility, and social division toward immigrant communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1556a291"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_888230e9",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who are politically engaged, particularly those who support or are sympathetic to Donald Trump's immigration policies. The meme is designed to resonate with audiences who perceive immigration as a threat to national identity and social cohesion, and who are receptive to anti-immigrant rhetoric that frames undocumented immigrants as 'illegals' and 'divisive.' It appeals to those who believe in binary thinking ('actual citizens' vs. 'illegals') and who are influenced by political messaging that portrays immigration as a source of political division. The meme's use of Donald Trump's image and the specific text overlay signals that it is intended for an audience familiar with his political discourse and the broader political discourse surrounding immigration in the United States.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1556a291"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
