    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_05adb6d0",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Mapping of 'how muslims see us' to the threatening scene",
      "description": "The top text 'how muslims see us staring down the barrel of a .45......' is mapped onto the visual scene of the man in a suit being threatened by armed individuals. This mapping suggests that the visual depiction of the man in fear represents how Muslims are perceived by the meme's author (or 'us') as being in a position of threat or danger, specifically 'staring down the barrel of a .45'. The visual material (the threatening scene) is thus analogically mapped to the textual description of how Muslims perceive 'us' (the author's group).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b94aff16"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_440dd54d",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man in the suit",
      "description": "The user (the meme's author or 'us') is projected onto the man in the suit, who is depicted kneeling in fear and being threatened by armed individuals. This projection is implied through the bottom text 'how we see muslims', which positions the user as the observer or the group being threatened, thereby identifying the man in the suit as the representation of 'us' in the context of how Muslims are perceived. The visual material of the man in the suit being threatened is thus the entity onto which the user is projected, as the user is the one 'seeing' or 'experiencing' the scenario described in the meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b94aff16"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_99bf5a3b",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme depicts a violent, threatening scenario to portray Muslims as inherently dangerous or violent, which is a harmful and hateful stereotype. It relies on the association of Muslims with terrorism and violence, which is a well-documented form of Islamophobia. The intent is to provoke fear and reinforce negative perceptions of Muslims by equating them with armed threats, thereby contributing to a hostile and discriminatory atmosphere.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b94aff16"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d71a651c",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed for an audience that identifies with the group being portrayed as 'us' in the text — specifically, non-Muslims or Westerners who are using the meme to express or reinforce negative stereotypes about Muslims. The audience is likely to be individuals who hold or are exposed to Islamophobic views, and who may be seeking to validate or share their perception of Muslims as violent or threatening. The meme’s intent to provoke fear and reinforce prejudice indicates it targets those who are already predisposed to or receptive to such stereotypes, particularly in contexts where anti-Muslim sentiment is prevalent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b94aff16"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
