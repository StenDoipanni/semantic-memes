      "@id": "http://example.org/multimodal-taxonomy#dimension_3703b3d7",
      "@type": "EmotionExpression",
      "instance_name": "fear",
      "label": "fearful emotion",
      "description": "The man in the suit is kneeling with both hands pressed to his head, a posture universally associated with extreme fear, helplessness, and distress in the face of imminent danger. His body language conveys a profound emotional state of terror and vulnerability.",
