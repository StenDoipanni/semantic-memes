    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_421e58ca",
      "@type": "Scene",
      "instance_name": "threatening_scene",
      "label": "a man in a suit being threatened by two armed individuals",
      "description": "The scene depicts a man in a suit kneeling on the floor with his hands on his head, appearing distressed. He is positioned centrally and is being threatened by two armed individuals: one holding a rifle and the other pointing a handgun at him. The setting is a bare, dilapidated room, enhancing the sense of danger and vulnerability. The text overlays suggest a hateful stereotype, portraying Muslims as violent threats, which is a form of Islamophobia.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b94aff16"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
