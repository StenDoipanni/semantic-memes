      "instance_name": "thefts",
      "label": "Thefts",
      "description": "The act of stealing property or goods from someone else without permission. This is a common crime and a real-world concern that motivates people to install security systems. The meme uses this term to imply a perceived or exaggerated threat to personal property.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6196b590"
