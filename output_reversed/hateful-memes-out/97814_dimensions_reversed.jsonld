    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_24588e48",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'call me a hater if you want but,...' maps to the central Black woman in the white dress.",
      "description": "The top text overlay 'call me a hater if you want but,...' is directly addressing the viewer and implicitly projecting the speaker's identity onto the central visual entity, the Black woman in the white dress. This creates an analogical mapping where the speaker (implied by the text) is visually represented by the woman, suggesting she is the one being called a 'hater' or is the subject of the subsequent hateful claim. The spatial positioning of the text above her reinforces this projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4f19a398"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2265b46a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_2",
      "label": "The text '...when is the last time you saw a photo of anyone but a muslim holding a human head?' maps to the theatrical performance scene.",
      "description": "The bottom text poses a rhetorical question that relies on the visual context of the theatrical performance. The text implies that the only person depicted holding a human head (a grotesque metaphor for violence) is a Muslim, and this is mapped onto the scene as a whole. The theatrical setting is used to frame the visual material as a staged representation, which the text then weaponizes to reinforce a harmful stereotype. The mapping is between the text's claim and the visual scene, where the scene is the entity being referenced or implied by the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4f19a398"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3b1eba0f",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the central Black woman in the white dress",
      "description": "The top text overlay 'call me a hater if you want but,...' directly addresses the viewer ('you') and implicitly projects the speaker's identity (the 'hater') onto the central visual entity, the Black woman in the white dress. This creates a deictic projection where the user is positioned as the 'hater' being called out, and the woman becomes the visual embodiment of that role within the meme's narrative. The spatial positioning of the text above her reinforces this projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4f19a398"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eb692e08",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_2",
      "label": "User projected onto the theatrical performance scene",
      "description": "The bottom text '...when is the last time you saw a photo of anyone but a muslim holding a human head?' poses a rhetorical question that implicitly projects the user's perspective onto the entire theatrical performance scene. The user is expected to mentally engage with the scene, interpreting it as evidence for the text's claim. The scene becomes the entity onto which the user's judgment and the meme's hateful argument are projected, as the text relies on the visual context of the scene to make its point about Muslims and violence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4f19a398"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
