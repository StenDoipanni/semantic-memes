    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f2d41552",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual and textual contrast of the meme",
      "description": "The user is projected onto the entire meme structure, which juxtaposes two scenes: a festive turkey preparation (USA) and a violent hanging execution (Romania). The user is not explicitly directed to any single element via deictic pronouns like 'me' or 'you', but the meme's structure invites the user to interpret the absurd comparison and internalize the implied cultural judgment. The projection is onto the overall scene and its textual labels, which frame the user as an observer of the cultural caricature.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_08e86a63"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
