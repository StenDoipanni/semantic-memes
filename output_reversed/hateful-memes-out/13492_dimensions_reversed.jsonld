      "@type": "BackgroundKnowledge",
      "instance_name": "housework_stereotype",
      "label": "Housework Stereotype",
      "description": "The societal expectation that women are expected to handle household chores and food preparation. This is implied by the scene of the mother making sandwiches, which is a common domestic activity, and the text praising her skill in this area, suggesting that her competence in this role is a point of pride.",
      "belongsToAnalysis": {
