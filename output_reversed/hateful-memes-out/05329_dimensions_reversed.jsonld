      "instance_name": "racial_humor",
      "label": "Racial Humor",
      "description": "Humor that relies on racial stereotypes or references to race, often in a way that is offensive or reductive. The meme uses racial humor by suggesting that a tan skin tone might be the reason for judgment, rather than race, which can be seen as a subtle form of racial humor that may be offensive to some.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b8e07097"
      },
      "extractionMethod": "llm_extraction_huggingface"
