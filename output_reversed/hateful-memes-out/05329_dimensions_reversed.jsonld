    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a6e91a5c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Tan skin as a proxy for race",
      "description": "The text 'they might just be tan' is mapped onto the visual of the woman with a tan complexion. The meme uses her tan skin as a visual representation of the textual claim that a person's skin color might be due to sun exposure rather than race. This creates an analogical mapping where the woman's tan skin is projected as the 'reason' for the judgment mentioned in the text, deflecting from the serious issue of racial bias.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b8e07097"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_183c5c57",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman with tan skin as a representation of the 'tanning' joke",
      "description": "The user is projected onto the visual material of the woman with a tan complexion, who is lying on the rocks. The meme uses her tan skin as a visual anchor for the textual claim 'they might just be tan', implying that the user (or the viewer) is projecting their own judgment onto her, and that this judgment can be explained by her tan skin rather than her race. This creates a semiotic projection where the user identifies with the deflection mechanism of the meme, seeing the woman as a stand-in for the 'judged' person, and thus projecting their own perspective onto her tan skin as the reason for any potential judgment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b8e07097"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
