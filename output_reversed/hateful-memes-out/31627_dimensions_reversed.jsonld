      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_61b55422",
      "@type": "BackgroundKnowledge",
      "instance_name": "fire_cracker_metaphor",
      "label": "Firecracker Metaphor",
      "description": "The metaphor of a 'firecracker' refers to a person who is volatile, explosive, or prone to sudden, destructive outbursts. This is a common cultural metaphor used to describe someone's temperament or behavior as unpredictable or dangerous. The term 'firecracker' itself is associated with loud, sudden, and often destructive explosions, which is visually represented by the flames engulfing the man. This metaphor is used to convey a negative judgment about the individual's emotional stability or behavior, which can be stigmatizing or dehumanizing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2a20eea7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_59a0156a",
      "@type": "BackgroundKnowledge",
      "instance_name": "emotional_instability_stereotype",
      "label": "Emotional Instability Stereotype",
      "description": "This stereotype involves labeling individuals as 'crazy,' 'hysterical,' or 'volatile' to imply they are emotionally unstable or unpredictable. It is often used to demean or dehumanize people, particularly in contexts where their behavior is perceived as erratic or out of control. This stereotype is part of broader misogynistic tropes that associate women (and sometimes men) with emotional instability, which can lead to social harm or reinforce negative societal perceptions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2a20eea7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dc83e7b9",
      "@type": "BackgroundKnowledge",
      "instance_name": "dangerous_person_stereotype",
      "label": "Dangerous Person Stereotype",
      "description": "This stereotype involves portraying individuals as inherently dangerous or unstable, often based on their behavior or appearance. It is used to justify fear, avoidance, or hostility toward the person, and can be used to stigmatize or marginalize them. This stereotype is often applied to people who are perceived as emotionally volatile, unpredictable, or prone to outbursts, which aligns with the visual metaphor of the man being engulfed in flames.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2a20eea7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6b23083c",
      "@type": "BackgroundKnowledge",
      "instance_name": "dehumanizing_metaphor",
      "label": "Dehumanizing Metaphor",
      "description": "This refers to the use of metaphors or analogies that strip a person of their humanity, often by comparing them to inanimate objects or animals. In this case, comparing a person to a 'firecracker' reduces them to a volatile, explosive object, which can be seen as dehumanizing. This type of metaphor is often used to justify negative judgments or actions against the person, as it implies they are not worthy of empathy or understanding.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2a20eea7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
