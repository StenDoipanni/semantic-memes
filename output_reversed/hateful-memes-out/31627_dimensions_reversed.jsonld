    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_02f65587",
      "@type": "Scene",
      "instance_name": "fire_cracker_metaphor",
      "label": "man engulfed in flames as a fire cracker",
      "description": "The scene depicts a man with short brown hair and a beard, wearing a dark button-up shirt and dark pants, standing with arms crossed. He is engulfed in flames, creating a visual metaphor for being volatile or explosive. The text 'a fire cracker' is overlaid on the image, reinforcing the metaphor. The man is the central and most salient visual element in the image, positioned centrally against a plain gray background. The flames are concentrated around his torso and head, with his face visible and expression neutral. The overall composition uses the visual of fire and the metaphorical text to convey a negative judgment about the individual's temperament or behavior, suggesting he is dangerous or unstable.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2a20eea7"
