    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0b5eb9bc",
      "@type": "BackgroundKnowledge",
      "instance_name": "motivational_meme_concept",
      "label": "Motivational Meme Concept",
      "description": "The meme format of using a visual metaphor (like a swimmer) with overlaid text to convey an inspirational or self-help message is a common internet phenomenon. This concept relies on cultural understanding of visual metaphors and motivational discourse prevalent in social media and self-improvement communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8a8c8c82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e4da1655",
      "@type": "BackgroundKnowledge",
      "instance_name": "self_motivation_philosophy",
      "label": "Self-Motivation Philosophy",
      "description": "The core message 'the only thing that hinders you is your own motivation' is a philosophical statement rooted in self-help literature and psychology. It implies that internal drive is the primary factor in achieving goals, and external obstacles are secondary. This concept is widely discussed in personal development circles.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8a8c8c82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c435d7ac",
      "@type": "BackgroundKnowledge",
      "instance_name": "swimming_as_metaphor",
      "label": "Swimming as Metaphor",
      "description": "Swimming is often used as a metaphor for progress, struggle, and perseverance in motivational contexts. The act of swimming against water represents overcoming challenges, and the swimmer's effort symbolizes personal determination. This metaphor is culturally embedded in self-help imagery.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8a8c8c82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c92ca007",
      "@type": "BackgroundKnowledge",
      "instance_name": "inspirational_social_media_trend",
      "label": "Inspirational Social Media Trend",
      "description": "The use of motivational quotes overlaid on action shots (like athletes, climbers, or swimmers) is a dominant trend in social media platforms. It leverages visual storytelling to inspire followers and promote self-improvement, often tied to fitness, productivity, or personal growth communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8a8c8c82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_04eea83a",
      "@type": "EmotionExpression",
      "instance_name": "determination",
      "label": "determined emotion",
      "description": "The swimmer's focused facial expression and active swimming motion convey a sense of determination and perseverance, aligning with the motivational message of overcoming internal barriers.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8a8c8c82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9834526b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Swimmer as the embodiment of self-motivation",
      "description": "The visual entity 'swimmer' is mapped onto the textual concept of 'self-motivation' through the meme's message. The swimmer's active, determined motion in the water symbolizes the internal drive (self-motivation) that the text claims is the only hindrance. The swimmer's effort and perseverance visually represent the abstract concept of self-motivation described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8a8c8c82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9d6793fa",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the swimmer as a metaphor for self-motivation",
      "description": "The user is projected onto the swimmer (visual material) through the textual message 'the only thing that hinders you is your own motivation'. The deictic pronoun 'you' directly addresses the viewer, implying that the user is the 'you' in the statement. The swimmer, as the visual embodiment of effort and perseverance, becomes the projected entity onto which the user identifies — the user is metaphorically the swimmer striving against internal resistance (lack of motivation).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8a8c8c82"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_52e369df",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "motivational self-improvement community",
      "description": "The meme is designed for individuals engaged in personal development, fitness, or productivity-focused online communities. The visual metaphor of swimming and the text 'the only thing that hinders you is your own motivation' directly appeal to audiences seeking self-help, goal-setting, and perseverance narratives. This aligns with the inspirational social media trend and self-motivation philosophy, targeting users who consume motivational content to fuel their own progress.",
      "belongsToAnalysis": {
