    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7ac443ab",
      "@type": "BackgroundKnowledge",
      "instance_name": "china",
      "label": "China",
      "description": "A country in East Asia with a distinct cultural, historical, and religious identity. Chinese culture has its own set of traditional festivals (e.g., Lunar New Year, Mid-Autumn Festival) and does not recognize or celebrate Western holidays like Thanksgiving. The meme implies a cultural mismatch by juxtaposing an American holiday with China.",
      "belongsToAnalysis": {
