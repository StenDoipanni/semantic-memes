    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7492f825",
      "@type": "BackgroundKnowledge",
      "instance_name": "general_custer_battle_of_little_bighorn",
      "label": "Battle of Little Bighorn",
      "description": "The Battle of Little Bighorn, fought in 1876, was a decisive victory for Native American forces led by Sitting Bull and Crazy Horse against the 7th Cavalry Regiment of the U.S. Army, commanded by General George Armstrong Custer. This battle is central to the meme's context, as it is the historical event that links Custer to Native American conflict, allowing the meme to use his image to symbolize violent aggression toward Native Americans. The defeat of Custer at Little Bighorn is a well-known historical event that provides the basis for the meme's juxtaposition of hatred toward both banks and Native Americans.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_32c8259d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0828d21b",
      "@type": "BackgroundKnowledge",
      "instance_name": "general_custer_stereotype",
      "label": "General Custer as a symbol of military aggression and failure",
      "description": "General Custer is often stereotyped in popular culture as a reckless, arrogant, and ultimately doomed military leader whose actions led to the defeat of the U.S. Army at Little Bighorn. This stereotype is leveraged in the meme to imply that the figure in the image represents a violent, aggressive force, which is then used to express hatred toward both banks and Native Americans. The meme relies on the public perception of Custer as a symbol of military failure and aggression to convey its message.",
      "belongsToAnalysis": {
