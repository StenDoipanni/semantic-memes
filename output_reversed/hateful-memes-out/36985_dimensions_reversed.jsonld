    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a1cac681",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Hitler is being mapped as having a 'good side'",
      "description": "The text 'okay now make sure to get my good side' is overlaid on the image of Adolf Hitler. This creates an analogical mapping where the textual entity 'my good side' is projected onto the visual entity 'Adolf_Hitler'. The meme implies that Hitler, as the visual subject, possesses a 'good side' that must be 'seen' or 'got', which is a grotesque and offensive caricature. This mapping is central to the meme's hateful intent, as it trivializes the historical atrocities committed by Hitler and his regime by suggesting he has a redeeming or positive aspect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_288b7675"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5e2e849d",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message implying personal interaction",
      "description": "The user is projected onto the textual material 'okay now make sure to get my good side' which uses the first-person plural 'my' to imply the user is the one who must 'get' Hitler's 'good side'. This creates a direct address to the viewer, making the user feel personally involved in the absurd and hateful scenario. The projection is onto the textual material, which frames the user as the recipient of Hitler's supposed 'good side' offer.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_288b7675"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
