      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_02015f00",
      "@type": "BackgroundKnowledge",
      "instance_name": "white_supremacy",
      "label": "White Supremacy",
      "description": "White supremacy is a racist ideology that promotes the belief in the inherent superiority of white people and the inferiority of other races. It was a foundational component of American slavery and segregation, and the Democratic Party, especially in its modern form, has historically opposed and sought to dismantle this ideology through civil rights legislation and social justice advocacy.",
      "belongsToAnalysis": {
