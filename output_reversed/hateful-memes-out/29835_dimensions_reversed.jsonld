      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9595714c",
      "@type": "BackgroundKnowledge",
      "instance_name": "segregation",
      "label": "Segregation",
      "description": "Segregation refers to the enforced separation of people based on race, particularly in the United States during the Jim Crow era. It was a system of racial discrimination upheld by laws and social norms, which the Democratic Party, especially in its modern form, has historically opposed and sought to dismantle through civil rights legislation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a738c4a5"
