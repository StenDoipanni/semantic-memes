      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_24bbbefa",
      "@type": "BackgroundKnowledge",
      "instance_name": "civil_rights_movement",
      "label": "Civil Rights Movement",
      "description": "The Civil Rights Movement was a social movement in the United States during the 1950s and 1960s that sought to end racial segregation and discrimination against African Americans. The Democratic Party, especially in its modern form, has historically been associated with supporting and advancing the goals of this movement through legislation and political advocacy.",
      "belongsToAnalysis": {
