    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9f76de8a",
      "@type": "BackgroundKnowledge",
      "instance_name": "American_Revolution",
      "label": "American Revolution",
      "description": "The historical event referenced in the meme, where the American colonies fought for independence from British rule. The meme implies that while the colonists fought for freedom, they failed to extend that freedom to enslaved African Americans, who were often held in bondage by the very same colonists. This requires knowledge of the historical context of slavery in the American colonies during the 18th century.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d2df8b15"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_688f7323",
      "@type": "BackgroundKnowledge",
      "instance_name": "Slavery_in_America",
      "label": "Slavery in America",
      "description": "The institution of slavery that existed in the American colonies and later the United States, particularly in the Southern states. The meme critiques the hypocrisy of fighting for independence while maintaining a system of human bondage. This requires understanding the historical reality that many of the founding fathers were slaveholders, and that enslaved people were not granted freedom during or after the revolution.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d2df8b15"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6f82dd30",
      "@type": "BackgroundKnowledge",
      "instance_name": "Historical_Hypocrisy",
      "label": "Historical Hypocrisy",
      "description": "The concept that historical figures or movements claimed moral high ground or noble ideals (like freedom or liberty) while simultaneously engaging in morally contradictory or unjust practices (like enslaving people). The meme uses this concept to critique the American Revolution, implying that the fight for independence was incomplete or hypocritical without including enslaved people.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d2df8b15"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_56787d98",
      "@type": "BackgroundKnowledge",
      "instance_name": "Anti_Black_Stereotype_Hypocrisy",
      "label": "Anti-Black Stereotype: Hypocrisy in the Fight for Freedom",
      "description": "A racialized stereotype that implies Black people were not truly 'free' or 'equal' because they were not included in the narrative of independence, even though they were often the ones fighting for it. This stereotype is used in the meme to suggest that the struggle for freedom was inherently flawed or incomplete without addressing the enslavement of Black people, which can be interpreted as a form of historical revisionism that minimizes the suffering of enslaved people and the moral complexity of the independence movements.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d2df8b15"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f9c64f31",
      "@type": "BackgroundKnowledge",
      "instance_name": "Racialized_Historical_Narrative",
      "label": "Racialized Historical Narrative",
      "description": "The framing of historical events through a racial lens, often to highlight perceived contradictions or injustices. The meme relies on this narrative to imply that the fight for independence was racially incomplete, which can be interpreted as harmful because it reduces a complex historical struggle to a simplistic, potentially offensive, and racially charged analogy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d2df8b15"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ba79732c",
      "@type": "EmotionExpression",
      "instance_name": "historical_hypocrisy_critique",
      "label": "critique of historical hypocrisy",
      "description": "The emotion expressed is a critical, sarcastic, or mocking tone directed at historical figures or movements that claimed noble ideals (like independence or freedom) while simultaneously engaging in morally contradictory practices (like enslaving people). This emotion is conveyed through the juxtaposition of the battle scene with the text, which implies a failure or incompleteness in the moral narrative of the revolution.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d2df8b15"
