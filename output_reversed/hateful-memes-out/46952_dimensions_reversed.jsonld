    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_08fbde65",
      "@type": "VisualMaterial",
      "instance_name": "Taco_Bell_restaurant",
      "label": "fast-food restaurant",
      "description": "A modern Taco Bell restaurant with a white and gray exterior, featuring the iconic red bell logo above the entrance. The building has large glass windows and doors, and is flanked by two columns of purple and white balloons. The scene is set under a clear blue sky with a parking lot in the foreground.",
