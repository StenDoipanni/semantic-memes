    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_baa7d712",
      "@type": "Scene",
      "instance_name": "taco_bell_wall_meme_scene",
      "label": "Taco Bell restaurant with wall joke text",
      "description": "A scene depicting a Taco Bell restaurant under a clear blue sky, with text overlaid that reads 'what you americans guna do when they build a wall to keep yall out'. The restaurant has a modern design with a white and gray exterior, large glass windows, and two columns of purple and white balloons flanking the entrance. The scene is set in a parking lot with blue parking lines. The text is positioned at the top and bottom of the image, framing the restaurant as the central visual element.",
      "belongsToAnalysis": {
