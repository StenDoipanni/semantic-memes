    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a9949e07",
      "@type": "BackgroundKnowledge",
      "instance_name": "cat_bacon_stereotype",
      "label": "Cats and Bacon Stereotype",
      "description": "The meme relies on the common cultural stereotype that cats are attracted to or obsessed with bacon, often depicted as being irresistibly drawn to it. This is a humorous exaggeration of a real-world phenomenon where cats may be tempted by the smell or taste of bacon, even though it is not part of their natural diet. The meme plays on this stereotype for comedic effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0b2c7583"
