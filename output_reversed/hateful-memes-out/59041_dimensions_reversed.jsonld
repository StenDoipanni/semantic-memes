    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_acfe255f",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The man is mapped as 'the squad'",
      "description": "The text 'when you don't need a squad be you are the squad' establishes an analogical mapping where the visual entity 'man' (specifically, James McAvoy) is being identified as 'the squad'. This mapping is based on the meme's core message: the individual's self-reliance and confidence are equated with being their own support group or 'squad'. The man's confident demeanor and self-assured expression visually embody this concept, making him the visual representation of 'the squad' as described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cee6adbe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_54d43484",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual material of the confident man",
      "description": "The user is projected onto the visual material of the man (James McAvoy) as 'the squad'. The text 'when you don't need a squad be you are the squad' uses 'you' to directly address the viewer, prompting them to identify with the man's self-reliant and confident demeanor. The user is thus projected onto the man as the embodiment of self-sufficiency and personal empowerment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cee6adbe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
