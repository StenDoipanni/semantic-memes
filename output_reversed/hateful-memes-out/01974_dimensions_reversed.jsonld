    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_78e71973",
      "@type": "BackgroundKnowledge",
      "instance_name": "atomic_bombings_of_hiroshima_and_nagasaki",
      "label": "Atomic bombings of Hiroshima and Nagasaki",
      "description": "Historical events in which the United States dropped atomic bombs on the Japanese cities of Hiroshima and Nagasaki in August 1945, resulting in massive destruction and loss of life. These bombings were pivotal in ending World War II but also caused long-term suffering, radiation sickness, and social trauma for survivors (hibakusha) and their descendants. The meme trivializes this genocide-level event by comparing it to a 'friend'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2162fff6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b52477bb",
      "@type": "BackgroundKnowledge",
      "instance_name": "holocaust_denial_minimization_themes",
      "label": "Holocaust denial/minimization themes",
      "description": "A form of antisemitic trope that downplays or denies the Holocaust, often by trivializing its scale and horror. This meme uses a similar harmful rhetorical strategy by minimizing the catastrophic human suffering of the atomic bombings, reducing it to a joke about friendship. This is a form of historical minimization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2162fff6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8df21cee",
      "@type": "BackgroundKnowledge",
      "instance_name": "trivialization_of_trauma",
      "label": "Trivialization of trauma",
      "description": "The act of reducing a serious, painful, or catastrophic event to something mundane or humorous. In this meme, the immense suffering caused by the atomic bombings is reduced to the phrase 'everybody needs a friend', which is deeply offensive and insensitive to survivors and their families.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2162fff6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7edd64ad",
      "@type": "BackgroundKnowledge",
      "instance_name": "hibakusha",
      "label": "Hibakusha",
      "description": "The term for survivors of the atomic bombings of Hiroshima and Nagasaki. They endured severe physical and psychological trauma, radiation sickness, and social stigma. The meme's insensitivity directly offends this group and their descendants.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2162fff6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
