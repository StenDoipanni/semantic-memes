      "@type": "BackgroundKnowledge",
      "instance_name": "shock_and_disbelief",
      "label": "Shock and Disbelief",
      "description": "An emotional state characterized by sudden surprise, often accompanied by a sense of being overwhelmed or unable to process information. In the context of this meme, it is the emotional response the man is humorously depicted as having to the news of his girlfriend's pregnancy, which is often portrayed as unexpected or unwanted.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4aa111d4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_47a8404e",
      "@type": "BackgroundKnowledge",
      "instance_name": "avoidance_behavior",
      "label": "Avoidance Behavior",
      "description": "A psychological and behavioral response to stress or discomfort, where an individual attempts to escape or avoid a situation or stimulus. In this meme, the man’s running is a visual metaphor for avoidance — he is fleeing from the emotional or practical implications of the pregnancy news.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4aa111d4"
