    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bfac9299",
      "@type": "Scene",
      "instance_name": "evolution_of_man_scene",
      "label": "juxtaposed_evolutionary_juxtaposition",
      "description": "A meme scene that visually juxtaposes a chimpanzee (representing the 'beginning' of human evolution) with an image of Michelle Obama (representing a modern human), with the text 'the evolution of man'. The scene is structured as a two-panel meme, with the chimpanzee in the top panel and Michelle Obama in the bottom panel, creating a visual narrative of 'evolution' that is rooted in racist stereotypes. The spatial arrangement is vertical, with the primate above the human, implying a hierarchy or progression. The direct relation is one of contrast and comparison, where the chimpanzee is positioned as the 'primitive' stage and Michelle Obama as the 'advanced' stage, despite the inherent racism in this framing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0f9d9cb9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b1661ced",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_chimpanzee_comparison",
      "label": "Anti-Black Stereotype: Comparing Black People to Primates",
      "description": "This stereotype, rooted in racist ideologies, dehumanizes Black people by equating them with chimpanzees or other primates, implying inferiority and a supposed evolutionary gap. It is used in the meme to demean Michelle Obama, a prominent Black woman, by associating her with a primate, which is a harmful and degrading trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0f9d9cb9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bc20081c",
      "@type": "BackgroundKnowledge",
      "instance_name": "michelle_obama",
      "label": "Michelle Obama",
      "description": "Michelle Obama is the former First Lady of the United States and a prominent public figure. She is a Black woman and a symbol of Black excellence, leadership, and representation. The meme uses her image to represent the 'advanced' stage of 'human evolution,' which is a racist trope that dehumanizes Black people by implying they are 'evolving' from primates.",
      "belongsToAnalysis": {
