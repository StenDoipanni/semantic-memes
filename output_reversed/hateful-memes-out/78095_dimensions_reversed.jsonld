    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ab608622",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynistic_stereotype",
      "label": "Misogynistic Stereotype: Linking Sexual Autonomy to Maternal Role",
      "description": "The meme relies on the harmful stereotype that a woman's sexual behavior or choices (specifically, her refusal to allow penetration) are somehow predictive or indicative of her future as a 'great single mother.' This frames her sexual agency as a precursor to her reproductive role, reducing her to her reproductive potential and ignoring her autonomy, consent, and personal agency. This is a form of misogynistic humor that devalues women's autonomy and reinforces the idea that a woman's worth is tied to her reproductive capacity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_681ad1df"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_436711a7",
      "@type": "BackgroundKnowledge",
      "instance_name": "sexual_objectification",
      "label": "Sexual Objectification",
      "description": "The meme uses the visual of a woman in lingerie, combined with sexually suggestive text, to objectify her. The text 'when she says \"don't cum in me\"' frames her as a sexual object whose body and desires are being used for comedic or degrading purposes. The image and text together create a narrative that reduces her to her sexual availability and reproductive potential, ignoring her as a person with agency and complex desires.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_681ad1df"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fb35ef12",
      "@type": "BackgroundKnowledge",
      "instance_name": "maternal_role_limitation_stereotype",
      "label": "Maternal Role Limitation Stereotype",
      "description": "The phrase 'make a great single mother' is a stereotype that implies a woman's primary or only value lies in her ability to be a mother. This stereotype limits women to the role of motherhood and suggests that any woman who is not in a traditional family structure (i.e., married with children) is somehow incomplete or less valuable. It reinforces the idea that a woman's worth is tied to her reproductive function, which is a form of gender-based discrimination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_681ad1df"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
