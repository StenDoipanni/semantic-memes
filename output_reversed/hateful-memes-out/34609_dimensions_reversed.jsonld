    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ce2ef7fe",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The overweight person is mapped as someone receiving welfare",
      "description": "The text 'someone's been getting more than 50 cents a day' is mapped onto the visual entity 'person'. The text implies the person is receiving government aid or welfare, and the visual of the overweight young male is used to represent this stereotype. This mapping is based on the juxtaposition of the text and image, where the person's appearance is used to embody the stereotype of a welfare-dependent individual.",
      "belongsToAnalysis": {
