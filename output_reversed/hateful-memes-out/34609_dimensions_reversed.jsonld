    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d7f34dcc",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism",
      "label": "Ableism",
      "description": "Discrimination or prejudice against people with disabilities or perceived physical impairments. In this context, the meme uses the person’s weight and physical appearance to imply he is incapable of self-sufficiency or is a burden on society, which is a form of ableist thinking that reduces a person’s worth to their physical condition.",
      "belongsToAnalysis": {
