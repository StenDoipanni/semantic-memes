    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0639f2de",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the overweight person as a welfare recipient",
      "description": "The user is projected onto the visual material of the overweight young male (person), interpreting him as the subject of the text's claim ('someone's been getting more than 50 cents a day'). The meme implicitly positions the viewer as someone who recognizes or judges this person as a welfare-dependent individual, aligning with the stereotype. This projection is not explicit with deictic pronouns like 'you' or 'me', but is inferred from the user's role in consuming and interpreting the meme's harmful narrative.",
      "belongsToAnalysis": {
