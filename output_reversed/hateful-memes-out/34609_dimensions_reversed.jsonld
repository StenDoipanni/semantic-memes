    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bda33756",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: meme_file_name; hasOverallIntent: Harmful; overall-intent-description: The image depicts a shirtless, overweight young person outdoors, with overlaid text reading 'someone's been getting more than 50 cents a day.' This juxtaposition implies the person is lazy or dependent on welfare, using a common derogatory stereotype. The intent is to mock or shame the individual based on their physical appearance and assumed economic behavior, which can be harmful by reinforcing negative societal attitudes toward people who are overweight or perceived as financially struggling. The meme relies on visual and textual elements to create a demeaning narrative, potentially contributing to stigma and discrimination against individuals with obesity or those receiving public assistance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6c80e0d8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
