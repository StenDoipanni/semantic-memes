    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d46d0f87",
      "@type": "Scene",
      "instance_name": "boxing_match",
      "label": "boxing_match",
      "description": "A scene depicting a boxing match in a ring, where one boxer is delivering a punch to the other. The visual elements include two muscular boxers, a boxing ring with ropes, and overlaid text that provides context. The spatial arrangement shows the aggressor (boxer_1) on the right side of the frame, delivering a punch to the other boxer (boxer_2) who is on the left. The scene is framed to emphasize the action and the dominance of boxer_1 over boxer_2.",
      "belongsToAnalysis": {
