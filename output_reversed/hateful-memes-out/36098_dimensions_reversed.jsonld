    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_358e9474",
      "@type": "BackgroundKnowledge",
      "instance_name": "watermelon_and_fried_chicken_stereotype",
      "label": "Watermelon and Fried Chicken Stereotype",
      "description": "A racist stereotype that dehumanizes Black people by associating them with food preferences and servitude, often implying they are only worthy of such food and are subservient to white masters. This stereotype is used in the meme to imply that Black people are only valued for their labor and are punished for it by being denied basic sustenance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d3472e4e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2015bb74",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_slavery_in_america",
      "label": "Historical Slavery in America",
      "description": "The system of chattel slavery in the United States, where enslaved Africans and their descendants were forced to work on plantations, often under brutal conditions, without compensation or autonomy. The meme references this historical context by invoking the imagery of a 'master' and 'slave' relationship, where the enslaved person is punished for labor (plucking cotton) by being denied food (watermelon).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d3472e4e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3945fd93",
      "@type": "BackgroundKnowledge",
      "instance_name": "cotton_plucking_as_labour",
      "label": "Cotton Plucking as Labour",
      "description": "The historical and economic practice of harvesting cotton, often performed by enslaved people on Southern plantations in the United States, which was a grueling and physically demanding task. The meme references this specific form of labor to reinforce the idea of exploitation and punishment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d3472e4e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_21bec92d",
      "@type": "BackgroundKnowledge",
      "instance_name": "boxing_as_metaphor_for_power_hierarchy",
      "label": "Boxing as Metaphor for Power Hierarchy",
      "description": "The visual of boxing, with one fighter dominating the other, is used metaphorically to represent racial hierarchy and violence. The aggressor (boxer_1) symbolizes the dominant power structure, while the recipient of the punch (boxer_2) symbolizes the oppressed group. This metaphor is central to understanding the meme's hateful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d3472e4e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3b5b8ca0",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_hierarchy_and_violence",
      "label": "Racial Hierarchy and Violence",
      "description": "The concept that racial hierarchies have historically justified violence and oppression against marginalized groups, particularly Black people in the United States. The meme uses this concept to portray Black people as inferior and deserving of punishment for labor, reinforcing harmful racial stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d3472e4e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
