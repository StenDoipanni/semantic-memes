    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bdd4222a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The 'master' is mapped onto the aggressor boxer",
      "description": "The text refers to a 'master' who refuses to feed a watermelon. This 'master' is analogically mapped onto boxer_1, who is visually depicted as the aggressor delivering a punch, symbolizing dominance and control over the other boxer. The boxing match metaphorically represents the power dynamic of historical slavery, where the 'master' (boxer_1) holds power over the 'slave' (boxer_2).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d3472e4e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_19b3c5e1",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material as the enslaved person",
      "description": "The user is projected onto the textual material (text_chunk) which uses the first-person plural 'you' ('you pluck cotton from his field'), implying the user identifies with the enslaved person being punished by the master. The user sees themselves as the one who performed the labor (plucking cotton) and is now being denied sustenance (watermelon) by the master, who is symbolized by the aggressor boxer (boxer_1).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d3472e4e"
      },
      "extractionMethod": "llm_extraction_huggingface"
