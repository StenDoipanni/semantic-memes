    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3c0b6240",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Robert De Niro is mapped as the person who should be removed",
      "description": "The text sarcastically asks 'you wanna get rid of them too?' after stating 'black people were around during slavery', implying that Robert De Niro (the visual entity) represents or stands for Black people in this hateful context. The meme uses De Niro's image to symbolize the group being targeted by the racist trope, creating an analogical mapping where the actor is equated with Black people as a target for removal.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_03aa0dd9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_868f7460",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the rhetorical question in the text",
      "description": "The meme uses the text 'you wanna get rid of them too?' to directly address the viewer, projecting the user onto the rhetorical question. This creates an implicit 'you' that is being asked to consider the hateful implication that Black people should be removed from history, as if the user is being invited to participate in or endorse the racist logic. The projection is onto the textual material, which frames the viewer as the one who should 'get rid of them' (i.e., Black people) in response to the initial premise about removing Confederate symbols.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_03aa0dd9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
