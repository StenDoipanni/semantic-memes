    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_40b978e7",
      "@type": "Scene",
      "instance_name": "kitchen_domestic_task",
      "label": "kitchen_domestic_task",
      "description": "A domestic kitchen scene where two people are engaged in food preparation tasks. The woman is actively chopping vegetables on a cutting board, while the man is also chopping vegetables nearby. The scene is set in a modern kitchen with visible countertops, shelves, and appliances, suggesting a typical household environment. The text overlay humorously implies that the dishwasher is 'chopping vegetables,' which is absurd and reinforces gendered stereotypes about domestic labor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_591741a0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eef28cce",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_stereotype_belongs_in_kitchen",
      "label": "Misogynous Stereotype: 'Belongs in Kitchen'",
      "description": "This stereotype implies that women are expected to handle domestic tasks like food preparation, and that their roles are confined to the kitchen. The meme humorously reinforces this by suggesting the dishwasher is 'acting weird' by chopping vegetables — an activity typically associated with women — thereby implying that appliances should not 'act' like women. This stereotype is a form of misogynous content that devalues women by confining them to domestic labor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_591741a0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5727468e",
      "@type": "BackgroundKnowledge",
      "instance_name": "gendered_domestic_role_stereotype",
      "label": "Gendered Domestic Role Stereotype",
      "description": "This stereotype assigns specific domestic tasks to men and women based on gender, often portraying women as the primary caregivers and cooks. The meme relies on this by having the man claim the dishwasher is 'chopping vegetables,' which is a task stereotypically associated with women, thus reinforcing the idea that women are the ones who should be doing such work. The humor comes from the absurdity of an appliance mimicking a gendered role.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_591741a0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8a0ef5ba",
      "@type": "BackgroundKnowledge",
      "instance_name": "absurdity_through_gendered_role_reversal",
      "label": "Absurdity Through Gendered Role Reversal",
      "description": "The meme uses the absurdity of an appliance (dishwasher) performing a human task (chopping vegetables) to highlight and mock gendered expectations. The humor is derived from the incongruity of a machine mimicking a traditionally female activity, which is presented as 'weird' — a term that implies the appliance is behaving in a way that is 'unusual' or 'wrong' because it mimics a gendered role. This relies on the audience understanding the social norms around gendered labor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_591741a0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a9204244",
      "@type": "EmotionExpression",
      "instance_name": "amusement",
      "label": "the amused emotion",
      "description": "The woman is smiling while looking down at her task, suggesting she finds the situation or the man's comment humorous or absurd. Her expression conveys lighthearted amusement at the joke being made about the dishwasher.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_591741a0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d423a75b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The dishwasher is mapped to the man",
      "description": "The text 'him: the dishwasher is acting weird' maps the dishwasher (an appliance) onto the man in the image. The man is visually depicted performing a domestic task (chopping vegetables), which is humorously attributed to the dishwasher. This mapping relies on the visual of the man chopping vegetables to represent the 'weird' behavior of the dishwasher, creating an absurd analogy where the appliance is 'acting' like a person (specifically, a man) doing a task.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_591741a0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_65ea52dc",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman in the kitchen scene",
      "description": "The user is projected onto the woman in the image, as the meme's humor and the 'her: what's it doing?' text imply the user is identifying with her perspective or role in the domestic scene. The woman is visually depicted as the one performing the domestic task (chopping vegetables), and the text dialogue positions her as the one questioning the absurdity of the dishwasher's 'behavior'. This projection aligns with the 'belongs in kitchen' trope, where the user sees themselves as the one expected to handle such tasks, or as the one being subjected to the gendered expectations being mocked.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_591741a0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_981fd9ab",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Mysogynous",
      "description": "The meme perpetuates the 'belongs in kitchen' stereotype by humorously implying that the dishwasher is 'acting weird' by chopping vegetables — an activity stereotypically associated with women. This reinforces gendered expectations and devalues women by confining them to domestic labor, which is a form of misogynous content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_591741a0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e59ce926",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who are familiar with and may find humor in gendered stereotypes about domestic labor, particularly the 'belongs in kitchen' trope. The meme relies on the audience understanding the social norms around gendered roles in the home, where women are stereotypically expected to handle food preparation. The humor is derived from the absurdity of an appliance mimicking a traditionally female activity, which is presented as 'weird' — a term that implies the appliance is behaving in a way that is 'unusual' or 'wrong' because it mimics a gendered role. This requires the audience to recognize and internalize the stereotype being mocked. The meme is designed for an audience that finds amusement in reinforcing or subverting these stereotypes, often through the lens of domestic absurdity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_591741a0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
