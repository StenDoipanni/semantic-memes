    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e14288a9",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_primate_comparison",
      "label": "Anti-Black Stereotype: Comparing Black People to Primates",
      "description": "This stereotype, historically used in racist discourse, equates Black people with monkeys or apes to demean their humanity and intelligence. The meme's 'spot the difference' format, when applied to baboons, implicitly invokes this harmful comparison, even if not explicitly racist in intent, as it normalizes the visual trope that has been weaponized against Black people.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dfce7a70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_745ce6c5",
      "@type": "BackgroundKnowledge",
      "instance_name": "spot_the_difference_meme_format",
      "label": "Spot the Difference Meme Format",
      "description": "A popular internet meme format that challenges viewers to identify subtle differences between two similar images. The format relies on visual comparison and engagement, but when paired with imagery that evokes racial stereotypes, it can unintentionally reinforce harmful analogies.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dfce7a70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a6e1793c",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_stereotype_historical_context",
      "label": "Historical Context of Racial Stereotypes",
      "description": "The use of primate imagery to demean Black people has deep roots in American and global racist history, including minstrelsy, scientific racism, and media caricatures. Understanding this context is necessary to interpret why the meme format, when applied to baboons, carries potential harm.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dfce7a70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fa1cec18",
      "@type": "EmotionExpression",
      "instance_name": "challenging_curiosity",
      "label": "curious challenge emotion",
      "description": "The text 'spot the difference' combined with the chaotic, densely packed baboons creates an emotional cue of playful challenge and curiosity, inviting the viewer to engage in a visual puzzle. The baboons' open mouths and expressive faces amplify this by suggesting a sense of urgency or collective vocalization, which can be interpreted as a humorous or mischievous call to action.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dfce7a70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8f45c810",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "spot the difference text maps to baboons",
      "description": "The text 'spot the difference' is overlaid on the image of a large crowd of baboons, creating an analogical mapping where the viewer is invited to perceive the baboons as a visual puzzle. This mapping implicitly equates the baboons with a human-like 'difference' to be spotted, leveraging the meme format to engage the viewer while invoking the historical racial stereotype of equating Black people with primates. The mapping is established through spatial adjacency and the meme's inherent challenge structure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dfce7a70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c1668090",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual material of baboons",
      "description": "The user is projected onto the visual material of the baboons, as the meme format 'spot the difference' implicitly invites the viewer to engage with the image as if they are the one spotting the difference. This engagement creates a semiotic projection where the user is positioned as the active observer and participant in the visual puzzle, even though no explicit deictic pronoun like 'you' or 'me' is present. The projection is onto the visual material (baboons) because the task is to visually compare and identify differences within the scene.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dfce7a70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_92ff56b2",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme format 'spot the difference' applied to baboons implicitly invokes the harmful historical stereotype of equating Black people with primates, which has been used to demean their humanity and intelligence. Although the image itself does not contain explicit racist imagery, the analogical mapping and semiotic projection normalize a dehumanizing trope that has been weaponized against Black people, making it potentially harmful in context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dfce7a70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
