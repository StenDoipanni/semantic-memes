    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_57b0ddc2",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_hypersexualization",
      "label": "Anti-Black Stereotype: Hypersexualization",
      "description": "The meme uses the phrase 'hold my hookah pipe!' in conjunction with the image of a Black woman discussing interracial marriage, implying that she is being 'held' or controlled by a male perspective. This is a form of hypersexualization, as it reduces her to an object of male desire or control, reinforcing the stereotype that Black women are sexually available or must be 'held' by men. This stereotype is part of a broader pattern of racialized sexual objectification of Black women.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d1224537"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9abbbc6f",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_interracial_marriage",
      "label": "Anti-Black Stereotype: Interracial Marriage",
      "description": "The meme references the idea that 'too many of our brothers are not marrying our sisters,' which is a racially coded statement implying that Black women are not desirable or 'good enough' for interracial unions. This stereotype suggests that Black women are inferior or less desirable when compared to white women, and that their value is diminished if they do not marry within their own race. This is a form of racial discrimination that targets Black women specifically.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d1224537"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9a3d842f",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_stereotype_gold_digger",
      "label": "Misogynous Stereotype: Gold Digger",
      "description": "The meme implies that Black women are not marrying 'their own kind' because they are 'not good enough' or 'not desirable' for interracial unions, which is a misogynous stereotype that suggests Black women are only valuable if they marry within their own race. This is a form of 'gold digger' accusation, where Black women are portrayed as being only interested in marrying for financial gain or social status, rather than for love or compatibility. This stereotype is used to demean Black women and reinforce racial and gender-based discrimination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d1224537"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d06bfd26",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_stereotype_objectification",
      "label": "Misogynous Stereotype: Objectification",
      "description": "The meme uses the phrase 'hold my hookah pipe!' to imply that the Black woman is being 'held' or controlled by a male perspective, which is a form of objectification. This stereotype reduces her to an object of male desire or control, rather than recognizing her as a person with agency and autonomy. This is a form of misogynous objectification that reinforces the idea that Black women are only valuable if they are controlled or dominated by men.",
      "belongsToAnalysis": {
