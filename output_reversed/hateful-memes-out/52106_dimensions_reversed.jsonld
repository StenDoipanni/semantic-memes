    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7bc548bd",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_tropes",
      "label": "Islamophobic Stereotypes",
      "description": "The meme relies on the harmful stereotype that Muslims, particularly those associated with the Quran, are inherently linked to terrorism or barbarism. This is a common Islamophobic trope used to dehumanize and fearmonger against Muslim communities. The image of boys studying the Quran is juxtaposed with this stereotype to imply that these boys are dangerous or incompatible with Western values, which is a direct attack on the Muslim community.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81cbdcc8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_80212543",
      "@type": "BackgroundKnowledge",
      "instance_name": "rohingya_refugee_context",
      "label": "Rohingya Refugee Crisis",
      "description": "The Rohingya are a Muslim ethnic minority primarily from Myanmar, who have faced severe persecution, including statelessness, violence, and forced displacement. Understanding their status as refugees is essential to contextualize the image — it is not merely about boys studying, but about a vulnerable, displaced population. The meme uses this context to reinforce negative stereotypes about Muslims by associating them with refugees, which can be used to justify exclusion or hostility.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81cbdcc8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a020ef9f",
      "@type": "BackgroundKnowledge",
      "instance_name": "quran_as_symbol",
      "label": "Quran as Religious Text",
      "description": "The Quran is the central religious text of Islam, and studying it is a core religious practice for Muslims. The image depicts boys engaged in this legitimate religious activity. However, the meme uses this to imply that such religious practice is threatening or incompatible with Western values — a distortion that requires external knowledge of Islamic practices to understand the harmful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81cbdcc8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_83977dea",
      "@type": "BackgroundKnowledge",
      "instance_name": "western_values_concept",
      "label": "Western Values",
      "description": "The meme implies that the boys are 'incompatible with Western values' — a concept that requires external knowledge of Western cultural norms and political ideologies. This is a key part of the meme’s harmful message, as it frames the boys as a threat to the social order of Western societies, which is a common xenophobic trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81cbdcc8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6de10dcb",
      "@type": "EmotionExpression",
      "instance_name": "piousness",
      "label": "the pious emotion",
      "description": "The boys are deeply engaged in studying the Quran, wearing traditional head coverings, and displaying focused concentration — all indicative of a pious and reverent emotional state rooted in religious devotion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81cbdcc8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1160d54e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Rohingya refugee boys are mapped as the subjects of the study",
      "description": "The text 'rohingya refugee boys' explicitly identifies the visual subjects — the group of boys seated and studying — establishing a direct analogical mapping between the textual label and the visual entity. This mapping anchors the entire meme's harmful intent by labeling the visual subjects with a specific identity (Rohingya refugee boys) that is then used to reinforce negative stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81cbdcc8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d242b837",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of Rohingya refugee boys studying the Quran",
      "description": "The user is projected onto the visual scene of the boys studying, as the meme uses the image to evoke a specific emotional or ideological response. The user is implicitly invited to see the boys as representatives of a group (Muslim refugees) that is framed as incompatible with Western values, thus projecting the user's own biases or fears onto the scene. There are no explicit deictic pronouns like 'you' or 'me', but the framing of the image and text creates an implicit projection where the user is positioned as a viewer who must confront or judge the scene, reinforcing the meme's harmful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81cbdcc8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4522e46b",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Islamophobia",
      "description": "The meme uses the image of Rohingya refugee boys studying the Quran to reinforce harmful stereotypes that associate Muslims with terrorism or barbarism, implying they are inherently dangerous or incompatible with Western values. This is a direct attack on the Muslim community and contributes to Islamophobia.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81cbdcc8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_561884a2",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed to target non-Muslim, Western audiences who may hold Islamophobic or xenophobic views. It uses the image of Rohingya refugee boys studying the Quran to provoke fear and hostility toward Muslims, particularly by associating them with terrorism or barbarism — a common trope used to dehumanize and justify exclusion. The target audience is likely individuals who are susceptible to or reinforce these stereotypes, often those with pre-existing biases against Islam or Muslim communities, and who may be influenced by media narratives that frame Muslims as a threat to Western values.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81cbdcc8"
      },
      "extractionMethod": "llm_extraction_huggingface"
