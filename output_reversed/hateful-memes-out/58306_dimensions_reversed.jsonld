    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5a17c918",
      "@type": "EmotionExpression",
      "instance_name": "accusatory_confrontation",
      "label": "accusatory emotion",
      "description": "The overall scene conveys an accusatory tone, with text overlays making direct accusations against Hillary Clinton regarding her alleged actions with emails and phones. The confrontational framing, combined with the text, expresses a strong accusatory emotion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_13ba4a8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_134fb170",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Hillary Clinton is mapped as the subject of accusations",
      "description": "The text 'let me stop you right there hillary' directly addresses Hillary Clinton, who is visually depicted in the image. This creates an analogical mapping where the textual entity 'hillary' is mapped onto the visual entity 'Hillary_Clinton', establishing her as the target of the accusation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_13ba4a8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_89f32aaf",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_2",
      "label": "Hillary Clinton is mapped as the person accused of deleting emails and destroying phones",
      "description": "The bottom text 'you deleted 34,000 emails, used WeChat on hard drives, then destroyed phones with hammers you have no right to talk about people hiding anything' explicitly accuses Hillary Clinton. The visual depiction of her speaking at a podium, combined with the accusatory text, maps her as the person being accused of these actions, even though the claims are false.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_13ba4a8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a0605841",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_3",
      "label": "The scene is mapped as an accusatory confrontation",
      "description": "The overall scene, composed of Hillary Clinton speaking with text overlays making accusations, is mapped onto the textual concept of 'accusatory_confrontation'. The visual elements (her expressions, gestures, and the setting) are used to represent the textual idea of being confronted with accusations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_13ba4a8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8e6cda77",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the accusatory confrontation scene",
      "description": "The user is projected onto the scene of accusatory confrontation, where the text overlays directly address the viewer ('you deleted 34,000 emails... you have no right to talk about people hiding anything') and imply the user is the one making accusations or being the one who should be held accountable. The phrase 'let me stop you right there hillary' also positions the viewer as the one speaking to Hillary Clinton, creating a direct address to the user.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_13ba4a8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_93ee24ba",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_2",
      "label": "User projected onto the textual accusation",
      "description": "The bottom text 'you deleted 34,000 emails, used WeChat on hard drives, then destroyed phones with hammers you have no right to talk about people hiding anything' explicitly uses 'you' to address the viewer, projecting the user as the one who is accused of the actions described. This creates a direct projection of the user onto the textual accusation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_13ba4a8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_42129c9c",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme promotes misinformation and conspiracy theories about Hillary Clinton, implying she deleted emails and destroyed devices to conceal wrongdoing. This can damage her reputation and contribute to political polarization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_13ba4a8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_30a77037",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "political_partisan_audience",
      "description": "The meme is designed for an audience that is politically engaged, particularly those who are critical of Hillary Clinton and supportive of conspiracy theories or misinformation about her. The accusatory tone, reference to the 2016 email controversy, and false claims about her actions (deleting emails, using WeChat, destroying phones) are tailored to resonate with individuals who distrust Clinton and believe in political cover-ups. The meme leverages existing political polarization and uses exaggerated claims to provoke emotional reactions, making it most effective for audiences already predisposed to view Clinton negatively.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_13ba4a8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_93e65d4f",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "conspiracy_theory_enablers",
      "description": "The meme targets individuals who are drawn to or actively promote conspiracy theories, particularly those related to political figures. The false claims about Clinton deleting emails and destroying phones with hammers are hyperbolic and sensationalized, designed to appeal to audiences who enjoy or believe in dramatic, outlandish narratives about political misconduct. The phrase 'truth uncensored' further signals that the meme is intended for those who value unfiltered, often unverified, political commentary.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_13ba4a8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b3fbf8fe",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "social_media_political_commentators",
      "description": "The meme is crafted for users of social media platforms who engage in political discourse, often sharing and reacting to satirical or exaggerated content. The visual format (text overlays on images of Clinton speaking) is optimized for quick consumption and sharing on platforms like Twitter, Facebook, or Reddit. The meme’s satirical tone and use of political rhetoric make it appealing to users who enjoy mocking or criticizing political figures through memes, especially those who are familiar with the 2016 email controversy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_13ba4a8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8fa5928d",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "political_disinformation_consumers",
      "description": "The meme is designed for audiences who are susceptible to or actively seek out political disinformation. The false claims about Clinton’s actions (deleting 34,000 emails, using WeChat, destroying phones) are presented as factual, appealing to individuals who may not critically evaluate the accuracy of the information. The meme’s structure—using visual cues (Clinton speaking at a podium) and accusatory text—reinforces the false narrative, making it effective for audiences who are more likely to accept sensationalized claims without verification.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_13ba4a8e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
}