    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c3499e81",
      "@type": "BackgroundKnowledge",
      "instance_name": "Parkinson_s_disease",
      "label": "Parkinson's disease",
      "description": "A progressive neurological disorder that affects movement, often causing tremors, stiffness, and difficulty with balance. It is not a game or a condition that can be 'won' through simple activities. The meme's reference to a 'game center' for Parkinson's disease is misleading and potentially harmful as it trivializes the serious medical condition and the daily challenges faced by those living with it.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_77fb89e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6d3b2911",
      "@type": "BackgroundKnowledge",
      "instance_name": "Therapeutic_recreation_for_Parkinson_s_disease",
      "label": "Therapeutic recreation for Parkinson's disease",
      "description": "Activities such as puzzles, games, and physical exercises are sometimes used in occupational or physical therapy for Parkinson's patients to improve motor skills, cognitive function, and quality of life. However, these are not 'games' that can be 'won' or trivialized as such. The meme misrepresents the purpose and seriousness of such therapeutic activities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_77fb89e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_324eab87",
      "@type": "BackgroundKnowledge",
      "instance_name": "Inspiration_porn",
      "label": "Inspiration porn",
      "description": "A term used to describe media that portrays people with disabilities as inspirational or heroic for simply performing everyday tasks, often ignoring the challenges they face. The meme's framing of a Parkinson's patient 'winning' a game can be seen as a form of inspiration porn, which can be patronizing and reduce the lived experience of disability to a simplistic, uplifting narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_77fb89e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_403d5740",
      "@type": "BackgroundKnowledge",
      "instance_name": "Stereotype_of_Parkinson_s_disease_as_a_game_or_fun_challenge",
      "label": "Stereotype of Parkinson's disease as a 'game' or 'fun challenge'",
      "description": "This is a harmful stereotype that trivializes the condition by implying it can be easily managed or 'won' through simple activities. It ignores the progressive, debilitating nature of Parkinson's disease and can be deeply insensitive to those living with it.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_77fb89e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_731b1f2d",
      "@type": "BackgroundKnowledge",
      "instance_name": "Trivialization_of_neurological_disorders",
      "label": "Trivialization of neurological disorders",
      "description": "The act of reducing serious medical conditions to simple, lighthearted activities or games. This can be offensive and misleading, as it fails to acknowledge the complexity and severity of the conditions and can contribute to stigma or misunderstanding.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_77fb89e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_78342ac3",
      "@type": "BackgroundKnowledge",
      "instance_name": "Meme_culture_and_its_potential_for_harm",
      "label": "Meme culture and its potential for harm",
      "description": "Memes are often used to convey humor or commentary, but they can also perpetuate harmful stereotypes or misinformation. This meme, while seemingly lighthearted, can be harmful by trivializing a serious medical condition and potentially causing offense or misunderstanding to those affected.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_77fb89e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
