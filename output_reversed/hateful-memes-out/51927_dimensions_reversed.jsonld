    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ed1b96b8",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogyny_stereotype",
      "label": "Misogynous Stereotype: 'Belongs in kitchen'",
      "description": "The term 'princess' in the context of 'chocolate paradise princess' combined with the chef's professional setting implies a gendered stereotype that women are relegated to domestic or nurturing roles, such as being 'princesses' who belong in kitchens. This stereotype is rooted in historical and cultural norms that have historically confined women to domestic spheres, contrasting with the professional, skilled role of a chef, which is typically associated with men in traditional portrayals.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b4a00222"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_17782ca1",
      "@type": "BackgroundKnowledge",
      "instance_name": "objectification_stereotype",
      "label": "Objectification Stereotype: 'Princess' as a diminutive title",
      "description": "The use of 'princess' as a title for a person, especially in a context involving food and indulgence ('chocolate paradise'), is a form of objectification. It reduces the person to a role or status associated with being pampered, infantilized, or valued for aesthetic or sensual qualities rather than their agency or competence. This is a common trope in media and advertising, often used to demean or infantilize women.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b4a00222"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
