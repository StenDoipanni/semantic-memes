    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bc36d278",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "Albert is the chocolate paradise princess",
      "description": "The text 'hello chocolate paradise princess' is mapped onto the chef (Albert) in the image, implying that he is being addressed as 'chocolate paradise princess'. This is an analogical mapping where the textual entity 'chocolate paradise princess' is projected onto the visual entity 'chef'. The mapping is created through the juxtaposition of the text with the visual of the chef presenting dessert, and the bottom text 'i'm albert' confirms the identity of the chef as Albert, making the mapping explicit. This mapping is ironic and condescending, as it uses a gendered, infantilizing title ('princess') to refer to a professional chef, creating a humorous or mocking contrast.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b4a00222"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_54e5a1b4",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the chef as 'chocolate paradise princess'",
      "description": "The user is projected onto the chef (Albert) through the textual material 'hello chocolate paradise princess' and 'i'm albert'. The meme uses the chef as the subject of the address, implying the user is being humorously or condescendingly addressed as 'chocolate paradise princess'. The bottom text 'i'm albert' confirms the chef's identity and anchors the projection. The projection is onto the VisualMaterial entity 'chef' and the TextualMaterial entity 'top_text', creating an ironic and condescending tone.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b4a00222"
      },
      "extractionMethod": "llm_extraction_huggingface"
