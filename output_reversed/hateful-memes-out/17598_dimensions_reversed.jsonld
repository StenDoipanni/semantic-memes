      "instance_name": "origami_brain",
      "label": "object",
      "description": "A yellow origami sculpture shaped like a human brain, with geometric folds and facets, positioned centrally in the image. It is the primary visual element and serves as a metaphor for intelligence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d28773a7"
