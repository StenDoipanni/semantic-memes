    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f7d05b5a",
      "@type": "Scene",
      "instance_name": "intelligence_metaphor_scene",
      "label": "Scene of intelligence metaphor",
      "description": "The scene depicts a yellow origami brain as a visual metaphor for intelligence, positioned centrally against a plain background. The text overlay provides context, humorously contrasting a low IQ score with high status in a small community. The spatial arrangement centers the origami brain, with the text positioned above it, creating a composition that emphasizes the brain as the focal point of the intelligence metaphor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d28773a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0a4d3a79",
      "@type": "BackgroundKnowledge",
      "instance_name": "intelligence_mockery",
      "label": "Intelligence Mockery",
      "description": "The meme humorously mocks the concept of intelligence by juxtaposing a low IQ score (80) with the idea of being the 'highest in your village,' implying that intelligence is relative and context-dependent. This relies on the real-world stereotype that intelligence is often mocked or undervalued when it is not recognized as exceptional in a specific social or cultural context. The meme uses this stereotype to create humor by highlighting the absurdity of such a situation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d28773a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_53fa4bef",
      "@type": "BackgroundKnowledge",
      "instance_name": "relative_intelligence_concept",
      "label": "Relative Intelligence Concept",
      "description": "The meme relies on the real-world understanding that intelligence is often perceived as relative within a specific community or social group. An IQ score of 80 is considered below average in many global contexts, but in a small village with limited education or exposure to advanced knowledge, it may be perceived as exceptionally high. This concept is central to the meme's humor and requires background knowledge about how intelligence is measured and perceived differently across cultures and social strata.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d28773a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1c8029cc",
      "@type": "BackgroundKnowledge",
      "instance_name": "iq_score_context",
      "label": "IQ Score Context",
      "description": "The meme references the concept of IQ (Intelligence Quotient) as a standardized measure of cognitive ability. An IQ score of 80 is generally considered below average (average is 100), and the meme's humor stems from the contrast between this score and the implied social status of being the 'highest in your village.' This requires background knowledge about IQ scoring systems and their interpretation in different cultural and educational contexts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d28773a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_93c77f35",
      "@type": "BackgroundKnowledge",
      "instance_name": "village_context",
      "label": "Village Context",
      "description": "The meme uses the concept of a 'village' to imply a small, close-knit community with limited exposure to diverse knowledge or advanced education. This context is crucial for understanding the humor, as it suggests that intelligence is not measured by global standards but by local norms. The background knowledge required includes understanding how social structures and educational opportunities vary in rural or isolated communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d28773a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2bc21295",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism_stereotype",
      "label": "Ableism Stereotype",
      "description": "The meme implicitly references the ableist stereotype of mocking intellectual ability, which is categorized under 'Intelligence mockery' in the provided knowledge base. While the meme is not explicitly targeting any specific group, its humor may unintentionally reinforce ableist stereotypes by making light of intellectual achievement, which can be perceived as dismissive or demeaning in certain contexts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d28773a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
