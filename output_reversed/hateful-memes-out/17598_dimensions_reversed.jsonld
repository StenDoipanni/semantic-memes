      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d8ae777f",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme humorously mocks the concept of intelligence by juxtaposing a low IQ score (80) with the idea of being the 'highest in your village,' implying that intelligence is relative and context-dependent. This relies on the real-world stereotype that intelligence is often mocked or undervalued when it is not recognized as exceptional in a specific social or cultural context. The meme uses this stereotype to create humor by highlighting the absurdity of such a situation. While not explicitly targeting any specific group, it may unintentionally reinforce ableist stereotypes by making light of intellectual achievement, which can be perceived as dismissive or demeaning in certain contexts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d28773a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_36aeb8ea",
      "@type": "TargetCommunity",
      "instance_name": "person",
      "label": "individuals with above-average intelligence in small communities",
      "description": "The meme targets individuals who possess an IQ score that is considered below average (e.g., 80) in a global or urban context but is perceived as exceptionally high within their local, often rural or isolated, community (e.g., a village). The humor arises from the relatable experience of feeling intellectually superior in a context where such ability is not recognized or valued, making it particularly resonant with people who have experienced this social dynamic.",
      "belongsToAnalysis": {
