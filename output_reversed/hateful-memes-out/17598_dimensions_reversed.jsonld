    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_97d60ac2",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The text maps the concept of 'intelligence' to the origami brain",
      "description": "The textual material 'when you have an 80 point iq but it's the highest in your village' explicitly refers to intelligence (via 'iq'), and this concept is visually represented by the origami brain, which is a common metaphor for the brain and thus intelligence. The mapping is established through the juxtaposition of the text describing intelligence and the visual object symbolizing it.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d28773a7"
      },
