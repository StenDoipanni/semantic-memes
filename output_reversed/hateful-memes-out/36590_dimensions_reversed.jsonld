    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4399410d",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals who hold Islamophobic views or are influenced by anti-Muslim sentiment, particularly those who support or are sympathetic to calls for banning religious attire like the niqab in public spaces. The meme is designed to resonate with people who perceive the niqab as incompatible with Western values and who may be predisposed to view Muslim women wearing it as a threat or as oppressed individuals. The confrontational tone and direct question 'do you agree?' are aimed at provoking agreement from this audience, who are likely to be part of broader communities that support exclusionary policies based on religious or cultural grounds.",
      "belongsToAnalysis": {
