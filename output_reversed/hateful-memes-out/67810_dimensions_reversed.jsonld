    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2127b5e6",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Liberals are mapped onto Sheldon Cooper",
      "description": "The top text 'why are liberals so angry?' is mapped onto the visual of Jim Parsons as Sheldon Cooper. The meme uses Sheldon's sarcastic and annoyed expression to visually represent the stereotype that liberals are 'angry,' implying that the character (and by extension, the group he represents) is the source of the anger being questioned. This is an analogical mapping where the textual entity 'liberals' is projected onto the visual entity 'Sheldon Cooper' through the character's demeanor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_76bc8b95"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2fa8ee93",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the sarcastic reaction scene",
      "description": "The user is projected onto the visual scene of Jim Parsons as Sheldon Cooper, who is depicted with a sarcastic and annoyed expression. This expression is used to represent the stereotype that liberals are 'angry,' and the user is implicitly identifying with or projecting their own perception of this stereotype onto the character's demeanor. The meme's structure invites the user to see themselves as the one questioning or reacting to the 'angry liberals' stereotype, thereby projecting their own viewpoint onto the visual material.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_76bc8b95"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
