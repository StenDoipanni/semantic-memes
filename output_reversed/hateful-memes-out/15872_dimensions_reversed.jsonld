    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9325a51a",
      "@type": "BackgroundKnowledge",
      "instance_name": "suicide_bombing",
      "label": "Suicide Bombing",
      "description": "A terrorist act in which an individual detonates an explosive device while killing themselves, often targeting civilians or military personnel. This concept is central to the meme's text, which references 'suicide bombin' as a 'job' one comes home from, implying normalization of terrorism. It requires real-world knowledge of terrorism, its methods, and its moral and legal condemnation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54bb18a9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_33f58028",
      "@type": "BackgroundKnowledge",
      "instance_name": "terrorism",
      "label": "Terrorism",
      "description": "The use of violence or intimidation, especially against civilians, to achieve political, religious, or ideological goals. The meme implicitly references terrorism as a normalized activity, which requires understanding of its real-world implications, including international law, human rights violations, and societal condemnation.",
      "belongsToAnalysis": {
