    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_71ac1d23",
      "@type": "BackgroundKnowledge",
      "instance_name": "wife_look_stereotype",
      "label": "Wife Look Stereotype",
      "description": "A cultural trope depicting a spouse (often a wife) giving a calm, disapproving, or judgmental look to a partner upon their return home, especially after a day of work or problematic behavior. This stereotype is used in the meme to contrast the mundane 'return home' with the horrific act of suicide bombing, creating dark humor. It relies on real-world social dynamics and gendered expectations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54bb18a9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4ab0af1d",
      "@type": "BackgroundKnowledge",
      "instance_name": "dark_humor",
      "label": "Dark Humor",
      "description": "Humor derived from morbid, taboo, or distressing subjects, often used to shock or provoke. The meme uses dark humor to mock the normalization of terrorism by framing it as a 'job' with a domestic consequence. Understanding this requires knowledge of comedic conventions and their potential to trivialize serious issues.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54bb18a9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9b447b66",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia",
      "label": "Islamophobia",
      "description": "Prejudice, fear, or hatred directed at Muslims or those perceived to be Muslim. The meme implicitly references Islamophobia by associating suicide bombing with a 'wife' (a gendered and culturally specific trope often used in anti-Muslim rhetoric), thereby reinforcing harmful stereotypes that link terrorism to Islam. This requires understanding of real-world anti-Muslim bias and its manifestations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54bb18a9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8739c357",
      "@type": "BackgroundKnowledge",
      "instance_name": "normalization_of_terrorism",
      "label": "Normalization of Terrorism",
      "description": "The process by which acts of terrorism are portrayed as routine, acceptable, or even mundane, thereby reducing their moral and legal weight. The meme attempts to normalize suicide bombing by comparing it to a 'job' and framing the wife's look as a domestic consequence, which requires understanding of how media and satire can perpetuate dangerous ideologies.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54bb18a9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fb1f3300",
      "@type": "EmotionExpression",
      "instance_name": "disapproval",
      "label": "disapproving emotion",
      "description": "The woman's facial expression conveys mild disapproval or judgment, characterized by a neutral to slightly downturned mouth and direct, unsmiling gaze. This expression is commonly interpreted as a 'wife look' in memes, indicating disappointment or criticism toward the person being addressed.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54bb18a9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3b1187d1",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The wife's disapproving look is mapped onto the textual description of her reaction",
      "description": "The text 'and your wife gives you this look' explicitly identifies the visual entity (the woman) as the 'wife' who is giving a disapproving look. The visual material (the woman's expression) is directly mapped onto the textual description of her role and action, creating an analogical mapping where the visual entity embodies the textual entity. This mapping is reinforced by the spatial positioning of the text below the woman's face, directly linking her expression to the described 'look'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54bb18a9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_79bb3304",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of the wife giving a look",
      "description": "The user is projected onto the scene where the wife gives a disapproving look, as indicated by the text 'and your wife gives you this look'. The deictic 'your' directly implicates the viewer as the recipient of the wife's look, making the user the subject of the wife's reaction. The user is also implicitly projected onto the textual description of returning from suicide bombing, as the text 'when you come home from a long day of suicide bombin' uses 'you' to address the viewer as the person performing the action. The visual material of the woman's expression is mapped onto this textual description, creating a unified projection where the user is the central figure in both the textual and visual narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54bb18a9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_71da16a5",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme trivializes and normalizes acts of terrorism by framing suicide bombing as a mundane 'job' one comes home from, juxtaposed with a domestic reaction. This can desensitize viewers to the real-world consequences and moral weight of such acts, potentially contributing to a culture that minimizes or trivializes violence against civilians. It also reinforces harmful stereotypes by linking terrorism to a specific gendered domestic trope (the 'wife look'), which can perpetuate Islamophobic narratives.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54bb18a9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a1da5c23",
      "@type": "TargetCommunity",
      "instance_name": "person",
      "label": "woman",
      "description": "The intended audience is individuals who understand and recognize the dark humor and cultural trope of the 'wife look' stereotype, particularly those familiar with internet meme formats and satire that juxtapose mundane domestic scenarios with extreme violence. The meme targets viewers who are comfortable with or accustomed to dark humor that trivializes terrorism, and who may be exposed to or sympathetic to the normalization of terrorism as a 'job'—a concept that often intersects with anti-Muslim sentiment and Islamophobic stereotypes. The target community includes those who engage with or create memes that use shock value and satire to mock serious issues, potentially reinforcing harmful ideologies.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54bb18a9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
