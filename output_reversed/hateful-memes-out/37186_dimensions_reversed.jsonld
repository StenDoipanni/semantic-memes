    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7cf9ba5e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "monkey is mapped as starving mexican",
      "description": "The text 'starving mexican' explicitly maps the visual entity 'monkey' onto the human group 'Mexicans', using the monkey as a dehumanizing metaphor. This is a clear analogical mapping where the visual subject (monkey) is being equated with a specific ethnic group (Mexicans) through the text, creating a false and derogatory association.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_014dc5be"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_20902ab1",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the dehumanizing metaphor of the monkey representing a starving Mexican",
      "description": "The user is not explicitly projected onto any deictic pronoun like 'me' or 'you' in the text. However, the meme's overall intent and structure create an implicit projection where the viewer (user) is positioned as the one interpreting or witnessing the dehumanizing metaphor. The user is projected onto the visual material (the monkey) and the textual material (the phrase 'starving mexican monkey eating peanuts'), which together form a dehumanizing stereotype. The user is implicitly invited to accept or internalize the racist framing, making them a passive recipient of the projection. The projection is onto the 'monkey' as a symbol of the 'starving mexican' and onto the 'text_chunk' which explicitly states the stereotype. The user is not directly addressed, but the entire meme functions as a projection of the user's potential acceptance or perpetuation of the anti-Latino/hispanic racism and dehumanizing metaphor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_014dc5be"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
