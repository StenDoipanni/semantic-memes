    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_23481898",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_latino_hispanic_stereotype",
      "label": "Anti-Latino/Hispanic Stereotype",
      "description": "The meme relies on the stereotype that Mexicans are impoverished, primitive, and inferior, using a dehumanizing metaphor of a monkey to imply they are 'starving' and 'eating peanuts'. This stereotype is part of a broader pattern of anti-Latino/hispanic racism that includes claims of criminality, laziness, and being 'anchor babies' or job stealers. The image and text together invoke this harmful stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_014dc5be"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4b05180f",
      "@type": "BackgroundKnowledge",
      "instance_name": "dehumanizing_metaphor",
      "label": "Dehumanizing Metaphor",
      "description": "The meme uses the visual of a monkey (a non-human primate) to metaphorically represent humans (specifically Mexicans), reducing them to a level of animalism. This is a common tactic in racist rhetoric to strip a group of their humanity and dignity, making it easier to justify discrimination or hatred. The monkey is not just an animal; it is being used as a symbol of perceived primitiveness and inferiority.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_014dc5be"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eea6ca30",
      "@type": "BackgroundKnowledge",
      "instance_name": "starvation_stereotype",
      "label": "Starvation Stereotype",
      "description": "The text 'starving mexican' invokes the stereotype that Mexicans are chronically poor and hungry, implying they are unable to afford basic necessities. This is a false and harmful stereotype that perpetuates economic racism and ignores the economic diversity and achievements of the Mexican population. It is often used to justify immigration restrictions or to portray Mexicans as a burden on society.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_014dc5be"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4f0d7b07",
      "@type": "BackgroundKnowledge",
      "instance_name": "peanut_stereotype",
      "label": "Peanut Stereotype",
      "description": "The phrase 'eating peanuts' is used to imply that Mexicans are subsisting on low-quality, meager food, reinforcing the idea that they are impoverished and inferior. This is a derogatory stereotype that reduces their diet and lifestyle to something crude and unrefined, further dehumanizing them. It is often paired with 'starving' to emphasize their supposed lack of resources.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_014dc5be"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e041eb74",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_latino_hispanic_racism",
      "label": "Anti-Latino/Hispanic Racism",
      "description": "The meme is an example of anti-Latino/hispanic racism, a form of systemic discrimination targeting people of Latin American descent. It uses racist tropes and dehumanizing imagery to portray Mexicans as primitive, lazy, and dangerous. This racism is often rooted in xenophobia, economic anxiety, and historical prejudice against Latin American immigrants in the United States and other countries.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_014dc5be"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_518ea342",
