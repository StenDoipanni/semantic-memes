    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d2459813",
      "@type": "EmotionExpression",
      "instance_name": "frustration",
      "label": "frustrated emotion",
      "description": "The facial expression of Oprah Winfrey, characterized by furrowed brows, narrowed eyes, and slightly parted lips, conveys a strong sense of frustration. This expression visually communicates the internal conflict of being caught in an awkward situation — needing to urgently attend to a bodily function while being spoken to — which is the core of the meme’s humor.",
