    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2727a8ea",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The person in the image is mapped as someone experiencing an urgent bodily need while being spoken to.",
      "description": "The text 'when someone is talkin to you and you gotta shit' explicitly describes a scenario involving an urgent bodily need during a conversation. The visual material, specifically the person (Oprah Winfrey) with a frustrated and annoyed facial expression, is mapped onto this textual scenario. The expression visually represents the internal conflict and discomfort described in the text, creating an analogical mapping where the person's emotional state and physical presence are used to embody the situation described in the text. This mapping is central to the meme’s humor and relatability, as it uses the person’s expressive face to represent the universal experience of being caught in an awkward moment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_42f06420"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4b854ee2",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of urgent bodily need while being spoken to",
      "description": "The user is projected onto the scene described in the meme, where they identify with the experience of being interrupted or having to urgently attend to a bodily need while engaged in a conversation. This projection is facilitated by the text 'when someone is talkin to you and you gotta shit', which uses second-person address ('you') to directly involve the viewer in the scenario. The user sees themselves in the situation, and the visual material (Oprah Winfrey's frustrated expression) serves as a relatable emotional anchor for this projection. The projection is not onto a specific visual or textual element alone, but onto the entire scene (urgent_bodily_need_scene) which combines both text and visual material to create a shared, relatable experience.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_42f06420"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ba5d195e",
      "@type": "TargetCommunity",
      "instance_name": "relatable_meme_culture",
      "label": "Relatable Meme Culture",
      "description": "The meme is designed for a broad, internet-savvy audience familiar with 'relatable' humor — people who can easily identify with the universal awkwardness of being interrupted by an urgent bodily need during a conversation. This community values humor derived from shared, mundane experiences and appreciates the use of expressive public figures (like Oprah Winfrey) to amplify relatability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_42f06420"
      },
