    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2b7d699e",
      "@type": "BackgroundKnowledge",
      "instance_name": "pinto",
      "label": "pinto bean",
      "description": "A pinto bean is a type of legume, commonly used in Mexican and Southwestern U.S. cuisine. In the meme, it is used as a disparaging metaphor to describe the legroom of the Humvee as being as cramped as the space inside a pinto bean — implying it is extremely small and uncomfortable. This is a crude, degrading comparison that trivializes the vehicle's interior space.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8c8243de"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_773204a3",
      "@type": "BackgroundKnowledge",
      "instance_name": "shuttle_bus",
      "label": "shuttle bus",
      "description": "A shuttle bus is a type of public or private transportation vehicle, typically used for short-distance travel, often between specific locations like airports, campuses, or corporate campuses. In the meme, it is used as a comparison to the size of the Humvee, implying the vehicle is as large as a shuttle bus — which is a common, everyday vehicle. This comparison is absurd and humorous, highlighting the Humvee's large exterior size while contrasting it with its tiny interior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8c8243de"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4c8750df",
      "@type": "BackgroundKnowledge",
      "instance_name": "legroom",
      "label": "legroom",
      "description": "Legroom refers to the amount of space available for a person's legs inside a vehicle or seat. In the context of the meme, it is used to describe the cramped interior space of the Humvee, implying that passengers have very little room to stretch their legs. This is a common term used in transportation and seating contexts, and the meme uses it to highlight the vehicle's uncomfortable interior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8c8243de"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c12b6655",
      "@type": "BackgroundKnowledge",
      "instance_name": "humvee",
      "label": "High Mobility Multipurpose Wheeled Vehicle (Humvee)",
      "description": "The Humvee is a military vehicle used by the U.S. military and other armed forces. It is known for its rugged, utilitarian design and is often used in combat and support roles. In the meme, it is the subject of the comparison, and its size and legroom are being mocked. The meme uses the Humvee's real-world function and design to create a humorous and slightly insulting comparison.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8c8243de"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_921d0949",
      "@type": "EmotionExpression",
      "instance_name": "derision",
      "label": "derisive emotion",
      "description": "The meme expresses derision through absurd and degrading comparisons, mocking the Humvee's interior space by likening its legroom to that of a pinto bean, which is a crude and dismissive analogy. This tone is intended to trivialize the vehicle's design and functionality, creating humor through exaggerated insult.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8c8243de"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f3caab7f",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "size comparison",
      "description": "The top text overlay 'size of a shuttle bus' maps onto the visual entity 'humvee', suggesting that the Humvee's overall size is comparable to that of a shuttle bus, creating an absurd and humorous analogy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8c8243de"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3593afb0",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the Humvee as the subject of the degrading comparison",
      "description": "The user is projected onto the Humvee (VisualMaterial entity) as the object being mocked through the textual comparisons. The meme invites the user to imagine themselves in the cramped interior (legroom of a pinto) or to perceive the vehicle's size (size of a shuttle bus) as absurdly disproportionate, thereby projecting the user's own experience or perspective onto the vehicle as the target of the joke. There are no explicit deictic pronouns like 'me' or 'you', but the implied audience is the user viewing the meme, who is positioned as the one experiencing or imagining the humor derived from the vehicle's perceived inadequacies.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8c8243de"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eb12df56",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme uses crude, degrading analogies to mock the vehicle's interior space, implying it is cramped and uncomfortable. While not targeting any specific protected group, the intent is to create humor through exaggerated, dismissive comparisons that trivialize the vehicle's design and functionality. The humor is derived from the juxtaposition of the vehicle's rugged, utilitarian nature with the mundane, almost insulting, comparison to a pinto bean, which could be seen as demeaning to the vehicle's purpose or the people who use it. The meme's overall intent is to entertain through crude, simplistic humor, which may be perceived as insensitive or offensive by some viewers due to its dismissive tone, even if it does not directly target a marginalized group.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8c8243de"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f587b67a",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "general internet humor audience",
      "description": "The meme is designed for a broad, general internet audience familiar with military vehicles and crude, absurdist humor. The target community likely includes individuals who appreciate exaggerated, dismissive comparisons and find humor in the juxtaposition of a rugged military vehicle with mundane, insulting analogies (like comparing legroom to a pinto bean). The humor relies on simplistic, crude wit rather than specific cultural or demographic markers, making it accessible to a wide range of viewers, though potentially offensive to those sensitive to dismissive or trivializing content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8c8243de"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
