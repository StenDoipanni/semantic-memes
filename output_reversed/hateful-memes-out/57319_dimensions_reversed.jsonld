    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7bbee7b5",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "men",
      "description": "The meme is designed for a male audience, as it explicitly frames the woman as 'what men want,' leveraging hypersexualization and objectification tropes that are commonly directed at or reinforced for male viewers. The visual and textual elements (revealing referee outfit, beer, football, and the phrase 'what men want') are culturally coded to appeal to or resonate with male viewers who may identify with or enjoy such stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_22a82220"
