      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3f833cdf",
      "@type": "BackgroundKnowledge",
      "instance_name": "beer_and_football_cultural_reference",
      "label": "Beer and Football Cultural Reference",
      "description": "A common cultural association between beer consumption and football games, often implying a male-dominated, casual, and sexually charged atmosphere. The combination of beer and football in the image, along with the woman’s appearance, reinforces the stereotype of male desire and leisure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_22a82220"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_115c364f",
      "@type": "EmotionExpression",
      "instance_name": "objectified_happiness",
      "label": "objectified happiness expression",
      "description": "The woman is smiling broadly and directly at the camera, conveying a cheerful and engaging emotion. However, this happiness is framed within the context of objectification — her smile and pose are used to reinforce the stereotype that she is 'what men want,' reducing her emotional expression to a tool for male gratification rather than an authentic display of joy or agency.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_22a82220"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b2c560f1",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The woman is mapped as 'what men want'",
      "description": "The text 'what men want' is overlaid on the image of a woman dressed in a revealing football referee outfit, holding a beer and a football. This creates an analogical mapping where the woman is explicitly framed as the object of male desire, reducing her to a sexualized trope. The mapping is direct: the textual phrase 'what men want' is projected onto the visual entity (the woman), implying she embodies that stereotype. This aligns with the misogynous trope of hypersexualization and objectification, where her value is tied to her appearance and availability for male gratification.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_22a82220"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1144b9e3",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material framing the woman as 'what men want'",
      "description": "The user is projected onto the textual material 'what men want', which explicitly frames the visual material (the woman) as the object of male desire. This projection implies that the user (as a male viewer) is identifying with or imagining themselves as the subject of this desire, aligning with the misogynous trope of hypersexualization. The text acts as a direct deictic projection onto the user's perspective, suggesting the user sees themselves as the 'man' who desires the objectified woman.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_22a82220"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
