    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_96e34c29",
      "@type": "BackgroundKnowledge",
      "instance_name": "hypersexualization",
      "label": "Hypersexualization",
      "description": "A derogatory stereotype that reduces women to sexual objects, implying their value is tied to their physical appearance and availability for male gratification. This concept is central to understanding the meme's message, as the woman is portrayed in a revealing outfit and framed as 'what men want', reinforcing the idea that her worth is sexualized.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_22a82220"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b4a54d2d",
      "@type": "BackgroundKnowledge",
      "instance_name": "objectification",
      "label": "Objectification",
      "description": "The process of treating a person, especially a woman, as an object for the pleasure or gratification of others, rather than as a person with agency, competence, or intrinsic worth. The meme relies on this concept to portray the woman as a sexualized object whose value is tied to her appearance and availability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_22a82220"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_59869924",
      "@type": "BackgroundKnowledge",
      "instance_name": "mysogynous_trope",
      "label": "Misogynous Trope",
      "description": "A recurring, often harmful, stereotype or narrative that devalues women by portraying them as sexually available, emotionally unstable, or incompetent outside of traditional roles. The meme uses this trope to imply that men desire women who are hypersexualized and objectified, particularly in contexts like sports.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_22a82220"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0ec3137c",
      "@type": "BackgroundKnowledge",
      "instance_name": "football_referee_stereotype",
      "label": "Football Referee Stereotype",
      "description": "A cultural trope that associates female referees with hypersexualization and objectification, often portraying them in revealing outfits to appeal to male audiences. This stereotype is used in the meme to reinforce the idea that the woman’s role and appearance are primarily for male gratification.",
      "belongsToAnalysis": {
