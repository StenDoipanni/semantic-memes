    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_db4484b3",
      "@type": "EmotionExpression",
      "instance_name": "mocking_contempt",
      "label": "mocking contempt expressed through visual and textual elements",
      "description": "The image combines a dog wearing a Native American headdress with the text 'free blanket' and 'maybe white man not so bad after all' to convey a mocking and contemptuous attitude toward Native American culture and history. The visual of the dog in the headdress is used to trivialize and caricature Native American identity, while the text reinforces a demeaning stereotype that implies Native Americans are grateful for colonial oppression. This combination expresses contempt for Indigenous peoples and their cultural heritage.",
      "belongsToAnalysis": {
