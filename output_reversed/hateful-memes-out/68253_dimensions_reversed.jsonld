    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_46fc9930",
      "@type": "BackgroundKnowledge",
      "instance_name": "Native_American_headdress_stereotype",
      "label": "Native American headdress stereotype",
      "description": "The headdress worn by the dog is a sacred and culturally significant item in many Native American tribes, often used in ceremonial contexts. Its use in this meme trivializes its importance and perpetuates a harmful stereotype that reduces Native American identity to a costume or prop for mockery. This stereotype is rooted in historical appropriation and colonial-era caricatures.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6c45a031"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_08a9b9c4",
      "@type": "BackgroundKnowledge",
      "instance_name": "Colonialism_and_cultural_appropriation",
      "label": "Colonialism and cultural appropriation",
      "description": "The meme references the historical context of colonialism, where Native American lands and cultures were forcibly taken by European settlers. The phrase 'free blanket' alludes to the historical practice of giving blankets to Native Americans as a form of 'gift' or 'bribe' to encourage assimilation or surrender of land, which was often a coercive tactic. The meme uses this to imply that Native Americans are 'grateful' for white colonialism, which is a harmful and offensive stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6c45a031"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_57ffa5e3",
      "@type": "BackgroundKnowledge",
      "instance_name": "Racist_trope_of_Native_American_gratitude",
      "label": "Racist trope of Native American gratitude",
      "description": "This trope suggests that Native Americans are somehow 'grateful' or 'accepting' of white colonialism, implying they are inferior or subservient. It is a harmful stereotype that reinforces historical narratives of exploitation and cultural erasure, and it contributes to the ongoing marginalization and stereotyping of Indigenous peoples.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6c45a031"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_11ab1fc2",
      "@type": "BackgroundKnowledge",
      "instance_name": "Historical_context_of_Native_American_land_dispossession",
      "label": "Historical context of Native American land dispossession",
      "description": "The meme implicitly references the historical context of Native American land dispossession, where Native American tribes were forcibly removed from their ancestral lands through treaties, wars, and policies like the Indian Removal Act. The 'free blanket' trope is a metaphor for the coercive nature of these policies, which were often used to encourage Native Americans to surrender their land or assimilate into white society.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6c45a031"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6faac8cb",
      "@type": "BackgroundKnowledge",
      "instance_name": "Stereotype_of_Native_Americans_as_savages_or_uncivilized",
      "label": "Stereotype of Native Americans as 'savages' or 'uncivilized'",
      "description": "This stereotype, rooted in colonial-era propaganda, portrayed Native Americans as 'uncivilized' or 'savage' to justify their subjugation and displacement. The meme uses this stereotype to imply that Native Americans are somehow 'less than' white people, which is a harmful and offensive trope.",
      "belongsToAnalysis": {
