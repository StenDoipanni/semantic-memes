    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_258c34bc",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Tom Hardy is the authoritative figure dismissing 'snowflakes'",
      "description": "The visual of Tom Hardy with his stern, dismissive expression is mapped onto the textual concept of an authoritative figure who rejects those perceived as easily offended ('snowflakes'). The text 'move along snowflake if you're easily offended' is directly projected onto Tom Hardy's visual persona, using his image to embody the role of the dismissive authority figure. His expression and presence are used to analogically represent the textual message of exclusion and contempt.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_feaba5f2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0c5ae207",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the dismissive authority figure embodied by Tom Hardy",
      "description": "The user is projected onto Tom_Hardy, who is visually depicted as the authoritative figure dismissing 'snowflakes'. The user identifies with or imagines themselves as the authoritative figure who rejects those perceived as easily offended, using Tom Hardy's stern expression and persona as a visual stand-in for their own stance. The text 'move along snowflake if you're easily offended' is directed at the audience, and the user is implicitly positioned as the one enforcing this boundary, projecting their own identity onto Tom Hardy's image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_feaba5f2"
      },
      "extractionMethod": "llm_extraction_huggingface"
