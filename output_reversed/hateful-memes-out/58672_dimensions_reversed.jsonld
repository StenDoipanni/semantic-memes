    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_81103c9a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Textual stereotype mapped onto royal couple",
      "description": "The text 'did you know that the chinese eat dogs' and 'savages disgusting' is juxtaposed with the image of Prince Charles and Camilla, Duchess of Cornwall, at a public event. This creates an analogical mapping where the royal couple (visual material) is implicitly mapped as the entity being referenced or targeted by the offensive text (textual material). The meme uses their presence to contrast Western civility with the racist stereotype, implying the royal couple represents the moral authority that condemns the 'savages' and 'disgusting' Chinese people. The mapping is established through spatial adjacency and contextual contrast.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dd8ca698"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_477f4850",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the offensive textual material",
      "description": "The user is projected onto the textual material that contains the racist stereotypes ('did you know that the chinese eat dogs', 'savages disgusting'), as these are the elements that directly convey the hateful message and are the focal point of the meme's intent. The user is implicitly invited to accept or internalize this offensive viewpoint, making the text the primary target of the semiotic projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dd8ca698"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
