    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_69cbc00f",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The man is mapped as the person who must not blink to see the magic trick",
      "description": "The text 'when they say not to blink or you'll miss the magic trick' is mapped onto the visual of the man intensely focused on the laptop. His expression and posture visually represent the act of trying not to blink, aligning with the textual instruction. This creates an analogical mapping where the man embodies the role of the person instructed to maintain intense focus to witness a magic trick, even while performing a mundane activity like eating a banana.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b2bceab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bf7af1d8",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man in the intense focus scene",
      "description": "The user is projected onto the visual material of the Black man intensely focused on the laptop, as the meme's humor and intent rely on the viewer imagining themselves in his position—trying not to blink to witness a magic trick. The text 'when they say not to blink' implicitly addresses the viewer, inviting them to identify with the man's experience. The user is not explicitly deictic (e.g., 'you' or 'me'), but the framing and context of the meme create an implicit projection where the viewer is positioned as the person who must maintain intense focus, mirroring the man's state.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b2bceab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
