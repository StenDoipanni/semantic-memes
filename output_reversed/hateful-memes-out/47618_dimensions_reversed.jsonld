    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e0c47f9d",
      "@type": "BackgroundKnowledge",
      "instance_name": "not_blink_magic_trick_concept",
      "label": "Common Internet Meme Trope: 'Not Blinking to See Magic Trick'",
      "description": "The phrase 'when they say not to blink or you'll miss the magic trick' is a well-known internet meme trope that references the classic magic trick where the audience is instructed not to blink to avoid missing a surprise. This trope is often used humorously to describe situations where one must maintain intense focus to witness something extraordinary or unexpected. The meme uses this trope to create a humorous contrast with the mundane activity of eating a banana.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b2bceab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_16b2ec9b",
      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_stereotype_in_meme",
      "label": "Racialized Stereotype in Meme Context",
      "description": "The meme's humor is derived from the juxtaposition of the mundane (eating a banana) with the intense focus required to 'not blink,' but the racialized subject matter (a Black man) can be seen as a subtle form of racial stereotyping. This reinforces the stereotype that Black people are hyper-focused or 'always watching,' which can contribute to racial profiling or the perpetuation of negative racial tropes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b2bceab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_71155314",
