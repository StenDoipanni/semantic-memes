    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_baf5ef15",
      "@type": "BackgroundKnowledge",
      "instance_name": "white_trash_stereotype",
      "label": "White Trash Stereotype",
      "description": "A derogatory term used in American English to refer to people from lower socioeconomic backgrounds, often implying they are uneducated, lazy, or morally inferior. It is a racialized and class-based slur that targets white people who are perceived as poor or lacking in social status, often associated with rural or working-class communities. The term is used to demean and dehumanize individuals, reinforcing negative stereotypes about their character, intelligence, and behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6267a044"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4819e632",
      "@type": "BackgroundKnowledge",
      "instance_name": "recycling_behavior",
      "label": "Recycling Behavior",
      "description": "The act of separating waste materials for disposal or reuse, often to reduce environmental impact. In the context of this meme, recycling is portrayed as a positive, environmentally responsible action. However, the meme sarcastically juxtaposes this positive behavior with the derogatory label 'white trash,' implying that the act of recycling is somehow 'right' or 'acceptable' only because the person performing it is considered 'trash.' This creates a mocking tone that undermines the value of the action by associating it with a negative stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6267a044"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_531fd0f4",
      "@type": "BackgroundKnowledge",
      "instance_name": "sarcastic_praise",
      "label": "Sarcastic Praise",
      "description": "A rhetorical device where something is praised in a mocking or ironic manner to highlight its absurdity or to belittle the person or thing being praised. In this meme, the phrase 'you are doing it right' is used sarcastically to mock the person labeled 'white trash' for recycling, implying that their positive action is only 'right' because they are considered 'trash.' This form of praise is used to reinforce the negative stereotype and to ridicule the individual's perceived social status.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6267a044"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ab57c270",
      "@type": "BackgroundKnowledge",
      "instance_name": "class_based_stereotype",
      "label": "Class-Based Stereotype",
      "description": "A stereotype that associates individuals with specific social classes, often implying that people from lower socioeconomic backgrounds are inherently less capable, less intelligent, or less moral. In this meme, the term 'white trash' is used to target individuals from lower socioeconomic backgrounds, implying that their recycling behavior is somehow 'right' or 'acceptable' only because they are considered 'trash.' This reinforces the idea that their social status is inherently inferior, regardless of their actions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6267a044"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_60ea7a63",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_slur",
      "label": "Racial Slur",
      "description": "A word or phrase used to demean or insult a person or group based on their race or ethnicity. In this meme, the term 'white trash' is used as a racial slur to target white people who are perceived as poor or lacking in social status. The term is derogatory and offensive, and its use in the meme is intended to mock and demean the targeted group.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6267a044"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0555c16f",
      "@type": "EmotionExpression",
      "instance_name": "mocking_contempt",
      "label": "mocking contempt emotion",
      "description": "The emotion expressed is one of ridicule and disdain, conveyed through the sarcastic praise 'you are doing it right' juxtaposed with the derogatory label 'white trash'. This creates a tone of contempt for the targeted group, implying their positive action (recycling) is only 'right' because they are considered 'trash'. The overall intent is to demean and belittle individuals from lower socioeconomic backgrounds.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6267a044"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aec09df1",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "white trash is the person recycling",
      "description": "The text 'white trash' is mapped onto the person who is recycling, as represented by the recycling bag attached to the bicycle. The meme sarcastically implies that the person performing the positive action of recycling is labeled 'white trash', thereby associating the derogatory term with the visual material (the recycling bag and the act of recycling). This mapping is reinforced by the sarcastic praise 'you are doing it right', which further links the text 'white trash' to the visual entity of the recycling bag and the person implied to be using it.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6267a044"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1e657158",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the person implied by the 'white trash' label",
      "description": "The user is projected onto the individual (or group) being labeled 'white trash' in the meme. This projection is implied through the sarcastic praise 'you are doing it right', which directly addresses the person performing the action (recycling) and thereby positions the viewer as the one being addressed or identified with the stereotype. The user is thus projected onto the 'white trash' entity, which is visually represented by the recycling bag and the act of recycling, and is the target of the meme's mockery.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6267a044"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
