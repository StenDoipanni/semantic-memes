    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fb2e2515",
      "@type": "Scene",
      "instance_name": "physical_struggle",
      "label": "Physical Struggle Between Two Men",
      "description": "A scene depicting two men in suits engaged in a physical altercation. The Black man on the left is being grabbed by the collar by the white man on the right, who is holding him in a confrontational manner. The setting appears to be an indoor public space with glass walls and modern architecture in the background. The scene is framed by text overlays that reinforce a racial stereotype, linking the physical struggle to a metaphorical 'beat' in music.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_eb6c24e8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_db6f8291",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_aggressive_violent_nature",
      "label": "Anti-Black Stereotype: Aggressive/Violent Nature Claims",
      "description": "This stereotype falsely claims that Black people are inherently aggressive or violent, often using metaphors related to music or rhythm (e.g., 'love a good beat') to imply that their cultural expression is linked to physicality or aggression. This is a harmful and offensive racial trope used to dehumanize and justify discrimination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_eb6c24e8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8c2b5966",
      "@type": "BackgroundKnowledge",
      "instance_name": "musical_beat_metaphor",
      "label": "Metaphor: 'Beat' as Aggression",
      "description": "The phrase 'they always love a good beat' uses the concept of a musical 'beat' to imply physical rhythm or aggression, which is a culturally loaded metaphor. In this context, it is used to stereotype Black people as inherently linked to violence or physicality, despite music being a rich and diverse cultural expression.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_eb6c24e8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_21f89fc6",
      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_music_stereotype",
      "label": "Racialized Music Stereotype",
      "description": "The meme relies on the stereotype that Black people are 'musical' and that this musicality is equated with aggression or physicality. This is a harmful racial trope that reduces a cultural identity to a simplistic, negative caricature, ignoring the diversity and depth of Black musical expression.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_eb6c24e8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2db6b205",
      "@type": "EmotionExpression",
      "instance_name": "aggression",
      "label": "aggressive emotion",
      "description": "The white man on the right is physically grabbing the Black man's collar in a confrontational manner, which visually expresses aggression. This gesture is amplified by the text overlay that equates Black people with 'loving a good beat,' implying a connection to physicality or violence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_eb6c24e8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e0fcc1a4",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Mapping of 'blacks are musical' to the Black man in the struggle",
      "description": "The top text 'blacks are musical' is mapped onto the visual entity 'man_on_left' (the Black man in the suit). The meme uses his physical presence and the context of the struggle to visually represent the stereotype that Black people are 'musical' — a racialized trope that reduces their identity to a simplistic cultural association. The visual of the man being grabbed by the collar is juxtaposed with the text to imply that his 'musicality' is inherently linked to physicality or aggression, aligning with the stereotype 'anti_black_stereotype_aggressive_violent_nature'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_eb6c24e8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c3982318",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the racialized stereotype conveyed through the visual and textual elements",
      "description": "The user is not explicitly projected onto any specific visual, textual, or scene element via deictic pronouns like 'me', 'you', etc. However, the meme's overall intent and structure project the user's interpretation onto the entire scene — particularly the visual of the Black man being grabbed and the text 'blacks are musical' and 'they always love a good beat' — which together construct a harmful racial stereotype. The user is implicitly invited to internalize or recognize this stereotype as the meme's core message, projecting their own understanding onto the visual and textual material. The projection is onto the scene and its textual overlays, which collectively represent the anti-Black stereotype of aggressive/violent nature.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_eb6c24e8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6f93bd82",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks Black people based on race by associating them with aggression and violence through the text 'blacks are musical' and 'they always love a good beat', which equates musicality with physicality and aggression. This is a harmful racial stereotype that dehumanizes a racial group.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_eb6c24e8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_99cf1cbb",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed for an audience that may be familiar with or receptive to racially charged stereotypes, particularly those targeting Black people. The target community likely includes individuals who either perpetuate or find humor in anti-Black stereotypes, such as the 'aggressive/violent nature' trope. The meme relies on the audience's understanding of the metaphorical link between 'musicality' and physical aggression, which is a culturally loaded and offensive trope. The audience may also be drawn to the visual contrast of the physical struggle juxtaposed with the text, expecting a punchline that reinforces a harmful racial caricature. This audience is likely to be uneducated or indifferent to the dehumanizing implications of the stereotype, and may be seeking content that validates or entertains through racially insensitive humor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_eb6c24e8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
