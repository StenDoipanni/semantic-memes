    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_136b48e5",
      "@type": "BackgroundKnowledge",
      "instance_name": "trailer_park_stereotype",
      "label": "Trailer Park Stereotype",
      "description": "A widely circulated and derogatory stereotype portraying residents of trailer parks as impoverished, violent, chaotic, and lacking in social responsibility. This stereotype is often used to dehumanize and mock lower-income communities, implying they are inherently dangerous or incompetent. The meme’s text references this stereotype by suggesting trailer parks are equipped with absurd weaponry ('yeet cannons'), reinforcing the idea of them as a violent, defenseless, and chaotic environment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_03c55d60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a3c64c78",
      "@type": "BackgroundKnowledge",
      "instance_name": "yeet_cannon",
      "label": "Yeet Cannon",
      "description": "A fictional, absurd, and internet-born concept representing a comically exaggerated weapon or device that launches objects with great force. The term 'yeet' is a slang verb meaning to throw or hurl something forcefully, often used humorously or in gaming contexts. The 'yeet cannon' is a satirical invention used in memes to depict extreme, over-the-top violence or defense mechanisms, often in a mocking or surreal way. In this meme, it is used to mock the idea of trailer park residents being armed with ridiculous, cartoonish weaponry.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_03c55d60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0ddda007",
      "@type": "BackgroundKnowledge",
      "instance_name": "dalai_lama",
      "label": "Dalai Lama",
      "description": "The Dalai Lama is the spiritual leader of Tibetan Buddhism and a globally recognized figure of peace, compassion, and non-violence. His image is often used in memes to juxtapose his serene, wise, and non-aggressive persona with absurd, violent, or satirical text. In this meme, his presence is used ironically to contrast his peaceful teachings with the violent, chaotic imagery described in the text, amplifying the meme’s mocking tone.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_03c55d60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c3c1dce2",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_poor_stereotype",
      "label": "Anti-Poor Stereotype",
      "description": "A broader social stereotype that devalues and demonizes people living in poverty or marginalized socioeconomic groups. This includes portraying them as lazy, criminal, violent, or incompetent. The meme relies on this stereotype by depicting trailer parks as dangerous and chaotic, implying that people living there are inherently violent and need to be defended against with absurd weaponry. This stereotype is often used to justify social exclusion, discrimination, or policy decisions that ignore the systemic causes of poverty.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_03c55d60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_adbf07ae",
      "@type": "EmotionExpression",
      "instance_name": "mocking_irony",
      "label": "mocking and ironic emotion",
      "description": "The Dalai Lama’s earnest and engaged facial expression and gestures, juxtaposed with the absurd and violent text about 'trailer parks' and 'yeet cannons,' create a tone of mocking irony. The contrast between his peaceful persona and the satirical, dehumanizing content of the text is the primary emotional expression.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_03c55d60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_18755d91",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Dalai Lama is mapped as the speaker of the absurd text about trailer parks",
      "description": "The Dalai Lama, as the central visual entity, is presented as the source or speaker of the text 'you cannot invade the trailer park' and 'there will be a dumpster-defend with a yeet cannon behind every door!'. His earnest expression and gesturing hands are juxtaposed with the violent, satirical text, creating an analogical mapping where his persona (peaceful, wise spiritual leader) is contrasted with the absurd, violent content he is humorously 'assigned' to deliver. This mapping is central to the meme's mocking irony.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_03c55d60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_35e08b50",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the absurd text describing trailer park violence",
      "description": "The user is projected onto the textual material that describes a violent, absurd scenario involving trailer parks and 'yeet cannons'. This projection is implicit, as the meme's humor and irony rely on the user imagining themselves in the context of the text's scenario — either as the invader or as someone who must defend against the absurdly armed trailer park residents. The text does not contain explicit deictic pronouns like 'you' or 'me', but the meme's structure and tone create an implicit address to the viewer, inviting them to engage with the satirical scenario as if it were real or as if they were the one being warned or threatened. The projection is onto the textual material, which is the core of the meme's satirical message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_03c55d60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_03de6022",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme relies on harmful stereotypes about poverty and lower-class communities, portraying them as violent, chaotic, and equipped with absurd weaponry. This creates a hostile and degrading tone, potentially causing harm by reinforcing negative perceptions of marginalized groups and trivializing serious social issues.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_03c55d60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f594ac30",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals familiar with internet meme culture, particularly those who understand and appreciate absurdist humor, satire, and the use of juxtaposition. The meme relies on cultural references such as the 'yeet cannon' (a fictional, exaggerated internet concept) and the 'trailer park stereotype' (a widely recognized, derogatory trope). The audience is likely to find the humor in the absurdity of pairing the Dalai Lama’s peaceful persona with violent, chaotic imagery. The meme is designed for an audience that enjoys mocking or parodying stereotypes about lower-income communities, particularly those associated with trailer parks, and who are comfortable with the use of crude, violent, and satirical language. The target community includes internet users who engage with meme culture, often on platforms like Reddit, Twitter, or imageboards, and who are familiar with the 'yeet' slang and the 'dumpster-defend' concept as part of internet humor. The meme’s tone and content suggest it is intended for an audience that finds humor in dehumanizing or exaggerating social stereotypes, particularly those related to poverty and marginalized groups.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_03c55d60"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
