    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2c2b8663",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Textual command mapped onto visual victim",
      "description": "The text 'don't move and give me your money' is directly mapped onto the visual entity of the woman, who is depicted as the victim being held at gunpoint. The text explicitly commands her to surrender money, and her visual portrayal as restrained and fearful reinforces this mapping. The woman is the direct subject of the command, making her the mapped entity in the visual material.",
      "belongsToAnalysis": {
