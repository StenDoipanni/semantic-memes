    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_98d8a85a",
      "@type": "BackgroundKnowledge",
      "instance_name": "driving_ability_mockery_stereotype",
      "label": "Driving Ability Mockery Stereotype",
      "description": "A harmful stereotype that portrays members of certain racial or ethnic groups, particularly Asian drivers, as inherently incompetent or dangerous behind the wheel. This stereotype is often used in memes and media to demean and stereotype individuals based on their ethnicity, perpetuating racial prejudice and discrimination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e6b069c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c01702ea",
      "@type": "BackgroundKnowledge",
      "instance_name": "model_minority_myth_weaponization",
      "label": "Model Minority Myth Weaponization",
      "description": "The use of the 'model minority' stereotype — which portrays Asian Americans as universally successful, hardworking, and academically gifted — to justify or rationalize negative stereotypes, such as the 'driving ability mockery' trope. This involves using the positive stereotype to contrast with a negative one, thereby reinforcing harmful biases.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e6b069c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_331dfa99",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_asian_racism",
      "label": "Anti-Asian Racism",
      "description": "A form of systemic racism that targets Asian individuals and communities based on their ethnicity, often through harmful stereotypes, xenophobia, and discriminatory practices. This includes tropes like 'driving ability mockery' and 'foreign infiltrator' claims, which are used to dehumanize and marginalize Asian people.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e6b069c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dbe356b2",
      "@type": "BackgroundKnowledge",
      "instance_name": "hateful_meme_intention",
      "label": "Hateful Meme Intention",
      "description": "The underlying intent of the meme is to spread hate and prejudice by associating a specific racial group with negative traits or behaviors. In this case, the meme uses the juxtaposition of a damaged car and a professionally posed Asian woman to imply that Asian drivers are inherently dangerous, which is a form of racial stereotyping and discrimination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e6b069c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_903e4528",
      "@type": "EmotionExpression",
      "instance_name": "mocking_contempt",
      "label": "contemptuous mockery emotion",
      "description": "The emotion expressed is one of contemptuous mockery, conveyed through the juxtaposition of the severely damaged car with the professionally posed Asian woman, combined with the text 'asian drivers test' and 'went as expected'. This implies that the woman's appearance (representing an idealized 'model minority' stereotype) is being used to mock or belittle the stereotype of 'Asian drivers' as dangerous or incompetent. The overall tone is demeaning and racially charged, expressing contempt for the targeted group.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e6b069c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1a17bb5c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Asian woman is mapped as the 'asian drivers test' subject",
      "description": "The text 'asian drivers test' is mapped onto the visual entity 'woman' (the professionally posed Asian woman). The meme implies that this woman represents the stereotype of an 'Asian driver' being tested, and the damaged car symbolizes the 'test result'. The mapping is established through the juxtaposition and the text's direct reference to 'asian drivers', which is then visually embodied by the woman in the image, despite her professional appearance contrasting with the car's damage.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e6b069c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_60b19ee6",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene as the implied subject of the 'asian drivers test'",
      "description": "The user is not explicitly projected onto a specific visual, textual, or scene element via deictic pronouns like 'me' or 'you'. However, the meme's structure and hateful intent create an implicit projection: the user is positioned as the one who 'expects' or 'understands' the outcome (the damaged car) based on the stereotype of 'asian drivers'. The user is thus projected onto the overall scene and its implied narrative, where they are the one interpreting the stereotype and its 'expected' result. The user is not directly mapped to a specific entity like the woman or the car, but rather to the entire meme's message and its implied audience role.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e6b069c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
