    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e5318d7d",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed for an audience that is familiar with and receptive to racial stereotypes, particularly those targeting Asian individuals. The target community includes viewers who may find humor in or be desensitized to harmful tropes like 'driving ability mockery' and 'model minority myth weaponization'. The meme relies on the audience's understanding of these stereotypes to convey its hateful message, making it most effective for those who already hold or are exposed to anti-Asian racist views.",
