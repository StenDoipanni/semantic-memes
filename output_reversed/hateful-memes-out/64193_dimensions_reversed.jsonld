    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9e39a909",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who are familiar with internet meme culture, particularly those who recognize and understand the 'potato' trope and the use of derogatory ableist slurs. The meme is designed to be understood and appreciated by users who find humor in mocking ignorance or perceived stupidity, especially in the context of disability. The audience likely includes online communities that engage with edgy, confrontational, or abusive humor, where the use of such slurs is normalized or seen as 'dark comedy'. The visual of the stern man is used to amplify the insult, appealing to an audience that interprets such expressions as aggressive mockery. The meme's toxicity and offensive nature suggest it is targeted at users who are desensitized to ableist language and who may find the combination of the 'potato' trope and the 'full retard' slur amusing or entertaining, despite its harmful content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bb555296"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
