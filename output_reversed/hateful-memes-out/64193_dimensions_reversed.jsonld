    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_86fe75ae",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'you just ran past full retard' maps to the man as the target of the insult.",
      "description": "The top text overlay 'you just ran past full retard' directly refers to a person (the target of the meme) who allegedly failed to acknowledge or recognize someone with a disability. The man in the image, with his stern and confrontational expression, is visually mapped as the embodiment of this target — the person being mocked for their supposed ignorance or dismissiveness. The visual material (the man) is thus mapped onto the textual entity (the insult directed at 'you').",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bb555296"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1331077e",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the target of the insult",
      "description": "The user is projected onto the person being mocked, as indicated by the text 'you just ran past full retard'. The text directly addresses the user ('you'), making the user the target of the insult. The visual material (the man) is used to represent this target, creating a semiotic projection where the user sees themselves as the subject of the mockery. The man's stern expression reinforces the accusatory tone directed at the user.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bb555296"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
