    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c15f6b29",
      "@type": "BackgroundKnowledge",
      "instance_name": "Goodyear",
      "label": "Goodyear Tire and Rubber Company",
      "description": "Goodyear is a well-known American tire manufacturer. The joke in the meme plays on the word 'rubbery' — a term associated with rubber — implying that the chicken is so rubbery that it resembles a tire, and thus Goodyear would be interested in the recipe. This is a pun-based humor relying on the company's association with rubber.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3ad62a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8ca075ef",
      "@type": "BackgroundKnowledge",
      "instance_name": "rubbery",
      "label": "Rubbery texture",
      "description": "In culinary contexts, 'rubbery' describes meat (especially chicken) that is tough, chewy, and lacks tenderness — often due to overcooking or improper preparation. The term is used here to convey a negative critique of the dish's texture, which is the core of the joke.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3ad62a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1a20989e",
      "@type": "BackgroundKnowledge",
      "instance_name": "Gordon_Ramsay",
      "label": "Gordon Ramsay",
      "description": "Gordon Ramsay is a world-famous British chef, television personality, and restaurateur known for his sharp, often harsh critiques of food and cooking. His recognizable persona and frequent appearances on cooking shows make him a cultural reference point for culinary criticism. The meme uses his image to evoke his signature style of blunt, exaggerated disapproval.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3ad62a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d7ae3137",
      "@type": "BackgroundKnowledge",
      "instance_name": "pun",
      "label": "Pun",
      "description": "The meme relies on a pun — the double meaning of 'rubbery' — to create humor. The word 'rubbery' can refer to both the texture of food and the material rubber, which is associated with Goodyear. This linguistic play is central to understanding the joke.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3ad62a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_18a82207",
      "@type": "BackgroundKnowledge",
      "instance_name": "absurd_joke",
      "label": "Absurd humor",
      "description": "The joke is absurd because it connects an unrelated corporate entity (Goodyear) with a culinary critique in a ridiculous way. This type of humor relies on the unexpected juxtaposition of unrelated concepts to create comedic effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3ad62a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_33085f4c",
      "@type": "EmotionExpression",
      "instance_name": "disapproval",
      "label": "disapproving expression",
      "description": "Gordon Ramsay is leaning forward with a skeptical and displeased facial expression, conveying strong disapproval of the rubbery chicken dish. His furrowed brow and narrowed eyes emphasize his critical judgment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3ad62a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_81c24dbc",
      "@type": "AnalogicalMapping",
      "instance_name": "rubbery_chicken_mapping",
      "label": "The chicken is mapped as 'rubbery' and thus associated with Goodyear",
      "description": "The top text 'this chicken is so rubbbery' is mapped onto the visual material of the chicken dish, implying its texture is so rubbery that it resembles a Goodyear tire. The visual of Gordon Ramsay's disapproval reinforces the negative evaluation of the chicken's texture, which is the core of the pun-based analogy. The mapping is between the textual description of the chicken's texture and the visual representation of the chicken dish, with the humor derived from the absurd implication that Goodyear would want the recipe.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3ad62a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b756cbda",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the humorous textual analogy",
      "description": "The user is projected onto the textual material that creates the absurd joke — specifically, the pun that links 'rubbery' chicken to Goodyear. The user is not directly addressed with deictic pronouns like 'you' or 'me', but the humor invites the user to share in the joke by imagining the absurdity of Goodyear calling for a chicken recipe. The projection is onto the textual material that forms the core of the meme's punchline.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3ad62a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4572c9cb",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme uses an absurd and exaggerated analogy to create humor, implying that a rubbery chicken is so good it would be sought after by Goodyear, a tire company. While the joke is harmless and relies on wordplay, the implication that a rubbery chicken is desirable enough to warrant a call from a tire company could be seen as potentially harmful by some, as it trivializes the negative culinary critique by associating it with an unrelated corporate entity. The humor is derived from the juxtaposition of a culinary critique with an unrelated corporate entity, which is a common comedic device, but the absurdity may be perceived as offensive or inappropriate by some audiences.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3ad62a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_66034fdd",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals familiar with Gordon Ramsay's persona and culinary critiques, as well as those who appreciate pun-based humor and absurd wordplay. The meme relies on cultural references such as Ramsay’s recognizable disapproval, the double meaning of 'rubbery,' and the unexpected juxtaposition of a chicken dish with Goodyear, a tire company. The humor is designed for an audience that understands and enjoys culinary humor, pop culture references, and internet-style absurdist jokes. Demographic cues suggest it targets adults who consume entertainment content, particularly cooking shows or celebrity chef media, and who are comfortable with internet memes and linguistic wordplay.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b3ad62a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
