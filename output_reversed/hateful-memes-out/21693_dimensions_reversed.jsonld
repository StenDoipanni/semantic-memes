    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cc99acbb",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Cashier is mapped as a thief",
      "description": "The text overlay explicitly accuses the cashier of theft by stating '$21.36 after theft', directly mapping the visual entity 'cashier' to the textual concept of 'thief'. This is a hateful analogical mapping that uses the visual of a Black man in a service role to project the stereotype of criminal behavior onto him.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5fcb77ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_10dea9e5",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the transaction scene as the target of a racialized accusation",
      "description": "The user is projected onto the scene of the cashier processing a payment, where the overlaid text falsely accuses the Black cashier of theft. The text 'your purchase of $19.99 comes to $21.36 after theft' uses 'your' to directly address the viewer/user, making them the implied subject of the accusation. The user is thus projected onto the scene as the person who is being targeted by the hateful stereotype, experiencing the false narrative that the cashier is a thief. This projection is reinforced by the visual of the smiling cashier, which contrasts with the hateful accusation, creating a dissonant experience for the user.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5fcb77ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d3a2088a",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly accuses a Black male cashier of theft based on his race, using racially charged language and imagery to dehumanize him. This is a direct attack based on protected characteristics (race) and constitutes hateful content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5fcb77ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d12dee9c",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals who hold or are exposed to racist stereotypes, particularly those who may believe or perpetuate the stereotype that Black people are inherently more likely to be associated with criminal behavior, especially theft. The meme is designed to appeal to or provoke this audience by using racially charged imagery and text to reinforce harmful generalizations. It targets those who may find satisfaction in racially profiling Black individuals, or who are susceptible to misinformation that links race with dishonesty. The audience is likely to be those who consume and share content that relies on racialized hate speech, and who may not recognize the meme as a hateful attack, but rather as a joke or commentary that normalizes racist tropes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5fcb77ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
