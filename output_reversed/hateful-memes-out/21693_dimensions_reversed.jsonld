    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_28df6ae5",
      "@type": "BackgroundKnowledge",
      "instance_name": "stereotype_of_black_people_as_thieves",
      "label": "Stereotype of Black People as Thieves",
      "description": "This is a specific, harmful stereotype that links Black individuals to criminal behavior, particularly theft. The meme uses this stereotype to falsely accuse the cashier of stealing money from the customer, which is a direct and malicious application of this stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5fcb77ce"
      },
