      "@id": "http://example.org/multimodal-taxonomy#dimension_82cf5106",
      "@type": "VisualMaterial",
      "instance_name": "cashier",
      "label": "Black male cashier",
      "description": "A Black man with curly hair and a beard, wearing a white shirt and a brown apron, smiling while holding a payment terminal. He is positioned behind a counter in what appears to be a café or restaurant, and is the central focus of the image. His cheerful expression contrasts with the hateful text overlay accusing him of theft.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5fcb77ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2728ee08",
      "@type": "Scene",
      "instance_name": "transaction_scene",
      "label": "cashier_processing_payment",
      "description": "A scene depicting a Black male cashier in a retail or food service setting, smiling while processing a transaction with a customer. The cashier is holding a payment terminal and appears to be engaged in a routine transaction. The customer is partially visible from behind, facing the cashier. The scene is overlaid with text that falsely accuses the cashier of theft, creating a hateful and racially charged context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5fcb77ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
