    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1dc2d627",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: meme_image; hasOverallIntent: Hateful; overall-intent-description: The image depicts a Black male cashier in a retail or food service setting, smiling while processing a transaction. The overlaid text reads: \"your purchase of $19.99 comes to $21.36 after theft.\" This text is a direct and malicious accusation, implying that the cashier is responsible for the extra $1.37 charge, framing him as a thief. This is a hateful stereotype that targets Black individuals by associating them with criminal behavior, specifically theft, in a context where they are performing a legitimate job. The meme uses the visual of a Black person in a service role to reinforce a harmful and false narrative, which is a direct attack based on race. The intent is to demean and dehumanize the individual by linking his appearance and profession to dishonesty, which is a form of racialized hate speech.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5fcb77ce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
