    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_098312c7",
      "@type": "BackgroundKnowledge",
      "instance_name": "criminal_behavior_associations",
      "label": "Criminal Behavior Associations",
      "description": "The meme relies on the stereotype that Black people are inherently more likely to be associated with criminal behavior, particularly theft. This is a harmful and false stereotype that is used to dehumanize the cashier and justify the hateful accusation in the text overlay.",
      "belongsToAnalysis": {
