      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_68073afe",
      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_hate_speech",
      "label": "Racialized Hate Speech",
      "description": "The meme uses racial profiling to accuse a Black person of theft, which is a form of racialized hate speech. This speech targets an individual based on their race, implying that their racial identity makes them inherently dishonest or criminal, which is a harmful and false generalization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5fcb77ce"
