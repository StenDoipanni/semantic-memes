    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_09fae320",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Barack Obama is mapped as the candidate offering free food",
      "description": "The top text 'vote for me' directly maps Barack Obama (the visual entity) as the political candidate making a campaign promise. The visual of Obama smiling and looking upward, combined with the text, creates an analogical mapping where the political figure is projected as the entity soliciting votes through the offer of 'free kfc, grape kool aid, & watermelon'. This mapping is reinforced by the campaign setting and the juxtaposition of his image with the satirical, racially coded text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e56ef87b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0ad0f2f9",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the campaign promotion scene",
      "description": "The user is projected onto the scene of Barack Obama's campaign promotion, where the visual of Obama smiling and the text 'vote for me' and 'free kfc, grape kool aid, & watermelon' create an implicit invitation for the user to imagine themselves as the voter being targeted by this satirical offer. The meme's structure invites the user to mentally inhabit the role of the recipient of the 'free food' promise, thereby projecting the user onto the campaign promotion scene as the potential beneficiary or target of the political message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e56ef87b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_60d8d60f",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme leverages a racially coded food stereotype — 'watermelon and fried chicken' — historically used to depict Black Americans as lazy, dependent, or culturally inferior. By mapping this stereotype onto Barack Obama, the meme trivializes his political campaign and reinforces harmful racial biases, potentially inciting racial resentment and contributing to a hostile environment for Black individuals.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e56ef87b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2c8221ad",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who are familiar with or recognize the racial stereotype of Black Americans being associated with 'watermelon and fried chicken,' and who may find humor in the juxtaposition of a respected political figure with racially coded, satirical campaign promises. This audience likely includes people who are aware of the historical context of the stereotype and may be drawn to the meme for its provocative, racially charged humor, even if it is harmful. The meme is designed to resonate with those who understand the cultural reference and may be entertained by the mockery of Obama's campaign through the lens of offensive stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e56ef87b"
      },
      "extractionMethod": "llm_extraction_huggingface"
