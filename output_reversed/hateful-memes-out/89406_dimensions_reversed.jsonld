      "label": "Racist Stereotype",
      "description": "The meme equates white people with fish, implying they are unintelligent or primitive, which is a harmful and offensive racial stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4d30ea19"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
