    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_476c5738",
      "@type": "BackgroundKnowledge",
      "instance_name": "racist_stereotype_white_people_fish",
      "label": "Racist Stereotype: White People as Fish",
      "description": "The meme relies on a derogatory racial stereotype that equates white people with fish, implying they are unintelligent or primitive. This is a false analogy used to demean white people by suggesting they are so ignorant they don't know basic facts about fish behavior (e.g., that fish swim in schools). This stereotype is part of a broader history of racial caricatures and is considered harmful and offensive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4d30ea19"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a723fc47",
      "@type": "BackgroundKnowledge",
      "instance_name": "fish_swim_in_schools_fact",
      "label": "Biological Fact: Fish Swim in Schools",
      "description": "The phrase 'fish swim in schools' is a basic biological fact referring to the social behavior of fish, which often gather in groups for protection and efficiency. This fact is used in the meme as a punchline to mock the supposed ignorance of white people, implying they are unaware of this simple truth. The knowledge that fish swim in schools is external to the image and is required to understand the joke's setup.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4d30ea19"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9e2182ff",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_juxtaposition_weapon_and_stereotype",
      "label": "Meme Juxtaposition: Weapon Firing and Stereotype",
      "description": "The visual of a naval gunner firing a weapon is juxtaposed with the text to create a metaphorical 'attack' on the stereotype. The firing of the weapon symbolizes aggression or 'shooting down' the idea that white people are ignorant, reinforcing the meme's hostile tone. This requires understanding of meme structure and metaphorical imagery to interpret the intended meaning.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4d30ea19"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_173b1b91",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_prejudice_context",
      "label": "Context of Racial Prejudice",
      "description": "The meme operates within the context of racial prejudice and hate speech, using a derogatory stereotype to demean a racial group. Understanding that this is a form of racial discrimination and that such stereotypes are harmful and offensive is essential to interpreting the meme's intent and impact. This background knowledge is required to recognize the meme as a harmful and offensive piece of content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4d30ea19"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_63905795",
      "@type": "EmotionExpression",
      "instance_name": "derision",
      "label": "derisive emotion",
      "description": "The emotion expressed is derision, conveyed through the juxtaposition of a military weapon being fired with the text implying that white people are so ignorant they don't know that fish swim in schools. This creates a mocking and demeaning tone, suggesting the target group is foolish or primitive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4d30ea19"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_77f96198",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "White people are mapped onto fish",
      "description": "The top text 'when white people learn that' sets up a stereotype that white people are ignorant, and the bottom text 'fish swim in schools' is presented as the punchline. The visual of the naval gunner firing a weapon is used metaphorically to represent the 'attacking' or 'shooting down' of this stereotype. The analogical mapping is that the 'white people' (as a group) are being equated with 'fish' (as a group) in the context of the stereotype, and the firing of the weapon symbolizes the aggressive dismissal of this ignorance. The visual material (naval gunner firing) is mapped onto the textual material (the stereotype about white people being ignorant of fish behavior).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4d30ea19"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_54408628",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the stereotype and the visual metaphor",
      "description": "The user is projected onto the meme's core message, which equates white people with fish and uses the visual of a naval gun firing as a metaphor for 'attacking' this ignorance. The user is implicitly positioned as someone who might be 'shooting down' or reacting to the stereotype, even though the meme itself does not contain explicit deictic pronouns like 'you' or 'me'. The projection is onto the textual material ('fish swim in schools') and the visual material (naval gunner firing) which together form the stereotype and its aggressive dismissal.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4d30ea19"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
