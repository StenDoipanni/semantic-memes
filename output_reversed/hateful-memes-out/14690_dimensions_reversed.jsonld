    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_46ea3c4a",
      "@type": "BackgroundKnowledge",
      "instance_name": "top_text",
      "label": "Meme text: 'showing the kids you can do it too'",
      "description": "The phrase 'showing the kids you can do it too' is a common motivational phrase used in educational, sports, and social contexts to encourage children to believe in their own potential. It implies that someone (often a role model or authority figure) is demonstrating that success or capability is attainable for others, even if they are not currently achieving it. This phrase is culturally understood as positive and empowering.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d9922ca8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_628273d9",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_structure",
      "label": "Meme format: 'showing the kids you can do it too'",
      "description": "This meme format is a common internet meme structure used to convey encouragement or empowerment. It typically features a person (often a celebrity or public figure) interacting with a child or group of children, with text overlaying the image to suggest that the person is demonstrating a skill or attitude that the children can emulate. The format relies on the viewer's understanding of motivational messaging and public figures as role models.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d9922ca8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
