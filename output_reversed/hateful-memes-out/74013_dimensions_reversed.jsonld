    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7f1ed86a",
      "@type": "Scene",
      "instance_name": "alzheimer_patient_reaction",
      "label": "Alzheimer's patient reacting to nurse announcement",
      "description": "Samuel_L_Jackson, portrayed as an Alzheimer's patient, is shown with a surprised and angry expression, gesturing with his right hand, in response to a nurse's announcement about mashed potatoes. The scene is framed to emphasize his emotional outburst and the absurdity of his reaction.",
      "belongsToAnalysis": {
