    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fe824b4b",
      "@type": "VisualMaterial",
      "instance_name": "Samuel_L_Jackson",
      "label": "actor",
      "description": "A Black man with a mustache and goatee, wearing a black beanie, a black-and-white striped polo shirt under a plaid vest, and a black zip-up hoodie. He has a surprised or angry expression, with his mouth open and his right hand raised in a gesture of exasperation or disbelief. He is the central figure in the image and is being used in the meme to portray an Alzheimer's patient reacting to a nurse's announcement.",
      "belongsToAnalysis": {
