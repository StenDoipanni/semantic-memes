    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fa39fa41",
      "@type": "BackgroundKnowledge",
      "instance_name": "baby_animal_as_human_baby_stereotype",
      "label": "Baby Animal as Human Baby Stereotype",
      "description": "The meme relies on the visual similarity between human infants and baby primates to generate humor. It implicitly references the common human tendency to anthropomorphize baby animals, treating them as if they were human babies, which is a widely recognized social behavior and cultural phenomenon. This stereotype is used to create absurdity by applying human social media behavior (tagging friends) to an animal.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bd97a524"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f2b34fcf",
      "@type": "BackgroundKnowledge",
      "instance_name": "social_media_tagging_behavior",
      "label": "Social Media Tagging Behavior",
      "description": "The text 'can you tag your friend' references a common social media practice where users tag friends in posts or photos. This behavior is a real-world social trend and platform-specific interaction that is not visible in the image but is essential to understanding the meme's context and humor.",
      "belongsToAnalysis": {
