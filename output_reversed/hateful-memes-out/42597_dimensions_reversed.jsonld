      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_57b40c0e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "baby orangutan is mapped as 'their baby pic'",
      "description": "The text 'tell them i found their baby pic' implies that the baby orangutan is being treated as a 'baby' in the human sense, creating an analogical mapping where the visual entity (baby orangutan) is mapped onto the textual concept of 'their baby pic'. This mapping relies on anthropomorphism and the visual similarity between human infants and baby primates to generate humor. The text explicitly refers to the visual material as if it were a human baby photograph, projecting human social media behavior onto the animal.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bd97a524"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5f4e3213",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material prompting social media interaction",
      "description": "The user is projected onto the textual material 'can you tag your friend' and 'tell them i found their baby pic', which directly addresses the viewer as the one who should perform the action (tagging a friend) and implies the user is the one who 'found' the picture. This creates an implicit deictic reference to 'you' (the viewer) as the actor in the social media scenario. The projection is onto the textual material, which frames the user as the one initiating the social media behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bd97a524"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
