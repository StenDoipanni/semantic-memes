:historical_tragedy_trivialization rdf:type :BackgroundKnowledge ;
                rdfs:label "Historical Tragedy Trivialization"@en ;
                rdfs:comment "The act of reducing the gravity of a major historical tragedy to a joke or a trivial comparison. This meme is a prime example, as it equates the Holocaust with a cosmetic issue, which is deeply insensitive and harmful."@en ;
                :extractionMethod "llm_extraction_huggingface" ;
                :extractedFrom "03186.png" ;
                :extractionTimestamp "2025-12-15T11:30:30.592173" .

