    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_daf18f1c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "scientist are working hard is mapped onto the patients in the hospital ward",
      "description": "The text 'scientist are working hard' is juxtaposed with the visual of patients in a crowded hospital ward, creating an analogical mapping where the text implies that the scientists are working hard to cure the patients shown. This mapping is ironic, as the visual context suggests the patients are suffering in an overwhelmed system, contrasting with the optimistic claim about scientists. The mapping is established through the ironic contrast between the text and the visual material, where the patients are the entities being 'cured' by the implied scientific effort.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_85999f14"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3dc22c76",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of suffering patients",
      "description": "The user is projected onto the visual material of the crowded hospital ward and the patients within it, as the meme's ironic text ('scientist are working hard to cure them all') implies that the user (or society) is witnessing the consequences of insufficient scientific or medical intervention. The projection is not explicit (e.g., no 'you' or 'me'), but it is implied through the user's identification with the suffering depicted and the cynical commentary on scientific progress. The user is positioned as an observer of the scene, and the meme invites them to project their own feelings of despair, helplessness, or cynicism onto the patients and the overwhelmed system.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_85999f14"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
