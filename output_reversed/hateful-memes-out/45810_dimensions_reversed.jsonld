    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5564de55",
      "@type": "BackgroundKnowledge",
      "instance_name": "homosexual_stereotype",
      "label": "Homosexual Stereotype",
      "description": "The meme uses the slur 'faggot' to associate men who are offended by the image of dogs fighting with homosexuality, reinforcing a harmful stereotype that equates homosexuality with weakness or lack of masculinity. This is a derogatory and offensive trope used to shame and demean individuals based on their sexual orientation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41025c25"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6e537b0b",
      "@type": "BackgroundKnowledge",
      "instance_name": "masculinity_stereotype",
      "label": "Masculinity Stereotype",
      "description": "The meme implies that men who are offended by the image of dogs fighting are not 'real men' because they are perceived as weak or unmanly. This reflects a harmful stereotype that equates masculinity with aggression, dominance, or the ability to tolerate violent or crude imagery without complaint.",
      "belongsToAnalysis": {
