      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_68738645",
      "@type": "BackgroundKnowledge",
      "instance_name": "slur_usage",
      "label": "Use of Derogatory Slur",
      "description": "The term 'faggot' is a highly offensive slur historically used to demean and dehumanize gay men. Its use in the meme is not just a reference to sexual orientation but an act of hate speech intended to insult and attack those who are perceived as 'weak' or 'unmanly' for being offended by the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41025c25"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5db7e973",
      "@type": "BackgroundKnowledge",
      "instance_name": "dog_fighting_as_analogy",
      "label": "Dog Fighting as Analogy for Human Behavior",
      "description": "The meme uses the visual of two dogs fighting as a metaphor to suggest that men who are offended by such imagery are homosexual. This is a form of analogical mapping that relies on the viewer understanding the cultural association between animal aggression and human masculinity, which is a common trope in misogynistic and homophobic rhetoric.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41025c25"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c440600d",
      "@type": "BackgroundKnowledge",
      "instance_name": "heteronormative_expectations",
      "label": "Heteronormative Expectations",
      "description": "The meme operates under the assumption that men should not be offended by violent or crude imagery, implying that true masculinity requires tolerance of such content. This reflects a heteronormative and patriarchal expectation that men must conform to a specific, aggressive, and unemotional standard of behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41025c25"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_28cc6ea8",
      "@type": "EmotionExpression",
      "instance_name": "homophobic_contempt",
      "label": "contemptuous emotion toward men who are offended",
      "description": "The meme expresses contempt for men who are offended by the image of dogs fighting, labeling them as 'faggots' and dismissing their discomfort as unworthy of consideration. This emotion is conveyed through the use of a derogatory slur and the framing of the man's reaction as a sign of weakness or lack of masculinity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41025c25"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3b7666bb",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Dog fighting is mapped as an analogy for men who are offended by such imagery",
      "description": "The visual of two dogs engaged in a physical altercation (dog_fighting) is used as an analogy to represent men who are offended by the image. The text explicitly states that if a man is offended by this scene, he is labeled as a 'faggot', thereby mapping the visual of dog fighting onto the textual concept of male homosexuality and weakness. This is a form of analogical mapping where the visual material (dog fighting) is projected onto a textual entity (the man's reaction) to imply a stereotype about sexual orientation and masculinity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41025c25"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3227e97f",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message addressing 'ladies' and 'your man'",
      "description": "The user is projected onto the textual material that directly addresses 'ladies!' and 'your man', creating an implicit 'you' (the viewer) who is being instructed to evaluate their partner's reaction to the image. The text 'ladies! if your man is offended by this' explicitly directs the user's attention and judgment toward their own partner, making the viewer a participant in the meme's social commentary. This projection is onto the textual material, which frames the user as the one who should assess their partner's masculinity based on their reaction to the dog-fighting scene.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41025c25"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_384bbdce",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks men who are offended by the image of dogs fighting by labeling them as 'faggots', which is a derogatory slur targeting their sexual orientation. This constitutes a hateful attack based on protected characteristics.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_41025c25"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
