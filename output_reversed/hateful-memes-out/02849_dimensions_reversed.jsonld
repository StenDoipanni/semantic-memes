    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4495645f",
      "@type": "BackgroundKnowledge",
      "instance_name": "model_minority_myth",
      "label": "Model Minority Myth",
      "description": "A stereotype that portrays Asian Americans as uniformly successful, academically gifted, and economically stable, often used to downplay systemic racism and inequality faced by Asian communities. This meme leverages this stereotype by implying that Asian people are inherently good at cooking (specifically frying), which is a reductive and potentially offensive generalization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81aea3ca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b9951a8e",
      "@type": "BackgroundKnowledge",
      "instance_name": "frying_stereotype",
      "label": "Frying Stereotype",
      "description": "A disparaging stereotype that associates Asian people with frying food, often used to imply that their culinary skills are limited to this one method, reinforcing the 'model minority' myth and perpetuating anti-Asian racism. The phrase 'i can fryyy' is a humorous exaggeration of this stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81aea3ca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_266035b3",
      "@type": "BackgroundKnowledge",
      "instance_name": "abba_ree",
      "label": "Abba Ree",
      "description": "A popular internet meme phrase derived from the Swedish pop group ABBA, often used to express exaggerated excitement or frustration. The phrase 'abba ree' is used here to add comedic effect to the man's intense singing performance, contrasting with the absurdity of the 'i can fryyy' text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81aea3ca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4ab4dc53",
      "@type": "EmotionExpression",
      "instance_name": "exaggerated_excitement",
      "label": "the exaggerated excitement emotion",
      "description": "The man's facial expression, with his mouth wide open and eyes squinted, conveys intense, exaggerated emotion, likely excitement or passion, as he sings into the microphone. This is amplified by the text 'abba ree', which is a meme phrase used to express heightened excitement or frustration in an over-the-top manner.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81aea3ca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3f66c1e2",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_abba_ree_to_singing_man",
      "label": "The man singing passionately is mapped as 'abba ree'",
      "description": "The text 'abba ree' is overlaid on the image of the man singing with intense emotion. The phrase 'abba ree' is a meme phrase used to express exaggerated excitement or frustration, which is visually mirrored by the man's facial expression and performance. This creates an analogical mapping where the man's emotional state and performance are equated with the meme phrase 'abba ree'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81aea3ca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d901fbc6",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the singing man as embodying the 'abba ree' and 'i can fryyy' stereotype",
      "description": "The user is projected onto the visual material of the man singing passionately, interpreting his intense performance as a humorous, exaggerated embodiment of the meme's text. The user sees themselves in the man's emotional expression and the absurdity of the stereotype, projecting their own experience or identity onto the scene. The text 'abba ree' and 'i can fryyy' are not deictic but are part of the meme's structure; however, the user's projection is onto the man's performance, which is the visual anchor for the joke. The user is not explicitly addressed by 'you' or 'me' in the text, but the meme's humor and the user's engagement imply a self-referential projection onto the man's persona.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81aea3ca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5a751236",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme uses a stereotype that associates Asian people with frying food, reinforcing the 'model minority' myth and perpetuating anti-Asian racism. This can be offensive and potentially damaging to perceptions of Asian communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81aea3ca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1b832947",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed for a general internet audience familiar with internet meme culture, particularly those who recognize the 'abba ree' phrase and the 'model minority' stereotype. The target community includes viewers who find humor in exaggerated stereotypes and may not be aware of the harmful implications of the 'i can fryyy' text, which reinforces anti-Asian racism through the 'model minority' myth. The visual of the East Asian man singing passionately is used to create a comedic juxtaposition, appealing to audiences who appreciate absurdist humor and may not critically engage with the underlying racial stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_81aea3ca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
