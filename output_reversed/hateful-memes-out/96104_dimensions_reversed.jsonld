      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8eb74d49",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "KKK members are mapped as perpetrators of historical racial violence",
      "description": "The visual of the four Ku Klux Klan members is mapped onto the textual claim that 'the ku klux klan killed 3446 blacks in a span of 86 years'. The image of the KKK members serves as a visual representation of the historical white supremacist group responsible for the violence mentioned in the text, creating an analogical mapping where the visual entity (KKK members) is identified as the entity (perpetrators) described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdae0928"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_02c93df0",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual material of Ku Klux Klan members",
      "description": "The user is projected onto the visual material of the four Ku Klux Klan members, as the image evokes a direct association with historical white supremacist violence. The user is implicitly positioned as someone who must confront or judge the historical and contemporary violence presented, with the visual of the KKK members serving as a focal point for this projection. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the framing of the meme (juxtaposing historical and contemporary violence) invites the user to engage with the content and form an opinion, thereby projecting the user onto the visual material as the intended audience for the message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdae0928"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9dae138e",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme creates a false equivalence between historical white supremacist violence and contemporary Black-on-Black violence, which can incite racial division and hostility by minimizing the systemic nature of historical racism and deflecting attention from institutional oppression.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdae0928"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_89d9c853",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who are likely to engage with racially charged content, particularly those who may be exposed to or influenced by narratives that equate historical white supremacist violence with contemporary Black-on-Black violence. This includes people who may be susceptible to false equivalences, those who hold or are exposed to racially divisive ideologies, and individuals who may be seeking to justify or downplay systemic racism by focusing on internal community issues. The meme is designed to provoke outrage and racial division, so its target audience likely includes those who are already predisposed to racial hostility or who are influenced by extremist or conspiratorial narratives that minimize the historical and systemic nature of white supremacist violence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdae0928"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
