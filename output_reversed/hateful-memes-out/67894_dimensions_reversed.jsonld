    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_469cd7fd",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_hate_speech",
      "label": "Antisemitic Hate Speech",
      "description": "The meme uses a dehumanizing and violent metaphor to equate Jewish people with inanimate objects (pizza) and implies that Jews are capable of screaming or suffering in an oven, referencing the Holocaust. This is a clear example of antisemitic hate speech, using a disparaging stereotype to incite hatred and spread harmful misinformation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fb833a61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d444818f",
      "@type": "BackgroundKnowledge",
      "instance_name": "holocaust_reference",
      "label": "Holocaust Reference",
      "description": "The phrase 'a pizza doesn't scream in the oven' is a direct allusion to the Holocaust, specifically the genocide of Jewish people during World War II, where millions were systematically murdered in ovens and gas chambers. This reference is used to dehumanize Jewish people by comparing them to inanimate objects (pizza) and implying they 'scream' or suffer in ovens, which is a violent and false metaphor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fb833a61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_850b90b5",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_stereotype",
      "label": "Antisemitic Stereotype",
      "description": "The meme relies on the antisemitic stereotype that Jewish people are inherently violent or capable of suffering in ovens, which is a direct reference to the Holocaust. This stereotype is used to dehumanize Jewish people and equate them with inanimate objects (pizza) to justify hatred and discrimination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fb833a61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_204d0862",
      "@type": "BackgroundKnowledge",
      "instance_name": "dehumanizing_metaphor",
      "label": "Dehumanizing Metaphor",
      "description": "The meme uses a dehumanizing metaphor by comparing Jewish people to pizza, an inanimate object, to imply that they are incapable of feeling pain or suffering in an oven. This metaphor is used to justify hatred and discrimination against Jewish people by portraying them as objects rather than human beings.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fb833a61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_891b3c7f",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_concept",
      "label": "Antisemitic Concept",
      "description": "The meme is based on the antisemitic concept that Jewish people are inherently violent or capable of suffering in ovens, which is a direct reference to the Holocaust. This concept is used to dehumanize Jewish people and equate them with inanimate objects (pizza) to justify hatred and discrimination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fb833a61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3000e3d4",
      "@type": "EmotionExpression",
      "instance_name": "distress",
      "label": "distressed emotion",
      "description": "The woman's facial expression shows alarm and discomfort, with her eyes wide and mouth open as if reacting to extreme heat or danger. Her body posture—leaning forward with oven mitts—reinforces the sense of urgency and fear.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fb833a61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f34b6bf7",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Jew is mapped to pizza",
      "description": "The top text 'what's the difference between a jew and a pizza' explicitly sets up an analogy where 'jew' is being compared to 'pizza'. The visual material, specifically the woman reacting with distress to the hot pizza, is used to represent the 'pizza' side of the analogy. The woman's reaction (distress) is mapped onto the implied 'jew' (as a human being) to suggest that a 'jew' would 'scream' in the oven, contrasting with the pizza which does not. This is a dehumanizing metaphor where the pizza (visual) is used to represent the 'jew' (textual) in the analogy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fb833a61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7b6360b0",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman reacting to the hot pizza",
      "description": "The user is projected onto the visual material of the woman reacting with distress to the hot pizza, as her alarmed expression and action (pulling the pizza from the oven) are used to metaphorically represent the implied suffering of a 'jew' in the oven. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the visual material is framed to evoke the user's identification with the woman's reaction, thereby projecting the user's perspective onto her distress. This projection reinforces the hateful message by making the user feel implicated in the metaphorical violence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fb833a61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
