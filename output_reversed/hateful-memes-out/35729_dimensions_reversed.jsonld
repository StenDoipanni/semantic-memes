    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ad5fca9c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "LGBTQ+ visibility is mapped as attention-seeking behavior",
      "description": "The text 'looking for attention?' is juxtaposed with the visual of two people wrapped in a rainbow flag, which is a symbol of LGBTQ+ pride and visibility. The mapping implies that the act of being visibly proud (represented by the flag and the scene) is equated with seeking attention, aligning with the 'Visibility as attention seeking' stereotype. This mapping is reinforced by the text 'join us' which suggests the group is inviting others to participate in this supposedly attention-seeking behavior, further embedding the stereotype in the visual context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0a04378e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6114eafc",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the text overlay as the target of accusation",
      "description": "The user is implicitly projected onto the text 'looking for attention?' which frames the viewer as the one who is being accused of seeking attention. The text 'join us' further implies the user is being invited to join the group being criticized, thus projecting the user onto the scene as a potential participant in the stereotyped behavior. This projection is not explicit with deictic pronouns like 'you' or 'me', but is implied through the accusatory tone and the invitation to join, which positions the viewer as the one being addressed or targeted by the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0a04378e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
