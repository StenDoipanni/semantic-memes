      "@id": "http://example.org/multimodal-taxonomy#dimension_b0a19ad6",
      "@type": "EmotionExpression",
      "instance_name": "derision",
      "label": "derisive emotion",
      "description": "The emotion expressed is derision, conveyed through the accusatory text overlay 'looking for attention?' which mocks the visibility of LGBTQ+ individuals as attention-seeking behavior. This is reinforced by the juxtaposition of the peaceful, proud scene with the hostile text, creating an emotionally charged and demeaning tone.",
      "belongsToAnalysis": {
