      "instance_name": "visibility_as_attention_seeking_stereotype",
      "label": "Visibility as 'attention seeking' stereotype",
      "description": "A derogatory stereotype that frames LGBTQ+ individuals as seeking attention by being visibly proud of their identity, often used to delegitimize or mock their visibility. This stereotype is part of broader LGBTQ+ discrimination tropes and is harmful as it discourages open expression of identity and reinforces social stigma.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0a04378e"
      },
      "extractionMethod": "llm_extraction_huggingface"
