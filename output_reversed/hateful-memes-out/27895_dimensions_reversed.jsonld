    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2817c170",
      "@type": "Scene",
      "instance_name": "political_attack_scene",
      "label": "Political Attack Scene",
      "description": "The scene depicts a juxtaposition of a woman (Rep. Ilhan Omar) with an image of the 9/11 attacks, using text that falsely claims she 'forgot' the 9/11 attacks. The scene is designed to discredit her by association with the 9/11 attacks, which is a form of political propaganda and character assassination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cec4f3a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f06b05df",
      "@type": "BackgroundKnowledge",
      "instance_name": "911_attacks",
      "label": "September 11, 2001 terrorist attacks",
      "description": "The 9/11 attacks were a series of coordinated terrorist attacks carried out by the Islamic extremist group al-Qaeda against the United States, resulting in the destruction of the Twin Towers of the World Trade Center in New York City. This event is one of the most significant and traumatic in modern American history and is often invoked in political discourse to evoke national unity or grievance. The meme uses this event to falsely accuse Rep. Ilhan Omar of forgetting or being ungrateful for it, which is a form of political character assassination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cec4f3a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5a2356e3",
      "@type": "BackgroundKnowledge",
      "instance_name": "ilhan_omar",
      "label": "Ilhan Omar",
      "description": "Ilhan Omar is a Somali-American politician and the first Somali-American woman elected to the U.S. Congress, representing Minnesota. She is a member of the Democratic Party and has been a vocal advocate for progressive policies, including immigration reform and racial justice. The meme falsely accuses her of forgetting the 9/11 attacks, which is a baseless and politically motivated attack intended to discredit her. Her identity as a Muslim woman of African descent is central to the meme's harmful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cec4f3a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e700e9a9",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia",
      "label": "Islamophobia",
      "description": "Islamophobia is the fear, dislike, or prejudice against Islam and Muslims. It often manifests as stereotypes that associate Muslims with terrorism, violence, or being incompatible with Western values. The meme leverages this stereotype by using the 9/11 attacks — an event associated with Muslim extremists — to attack Rep. Ilhan Omar, who is a Muslim, thereby implying that she is somehow connected to or responsible for the attacks. This is a classic example of using a traumatic historical event to stigmatize a religious group.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cec4f3a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1291cec8",
      "@type": "BackgroundKnowledge",
      "instance_name": "political_character_assassination",
      "label": "Political Character Assassination",
      "description": "This is a rhetorical strategy in which a person's character is attacked to discredit their policies or arguments, rather than addressing the substance of their claims. The meme is a textbook example of this, using a false accusation (that she 'forgot' 9/11) to delegitimize Rep. Ilhan Omar's political position. This tactic is often used to provoke emotional reactions and distract from actual policy debates.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cec4f3a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c60cf021",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_muslim_stereotype",
      "label": "Anti-Muslim Stereotype",
      "description": "This stereotype falsely equates all Muslims with terrorism or violence, often using historical events like 9/11 to reinforce this association. The meme relies on this stereotype by implying that Rep. Ilhan Omar, as a Muslim, is somehow complicit in or ungrateful for the 9/11 attacks. This is a harmful and inaccurate generalization that contributes to the marginalization of Muslim communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cec4f3a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8540d799",
      "@type": "EmotionExpression",
      "instance_name": "contemplative_seriousness",
      "label": "serious and contemplative expression",
      "description": "The woman's facial expression, with her gaze directed slightly away and a neutral to serious mouth, conveys a sense of deep thought, solemnity, or perhaps defensiveness. Her expression does not appear to be overtly emotional like anger or sadness, but rather one of quiet intensity or reflection, possibly in response to the gravity of the situation or the accusation implied by the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cec4f3a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_97964ec0",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_2",
      "label": "The text 'we are fighting this together' maps the woman onto the collective response to the 9/11 attacks.",
      "description": "The phrase 'we are fighting this together' in the text overlay is used to imply that the woman is part of the collective response to the 9/11 attacks. This creates an analogical mapping where the woman is projected as being part of the 'we' that is fighting, which is visually represented by the image of the 9/11 attacks. The mapping is established through the juxtaposition of the text and the visual, where the woman is implicitly equated with the collective response to the event.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cec4f3a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2b14a158",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the text overlay",
      "description": "The user is projected onto the textual material 'nevr forget' - you said... we didn't forget and we are fighting this together', which uses the second-person pronoun 'you' to directly address the viewer. This creates a semiotic projection where the user is positioned as the speaker of the text, implying they are the one who said 'nevr forget' and are now being challenged by the meme's message. The projection is onto the text_chunk entity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cec4f3a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_be112508",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme uses a traumatic historical event (9/11) to falsely accuse Rep. Ilhan Omar of forgetting it, which is a form of political character assassination. This can cause emotional distress and contribute to a hostile political environment by misrepresenting a public figure and using a national tragedy for political attack.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cec4f3a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6be56f84",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The intended audience is individuals who hold anti-Muslim sentiments or are politically motivated to discredit Muslim politicians, particularly those who support progressive policies. The meme leverages the 9/11 attacks—a traumatic event often invoked in political discourse—to stigmatize Rep. Ilhan Omar, a Muslim woman of African descent, by falsely accusing her of forgetting the attacks. This targets communities that may be influenced by Islamophobic stereotypes, which associate Muslims with terrorism or violence. The meme is designed to provoke outrage and hostility toward her or her supporters, thereby appealing to audiences who are predisposed to anti-Muslim rhetoric and political character assassination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cec4f3a5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
