    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b36038db",
      "@type": "EmotionExpression",
      "instance_name": "mocking_indifference",
      "label": "mocking indifference expression",
      "description": "The man (actor Mike Myers) displays a stern, unimpressed facial expression, characterized by a flat, deadpan look, slightly narrowed eyes, and a neutral mouth. This expression is culturally recognized as conveying sarcasm, disdain, or a dismissive attitude toward something perceived as trivial or absurd. In this context, it is used to mock the gravity of a tragic event — a fatal car accident — by implying that the event is somehow humorous or inconsequential.",
      "belongsToAnalysis": {
