    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fb75f25b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The man's mocking indifference expression is mapped onto the tragic event",
      "description": "The visual entity 'man' (actor Mike Myers) with his stern, unimpressed facial expression is used to represent or stand in for the textual entity 'tragic_event_meme'. The meme's intent is to map the man's expression — which conveys mocking indifference — onto the tragic event described in the text ('there was a 4 car pile-up in mexico' and 'today 93 people died'), implying that the event is trivial or humorous. This is an analogical mapping where the visual expression serves as a symbolic representation of a dismissive attitude toward the text's subject.",
      "belongsToAnalysis": {
