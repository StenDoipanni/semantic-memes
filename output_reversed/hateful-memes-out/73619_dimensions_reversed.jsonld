    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c018af77",
      "@type": "VisualMaterial",
      "instance_name": "child",
      "label": "young child with curly hair",
      "description": "A young child with voluminous, curly brown hair, wearing an orange zip-up sweater and blue jeans, is holding a pink cotton candy on a stick. The child is looking upward with an expression of surprise or delight, and has one hand raised in a gesture of excitement or questioning. The child is the central focus of the image and is the subject of the meme's text overlay.",
