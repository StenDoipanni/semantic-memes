    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_07b154c7",
      "@type": "BackgroundKnowledge",
      "instance_name": "hard_work_stereotype",
      "label": "Hard Work Stereotype",
      "description": "The meme relies on the stereotype that manual labor and rural work (like farming) are inherently associated with hard work, perseverance, and moral virtue. This stereotype is often used to justify or glorify physical labor over other forms of work or lifestyles. The image of the man with hay bales reinforces this by visually associating him with agricultural labor, which is culturally coded as 'real' or 'genuine' work.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bac5e365"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e946c7f4",
      "@type": "BackgroundKnowledge",
      "instance_name": "motivational_advice_culture",
      "label": "Motivational Advice Culture",
      "description": "The meme is part of a broader cultural phenomenon where motivational quotes and images are used to inspire self-improvement, often through simplistic, blunt, or even harsh language. The phrase 'get off your ass and earn it' is a common trope in this culture, used to encourage personal responsibility and action. This cultural context is necessary to understand why the phrase is paired with the image and why it is framed as advice.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bac5e365"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_295b4962",
      "@type": "BackgroundKnowledge",
      "instance_name": "rural_american_worker_stereotype",
      "label": "Rural American Worker Stereotype",
      "description": "The image of a man in a rural, agricultural setting (hay bales, field) is often used to represent the 'everyman' or 'hardworking American' archetype. This stereotype is rooted in American cultural narratives that valorize rural life, self-reliance, and physical labor as virtues. The man’s attire (cap, striped shirt, jeans) and posture reinforce this archetype, which is culturally coded as trustworthy and industrious.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bac5e365"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7b7c3ebd",
      "@type": "BackgroundKnowledge",
      "instance_name": "lazy_unemployed_characterization",
      "label": "Lazy/Unemployed Characterization",
      "description": "The phrase 'get off your ass' is a disparaging metaphor that implicitly references the stereotype of laziness or idleness, often associated with people who are unemployed or not working. This stereotype is part of a broader cultural narrative that equates inactivity with moral failure. The meme uses this stereotype to contrast the 'lazy' person with the 'hardworking' person (the man in the image), reinforcing the message that effort is required to achieve goals.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bac5e365"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_21314ad1",
      "@type": "BackgroundKnowledge",
      "instance_name": "self_reliance_philosophy",
      "label": "Self-Reliance Philosophy",
      "description": "The meme is grounded in the philosophical concept of self-reliance, which emphasizes individual responsibility and the belief that one must earn their own success through personal effort. This philosophy is often associated with American ideals of independence and rugged individualism. The image of the man standing confidently next to his labor (hay bales) visually embodies this philosophy, making the text's message more impactful.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bac5e365"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_82a17b03",
      "@type": "EmotionExpression",
      "instance_name": "determination",
      "label": "determined emotion",
      "description": "The man's facial expression and posture convey a sense of resolve and confidence. He is leaning against a hay bale with one hand on his hip, looking directly forward with a focused gaze, which visually communicates determination and readiness to act.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bac5e365"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_720fe18b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The man is mapped as the embodiment of someone who 'earns' things through hard work.",
      "description": "The text 'if you want something get off your ass and earn it' implicitly maps the visual entity 'man' as the archetype of someone who achieves goals through effort. The man's posture (leaning against hay bales, hand on hip) and setting (rural field) visually reinforce the stereotype of a hardworking rural American worker, which is then used to represent the ideal person who 'earns' things. This mapping is supported by the background knowledge entities 'rural_american_worker_stereotype' and 'self_reliance_philosophy'. The text's message is made concrete by projecting the visual of the man onto the abstract concept of 'earning' through action.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bac5e365"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bdac621b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene and text as the recipient of motivational advice",
      "description": "The user is projected onto the scene and text as the intended recipient of the motivational message. The text 'if you want something get off your ass and earn it' directly addresses the user with 'you', making the user the subject of the imperative. The user is thus projected onto the scene (standing_man_with_hay_bales) as the person who must take action, and onto the textual material (text_chunk) as the one who must heed the advice. The visual of the man embodies the ideal recipient of the advice — someone who has earned their success — and the user is implicitly mapped onto this ideal through the deictic 'you'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bac5e365"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e7a288b4",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "motivational_advice_culture",
      "description": "The meme is designed for individuals engaged in or interested in motivational advice culture, which values self-improvement, personal responsibility, and inspirational messages often delivered through blunt or harsh language. The phrase 'get off your ass and earn it' is a common trope in this culture, used to encourage action and effort.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bac5e365"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
