    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5d186f88",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The girl is mapped as the embodiment of disappointment at the worst pajama party ever",
      "description": "The visual entity 'girl' (a young girl with a displeased expression, arms crossed) is mapped onto the textual entity 'worst pijama party ever'. The girl's frustrated expression and posture serve as a visual representation of the negative sentiment conveyed by the text. This is a classic disappointment meme trope where the person's emotion is used to symbolize the event described in the text. The text explicitly labels the event as 'worst... ever', and the girl's visual demeanor is used to project that extreme negative evaluation onto the scene.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_44528c38"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_977e569d",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the disappointed girl at the pajama party",
      "description": "The user is projected onto the visual material of the girl, who embodies the sentiment of disappointment expressed in the text. The meme uses the girl's frustrated expression and posture as a visual stand-in for the user's own experience or imagined experience of attending the 'worst pajama party ever'. There are no explicit deictic pronouns like 'me' or 'you', but the framing of the girl as the embodiment of the negative experience creates an implicit identification with the viewer/user, who is expected to recognize themselves in her frustration. This is a common trope in disappointment memes where the viewer projects their own feelings or situation onto the depicted character.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_44528c38"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_22df6b2d",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme uses a visual of a young girl expressing disappointment to humorously convey a negative experience with a pajama party. While the content is lighthearted and self-deprecating, the framing of the event as the 'worst ever' and the use of a child's frustrated expression can be interpreted as potentially harmful by normalizing or trivializing negative social experiences. The meme does not target any specific group or individual, but its exaggerated portrayal of disappointment may contribute to a culture of cynicism or discourage participation in social events. The overall intent is comedic, but the potential for harm lies in the amplification of negative sentiment through visual and textual tropes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_44528c38"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c68e899c",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "disappointment meme trope audience",
      "description": "The intended audience is individuals familiar with internet meme culture, particularly those who recognize and appreciate the 'disappointment meme' trope — where a person (often a child or teenager) displays a frustrated or displeased expression to humorously convey dissatisfaction with an event or situation. This audience understands the sarcastic comedic style and the exaggerated emotional reaction used for comedic effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_44528c38"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
