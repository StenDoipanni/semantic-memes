    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_564d010a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Cher is mapped as 'part Indian' belonging to the 'Smackahoe tribe'",
      "description": "The top text 'why yes i'm part indian' and the bottom text 'i'm from the smackahoe tribe' together create an analogical mapping where Cher, as the visual entity, is being projected as the speaker of these statements. The meme implies that Cher is the 'part Indian' individual who belongs to the fictional 'Smackahoe tribe'. This mapping is established through the juxtaposition of her image with the text, which frames her as making a self-deprecating, humorous claim about her heritage. The visual material (Cher) is mapped onto the textual material (the claim of being 'part Indian' and belonging to the 'Smackahoe tribe'), creating a direct analogical relationship where the celebrity is the entity being described by the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d3d58faa"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6ee1dd1e",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual material of Cher making a self-deprecating claim",
      "description": "The user is projected onto the visual material of Cher, who is depicted as the speaker of the meme's text. The text 'why yes i'm part indian' and 'i'm from the smackahoe tribe' frames Cher as the entity making the humorous, self-deprecating statement about her heritage. The user sees Cher as the 'part Indian' individual belonging to the fictional 'Smackahoe tribe', projecting themselves onto her as the subject of the joke. This projection is implicit, as the meme uses Cher's image to represent the speaker of the text, and the user identifies with the persona being portrayed.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d3d58faa"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
