    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_634c697a",
      "@type": "BackgroundKnowledge",
      "instance_name": "racist_trope_black_and_white",
      "label": "Racist Trope: 'In plain black and white'",
      "description": "The phrase 'in plain black and white' is a racist trope used to dehumanize Black individuals by reducing them to a monochromatic, simplistic, and often stereotypical representation. It implies that Black people are inherently 'black and white' — either good or bad — and lacks nuance, reinforcing racial bias and harmful stereotypes. This trope is often used to justify prejudice by suggesting that Black people are inherently simplistic or one-dimensional.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_07094907"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6dcda92c",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_hypersexualization",
      "label": "Anti-Black Stereotype: Hypersexualization",
      "description": "The stereotype that Black men are hypersexualized — often portrayed as overly aggressive, lustful, or sexually threatening — is used to dehumanize and demean Black men. This stereotype is frequently invoked in racist discourse to justify discrimination, fear, or contempt. In this meme, the intimate pose between the Black man and white woman is weaponized to imply that the Black man is 'disgusting' for being 'too sexual' or 'too much' — a direct application of hypersexualization as a racist trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_07094907"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_617410f2",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_racial_disgust",
      "label": "Anti-Black Stereotype: Racial Disgust",
      "description": "The concept of 'racial disgust' refers to the visceral, often irrational, revulsion directed at Black people based on their race. This is a core component of systemic racism and is used to justify exclusion, violence, or contempt. The meme's text 'the definition of utter disgust' directly invokes this concept, implying that the Black man is inherently repulsive — a racist assertion that relies on the viewer's internalized racial biases.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_07094907"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b7efa0f8",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_dehumanization",
      "label": "Anti-Black Stereotype: Dehumanization",
      "description": "Dehumanization is the process of denying a person's humanity, often by portraying them as less than human, animal-like, or subhuman. In this meme, the Black man is reduced to a 'plain black and white' image — a visual metaphor for dehumanization — stripping him of his individuality, complexity, and humanity. This is a common tactic in racist discourse to justify hatred and violence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_07094907"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9ed9d540",
      "@type": "EmotionExpression",
      "instance_name": "racial_disgust",
      "label": "expression of racial disgust",
      "description": "The text overlay 'the definition of utter disgust' explicitly expresses a visceral, hateful revulsion directed at the Black man depicted in the image. This emotion is not expressed through facial expressions or gestures in the visual material, but is directly conveyed through the hateful textual message, which frames the Black man as inherently repulsive based on his race.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_07094907"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2e32b39a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The Black man is mapped as 'the definition of utter disgust'",
      "description": "The top text overlay 'the definition of utter disgust' is directly mapped onto the visual entity 'man' (the Black man). The meme uses the intimate pose of the Black man to visually represent the textual claim that he embodies 'utter disgust', creating an analogical mapping where the man is equated with the concept of disgust. This is a hateful mapping that dehumanizes the man by associating him with a negative emotional state.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_07094907"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1942ccdb",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the Black man as the embodiment of 'utter disgust'",
      "description": "The user is projected onto the visual entity 'man' (the Black man) through the textual claim 'the definition of utter disgust'. The meme forces the viewer to internalize the hateful message by equating the man's physical presence with the concept of disgust, thereby projecting the user's own biases or the meme's intended message onto him. This is a dehumanizing projection that reduces the man to a symbol of racial disgust.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_07094907"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fa67cd8c",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks a Black man based on his race, using the text 'the definition of utter disgust' to dehumanize him and imply he is inherently repulsive. This is a hateful attack targeting a protected characteristic (race).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_07094907"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
