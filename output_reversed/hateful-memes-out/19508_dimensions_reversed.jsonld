      "@id": "http://example.org/multimodal-taxonomy#dimension_f48e2739",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "racist audience",
      "description": "The meme is designed for an audience that holds racist beliefs, particularly anti-Black racism. The target community includes individuals who internalize and propagate racial stereotypes, such as the hypersexualization of Black men and the dehumanizing trope of 'in plain black and white.' The hateful message is intended to provoke disgust and reinforce racial bias among those who already hold prejudiced views toward Black people.",
      "belongsToAnalysis": {
