    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d308f2a4",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Brett Kavanaugh is the boy shouting into the megaphone",
      "description": "The text 'brett kavanaugh' at the top of the image is mapped onto the visual entity 'boy' (the young boy in vintage attire shouting into a megaphone). This mapping equates the political figure Brett Kavanaugh with the childish, absurd visual of a boy shouting, implying that Kavanaugh is portrayed as immature or base. The mapping is established by direct textual reference to the visual subject, creating an analogical equivalence where the text identifies the visual entity as the person named.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0f7f079d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7085eb36",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual claim of personal violation",
      "description": "The user is projected onto the textual material 'grabbed my penis' at the bottom of the image. This phrase uses the first-person possessive 'my' to directly address the viewer as the victim of the alleged act. The projection is onto the textual material, which explicitly frames the user as the person experiencing the violation, thereby making the abusive content personal and direct. The user is not projected onto the visual material (the boy) or the scene, but specifically onto the text that uses 'my' to create a deictic link to the viewer.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0f7f079d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
