    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_31895b08",
      "@type": "BackgroundKnowledge",
      "instance_name": "brett_kavanaugh",
      "label": "Brett Kavanaugh",
      "description": "Brett Kavanaugh is a real-world individual who served as an Associate Justice of the Supreme Court of the United States. He is a prominent political figure known for his conservative judicial philosophy and his controversial confirmation hearings in 2018, during which allegations of sexual assault were made against him. The meme uses his name to target him with a vulgar and abusive accusation, leveraging his public persona and the context of his political career to create a mocking and degrading image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0f7f079d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7d288aeb",
      "@type": "BackgroundKnowledge",
      "instance_name": "sexual_assault_allegations_against_kavanaugh",
      "label": "Sexual Assault Allegations Against Brett Kavanaugh",
      "description": "In 2018, during the confirmation hearings for Brett Kavanaugh's appointment to the Supreme Court, multiple women came forward with allegations of sexual assault and misconduct against him. These allegations were central to the political and public discourse surrounding his nomination. The meme references these allegations by using the phrase 'grabbed my penis,' which is a vulgar and crude way to refer to sexual assault, implying that Kavanaugh is a figure of predatory or inappropriate behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0f7f079d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d261234f",
      "@type": "BackgroundKnowledge",
      "instance_name": "vulgar_language",
      "label": "Vulgar Language",
      "description": "The phrase 'grabbed my penis' is a crude, explicit, and vulgar expression used to describe a sexual assault. This type of language is often used in memes to shock, provoke, or demean. The use of such language in this context is intended to be offensive and degrading, targeting Brett Kavanaugh personally and directly. Understanding the offensive nature of this language is essential to interpreting the meme's abusive intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0f7f079d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a492aa9a",
      "@type": "BackgroundKnowledge",
      "instance_name": "child_shouting_into_megaphone_stereotype",
      "label": "Child Shouting into a Megaphone Stereotype",
      "description": "The image of a child shouting into a megaphone is often used in memes to represent childishness, absurdity, or a lack of seriousness. In this context, it is used to mock Brett Kavanaugh by implying that he is a figure of childish or base behavior, suggesting that his actions or public persona are immature or ridiculous. This stereotype is a common trope in internet culture to diminish or ridicule a person by associating them with something perceived as silly or infantile.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0f7f079d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9e735379",
      "@type": "BackgroundKnowledge",
      "instance_name": "abusive_meme_intention",
      "label": "Abusive Meme Intention",
      "description": "The meme is designed to be abusive, using vulgar language and a demeaning metaphor to attack an individual. The intent is to insult and provoke a negative emotional response. This type of meme relies on the understanding that the content is meant to be offensive and degrading, which is a common characteristic of abusive online content. The background knowledge required to understand this includes the concept of abusive intent in digital communication and the cultural context of internet memes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0f7f079d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6cfce47b",
      "@type": "EmotionExpression",
      "instance_name": "mockery",
      "label": "mocking emotion",
      "description": "The visual of a child shouting into a megaphone, combined with the vulgar text 'grabbed my penis', expresses a mocking and derisive emotion. The absurdity of the child's action juxtaposed with the crude accusation creates a tone of ridicule and contempt towards Brett Kavanaugh.",
      "belongsToAnalysis": {
