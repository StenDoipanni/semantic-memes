    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dad6b146",
      "@type": "BackgroundKnowledge",
      "instance_name": "Ron_Burgundy_character",
      "label": "Ron Burgundy character",
      "description": "The character Ron Burgundy is from the 2004 film 'Anchorman: The Legend of Ron Burgundy', played by actor Will Ferrell. The character is a satirical portrayal of a 1970s news anchor known for his flamboyant style, smug demeanor, and faux-seriousness. His use in memes often leverages the contrast between his polished, professional appearance and the absurd or offensive content he is made to deliver, amplifying the meme's comedic or abusive tone.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_060989b1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9492cbd4",
      "@type": "BackgroundKnowledge",
      "instance_name": "NSW",
      "label": "New South Wales",
      "description": "New South Wales is a state in Australia, one of the six states of the Commonwealth of Australia. It is the most populous state and is often contrasted with other Australian states like Queensland in regional rivalries, particularly in sports, politics, and cultural identity. The meme references NSW as the source of the abusive message, implying a regional conflict or rivalry.",
      "belongsToAnalysis": {
