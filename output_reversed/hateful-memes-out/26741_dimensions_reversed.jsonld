    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1e74144e",
      "@type": "BackgroundKnowledge",
      "instance_name": "Australian_state_rivalries",
      "label": "Australian state rivalries",
      "description": "A cultural and often media-driven phenomenon in Australia where states like New South Wales and Queensland compete in areas such as sports, politics, and media representation. These rivalries are sometimes exaggerated or used for comedic effect, but can also fuel regional tensions. The meme exploits this dynamic to deliver an insult.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_060989b1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
