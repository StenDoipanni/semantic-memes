      "instance_name": "Profanity_in_meme_context",
      "label": "Profanity in meme context",
      "description": "The use of explicit or vulgar language in memes to convey strong emotion, shock, or insult. In this case, the phrase 'go f@#k yourself' is a direct, offensive insult. The inclusion of such language is a common meme tactic to provoke or mock, and its effectiveness relies on the audience's understanding of its vulgar nature and the social context in which it is used.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_060989b1"
      },
      "extractionMethod": "llm_extraction_huggingface"
