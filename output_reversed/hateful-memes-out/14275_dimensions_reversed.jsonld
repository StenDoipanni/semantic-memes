      "instance_name": "antisemitic_concept_holocaust_denial",
      "label": "Antisemitic Concept: Holocaust Denial",
      "description": "This is an antisemitic trope that denies or minimizes the Holocaust, the systematic genocide of six million Jewish people by Nazi Germany during World War II. This concept is used to justify hatred and violence against Jewish people by portraying them as exaggerating their suffering and seeking revenge. The meme's text implies this by suggesting that Jewish people are 'pretending to be white' and are therefore a threat to the world.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f6744fe4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
