      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_55677e79",
      "@type": "VisualMaterial",
      "instance_name": "dog",
      "label": "large fluffy white dog",
      "description": "A large, fluffy white dog with thick fur and intense brown eyes is staring directly at the viewer. The dog's expression appears serious and confrontational, with its head slightly tilted. The background is completely black, which makes the dog stand out prominently. The dog's fur is voluminous and appears soft, with some strands slightly disheveled, adding to its imposing presence. The lighting highlights the texture of the fur and the dog's facial features, emphasizing its direct gaze.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f6744fe4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8ae079c8",
      "@type": "Scene",
      "instance_name": "threatening_dog_scene",
      "label": "dog_threatening_with_text",
      "description": "A large, fluffy white dog stares intensely at the viewer, positioned centrally against a black background. Superimposed text above and below the dog delivers a hateful, antisemitic threat involving nuclear weapons and racial stereotypes. The dog's confrontational gaze and the threatening text combine to create a scene of intimidation and hate.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f6744fe4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c8cb6349",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_stereotype_jews_pretending_to_be_white",
      "label": "Antisemitic Stereotype: Jews Pretending to Be White",
      "description": "This is a derogatory antisemitic trope that falsely claims Jewish people are not ethnically 'white' and are therefore 'pretending' to fit into white society. It is used to dehumanize and marginalize Jewish people by denying their legitimacy within the racial or ethnic framework of the dominant society. This stereotype is rooted in historical antisemitism and is often used to justify discrimination and violence against Jewish communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f6744fe4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e0141832",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_threat_nuclear_weapons",
      "label": "Antisemitic Threat: Nuclear Weapons",
      "description": "The explicit mention of '72 nukes aimed at Israel' is a hyperbolic and threatening statement that leverages the fear of nuclear annihilation to intimidate and incite violence. In the context of antisemitism, such threats are often used to portray Jewish people or the State of Israel as a dangerous, existential threat to the world, reinforcing the 'Jewish world conspiracy' myth and justifying violent action against them.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f6744fe4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_be16a61a",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_threat_wipe_israel_off_map",
      "label": "Antisemitic Threat: Wipe Israel Off the Map",
      "description": "This phrase is a violent and genocidal threat that implies the complete destruction and erasure of the State of Israel and its people. It is a common trope in antisemitic rhetoric, used to express a desire for the physical elimination of Jewish people and their national homeland. This phrase is often used to justify extreme violence and is a direct call for genocide.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f6744fe4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7e327ec8",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_concept_jewish_world_conspiracy",
      "label": "Antisemitic Concept: Jewish World Conspiracy",
      "description": "This is a long-standing antisemitic conspiracy theory that falsely claims Jewish people secretly control global financial, political, and media institutions. This concept is used to justify hatred and violence against Jewish people by portraying them as a dangerous, manipulative force that must be eliminated. The meme's text implies this by suggesting that Jewish people are 'pretending to be white' and are therefore a threat to the world.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f6744fe4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2d24d53c",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_concept_puppet_master",
      "label": "Antisemitic Concept: Puppet Master",
      "description": "This is an antisemitic trope that portrays Jewish people as manipulative 'puppet masters' who control global events and governments. This concept is used to dehumanize Jewish people and justify their persecution by portraying them as dangerous, controlling figures who must be removed from power. The meme's text implies this by suggesting that Jewish people are 'pretending to be white' and are therefore a threat to the world.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f6744fe4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
