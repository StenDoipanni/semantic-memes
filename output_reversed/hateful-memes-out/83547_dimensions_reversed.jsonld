    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_124d4c9a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "White people are mapped onto the woman holding pets",
      "description": "The top text overlay 'why do \"white people\" own so many pets ?' explicitly refers to 'white people' as the subject of the question. This textual entity is mapped onto the visual entity 'woman' in the image, who is depicted holding multiple pets. The meme uses this visual representation to imply that the woman (as a symbol of 'white people') is the one who owns the pets, thereby creating an analogical mapping between the textual concept of 'white people' and the visual depiction of the woman with pets.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7c62f9f2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2ea8a999",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman holding pets",
      "description": "The user is projected onto the visual material of the woman holding multiple pets, as the meme uses her as a visual stand-in for 'white people' in the textual question. The user is implicitly identifying with or seeing themselves as the subject of the meme's rhetorical question, which asks 'why do \"white people\" own so many pets?'. The woman's affectionate interaction with the pets serves as the visual anchor for this projection, even though the text explicitly targets a racial group. The user is not directly addressed with deictic pronouns like 'you' or 'me', but the rhetorical structure and the visual representation create an implicit projection where the viewer is positioned as the one asking the question or as the one who might be expected to understand the stereotype being presented.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7c62f9f2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
