    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5b497e37",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed to target individuals who hold or are exposed to racist ideologies, particularly those who subscribe to anti-Black stereotypes and historical eugenics narratives. The target audience likely includes people who are familiar with or sympathetic to the false premise of 'Black population control' and the hypersexualization of Black men as a justification for systemic oppression. The meme appeals to those who may find the imagery of forced restraint and the accompanying text provocative or 'edgy,' using it to reinforce existing racist beliefs or to provoke outrage among those who oppose the depicted stereotypes. The audience is implicitly defined by their acceptance of the meme's hateful message, which frames Black people as biologically inferior and in need of state control, thus targeting communities that perpetuate or benefit from such ideologies.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14814973"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
