    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5a330380",
      "@type": "VisualMaterial",
      "instance_name": "Black_man",
      "label": "central figure",
      "description": "A Black man is seated in a chair, restrained with straps around his torso, arms, and legs. He appears calm or resigned, looking forward. His posture and the restraints suggest he is being forcibly held in place, likely in a medical or institutional setting. This is the focal point of the visual material and the subject of the overlaid text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14814973"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eb8f9919",
      "@type": "Scene",
      "instance_name": "restraint_scene",
      "label": "forced_restraint",
      "description": "A Black man is seated in a chair and restrained with straps around his torso, arms, and legs by multiple white men. The scene depicts a coercive and degrading interaction, likely in a medical or institutional setting. The Black man appears calm or resigned, while the white men are actively securing him. This scene is juxtaposed with racist text claiming that 'they don't know how to use condom' and 'this is the only way to control their population,' which frames the restraint as a form of population control.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14814973"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a96feb2d",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_hypersexualization",
      "label": "Hypersexualization of Black men",
      "description": "The meme relies on the racist stereotype that Black men are hypersexual and therefore require population control through coercive means, such as forced sterilization or medical experimentation. This stereotype is used to justify the degrading imagery of restraint and to frame the Black man as a biological threat needing control.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14814973"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_11b2307b",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_eugenics_programs",
      "label": "Historical Eugenics Programs",
      "description": "The meme references the real-world historical practice of eugenics, particularly in the United States, where forced sterilization and other coercive population control measures were implemented against marginalized groups, including Black people, under the guise of public health and racial purity. The image of restraint is a visual metaphor for these coercive medical interventions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14814973"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_214a7486",
      "@type": "BackgroundKnowledge",
      "instance_name": "forced_restraint_as_population_control",
      "label": "Forced Restraint as a Symbol of Population Control",
      "description": "The meme uses the visual of forced restraint to symbolize a broader, systemic effort to control the population of Black people. This is a metaphorical extension of historical and contemporary racist ideologies that view Black people as needing to be managed or controlled due to perceived overpopulation or biological inferiority.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14814973"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_22c4ca9c",
      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_medical_experimentation",
      "label": "Racialized Medical Experimentation",
      "description": "The image and text imply a history of racialized medical experimentation on Black people, where their bodies were subjected to invasive procedures without consent. The restraint scene is a visual echo of such experiments, which were often justified by pseudoscientific claims about racial inferiority and the need for population control.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14814973"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_529aa8df",
      "@type": "BackgroundKnowledge",
      "instance_name": "black_population_control_rhetoric",
      "label": "Black Population Control Rhetoric",
      "description": "The meme draws on racist rhetoric that has historically been used to justify systemic oppression and control over Black communities, including claims about overpopulation, biological inferiority, and the need for state intervention. This rhetoric is often used to dehumanize Black people and justify discriminatory policies.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14814973"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_633d7441",
      "@type": "EmotionExpression",
      "instance_name": "dehumanization",
      "label": "dehumanizing emotion",
      "description": "The emotion expressed is one of dehumanization, conveyed through the visual of a Black man being forcibly restrained and the accompanying text that frames him as a biological threat requiring population control. This reduces his humanity to a mere statistic or object of control, stripping away his dignity and agency.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14814973"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_801476d5",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Black man is mapped as 'they' who don't know how to use condom",
      "description": "The top text 'they don't know how to use condom' explicitly refers to the Black man in the image as 'they'. This is an analogical mapping where the textual entity 'they' is projected onto the visual entity 'Black_man', equating the Black man with a collective group that is stereotyped as lacking knowledge about contraception. This mapping is central to the meme's hateful intent, as it uses the visual of restraint to symbolize the supposed need for population control based on this false premise.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14814973"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dbd099fd",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the Black man as the target of the racist population control narrative",
      "description": "The user is not explicitly projected onto a specific entity via deictic pronouns like 'me' or 'you'. However, the meme's hateful intent and the projection of the racist stereotype onto the Black man (via 'they' in the text) create an implicit semiotic projection where the user is positioned as the one who understands or endorses the racist logic. The user is projected onto the scene and the textual material as the one who interprets the image and text as a justification for systemic control over Black people. The user is not directly projected onto a specific visual or textual entity, but the entire meme functions as a projection of the user's potential acceptance of the hateful narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_14814973"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6f86fda0",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme uses racist and dehumanizing stereotypes to justify systemic oppression and control over Black communities, equating Black people with biological inferiority and the need for state-imposed control.",
      "belongsToAnalysis": {
