    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9e3a79ac",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "sheep are mapped to ISIS followers",
      "description": "The text 'at the isis strip club' is overlaid on the image of two sheep, creating an analogical mapping where the sheep are metaphorically mapped to ISIS followers. This mapping is based on the meme's use of sheep as a visual metaphor for followers or adherents of a group, particularly one perceived as blindly obedient or easily manipulated. The text explicitly labels the sheep as being 'at the isis strip club', which is a satirical and derogatory reference to ISIS, thereby projecting the visual entity (sheep) onto the textual entity (ISIS followers).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d65984ea"
