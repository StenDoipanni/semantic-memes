    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_abf1ec62",
      "@type": "BackgroundKnowledge",
      "instance_name": "isis_strip_club_stereotype",
      "label": "ISIS Strip Club Stereotype",
      "description": "The phrase 'at the ISIS strip club' is a satirical and derogatory reference to ISIS (Islamic State of Iraq and Syria), a terrorist organization. It leverages the stereotype that ISIS is associated with extreme violence, sexual repression, and barbarism, while juxtaposing it with the concept of a 'strip club' to create a jarring, absurd, and offensive contrast. This is a form of dark humor that relies on the real-world perception of ISIS as a violent, misogynistic, and extremist group, which is not visible in the image but is essential to understanding the meme's intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d65984ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1df79f72",
      "@type": "BackgroundKnowledge",
      "instance_name": "sheep_as_metaphor_for_followers",
      "label": "Sheep as Metaphor for Followers",
      "description": "The image uses sheep as a visual metaphor for followers or adherents of a group, particularly one that is perceived as blindly obedient or easily manipulated. This metaphor is rooted in real-world cultural and political discourse, where 'sheep' is used to describe people who follow leaders or ideologies without critical thought. The meme implies that the sheep in the 'ISIS strip club' scene are blindly following a leader or ideology, which is a stereotype often applied to groups perceived as lacking independent thought or moral agency.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d65984ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aad3f3e7",
      "@type": "BackgroundKnowledge",
      "instance_name": "isis_terrorism_stereotype",
      "label": "ISIS Terrorism Stereotype",
      "description": "The meme relies on the real-world stereotype that ISIS is a terrorist organization associated with violence, extremism, and the oppression of women. This stereotype is not visible in the image but is essential to understanding the offensive and satirical nature of the phrase 'ISIS strip club'. The juxtaposition of ISIS with a strip club is meant to be shocking and absurd, playing on the idea that ISIS is a group that would be 'unfit' or 'incompatible' with such a setting, which is a form of dark humor that relies on real-world perceptions of ISIS.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d65984ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c71aad11",
      "@type": "BackgroundKnowledge",
      "instance_name": "sheep_as_metaphor_for_mass_following",
      "label": "Sheep as Metaphor for Mass Following",
      "description": "The image uses sheep as a visual metaphor for mass following or conformity, which is a common cultural trope. This metaphor is rooted in real-world discourse where 'sheep' is used to describe people who follow trends, leaders, or ideologies without questioning. The meme implies that the sheep in the 'ISIS strip club' scene are part of a large, obedient group, which is a stereotype often applied to groups perceived as lacking independent thought or moral agency.",
