    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_54ba7ffd",
      "@type": "EmotionExpression",
      "instance_name": "mocking_irony",
      "label": "mocking and ironic emotional expression",
      "description": "The man's facial expression and gesture, combined with the text overlay, convey a tone of sarcastic or mocking irony. His slightly raised eyebrows, open mouth mid-speech, and gesturing hand suggest he is delivering a deliberately provocative or humorous statement, even though the content is offensive. The juxtaposition of the two lines of text creates a paradoxical and mocking effect, intended to shock or provoke.",
      "belongsToAnalysis": {
