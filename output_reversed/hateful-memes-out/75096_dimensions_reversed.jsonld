    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_49f46c90",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: i'm not saying you're retarded but you're retarded; hasOverallIntent: Harmful; overall-intent-description: The image features a man speaking into a microphone with text overlaid that reads \"i'm not saying you're retarded but you're retarded.\" The scene is a meme format that uses juxtaposition to create a paradoxical or ironic statement. The text is intentionally offensive and derogatory, using the term \"retarded\" — a historically harmful and outdated slur — to demean or insult someone. This term falls under the category of ableism, as it targets individuals with intellectual or developmental disabilities. The meme's intent is to provoke a reaction through shock value and humor derived from the offensive language, which can be harmful by reinforcing negative stereotypes and potentially causing emotional distress or harm to people with disabilities or those who are sensitive to such language. The overall intent is not to inform or educate, but to elicit a reaction through the use of a harmful and offensive term, making it a harmful meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5af78443"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
