      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7873436e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The speaker is mapped as the subject of the ironic statement",
      "description": "The visual material of the man speaking into a microphone is mapped onto the textual material 'i'm not saying you're retarded but you're retarded'. The man's expression and gesture, combined with the text, create an analogical mapping where the speaker is implicitly the subject of the rhetorical irony. The text overlays the visual scene to create a paradoxical statement, and the speaker's visual presence is the entity being referenced by the text. The mapping is established through juxtaposition and the speaker's role as the one delivering the offensive statement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5af78443"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_64066f32",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material expressing ironic insult",
      "description": "The user is projected onto the textual material 'i'm not saying you're retarded but you're retarded' because the meme uses the phrase to directly address the viewer, implying the viewer is the target of the insult. The rhetorical structure 'I'm not saying you're retarded, but you're retarded' is a direct address to the audience, making the user the implicit subject of the statement. The projection is onto the textual material, which contains the deictic-like structure that frames the viewer as the recipient of the insult.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5af78443"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
