    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_451c59c8",
      "@type": "BackgroundKnowledge",
      "instance_name": "the_fresh_prince_reference",
      "label": "The Fresh Prince of Bel-Air TV Show",
      "description": "The phrase 'the fresh prince' is a direct reference to the 1990s sitcom 'The Fresh Prince of Bel-Air,' which starred Will Smith as a young Black man who moves from a poor neighborhood in West Philadelphia to live with his wealthy relatives in Bel-Air, California. The show was a cultural phenomenon and its title character became iconic. Using this phrase to refer to Meghan Markle is a derogatory stereotype implying she is an outsider or not truly belonging in the royal family, mocking her perceived 'freshness' or 'newness' as if she were an intruder or a temporary guest, rather than a legitimate member of the royal family.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b5778aa5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a2078d55",
      "@type": "BackgroundKnowledge",
      "instance_name": "will_smith",
      "label": "Actor Will Smith",
      "description": "Will Smith is the lead actor in 'The Fresh Prince of Bel-Air,' portraying the character of Will Smith (the 'Fresh Prince'). His portrayal of a Black man from a working-class background moving into a wealthy, predominantly white environment was central to the show's premise. The meme uses his character's name and the show's title to imply that Meghan Markle is being compared to an outsider or 'newcomer' in a way that is condescending and mocking, leveraging the cultural weight of the show and its star.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b5778aa5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
