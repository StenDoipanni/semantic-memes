    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e44aaa71",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Mohammed is the person holding the bomb",
      "description": "The text 'mohammed:' explicitly labels the person holding the bomb in the visual material. This creates an analogical mapping where the textual entity 'mohammed' is mapped onto the visual entity 'person holding a bomb'. The mapping is direct and explicit through the text overlay, indicating that the person in the image is being identified as 'Mohammed'.",
      "belongsToAnalysis": {
