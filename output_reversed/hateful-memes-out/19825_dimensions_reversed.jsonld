    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e599604b",
      "@type": "Scene",
      "instance_name": "firework_watching_crowd",
      "label": "Crowd watching fireworks",
      "description": "A scene depicting a crowd of people, seen as silhouettes, watching a spectacular fireworks display. The fireworks are bursting in the sky above them, creating a bright, colorful, and celebratory atmosphere. The people are positioned in the foreground, looking upward toward the fireworks, indicating they are spectators at a public event. The scene is framed by the fiery glow of the fireworks, which illuminates the silhouettes and creates a contrast between the dark figures and the bright sky.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45a46a39"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8c5fbe9b",
      "@type": "BackgroundKnowledge",
      "instance_name": "terrorism_connotation",
      "label": "Terrorism Connotation",
      "description": "The term 'terrorist' is a highly charged label in the real world, associated with individuals or groups who commit acts of violence intended to create fear and coerce governments or populations. It carries profound social, political, and moral weight, often linked to real-world suffering, loss of life, and trauma. The meme's humor relies on the contrast between this serious connotation and the harmless, celebratory nature of a firework.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45a46a39"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e95c54c5",
      "@type": "BackgroundKnowledge",
      "instance_name": "firework_as_celebratory_object",
      "label": "Firework as Celebratory Object",
      "description": "Fireworks are universally recognized symbols of celebration, festivity, and public joy — often used in national holidays, New Year’s Eve, and other communal events. Their association with positive, non-violent spectacle is central to the meme’s irony. The meme equates the celebratory object with the violent label, creating a satirical contrast.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45a46a39"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aba82b69",
      "@type": "BackgroundKnowledge",
      "instance_name": "trivialization_of_terrorism",
      "label": "Trivialization of Terrorism",
      "description": "The meme implicitly references the real-world phenomenon of trivializing or minimizing the term 'terrorist' — sometimes done for comedic effect, political satire, or to deflect from serious issues. This can be seen as a form of cultural commentary, though it risks desensitizing viewers to the real-world consequences of terrorism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45a46a39"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_042efdee",
      "@type": "BackgroundKnowledge",
      "instance_name": "ironic_juxtaposition",
      "label": "Ironic Juxtaposition",
      "description": "The meme relies on the rhetorical device of ironic juxtaposition — placing two contrasting ideas (a celebratory firework vs. a violent terrorist) side by side to create humor or provoke thought. This requires understanding of rhetorical strategies and the cultural weight of the terms involved.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45a46a39"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fcfe8e60",
      "@type": "BackgroundKnowledge",
      "instance_name": "political_and_social_labeling",
      "label": "Political and Social Labeling",
      "description": "The meme references the broader social phenomenon of labeling — how individuals or groups are assigned labels (like 'terrorist') that carry significant social, political, or moral implications. The humor arises from the absurdity of being labeled 'terrorist' when one identifies with something benign and festive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45a46a39"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c068a9f6",
      "@type": "EmotionExpression",
      "instance_name": "ironic_humor",
      "label": "ironic humor expression",
      "description": "The emotion expressed is ironic humor, derived from the juxtaposition of the celebratory image of fireworks with the serious and negative label 'terrorist'. The text overlay explicitly frames this contrast as a punchline, inviting the viewer to laugh at the absurdity of being called a terrorist while identifying as a firework. The emotion is not genuine amusement but a satirical or mocking tone, leveraging the visual and textual elements to create a humorous effect through contradiction.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45a46a39"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f0c82b38",
      "@type": "AnalogicalMapping",
      "instance_name": "firework_terrorist_mapping",
      "label": "Person identified as a firework",
      "description": "The text 'you identify as a firework' creates an analogical mapping where the person (represented by the silhouetted crowd) is mapped onto the visual entity 'firework_as_celebratory_object'. The meme humorously equates the person's self-identification with the celebratory, non-violent nature of a firework, contrasting it with the negative connotation of 'terrorist'. This mapping is established through the ironic juxtaposition of the celebratory visual (fireworks) with the text's claim of self-identification.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45a46a39"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_81e17aec",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the person identifying as a firework",
      "description": "The text 'you identify as a firework' directly projects the user (the viewer) onto the conceptual entity of 'person' within the meme. The user is positioned as the subject of the self-identification, aligning with the visual of the crowd (silhouettes) watching fireworks, which serves as a metaphor for the user's own identity. The projection is onto the textual material that invokes self-identification, which then maps onto the visual material of the firework as a celebratory object.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45a46a39"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_db4131b9",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme trivializes the term 'terrorist' by equating it with a harmless, celebratory object (a firework), which can desensitize viewers to the real-world consequences of terrorism and minimize the suffering caused by actual terrorist acts. While not targeting specific protected groups, the message carries potential societal harm by downplaying the gravity of terrorism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45a46a39"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
