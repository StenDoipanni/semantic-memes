    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6dd44887",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "female lion as 'she' who realizes the cost",
      "description": "The text 'that moment when she realizes those guarana's & tequila weren't free' maps the female lion as the subject 'she'. Her passive, resigned posture while being mounted by the male lion is interpreted as her realization of being tricked, metaphorically aligning her emotional state with the human scenario of being deceived into paying for something she thought was free.",
      "belongsToAnalysis": {
