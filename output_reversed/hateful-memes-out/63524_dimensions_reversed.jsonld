    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a1796b40",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The angry protest scene is mapped onto the claim that Islam is a religion of peace",
      "description": "The visual material of the angry protest scene (man_in_foreground shouting and pointing aggressively, surrounded by other angry protesters holding green flags) is juxtaposed with the textual claim 'islam is a religion of peace if you don't agree then you're ignorant'. This creates an analogical mapping where the visual representation of anger and aggression is used to imply that the claim about Islam being a religion of peace is false or invalid. The mapping suggests that if one disagrees with the claim, they are ignorant, and the visual of anger is used to discredit the claim by association.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a5f1cd89"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cdba0425",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man in the foreground",
      "description": "The user is projected onto the man in the foreground who is shouting and pointing aggressively at the viewer. The deictic pronoun 'you' in the text 'you don't agree then you're ignorant' directly addresses the viewer, creating a direct projection of the user onto this visual entity. The man's confrontational gesture and direct gaze reinforce this projection, making the viewer feel personally targeted by the message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a5f1cd89"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9013b634",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_2",
      "label": "User projected onto the textual claim",
      "description": "The user is projected onto the textual material 'you don't agree then you're ignorant'. The text explicitly uses 'you', directly addressing the viewer and implying that the user is the one being judged as 'ignorant' for disagreeing with the claim that 'Islam is a religion of peace'. This creates a projection where the user is positioned as the target of the rhetorical accusation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a5f1cd89"
      },
      "extractionMethod": "llm_extraction_huggingface"
