    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6575b586",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_terrorism_work_visual",
      "label": "terrorism work is mapped onto firearms",
      "description": "The text 'terrorism is one of the only areas where they do most of the work' is mapped onto the visual of firearms, implying that the firearms represent the 'work' done in counter-terrorism. The visual of the pile of weapons serves as a metaphor for the effort, danger, and resources expended in combating terrorism, which the text claims is uncredited.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f3f704a8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ea961437",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message and visual of firearms as representing uncredited counter-terrorism work",
      "description": "The user is projected onto the textual message 'terrorism is one of the only areas where they do most of the work and none of them get the credit' and the visual of the pile of firearms, which together imply that the user (or a collective 'we') identifies with the 'they' (law enforcement, military, government agencies) who perform the work but are not credited. The projection is onto the textual material and the visual material, which together form the core argument of the meme. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the implied identification with 'they' is a key semiotic projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f3f704a8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_314aea54",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme promotes a false equivalence by suggesting that the work done to prevent or combat terrorism is somehow 'uncredited' or 'unappreciated,' while simultaneously using the image of weapons to imply violence or danger. It risks normalizing or glorifying violence and could be used to justify or downplay the role of state actors in counter-terrorism operations. The meme is potentially dangerous as it could encourage a distorted view of the role of state actors in maintaining security, and may be used to justify or rationalize violence or militarization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f3f704a8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ca4b6873",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals who are familiar with or interested in discussions around counter-terrorism, law enforcement, military operations, and public acknowledgment of security forces. This includes people who follow political rhetoric, social media discourse on security issues, and those who engage with memes as a tool for political or social critique. The meme appeals to those who may feel that state actors (military, police, intelligence agencies) are underappreciated or not sufficiently credited for their work in combating terrorism, and who may be critical of mainstream media representation or public perception of these institutions. The visual of firearms in a cart serves as a recognizable symbol for militarized security and weapon confiscation, which resonates with audiences concerned about state power, militarization, or the role of government in maintaining public safety. The meme is likely shared and discussed within online communities that engage in political expression, social commentary, or cultural critique, particularly those that debate the balance between security and civil liberties, or who are skeptical of official narratives around counter-terrorism efforts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f3f704a8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
