  "dimensions": [
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_72904406",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: they_can_kill_the_messenger_but_they_cant_kill_the_message; hasOverallIntent: Propaganda; overall-intent-description: The image depicts a silhouette of Jesus Christ on the cross against a dramatic sky, with the text 'they can kill the messenger but they can't kill the message.' This visual and textual combination is used to convey a message of enduring truth or moral conviction, often in the context of religious or political resistance. The overall intent is propagandistic, aiming to inspire resilience and reinforce the idea that oppressive forces cannot extinguish core beliefs or values. The imagery of crucifixion is symbolic of sacrifice and martyrdom, which is juxtaposed with the message to suggest that even in the face of persecution, the underlying truth remains unshakable. There is no toxicity present in this meme as it does not target any specific group based on protected characteristics, nor does it contain abusive, cyberbullying, harmful, hateful, misogynous, or other forms of toxicity. The intent is to motivate and affirm, not to attack or demean.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_59df244c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_99166e80",
