    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2f3c8b75",
      "@type": "EmotionExpression",
      "instance_name": "hate",
      "label": "hateful emotion",
      "description": "The emotion expressed is hatred, conveyed through the antisemitic stereotype of 'jew jerky' and the use of the crucifixion image to dehumanize Jewish people. The text instructs to 'leave out in the sun until all moisture is gone' and 'store in a cool dark place for 3 days,' which is a grotesque metaphor implying Jewish people are inedible and undesirable, reinforcing antisemitic hatred.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3846eb9e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a4e7a6dd",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_jew_jerky_to_crucifixion",
      "label": "Jew Jerky stereotype mapped onto crucifixion scene",
      "description": "The text 'jew jerky: leave out in the sun until all moisture is gone, store in a cool dark place for 3 days' is an antisemitic food metaphor. This text is analogically mapped onto the visual of the crucifixion scene, where the person on the cross is dehumanized and portrayed as an object to be processed (dried, stored), mirroring the grotesque treatment implied by the text. The crucifixion scene visually represents the 'jew jerky' stereotype by associating Jewish people with a degrading, inedible, and religiously charged object.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3846eb9e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e98fed17",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the antisemitic food metaphor text",
      "description": "The user is projected onto the textual material describing 'jew jerky' as if they are the one performing the dehumanizing act of processing Jewish people as food. The meme implies the user is the one who would 'leave out in the sun' and 'store' Jewish people, projecting the user into the role of the perpetrator of the antisemitic stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3846eb9e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
