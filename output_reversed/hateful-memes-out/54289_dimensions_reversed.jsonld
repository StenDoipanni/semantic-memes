    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1546d5a5",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "woman is mapped as 'meat' to be slapped on a grill",
      "description": "The text 'cause i'm bout to slap this meat across your grill' explicitly maps the woman's visual representation (her face) onto the concept of 'meat'. This is a misogynistic objectification trope where the woman's body is reduced to a consumable commodity, visually represented by her face being juxtaposed with the vulgar metaphor. The sloth in the top half serves as a humorous, slow-moving visual punchline to the threat, reinforcing the crude and degrading nature of the metaphor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4cc7d820"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d6d88d95",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene as the recipient of a threatening metaphor",
      "description": "The user is projected onto the 'barbeque_threat_scene' as the implied recipient of the threat. The text 'do you like to barbeque' directly addresses the user with 'you', and 'cause i'm bout to slap this meat across your grill' uses 'your grill', explicitly directing the threat toward the user's personal domain (their grill). The user is thus projected onto the scene as the target of the misogynistic objectification metaphor.",
      "belongsToAnalysis": {
