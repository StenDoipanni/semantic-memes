    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_24eb37d2",
      "@type": "Scene",
      "instance_name": "barbeque_threat_scene",
      "label": "a threatening barbeque metaphor scene",
      "description": "The scene is composed of a sloth and a woman's face, juxtaposed with text that creates a threatening metaphor about barbecuing meat. The sloth appears in the top half, and the woman's face is in the bottom half, visually separated by a white vertical bar. The text 'do you like to barbeque' is positioned above the sloth, and 'cause i'm bout to slap this meat across your grill' is below the woman's face. The scene uses the sloth as a visual punchline to the text, implying the woman is being objectified as 'meat' to be 'slapped' onto a grill. The spatial arrangement is vertical, with the sloth and woman's face occupying distinct halves of the image, creating a visual contrast that emphasizes the meme's misogynistic intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4cc7d820"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
