    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f803d76c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'perfect girls don't exi' maps onto the visual of the woman in bikini and tactical gear.",
      "description": "The textual phrase 'perfect girls don't exi' (intended to be 'exist') is juxtaposed with the visual of the woman in a revealing bikini and tactical gear, who is being directed by a man with a firearm. This creates an analogical mapping where the woman is implicitly represented as the 'perfect girl' that the text claims does not exist. The mapping is reinforced by the visual presentation that objectifies her, aligning with the misogynistic trope that 'perfect' women are unattainable or undesirable because they are sexualized or controlled. The woman's visual depiction — her attire, her position, and her objectified presentation — serves as the visual instantiation of the 'perfect girl' concept being denied by the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_70cd9d90"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_22ecd169",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message",
      "description": "The user is projected onto the text 'perfect girls don't exi' (intended to be 'exist'), which serves as the central claim of the meme. The text acts as a direct address to the viewer, inviting them to internalize the misogynistic message that 'perfect' women do not exist, thereby framing the user as someone who must confront or accept this notion. The text is the primary locus of the user's projection, as it explicitly states the meme's core argument and is juxtaposed with the visual material to reinforce its message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_70cd9d90"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a32461f4",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Mysogynous",
      "description": "The meme objectifies and devalues women by implying that 'perfect girls' do not exist, framing women as inherently flawed or incomplete due to their sexualization and objectification. The visual of the woman in a bikini and tactical gear, while being directed by a man with a firearm, reinforces harmful stereotypes that reduce women to sexualized objects and subordinate them to male authority.",
      "belongsToAnalysis": {
