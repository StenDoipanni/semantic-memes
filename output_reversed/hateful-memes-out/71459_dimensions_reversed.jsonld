    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e5dfb6de",
      "@type": "AnalogicalMapping",
      "instance_name": "partial_arts_mapping",
      "label": "The text 'partial arts' maps to the visual depiction of martial artists performing incomplete or half-hearted stances.",
      "description": "The textual phrase 'partial arts' is superimposed over the image of an adult and a child in martial arts uniforms and stances. The mapping is based on the visual implication that their martial arts practice is incomplete or inadequate, which contrasts with the serious discipline martial arts represents. The text puns on 'partial' (incomplete) and 'arts' (martial arts), creating an ironic mapping where the visual material (the martial artists) is interpreted as embodying the concept of 'partial arts'. This mapping is central to the meme's humor and its harmful intent of trivializing martial arts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7d6ccd44"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f1a96a12",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the ironic textual material",
      "description": "The user is projected onto the textual material 'partial arts' because the meme's humor and intent rely on the user interpreting the text as a direct commentary on the visual scene. The user must mentally map the text to the visual depiction of the martial artists to understand the joke and its implied disrespect. The projection is onto the text_chunk entity, as the user's understanding of the meme's meaning is anchored in the textual pun and its ironic contrast with the visual material.",
      "belongsToAnalysis": {
