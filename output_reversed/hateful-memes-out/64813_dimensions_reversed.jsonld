    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9d335801",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_comparing_to_primates",
      "label": "Anti-Black Stereotype: Comparing Black People to Primates",
      "description": "A well-documented and harmful racial stereotype that dehumanizes Black individuals by equating them with apes or monkeys. This stereotype has historical roots in slavery and colonialism and is used to demean, mock, and justify discrimination against Black people. The meme relies on this stereotype to imply that calling someone 'ugly' could lead to them being perceived as a gorilla, thereby mocking and degrading Black individuals.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d266a4a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e2062cee",
      "@type": "BackgroundKnowledge",
      "instance_name": "high_school_context",
      "label": "High School Social Dynamics",
      "description": "The setting of 'high school' implies a context of adolescent social hierarchies, peer pressure, and the frequent use of derogatory labels or bullying. The text 'be careful who you call ugly in high school' references the common social phenomenon of name-calling and teasing among teenagers, which can have lasting psychological effects. The meme uses this context to frame the stereotype as a consequence of such behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d266a4a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_89795cae",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_slur_implication",
      "label": "Implication of Racial Slur via 'Ugly' Label",
      "description": "The phrase 'be careful who you call ugly' is a veiled reference to racial slurs. In the context of the image, 'ugly' is not meant to be taken literally but is used as a euphemism for calling someone 'ugly' in a racially derogatory way. This implies that such a comment could provoke a violent or dehumanizing response, as the stereotype equates Black people with primates. This is a form of coded racism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d266a4a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b8a978fe",
      "@type": "EmotionExpression",
      "instance_name": "mocking_contempt",
      "label": "mocking and contemptuous emotion",
      "description": "The meme expresses a mocking and contemptuous emotion by juxtaposing a smiling Black teenager with a gorilla and using the text 'be careful who you call ugly in high school' to imply that calling someone 'ugly' could lead to them being perceived as a gorilla. This is a dehumanizing and racially derogatory stereotype that mocks and degrades Black individuals. The emotion is conveyed through the visual contrast and the coded racial slur implication in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d266a4a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_22fc2746",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The teenager is mapped as the consequence of calling someone 'ugly' in high school",
      "description": "The text 'be careful who you call ugly in high school' implies that calling someone 'ugly' could lead to them being perceived as a gorilla. The visual material of the smiling Black teenager is juxtaposed with the gorilla to create an analogical mapping where the teenager is being mapped onto the gorilla as the result of being called 'ugly'. This mapping is part of the harmful anti-Black stereotype of comparing Black people to primates, which is the core of the meme's hateful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d266a4a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d5d3d912",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material as the instigator of the harmful stereotype",
      "description": "The user is projected onto the text_chunk 'be careful who you call ugly in high school' because the meme implies that the user (as a person who might say 'ugly') is the one who could trigger the dehumanizing consequence (the gorilla). The text directly addresses the viewer, creating a sense of personal responsibility or potential consequence, thereby projecting the user onto the textual material as the actor in the scenario.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d266a4a7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b04ba2e0",
