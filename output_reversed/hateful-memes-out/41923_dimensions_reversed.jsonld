      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Age-Based Exclusion",
      "description": "The meme implies that only individuals in their 30s have authentic or valid memories of the depicted cultural artifact, potentially marginalizing and devaluing the experiences of other age groups. This fosters a sense of generational hierarchy and exclusion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e4c6c5f"
      },
      "extractionMethod": "llm_extraction_huggingface"
