    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_12d8eca8",
      "@type": "BackgroundKnowledge",
      "instance_name": "generational_nostalgia",
      "label": "Generational Nostalgia",
      "description": "The meme relies on the concept that certain cultural artifacts, music, or events are tied to specific generations, and that only those who experienced them firsthand can truly 'remember' them. This creates an implicit hierarchy of cultural memory, where the experiences of one generation are deemed more authentic or valuable than others. The phrase 'only 30's kids will remember this' implies that the depicted scene is from a past era that is now inaccessible to younger people, and that the targeted demographic (30-somethings) has a unique, privileged connection to it.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e4c6c5f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4c3ccbcc",
      "@type": "BackgroundKnowledge",
      "instance_name": "cultural_elitism",
      "label": "Cultural Elitism",
      "description": "The meme subtly promotes the idea that cultural experiences are exclusive to certain age groups, implying that those outside the targeted demographic (30-somethings) are somehow less connected to or less capable of appreciating the cultural artifact being referenced. This can lead to the marginalization of other age groups and the creation of a hierarchy where the '30's kids' are positioned as the authentic or superior cultural inheritors.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e4c6c5f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_45f820f9",
      "@type": "BackgroundKnowledge",
      "instance_name": "age_based_exclusion",
      "label": "Age-Based Exclusion",
      "description": "The meme functions by excluding individuals who are not in their 30s from the cultural narrative it presents. By stating that only '30's kids' will remember the scene, it implicitly devalues the experiences and memories of other age groups, potentially causing emotional discomfort or alienation for those who are not part of the targeted demographic. This is a form of exclusion based on age, which can be harmful as it suggests that cultural memory is not universal or accessible to all.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e4c6c5f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6bf71aa6",
      "@type": "BackgroundKnowledge",
      "instance_name": "nostalgia_as_cultural_property",
      "label": "Nostalgia as Cultural Property",
      "description": "The meme treats nostalgia as a form of cultural property that is owned or exclusive to a specific generation. This concept implies that the cultural artifact (the performance) is not merely a shared experience but something that is 'owned' by those who experienced it in the past, and that this ownership is tied to age. This can lead to the commodification of nostalgia and the exclusion of those who did not experience it firsthand.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e4c6c5f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e2be8110",
      "@type": "EmotionExpression",
      "instance_name": "nostalgia",
      "label": "nostalgic emotion",
      "description": "The overall scene and text evoke a sense of longing for a past era, suggesting that the depicted musical performance is a cherished memory tied to a specific time period. The black-and-white aesthetic and the phrase 'only 30's kids will remember this' reinforce this feeling of looking back fondly on something that is now distant and perhaps inaccessible to younger generations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e4c6c5f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0bd69f95",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The text 'only 30's kids' maps onto the visual scene of the stage performance.",
      "description": "The text 'only 30's kids' is positioned at the top center of the image, directly above the visual scene of the stage performance. This spatial adjacency creates an analogical mapping where the text explicitly identifies the visual scene as something that is exclusively remembered by '30's kids'. The mapping implies that the entire visual scene (the stage performance) is a cultural artifact tied to a specific past era, and that only individuals in their 30s are the legitimate bearers of this memory. This is a direct projection of the textual claim onto the visual material, establishing the performance as the 'thing' that is being claimed to be exclusive to the 30's demographic.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e4c6c5f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6d5eefc9",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the targeted demographic of '30's kids",
      "description": "The user is implicitly projected onto the demographic of '30's kids, as the meme's text 'only 30's kids will remember this' positions this group as the exclusive audience or memory holders of the depicted scene. The user is invited to identify with this group, feeling that their experience or memory of the cultural artifact is validated by the meme. This projection is not explicit with deictic pronouns like 'you' or 'me', but is implied through the exclusivity claim and the user's assumed alignment with the targeted age group.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e4c6c5f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
