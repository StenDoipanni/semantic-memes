    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2b9e4a22",
      "@type": "BackgroundKnowledge",
      "instance_name": "rape_and_murder_stereotype",
      "label": "Rape and Murder Stereotype",
      "description": "The meme uses the horrific and false stereotype that immigrants are disproportionately responsible for sexual assault and murder. This is a dangerous and baseless claim that has been used to fuel xenophobia and is not supported by evidence. The text explicitly states the victim was 'raped and murdered by an illegal immigrant,' invoking this harmful trope.",
      "belongsToAnalysis": {
