    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bd18e3f4",
      "@type": "BackgroundKnowledge",
      "instance_name": "illegal_immigrant_stereotype",
      "label": "Illegal Immigrant Stereotype",
      "description": "This is a specific subset of anti-Latino/Hispanic stereotypes that falsely associates undocumented immigrants with criminal behavior, particularly violent crimes like murder and rape. The meme uses this stereotype to vilify a specific group based on their immigration status, which is a common tactic in hate speech.",
      "belongsToAnalysis": {
