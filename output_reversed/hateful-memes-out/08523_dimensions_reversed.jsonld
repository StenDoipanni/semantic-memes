    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cbf65840",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The young woman is mapped as a 'cute kid'",
      "description": "The text 'cute kid' in the top left corner directly maps onto the visual entity 'young_woman'. The text explicitly labels the visual subject as a 'cute kid', creating an analogical mapping where the textual description is projected onto the visual material. This mapping is central to the meme's hateful intent, as it frames the victim as innocent and vulnerable, which is then contrasted with the violent text below.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aa46c14b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a253bfa0",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the young woman as a 'cute kid'",
      "description": "The user is projected onto the visual material of the young woman, who is explicitly labeled as a 'cute kid' by the text overlay. This projection frames the user as identifying with or imagining themselves as the innocent, vulnerable subject of the meme, which is then contrasted with the hateful text below. The projection is implicit through the labeling and the emotional contrast, inviting the user to mentally inhabit the role of the 'cute kid' before the violent narrative is imposed.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aa46c14b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
