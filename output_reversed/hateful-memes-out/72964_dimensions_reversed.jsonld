      "@type": "BackgroundKnowledge",
      "instance_name": "social_norm_violation",
      "label": "Social Norm Violation",
      "description": "The meme humorously highlights a violation of social norms by juxtaposing a sincere expression of gratitude with an incredulous, confused reaction to the expected response. This violation is the core of the meme's comedic effect, implying the response is inappropriate or absurd.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d3ad9eeb"
