    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0ede5ff2",
      "@type": "BackgroundKnowledge",
      "instance_name": "landmine_concept",
      "label": "Landmine",
      "description": "Landmines are explosive devices designed to be triggered by the weight or pressure of a person stepping on them. Their activation mechanism relies on mechanical pressure, making them ineffective against very light individuals. This real-world knowledge is essential to understand the absurdity of the meme's premise — that someone is so light they cannot trigger a landmine.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b0623bc5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f7d68d9e",
      "@type": "BackgroundKnowledge",
      "instance_name": "weight_based_activation",
      "label": "Weight-Based Activation Mechanism",
      "description": "The concept that landmines are triggered by weight or pressure is a real-world engineering principle. This knowledge is necessary to interpret the meme's joke — the idea that someone is 'too light' to activate a landmine — as a literal, physical impossibility, which forms the basis of the dark humor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b0623bc5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2c205b34",
      "@type": "BackgroundKnowledge",
      "instance_name": "harmless_person_stereotype",
      "label": "Stereotype of Harmless or Insignificant Individuals",
      "description": "The meme implicitly references the stereotype that some people are so 'light' or 'insignificant' that they are harmless — a dehumanizing trope that can be used to dismiss or belittle individuals based on their perceived lack of weight or value. This stereotype is often used in social contexts to marginalize people, making the meme's humor potentially harmful.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b0623bc5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_37d49cd0",
      "@type": "BackgroundKnowledge",
      "instance_name": "dehumanization_through_weight",
      "label": "Dehumanization via Physical Attributes",
      "description": "The meme uses the concept of weight as a proxy for value or threat, which is a form of dehumanization. In real-world contexts, people are sometimes judged or dismissed based on physical traits like weight, height, or appearance — a form of ableism or body-shaming. This background knowledge is needed to understand the meme's potential to reinforce harmful stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b0623bc5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_84918d4d",
      "@type": "BackgroundKnowledge",
      "instance_name": "dark_humor",
      "label": "Dark Humor",
      "description": "The meme relies on dark humor — humor derived from morbid, taboo, or potentially offensive subjects — to create its effect. Understanding that the joke is based on a dangerous scenario (stepping on a landmine) and then subverting it with absurdity (not triggering it due to weight) requires knowledge of dark humor conventions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b0623bc5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
