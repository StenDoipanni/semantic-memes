    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8e43a5d2",
      "@type": "Scene",
      "instance_name": "accusatory_text_over_politicians",
      "label": "Accusatory text overlaid on images of Muslim women politicians",
      "description": "The meme presents three Muslim women politicians (Ilhan Omar, Linda Sarsour, Rashida Tlaib, and Alexandria Ocasio-Cortez) with the text 'the enemy has infiltrated congress the enemy within,' implying they are traitors or foreign agents. This is a hateful attack targeting Muslim women in political office, using the 'foreign infiltrator' trope associated with anti-Asian and Islamophobic stereotypes to delegitimize their political roles and suggest they are disloyal to the United States. The juxtaposition of their images with this accusatory text is designed to incite hostility and distrust toward them based on their religion and gender.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b5bd331"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fd67d99a",
      "@type": "BackgroundKnowledge",
      "instance_name": "foreign_infiltrator_trope",
      "label": "Foreign Infiltrator Trope",
      "description": "A racist and Islamophobic stereotype that falsely accuses individuals of being foreign agents or traitors who have infiltrated a society or institution. This trope is often used to delegitimize political figures based on their ethnicity, religion, or national origin, and is frequently weaponized against Muslim, Asian, and other minority groups. In this meme, it is used to imply that the featured Muslim women politicians are disloyal to the United States.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b5bd331"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_70683b49",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia",
      "label": "Islamophobia",
      "description": "Prejudice, fear, or hatred directed towards Muslims. This includes stereotypes that portray Muslims as inherently violent, incompatible with Western values, or as threats to national security. The meme leverages Islamophobic tropes by associating the featured politicians with the 'enemy within' accusation, which is a common tactic to delegitimize Muslim political participation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b5bd331"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b11cc062",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_muslim_stereotype",
      "label": "Anti-Muslim Stereotype",
      "description": "A set of negative beliefs and assumptions about Muslims, often including claims of disloyalty, terrorism, or cultural incompatibility. This stereotype is used in the meme to cast doubt on the loyalty and legitimacy of Muslim women politicians, implying they are not truly American.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b5bd331"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_179ac088",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_asian_racism",
      "label": "Anti-Asian Racism",
      "description": "Discrimination and prejudice against Asian people, often rooted in stereotypes such as the 'foreign infiltrator' trope. This trope is frequently used to attack Asian individuals in positions of power, suggesting they are not truly loyal to their adopted country. The meme implicitly draws from this by using the 'enemy within' accusation, which has historically been used against Asian Americans.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b5bd331"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ff56ceb7",
      "@type": "BackgroundKnowledge",
      "instance_name": "hateful_meme",
      "label": "Hateful Meme",
      "description": "A meme designed to incite hostility, hatred, or discrimination against a specific group. This meme is explicitly hateful as it targets Muslim women politicians with false and dangerous accusations, aiming to delegitimize their political roles and incite distrust based on their religion and gender.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b5bd331"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b30c9929",
      "@type": "BackgroundKnowledge",
      "instance_name": "political_discredit",
      "label": "Political Discredit",
      "description": "The act of undermining or delegitimizing a political figure or group through false or misleading claims. In this meme, the accusation of being 'the enemy within' is used to discredit the political careers of the featured women, suggesting they are not trustworthy or loyal to the United States.",
      "belongsToAnalysis": {
