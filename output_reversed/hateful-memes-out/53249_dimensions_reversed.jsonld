    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_df2a3a9d",
      "@type": "BackgroundKnowledge",
      "instance_name": "congressional_infiltration_accusation",
      "label": "Congressional Infiltration Accusation",
      "description": "A false and inflammatory claim that members of Congress are secretly working against the interests of the United States, often used to attack political opponents. The meme uses this accusation to imply that the featured politicians are traitors, which is a common tactic in political rhetoric to delegitimize opponents.",
      "belongsToAnalysis": {
