    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1a28f960",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The man is mapped as the speaker of the joke",
      "description": "The visual entity 'man' is mapped onto the textual entity 'i' in the text 'so i gave her diabeetus'. The man's presence and expression serve as the visual representation of the speaker ('i') in the joke, creating an analogical mapping where the person in the image is the one performing the action described in the text.",
      "belongsToAnalysis": {
