    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2d183582",
      "@type": "BackgroundKnowledge",
      "instance_name": "diabetes",
      "label": "Medical Condition",
      "description": "Diabetes is a serious, chronic medical condition characterized by high blood sugar levels due to the body's inability to produce or properly use insulin. It requires lifelong management and can lead to severe complications such as heart disease, kidney failure, blindness, and amputations. The meme trivializes this condition by using a crude pun, which is harmful and disrespectful to people living with diabetes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a27e2606"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_af93989e",
      "@type": "BackgroundKnowledge",
      "instance_name": "diabeetus",
      "label": "Vulgar Pun",
      "description": "A deliberately offensive pun created by replacing the 'e' in 'diabetes' with a 't' to form 'diabeetus,' implying a sexual innuendo. This pun is used to mock and degrade people with diabetes, reducing a serious medical condition to a crude joke. It relies on the audience understanding the phonetic and semantic manipulation to grasp the offensive intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a27e2606"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4b1945f4",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism",
      "label": "Disability-Based Discrimination",
      "description": "Ableism is the discrimination or social prejudice against people with disabilities. It often manifests as mocking or trivializing disabilities, which is exactly what this meme does by making a joke about diabetes, a condition affecting millions of people. The meme promotes ableist attitudes by portraying a medical condition as something to be laughed at rather than respected or taken seriously.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a27e2606"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5c36158a",
      "@type": "BackgroundKnowledge",
      "instance_name": "medical_stigma",
      "label": "Stigma Around Medical Conditions",
      "description": "Medical stigma refers to the negative attitudes, beliefs, and behaviors directed toward people with medical conditions. This meme contributes to medical stigma by using humor to demean and belittle those with diabetes, potentially causing emotional distress and reinforcing harmful stereotypes that medical conditions are something to be joked about rather than treated with dignity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a27e2606"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5a2fa4eb",
      "@type": "BackgroundKnowledge",
      "instance_name": "sexual_innuendo",
      "label": "Sexual Double Meaning",
      "description": "The joke relies on a sexual innuendo, where the word 'diabeetus' is a phonetic play on 'diabetes' that suggests a sexual act. This type of humor is often considered crude and offensive, especially when applied to a serious medical condition. The meme uses this innuendo to create a shockingly inappropriate and disrespectful joke.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a27e2606"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_27580f34",
      "@type": "EmotionExpression",
      "instance_name": "mocking",
      "label": "mocking emotion",
      "description": "The man's neutral to slightly confused facial expression, combined with the crude and offensive text overlay, conveys a mocking tone. The juxtaposition of a serious medical condition with a vulgar pun creates an emotionally charged, disrespectful atmosphere intended to provoke laughter at the expense of people with diabetes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a27e2606"
      },
      "extractionMethod": "llm_extraction_huggingface"
