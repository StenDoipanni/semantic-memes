    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ee79e2c0",
      "@type": "VisualMaterial",
      "instance_name": "child",
      "label": "a young girl",
      "description": "A young girl with light brown hair, wearing a gray sweater with a yellow collar, is holding a stuffed animal. Her face is partially obscured by a plush lion head that has been digitally altered to resemble her face using a face-swapping app. She is smiling and looking at the camera, conveying a sense of joy and innocence.",
      "belongsToAnalysis": {
