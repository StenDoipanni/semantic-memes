    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ef6faae8",
      "@type": "Scene",
      "instance_name": "face_swap_demo",
      "label": "child holding digitally altered stuffed animal",
      "description": "A child is holding a stuffed animal whose face has been digitally altered to resemble her face using a face-swapping app. The child's own face is partially obscured by the plush lion head. The scene is playful and lighthearted, with the child smiling and looking at the camera. The text overlay 'this faceapp stuff is incredible!' reinforces the theme of technological amazement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1cc8cfd8"
      },
      "extractionMethod": "llm_extraction_huggingface"
