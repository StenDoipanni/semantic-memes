    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_05094cfd",
      "@type": "BackgroundKnowledge",
      "instance_name": "family_gatherings",
      "label": "Family Gatherings",
      "description": "The concept of family gatherings, particularly those centered around food and social obligation, is a common cultural phenomenon in many societies. The meme references the common experience of visiting family for events like barbecues, which are often seen as obligatory or socially expected, even if the primary motivation is superficial (e.g., the food or the event itself).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_25c0845c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_17e402fd",
      "@type": "BackgroundKnowledge",
      "instance_name": "barbecue",
      "label": "Barbecue",
      "description": "A barbecue is a social event involving the grilling of food, often held outdoors and associated with family and community gatherings. It is a common cultural event in many countries, especially in the United States, and is often used as a social bonding activity. The meme uses the barbecue as a specific, relatable context for family visits.",
      "belongsToAnalysis": {
