      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e73bb9b7",
      "@type": "BackgroundKnowledge",
      "instance_name": "social_obligation",
      "label": "Social Obligation",
      "description": "The idea that people feel compelled to attend family events due to social norms or expectations, even if they are not enthusiastic about them. This concept is central to understanding the meme’s humor, as it implies the visit is not out of genuine affection but due to external pressure or the lure of the event (the barbecue).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_25c0845c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f20e308c",
      "@type": "BackgroundKnowledge",
      "instance_name": "relatable_humor",
      "label": "Relatable Humor",
      "description": "The humor in the meme relies on the universal experience of attending family gatherings that one may not fully enjoy, but feels obligated to attend. This type of humor is common in internet culture and often involves exaggerating a common, mildly frustrating situation to create comedic effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_25c0845c"
      },
      "extractionMethod": "llm_extraction_huggingface"
