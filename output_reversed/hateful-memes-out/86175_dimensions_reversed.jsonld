    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_67c9820b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The viewer is mapped onto the woman as the person who goes to see family for the barbecue",
      "description": "The text 'when you go see your family because of the barbecue' directly addresses the viewer ('you'), creating an analogical mapping where the viewer is projected onto the visual entity (the woman). The woman's angry, accusatory expression and pointing gesture serve as a visual representation of the viewer's internal frustration or annoyance at the situation described in the text. The mapping is established through the direct address ('you') in the text and the visual framing that makes the viewer feel personally targeted and blamed, as implied by the woman's expression and gesture.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_25c0845c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b0f98599",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman in the image",
      "description": "The user is projected onto the woman (VisualMaterial entity) because the text 'when you go see your family because of the barbecue' directly addresses the viewer ('you'), creating an implicit deictic reference. The woman's angry, accusatory expression and pointing gesture visually represent the viewer's internal frustration or annoyance at the situation described in the text. The projection is established through the direct address ('you') in the text and the visual framing that makes the viewer feel personally targeted and blamed, as implied by the woman's expression and gesture.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_25c0845c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e2b9251a",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme uses an exaggerated angry expression and accusatory pointing to humorously convey frustration about visiting family for a barbecue, which may be perceived as mildly irritating or annoying. While the intent is to evoke relatable humor about social obligations, the exaggerated emotional reaction could potentially cause discomfort or be interpreted as overly aggressive by some viewers, especially if they are sensitive to being directly blamed or targeted. The humor is situational and self-referential, but the visual framing makes the viewer feel personally addressed and blamed, which can be perceived as a mild form of social harm or discomfort.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_25c0845c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_92963048",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "general internet audience",
      "description": "The meme is designed for a broad, general internet audience familiar with relatable social commentary and situational humor. It targets individuals who have experienced or can empathize with the social obligation to attend family gatherings, particularly barbecues, often for superficial reasons like food or social pressure, rather than genuine familial affection. The humor relies on universal experiences of family visits and social expectations, making it accessible to a wide demographic across cultures and backgrounds who understand the concept of attending events out of obligation or for the event itself (e.g., the barbecue). The visual of an angry woman pointing directly at the viewer creates a direct, self-referential address that invites the viewer to identify with the frustration, making it especially effective for audiences who recognize and resonate with this common social dynamic.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_25c0845c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
