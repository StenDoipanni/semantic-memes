    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cb84361f",
      "@type": "VisualMaterial",
      "instance_name": "woman",
      "label": "person with Down syndrome",
      "description": "A woman with Down syndrome is shown applying makeup in front of a mirror. She has dark hair, is wearing a red floral top, and is holding a makeup brush near her eye. Her expression appears focused or slightly surprised. The image is framed to show her reflection in the mirror, with her profile visible on the left side of the frame.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c677a9fe"
