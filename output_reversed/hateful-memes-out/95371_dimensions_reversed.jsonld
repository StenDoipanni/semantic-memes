    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f6780ee1",
      "@type": "Scene",
      "instance_name": "makeup_application_scene",
      "label": "woman applying makeup in front of mirror",
      "description": "A woman with Down syndrome is shown applying makeup in front of a mirror. Her reflection is visible, and she is holding a makeup brush near her eye. The scene is framed to show both her profile and her reflection, with the mirror occupying a significant portion of the background. The spatial arrangement suggests she is in a bathroom or similar setting, with tiled walls and a potted plant visible in the background. The text overlay 'down syndrome girl put on makeup for a party' contextualizes the scene as a personal preparation for an event.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c677a9fe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f2845933",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism_stereotype",
      "label": "Ableism Stereotype",
      "description": "The meme relies on the harmful stereotype that people with Down syndrome are incapable of self-expression or social agency without external validation, reducing them to a spectacle. This is a form of 'inspiration porn' or 'pity narrative' that infantilizes and mocks their personal effort and dignity, implying they are only worthy of attention when performing tasks that are perceived as 'unusual' or 'amusing' for someone with a disability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c677a9fe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b4c91fa7",
      "@type": "BackgroundKnowledge",
      "instance_name": "developmental_disability_infantilization",
      "label": "Developmental Disability Infantilization",
      "description": "The meme implicitly reinforces the stereotype that individuals with Down syndrome are childlike or incapable of independent decision-making, thereby reducing their personal agency. The framing of the image as 'amusing' or 'pity-inducing' suggests that their actions are not to be taken seriously, which infantilizes them and denies their autonomy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c677a9fe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d1f4f183",
      "@type": "BackgroundKnowledge",
      "instance_name": "inspiration_porn",
      "label": "Inspiration Porn",
      "description": "The meme uses the trope of 'inspiration porn' — portraying people with disabilities as inspirational or heartwarming subjects for the benefit of able-bodied viewers — to frame the woman's makeup application as a spectacle rather than a personal, empowering act. This trope trivializes the individual's dignity and reduces their experience to a narrative for others' consumption.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c677a9fe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_19388b78",
      "@type": "BackgroundKnowledge",
      "instance_name": "pity_narrative",
      "label": "Pity Narrative",
      "description": "The meme constructs a narrative centered on pity by implying that the woman's actions are unusual or amusing because she has Down syndrome. This narrative frames her as an object of pity rather than as a capable individual preparing for a social event, which reinforces negative societal perceptions and diminishes her agency.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c677a9fe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_984a9a53",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism",
      "label": "Ableism",
      "description": "The meme is an example of ableism — discrimination or prejudice against people with disabilities — by portraying the woman as an object of pity or amusement rather than as a person with agency and dignity. It normalizes viewing disability through a lens of pity or mockery, which can contribute to negative societal perceptions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c677a9fe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1fd5923e",
