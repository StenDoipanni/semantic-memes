    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cc38e1ee",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The exhausted person needing to go grocery shopping is mapped onto the woman in the shopping cart",
      "description": "The text 'when you've had a long day' is mapped onto the woman in the shopping cart, who is depicted as relaxed and laughing while being pushed, implying she is too tired to walk. This creates an analogical mapping where the woman represents the 'exhausted person' described in the text. The visual of her being pushed in the cart humorously exaggerates the feeling of being too tired to move, aligning with the textual description of needing to do a mundane task (grocery shopping) after a long day.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3f138196"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d0d681a0",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the exhausted person needing to go grocery shopping",
      "description": "The user is projected onto the woman in the shopping cart, who is depicted as relaxed and laughing while being pushed, implying she is too tired to walk. This visual representation aligns with the textual description 'when you've had a long day but you need to but geroceries', creating an analogical mapping where the viewer identifies with the exhausted person needing to perform a mundane task. The projection is implicit through the relatable meme culture trope, where 'you' is understood as the viewer experiencing fatigue after a long day.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3f138196"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
