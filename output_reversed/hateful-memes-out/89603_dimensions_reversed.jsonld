    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3d2afae9",
      "@type": "Scene",
      "instance_name": "shopping_cart_scene",
      "label": "man pushing woman in shopping cart",
      "description": "A man is pushing a shopping cart in which a woman is seated, both appearing to be laughing and enjoying themselves. The scene takes place in an outdoor parking lot setting. The man is exerting effort but smiling, while the woman is relaxed and laughing with her feet up. The shopping cart contains a water bottle and other items. The overall mood is lighthearted and humorous, contrasting the mundane task of grocery shopping with the absurdity of being pushed in a cart.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3f138196"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_740a893a",
      "@type": "BackgroundKnowledge",
      "instance_name": "lazy_unemployed_characterization",
      "label": "Lazy/Unemployed Characterization",
      "description": "The meme humorously depicts someone being pushed in a shopping cart, implying they are too tired or lazy to walk, which is a common stereotype used to describe people who are perceived as unwilling to exert effort, often associated with being unemployed or unproductive. This stereotype is used here to exaggerate the feeling of exhaustion after a long day, making the absurdity of the situation funnier.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3f138196"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_98231f01",
      "@type": "BackgroundKnowledge",
      "instance_name": "grocery_shopping",
      "label": "Grocery Shopping",
      "description": "The text 'but you need to but geroceries' (misspelling of 'groceries') refers to the mundane, everyday task of purchasing food and household items. This is a common errand that people must perform, and the meme uses it as a relatable context to highlight the contrast between the absurdity of being pushed in a cart and the necessity of the task.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3f138196"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_105b9938",
      "@type": "BackgroundKnowledge",
      "instance_name": "shopping_cart_as_transport",
      "label": "Shopping Cart as Transport",
      "description": "The use of a shopping cart as a mode of transport for a person is an absurd and humorous trope. While shopping carts are designed for carrying goods, using them to transport people is not a real-world function, and this juxtaposition is central to the meme's humor. It relies on the viewer understanding that this is an exaggerated, unrealistic scenario.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3f138196"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2602e81f",
      "@type": "BackgroundKnowledge",
      "instance_name": "relatable_meme_culture",
      "label": "Relatable Meme Culture",
      "description": "The meme format relies on the concept of 'relatability' — a cultural phenomenon where internet users share humorous or exaggerated images to express shared experiences or emotions. The phrase 'when you've had a long day' is a common trope in meme culture, used to evoke empathy and laughter by connecting with the viewer's own experiences of fatigue or laziness.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3f138196"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2d308bf6",
      "@type": "BackgroundKnowledge",
      "instance_name": "misspelling_of_groceries",
      "label": "Misspelling of 'Groceries'",
      "description": "The text 'but you need to but geroceries' contains a misspelling of 'groceries'. This is a common feature in memes, often used to add to the humor or to indicate a casual, unpolished tone. The misspelling is not a real-world entity but is part of the textual material that requires understanding of common spelling errors in informal communication to be fully appreciated.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3f138196"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_623c6ffb",
      "@type": "EmotionExpression",
      "instance_name": "happiness",
      "label": "joyful emotion",
      "description": "Both the man and the woman are smiling broadly and laughing, indicating a state of happiness and enjoyment. Their facial expressions convey genuine amusement and lightheartedness, suggesting they are having fun despite the absurdity of the situation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3f138196"
