    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9d8c964c",
      "@type": "VisualMaterial",
      "instance_name": "Adolf_Hitler",
      "label": "Historical figure",
      "description": "A black-and-white portrait of Adolf Hitler, the Nazi dictator responsible for the Holocaust and genocide. He is depicted with his characteristic mustache, neatly combed hair, and wearing a military-style uniform with a tie and strap. The image is a formal, close-up photograph with a dark background, emphasizing his stern facial expression. The text overlay 'every one is afraid of this man' is present at the bottom, contributing to the meme's hateful intent by glorifying his terrifying reputation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2b93bb17"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e64dd90a",
      "@type": "Scene",
      "instance_name": "portrait_with_text",
      "label": "Portrait of Adolf Hitler with fear-inducing text overlay",
      "description": "A black-and-white portrait of Adolf Hitler, shown in a formal military-style uniform with a tie and strap, looking directly at the camera with a stern expression. Below the portrait, the text 'every one is afraid of this man' is overlaid, creating a scene that associates him with universal fear. The dark background isolates the subject, emphasizing his presence and the ominous tone of the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2b93bb17"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4e6546eb",
      "@type": "BackgroundKnowledge",
      "instance_name": "Holocaust",
      "label": "Holocaust",
      "description": "The systematic, state-sponsored persecution and murder of six million Jews by Nazi Germany and its collaborators during World War II. This event is central to understanding the historical context of Adolf Hitler's actions and the global horror associated with his regime. The meme's claim that 'every one is afraid of this man' implicitly references the terror and genocide he orchestrated, making knowledge of the Holocaust essential to interpret the meme's hateful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2b93bb17"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8d6b18b6",
      "@type": "BackgroundKnowledge",
      "instance_name": "Nazi_Germany",
      "label": "Nazi Germany",
      "description": "The totalitarian regime led by Adolf Hitler from 1933 to 1945, characterized by extreme nationalism, racial persecution, and the Holocaust. Understanding this political entity is necessary to comprehend the context of Hitler's power and the fear he instilled in populations both within and outside Germany. The meme's portrayal of him as universally feared is rooted in the historical reality of Nazi terror.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2b93bb17"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_85de8eaa",
      "@type": "BackgroundKnowledge",
      "instance_name": "Genocide",
      "label": "Genocide",
      "description": "The deliberate and systematic destruction of a racial, political, or cultural group. This term is essential to understanding the scale and nature of Hitler's crimes, which included the murder of Jews, Roma, disabled individuals, and others. The meme's implication that Hitler is universally feared is tied to the global recognition of genocide as a horrific crime, making this concept critical to interpreting the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2b93bb17"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_144fdcc5",
      "@type": "BackgroundKnowledge",
      "instance_name": "War_Criminal",
      "label": "War Criminal",
      "description": "An individual who commits serious violations of international humanitarian law during armed conflict. Hitler is widely recognized as a war criminal for his role in World War II and the Holocaust. The meme's glorification of his fear is a dangerous distortion that requires knowledge of his legal and moral culpability to be understood as hateful and revisionist.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2b93bb17"
