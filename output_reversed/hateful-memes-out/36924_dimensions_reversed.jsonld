    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c6840f25",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who may be influenced by or sympathetic to hateful historical revisionism, glorification of totalitarian terror, or those who seek to normalize or romanticize Adolf Hitler's legacy. This includes communities that may engage with or propagate hate speech, anti-Semitic tropes, or glorification of war criminals. The meme is designed to appeal to those who either misunderstand or deliberately distort historical events, particularly those who associate Hitler with universal fear without acknowledging the genocide and atrocities he committed. The audience is likely to be drawn to the meme’s provocative and sensationalist framing, which exploits fear and historical trauma for shock value or ideological reinforcement.",
      "belongsToAnalysis": {
