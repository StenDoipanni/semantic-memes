    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_82a15847",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Adolf Hitler is mapped as 'every one is afraid of this man'",
      "description": "The text 'every one is afraid of this man' explicitly maps the visual entity Adolf_Hitler as the subject universally feared. This is a direct analogical mapping where the textual description assigns a specific emotional and reputational attribute (being universally feared) to the visual entity depicted. The mapping is established through the juxtaposition of the text overlay with the portrait, creating a direct association between the text's claim and the visual subject.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2b93bb17"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0275c602",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual claim of universal fear",
      "description": "The user is projected onto the textual material 'every one is afraid of this man', which implicitly positions the viewer as part of the collective 'everyone' who is afraid. This creates a semiotic projection where the user identifies with the group experiencing fear toward the depicted figure, thereby internalizing the meme's hateful framing. There are no explicit deictic pronouns like 'you' or 'me', but the universal quantifier 'every one' functions as an implicit projection of the user into the collective subject of fear.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2b93bb17"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
