    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_60a84b8b",
      "@type": "VisualMaterial",
      "instance_name": "people",
      "label": "people",
      "description": "A group of young adults, mostly in their 20s, are shown in a party scene. In the top panel, several people are visible: a man with long hair holding a bottle, a woman with blonde hair laughing, and others socializing. In the bottom panel, a bald man with a goatee, wearing a vest and holding a tool, is shown in a workshop setting. These individuals are central to the visual narrative and are used to represent contrasting life situations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_82f60c35",
      "@type": "Scene",
      "instance_name": "party_scene",
      "label": "party_scene",
      "description": "A chaotic party scene with a group of young adults socializing and drinking in a confined space. The scene is characterized by loud laughter, alcohol consumption, and a sense of unrestrained celebration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5a00f5c4",
      "@type": "Scene",
      "instance_name": "workshop_scene",
      "label": "workshop_scene",
      "description": "A man with a goatee and bald head, wearing a vest and holding a tool, stands in a cluttered workshop filled with tools and equipment. The scene conveys a sense of hard work and manual labor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f643cb1e",
      "@type": "BackgroundKnowledge",
      "instance_name": "Mike_Rowe",
      "label": "Mike Rowe",
      "description": "Mike Rowe is an American television personality, actor, and advocate for vocational education. He is best known for hosting the TV show 'Dirty Jobs' and for his public commentary on the value of skilled trades and the flaws in the current education system. His quote in the meme is a direct reference to his public stance on the misallocation of educational resources and the devaluation of vocational training.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b848205b",
      "@type": "BackgroundKnowledge",
      "instance_name": "Vocational_Education",
      "label": "Vocational Education",
      "description": "Vocational education refers to training programs that prepare individuals for specific trades or occupations, such as plumbing, electrical work, or automotive repair. It is often contrasted with academic education (like a 4-year college degree) and is promoted by advocates like Mike Rowe as a more practical and economically viable path to employment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ff9bb0b3",
      "@type": "BackgroundKnowledge",
      "instance_name": "4_Year_College_Degree",
      "label": "4-Year College Degree",
      "description": "A 4-year college degree is an academic qualification typically earned after completing four years of full-time study at a university or college. It is often associated with higher earning potential and social status, but also with significant financial cost and student debt. The meme critiques the perceived inefficiency of this degree in the modern job market.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c78c2a07",
      "@type": "BackgroundKnowledge",
      "instance_name": "Student_Debt_Crisis",
      "label": "Student Debt Crisis",
      "description": "The student debt crisis refers to the growing problem of high levels of student loan debt in many countries, particularly the United States. It is often cited as a major financial burden on graduates and a systemic issue in higher education. The meme references this crisis by stating that money is being lent to students who 'can't pay it back'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a377411c",
      "@type": "BackgroundKnowledge",
      "instance_name": "Labor_Market_Dynamics",
      "label": "Labor Market Dynamics",
      "description": "Labor market dynamics refer to the forces that influence the supply and demand for labor, including job availability, wage levels, and the types of skills employers seek. The meme references a specific statistic (less than 20% of jobs require a 4-year degree) to argue that the education system is misaligned with current labor market needs.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_09abdac4",
      "@type": "BackgroundKnowledge",
      "instance_name": "Stereotype_College_Degree_as_a_Guarantee_of_Success",
      "label": "Stereotype: College Degree as a Guarantee of Success",
      "description": "This is a common cultural stereotype that equates a college degree with guaranteed career success, higher income, and social mobility. The meme challenges this stereotype by contrasting the success of the speaker's parents (with only a high school diploma) with the speaker's own situation (with a 4-year degree).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_076222fa",
      "@type": "BackgroundKnowledge",
      "instance_name": "Stereotype_Manual_Labor_as_Inferior",
      "label": "Stereotype: Manual Labor as Inferior",
      "description": "This is a societal stereotype that devalues manual labor and skilled trades compared to white-collar or academic professions. The meme uses the workshop scene to implicitly challenge this stereotype by portraying manual labor as a viable and respectable path to success.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_968e676e",
      "@type": "BackgroundKnowledge",
      "instance_name": "Stereotype_Party_Life_as_Unproductive",
      "label": "Stereotype: Party Life as Unproductive",
      "description": "This is a cultural stereotype that views partying and socializing as unproductive or frivolous, especially in contrast to hard work or academic achievement. The meme uses the party scene to represent a lifestyle that is contrasted with the perceived value of a 4-year degree.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bc4cfed0",
      "@type": "EmotionExpression",
      "instance_name": "frustration",
      "label": "frustrated emotion",
      "description": "The emotion of frustration is conveyed through the text overlay criticizing the value of a 4-year degree and the financial burden of student debt, juxtaposed with the contrast between the speaker's parents' success and their own situation. The quote from Mike Rowe reinforces this frustration by highlighting the perceived misallocation of resources.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b94de4fa",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The speaker's parents are mapped onto the party scene",
      "description": "The text 'my parents lived better with a high school diploma' is juxtaposed with the party scene, implying that the lifestyle depicted (party scene) represents the success and fulfillment of the speaker's parents, who achieved this with only a high school diploma. The party scene visually embodies the 'better' life being referenced.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7d8de054",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_2",
      "label": "The speaker is mapped onto the party scene",
      "description": "The text 'than i do with a 4 year degree' contrasts the speaker's current situation with their parents'. The party scene, which is associated with the parents' success, is juxtaposed with the speaker's situation, implying that the speaker's life (represented by the party scene) is less successful despite having a 4-year degree. The speaker is implicitly mapped onto the party scene as the visual representation of their current state.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_12429b57",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_3",
      "label": "The speaker is mapped onto the workshop scene",
      "description": "The text 'than i do with a 4 year degree' is followed by the statistic about jobs not requiring a degree, which is then visually reinforced by the workshop scene. The workshop scene, featuring a man in manual labor, is used to represent the alternative path (vocational education) that the speaker implies is more practical. The speaker is implicitly mapped onto this scene as the visual representation of a more viable or successful alternative to a 4-year degree.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f0d15200",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_4",
      "label": "Mike Rowe is mapped onto the workshop scene",
      "description": "The quote from Mike Rowe, 'we are lending money we don't have to kids who can't pay it back to train them for jobs that no longer exist. that's nuts', is visually anchored by the workshop scene. The man in the workshop, holding a tool, represents Mike Rowe's advocacy for vocational education and his critique of the education system. The visual material (workshop scene) is mapped onto the textual material (Mike Rowe's quote) to represent his persona and message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_25cbb3ea",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the speaker's current situation",
      "description": "The user is implicitly projected onto the speaker of the meme, who is contrasting their own life (with a 4-year degree) with their parents' life (with a high school diploma). The text 'than i do with a 4 year degree' directly references the speaker's personal experience, and the user, as the viewer, is positioned as identifying with this speaker and their situation. The party scene, which represents the parents' 'better' life, is juxtaposed against the speaker's current state, which the user is invited to see as less successful despite the degree. The user is thus projected onto the speaker's personal narrative and their current life circumstances.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_60700f9f",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme promotes a harmful narrative that devalues higher education and may contribute to societal harm by undermining the value of academic achievement and potentially influencing individuals to avoid costly degrees. The message can be misleading and harmful by oversimplifying complex labor market dynamics and potentially discouraging people from pursuing education that may still be valuable in many contexts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_539c5b40",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "young adults considering higher education",
      "description": "The meme targets young adults who are contemplating or currently pursuing a 4-year college degree, particularly those who are concerned about student debt, job market relevance, and the perceived value of a college education. The contrast between the speaker’s parents’ success with a high school diploma and the speaker’s situation with a degree directly speaks to this demographic.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
