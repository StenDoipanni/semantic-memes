  "dimensions": [
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e8f003db",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: meme_image; hasOverallIntent: Harmful; overall-intent-description: The meme juxtaposes a chaotic party scene with text criticizing the value of a 4-year college degree, claiming that most jobs don't require it and quoting Mike Rowe to argue that education is being misused for jobs that no longer exist. This is framed as a critique of higher education's perceived inefficiency and financial burden, potentially discouraging investment in college education. While not explicitly targeting any protected group, it promotes a harmful narrative that devalues higher education and may contribute to societal harm by undermining the value of academic achievement and potentially influencing individuals to avoid costly degrees. The intent is to provoke debate and challenge conventional wisdom about education, but the message can be misleading and harmful by oversimplifying complex labor market dynamics and potentially discouraging people from pursuing education that may still be valuable in many contexts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cd707886",
      "@type": "TextualMaterial",
      "instance_name": "text_chunk_1",
      "label": "top text overlay",
      "description": "my parents lived better with a high school diploma",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_849653bb",
      "@type": "TextualMaterial",
      "instance_name": "text_chunk_2",
      "label": "middle text overlay",
      "description": "than i do with a 4 year degree",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_378871a6",
      "@type": "TextualMaterial",
      "instance_name": "text_chunk_3",
      "label": "middle text overlay",
      "description": "of the 3 million available jobs today, less than 20% require a 4 year degree",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a4fe8633"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f61790b9",
      "@type": "TextualMaterial",
      "instance_name": "text_chunk_4",
      "label": "bottom text overlay",
      "description": "\"we are lending money we don't have to kids who can't pay it back to train them for jobs that no longer exist. that's nuts\"",
