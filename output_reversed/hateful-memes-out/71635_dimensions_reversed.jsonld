      "instance_name": "toxicity_1",
      "label": "Profanity and Frustration",
      "description": "The text contains strong profanity ('fuckin', 'fucking') and expresses frustration about being reported for memes, which can be perceived as aggressive or confrontational. However, this does not target specific protected groups or constitute abusive, hateful, or harmful content toward any group.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bab643f8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
