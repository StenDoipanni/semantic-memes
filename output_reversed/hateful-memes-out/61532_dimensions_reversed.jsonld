      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d2d775fa",
      "@type": "BackgroundKnowledge",
      "instance_name": "John_McCain_pro_life_claim",
      "label": "John McCain's public pro-life stance",
      "description": "John McCain was a U.S. Senator and presidential candidate who publicly identified as pro-life, meaning he opposed abortion. This stance was a significant part of his political identity and was used in political campaigns and public discourse. The meme references this specific political position to create a contrast with his death.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ea79215"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c8e1a017",
      "@type": "BackgroundKnowledge",
      "instance_name": "John_McCain_death",
      "label": "John McCain's death",
      "description": "John McCain died on August 25, 2018, at the age of 81. His death was widely reported in the media and was a significant national event. The meme uses his death as a punchline to imply hypocrisy in his pro-life claims, which is a form of posthumous criticism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ea79215"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_433fcf33",
      "@type": "BackgroundKnowledge",
      "instance_name": "pro_life_political_position",
      "label": "Pro-life political position",
      "description": "The pro-life position is a political and moral stance that opposes abortion, often grounded in the belief that life begins at conception. It is a major issue in U.S. politics, particularly in the context of the Republican Party and conservative movements. The meme relies on the public understanding of this political position to make its point.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ea79215"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6cc2b7a4",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_hypocrisy_juxtaposition",
      "label": "Meme trope: juxtaposing claims with contradiction",
      "description": "This meme uses a common internet trope of juxtaposing a person's public claim or identity with a contrasting event (in this case, death) to imply hypocrisy or insincerity. The meme format relies on the viewer's understanding of this rhetorical device to deliver its message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ea79215"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cb304e2b",
      "@type": "BackgroundKnowledge",
      "instance_name": "posthumous_political_criticism",
      "label": "Posthumous political criticism",
      "description": "The meme leverages the death of a public figure to criticize their political beliefs or actions. This is a form of posthumous criticism that can be seen as disrespectful or emotionally manipulative, as it uses the deceased person's mortality as a punchline. This trope is common in political memes and satire.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ea79215"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_123653c1",
      "@type": "EmotionExpression",
      "instance_name": "sardonic_smirk",
      "label": "sardonic or mocking smirk",
      "description": "John McCain's facial expression—a slight, closed-mouth smirk combined with upward gaze—conveys a sense of self-satisfaction, irony, or condescension. In the context of the meme, this expression is interpreted as mocking or smug, implying that his pro-life claims are insincere or hypocritical, especially juxtaposed with his death. The expression is not one of genuine happiness or warmth but rather a calculated or ironic display.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ea79215"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_32b29e24",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "John McCain is mapped as 'claims to be pro-life'",
      "description": "The text 'claims to be pro-life' is positioned above John McCain's head, creating an analogical mapping where the textual claim is projected onto him as his public identity or stance. This mapping implies that John McCain embodies or represents the pro-life political position.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ea79215"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d1e7b7a1",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual claim and the scene of hypocrisy",
      "description": "The user is not explicitly projected onto a deictic pronoun like 'me' or 'you'. However, the meme's structure implicitly projects the user as the one interpreting the juxtaposition of John McCain's pro-life claim and his death, thereby positioning the user as the one who perceives the implied hypocrisy. This projection occurs onto the textual material ('claims to be pro-life' and 'dies') and the overall scene ('pro_life_claim_scene'), which together form the critical message. The user is thus projected onto the interpretive act of recognizing the contradiction, making them an active participant in the meme's rhetorical effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ea79215"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c5c2dfc6",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme uses John McCain's death as a punchline to imply hypocrisy in his pro-life claims, leveraging his mortality to criticize his political beliefs. This can be seen as disrespectful and emotionally manipulative, potentially inciting division or disrespect toward the deceased.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ea79215"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3a2fdd3a",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals familiar with U.S. politics, particularly those who follow or are critical of Republican or conservative political figures. The meme relies on the public knowledge of John McCain’s pro-life stance and his death to create its critique, making it most effective for audiences who understand the political context and the rhetorical device of juxtaposing claims with contradiction. The meme is designed to resonate with viewers who are politically engaged and may hold skeptical or critical views toward McCain’s political positions, especially regarding abortion. The use of posthumous political criticism suggests the target audience includes those who are comfortable with or even expect such forms of satire or commentary on deceased public figures.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1ea79215"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
