    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_782fb035",
      "@type": "Scene",
      "instance_name": "pro_life_claim_scene",
      "label": "pro-life claim juxtaposed with death",
      "description": "The scene depicts John McCain with text overlays that create a contrast: 'claims to be pro-life' above his head and 'dies' below his chin, implying hypocrisy or contradiction in his public stance. The visual composition centers on McCain as the subject, with the text elements framing his image to deliver a critical message.",
      "belongsToAnalysis": {
