    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3828d057",
      "@type": "BackgroundKnowledge",
      "instance_name": "religious_intolerance_hypocrisy",
      "label": "Religious Intolerance Hypocrisy",
      "description": "The meme critiques the selective application of tolerance, where individuals or groups show intolerance toward other religions but expect the highest level of tolerance for their own. This concept is rooted in real-world discussions about religious freedom, sectarianism, and double standards in religious communities, often used to highlight perceived hypocrisy in religious or political discourse.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02cefef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ad6a5aea",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia",
      "label": "Islamophobia",
      "description": "A form of prejudice or discrimination against Muslims, often manifesting as stereotypes, fear, or hostility. The meme implicitly references this by using imagery and text that could be interpreted as targeting or caricaturing Muslim communities, particularly in the context of religious intolerance. This stereotype is part of broader anti-Islamic tropes that associate Muslims with violence, extremism, or cultural backwardness.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02cefef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c6bb0613",
      "@type": "BackgroundKnowledge",
      "instance_name": "religious_extremism",
      "label": "Religious Extremism",
      "description": "The belief or practice of adhering to a strict, often intolerant interpretation of religious doctrine. The meme uses the visual of an angry, shouting man to symbolize religious extremism, which is a real-world phenomenon often associated with radicalization, sectarian violence, and the rejection of other faiths. This concept is central to understanding the meme’s critique of intolerance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02cefef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_963bcb72",
      "@type": "BackgroundKnowledge",
      "instance_name": "selective_tolerance",
      "label": "Selective Tolerance",
      "description": "The practice of applying tolerance inconsistently, often favoring one’s own group or beliefs while being intolerant of others. This is a social and political concept that the meme critiques by juxtaposing the aggressive display of intolerance with the expectation of tolerance for one’s own religion. It reflects real-world debates about fairness, equity, and the limits of religious freedom.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02cefef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f02b7abe",
      "@type": "BackgroundKnowledge",
      "instance_name": "religious_hypocrisy",
      "label": "Religious Hypocrisy",
      "description": "The act of pretending to hold religious beliefs while acting contrary to them, or applying religious principles inconsistently. The meme uses this concept to condemn those who are intolerant of other religions but demand tolerance for their own. This is a common theme in religious and political discourse, often used to criticize leaders or communities for double standards.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02cefef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_16089ede",
      "@type": "EmotionExpression",
      "instance_name": "anger",
      "label": "the angry expression",
      "description": "The central figure in the foreground is depicted with a highly aggressive facial expression: his mouth is wide open in a shout, his eyes are narrowed and intense, and his eyebrows are furrowed, conveying extreme anger and hostility. His pointing finger further emphasizes confrontation and aggression. This expression is the focal point of the image and is directly linked to the textual message about intolerance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02cefef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_27a7291f",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The angry man is mapped as the embodiment of religious intolerance toward others",
      "description": "The visual entity 'man_in_foreground' with his aggressive expression and pointing gesture is mapped onto the textual entity 'text_chunk_1' ('show intolerance for other's religions'). The image visually represents the concept of intolerance, and the text explicitly labels this behavior, creating an analogical mapping where the man's actions and appearance symbolize the textual message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02cefef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cd115831",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the aggressive protest scene as embodying selective religious intolerance",
      "description": "The user is implicitly projected onto the scene and the central figure, as the meme uses the visual of the angry man and the text to create a caricature of religious hypocrisy. The user is invited to see themselves as the embodiment of the behavior described — showing intolerance toward others while expecting tolerance for their own — thus projecting their own potential or perceived behavior onto the scene. The deictic projection is implicit, not explicit, but the framing of the meme (the angry man pointing forward, the text labeling the behavior) creates a direct address to the viewer, making them the subject of the critique.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02cefef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c4097c2f",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme depicts and critiques religious intolerance through the visual of an angry, shouting man and the text 'show intolerance for other's religions' and 'expect highest level of tolerance for their own.' This is framed as a caricature of religious extremism and hypocrisy, which can be interpreted as a form of religious bigotry or Islamophobia, as it implies that those who are intolerant of other religions are themselves intolerant of their own, thus framing the behavior as inherently hypocritical and hateful toward religious minorities or other faiths.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02cefef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f48bfdf8",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who are aware of or engaged with discussions about religious intolerance, hypocrisy, and selective tolerance, particularly in the context of Islamophobia and religious extremism. The meme is designed to resonate with audiences familiar with critiques of religious double standards, and it implicitly targets or critiques communities that exhibit intolerance toward other religions while expecting tolerance for their own. The visual of the aggressive protest scene and the textual message are crafted to provoke reflection or criticism from those who recognize or have experienced such hypocrisy in religious or political discourse. The meme’s framing as a caricature of religious extremism and hypocrisy suggests it is aimed at an audience that understands or is concerned with issues of religious freedom, sectarianism, and social justice, particularly in relation to Muslim communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02cefef"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
