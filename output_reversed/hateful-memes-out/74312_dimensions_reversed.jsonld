    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1cb174e2",
      "@type": "BackgroundKnowledge",
      "instance_name": "karen_stereotype",
      "label": "Karen Stereotype",
      "description": "A derogatory stereotype referring to a woman (often white, middle-class, or upper-middle-class) perceived as entitled, aggressive, or unreasonable, particularly in public or service settings. The term is used pejoratively to describe individuals who are seen as demanding, confrontational, or overly assertive — often in ways that are considered disruptive or unreasonable. The stereotype is rooted in misogynistic and classist assumptions about women who are perceived as overly emotional or entitled.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4b81e68c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0d4fe955",
      "@type": "BackgroundKnowledge",
      "instance_name": "get_your_shit_together_phrase",
      "label": "Get Your Shit Together Phrase",
      "description": "A vulgar, dismissive, and confrontational command used to express frustration or anger, often directed at someone perceived as irresponsible, disorganized, or emotionally unstable. In the context of this meme, it reinforces the hostile tone and serves as a mocking retort to the 'karen' stereotype, implying the person should calm down or behave more rationally.",
      "belongsToAnalysis": {
