      "label": "top text overlay",
      "description": "when someone says \"show me in the bible where it says jesus command gays should be out to death?\"",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5ebeb312"
      },
      "extractionMethod": "llm_extraction_huggingface"
