    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ea1eabc8",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype",
      "label": "Anti-Black Stereotype: Black people are not 'American enough' to celebrate national holidays",
      "description": "This stereotype implies that Black people, despite being American citizens, are somehow culturally or racially incompatible with celebrating American national holidays like the 4th of July. It suggests a racial hierarchy where only certain groups are deemed 'authentic' or 'proper' participants in American patriotism, which is a form of racial exclusion and discrimination. This is a common trope in racist discourse, often used to undermine the legitimacy of Black Americans' patriotism and cultural participation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04ee0ea7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_567deb09",
      "@type": "BackgroundKnowledge",
      "instance_name": "4th_of_july",
      "label": "Independence Day (4th of July)",
      "description": "The 4th of July is the national holiday of the United States, commemorating the adoption of the Declaration of Independence in 1776. It is a day of patriotic celebration, including parades, fireworks, barbecues, and wearing red, white, and blue attire. The meme references this specific holiday to frame the celebration as inherently 'American' and to contrast it with the implied racial insensitivity of the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04ee0ea7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_018f0095",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_stereotyping",
      "label": "Racial Stereotyping",
      "description": "The meme relies on the broader concept of racial stereotyping — the oversimplified and often negative assumptions about a racial group. In this case, it stereotypes Black people as being 'out of place' or 'inappropriate' for celebrating American holidays, which is a form of racial exclusion and can be seen as a microaggression or hate speech. This stereotype is rooted in historical racism and continues to be used to marginalize Black Americans.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04ee0ea7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8e1d5bf0",
      "@type": "BackgroundKnowledge",
      "instance_name": "hateful_meme",
      "label": "Hateful Meme",
      "description": "A meme that is intentionally designed to provoke, demean, or insult a specific group based on race, ethnicity, or other identity markers. This meme is hateful because it uses the visual of a joyful Black family to contrast with a text that implies their celebration is somehow wrong or mocking, thereby perpetuating racial discrimination and harmful stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04ee0ea7"
      },
      "extractionMethod": "llm_extraction_huggingface"
