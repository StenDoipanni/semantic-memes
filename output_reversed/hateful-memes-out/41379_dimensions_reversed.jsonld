    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c70b792f",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The text 'how you look when youre black' maps onto the visual of the Black family celebrating the 4th of July.",
      "description": "The top text overlay 'how you look when youre black' is juxtaposed with the visual of a happy Black family dressed patriotically. This creates an analogical mapping where the text implies that the visual representation of the family (the 'mapping entity') is how a Black person 'looks' when they celebrate the 4th of July (the 'mapped entity'). This mapping is central to the meme's hateful intent, as it frames the family's joyful celebration as an example of how Black people are perceived or expected to behave during American patriotic holidays, reinforcing the anti-Black stereotype that Black people are not 'American enough' to celebrate such holidays. The entire scene — the family, their attire, their joy — is mapped onto the textual description provided.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04ee0ea7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8cc811cf",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material describing the visual scene",
      "description": "The user is projected onto the text 'how you look when youre black' which is presented as a direct address to the viewer, implying that the viewer (the user) is the one who is being described as 'how you look when youre black' in the context of celebrating the 4th of July. This creates a direct deictic projection where the user is positioned as the subject of the text's description, even though the visual material shows a family. The text 'how you look when youre black' is a direct address to 'you', which is the user.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_04ee0ea7"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
