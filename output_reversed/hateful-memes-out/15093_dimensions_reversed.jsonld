    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c65520d7",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who identify with or support the religious group being referenced in the text — specifically, adherents of Islam — as the meme frames the religion as 'peaceful' and victimized by external mockery. The meme is designed to resonate with this community by invoking shared identity and portraying them as the aggrieved party in a narrative of external criticism and violence. The visual of the angry man amidst wreckage is mapped onto the 'peaceful religion' being mocked, creating an emotional appeal to those who feel their faith is under attack. The meme weaponizes suffering and destruction to defend the religion, which is intended to provoke solidarity and outrage among its target audience — primarily Muslim communities — while delegitimizing criticism by equating it with violence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2f0867bd"
      },
