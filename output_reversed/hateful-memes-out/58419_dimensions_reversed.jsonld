    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8401b83f",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_stereotype",
      "label": "Islamophobia Stereotype",
      "description": "The meme implicitly relies on the stereotype that Muslims are not fully 'American' and that attacks on one Muslim are not equivalent to attacks on all Americans, which is a form of Islamophobia. This stereotype is used to justify potential discrimination or violence against Muslims by framing them as outsiders or threats to the American identity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_65889dca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6e497511",
      "@type": "BackgroundKnowledge",
      "instance_name": "cowboy_stereotype",
      "label": "Cowboy Stereotype",
      "description": "The image of the cowboy is implicitly associated with white, rural, and traditional American identity. This stereotype reinforces the implicit racial and cultural hierarchy in the meme's message, suggesting that 'American' identity is inherently tied to a specific racial or cultural group, thereby excluding Muslims from that identity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_65889dca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_49804e98",
      "@type": "BackgroundKnowledge",
      "instance_name": "barack_obama_quote_context",
      "label": "Barack Obama Quote Context",
      "description": "The quote 'those that attack one muslim, are attacking all muslims' is a well-known statement by Barack Obama, often cited in discussions about religious tolerance and combating Islamophobia. The meme uses this quote to establish a moral or ethical standard, which it then contrasts with the cowboy's statement about Americans.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_65889dca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8dff5379",
      "@type": "BackgroundKnowledge",
      "instance_name": "american_identity_concept",
      "label": "American Identity Concept",
      "description": "The meme implicitly references the concept of 'American identity' as a collective, homogeneous entity. The cowboy's statement 'those that attack one american, are attacking all americans!!' relies on the assumption that American identity is monolithic and that attacking one person is equivalent to attacking the entire group. This concept is used to contrast with the idea of religious identity (Muslims) and to imply that Muslims are not fully part of the American identity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_65889dca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_74f475e9",
      "@type": "BackgroundKnowledge",
      "instance_name": "one_person_all_group_stereotype",
      "label": "One Person = All Group Stereotype",
      "description": "The meme implicitly relies on the stereotype that attacking one member of a group is equivalent to attacking the entire group. This is a dangerous and exclusionary framing that is used to justify discrimination or violence against a group by equating the actions against one individual with attacks on the entire group. The meme uses this stereotype to suggest that the same logic should apply to Muslims, which is a form of Islamophobia.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_65889dca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3dd3b04a",
      "@type": "EmotionExpression",
      "instance_name": "condemnation",
      "label": "condemning emotion",
      "description": "The serious facial expression of Barack Obama, combined with his pointed finger gesture and the text overlay, conveys a strong sense of moral condemnation against those who attack Muslims. His expression is stern and authoritative, intended to communicate disapproval and a call for unity and protection of the Muslim community.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_65889dca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6c13278c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Barack Obama is mapped as the source of the moral statement about Muslims",
      "description": "The top panel visually presents Barack Obama, and the text overlay 'those that attack one muslim, are attacking all muslims' is attributed to him. This creates an analogical mapping where the visual entity (Barack_Obama) is the source or embodiment of the textual statement (text_chunk_1). The meme uses his image to represent the moral principle being discussed.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_65889dca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_02989798",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the cowboy image and its textual message",
      "description": "The user is implicitly projected onto the cowboy image and the text 'those that attack one american, are attacking all americans!!' in the bottom panel. This projection occurs because the meme frames the cowboy's statement as a universal truth or moral imperative that the user is expected to endorse or identify with. The user is invited to see themselves as part of the 'American' group being protected by this logic, thereby internalizing the meme's exclusionary message that Muslims are not fully 'American' and thus do not deserve the same protection. The emphatic '!!' in the text further reinforces this projection by demanding agreement or emotional investment from the viewer.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_65889dca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_96472712",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme is hateful because it uses the image of a white American cowboy to implicitly equate the concept of 'attacking one American' with the idea of 'attacking all Americans,' which is a dangerous and exclusionary framing. It promotes the idea that Muslims are not 'Americans' and that the same logic of 'one person = all' does not apply to them, which is a form of Islamophobia. The meme is designed to provoke division and reinforce harmful stereotypes by suggesting that Muslims are not fully part of the American identity, thereby justifying potential discrimination or violence against them. The use of the cowboy image, often associated with white, rural, and traditional American identity, further reinforces the implicit racial and cultural hierarchy in the meme's message, making it a hateful and potentially harmful piece of content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_65889dca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c5215b78",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who hold or are susceptible to Islamophobic views, particularly those who may perceive Muslims as not fully 'American' or as outsiders to the national identity. The meme is designed to appeal to or reinforce a community that embraces a narrow, exclusionary definition of 'American' identity, often associated with white, rural, or traditional cultural markers (as symbolized by the cowboy image). It targets those who may be inclined to justify discrimination or violence against Muslims by invoking the 'one person = all group' logic, which the meme frames as applicable to Americans but not to Muslims. The use of Barack Obama's image to establish a moral standard is likely intended to make the contrast more provocative for audiences who may already harbor skepticism toward Muslim integration or who are influenced by racial and cultural hierarchies.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_65889dca"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
