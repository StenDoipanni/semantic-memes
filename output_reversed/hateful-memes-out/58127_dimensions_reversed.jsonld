      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_18142fa6",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The unborn child is mapped as a bomb",
      "description": "The text 'it's a bomb' is an analogical mapping that projects the unborn child (implied by the pregnant woman's belly being touched) onto the metaphorical concept of a bomb. The visual of the pregnant woman's belly, the focal point of the pregnancy reveal, is mapped onto the textual entity 'bomb', creating a shocking and violent analogy. This mapping is central to the meme's dark humor and harmful intent, as it devalues the child by equating it with destruction.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_948c3191"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_57d64087",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the violent metaphor text",
      "description": "The user is projected onto the textual material 'it's a bomb', as this phrase is the central shocking element of the meme. The user is invited to imagine themselves reacting to or experiencing the dark humor and harmful metaphor presented in the text, which contrasts with the positive visual of the pregnancy reveal. The projection is implicit, not deictic, but the user is expected to identify with the experience of encountering this shocking statement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_948c3191"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
