    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_39838e44",
      "@type": "Scene",
      "instance_name": "pregnancy_reveal_scene",
      "label": "Pregnancy Reveal with Violent Metaphor",
      "description": "A scene depicting two women, one visibly pregnant, engaged in a moment of anticipation and interaction. The pregnant woman is smiling and being touched on her belly by the other woman. The scene is overlaid with text that poses the question 'is it a boy or a girl' and then delivers a shocking, violent metaphor 'it's a bomb'. The spatial arrangement shows the pregnant woman as the central focus, with the other woman positioned to her side, gently touching her belly. The interaction is intimate and personal, yet the text introduces a jarring, harmful tone.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_948c3191"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_67bf6eb8",
      "@type": "BackgroundKnowledge",
      "instance_name": "violent_metaphor_for_child",
      "label": "Violent Metaphor for Child",
      "description": "The phrase 'it's a bomb' is a crude, violent metaphor used to describe a child, implying danger, destruction, or explosiveness. This metaphor is inherently harmful as it devalues human life and infantile innocence, potentially normalizing violence or danger associated with childbirth or children. It is a form of dark humor that maps onto the image of a pregnant woman to create a shocking effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_948c3191"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a94cc0a2",
      "@type": "BackgroundKnowledge",
      "instance_name": "pregnancy_reveal_cultural_trend",
      "label": "Pregnancy Reveal Cultural Trend",
      "description": "The image and text reference the common cultural practice of 'pregnancy reveal' moments, where expectant parents share the gender of their unborn child with friends or family. This is often done with excitement and anticipation, as seen in the smiling pregnant woman. The meme subverts this positive cultural moment with a violent metaphor, creating a jarring contrast.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_948c3191"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
