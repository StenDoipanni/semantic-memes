    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e1a74a77",
      "@type": "BackgroundKnowledge",
      "instance_name": "cultural_norms_decline_stereotype",
      "label": "Cultural Norms Decline Stereotype",
      "description": "The meme relies on the stereotype that societal norms have deteriorated over time, particularly in terms of modesty and propriety in public behavior. This is a common trope in reactionary or conservative commentary, often used to imply that modern society is 'worse' than past eras, especially regarding gender expression and clothing. The juxtaposition of formal 1947 attire with a 2017 woman in a revealing outfit is meant to visually represent this perceived decline.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9bf14983"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_95d31b91",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogyny",
      "label": "Misogyny",
      "description": "The meme implicitly references misogynistic stereotypes that objectify women by focusing on their clothing and body, suggesting that women in the past were more 'proper' or 'modest' than women today. This aligns with misogynistic tropes that claim women are 'less capable' or 'less moral' when they deviate from traditional gender roles, particularly in public spaces. The 2017 image of the woman walking in a revealing outfit is interpreted through this lens as 'inappropriate' or 'decadent' compared to the 1947 man's formal attire.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9bf14983"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_38d98445",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_context_1947",
      "label": "Historical Context of 1947",
      "description": "The year 1947 is used to evoke a specific historical period characterized by post-war conservatism, traditional gender roles, and strict social norms, particularly in Western societies. The formal attire of the man and the studio portrait style reflect the era's emphasis on propriety and decorum. Understanding this context is necessary to interpret the meme's contrast with the 2017 image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9bf14983"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5ee73695",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_context_2017",
      "label": "Historical Context of 2017",
      "description": "The year 2017 is used to represent a contemporary era perceived as more liberal, permissive, or 'decadent' in terms of social norms, particularly regarding gender expression and public modesty. The image of a woman in a revealing outfit walking across a street is interpreted as a symbol of modern societal attitudes, which the meme contrasts unfavorably with the 1947 image. This contrast relies on the viewer's understanding of 2017 as a time of perceived moral or cultural decline.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9bf14983"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_073a66d4",
      "@type": "BackgroundKnowledge",
      "instance_name": "gender_expression_stereotype",
      "label": "Gender Expression Stereotype",
      "description": "The meme relies on the stereotype that women's clothing and public behavior should conform to traditional, modest standards. The 2017 image of the woman in a revealing outfit is interpreted as a violation of these standards, implying that such behavior is 'wrong' or 'degenerate' compared to the 1947 man's formal, restrained appearance. This stereotype is rooted in patriarchal norms that dictate how women should dress and behave in public.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9bf14983"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9c23c28d",
      "@type": "EmotionExpression",
      "instance_name": "mocking_disgust",
      "label": "mocking disgust at perceived moral decline",
      "description": "The emotion expressed is a satirical and mocking disgust, conveyed through the juxtaposition of the formal 1947 portrait with the 2017 image of a woman in revealing clothing, combined with the text 'something went terribly wrong.' This emotion is not genuine disgust but a performative, exaggerated reaction designed to shock and provoke, implying that modern society has regressed morally or culturally. It is rooted in the meme's intent to portray a decline in societal standards, particularly regarding gender expression and modesty.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9bf14983"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
