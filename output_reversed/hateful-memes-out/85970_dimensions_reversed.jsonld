    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4c62d3eb",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the insulted man",
      "description": "The user is projected onto the visual material of the elderly white man (Mitch McConnell) as the target of the abusive text. The meme's structure, with the text 'all american' and 'piece of shit' directly overlaid on his image, creates a direct projection where the user identifies with the act of insulting him, or sees themselves as the one delivering the insult. There are no explicit deictic pronouns like 'me' or 'you' in the text, but the framing of the image and the overall intent of the meme imply that the user is positioned as the speaker or the one who is morally condemning the man, projecting their own judgment onto him.",
      "belongsToAnalysis": {
