    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_163e0b5b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material 'your uncle samir'",
      "description": "The text 'look at the plane, it's your uncle samir' uses the deictic phrase 'your uncle samir', which directly projects the user (the viewer) onto the textual entity 'uncle samir'. The user is positioned as the person who is being addressed and who has a familial relationship with 'Samir', making them the implied subject of the statement. This projection is onto the textual material, as the deictic 'your' explicitly references the user.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_22336278"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
