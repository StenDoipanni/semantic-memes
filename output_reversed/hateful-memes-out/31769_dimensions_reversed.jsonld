    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bb0821d2",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "hateful text mapped onto peaceful civil rights protesters",
      "description": "The overlaid text 'what if i told you blacks should not vote' is juxtaposed with the visual of a group of Black youth holding civil rights signs ('This is America. Count every vote'). This creates an analogical mapping where the hateful text is projected onto the visual material, implying that the group of people depicted are the target of the racist message. The mapping is spatial and contextual: the text directly overlays the image, creating a contrast between the peaceful protest and the hateful statement, thereby mapping the hateful sentiment onto the visual representation of Black civic engagement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_830ee10a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8bf7934d",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the hateful text overlay",
      "description": "The user is projected onto the textual material 'what if i told you blacks should not vote' because the phrase 'what if i told you' directly addresses the viewer ('you'), creating an implicit deictic that positions the user as the recipient of the hateful proposition. The user is thus projected onto this text, which is the core message of the meme's hateful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_830ee10a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
