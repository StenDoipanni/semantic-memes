    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9ff2760e",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_disenfranchisement",
      "label": "Historical Disenfranchisement of Black Americans",
      "description": "The meme's message is a direct echo of historical efforts to disenfranchise Black Americans, including through violence, intimidation, and legal barriers, which were used to maintain white supremacy and political control in the United States.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_830ee10a"
