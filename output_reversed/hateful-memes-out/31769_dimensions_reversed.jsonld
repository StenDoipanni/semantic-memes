    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8a53d487",
      "@type": "Scene",
      "instance_name": "protest_scene",
      "label": "civil_rights_protest",
      "description": "A group of Black youth are gathered in a peaceful civil rights demonstration, holding red signs that read 'This is America. Count every vote.' They are dressed in white shirts and appear united in their purpose. The scene is set outdoors under a bright sky with trees in the background, conveying a message of civic engagement and equality. The overlaid text 'what if i told you blacks should not vote' creates a jarring contrast, turning the peaceful protest into a scene of hate speech juxtaposed with civil rights imagery.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_830ee10a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9091d33c",
      "@type": "BackgroundKnowledge",
      "instance_name": "racist_hate_speech",
      "label": "Racist Hate Speech",
      "description": "The overlaid text 'what if i told you blacks should not vote' constitutes a direct racist hate speech targeting Black Americans by denying them the fundamental democratic right to vote. This is not merely a political opinion but a hateful and exclusionary statement rooted in systemic racism and historical oppression.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_830ee10a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6e787349",
      "@type": "BackgroundKnowledge",
      "instance_name": "civil_rights_movement",
      "label": "Civil Rights Movement",
      "description": "The image visually references the American Civil Rights Movement, particularly the era of the 1960s when Black Americans fought for voting rights and equality. The signs 'This is America. Count every vote' are a direct nod to the movement's core message of universal suffrage and democratic participation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_830ee10a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_caa7c7ec",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_voting_rights_struggle",
      "label": "Historical Struggle for Voting Rights",
      "description": "The meme implicitly references the long and difficult historical struggle of Black Americans to secure the right to vote, including the Jim Crow laws, poll taxes, literacy tests, and voter suppression tactics that were used to disenfranchise them for generations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_830ee10a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_15634dac",
      "@type": "BackgroundKnowledge",
      "instance_name": "systemic_racism",
      "label": "Systemic Racism",
      "description": "The meme's hateful message is rooted in systemic racism — the institutionalized and structural discrimination against Black people that has historically denied them equal access to political power and civic rights, even after legal victories like the Voting Rights Act of 1965.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_830ee10a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_43a294eb",
      "@type": "BackgroundKnowledge",
      "instance_name": "voting_rights_act_of_1965",
      "label": "Voting Rights Act of 1965",
      "description": "This landmark U.S. federal law outlawed discriminatory voting practices, including literacy tests and poll taxes, that had been used to disenfranchise Black voters, especially in the Southern United States. The message 'Count every vote' directly references this legislation and the movement that led to it.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_830ee10a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ca971f4b",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype",
      "label": "Anti-Black Stereotype",
      "description": "The meme invokes the harmful stereotype that Black people are inherently undeserving of political power or civic participation, which is a direct continuation of racist ideologies that have been used to justify disenfranchisement and oppression throughout American history.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_830ee10a"
