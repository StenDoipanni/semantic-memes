    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2f82e3e5",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who hold negative stereotypes or prejudices toward young men, particularly those who perceive them as unruly, untrustworthy, or socially undesirable. The meme is designed to appeal to this audience by using a sarcastic and contemptuous tone to dismiss the group's 'pride' as so extreme or offensive that it makes 'shame' seem even more undesirable. This rhetorical device relies on the stereotype that young men (or certain groups) are inherently untrustworthy or unreliable, making their 'pride' seem dangerous or offensive. The intended audience likely includes those who view young men as uneducated, lacking in social skills, or incapable of nuanced behavior, and who are predisposed to devalue or belittle such groups based on their appearance or behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1891af7e"
      },
      "extractionMethod": "llm_extraction_huggingface"
