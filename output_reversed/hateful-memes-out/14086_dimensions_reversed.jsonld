    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_69376c9b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The group's defiant pose is mapped as 'pride'",
      "description": "The text 'if this is what they call pride..' directly maps the visual entity 'group_of_young_men' (specifically their defiant pose) to the concept of 'pride'. The meme uses this mapping to sarcastically imply that the group's display of 'pride' is so extreme or inappropriate that it makes the concept of 'shame' seem even more undesirable.",
      "belongsToAnalysis": {
