    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5542572a",
      "@type": "BackgroundKnowledge",
      "instance_name": "bro_culture",
      "label": "Bro Culture",
      "description": "The phrase 'i'm not even joking bro' is a colloquial expression often used in 'bro culture' — a social trend among young men that emphasizes machismo, hyper-masculinity, and the use of casual, often dismissive or aggressive language. This cultural context is necessary to understand the tone and intent of the meme, as it frames the statement as a serious, unironic declaration from a male perspective.",
      "belongsToAnalysis": {
