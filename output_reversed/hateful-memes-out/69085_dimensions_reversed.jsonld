    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_48c0bd7e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Dog's aggressive expression mapped to the speaker's hatred",
      "description": "The visual of the Shiba Inu dog snarling with its mouth open and teeth bared is mapped onto the textual statement 'i hate women so much'. The dog's aggressive expression serves as a visual metaphor for the speaker's supposed rage or hostility toward women, amplifying the hateful message through the common meme trope of using animal aggression to represent human emotion. This mapping relies on the audience's understanding that the dog's expression conveys anger, which is then analogically projected onto the speaker's stated emotion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bb006a9d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d04a3f6b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the dog's aggressive expression as a metaphor for their own hatred",
      "description": "The user is projecting themselves onto the visual material of the Shiba Inu dog snarling, interpreting the dog's aggressive expression as a metaphor for their own stated hatred toward women. The meme format uses the dog's expression to visually represent the user's internal state, creating a semiotic projection where the user identifies with the dog's perceived rage. This projection is reinforced by the textual material 'i hate women so much' and 'i'm not even joking bro', which frames the user's identity as the speaker of this hateful declaration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bb006a9d"
      },
      "extractionMethod": "llm_extraction_huggingface"
