    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2c2939df",
      "@type": "Scene",
      "instance_name": "child_outside",
      "label": "child playing outside",
      "description": "A young boy with light blonde hair and a wide, happy smile, wearing a blue t-shirt, is standing outdoors in a sunny, green environment. He is looking directly at the camera with a joyful expression, and has his hands clasped together near his chest. The background consists of lush green trees and a white fence, indicating an outdoor setting. The text 'i like to play outside' is overlaid on the image, reinforcing the scene's theme of outdoor play and childhood joy.",
      "belongsToAnalysis": {
