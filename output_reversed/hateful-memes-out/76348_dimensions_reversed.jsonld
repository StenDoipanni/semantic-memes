    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9bc1f463",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Refugees are mapped to limp floating pasta",
      "description": "The top text 'i like my refugees like i like my pasta' explicitly maps refugees to pasta. The visual of pasta boiling and floating in water in the pot serves as the visual representation for this metaphorical mapping. The bottom text 'limp and floating in water' reinforces this mapping by describing the state of the pasta, which is then analogously applied to refugees.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2c95b02a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_798fb485",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the dehumanizing metaphor of refugees as limp floating pasta",
      "description": "The user is projected onto the textual and visual metaphor that equates refugees with limp, floating pasta. The meme uses the phrase 'i like my refugees like i like my pasta' and the image of pasta boiling to create a direct analogy. The user is implicitly invited to identify with the speaker's perspective, adopting the hateful framing that refugees are undesirable and burdensome, as represented by the pasta metaphor. This projection is onto the textual material (text_chunk_1) and the visual material (pot) that together form the dehumanizing metaphor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2c95b02a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
