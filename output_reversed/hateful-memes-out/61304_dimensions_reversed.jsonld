    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cc68dac0",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "child is the one who won't be let use the oven with friends",
      "description": "The text 'mom won't let me use the oven with my friends' is mapped onto the visual entity 'child', who is depicted smiling while playing with a toy kitchen set. The child's joyful expression and engagement with the toy kitchen visually represent the child's desire to use the oven (as implied by the text) with friends, even though it is a toy. The mapping is established by the juxtaposition of the text with the child's image, where the child is the subject of the text ('me').",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f256aaab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5ea5a81e",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the child as the subject of the text",
      "description": "The user is projected onto the child (visual material) because the text 'mom won't let me use the oven with my friends' uses the first-person pronoun 'me', which directly refers to the child depicted in the image. The child is the central subject of the meme, and the text explicitly identifies her as 'me', creating a direct semiotic projection where the viewer sees themselves as the child in the scenario. This projection is reinforced by the child's joyful expression, which the user may relate to as their own experience or perspective.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f256aaab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
