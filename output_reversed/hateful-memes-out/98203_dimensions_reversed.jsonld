    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_719211d2",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The collective mourning scene is mapped onto the textual narrative of a child's death due to Israeli bombing.",
      "description": "The visual entity 'collective_mourning' — depicting men in intense grief and protest — is analogically mapped to the textual narrative 'when god grants you a child after 20 years of your marriage and israel bombs him few years later'. The image of collective anguish serves as a visual representation of the profound personal tragedy described in the text, framing the loss of a child as a communal and political event. The emotional intensity of the visual material (grief, rage, protest) is projected onto the textual material to evoke empathy and associate the personal loss with the broader geopolitical context of Israeli bombing in Palestine.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_97ef5695"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_77721147",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual narrative as the victim of geopolitical tragedy",
      "description": "The user is implicitly projected onto the textual material ('text_chunk') which describes a personal tragedy — the loss of a child after 20 years of marriage due to Israeli bombing. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the emotional framing of the meme (collective mourning, intense grief) and the universal nature of the tragedy (loss of a child) create a strong semiotic projection where the viewer identifies with the victim described in the text. The user is projected onto the text_chunk as the person experiencing the described loss, thereby internalizing the narrative as their own or as a shared human experience.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_97ef5695"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
