    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5ac34900",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Black man is mapped as 'livestock'",
      "description": "The text 'farm equipment and livestock don't mix' explicitly maps the Black man in the image to 'livestock'. This is a direct analogical mapping where the visual entity (the Black man) is equated with the textual entity 'livestock', reinforcing a dehumanizing stereotype. This mapping is central to the meme's hateful intent, as it reduces the man's humanity to that of an animal commodity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6055ac85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_967ff26b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the Black man as 'livestock'",
      "description": "The user is projected onto the Black man in the image, who is explicitly mapped as 'livestock' by the text 'farm equipment and livestock don't mix'. This projection is implicit but powerful, as the meme positions the viewer to identify with the dominant figure (the white woman) and to see the Black man as an object of use or control, reinforcing the racist trope of hypersexualization and subordination. The user is not directly addressed with deictic pronouns like 'you' or 'me', but the framing of the image and text creates a passive projection where the user is implicitly positioned as the 'owner' or 'operator' (the white woman) in the power dynamic.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6055ac85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
