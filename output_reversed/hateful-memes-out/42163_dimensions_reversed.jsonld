    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ca64ef99",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_hypersexualization",
      "label": "Anti-Black Stereotype: Hypersexualization",
      "description": "The meme uses the phrase 'farm equipment and livestock don't mix' to imply that the Black man is 'livestock' and the white woman is 'farm equipment,' which is a form of hypersexualization. This stereotype dehumanizes Black men by portraying them as objects for the use or control of white women, reducing their humanity and dignity. This is a well-documented racist trope in American culture.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6055ac85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0981132b",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_comparing_to_primates",
      "label": "Anti-Black Stereotype: Comparing Black People to Primates",
      "description": "The phrase 'livestock' in the meme is a euphemism that implicitly references the dehumanizing stereotype of comparing Black people to animals, particularly primates. This trope has a long history in racist discourse and is used to portray Black people as inferior, animalistic, and lacking human dignity. The use of 'livestock' directly invokes this harmful stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6055ac85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_17544ceb",
      "@type": "BackgroundKnowledge",
      "instance_name": "racist_trope_objectification",
      "label": "Racist Trope: Objectification",
      "description": "The meme objectifies the Black man by reducing him to a commodity ('livestock') that is 'used' by the white woman ('farm equipment'). This is a form of racial objectification, where a person's worth is diminished to their utility or function in a racist power dynamic. This trope is rooted in historical systems of slavery and racial hierarchy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6055ac85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b5e52693",
      "@type": "BackgroundKnowledge",
      "instance_name": "racist_trope_subordination",
      "label": "Racist Trope: Subordination",
      "description": "The meme implies a power dynamic of subordination, where the Black man is positioned as subordinate to the white woman. This is a common racist trope that reinforces white supremacy by portraying Black men as inferior and controlled by white women, perpetuating harmful gender and racial hierarchies.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6055ac85"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_48253138",
      "@type": "BackgroundKnowledge",
      "instance_name": "racist_trope_racial_hierarchy",
      "label": "Racist Trope: Racial Hierarchy",
      "description": "The meme operates within the framework of racial hierarchy, where the white woman is positioned as the dominant 'owner' or 'operator' and the Black man as the subordinate 'asset' or 'livestock.' This reinforces the idea that white people are superior and Black people are inferior, a core tenet of systemic racism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6055ac85"
      },
