      "@id": "http://example.org/multimodal-taxonomy#dimension_ad084151",
      "@type": "BackgroundKnowledge",
      "instance_name": "manual_tranny",
      "label": "manual transmission",
      "description": "A type of transmission system in vehicles where the driver manually shifts gears using a clutch and gear lever. Requires driver input to change gears, offering more control and efficiency but less convenience than automatic transmissions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_44daea27"
