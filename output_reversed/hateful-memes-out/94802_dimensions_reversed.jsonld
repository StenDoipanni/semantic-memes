    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cada2d80",
      "@type": "BackgroundKnowledge",
      "instance_name": "automatic_tranny",
      "label": "automatic transmission",
      "description": "A type of transmission system in vehicles that automatically changes gears without driver input, using a torque converter and planetary gear sets. Designed for convenience and ease of use, often at the expense of driver control and fuel efficiency compared to manual transmissions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_44daea27"
