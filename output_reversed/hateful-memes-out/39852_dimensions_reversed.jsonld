      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_31500088",
      "@type": "VisualMaterial",
      "instance_name": "three_individuals",
      "label": "survivors of Auschwitz",
      "description": "Three emaciated, visibly traumatized individuals, likely Jewish Holocaust survivors, standing and sitting in front of a building. Their clothing is ragged and worn, indicating extreme suffering and deprivation. The image is a historical photograph colorized, and the overlaid text falsely claims they were liberated by the USSR in 1945, which is historically inaccurate as Auschwitz was liberated by the Soviet Red Army in January 1945, but the text misattributes the liberation to the USSR (which is correct but misleadingly framed). The individuals appear to be in a state of extreme physical and emotional distress, consistent with survivors of the Holocaust. Their presence is the central visual material and the subject of the meme's hateful intent, which seeks to trivialize their suffering by presenting the image as a 'colorized' novelty.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_488ce1cb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_33612e3d",
      "@type": "Scene",
      "instance_name": "survivors_in_front_of_building",
      "label": "Three Holocaust survivors standing and sitting in front of a building",
      "description": "The scene depicts three emaciated survivors of Auschwitz, visibly traumatized and dressed in ragged clothing, positioned in front of a building. Their physical state and expressions convey extreme suffering and deprivation. The image is colorized, and overlaid text falsely claims they were liberated by the USSR in 1945. The scene composition centers on their collective presence as the primary visual material, with their spatial arrangement (two standing, one seated) forming a group portrait that emphasizes their shared trauma. The background building provides a static, somber setting that contrasts with their fragile physicality.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_488ce1cb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1ecf3d6d",
      "@type": "BackgroundKnowledge",
      "instance_name": "Holocaust",
      "label": "The Holocaust",
      "description": "The systematic, state-sponsored persecution and murder of six million Jews by Nazi Germany and its collaborators during World War II. This historical event is central to understanding the trauma depicted in the image and the gravity of the survivors' suffering. The meme's intent to trivialize this genocide by colorizing the image and misrepresenting the liberation context is a form of Holocaust minimization, which is a well-documented antisemitic trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_488ce1cb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f78d9c32",
      "@type": "BackgroundKnowledge",
      "instance_name": "Auschwitz",
      "label": "Auschwitz concentration camp",
      "description": "A network of Nazi concentration and extermination camps located in occupied Poland. Auschwitz-Birkenau was the largest and most infamous of these camps, where over 1.1 million people, mostly Jews, were murdered. The image depicts survivors from this site, making the location a critical background element for understanding the historical context and the horror of the event.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_488ce1cb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9fc4950f",
      "@type": "BackgroundKnowledge",
      "instance_name": "Soviet_Red_Army",
      "label": "Soviet Red Army",
      "description": "The army of the Soviet Union during World War II. The Soviet forces liberated Auschwitz in January 1945. The text overlay misattributes the liberation to 'the ussr' (which is factually correct) but frames it in a misleading or trivializing way, which is part of the meme's hateful intent. This historical fact is necessary to understand the inaccuracy and potential insensitivity of the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_488ce1cb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_905cc180",
      "@type": "BackgroundKnowledge",
      "instance_name": "Holocaust_Minimization",
      "label": "Holocaust Minimization",
      "description": "A form of antisemitic propaganda that downplays or trivializes the Holocaust, often by reducing the suffering of Jewish victims to a subject for aesthetic manipulation, such as colorization, or by presenting it as a historical curiosity rather than a genocide. This concept is central to understanding the meme's hateful intent, as it seeks to normalize or commodify trauma by presenting the image as a 'colorized' novelty.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_488ce1cb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8a3f897e",
      "@type": "BackgroundKnowledge",
      "instance_name": "Colorization_of_Historical_Photographs",
      "label": "Colorization of Historical Photographs",
      "description": "The practice of adding color to black-and-white historical photographs. While sometimes used for educational or aesthetic purposes, in this context, it is used to trivialize the trauma of Holocaust survivors by reducing their suffering to a visual novelty. This concept is necessary to understand the meme's intent to mock or minimize the gravity of genocide.",
      "belongsToAnalysis": {
