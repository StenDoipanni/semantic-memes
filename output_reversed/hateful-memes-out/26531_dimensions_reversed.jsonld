    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_25ac9644",
      "@type": "BackgroundKnowledge",
      "instance_name": "holocaust_minimization_theme",
      "label": "Holocaust Minimization Theme",
      "description": "The meme's text 'millions of kills, 1 death' is a deliberate and vulgar attempt to trivialize the Holocaust and the genocide of millions of Jews and other groups by Adolf Hitler. This is a form of Holocaust denial or minimization, which is a well-documented antisemitic trope that seeks to downplay or dismiss the scale and horror of the genocide. The meme uses this theme to mock Hitler's perceived lack of personal risk, thereby minimizing his moral responsibility.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d90802c2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cd86623a",
      "@type": "BackgroundKnowledge",
      "instance_name": "adolf_hitler",
      "label": "Adolf Hitler",
      "description": "The central figure in the image, Adolf Hitler was the dictator of Nazi Germany from 1933 until his death in 1945. He was the primary architect of the Holocaust, which resulted in the systematic murder of approximately 6 million Jews, along with millions of others including Roma, disabled people, Poles, and Soviet prisoners of war. His image is globally recognized and carries immense historical weight, making the meme's use of it deeply offensive and hateful.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d90802c2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_57313770",
      "@type": "BackgroundKnowledge",
      "instance_name": "nazi_germany",
      "label": "Nazi Germany",
      "description": "The state governed by the Nazi Party under Adolf Hitler from 1933 to 1945. It was responsible for the Holocaust, World War II, and the systematic persecution and murder of millions. The swastika armband visible on Hitler's uniform is the official symbol of the Nazi Party and is globally recognized as a symbol of genocide and fascism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d90802c2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8fb88648",
      "@type": "BackgroundKnowledge",
      "instance_name": "vulgar_language",
      "label": "Vulgar Language",
      "description": "The phrase 'what a fucking camper' uses crude, offensive language to mock Hitler. The term 'camper' is used in a derogatory way to imply he is a coward or someone who avoids direct confrontation. This type of language is used to dehumanize and trivialize the subject, which is a common tactic in hate speech and antisemitic memes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d90802c2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_27af13b3",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitic_stereotype",
      "label": "Antisemitic Stereotype",
      "description": "The meme relies on antisemitic tropes by portraying Hitler as a 'camper'—a coward who avoids direct involvement in the atrocities he ordered. This is a form of antisemitic stereotype that attempts to minimize his responsibility by suggesting he is not a direct perpetrator, thereby trivializing the Holocaust and the suffering of its victims.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d90802c2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
