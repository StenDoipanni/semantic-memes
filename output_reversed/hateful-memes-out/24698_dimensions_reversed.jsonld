    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3070fe66",
      "@type": "BackgroundKnowledge",
      "instance_name": "relatable_meme_culture",
      "label": "Relatable meme culture",
      "description": "The meme format relies on shared, universal experiences to create humor and empathy. The concept of 'relatability' is central to internet meme culture, where people share images and text to express common frustrations or experiences in a humorous way. This meme taps into the widespread experience of onion-induced tears.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_79da4a7c"
