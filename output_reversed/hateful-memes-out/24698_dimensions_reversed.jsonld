    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_96c5c736",
      "@type": "EmotionExpression",
      "instance_name": "discomfort",
      "label": "discomfort expression",
      "description": "The person is making a facial expression of discomfort or distress, with hands framing their eyes, visually representing the physical irritation caused by chopping onions. This exaggerated expression is meant to humorously convey the universally relatable experience of onion-induced tears.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_79da4a7c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e939b6f6",
      "@type": "AnalogicalMapping",
      "instance_name": "onion_chopping_discomfort_mapping",
      "label": "The person's discomfort is mapped onto the act of chopping onions",
      "description": "The visual of the person making a face of discomfort with hands framing their eyes is mapped onto the textual description 'when you chop onions'. This creates an analogical mapping where the person's physical reaction (discomfort) is understood as a direct consequence of the mundane kitchen task (chopping onions). The mapping is based on the universal biological phenomenon of onion-induced eye irritation, which makes the visual expression relatable and humorous in the context of the text. The person in the image serves as a visual proxy for anyone experiencing this common, irritating situation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_79da4a7c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b06b107a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the person experiencing discomfort",
      "description": "The user is projected onto the visual material of the person making a face of discomfort with hands framing their eyes, as this visual serves as a proxy for the user's own experience of chopping onions. The meme implicitly invites the viewer to identify with the person's reaction, creating a shared, relatable experience. There are no explicit deictic pronouns like 'me' or 'you', but the universal nature of the experience and the exaggerated expression create an implicit 'you' projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_79da4a7c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
