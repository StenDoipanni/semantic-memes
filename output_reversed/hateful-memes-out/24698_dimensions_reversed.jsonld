      "@type": "BackgroundKnowledge",
      "instance_name": "exaggerated_facial_expression",
      "label": "Exaggerated facial expression",
      "description": "The person's facial expression and hand gesture are exaggerated to visually represent extreme discomfort. This is a common technique in memes and comedy to amplify the emotional response and make the humor more obvious and impactful.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_79da4a7c"
