    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_65ff7104",
      "@type": "BackgroundKnowledge",
      "instance_name": "onion_induced_eye_irritation",
      "label": "Onion-induced eye irritation",
      "description": "The physical reaction of tearing up or watering the eyes when chopping onions is caused by sulfur compounds released into the air. These compounds react with moisture in the eyes to form sulfuric acid, causing irritation. This is a real-world biological phenomenon that is universally experienced by many people, making the meme relatable and humorous.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_79da4a7c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d0bf754f",
      "@type": "BackgroundKnowledge",
      "instance_name": "common_kitchen_task",
      "label": "Common kitchen task",
      "description": "Chopping onions is a fundamental and frequently performed task in home cooking and food preparation. It is a mundane, everyday activity that many people engage in, making the meme's depiction of discomfort relatable to a broad audience.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_79da4a7c"
