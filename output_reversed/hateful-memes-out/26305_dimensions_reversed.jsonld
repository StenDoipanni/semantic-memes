    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9ca8d406",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_stereotype",
      "label": "Misogynous Stereotype",
      "description": "The meme relies on the stereotype that women are overly talkative and should be quiet or restrained in social settings, particularly in dating contexts. This stereotype is often used to mock or diminish women's agency and social value, reinforcing gendered expectations that women 'belong in the kitchen' rather than in public or social spheres. The text 'when you take this girl on a date and she won't stop talking..' directly invokes this trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e870af8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_195e2157",
      "@type": "BackgroundKnowledge",
      "instance_name": "women_belongs_in_kitchen",
      "label": "Women Belongs in Kitchen",
      "description": "This is a historical and cultural stereotype that positions women primarily as domestic figures, confined to the home and kitchen, and implies that their social or public roles are limited or inappropriate. The meme uses the visual of the woman cooking to reinforce this stereotype, suggesting that her talkativeness is an undesirable trait in a dating context, which is a form of gendered social judgment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e870af8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c552d01b",
      "@type": "BackgroundKnowledge",
      "instance_name": "talkative_women_stereotype",
      "label": "Talkative Women Stereotype",
      "description": "This stereotype portrays women as emotionally unstable, 'crazy,' or 'hysterical' when they express themselves or speak freely, especially in social or dating contexts. The meme text 'she won't stop talking..' directly references this stereotype, implying that a woman's talkativeness is a negative trait that makes her an undesirable date.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e870af8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1e518008",
      "@type": "BackgroundKnowledge",
      "instance_name": "dating_context",
      "label": "Dating Context",
      "description": "The meme is set within the social context of dating, where expectations of behavior (such as being quiet, reserved, or non-dominant) are often imposed on women. The text 'when you take this girl on a date...' explicitly references this context, implying that the woman's talkativeness is a flaw in a social setting where silence or restraint is often expected.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e870af8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_abce7849",
      "@type": "EmotionExpression",
      "instance_name": "frustration",
      "label": "frustrated emotion",
      "description": "The man's posture and partial facial expression (visible side profile and tense shoulders) suggest he is overwhelmed or annoyed by the woman's constant talking, as implied by the meme text. His body language indicates passive resistance or discomfort with the situation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e870af8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ba665e84",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The woman is mapped as 'this girl' in the dating context",
      "description": "The text 'when you take this girl on a date...' explicitly refers to the woman in the image as 'this girl'. The visual material of the woman (engaged in cooking, smiling, and implied to be talkative) is mapped onto the textual entity 'this girl' to create the analogy that she is the subject of the dating scenario described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e870af8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c8b715df",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the dating scenario and the woman as 'this girl'",
      "description": "The user is projected onto the implied perspective of a male date who is experiencing the situation described in the text. The user identifies with the narrator of the meme, who is observing the woman's talkativeness during a date. The projection is onto the textual material ('when you take this girl on a date...') and the visual material (the woman, who is mapped as 'this girl'), creating an identification with the male subject of the scenario. The user is not directly projected onto the woman herself, but onto the role of the observer/experiencer of her behavior in the dating context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e870af8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8f45de14",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Mysogynous",
      "description": "The meme perpetuates harmful stereotypes about women by portraying talkativeness as an undesirable trait in a dating context, implying that women should be quiet or restrained, and reinforcing the outdated notion that women 'belong in the kitchen'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e870af8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a2494bd9",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who are familiar with and may find humor in misogynous stereotypes, particularly those that portray women as overly talkative and undesirably dominant in social or dating contexts. The meme appeals to an audience that accepts or enjoys reinforcing gendered expectations, such as the notion that women 'belong in the kitchen' and should be quiet or restrained in public or social settings. The humor is derived from the contrast between the woman’s active, engaged, and seemingly pleasant behavior (chopping food, smiling) and the negative judgment implied by the text, which targets those who subscribe to traditional gender roles and view talkativeness in women as a flaw. The audience is likely to include people who identify with or mock these stereotypes, often found in online communities that engage in gendered humor or share content that reinforces outdated social norms.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e870af8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
