    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_22111861",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "corpses on Mt. Everest are mapped as once highly motivated people",
      "description": "The top text 'think about it: every single corpse on mt. everest was once a highly motivated person' maps the visual entity 'Mount_Everest' (specifically, the corpses on it) to the conceptual entity 'highly motivated person'. The mountain, as the visual anchor, represents the location where these deceased individuals (the corpses) once were, and the text explicitly states they were once 'highly motivated'. This creates an analogical mapping where the visual material (the mountain with corpses) is understood through the lens of the textual description (they were once highly motivated).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0543c7b9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_678230f6",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the ironic advice text",
      "description": "The user is projected onto the textual material 'stay lazy, my friends.' through the ironic framing of the meme. The text directly addresses the viewer with a command ('stay lazy') and uses 'my friends' to include the audience, creating a direct address. This projection invites the user to identify with the implied audience of the ironic message, encouraging them to internalize the meme's sarcastic conclusion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0543c7b9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
