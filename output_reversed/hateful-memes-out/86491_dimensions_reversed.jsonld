    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_45e19386",
      "@type": "BackgroundKnowledge",
      "instance_name": "mental_deficient_slur",
      "label": "Mental Deficient Slur",
      "description": "A derogatory term used to demean individuals perceived as having low mental capacity or intellectual disability. It is a form of ableism that dehumanizes and stigmatizes people with cognitive impairments or those perceived as incompetent. This slur is often used to justify exclusion, discrimination, or violence against individuals with disabilities or those who are perceived as 'not smart enough'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6a41fc70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7d20ece2",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism",
      "label": "Ableism",
      "description": "Discrimination or prejudice against individuals with disabilities, often rooted in the belief that people with disabilities are less capable, less valuable, or a burden. Ableism manifests in social, cultural, and institutional contexts and includes the use of slurs, exclusion, and dehumanizing language like 'mental deficient'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6a41fc70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_feca85a7",
      "@type": "BackgroundKnowledge",
      "instance_name": "cigarette_as_metaphor",
      "label": "Cigarette as Metaphor for Disposal/Rejection",
      "description": "The act of crushing a cigarette is a common visual metaphor for discarding something unwanted, undesirable, or harmful. In this meme, the cigarette represents the person being targeted, implying they are being treated as trash or something to be destroyed. This metaphor relies on cultural understanding of cigarettes as symbols of vice, addiction, or low value.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6a41fc70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f22a908e",
      "@type": "BackgroundKnowledge",
      "instance_name": "dehumanizing_language",
      "label": "Dehumanizing Language",
      "description": "Language that strips a person of their humanity, dignity, or moral worth. Phrases like 'you are not wanted' and 'you are a mental deficient' are dehumanizing because they reduce a person to an object or a label, denying their inherent value and agency. This is a common tactic in abusive and hateful rhetoric.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6a41fc70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8debf65f",
      "@type": "BackgroundKnowledge",
      "instance_name": "abusive_meme_tropes",
      "label": "Abusive Meme Tropes",
      "description": "A category of internet memes that use violent imagery, degrading text, or harmful stereotypes to attack, shame, or demean a target. These memes often rely on shock value and emotional manipulation to provoke a reaction. The combination of crushing imagery and insulting text is a classic abusive trope used to inflict psychological harm.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6a41fc70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_30b07bbb",
      "@type": "EmotionExpression",
      "instance_name": "hatred",
      "label": "hateful emotion",
      "description": "The emotion of hatred is expressed through the violent act of crushing a cigarette and the explicit, dehumanizing text overlay that labels the target as 'not wanted' and 'a mental deficient'. This combination conveys intense hostility, contempt, and a desire to demean and destroy the target.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6a41fc70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1d88a1bc",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The person being targeted is mapped onto the cigarette being crushed.",
      "description": "The text 'you are not wanted!' and 'you are a mental deficient!' explicitly labels the target of the meme. The visual material of the hand crushing a cigarette serves as a metaphor for rejection and devaluation. The analogical mapping is that the cigarette (a visual entity) is being treated as the 'you' being targeted by the text — the cigarette is the object being destroyed, symbolizing the person being dehumanized and discarded. This mapping is reinforced by the metaphor 'cigarette as metaphor for disposal/rejection' and the dehumanizing language used in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6a41fc70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c5b8a8e0",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the cigarette being crushed",
      "description": "The user is projected onto the cigarette being crushed, as the text explicitly addresses 'you' ('you are not wanted!', 'you are a mental deficient!'). The visual of the hand crushing the cigarette serves as a metaphor for the user being targeted and devalued. The projection is reinforced by the direct address in the text, which maps the user onto the cigarette as the object of rejection and dehumanization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6a41fc70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d17f03af",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Abusive",
      "description": "The meme uses violent imagery (crushing a cigarette) and explicit derogatory text ('you are not wanted!', 'you are a mental deficient!') to directly threaten, demean, and psychologically attack the viewer or a specific target group. The intent is to inflict emotional harm and reinforce negative stereotypes about mental disability or incompetence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6a41fc70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5ebe5b4e",
      "@type": "TargetCommunity",
      "instance_name": "person",
      "label": "individual targeted by dehumanizing language",
      "description": "The meme targets any individual perceived as having low mental capacity or intellectual disability, using the slur 'mental deficient' and the metaphor of crushing a cigarette to dehumanize and reject them. The target is defined by the slur and the visual metaphor, not by any specific demographic or cultural group, but rather by the stereotype of being 'mentally deficient'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6a41fc70"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
