    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_244ec5ca",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_asian_racism_stereotype",
      "label": "Anti-Asian Racism Stereotype: Driving Ability Mockery",
      "description": "This stereotype implies that Asian drivers are inherently dangerous or reckless, to the point of being memorialized after fatal accidents. It weaponizes the 'model minority' myth by mocking their perceived driving abilities, portraying them as a threat to public safety. This is a form of anti-Asian racism that contributes to prejudice and discrimination against Asian communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c457936b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_393baa62",
      "@type": "BackgroundKnowledge",
      "instance_name": "model_minority_myth",
      "label": "Model Minority Myth",
      "description": "A stereotype that portrays certain minority groups, particularly Asian Americans, as universally successful, hardworking, and academically or professionally superior. This myth is often weaponized to justify discrimination or to mock other groups by contrasting them unfavorably with this idealized image. In this meme, it is used to mock Asian drivers by implying they are so dangerous that they must be memorialized, which is a distortion of the myth.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c457936b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_798b0bf1",
      "@type": "BackgroundKnowledge",
      "instance_name": "memorial_cross",
      "label": "Memorial Cross",
      "description": "A cross used as a symbol of remembrance or burial, often associated with Christian funerary practices. In this context, the cross is used to imply a fatal accident involving a driver, which is then juxtaposed with the text to create a harmful stereotype. The presence of flowers and a rosary reinforces the memorial context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c457936b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_86e063b5",
      "@type": "BackgroundKnowledge",
      "instance_name": "car_in_background",
      "label": "Car in Background",
      "description": "The car in the background is not just a vehicle but symbolizes the driver who is the subject of the stereotype. The juxtaposition of the car with the memorial cross implies that the driver died in a crash, and the text 'a good asian driver' suggests that the driver was so dangerous that they needed to be memorialized. This requires understanding of the cultural trope of associating cars with drivers and accidents.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c457936b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c84ddff5",
      "@type": "EmotionExpression",
      "instance_name": "hatefulness",
      "label": "hateful emotion expression",
      "description": "The image and text together convey a hateful sentiment by mocking Asian drivers through the stereotype that they are so dangerous they must be memorialized after fatal accidents. This is a form of anti-Asian racism that weaponizes the 'model minority' myth to perpetuate prejudice and discrimination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c457936b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_87eef701",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "a good asian driver is mapped onto the memorial cross",
      "description": "The text 'a good asian driver' is juxtaposed with the visual of a wooden cross, which symbolizes a memorial or grave. This creates an analogical mapping where the textual entity 'a good asian driver' is projected onto the visual entity 'wooden_cross', implying that the driver (represented by the cross) is being memorialized due to their driving. This mapping is part of a harmful stereotype that weaponizes the 'model minority' myth by mocking Asian drivers' perceived driving abilities, portraying them as dangerous enough to require a memorial.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c457936b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_70f2cf3c",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the text 'a good asian driver' as the central subject of the meme's harmful stereotype. The text directly addresses the viewer by implying the user is part of the group being stereotyped or is being asked to internalize the stereotype. There are no explicit deictic pronouns like 'me' or 'you' in the text, but the meme's overall intent and framing create an implicit projection where the user is positioned as the target of the stereotype or as the one who might perpetuate or understand the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c457936b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
