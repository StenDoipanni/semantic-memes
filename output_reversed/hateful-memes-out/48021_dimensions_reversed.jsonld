    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_62e43ee2",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_kill_them_queen",
      "label": "Hostility mapped onto Queen Elizabeth II",
      "description": "The text 'kill them' is superimposed over the image of Queen Elizabeth II, creating an analogical mapping where the violent command is projected onto her as the target. This mapping is abusive, as it associates the revered monarch with extreme violence, using her visual presence to embody the hostile sentiment expressed in the text. The mapping is reinforced by the juxtaposition of her dignified appearance with the aggressive text, creating a jarring contrast that intensifies the meme's provocative intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bee0749c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6515e046",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the abusive textual overlay",
      "description": "The user is projected onto the textual material 'kill them' and 'kill them all !!!!!', as the meme's intent is to provoke a reaction by associating the user's implied hostility or anger with the visual of Queen Elizabeth II. There are no explicit deictic pronouns like 'me' or 'you', but the meme's structure implies the user is the one expressing the violent sentiment through the text. The projection is onto the textual material, which serves as the vehicle for the abusive intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bee0749c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
