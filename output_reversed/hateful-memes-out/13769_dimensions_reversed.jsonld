    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5aa7331d",
      "@type": "BackgroundKnowledge",
      "instance_name": "procrastination",
      "label": "Procrastination",
      "description": "The concept of delaying tasks or goals despite knowing they should be done sooner. This is central to the meme's humor, as the text describes goals that were planned, promised, and should have been completed years earlier but were not. The child’s determined expression is used ironically to contrast the actual failure to act.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0847f1f1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_67e826b5",
      "@type": "BackgroundKnowledge",
      "instance_name": "time_management",
      "label": "Time Management",
      "description": "The practice of organizing and planning how to allocate time effectively to accomplish tasks. The meme humorously highlights a failure in time management by referencing multiple years (2013, 2014, 2016, 2017, 2018) and the misalignment between planning, promising, and actual execution.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0847f1f1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3871eec8",
      "@type": "BackgroundKnowledge",
      "instance_name": "self_deprecating_humor",
      "label": "Self-Deprecating Humor",
      "description": "A comedic technique where a person makes fun of themselves or their own shortcomings. The meme uses this to mock the absurdity of delayed goal achievement, making the viewer relate to the common experience of procrastination and poor follow-through.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0847f1f1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_51de1566",
      "@type": "BackgroundKnowledge",
      "instance_name": "ironic_juxtaposition",
      "label": "Ironic Juxtaposition",
      "description": "A rhetorical device where two contrasting ideas are placed together to create humor or emphasize a point. Here, the image of a determined child (symbolizing resolve) is juxtaposed with the text describing failure to act, creating irony and highlighting the absurdity of the situation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0847f1f1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2fdac321",
      "@type": "BackgroundKnowledge",
      "instance_name": "personal_responsibility",
      "label": "Personal Responsibility",
      "description": "The idea that individuals are accountable for their own actions and decisions. The meme implicitly references this concept by pointing out that the speaker promised and planned goals, implying a moral or practical obligation to follow through, which was not met.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0847f1f1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4d3c5d9b",
      "@type": "BackgroundKnowledge",
      "instance_name": "goal_setting",
      "label": "Goal Setting",
      "description": "The process of defining specific, measurable, achievable, relevant, and time-bound (SMART) objectives. The meme references this by mentioning goals that were 'planned' and 'promised' in different years, highlighting the failure to achieve them despite initial planning.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0847f1f1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bae8f302",
      "@type": "BackgroundKnowledge",
      "instance_name": "yearly_planning",
      "label": "Yearly Planning",
      "description": "The practice of setting goals and plans for each year, often in the context of personal development or productivity. The meme references specific years (2013, 2014, 2016, 2017, 2018) to emphasize the long-term nature of the procrastination and the repeated failure to execute plans over multiple years.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0847f1f1"
      },
