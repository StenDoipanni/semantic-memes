    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d70ebebb",
      "@type": "BackgroundKnowledge",
      "instance_name": "infantilization_stereotype",
      "label": "Infantilization Stereotype",
      "description": "The meme uses the metaphor of 'squeaky toy sounds' to infantilize and dehumanize the subjects, reducing them to the level of toys. This is a form of objectification and degradation that relies on the real-world stereotype of infantilizing individuals, particularly those perceived as less competent or mature, by comparing them to children's toys. This stereotype is often used to demean and belittle people, especially in contexts of power imbalance or social marginalization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b2c6d785"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6a2c7b79",
      "@type": "BackgroundKnowledge",
      "instance_name": "sexual_objectification_stereotype",
      "label": "Sexual Objectification Stereotype",
      "description": "The text 'when they fuck' explicitly sexualizes the subjects, reducing them to their sexual function and ignoring their humanity. This relies on the real-world stereotype of sexual objectification, which involves treating people as objects for sexual gratification rather than as individuals with agency, dignity, and autonomy. The combination of infantilization and sexual objectification is a particularly degrading form of stereotyping.",
      "belongsToAnalysis": {
