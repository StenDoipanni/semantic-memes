      "@type": "BackgroundKnowledge",
      "instance_name": "racist_metaphor_of_samehood",
      "label": "Racist Metaphor: 'Black and White Children Are the Same'",
      "description": "A degrading and harmful racial stereotype that implies Black children are indistinguishable from white children in a way that trivializes racial differences and reduces Black humanity to a superficial or animalistic level. This metaphor is used to downplay systemic racism and racial injustice.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_47bb6560"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
