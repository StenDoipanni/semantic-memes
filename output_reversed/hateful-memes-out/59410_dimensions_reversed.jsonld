    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9ebda5b9",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "monkey is mapped as 'black children' in the racist metaphor",
      "description": "The visual entity 'monkey' is mapped onto the textual entity 'black children' through the meme's racist metaphor. The monkey, positioned at the top with the text 'stop racism', is juxtaposed with the baby and the text 'black children and white children are the same', creating an analogical mapping where the monkey visually represents Black children in a dehumanizing way. This mapping is part of the anti-Black stereotype of comparing Black people to primates.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_47bb6560"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2850b975",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the racist metaphor scene",
      "description": "The user is projected onto the overall racist metaphor scene, which uses the visual of a monkey juxtaposed with text to imply dehumanization of Black children and trivialize racism. The scene as a whole functions as the target of the user's interpretation and emotional response, even though no explicit deictic pronoun like 'you' or 'me' is present. The projection is implicit through the meme's structure and the user's engagement with its harmful message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_47bb6560"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
