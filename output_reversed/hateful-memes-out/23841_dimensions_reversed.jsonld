    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5b0342d8",
      "@type": "BackgroundKnowledge",
      "instance_name": "the_squad",
      "label": "The Squad",
      "description": "A group of four progressive U.S. politicians — Alexandria Ocasio-Cortez, Rashida Tlaib, Ilhan Omar, and Ayanna Pressley — known for their collective advocacy on issues like climate change, racial justice, and economic inequality. The term 'The Squad' is a media and political label used to describe their unified stance and public presence. The meme references this real-world political group, which is not visible in the image but is essential to understanding the context of the text overlay.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0af0fd05"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0af197fb",
      "@type": "BackgroundKnowledge",
      "instance_name": "gang_of_four",
      "label": "The Gang of Four",
      "description": "A pejorative rebranding used in the meme to replace 'The Squad' with 'the gang of four.' The term 'gang' carries negative connotations implying informality, criminality, or illegitimacy, which is used sarcastically to diminish the political stature of the group. This is a rhetorical device that relies on real-world understanding of how language can be weaponized to delegitimize political actors.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0af0fd05"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bb0283fc",
      "@type": "BackgroundKnowledge",
      "instance_name": "pejorative_language",
      "label": "Pejorative Language",
      "description": "The use of derogatory or dismissive language to undermine the legitimacy or seriousness of a group or individual. In this meme, 'gang' is a pejorative term that contrasts with the formal, collective identity implied by 'squad.' This linguistic strategy is a common tactic in political discourse and media to delegitimize opponents or groups perceived as threatening to the status quo.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0af0fd05"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c35b4312",
      "@type": "BackgroundKnowledge",
      "instance_name": "political_delegitimization",
      "label": "Political Delegitimization",
      "description": "A rhetorical strategy used to undermine the credibility, authority, or legitimacy of a political group or individual. The meme's intent to rebrand 'The Squad' as 'the gang of four' is an example of this, aiming to reduce their political impact by associating them with a term that carries negative social and political connotations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0af0fd05"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_08e37b45",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_culture",
      "label": "Meme Culture",
      "description": "The broader cultural phenomenon of internet memes, which often use humor, irony, or satire to comment on current events, social issues, or political figures. This meme is part of a larger trend of using visual and textual juxtaposition to critique or mock political groups, relying on shared cultural knowledge of internet discourse and political satire.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0af0fd05"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_74dce45e",
      "@type": "EmotionExpression",
      "instance_name": "sarcastic_dismissiveness",
      "label": "sarcastic dismissiveness",
      "description": "The emotional expression conveyed through the overlaid text and the women's collective demeanor is one of sarcastic dismissal. The text 'more like \"the gang of four!\"' sarcastically rebrands 'The Squad' with a pejorative term, implying a mocking or condescending attitude toward their political identity. The women's neutral to slightly smirking expressions reinforce this tone, suggesting they are unimpressed or amused by the label being imposed on them.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0af0fd05"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3deb08f9",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The Squad is mapped to the Gang of Four",
      "description": "The textual element 'the squad?' is juxtaposed with the visual material of the four women, implying that the group of women visually represented is being referred to as 'The Squad'. The subsequent text 'more like \"the gang of four!\"' rebrands the same visual group with a pejorative term, creating an analogical mapping where the visual group (the four women) is mapped onto the textual concept 'the gang of four'. This mapping is central to the meme's intent to delegitimize the political group by rebranding it with a dismissive label.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0af0fd05"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6d90d2a7",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual rebranding of the group",
      "description": "The user is projected onto the textual material that sarcastically rebrands 'The Squad' as 'the gang of four,' implying the user is adopting or identifying with this dismissive rebranding. This projection is not explicit with deictic pronouns like 'you' or 'me,' but is implied through the rhetorical framing of the meme, where the user is expected to understand and engage with the pejorative rebranding as a form of commentary or identification.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0af0fd05"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fa643fb7",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme uses pejorative language to rebrand 'The Squad' as 'the gang of four,' which carries negative connotations implying informality, criminality, or illegitimacy. This rebranding aims to delegitimize the political stature of the group, potentially contributing to public ridicule or marginalization, thus having the potential to cause harm to the individuals depicted and their political impact.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0af0fd05"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6eca757c",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience for this meme is individuals familiar with U.S. political discourse, particularly those who follow or are aware of 'The Squad' — a group of progressive politicians. The meme relies on cultural knowledge of this specific political group and the pejorative rebranding of 'The Squad' as 'the gang of four,' which implies a dismissive or mocking attitude toward their political influence. The intended audience likely includes internet users engaged in meme culture, political satire, or online commentary who understand the rhetorical strategy of using pejorative language to delegitimize political actors. The meme is designed to resonate with those who may hold or be exposed to conservative or right-leaning political viewpoints that seek to undermine progressive political figures through humor or sarcasm.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0af0fd05"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
