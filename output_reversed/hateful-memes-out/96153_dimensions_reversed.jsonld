      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d8d17f3b",
      "@type": "VisualMaterial",
      "instance_name": "mosquito",
      "label": "insect",
      "description": "A close-up of a mosquito, likely a female, perched on human skin. It is shown in the act of biting, with its proboscis inserted into the skin. The mosquito has a dark, segmented body, long slender legs, and transparent wings. Its presence is the central visual element and serves as the metaphorical 'killer' in the meme's text.",
      "belongsToAnalysis": {
