    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b7fc8459",
      "@type": "BackgroundKnowledge",
      "instance_name": "Holocaust_Denial_Minimization_Themes",
      "label": "Holocaust Denial/Minimization Themes",
      "description": "The dangerous and false belief that the Holocaust did not happen or was exaggerated. The meme's framing of the historical event as a 'lesson' rather than a warning risks minimizing the gravity of the Holocaust, which is a form of historical minimization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_549db075"
