    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_21ea61e8",
      "@type": "BackgroundKnowledge",
      "instance_name": "Holocaust",
      "label": "Holocaust",
      "description": "The systematic, state-sponsored persecution and murder of six million Jews by Nazi Germany and its collaborators during World War II. The text 'we destroy the world and kill a lot of people' implicitly refers to the Holocaust as a primary example of the atrocities committed by the Nazi regime.",
