    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_31c610b8",
      "@type": "BackgroundKnowledge",
      "instance_name": "Genocide",
      "label": "Genocide",
      "description": "The deliberate and systematic destruction of a racial, political, or cultural group. The phrase 'kill a lot of people' in the text refers to the genocide of Jews, Roma, disabled people, and other groups by the Nazi regime.",
