    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e5a5e9da",
      "@type": "BackgroundKnowledge",
      "instance_name": "Nazi_Propaganda",
      "label": "Nazi Propaganda",
      "description": "The systematic use of media and public events to promote Nazi ideology and dehumanize targeted groups. The formal assembly in the image is a visual representation of Nazi propaganda tactics, used to legitimize and disseminate their ideology.",
      "belongsToAnalysis": {
