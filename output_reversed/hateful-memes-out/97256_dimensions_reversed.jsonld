    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_da9f55b4",
      "@type": "EmotionExpression",
      "instance_name": "moral_concern",
      "label": "moral concern expressed through text",
      "description": "The text 'know the history and learn from it' conveys a sense of moral responsibility and caution, urging viewers to reflect on historical atrocities to prevent future harm. This emotion is derived from the educational and cautionary tone of the message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_549db075"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6be4a7ba",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'we destroy the world and kill a lot of people' is mapped onto the Nazi Party assembly.",
      "description": "The textual statement 'we destroy the world and kill a lot of people' is directly projected onto the visual entity of the formal assembly in Nazi Germany. The assembly, composed of individuals in uniform and formal attire seated in rows under swastika banners, is presented as the embodiment of the 'we' in the text. The visual material represents the collective entity (the Nazi Party leadership and members) that is being described by the text as having committed global destruction and mass killings. This is an analogical mapping where the group of people in the image is mapped as the subject performing the actions described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_549db075"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_187bc117",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the formal assembly scene as the perpetrator of historical atrocities",
      "description": "The user is implicitly projected onto the visual material of the formal assembly (scene_1) and the textual material ('we destroy the world and kill a lot of people.'), which collectively represent the Nazi Party leadership and members. The text uses 'we' to directly attribute the actions of destruction and mass killing to the group depicted in the image. This creates a semiotic projection where the viewer (user) is positioned as part of or identified with the collective entity shown, thereby internalizing the historical responsibility implied by the text. The user is not explicitly addressed with 'you' or 'me', but the first-person plural 'we' in the text creates a direct projection of the user onto the historical actors depicted.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_549db075"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_987c6fb9",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme risks reducing complex historical trauma into a simplistic moralizing statement, which can be dangerous if it encourages viewers to view such atrocities as mere 'history' to be learned from, rather than as ongoing threats to be vigilantly resisted. The framing may inadvertently downplay the gravity of the historical event or normalize its depiction for educational purposes without sufficient context or sensitivity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_549db075"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_816b8b52",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "General Public",
      "description": "The meme is designed for a broad audience with general knowledge of history, particularly those familiar with World War II and the Holocaust. The visual and textual elements are intended to evoke a moral response from viewers who recognize the historical context, prompting them to reflect on the consequences of hatred and violence. The message is framed as a cautionary tale, targeting individuals who are expected to have a baseline understanding of Nazi atrocities and their global impact.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_549db075"
      },
