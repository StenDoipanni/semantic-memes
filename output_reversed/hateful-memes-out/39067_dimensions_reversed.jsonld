    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cd32b3c3",
      "@type": "EmotionExpression",
      "instance_name": "mocking_happiness",
      "label": "mocking happiness expression",
      "description": "The man's broad, toothy smile and crinkled eyes convey a sense of amusement or joy, but in this context, it is juxtaposed with hateful text to create a mocking or sarcastic effect. The expression is not genuine happiness but rather a performative or ironic smile that amplifies the cruelty of the overlaid message.",
      "belongsToAnalysis": {
