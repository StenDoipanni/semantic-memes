    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fc12aafe",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'you' is mapped onto the Black man in the image",
      "description": "The hateful text 'So, you think by being a muslim sympathizer...' directly addresses an individual, and by juxtaposition, this 'you' is visually mapped onto the Black man depicted in the image. The man's cheerful expression is used to mock the person being addressed, implying that the target of the insult is the man himself. This is a classic analogical mapping where the textual referent 'you' is instantiated by the visual entity 'man'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed5f7c66"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_246ad7bf",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the Black man in the image",
      "description": "The text in the meme directly addresses 'you', which is semiotically projected onto the visual entity of the Black man. The user is positioned as the target of the hateful message, and the man's cheerful expression is used to mock the user's perceived foolishness. This projection is explicit through the deictic pronoun 'you' in the text, which is instantiated by the visual material of the man.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed5f7c66"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7842c498",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Abusive",
      "description": "The text directly threatens and abuses the target by implying violence ('killing you') and using degrading language ('special kind of stupid'), targeting both religious affiliation and race.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed5f7c66"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ea8492df",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The intended audience is individuals who hold or are perceived to hold Muslim sympathies, as the meme directly addresses them with the text 'you think by being a muslim sympathizer...'. The meme is designed to provoke and insult this group by implying they are foolish for thinking their sympathies will protect them from violence, thereby targeting those who identify with or support Muslim communities. The racialized nature of the insult ('you are a special kind of stupid') also suggests the meme is aimed at audiences who are either anti-Black or who hold racist views, as it uses the Black man's race to amplify the insult. The overall intent is to dehumanize and incite hatred toward Muslim sympathizers, making the target audience those who might be perceived as vulnerable to such rhetoric or who are already part of a hostile discourse toward Muslims.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed5f7c66"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
