    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_de833fc7",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_racism",
      "label": "Anti-Black Racism",
      "description": "The meme targets a Black man with a racially charged insult ('you are a special kind of stupid'), which is a form of anti-Black racism. It uses his race as a basis for dehumanization and mockery, fitting into stereotypes that associate Black people with stupidity or criminality.",
      "belongsToAnalysis": {
