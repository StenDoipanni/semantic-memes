    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b0c38022",
      "@type": "BackgroundKnowledge",
      "instance_name": "jeffrey_dahmer",
      "label": "Jeffrey Dahmer",
      "description": "Jeffrey Dahmer was an American serial killer and cannibal who murdered 17 men and boys between 1978 and 1991. He is one of the most notorious criminals in American history, known for his extreme brutality and the grotesque nature of his crimes. His name is used here as a hyperbolic and inflammatory reference point to imply that the subject (Hillary Clinton) has committed or concealed similarly horrific acts, leveraging his notoriety to amplify the accusation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6733b6d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_424a45d0",
      "@type": "BackgroundKnowledge",
      "instance_name": "skeletons_in_closet",
      "label": "Skeletal Metaphor",
      "description": "The phrase 'skeletons in the closet' is a common idiom meaning hidden secrets, especially embarrassing or criminal ones. It is used here as a grotesque and violent metaphor to imply that the subject has concealed serious, possibly criminal, acts. The use of 'skeletons' evokes imagery of death and horror, intensifying the accusation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6733b6d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_71f5b2a1",
