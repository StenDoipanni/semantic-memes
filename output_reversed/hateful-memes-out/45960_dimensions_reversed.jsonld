    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6e88a597",
      "@type": "AnalogicalMapping",
      "instance_name": "skeletons_in_closet_mapping",
      "label": "Hillary Clinton is mapped as having more skeletons in her closet than Jeffrey Dahmer",
      "description": "The text 'has more skeletons in her closet than jeffrey dahmer' is directly mapped onto Hillary Clinton, who is visually depicted in the image. The mapping implies that Hillary Clinton is the entity possessing the 'skeletons in her closet' — i.e., hidden secrets or crimes — and that the quantity or severity of these is being compared to the extreme criminality of Jeffrey Dahmer. This is an analogical mapping where the textual accusation is projected onto the visual subject, creating a grotesque and inflammatory comparison.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6733b6d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8d40bb86",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual accusation",
      "description": "The user is not explicitly projected onto a specific visual or textual element via deictic pronouns like 'me', 'you', or 'your'. However, the meme's structure inherently projects the user's perspective onto the textual material ('has more skeletons in her closet than jeffrey dahmer') and the visual material (Hillary_Clinton) as the target of the accusation. The user is implicitly positioned as the one interpreting or endorsing the hateful comparison, thereby projecting their own stance onto the scene. The projection is onto the textual material which makes the accusation, and the visual material which embodies the target of that accusation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6733b6d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
