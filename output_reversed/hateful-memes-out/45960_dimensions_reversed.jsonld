    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f9fc7da1",
      "@type": "EmotionExpression",
      "instance_name": "contempt",
      "label": "contemptuous expression",
      "description": "Hillary Clinton's facial expression, characterized by a slight upward tilt of the lips and a gaze directed away, conveys a sense of disdain or contempt. This expression is often interpreted as dismissive or superior, suggesting she is looking down on something or someone. In the context of the meme, this expression is juxtaposed with the hateful text to amplify the inflammatory and degrading tone of the accusation.",
      "belongsToAnalysis": {
