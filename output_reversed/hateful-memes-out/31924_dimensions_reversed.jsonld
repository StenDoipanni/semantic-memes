    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c7afafb2",
      "@type": "VisualMaterial",
      "instance_name": "Harvey_Price",
      "label": "young Black boy",
      "description": "A young Black boy, identified as Harvey Price, is featured prominently in both the top and bottom images. In the top image, he appears as a child in a movie poster, wearing a pink shirt and a black cap. In the bottom image, he is shown as a slightly older child, standing in front of a Burger King, wearing a brown jacket. His presence is central to the meme's message of growth over time.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3f5ce183"
