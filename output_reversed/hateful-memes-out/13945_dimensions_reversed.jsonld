      "instance_name": "circus_performance",
      "label": "Circus Performance Scene",
      "description": "A circus performance is taking place on a circular stage under a tent, with performers executing acrobatic acts. The audience is seated in rows of red chairs, watching the show. The scene is illuminated by stage lights, and text overlays sarcastically invite viewers to 'join us' for attention.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_039808ad"
