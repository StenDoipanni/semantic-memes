    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3fd982f9",
      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_misogyny",
      "label": "Racialized Misogyny",
      "description": "The meme combines racial stereotypes (about Black men) with misogynistic tropes (about women being 'gold diggers' or requiring financial investment) to deliver a moralistic message. This intersection of racism and misogyny is a key element of the meme's harmful intent, as it blames Black men for relationship failures while implicitly devaluing women as financial assets.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_460e5cdf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_70e3c747",
      "@type": "BackgroundKnowledge",
      "instance_name": "moralistic_advice_tropes",
      "label": "Moralistic Advice Tropes",
      "description": "The meme uses a common cultural trope of delivering moralistic advice through a stern, authoritative figure (in this case, a Black man). This trope is often used to frame complex social issues as simple moral failures, which can be harmful when applied to marginalized groups. The use of a Black man as the moral authority reinforces the stereotype that Black men are inherently 'wise' or 'responsible' in a way that is not true for all individuals.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_460e5cdf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3501bc8f",
      "@type": "BackgroundKnowledge",
      "instance_name": "stereotype_of_black_man_as_fool",
      "label": "Stereotype: Black Man as Fool",
      "description": "The meme implicitly relies on the stereotype that Black men are 'fools' or 'simpletons' who are easily led astray by women, particularly in financial matters. This stereotype is used to justify the moralistic warning and to position the Black man as the 'victim' of his own choices, which is a form of racialized victim-blaming.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_460e5cdf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_340d81e0",
