    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ee2df165",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who are exposed to or consume internet memes, particularly those who may be influenced by or resonate with moralistic, racially coded advice. The meme is designed to appeal to a broad online audience, but its harmful stereotypes primarily target and reinforce negative perceptions of Black men, making it especially impactful for communities that may already hold or be exposed to anti-Black stereotypes. The use of a Black man as the moral authority figure ('my brother') and the framing of the message as a warning or life advice suggest the meme is intended for viewers who are open to simplistic moral lessons, potentially including younger audiences or those seeking social commentary. The meme’s racialized misogyny and financial stereotypes also imply it may be consumed by audiences who are familiar with or perpetuate these harmful tropes, often found in online spaces that normalize or amplify racial and gendered stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_460e5cdf"
      },
      "extractionMethod": "llm_extraction_huggingface"
