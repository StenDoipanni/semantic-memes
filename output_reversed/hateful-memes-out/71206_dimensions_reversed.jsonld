    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ed4086f3",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The man is mapped as 'my brother' delivering moral advice",
      "description": "The top text 'my brother, the more girlfriends you have...' explicitly identifies the visual entity (the Black man) as 'my brother'. This creates an analogical mapping where the man is being projected as a moral authority figure ('my brother') who is giving advice. The visual material (the man's serious expression) is mapped onto the textual role of 'my brother' who is delivering a warning. This mapping reinforces the stereotype that Black men are inherently moral authorities or figures of wisdom, which is part of the racialized moralistic trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_460e5cdf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e1a43bc9",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual advice as the recipient of moral instruction",
      "description": "The user is projected onto the textual material as the intended recipient of the moral advice. The text explicitly uses 'you' ('you have the more girlfriends you have...') and 'your' ('your future'), directly addressing the viewer. This creates a semiotic projection where the user is positioned as the person who must heed the advice, making the moralistic message feel personal and directed at them. The visual material (the man) is presented as the moral authority ('my brother') delivering this advice to 'you'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_460e5cdf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fc3e0b1c",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_2",
      "label": "User projected onto the visual material as the moral authority figure",
      "description": "The user is projected onto the visual material (the Black man) as the moral authority figure ('my brother') who is delivering the advice. The text explicitly identifies the man as 'my brother', which creates an analogical mapping where the user is implicitly positioned as the 'sibling' or 'relative' who is being addressed by this moral figure. This projection reinforces the stereotype that Black men are inherently moral authorities or figures of wisdom, which is part of the racialized moralistic trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_460e5cdf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
