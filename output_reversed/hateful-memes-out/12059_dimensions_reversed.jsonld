    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2ebb61a3",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The three women are mapped as 'the only kkk'",
      "description": "The overlaid text 'the only kkk' is spatially positioned above the three women, directly mapping them onto the concept of the Ku Klux Klan. This is an analogical mapping where the visual subjects (the three women) are falsely equated with the historical white supremacist organization (KKK) through the text. The mapping is explicit and central to the meme's hateful intent, as it uses the visual material to represent the textual entity 'KKK'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7669414"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_572497fa",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the three women as the 'only kkk'",
      "description": "The user is projected onto the visual material of the three women, who are falsely equated with the Ku Klux Klan through the overlaid text. The meme's hateful intent relies on the user perceiving the women as embodying the KKK, creating a dehumanizing and offensive projection. There are no explicit deictic pronouns like 'me' or 'you' in the text, but the projection is implicit through the meme's structure: the user is expected to see the women as the subject of the hateful statement, thereby internalizing the racist stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d7669414"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
