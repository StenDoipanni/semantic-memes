      "@type": "BackgroundKnowledge",
      "instance_name": "white_men_stereotype",
      "label": "White Men Stereotype",
      "description": "The image shows a group of older white men, and the text implies they are the ones doing the work. This implicitly references the stereotype that white men are the primary actors in many societal roles, including military, political, and security roles. The meme uses this to satirize the idea that these men are doing the work without recognition, which is a commentary on gender and racial stereotypes in power structures.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0423bcc3"
      },
      "extractionMethod": "llm_extraction_huggingface"
