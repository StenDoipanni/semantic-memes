    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d6b6de0c",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia",
      "label": "Islamophobia",
      "description": "The meme relies on the implicit association between the group of men (who are white and appear to be older) and the stereotype that Muslims are terrorists. This is a core element of Islamophobia, which involves linking terrorism to Muslims. The meme uses this stereotype to imply that the group being referenced (likely white men) are doing the work of fighting terrorism without receiving credit, which is a satirical or ironic commentary on the stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0423bcc3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
