    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_119e49ae",
      "@type": "EmotionExpression",
      "instance_name": "irony",
      "label": "ironic emotion",
      "description": "The image conveys irony through the juxtaposition of the smiling, posed group of men holding books with the text claiming they do most of the work in terrorism without credit. The contrast between their calm, almost celebratory demeanor and the serious, accusatory nature of the text creates an ironic tone.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0423bcc3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2d8845bd",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The group of men are mapped as 'they' who do most of the work in terrorism without credit",
      "description": "The text 'terrorism is one of the only areas where they do most of the work and none of them get the credit' implicitly maps the visual entity 'seven_older_white_men' onto the pronoun 'they'. The meme uses this mapping to satirize the stereotype that white men are the primary actors in fighting terrorism without recognition, which is a commentary on gender and racial stereotypes in power structures. The irony arises from the contrast between the calm, posed demeanor of the men and the serious, accusatory nature of the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0423bcc3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ef497f28",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the text_chunk",
      "description": "The user is projected onto the textual material, as the meme's message is directed at the viewer to interpret the irony or satire regarding the group of men and their implied role in terrorism. There are no explicit deictic pronouns like 'you' or 'me', but the text implicitly invites the user to recognize the stereotype and the satirical commentary, making the user the recipient of the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0423bcc3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_44df827b",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Islamophobia",
      "description": "The meme implicitly links the group of older white men to the stereotype that Muslims are associated with terrorism, which is a core element of Islamophobia. The text 'terrorism is one of the only areas where they do most of the work and none of them get the credit' relies on this association to create a satirical commentary, but the underlying stereotype is harmful and perpetuates Islamophobic tropes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0423bcc3"
      },
      "extractionMethod": "llm_extraction_huggingface"
