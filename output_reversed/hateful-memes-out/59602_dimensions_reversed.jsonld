    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f79a7aa0",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_racial_assumption",
      "label": "Anti-Black Stereotype: Racial Assumption",
      "description": "The meme’s humor is built on the assumption that the suspect’s appearance (implied to be that of a Black man) warrants a racialized, animalistic label — a stereotype that is not visible in the image but is central to the meme’s racist logic. The phrase 'i don't want to assume' is ironic, as the assumption is already racially charged.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f2810cad"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_809b4aed",
      "@type": "EmotionExpression",
      "instance_name": "racist_humor",
      "label": "racist humor expression",
      "description": "The text overlay expresses a racially charged and dehumanizing joke by suggesting the suspect 'kinda looks like a mountain panda' — a derogatory stereotype implying criminality and animal-like traits based on appearance. The phrase 'i don't want to assume' is ironic, as the assumption is already racially motivated. This humor is intended to mock and dehumanize Black individuals, reflecting a harmful and offensive emotional tone.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f2810cad"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_738fab11",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The suspect is mapped onto the police officer",
      "description": "The text 'suspect is a male wearing clothing' is juxtaposed with the visual of the police officer, implying that the officer is the suspect. This is a direct analogical mapping where the textual description of the suspect is projected onto the visual entity (the police officer). The officer's appearance (male, wearing clothing, in uniform) matches the textual description, creating a mapping between the text and the visual material.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f2810cad"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f0ebee3b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the police officer as the suspect",
      "description": "The user is projected onto the visual material of the police officer, who is depicted as the suspect in the meme. The text 'suspect is a male wearing clothing' is explicitly mapped onto the visual of the police officer, creating a direct semiotic projection where the user sees themselves or identifies with the role of the suspect being described. This projection is reinforced by the ironic text 'kinda looks like a mountain panda but i don't want to assume', which implies the user is the one making the assumption about the suspect's appearance, thereby projecting the user's perspective onto the officer's visual representation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f2810cad"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
