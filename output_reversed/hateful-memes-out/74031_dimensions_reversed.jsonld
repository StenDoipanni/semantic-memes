      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c4c6099d",
      "@type": "BackgroundKnowledge",
      "instance_name": "iq_as_racial_metric",
      "label": "IQ as a Racial Metric",
      "description": "The false and scientifically invalid notion that intelligence quotient (IQ) scores can be used to categorize or rank entire racial or ethnic groups. This concept is a product of racist pseudoscience and has been debunked by modern psychology and genetics. The meme relies on this false premise to perpetuate its hateful message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcb33abe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_af9b1679",
      "@type": "BackgroundKnowledge",
      "instance_name": "retarded_slur",
      "label": "Retarded Slur",
      "description": "A derogatory term historically used to demean individuals with intellectual disabilities, and now considered offensive and harmful. Its use in the meme to describe people with average IQs of 70-80 is a form of ableist and racist language that dehumanizes and infantilizes the targeted group.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcb33abe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a2feb1d7",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_stereotype_meme",
      "label": "Racial Stereotype Meme",
      "description": "A type of internet meme that uses visual imagery of a specific racial or ethnic group combined with text that perpetuates harmful stereotypes. These memes are designed to spread misinformation and reinforce prejudice. The current meme is a classic example, using the visual of Maasai men to spread a false and hateful claim about their intelligence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcb33abe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0b85f1e2",
      "@type": "EmotionExpression",
      "instance_name": "hateful_anger",
      "label": "hateful anger expressed through derogatory text",
      "description": "The overlaid text explicitly uses hateful and derogatory language ('retarded') to demean the depicted group, expressing anger and contempt toward Black people by falsely claiming their average IQ is low. This is a form of racial hatred disguised as a 'joke' or 'fact'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcb33abe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0c51525b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text claims the average IQ of the depicted group is low, mapping onto the visual of the three men.",
      "description": "The overlaid text 'their average iq is about 70-80, few points above being retarded' is directly mapped onto the visual of the three men (three_men), who are identified as members of the Maasai ethnic group. The text attributes a false and derogatory intelligence level to them, creating an analogical mapping where the textual claim about intelligence is projected onto the visual representation of the individuals. This mapping is central to the meme's hateful intent, as it uses the visual of culturally rich individuals to reinforce a racist and ableist stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcb33abe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_49991c48",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual claim about intelligence",
      "description": "The user is projected onto the textual material (text_chunk) which contains the hateful and scientifically inaccurate claim about the average IQ of the depicted group. The meme does not use explicit deictic pronouns like 'you' or 'me', but the user is implicitly projected onto the text as the one consuming and internalizing the stereotype, thereby reinforcing the hateful message. The projection is onto the textual material because the user's engagement with the meme is primarily through interpreting and accepting the derogatory text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcb33abe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_900ed3fb",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme explicitly uses derogatory and scientifically inaccurate text to demean an entire ethnic group, associating them with low intelligence and using the offensive term 'retarded'. This constitutes a direct attack based on race and intelligence, fitting the definition of hateful content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcb33abe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_34e83b3f",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed for an audience that may be exposed to or propagate racist stereotypes, particularly those who hold or are influenced by anti-Black intelligence stereotypes. The target community likely includes individuals who are not members of the Maasai ethnic group or other targeted groups, but who may be predisposed to accept or spread racially charged misinformation. The meme's intent is to reinforce harmful biases by associating the visual representation of Maasai men with a false and derogatory claim about their intelligence, appealing to those who believe in or are influenced by the 'IQ as a racial metric' myth. The use of the term 'retarded' as a slur targets those who may not be aware of its offensive nature or who are indifferent to its impact, thereby appealing to a community that is either ignorant of or dismissive of the harm caused by such language. The meme's overall intent is hateful, and its target audience is likely those who are receptive to racial and ableist stereotypes, including those who may be influenced by or supportive of anti-Black racism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcb33abe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
