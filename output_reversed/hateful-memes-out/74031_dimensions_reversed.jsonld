    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6f24bd2b",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_intelligence_stereotype",
      "label": "Anti-Black Intelligence Stereotype",
      "description": "A harmful racial stereotype that falsely claims Black people have lower average intelligence, often used to justify discrimination and dehumanization. This stereotype is rooted in racist pseudoscience and has been historically used to support systemic oppression and segregation. The meme explicitly references this by claiming an average IQ of 70-80 for the depicted group, using the derogatory term 'retarded' to further demean them.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bcb33abe"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b516f95d",
      "@type": "BackgroundKnowledge",
      "instance_name": "maasai_ethnic_group",
      "label": "Maasai Ethnic Group",
      "description": "An ethnic group indigenous to Kenya and Tanzania, known for their distinctive traditional dress, beadwork, and pastoralist lifestyle. The men in the image are likely Maasai, identifiable by their colorful beaded necklaces, headbands, and attire. The meme misrepresents them by associating their cultural identity with a false intelligence stereotype, which is a form of racial stereotyping.",
      "belongsToAnalysis": {
