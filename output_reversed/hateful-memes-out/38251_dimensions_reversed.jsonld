    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0549b57c",
      "@type": "EmotionExpression",
      "instance_name": "self_doubt",
      "label": "self-doubt emotion",
      "description": "The man's thoughtful expression and the text 'i don't always speak my mind' convey a sense of uncertainty and lack of confidence in his ability to express himself effectively. This is reinforced by the second panel's text 'but when i do, i sound like a damn idiot,' which expresses a fear of sounding foolish when he finally speaks up.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9a8bf23e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6a1717b6",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The man is mapped as the speaker of the text",
      "description": "The top text 'i don't always speak my mind,' is mapped onto the visual entity 'man' who is depicted in a contemplative, hesitant pose, suggesting he is the one who experiences this internal conflict. The visual representation of his thoughtful expression and posture directly corresponds to the textual statement about not always speaking one's mind.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9a8bf23e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0a1a74e0",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the speaker of the meme",
      "description": "The user is projected onto the man in the top panel, who is depicted as the speaker of the text 'i don't always speak my mind,' and implicitly onto the speaker of the full meme text. The self-deprecating nature of the text ('but when i do, i sound like a damn idiot') creates an implicit 'me' projection, where the viewer identifies with the speaker's experience of internal conflict and self-doubt about speaking up. The visual of the man in contemplation reinforces this identification, as his posture and expression mirror the user's potential internal state. The bottom panel's skeptical woman serves as a contrast, but the primary projection is onto the man as the self-reflective speaker.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9a8bf23e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1ff4718c",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "general adult audience",
      "description": "The meme is designed for a broad, general adult audience familiar with self-deprecating humor and workplace dynamics. It uses universally relatable themes of self-doubt, social anxiety, and the fear of sounding foolish when speaking up, which are common experiences across various demographics and professions. The visual and textual elements are neutral and do not target any specific protected group or rely on stereotypes. The humor is personal and introspective, making it accessible to anyone who has experienced internal conflict about expressing their opinions in professional or social settings.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9a8bf23e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
