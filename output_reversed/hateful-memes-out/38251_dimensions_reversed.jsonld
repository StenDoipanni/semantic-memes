    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cc9a77d1",
      "@type": "BackgroundKnowledge",
      "instance_name": "office_culture",
      "label": "Office culture",
      "description": "The unwritten rules, norms, and expectations within a workplace. The setting and the man’s behavior suggest a culture where speaking one’s mind might be discouraged or met with negative consequences, contributing to the tension in the meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9a8bf23e"
