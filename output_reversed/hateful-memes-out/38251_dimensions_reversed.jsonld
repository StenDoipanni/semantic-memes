    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_de53fa49",
      "@type": "BackgroundKnowledge",
      "instance_name": "self_deprecating_humor_concept",
      "label": "Self-deprecating humor",
      "description": "A comedic technique where a person makes fun of themselves, often to deflect criticism or to appear humble. This meme uses self-deprecating humor to express the relatable experience of speaking up and feeling foolish afterward.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9a8bf23e"
