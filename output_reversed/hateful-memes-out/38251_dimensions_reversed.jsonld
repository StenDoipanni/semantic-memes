      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3a3a14c7",
      "@type": "BackgroundKnowledge",
      "instance_name": "internal_conflict",
      "label": "Internal conflict",
      "description": "The psychological state of being torn between two or more contradictory desires or beliefs. In this meme, the man’s contemplative expression and the text 'i don't always speak my mind' imply an internal struggle about whether to speak up or remain silent.",
      "belongsToAnalysis": {
