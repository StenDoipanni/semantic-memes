    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a1a2ff23",
      "@type": "EmotionExpression",
      "instance_name": "anger",
      "label": "angry emotion",
      "description": "The group of men in the image are depicted with intense facial expressions—wide eyes, open mouths, and furrowed brows—indicating extreme anger or outrage. Their aggressive gestures, such as raised hands and pointing fingers, further reinforce this emotional state. The overall scene conveys a collective display of fury and hostility.",
      "belongsToAnalysis": {
