    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_92cbd40c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The angry men are mapped as 'muslims who are offended by jokes'",
      "description": "The top text 'jokes don't kill people' is juxtaposed with the visual of angry men, who are then explicitly mapped by the bottom text 'muslims who are offended by jokes kill people'. This creates an analogical mapping where the visual entity (group_of_men) is being identified as the group described in the text (muslims who are offended by jokes). The visual material (angry_men_protest) is thus mapped onto the textual description (joke_offense_stereotype) to imply that this group is responsible for violence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80e89a7f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a4623e91",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual material of angry Muslim men",
      "description": "The user is implicitly projected onto the visual material of the angry men (group_of_men) in the image. The meme's structure, which juxtaposes the visual of angry men with the text 'muslims who are offended by jokes kill people', creates a semiotic projection where the viewer is expected to identify with or associate themselves with the group being depicted. This projection is not explicit (e.g., no 'you' or 'me' text), but it is implied through the accusatory framing and the user's role as the one interpreting the meme's message. The user is projected onto the scene of the angry men, who are visually mapped as 'muslims who are offended by jokes', thereby internalizing the meme's harmful stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80e89a7f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4ca69af5",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks Muslims by linking their religious identity to violence and aggression, implying that their anger over jokes is inherently dangerous and responsible for real-world violence. This is a harmful and hateful stereotype that delegitimizes the right of Muslims to feel offended.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80e89a7f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_25b287c9",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed to target and provoke a non-Muslim audience, particularly those who may hold or be exposed to Islamophobic stereotypes. The visual of angry Muslim men is used to elicit fear or anger in the viewer, who is then presented with the false equivalence that 'muslims who are offended by jokes kill people.' The target audience is likely individuals who are not Muslim, or who may be influenced by or sympathetic to anti-Muslim rhetoric, as the meme functions to delegitimize Muslim emotional responses and scapegoat the group for violence. The meme relies on the audience's potential acceptance of the stereotype that Muslims are inherently violent or prone to aggression when offended, which is a core component of Islamophobia.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80e89a7f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
