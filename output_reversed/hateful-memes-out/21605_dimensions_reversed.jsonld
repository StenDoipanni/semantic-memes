      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a0a695a3",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_stereotype",
      "label": "Islamophobia Stereotype",
      "description": "The meme relies on the harmful stereotype that Muslims are inherently violent or prone to aggression, particularly when offended. This stereotype is a core component of Islamophobia and is used to delegitimize Muslim emotional responses and to scapegoat the group for acts of violence, even when those acts are not connected to the specific offense mentioned (jokes).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80e89a7f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bf862066",
      "@type": "BackgroundKnowledge",
      "instance_name": "joke_offense_stereotype",
      "label": "Joke Offense Stereotype",
      "description": "The meme implies that the mere act of being offended by jokes is a justification for violence, which is a false and dangerous equivalence. This stereotype suggests that religious or cultural groups are overly sensitive or irrational in their reactions to humor, thereby justifying the violent outcomes attributed to them.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80e89a7f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1d2392da",
      "@type": "BackgroundKnowledge",
      "instance_name": "violence_joke_equivalence",
      "label": "Violence-Joke Equivalence",
      "description": "The meme falsely equates the act of telling a joke with the act of killing, and then attributes the violence to the offended group's reaction. This is a logical fallacy that ignores the complex causes of violence and instead blames a specific group for any violent outcome, regardless of context or causation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80e89a7f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3a27d8a0",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_terrorism_association",
      "label": "Islamophobia: Terrorism Association",
      "description": "The meme implicitly references the real-world association between Islam and terrorism, which is a common and dangerous trope in Islamophobia. This association is used to justify the stereotype that Muslims are inherently violent, even when the specific act of violence is not connected to the offense (jokes).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80e89a7f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_06f3d745",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_violence_barbarism_claim",
      "label": "Islamophobia: Violence/Barbarism Claim",
      "description": "The meme relies on the stereotype that Muslims are inherently violent or barbaric, which is a core component of Islamophobia. This stereotype is used to justify the violent outcomes attributed to the group, even when those outcomes are not connected to the specific offense (jokes).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80e89a7f"
      },
      "extractionMethod": "llm_extraction_huggingface"
