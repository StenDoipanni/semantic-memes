    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_34cc4183",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'me' is mapped onto the man with developmental disability",
      "description": "The text 'me:' at the end of the statement 'her: you must be retarded if you think we fucking me:' explicitly refers to the person being addressed. In the visual material, the man with visible developmental disability is the one being spoken to, and the text 'me:' is positioned to directly map onto him. This creates an analogical mapping where the textual entity 'me' is projected onto the visual entity 'man'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e8bd402"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_785fa891",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man with developmental disability via the textual deictic 'me'",
      "description": "The user is projected onto the man with visible developmental disability, as indicated by the textual deictic 'me:' in the text_chunk 'her: you must be retarded if you think we fucking me:'. The text explicitly addresses the man as 'me', creating a direct semiotic projection where the viewer is meant to identify with or project themselves onto the man as the recipient of the hateful statement. This projection is reinforced by the visual material showing the man as the one being spoken to, and the text's placement directly mapping onto him.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e8bd402"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
