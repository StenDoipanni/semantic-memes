    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b0df8870",
      "@type": "Scene",
      "instance_name": "happy_couple_on_bench",
      "label": "Two people with visible developmental disabilities sharing a joyful moment on a park bench",
      "description": "A man and a woman, both with visible developmental disabilities, are seated closely together on a wooden park bench. The man, wearing a light blue checkered shirt, is smiling broadly and laughing while holding a smartphone. The woman, wearing a purple zip-up hoodie, is leaning her head affectionately against the man's shoulder, also laughing. They appear to be enjoying each other's company in a relaxed, happy setting. The background shows a blurred park with green grass and trees, suggesting a peaceful outdoor environment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e8bd402"
      },
      "extractionMethod": "llm_extraction_huggingface"
