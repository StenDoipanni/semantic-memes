      "@type": "BackgroundKnowledge",
      "instance_name": "intelligence_mockery_use_of_slurs",
      "label": "Intelligence mockery (use of slurs)",
      "description": "The slur 'retarded' is used in the text to demean the person being addressed, implying they are unintelligent or incapable. This is a form of ableism that mocks and dehumanizes individuals with developmental disabilities by associating them with low intelligence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e8bd402"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ab2b7d3e",
