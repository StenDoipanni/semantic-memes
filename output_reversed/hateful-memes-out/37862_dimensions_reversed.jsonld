    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_37b26d2e",
      "@type": "VisualMaterial",
      "instance_name": "man",
      "label": "person with visible developmental disability",
      "description": "A man with a developmental disability, wearing a light blue checkered shirt and jeans, is seated on a park bench. He is smiling broadly and appears to be laughing, holding a smartphone in his left hand. His physical features suggest he has Down syndrome or a similar condition.",
