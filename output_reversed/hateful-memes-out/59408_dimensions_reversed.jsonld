    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cc58a76c",
      "@type": "BackgroundKnowledge",
      "instance_name": "pedophilia_false_association",
      "label": "False association between LGBTQ+ relationships and pedophilia",
      "description": "A harmful stereotype that falsely equates same-sex relationships, particularly those involving children, with child sexual abuse. This is a baseless and dangerous myth used to stigmatize and demonize LGBTQ+ individuals and families. It is not grounded in reality and is widely condemned by mental health professionals, child protection agencies, and the broader public. The meme leverages this stereotype to incite fear and hatred.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5b3cb600"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5f9c6203",
      "@type": "BackgroundKnowledge",
      "instance_name": "gay_marriage",
      "label": "Gay marriage",
      "description": "The legal and social recognition of marriage between two individuals of the same sex. It is a civil right protected in many countries and is a cornerstone of LGBTQ+ equality. The meme falsely implies that gay marriage is inherently linked to pedophilia, which is a dangerous and false narrative.",
      "belongsToAnalysis": {
