      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dae27622",
      "@type": "BackgroundKnowledge",
      "instance_name": "hate_speech",
      "label": "Hate speech",
      "description": "Speech that is intended to incite hatred, violence, or discrimination against a particular group based on characteristics such as race, religion, sexual orientation, or gender. The meme is an example of hate speech because it uses a benign image to propagate a false and dangerous stereotype about LGBTQ+ individuals, aiming to incite prejudice and fear.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5b3cb600"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_43a3192a",
      "@type": "BackgroundKnowledge",
      "instance_name": "misinformation",
      "label": "Misinformation",
      "description": "False or inaccurate information that is spread, often unintentionally, but which can have harmful consequences. The meme spreads misinformation by falsely equating gay marriage with pedophilia, which is a baseless and dangerous myth. This misinformation is used to stigmatize and demonize the LGBTQ+ community.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5b3cb600"
      },
      "extractionMethod": "llm_extraction_huggingface"
