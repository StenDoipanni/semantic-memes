    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_65c1ece1",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The affectionate family moment is mapped as the beginning of a dangerous narrative.",
      "description": "The top text 'and so it begins...' is analogically mapped onto the visual scene of the affectionate family moment. The text implies that the depicted tender family scene is the starting point for a harmful or sinister development — specifically, the false association with pedophilia. The visual material (affectionate_family_moment) is being used to symbolize the 'beginning' of the hateful narrative described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5b3cb600"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_067e6df6",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message as the target of the hateful narrative",
      "description": "The user is projected onto the textual material (text_chunk_1: 'and so it begins...') and the underlying hateful narrative it introduces. The phrase 'and so it begins...' implies that the user (as the viewer) is being positioned as the one who is now witnessing or experiencing the 'beginning' of a dangerous or sinister development — specifically, the false association between gay marriage and pedophilia. The user is not directly addressed with 'you' or 'your', but the deictic 'it begins' creates an implicit projection where the user is the one who is now entering or witnessing this harmful narrative. The projection is onto the text and the scene it frames, making the user feel implicated in or responsible for the unfolding of the hate speech.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5b3cb600"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
