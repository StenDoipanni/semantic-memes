    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_43f1bbe4",
      "@type": "BackgroundKnowledge",
      "instance_name": "christian_condemnation",
      "label": "Christian condemnation of LGBTQ+ relationships",
      "description": "A theological and cultural stance held by some Christian denominations that views same-sex relationships as sinful or immoral, often based on interpretations of religious texts. The meme references this by claiming 'we Christians tried to warn you,' implying that religious opposition to gay marriage is justified or valid, despite the false and harmful nature of the underlying stereotype.",
      "belongsToAnalysis": {
