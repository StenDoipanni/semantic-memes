    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d15c76ed",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The text 'what's burning?' maps onto the burning sage bundle.",
      "description": "The textual question 'what's burning?' is directly juxtaposed with the visual of a burning sage bundle (smudge stick) in the image. This creates an analogical mapping where the text prompts the viewer to identify or interpret the visual object as the subject of the burning question. The mapping is explicit through spatial adjacency and context: the text is positioned over the burning object, inviting the viewer to consider what is literally burning (sage) and what it symbolically represents (spiritual cleansing).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_17318fc4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_afa28d00",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material prompting reflection",
      "description": "The user is projected onto the text 'what's burning?' which acts as a rhetorical question inviting the viewer to consider the meaning of the burning object. The text directly engages the user by prompting them to interpret the visual scene, making the user an active participant in the meme's meaning-making process. There are no explicit deictic pronouns like 'you' or 'me', but the question format inherently directs the user's attention and thought to the visual material and its context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_17318fc4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
