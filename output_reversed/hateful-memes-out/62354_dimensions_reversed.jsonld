    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_89e30df8",
      "@type": "BackgroundKnowledge",
      "instance_name": "bae",
      "label": "bae",
      "description": "The term 'bae' is a colloquial slang term, originating from the phrase 'before anyone else,' which has evolved to mean 'boyfriend' or 'girlfriend' in modern internet and youth culture. It is used to refer to a romantic partner in a casual, affectionate manner. Understanding this slang is necessary to interpret the text overlay 'when you ready for bed but bae won't leave you alone' as referring to a romantic relationship.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54a52a38"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b8739786",
      "@type": "BackgroundKnowledge",
      "instance_name": "ready_for_bed",
      "label": "ready for bed",
      "description": "This phrase refers to the common daily routine of preparing to sleep, often involving winding down, turning off electronics, and getting into bed. It is a mundane, relatable activity that forms the context for the meme's humor, contrasting the desire for solitude with the affectionate clinginess of a partner.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54a52a38"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e50f9f77",
      "@type": "BackgroundKnowledge",
      "instance_name": "romantic_relationship_dynamics",
      "label": "romantic relationship dynamics",
      "description": "The meme relies on the understanding of common behaviors and emotional patterns within romantic relationships, such as the desire for personal space versus the need for physical or emotional closeness. This knowledge is necessary to interpret the humor in the juxtaposition of the affectionate image with the text describing a relatable domestic conflict.",
      "belongsToAnalysis": {
