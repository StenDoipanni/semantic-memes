    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4211a0ff",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The couple's affectionate embrace is mapped onto the textual concept of 'bae' (romantic partner) who won't leave you alone.",
      "description": "The text 'bae won't leave you alone' is analogically mapped onto the visual entity of the couple embracing. The affectionate embrace visually represents the clinginess or unwillingness to let go described by 'bae'. The visual material (the couple's embrace) is used to embody the textual concept of a romantic partner (bae) who is physically and emotionally attached, preventing the other from being alone. This mapping relies on the cultural understanding that 'bae' refers to a romantic partner, and the visual affectionate embrace symbolizes the clinginess described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54a52a38"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ea3dd131",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material describing a relatable romantic scenario",
      "description": "The user is projected onto the text 'when you ready for bed but bae won't leave you alone', which uses the second-person pronoun 'you' to directly address the viewer. This creates an identification where the viewer sees themselves in the situation described — being ready for bed but unable to be left alone by their romantic partner. The projection is onto the textual material, which frames the scenario as personal and immediate.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54a52a38"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
