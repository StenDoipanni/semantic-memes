    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bfa118de",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The woman's exposed chest is mapped as the 'argumentative advantage' referenced in the text.",
      "description": "The top text 'hard to argue with a woman that's braless' implies that her physical appearance (specifically being braless) is the source of her persuasive power. The visual material shows her chest exposed through the wet, see-through shirt, which is directly mapped onto the textual claim that her 'bralessness' is the reason she is hard to argue with. This is an analogical mapping where the visual attribute (exposed chest) is equated with the textual concept (argumentative advantage).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c9b67c6b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_37087966",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman in the scene as the subject of the misogynistic trope",
      "description": "The user is not explicitly projected onto a specific entity via deictic pronouns like 'me' or 'you'. However, the meme's structure implicitly projects the user onto the woman depicted in the visual material. The user is expected to identify with or imagine themselves as the observer of the scene, interpreting the woman's exposed chest as the 'argumentative advantage' referenced in the text. This creates a semiotic projection where the user is positioned as the one who understands or is being addressed by the meme's misogynistic message, which equates physical appearance with persuasive power. The projection is onto the visual material (the woman) and the textual material (the argumentative claim), but the core projection is onto the woman as the subject of the trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c9b67c6b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
