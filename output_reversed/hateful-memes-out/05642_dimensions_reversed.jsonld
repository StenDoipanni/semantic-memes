    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0a020987",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Textual joke mapped onto visual car failure",
      "description": "The text 'did you say dude blew his tranny???' is an analogical mapping that projects the concept of a car transmission failure ('blown tranny') onto the visual of the burning silver sedan. The text humorously interprets the car's catastrophic mechanical failure (indicated by flames and smoke from the engine bay) as a 'blown tranny', using automotive slang. This mapping relies on the viewer understanding the visual context (car on fire) and the textual pun (blown tranny) to create the joke. The mapping is explicit through the juxtaposition of the text with the visual material, where the text assigns a specific mechanical explanation to the visual event.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a42a759f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6148a0f0",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material via deictic reference",
      "description": "The user is projected onto the textual material 'did you say dude blew his tranny???' through the use of the second-person pronoun 'you' in the text. This deictic reference directly addresses the viewer, inviting them to imagine themselves as the person who made the comment or as the one who is being addressed in the joke. The projection is onto the text_chunk, which contains the deictic element 'you', making the user feel personally implicated or addressed in the humorous scenario.",
      "belongsToAnalysis": {
