    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8f88926d",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The 9/11 victims are mapped as 'fastest readers' based on the text's grotesque metaphor.",
      "description": "The textual material 'the 9/11 victims cause they went through 87 stories in 10 seconds' creates an analogical mapping where the victims are implicitly equated with 'fastest readers'. The visual material, specifically the World Trade Center Twin Towers, serves as the mapping entity because it is the physical location associated with the victims' deaths. The text projects the victims' tragic fate onto the metaphor of reading speed, using the towers as the anchor point for this dehumanizing comparison. The mapping is established by the juxtaposition of the solemn memorial scene (the towers) with the mocking text, which forces the viewer to associate the visual with the grotesque textual metaphor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d1efb8cc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_77d37c77",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material mocking the 9/11 victims",
      "description": "The user is projected onto the textual material (text_chunk_1 and the lower text) which presents a dehumanizing joke about the 9/11 victims. The meme forces the viewer to engage with the text's grotesque metaphor, making the user an implicit participant in the act of reading and internalizing the offensive comparison. There are no explicit deictics like 'you' or 'me', but the framing of the question 'who were the fastest readers in the world?' and the subsequent answer directly address the user's perspective, projecting them onto the act of interpreting the text and its dark humor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d1efb8cc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cdf85eed",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme trivializes the 9/11 victims by comparing their deaths to a 'reading speed' of 87 stories in 10 seconds, which is a grotesque and dehumanizing joke. This reduces the profound human tragedy to a dark, offensive metaphor, causing significant emotional harm and disrespect to the memory of those who died.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d1efb8cc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b42cdcb5",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "general internet audience",
      "description": "The meme is designed for a broad online audience familiar with 9/11 history and dark humor tropes, likely targeting individuals who engage with internet memes, particularly those who appreciate or are exposed to edgy, controversial, or shock-value content. The target community includes users who may find the juxtaposition of a solemn memorial scene with a grotesque, dehumanizing joke amusing or provocative, even if it is offensive. The meme relies on cultural knowledge of the 9/11 attacks and the visual symbolism of the Twin Towers to deliver its message, so the audience must be aware of this context to fully comprehend the joke — or its intended shock value. The humor is rooted in dark humor, which is often consumed by internet communities that value provocative or boundary-pushing content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d1efb8cc"
      },
