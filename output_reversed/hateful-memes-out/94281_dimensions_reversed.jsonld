    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_df069de2",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The emotional gap of social exclusion is mapped onto the physical hole in the brick wall",
      "description": "The textual phrase 'when i try to fit in with other people' describes an emotional or psychological state of alienation. This state is visually represented by the hole in the brick wall, which serves as a metaphor for a missing piece or void — symbolizing the gap one feels when trying to belong. The mapping is established through the visual metaphor: the hole (visual) corresponds to the feeling of not fitting in (textual).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f4aa1383"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2077a635",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual metaphor of the hole in the brick wall",
      "description": "The user is projected onto the visual material of the brick wall with a hole, which serves as a metaphor for the emotional gap experienced when trying to fit in with others. The textual material 'when i try to fit in with other people' explicitly uses 'i', which deictically anchors the experience to the user, making them the subject of the metaphor. The user identifies with the feeling of alienation represented by the hole, projecting their own experience onto the visual entity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f4aa1383"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
