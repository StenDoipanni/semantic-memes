    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_92446466",
      "@type": "BackgroundKnowledge",
      "instance_name": "social_exclusion",
      "label": "Social Exclusion",
      "description": "The concept of social exclusion refers to the process by which individuals or groups are denied access to social, economic, or political opportunities, often leading to feelings of alienation or not belonging. This is a real-world social phenomenon that the meme metaphorically represents through the visual of a missing brick in a wall.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f4aa1383"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e47c8094",
      "@type": "BackgroundKnowledge",
      "instance_name": "metaphor_of_gap",
      "label": "Metaphor of Gap",
      "description": "The visual of a hole in a brick wall is used as a metaphor to represent a missing piece, a void, or an absence — in this case, the emotional or psychological gap one feels when trying to fit in with others. This is a common figurative device in literature and visual media to convey incompleteness or disconnection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f4aa1383"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a346f2d8",
      "@type": "BackgroundKnowledge",
      "instance_name": "relatable_human_experience",
      "label": "Relatable Human Experience",
      "description": "The meme taps into a universal human experience — the struggle to belong, fit in, or be accepted by a social group. This is a common theme in social psychology and popular culture, often expressed through humor or self-deprecating imagery to convey shared feelings of isolation or awkwardness.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f4aa1383"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_58fbf5b9",
      "@type": "BackgroundKnowledge",
      "instance_name": "emotional_state_of_alienation",
      "label": "Emotional State of Alienation",
      "description": "Alienation is a psychological state characterized by feelings of isolation, detachment, and exclusion from social groups. The meme uses the visual metaphor to express this emotional state, which is a well-documented psychological experience that resonates with many people.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f4aa1383"
      },
      "extractionMethod": "llm_extraction_huggingface"
