    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ffd93367",
      "@type": "VisualMaterial",
      "instance_name": "chocolate_bars",
      "label": "stacked chocolate bars",
      "description": "A stack of dark chocolate bars, partially melted, with chocolate dripping down the sides. The bars are arranged vertically, showing their segmented, rectangular shape. The melting chocolate creates a glossy, flowing appearance, emphasizing the decadence and visual appeal of the chocolate.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6fae674"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_af0e19bb",
      "@type": "Scene",
      "instance_name": "melting_chocolate_scene",
      "label": "melting chocolate scene",
      "description": "A stack of chocolate bars is melting, with chocolate dripping down the sides. The scene is visually appealing and decadent, emphasizing the glossy, flowing appearance of the melting chocolate. The text overlay states 'Chocolate melts at 86°F', which is factually misleading as it implies a universal melting point for all chocolate types, when in reality, melting points vary by composition (dark vs. milk chocolate).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6fae674"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_53eaa73a",
      "@type": "BackgroundKnowledge",
      "instance_name": "melting_point_fact",
      "label": "Melting Point of Chocolate",
      "description": "The claim that 'Chocolate melts at 86°F' is factually misleading. Dark chocolate melts around 86°F (30°C), but milk chocolate melts at a lower temperature, and the melting point varies significantly by composition. This scientific inaccuracy is central to the meme's intent to spread misinformation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6fae674"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b5f55c44",
      "@type": "BackgroundKnowledge",
      "instance_name": "misinformation_spread",
      "label": "Spread of Misinformation",
      "description": "The meme leverages the visual appeal of melting chocolate to present a scientifically inaccurate claim, aiming to provoke confusion or skepticism. This reflects a broader social phenomenon where false or misleading information is disseminated for humorous or ironic effect, potentially undermining trust in factual knowledge.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6fae674"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_61e0acf7",
      "@type": "BackgroundKnowledge",
      "instance_name": "scientific_accuracy",
      "label": "Scientific Accuracy of Melting Points",
      "description": "Real-world knowledge about the physical properties of chocolate, including how its melting point varies by type (dark, milk, white), is required to understand why the meme's claim is misleading. This knowledge is not visible in the image but is essential for evaluating the meme's factual content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6fae674"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_211b3f1c",
      "@type": "EmotionExpression",
      "instance_name": "mischievousness",
      "label": "the mischievous emotion",
      "description": "The emotion expressed is mischievous, conveyed through the juxtaposition of a visually appealing, decadent image of melting chocolate with a scientifically inaccurate and misleading claim ('Chocolate melts at 86°F'). The intent is to provoke confusion or skepticism in a humorous or ironic way, which is characteristic of mischievous behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6fae674"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f0f3ec2d",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Chocolate melting point claim mapped to visual depiction of melting chocolate",
      "description": "The text 'Chocolate melts at 86°F' is presented as a factual statement, which is then visually instantiated by the image of chocolate bars melting. The visual material (melting chocolate) serves as the concrete representation or embodiment of the textual claim, creating an analogical mapping where the text's assertion is visually anchored to the scene. This mapping is central to the meme's structure, as the visual material confirms the text's claim (even though it is factually misleading), thereby creating a false equivalence between the visual and the textual assertion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6fae674"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_81ff7b45",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual material of melting chocolate",
      "description": "The user is projected onto the visual material (chocolate_bars) as the subject of the meme's visual appeal and the implied target of the misleading claim. The user is invited to perceive the decadent, glossy melting chocolate as a representation of the stated fact, even though the fact is scientifically inaccurate. The projection is implicit, not deictic, but the user is positioned as the observer of the visual material that embodies the textual claim.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e6fae674"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d37508c5",
