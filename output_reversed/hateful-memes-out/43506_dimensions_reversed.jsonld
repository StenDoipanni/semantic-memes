    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c369b6cc",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the hateful textual claim",
      "description": "The user is projected onto the bottom textual material 'they are pedophiles', which is the core hateful assertion of the meme. The meme does not use explicit deictic pronouns like 'you' or 'me', but the user is implicitly projected onto the act of consuming and interpreting this hateful message, which is directed at the family unit. The projection is onto the textual material that delivers the false and malicious association.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_84a30a55"
      },
      "extractionMethod": "llm_extraction_huggingface"
