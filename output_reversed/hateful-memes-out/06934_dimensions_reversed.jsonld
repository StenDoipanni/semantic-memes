    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ba2b1090",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Hitler is mapped as nonchalantly killing millions of Jews",
      "description": "The text 'hitler nonchalantly killing millions of jews with no remorse' explicitly maps Adolf Hitler (the visual entity) onto the act of nonchalantly killing millions of Jews. The visual material of Hitler sitting casually on a blanket is juxtaposed with the text to create an analogical mapping where his mundane posture is equated with the horrific act of genocide. This mapping is central to the meme's hateful intent, trivializing the Holocaust by reducing it to a casual, picnic-like scene.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_981597bd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d7ae359e",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of Hitler nonchalantly killing millions of Jews",
      "description": "The user is projected onto the scene described in the meme, where the visual of Adolf Hitler sitting casually on a blanket is juxtaposed with the textual claim that he is 'nonchalantly killing millions of jews with no remorse'. This projection invites the user to imagine themselves in the context of this grotesque trivialization, where the horror of genocide is reduced to a mundane, almost picnic-like activity. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the meme's framing and intent create an implicit projection where the viewer is positioned as a participant in the act of mocking or trivializing the Holocaust, thereby internalizing the hateful message. The projection is onto the scene (nonchalant_killing_scene) which combines both visual and textual material to create a unified, dehumanizing narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_981597bd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6cff24ae",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks and glorifies Adolf Hitler, the architect of the Holocaust, by trivializing his genocide of millions of Jews through grotesque humor. It equates his horrific actions with a mundane, nonchalant picnic scene, thereby dehumanizing the victims and mocking the historical atrocity. This is a direct hateful attack on Jewish people and the memory of the Holocaust, falling under antisemitic tropes and Holocaust minimization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_981597bd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c340db63",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who may be seeking dark humor, shock value, or who are desensitized to historical atrocities, particularly those who might find grotesque or offensive content amusing. The meme is designed to provoke a reaction through its hateful and trivializing depiction of the Holocaust, likely targeting viewers who are either unaware of the historical gravity or who intentionally engage with extremist or antisemitic content for provocative or mocking purposes. The community-specific element is the use of antisemitic tropes and Holocaust minimization themes, which are intended to resonate with those who hold or are exposed to such hateful ideologies, even if indirectly.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_981597bd"
      },
