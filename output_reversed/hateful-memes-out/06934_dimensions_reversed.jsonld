    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fbffced9",
      "@type": "Scene",
      "instance_name": "nonchalant_killing_scene",
      "label": "Adolf Hitler nonchalantly killing millions of Jews",
      "description": "The scene depicts Adolf Hitler sitting casually on a blanket outdoors, holding an object in his hands, while overlaid text states he is 'nonchalantly killing millions of Jews with no remorse'. The juxtaposition of his mundane, relaxed posture with the horrific act described in the text creates a scene of grotesque trivialization. The spatial arrangement places Hitler as the central, dominant figure, with the blanket and grass forming the immediate environment. The text acts as a narrative overlay that defines the scene's horrific intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_981597bd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2d3501dd",
      "@type": "BackgroundKnowledge",
      "instance_name": "Holocaust",
      "label": "Holocaust",
      "description": "The Holocaust was the systematic, state-sponsored persecution and murder of six million Jews by Nazi Germany and its collaborators during World War II. It is one of the most horrific genocides in human history and is central to understanding the gravity of the text's claim about 'killing millions of Jews'. The meme trivializes this historical atrocity by juxtaposing it with a mundane, nonchalant scene.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_981597bd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
