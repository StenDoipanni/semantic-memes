      "@id": "http://example.org/multimodal-taxonomy#dimension_6f0236b8",
      "@type": "EmotionExpression",
      "instance_name": "mocking_happiness",
      "label": "mocking happiness expression",
      "description": "The Black man is smiling broadly with arms crossed, conveying a false sense of agreement or validation. This expression is used to mockingly endorse a racist comparison, making the hateful stereotype seem 'valid' or 'reasonable'.",
      "belongsToAnalysis": {
