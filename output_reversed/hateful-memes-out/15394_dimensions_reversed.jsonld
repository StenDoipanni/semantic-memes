    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dafb2f2a",
      "@type": "EmotionExpression",
      "instance_name": "celebratory_exuberance",
      "label": "celebratory and exuberant emotion",
      "description": "The emotion expressed is one of enthusiastic celebration, conveyed through Hulk Hogan’s dramatic, intense pose—pointing forward with energy—and the overlaid text 'happy birthday brother!!!!' which amplifies the joyful, over-the-top tone. The combination of his iconic persona and the birthday message creates a humorous and exaggerated expression of happiness and camaraderie.",
      "belongsToAnalysis": {
