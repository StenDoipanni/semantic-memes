    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ac4c0a1c",
      "@type": "BackgroundKnowledge",
      "instance_name": "Hulk_Hogan",
      "label": "Hulk Hogan",
      "description": "Hulk Hogan is a legendary professional wrestler and one of the most iconic figures in WWE history. His persona, characterized by his black bandana, yellow sunglasses, and catchphrases like 'Hulkamania,' is globally recognized. His dramatic entrance and speeches at major events like WrestleMania are part of his signature style. Understanding the meme requires knowing that he is a cultural icon whose exaggerated persona is used for humor and celebration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_53aa5c71"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bed858ef",
      "@type": "BackgroundKnowledge",
      "instance_name": "WrestleMania",
      "label": "WrestleMania",
      "description": "WrestleMania is the flagship annual pay-per-view event of WWE (World Wrestling Entertainment), often considered the most prestigious and widely watched professional wrestling event in the world. It features major championship matches and is known for its high production value, dramatic storylines, and iconic moments. The background knowledge of WrestleMania is necessary to understand the setting and the context of Hulk Hogan’s appearance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_53aa5c71"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6b90cd92",
      "@type": "BackgroundKnowledge",
      "instance_name": "birthday_celebration",
      "label": "Birthday Celebration",
      "description": "The concept of a birthday celebration is a universal cultural phenomenon involving the commemoration of a person's birth anniversary, typically marked with gifts, greetings, and festivities. The meme uses this concept to create a humorous, exaggerated birthday wish by leveraging Hulk Hogan’s dramatic persona. Understanding this cultural context is essential to interpret the meme’s intent.",
      "belongsToAnalysis": {
