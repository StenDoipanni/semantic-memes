    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e8795f71",
      "@type": "AnalogicalMapping",
      "instance_name": "happy_birthday_mapping",
      "label": "Hulk Hogan is the birthday celebrant",
      "description": "The text 'happy birthday' is mapped onto Hulk Hogan, implying that he is the person being celebrated. The visual of Hulk Hogan in his iconic persona, combined with the birthday greeting, creates an analogical mapping where the textual element 'happy birthday' refers to him as the recipient of the celebration. This is reinforced by the bottom text 'brother!!!!', which further identifies him as the celebrant or the person being addressed.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_53aa5c71"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_14325c82",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the celebratory scene and textual greeting",
      "description": "The user is projected onto the overall celebratory scene and the textual elements 'happy birthday' and 'brother!!!!', which together create an address directed at the user as the recipient of the birthday wish. The user is not explicitly deictic (e.g., 'you' or 'me'), but the entire meme structure — the dramatic visual of Hulk Hogan, the birthday greeting text, and the informal 'brother!!!!' — functions as an address to the viewer/user, making them the implied celebrant or the person being wished a happy birthday. The projection is onto the scene and the textual material that collectively form the celebratory message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_53aa5c71"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
