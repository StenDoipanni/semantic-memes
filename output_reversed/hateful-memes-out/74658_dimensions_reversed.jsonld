    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a0947a04",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The creator of the image is mapped onto the woman in the center",
      "description": "The text 'whoever photoshopped this' explicitly refers to the person who created or edited the image. This person is analogically mapped onto the central woman in the image, who is visually depicted as being shocked and surrounded by accusatory pointing hands. The visual metaphor of the woman being targeted by multiple hands represents the act of being blamed or shamed, which is the core of the meme's message. The woman's shocked expression and the surrounding pointing hands symbolize the public shaming and accusation directed at the creator of the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c81d718c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_38b51a90",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the central woman as the target of blame",
      "description": "The user is projected onto the central woman in the image, who is visually depicted as being shocked and surrounded by accusatory pointing hands. This projection is based on the textual material 'whoever photoshopped this' which explicitly refers to the creator of the image, and the visual metaphor of the woman being targeted represents the user's identification with the victim of online shaming. The user sees themselves as the one being blamed or shamed, even though the meme is directed at the creator. The user is not explicitly deictic (e.g., 'me', 'you'), but the projection is implied through the accusatory tone and the visual metaphor of being targeted, which the user identifies with.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c81d718c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
