      "instance_name": "cracker_presidents_metaphor",
      "label": "Stereotype of trivializing U.S. presidents",
      "description": "The meme uses a visual metaphor to imply that U.S. presidents are trivial or mundane, comparable to common snack foods. This reduces complex political figures to a simplistic category, mocking the gravity of presidential roles and history. This is a form of cultural satire that relies on the audience understanding the contrast between the importance of U.S. presidents and the triviality of crackers.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_98d32acd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
