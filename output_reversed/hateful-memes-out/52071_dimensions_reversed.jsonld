    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b30fd839",
      "@type": "BackgroundKnowledge",
      "instance_name": "tired_boss",
      "label": "tired boss",
      "description": "A meme template that uses the image of a weary-looking Black man (often identified as Mookie from 'Do the Right Thing' or a similar figure) to convey exhaustion or resignation. The term 'boss' implies authority or responsibility, and the phrase 'I'm tired' suggests being overwhelmed. This is a cultural meme format that relies on the visual of a Black man to represent a figure of authority or burden, which can be racially stereotyping.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_641cb3a0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7a7192c8",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype",
      "label": "anti-black_stereotype",
      "description": "A harmful racial stereotype that associates Black people with criminality, aggression, or being overly sensitive, often used to delegitimize their experiences or perspectives. The meme leverages the image of a Black man to represent a 'boss' who is 'tired' of social media conflicts, which can be interpreted as reinforcing the stereotype that Black people are inherently 'angry' or 'overly sensitive' in a derogatory way.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_641cb3a0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bd9c13c3",
      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_visual",
      "label": "racialized_visual",
      "description": "The use of a Black person's image to represent a concept or emotion that is culturally or socially loaded, often to reinforce racial stereotypes or to make a point about race in a way that can be offensive or harmful. In this meme, the Black man's weary expression is used to represent the 'boss' who is 'tired' of social media conflicts, which can be interpreted as racially charged and potentially harmful to Black individuals and communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_641cb3a0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5d316857",
      "@type": "EmotionExpression",
      "instance_name": "resignation",
      "label": "resigned emotion",
      "description": "The man's facial expression conveys a sense of weariness, fatigue, and defeat, suggesting he has given up or is overwhelmed by a situation. His downturned mouth, heavy eyelids, and lack of engagement with the camera communicate emotional exhaustion and a desire to stop.",
      "belongsToAnalysis": {
