    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9243cc3c",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableist_stereotype",
      "label": "ableist stereotype",
      "description": "The meme relies on the stereotype that people with physical disabilities are incapable of engaging in normal, independent activities and are often relegated to domestic or infantilized roles, such as 'making mashed potatoes'. This is a form of ableist toxicity that infantilizes and belittles individuals with disabilities by associating their condition with incompetence or a need for constant care.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3c811000"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aaef3371",
      "@type": "BackgroundKnowledge",
      "instance_name": "inspiration_porn",
      "label": "inspiration porn",
      "description": "The meme may be interpreted as 'inspiration porn' — a trope that portrays people with disabilities as inspirational or pitiable for performing mundane tasks, which can be demeaning and reduce their humanity to a narrative of overcoming adversity or being 'cute' or 'adorable' in a way that reinforces pity rather than respect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3c811000"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9260253c",
      "@type": "BackgroundKnowledge",
      "instance_name": "domestic_labour_stereotype",
      "label": "domestic labour stereotype",
      "description": "The phrase 'making mashed potatoes' is a domestic chore typically associated with women or children in a household context. By juxtaposing this with a child in a wheelchair in a public setting, the meme implies the child is performing a task that is trivial, domestic, and perhaps beneath their station, reinforcing a stereotype that people with disabilities are only capable of or should be confined to such roles.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3c811000"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e008e2d0",
      "@type": "BackgroundKnowledge",
      "instance_name": "childhood_infantilization",
      "label": "childhood infantilization",
      "description": "The meme may infantilize the child by associating them with a task typically expected of very young children or domestic help, suggesting they are incapable of engaging in more complex or 'adult' activities, which is a form of ableist infantilization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3c811000"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
