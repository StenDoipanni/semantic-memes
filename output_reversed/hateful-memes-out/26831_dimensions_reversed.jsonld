    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9f191a58",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "child is making mashed potatoes",
      "description": "The text 'making mashed potatoes' is overlaid on the image of a child in a wheelchair, creating an analogical mapping where the child is implicitly projected as the one performing the domestic task. This mapping is central to the meme's humor and its underlying ableist stereotype, as it associates the child's physical disability with the mundane, domestic chore of preparing mashed potatoes, implying incompetence or infantilization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3c811000"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0aed4af1",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the child in the wheelchair",
      "description": "The user is projected onto the visual material of the child in the wheelchair, as the meme implies the child is performing the task of 'making mashed potatoes'. This projection is implicit, as there are no explicit deictic pronouns like 'me' or 'you', but the user is invited to imagine themselves in the role of the child or to see the child as a representation of themselves in a context of ableist infantilization. The user is thus projected onto the child's experience and the stereotype being portrayed.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3c811000"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
