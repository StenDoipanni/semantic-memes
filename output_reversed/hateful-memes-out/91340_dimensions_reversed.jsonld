    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a0e749d7",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: this_nigga_so_black_they_had_to_change_his_background_white; hasOverallIntent: Hateful; overall-intent-description: The meme features a Black man in a black tank top against a plain white background, with overlaid text that reads, 'this nigga so black they had to change his background white.' This text is a racist trope that attempts to mock the person's skin tone by implying that his natural color is so dark that it necessitated a white background to be visible. This is a direct attack based on race, using a derogatory term ('nigga') and a stereotype that reduces the individual to a caricature of his race. The intent is to demean and insult the person's appearance through racialized humor, which is inherently hateful and reinforces harmful anti-Black stereotypes. The juxtaposition of the image (a person of color) with the text (mocking his skin tone) creates a visual and textual punchline rooted in racial prejudice.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fcd3f372"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
