    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eccf30db",
      "@type": "EmotionExpression",
      "instance_name": "mocking_contempt",
      "label": "contemptuous mockery emotion",
      "description": "The emotion expressed is contemptuous mockery, conveyed through the juxtaposition of the man's neutral facial expression with the racist text overlay that mocks his skin tone. The man's expression is not emotive but serves as a passive canvas for the hateful commentary, which is the true emotional driver of the meme. The emotion is not felt by the man but is projected by the creator of the meme to ridicule and demean.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fcd3f372"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_01a6bab7",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text maps the man's skin tone to a visual joke about needing a white background",
      "description": "The textual material 'this nigga so black they had to change his background white' is an analogical mapping that projects the visual material of the Black man's dark skin tone onto the concept of requiring a white background to be visible. This mapping is rooted in the racist trope of mocking Black skin tone by implying it is so dark that it necessitates a white background for contrast, creating a visual and textual punchline. The man's visual presence (dark skin, black tank top, white background) is directly mapped onto the textual claim that his skin is so black it required the background to be changed.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fcd3f372"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c8d3b791",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material mocking the man's skin tone",
      "description": "The user is projected onto the textual material 'this nigga so black they had to change his background white', which functions as a deictic statement directed at the viewer. The meme invites the user to perceive the man's dark skin tone as an object of ridicule, positioning the user as the one who 'sees' the joke or the 'truth' in the text. The text acts as a direct address to the user, implying that the user is the one who must interpret the visual and textual elements as a racialized punchline. The projection is onto the text_chunk, which contains the deictic framing of the joke.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_fcd3f372"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
