  "dimensions": [
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ca60dc22",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: that_chicken_was_so_black_the_police_just_arrested_it; hasOverallIntent: Hateful; overall-intent-description: The meme depicts Gordon Ramsay in an angry expression, juxtaposed with the text 'that chicken was so black the police just arrested it.' This text uses a racist stereotype by equating the color black with criminality, implying that being black (in this case, metaphorically referring to the chicken's color) leads to arrest. The humor is derived from the absurdity of the situation, but the underlying message perpetuates a harmful and hateful association between Blackness and criminal behavior, which is a well-documented anti-Black stereotype. The meme's intent is to provoke laughter through this offensive and racially charged joke, making it a hateful meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_907fc368"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
