    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_62b58906",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_criminality",
      "label": "Anti-Black Stereotype: Criminal Behavior Associations",
      "description": "The meme relies on the harmful stereotype that Black people are inherently criminal or prone to criminal behavior. This is conveyed through the text 'that chicken was so black the police just arrested it,' which uses the color black as a proxy for Blackness and implies that being Black (metaphorically) leads to arrest. This stereotype is a well-documented form of racial prejudice and is central to understanding the meme's offensive nature.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_907fc368"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e2c9b1ad",
      "@type": "BackgroundKnowledge",
      "instance_name": "gordon_ramsay",
      "label": "Gordon Ramsay",
      "description": "Gordon Ramsay is a well-known British chef, television personality, and restaurateur. His public persona is often associated with intense, fiery, and confrontational behavior, especially during cooking competitions or restaurant critiques. The image captures him in a moment of anger, which is leveraged by the meme to amplify the perceived absurdity and shock value of the text. His real-world fame and recognizable persona are essential to understanding the meme’s context and impact.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_907fc368"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aa59f1a2",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_slur_metaphor",
      "label": "Racial Slur Metaphor",
      "description": "The phrase 'that chicken was so black' is a racial slur metaphor. It uses the color black to refer to Black people, which is a common tactic in racist language to dehumanize or stereotype. The meme’s humor is derived from the absurdity of the situation, but the underlying message perpetuates a harmful and hateful association between Blackness and criminal behavior, which is a well-documented anti-Black stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_907fc368"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9b450c0f",
      "@type": "BackgroundKnowledge",
      "instance_name": "police_arrest_stereotype",
      "label": "Police Arrest Stereotype",
      "description": "The phrase 'the police just arrested it' implies that the chicken (metaphorically representing a Black person) was arrested for being black. This is a direct reference to the stereotype that Black people are more likely to be arrested or criminalized. This stereotype is rooted in systemic racism and is a key element of the meme’s hateful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_907fc368"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bd89c2f0",
      "@type": "EmotionExpression",
      "instance_name": "anger",
      "label": "angry expression",
      "description": "Gordon Ramsay is displaying a visibly angry facial expression, with furrowed brows, narrowed eyes, and an open mouth as if shouting or yelling. His body language, leaning forward toward the other person, reinforces the confrontational and enraged emotional state.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_907fc368"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cc18a911",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'that chicken was so black' is mapped onto the visual entity Gordon Ramsay, implying he is the one who is 'black' (metaphorically referring to Blackness) and thus the subject of the arrest.",
      "description": "The text 'that chicken was so black' uses a racial slur metaphor to refer to Black people. The visual entity Gordon Ramsay is mapped onto this metaphorical 'black' entity. His angry expression and confrontational posture are leveraged to amplify the absurdity of the stereotype, making the mapping between the text and his visual portrayal central to the meme's hateful intent. The mapping is established through the juxtaposition of his intense expression with the text, which projects the stereotype onto him as the subject of the joke.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_907fc368"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4e6fd30d",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene and text",
      "description": "The user is projected onto the scene of Gordon Ramsay's angry confrontation and the textual content 'that chicken was so black the police just arrested it'. The meme invites the user to imagine themselves in the role of the person being confronted or to identify with the absurdity of the situation, thereby internalizing the racist stereotype presented. The projection is implicit, not explicit with deictic pronouns, but the user is positioned as the one experiencing or interpreting the meme's content, which is centered on the visual and textual elements.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_907fc368"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1bc151a2",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme uses a racial slur metaphor to associate Blackness with criminality, perpetuating a harmful and hateful stereotype. The text 'that chicken was so black the police just arrested it' directly maps the color black to Black people and implies inherent criminality, which is a well-documented form of anti-Black racism. The visual of Gordon Ramsay's angry expression is leveraged to amplify the absurdity of the stereotype, making the mapping between the text and his portrayal central to the meme's hateful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_907fc368"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a8b0bdaa",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience for this meme is individuals who are familiar with Gordon Ramsay’s public persona and the internet meme culture that leverages his confrontational style for comedic effect. The meme relies on the audience’s recognition of Ramsay’s anger and the absurdity of the text to generate humor, which is typically appreciated by those who understand and engage with satirical, often offensive, internet humor. The audience is likely to be online users who are aware of racial stereotypes and may find the joke amusing despite its hateful content, indicating a community that consumes and shares memes that perpetuate harmful tropes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_907fc368"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
