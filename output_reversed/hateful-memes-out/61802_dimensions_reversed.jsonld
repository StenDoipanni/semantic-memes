    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a683cfef",
      "@type": "BackgroundKnowledge",
      "instance_name": "transatlantic_slave_trade",
      "label": "Transatlantic Slave Trade",
      "description": "A historical system of forced migration and enslavement of Africans across the Atlantic Ocean, primarily by European colonial powers from the 16th to 19th centuries. This event is central to understanding the visual scene as it depicts the commodification and dehumanization of Black people. The meme uses this horrific historical event to create a hateful analogy with modern consumerism, equating the sale of human beings with Black Friday sales.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed2b5d7e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_593a327d",
      "@type": "BackgroundKnowledge",
      "instance_name": "black_friday",
      "label": "Black Friday",
      "description": "An annual shopping event in the United States that occurs on the day after Thanksgiving, known for large discounts and heavy consumer spending. The term 'Black Friday' originally referred to the day when retailers' books went from a 'red' (loss) to a 'black' (profit) balance. The meme uses this commercial event to create a racially charged and offensive juxtaposition with the historical trauma of slavery, leveraging the word 'black' to reference both the racial identity of enslaved people and the color associated with the sale.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed2b5d7e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1f62ea33",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_racism",
      "label": "Anti-Black Racism",
      "description": "A system of racial discrimination and prejudice against Black people, often rooted in historical oppression such as slavery and systemic inequality. The meme perpetuates anti-Black racism by using the historical suffering of Black people to mock or trivialize the Black Friday shopping event, thereby reducing trauma to a commercial promotion and inflicting pain on a marginalized group through racialized commerce.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed2b5d7e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_91e107e0",
      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_exploitation",
      "label": "Racialized Exploitation",
      "description": "The practice of exploiting racialized identities for economic or social gain, often through dehumanizing stereotypes or historical trauma. In this meme, the commodification of human beings in slavery is equated with modern consumerism, using the term 'black' to reference both racial identity and commercial color, thereby reducing the trauma of slavery to a commercial promotion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed2b5d7e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9adcbcfb",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_revisionism",
      "label": "Historical Revisionism",
      "description": "The act of altering, distorting, or minimizing historical facts to fit a particular narrative or agenda. The meme engages in historical revisionism by trivializing the transatlantic slave trade as a 'sale,' thereby downplaying the horrific reality of slavery and its lasting impacts on Black communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed2b5d7e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5c2dea89",
      "@type": "BackgroundKnowledge",
      "instance_name": "hateful_analogy",
      "label": "Hateful Analogy",
      "description": "A comparison that is intentionally offensive, misleading, or harmful, often used to demean or dehumanize a group. In this meme, the analogy between the sale of enslaved people and Black Friday sales is hateful because it equates human suffering with consumerism, using racialized language to provoke and shock.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed2b5d7e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cb5d5271",
      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_commerce",
      "label": "Racialized Commerce",
      "description": "The use of racial identity or historical racial trauma to frame or market commercial activities. The meme uses the racial identity of Black people and the historical trauma of slavery to frame the Black Friday sale, thereby reducing the dignity and suffering of Black people to a commercial promotion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed2b5d7e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1133285a",
      "@type": "EmotionExpression",
      "instance_name": "hateful_joy",
      "label": "hateful joy expression",
      "description": "The emotion expressed is a malicious, mocking glee derived from the juxtaposition of the horrific historical trauma of the transatlantic slave trade with the commercial promotion of Black Friday. The text 'black friday sale' is used to trivialize and commodify human suffering, expressing a hateful and exploitative form of joy that derives satisfaction from inflicting pain on a marginalized group through racialized commerce.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed2b5d7e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_279a228e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Black Friday Sale is mapped onto the transatlantic slave trade scene",
      "description": "The text 'black friday sale' is juxtaposed with the visual scene of the transatlantic slave trade, creating an analogical mapping where the commercial event is equated with the historical commodification of human beings. This mapping uses the term 'black' to reference both the racial identity of the enslaved people and the color associated with the sale, thereby reducing the trauma of slavery to a commercial promotion. The mapping is hateful and racially charged, leveraging historical suffering to mock or trivialize the Black Friday shopping event.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed2b5d7e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6addeb59",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the hateful analogy between Black Friday and the transatlantic slave trade",
      "description": "The user is not explicitly projected onto a specific visual, textual, or scene element via deictic pronouns like 'me' or 'you'. However, the meme's overall intent is to project the user's perception onto the hateful analogy itself — the juxtaposition of the text 'black friday sale' with the visual of the slave trade scene. This forces the user to confront the offensive mapping, making them an implicit participant in the act of viewing and potentially internalizing the racist message. The projection is onto the entire hateful analogy, which is the core semiotic structure of the meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed2b5d7e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9aef0f6a",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful Analogy",
      "description": "The meme equates the horrific commodification of human beings in the transatlantic slave trade with the commercial promotion of Black Friday sales, using the term 'black' to reference both racial identity and commercial color. This hateful analogy trivializes historical trauma and inflicts pain on a marginalized group through racialized commerce.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed2b5d7e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2d333b20",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The target audience is individuals who are familiar with or engage with consumer culture, particularly those who participate in or are aware of Black Friday shopping events. The meme is designed to provoke a reaction from people who understand the commercial context of 'Black Friday' and may be unaware or indifferent to the racialized historical trauma being referenced. It leverages the irony and shock value of equating a modern consumer event with the transatlantic slave trade, likely targeting those who are internet-savvy and familiar with meme culture, where such provocative and offensive analogies are sometimes circulated for shock value or satire, even if they are deeply harmful. The audience is implicitly those who might find the juxtaposition amusing or ironic without recognizing its deeply offensive and racist implications.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ed2b5d7e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
