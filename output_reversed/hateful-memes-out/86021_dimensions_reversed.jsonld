    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_66966796",
      "@type": "Scene",
      "instance_name": "hitler_chill_day",
      "label": "Hitler enjoying a chill day",
      "description": "A scene depicting Adolf Hitler in a relaxed, leisurely state, juxtaposed with the text 'hitler enjoying a chill day at kehlsteinhaus'. The scene is ironic and satirical, contrasting Hitler's historical atrocities with a mundane, modern 'chill' activity. The visual material is a black-and-white portrait of Hitler, with text overlays providing context and humor.",
      "belongsToAnalysis": {
