    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a247021b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "flowers are for martin luther king day",
      "description": "The text 'flowers for martin luther king day' is juxtaposed with the visual of flowers placed inside an ice cream cone. This creates an analogical mapping where the visual material (flowers in an ice cream cone) is being presented as a representation or offering for Martin Luther King Day. The mapping is ironic, as the visual metaphor of flowers in a cone (suggesting triviality or indulgence) is contrasted with the solemnity of the holiday, implying that the offering is inappropriate or childish. The text explicitly labels the visual scene as 'flowers for martin luther king day', establishing a direct mapping between the textual description and the visual arrangement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_321eafda"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_537c8a1b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual metaphor of flowers in an ice cream cone",
      "description": "The user is projected onto the visual material (ice_cream_cone) which serves as a metaphorical container for the flowers, symbolizing a trivial or childish offering for Martin Luther King Day. The user is implicitly invited to interpret the image as a humorous or ironic commentary on the holiday, aligning with the meme's overall intent to trivialize the solemn occasion. The projection is onto the visual material because the user is expected to see the image and interpret its metaphorical meaning, which is central to the meme's effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_321eafda"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
