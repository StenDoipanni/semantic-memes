      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cbd86698",
      "@type": "BackgroundKnowledge",
      "instance_name": "martin_luther_king_day",
      "label": "Martin Luther King Day",
      "description": "A federal holiday in the United States observed on the third Monday of January to honor the life and work of Dr. Martin Luther King Jr., a pivotal figure in the American civil rights movement. It is a day for reflection, education, and community service, not trivialization.",
      "belongsToAnalysis": {
