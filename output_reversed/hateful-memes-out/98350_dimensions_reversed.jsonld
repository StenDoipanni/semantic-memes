    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_50aeb05d",
      "@type": "BackgroundKnowledge",
      "instance_name": "trivialization",
      "label": "Trivialization",
      "description": "The act of reducing something of great importance or solemnity to something insignificant or childish. In this meme, the serious commemoration of Dr. King's legacy is juxtaposed with a childish image (flowers in an ice cream cone), which is a form of trivialization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_321eafda"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
