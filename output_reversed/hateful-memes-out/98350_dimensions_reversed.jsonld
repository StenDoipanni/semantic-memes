      "instance_name": "visual_metaphor",
      "label": "Visual Metaphor",
      "description": "A figure of speech that uses an image to represent an idea or concept. In this meme, the ice cream cone (symbolizing indulgence or fleeting pleasure) is used as a metaphor to contrast with the solemnity of Martin Luther King Day, creating irony or humor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_321eafda"
