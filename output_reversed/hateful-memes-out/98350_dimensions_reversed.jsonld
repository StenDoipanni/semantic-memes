    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e121266e",
      "@type": "BackgroundKnowledge",
      "instance_name": "civil_rights_movement",
      "label": "Civil Rights Movement",
      "description": "A major social movement in the United States during the 1950s and 1960s aimed at ending racial segregation and discrimination against African Americans and securing legal recognition and federal protection of their rights. Dr. King was a central leader of this movement.",
      "belongsToAnalysis": {
