    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aa13723b",
      "@type": "EmotionExpression",
      "instance_name": "mockery",
      "label": "mocking emotion",
      "description": "The emotion expressed is mockery, conveyed through the ironic juxtaposition of flowers in an ice cream cone with the solemn commemoration of Martin Luther King Day. The visual metaphor of placing a symbol of celebration or indulgence (flowers in a cone) against a serious historical observance creates a humorous or sarcastic tone, implying trivialization.",
      "belongsToAnalysis": {
