    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cdce2f88",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The text 'no pity sex?' is mapped onto the visual of the man in the police uniform.",
      "description": "The top text overlay 'no pity sex?' is juxtaposed with the visual of the bald man in a police uniform. This creates an analogical mapping where the man is implicitly identified as the subject of the phrase 'no pity sex?'. The phrase is a dehumanizing stereotype that hypersexualizes Black men, and by mapping it onto the visual of the police officer, the meme equates the officer with this stereotype, suggesting he embodies or represents this hypersexualized, predatory Black male trope. This mapping reinforces the hateful intent by linking the visual of a police officer to a racist trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e4eef98"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_add74df9",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual material of the police officer",
      "description": "The user is projected onto the visual material of the man in the police uniform, as the meme uses his image to embody the hateful stereotypes presented in the text. The user is implicitly invited to identify with or project their own perspective onto this visual representation, which is then used to reinforce the racist and dehumanizing message. The visual of the officer is central to the meme's projection, as it is the focal point onto which the hateful text is mapped and interpreted.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3e4eef98"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
