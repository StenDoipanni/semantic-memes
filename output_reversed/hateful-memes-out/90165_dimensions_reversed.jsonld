      "instance_name": "workplace_misconduct",
      "label": "Workplace Misconduct",
      "description": "Unethical or illegal behavior occurring in a professional setting, such as harassment, fraud, or negligence. The meme is often used to frame such misconduct as the result of collective inaction rather than individual malfeasance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e359830"
