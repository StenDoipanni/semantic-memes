      "@type": "BackgroundKnowledge",
      "instance_name": "corporate_scandal",
      "label": "Corporate Scandal",
      "description": "A real-world event or situation involving unethical or illegal behavior by a corporation or its employees, often leading to public outcry and legal consequences. The meme is commonly used in the context of such scandals to argue that the failure was due to systemic issues, not one person.",
      "belongsToAnalysis": {
