    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e96abc2c",
      "@type": "BackgroundKnowledge",
      "instance_name": "complicity",
      "label": "Complicity",
      "description": "The state of being involved in wrongdoing, often unintentionally or by omission. The meme suggests that the group's inaction or failure to challenge wrongdoing constitutes complicity, even if they claim to be 'just doing their jobs'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e359830"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c7d64945",
      "@type": "BackgroundKnowledge",
      "instance_name": "deflecting_accountability",
      "label": "Deflecting Accountability",
      "description": "The act of shifting blame away from oneself or a specific individual to a group or system. This is the core rhetorical strategy of the meme, which uses the visual of a diverse group to imply that the failure was not due to one person but due to the group's collective actions or inactions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e359830"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_926a8eac",
      "@type": "EmotionExpression",
      "instance_name": "collective_confidence",
      "label": "collective confidence expression",
      "description": "The group of professionals is posing together with smiles and confident postures, conveying a sense of self-assurance and collective pride in their roles. Their body language—hands on hips, direct eye contact with the camera, and upright stances—suggests they are portraying themselves as competent and in control, aligning with the meme's message that they were 'just doing their jobs'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e359830"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7bbe83b8",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The group of professionals is mapped as 'people who were just doing their jobs'",
      "description": "The text 'it happened because of people who were just doing their jobs' is directly analogically mapped onto the visual entity 'person' (the diverse group of six professionals). The visual depiction of the group posing confidently in business attire, with smiles and professional postures, serves as the visual representation of the textual claim that they were merely performing their duties. This mapping is central to the meme's intent to deflect accountability by attributing collective responsibility to the group rather than a single individual.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e359830"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_acbd5156",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the group of professionals as 'people who were just doing their jobs'",
      "description": "The user is projected onto the visual entity 'person' (the diverse group of six professionals) through the textual message 'it happened because of people who were just doing their jobs'. The user identifies with or imagines themselves as part of this group, adopting the perspective of collective responsibility and apathy. This projection is implicit, not explicit, but is inferred from the meme's rhetorical device of deflecting accountability by attributing failure to a group rather than a single individual. The user sees themselves as part of the 'system' or 'organization' that failed, and thus identifies with the group's posture and demeanor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e359830"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_214171cc",
