    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_523c6d0c",
      "@type": "BackgroundKnowledge",
      "instance_name": "collective_accountability_meme",
      "label": "Collective Accountability Meme",
      "description": "A meme format that shifts blame from a single individual to a group, often used to deflect responsibility in corporate scandals, workplace misconduct, or social issues. It relies on the visual of a diverse group to imply systemic or organizational failure rather than individual malfeasance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e359830"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b210aec0",
      "@type": "BackgroundKnowledge",
      "instance_name": "scapegoating",
      "label": "Scapegoating",
      "description": "The practice of blaming a single individual or group for a problem or failure, often to avoid addressing systemic issues or collective responsibility. This meme uses scapegoating as its rhetorical device to deflect accountability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e359830"
