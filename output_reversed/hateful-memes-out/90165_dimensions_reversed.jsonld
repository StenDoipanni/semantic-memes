      "@type": "BackgroundKnowledge",
      "instance_name": "systemic_apathy",
      "label": "Systemic Apathy",
      "description": "A state of widespread indifference or lack of concern within a system or organization, often used to describe the failure to act on known problems. The meme implies that the group's 'just doing their jobs' attitude represents systemic apathy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e359830"
      },
