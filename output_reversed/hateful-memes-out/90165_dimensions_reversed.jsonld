    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5d4ef997",
      "@type": "TargetCommunity",
      "instance_name": "person",
      "label": "professionals in a corporate setting",
      "description": "The target community is professionals, particularly those in corporate or organizational environments, who may be familiar with workplace dynamics, corporate scandals, or discussions around accountability and systemic failure. The visual of a diverse group in business attire and the textual message about 'doing their jobs' directly address this audience, implying they are the ones being referenced as complicit in organizational failures. The meme is designed to resonate with individuals who have experienced or observed workplace misconduct, corporate scandals, or situations where blame is shifted to a group rather than an individual, making it relevant to employees, managers, and those engaged in organizational critique.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1e359830"
      },
      "extractionMethod": "llm_extraction_huggingface"
