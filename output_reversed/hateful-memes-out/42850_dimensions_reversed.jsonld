      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_753b34e4",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the advocacy message of the meme",
      "description": "The user is projected onto the overall advocacy message conveyed by the scene, which frames abortion as a medical and affordable procedure. The user is implicitly invited to align with the values of legality and affordability promoted in the text and visual elements. There are no explicit deictic pronouns like 'you' or 'me', but the call to action ('keep it legal.' and 'keep it affordable!') creates an implicit projection of the user as an advocate or supporter of the stated goals.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1d8bfb01"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ee50ca4f",
      "@type": "TargetCommunity",
      "instance_name": "medical_abortion_advocacy",
      "label": "Medical Abortion Advocacy Community",
      "description": "The target community is individuals and groups actively involved in or supportive of reproductive rights and healthcare policy advocacy, particularly those focused on ensuring abortion remains legal and affordable. The visual and textual elements—stethoscope (medical legitimacy), 'keep it legal', 'keep it affordable!', and the word 'ABORTION'—are designed to resonate with advocates, policymakers, healthcare professionals, and the general public who support access to reproductive healthcare as a fundamental medical right. The meme frames abortion as a public health issue within the healthcare system, appealing to those who view it through a policy and medical lens rather than a moral or social one.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1d8bfb01"
      },
      "extractionMethod": "llm_extraction_huggingface"
