    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8a9fb0fd",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The smug expression is mapped onto the look on your face after killing someone",
      "description": "The text 'the look on your face after killing someone!' explicitly maps the visual entity 'man' (with his smug expression) onto the textual concept of a person's facial expression immediately following a murder. This is a direct analogical mapping where the visual material (the man's calm, smug expression) is interpreted as embodying the textual description (the look after killing someone). The mapping is established through the juxtaposition of the text and the visual, creating a conceptual link between the man's demeanor and the violent act described.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_efd490d3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_71f845d4",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material describing the implied crime",
      "description": "The user is projected onto the textual material 'after killing someone!' which directly addresses the viewer by implying the viewer is the one who has committed the act. The phrase 'the look on your face' explicitly uses 'your' to direct the projection onto the viewer, making the viewer the subject of the implied crime. This creates a direct semiotic projection where the user is imagined as the perpetrator, and the visual material (the man's expression) is interpreted as the reaction of that imagined self.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_efd490d3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ce941619",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme depicts a man with a calm, smug expression overlaid with text that reads 'the look on your face after killing someone!'. This juxtaposition is intended to be shocking and provocative, using a well-known meme format to imply that the person depicted is guilty of a serious crime. The meme's intent is to elicit strong emotional reactions (shock, disgust, outrage) from viewers by associating the subject with extreme violence. While it does not target any specific protected group, it is harmful because it promotes a violent and morally reprehensible act, potentially normalizing or trivializing murder. The meme is not abusive or cyberbullying in the traditional sense, but it is harmful as it encourages viewers to imagine or associate the subject with a horrific crime, which can be psychologically disturbing and may contribute to a culture that glorifies or sensationalizes violence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_efd490d3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7c653279",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "internet meme enthusiasts",
      "description": "The meme targets individuals familiar with internet meme culture, particularly those who recognize and engage with the 'The Look on Your Face' format. This audience appreciates shock value, irony, and the juxtaposition of calm demeanor with extreme violence, often using such memes for satire, commentary, or to provoke strong reactions. The meme's effectiveness relies on the audience's understanding of this specific meme format and its cultural context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_efd490d3"
