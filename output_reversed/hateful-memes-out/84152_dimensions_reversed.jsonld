    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4b73b187",
      "@type": "BackgroundKnowledge",
      "instance_name": "dishwasher_failure_meme_concept",
      "label": "Concept of appliance failure as a major life event",
      "description": "The meme uses hyperbole to express the emotional weight of a broken dishwasher by comparing it to death. This relies on the cultural understanding that major household appliances are expensive, long-lasting investments, and their failure can be deeply frustrating and disruptive to daily life. The humor comes from the absurdity of equating appliance failure with mortality.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_63ae224f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bba2e2e4",
      "@type": "BackgroundKnowledge",
      "instance_name": "cultural_stereotype_of_women_in_kitchen",
      "label": "Stereotype that women belong in the kitchen",
      "description": "The image of a woman in a coffin, juxtaposed with a broken dishwasher, implicitly references the stereotype that women are primarily responsible for household chores, including dishwashing. The meme exaggerates the emotional impact of appliance failure on the person who is stereotypically expected to handle it, adding a layer of gendered humor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_63ae224f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_928997ae",
      "@type": "BackgroundKnowledge",
      "instance_name": "dark_humor_concept",
      "label": "Use of dark humor to express frustration",
      "description": "The meme employs dark humor, which uses morbid or taboo subjects (like death) to create comedic effect. This requires background knowledge of how dark humor functions in popular culture to understand why the image of a woman in a coffin is used to express frustration over a broken dishwasher.",
      "belongsToAnalysis": {
