    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_78f75c6c",
      "@type": "EmotionExpression",
      "instance_name": "frustration",
      "label": "frustrated emotion",
      "description": "The woman's facial expression, with wide eyes and slightly parted lips, conveys a sense of shock, dismay, and exasperation, reflecting the emotional weight of a broken dishwasher. This is amplified by the dark humor of her being in a coffin, symbolizing the perceived finality of the appliance's failure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_63ae224f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2386ebe4",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The woman in the coffin is mapped as the person experiencing the finality of a broken dishwasher.",
      "description": "The text 'when your dishwasher is done for good' implies that the dishwasher has reached the end of its functional life. The visual of the woman in a coffin, a symbol of death and finality, is used to analogically represent the perceived finality and emotional weight of the dishwasher's failure. The mapping is established through the juxtaposition of the text and the image, where the woman's shocked expression and the coffin symbolize the user's emotional reaction to the appliance's demise. This is a classic example of dark humor, where the visual material (woman in coffin) is mapped onto the textual concept (dishwasher failure) to exaggerate the emotional impact.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_63ae224f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e171afac",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of the woman in the coffin",
      "description": "The user is projected onto the scene of the woman in the coffin, as the text 'when your dishwasher is done for good' uses the deictic 'your' to directly address the viewer. This implies the user is the person experiencing the frustration of a broken dishwasher, and the visual of the woman in the coffin is used to represent their emotional state. The projection is onto the scene entity 'woman_in_coffin', which serves as the visual embodiment of the user's imagined reaction to appliance failure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_63ae224f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
