  "dimensions": [
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1cb75067",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: meme_file_name; hasOverallIntent: ableism; overall-intent-description: The image features a person with a developmental disability, smiling broadly, with text that reads: 'we wouldn't change him for the world. but we wish the world would change for him.' This juxtaposition creates a tone of affection and acceptance while simultaneously implying that the individual is not fully capable of navigating or thriving in the current world. This reflects a common ableist trope — 'inspiration porn' or 'pity narratives' — where the person's disability is framed as a reason for societal change rather than a reason for inclusion and accommodation. The meme's intent is to evoke sympathy while subtly reinforcing the idea that the person's existence is a burden or requires external modification, which is harmful and perpetuates ableist attitudes by suggesting that the world is not inherently accessible or welcoming to people with disabilities. The overall intent is to normalize the idea that people with disabilities are 'different' and need the world to adapt to them, rather than being fully integrated into society as equal members.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9395e1e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_453efb04",
      "@type": "TextualMaterial",
      "instance_name": "top_text",
      "label": "top text overlay",
      "description": "we wouldn't change him for the world.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9395e1e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fb2b8ee5",
      "@type": "VisualMaterial",
      "instance_name": "person",
      "label": "individual with developmental disability",
      "description": "A smiling man with short brown hair and a visible developmental disability, wearing a dark blue polo shirt. He is the central focus of the image, positioned in the foreground with a blurred background. His expression is joyful and engaging, contrasting with the text's underlying ableist message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9395e1e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7efbbd36",
      "@type": "Scene",
      "instance_name": "affectionate_but_ableist_message",
      "label": "Scene of a person with developmental disability smiling with contrasting text",
      "description": "The scene centers on a smiling person with developmental disability, positioned in the foreground, with overlaid text that expresses affection ('we wouldn't change him for the world') while simultaneously implying societal inadequacy ('but we wish the world would change for him'). The spatial arrangement places the person as the focal point, with the text framing the emotional and ableist message. The scene's structure is defined by the juxtaposition of the person's joyful expression and the text's underlying ableist trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9395e1e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c959e629",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableist_trope_insiration_porn",
      "label": "Inspiration Porn / Pity Narrative",
      "description": "A cultural phenomenon where people with disabilities are portrayed as inspirational or pitiable, often to evoke sympathy while reinforcing the idea that they are fundamentally different or incapable of full societal participation without external modification. This trope is used to normalize the idea that the world must change for disabled people rather than being fully integrated as equals.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9395e1e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_987f5d72",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableist_trope_burden_on_society",
      "label": "Burden on Society Stereotype",
      "description": "A stereotype that portrays people with disabilities as a financial or social burden, implying they are not capable of contributing to society or that their existence requires societal adaptation rather than inclusion. This is often used to justify exclusionary policies or attitudes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9395e1e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7c4fb34f",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableist_trope_infantilization",
      "label": "Developmental Disability Infantilization",
      "description": "A stereotype that portrays individuals with developmental disabilities as childlike or incapable of adult responsibilities, which justifies the need for societal adaptation rather than inclusion. This trope undermines their autonomy and competence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9395e1e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b25ac848",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableist_trope_independence_denial",
      "label": "Independence/Competence Denial",
      "description": "A stereotype that denies the independence and competence of people with disabilities, implying they are incapable of self-sufficiency or making decisions without external support. This reinforces the idea that the world must change for them.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9395e1e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1abb7700",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableist_trope_societal_change_required",
      "label": "Societal Change Required Framing",
      "description": "A framing that implies the world must change to accommodate people with disabilities, rather than the society adapting to include them as equal members. This trope shifts the responsibility for inclusion onto the disabled person’s environment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9395e1e6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
