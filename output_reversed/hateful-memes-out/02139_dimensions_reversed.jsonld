    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_74faa0a4",
      "@type": "AnalogicalMapping",
      "instance_name": "no_less_beautiful_mapping",
      "label": "The woman is mapped as 'no less beautiful'",
      "description": "The text 'no less beautiful' is overlaid on the image of the woman, creating an analogical mapping where the woman (visual entity) is being identified as 'no less beautiful' (textual entity). This mapping is central to the meme's intent, affirming her beauty and value in a celebratory context. The phrase 'no less beautiful' is a common meme format used to express admiration and validation, and in this case, it is directly projected onto the visual subject, Tilda Swinton, who is the focus of the admiration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e814df67"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c6df8116",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman as an object of admiration",
      "description": "The user is projected onto the visual material of the woman (Tilda Swinton), interpreting her as the subject of the affirmation 'no less beautiful'. The meme format invites the user to identify with the celebratory message directed at the woman, seeing her as a figure worthy of admiration. There are no explicit deictic pronouns like 'me' or 'you', but the implicit projection is onto the woman as the recipient of the affirmation, making her the focal point of the user's projected admiration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e814df67"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
