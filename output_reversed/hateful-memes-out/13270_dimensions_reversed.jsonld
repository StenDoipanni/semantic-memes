    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_500a7f9c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_2",
      "label": "The text 'trump is still your president' is mapped onto the person in the wizard costume",
      "description": "The bottom text 'trump is still your president' asserts political authority and loyalty. The person in the wizard costume, despite their absurd or mocking appearance, is visually positioned as the embodiment of the message — the 'president' or the figure who remains in power regardless of dissent. This creates an analogical mapping where the textual concept of 'president' is visually instantiated by the person in the costume, even though the costume is metaphorical and ironic.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5ffae2f1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5dcba72a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the person in the wizard costume via the text 'you'",
      "description": "The top text overlay 'remember no matter how much you whine like a little bitch' directly addresses the viewer or critic, explicitly projecting the user onto the person depicted in the visual material. The 'you' in the text is deictically pointing to the user, making them the target of the criticism. The person in the wizard costume is visually presented as the embodiment of the criticized 'you'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5ffae2f1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_334a29f6",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_2",
      "label": "User projected onto the person in the wizard costume via the text 'your president'",
      "description": "The bottom text 'trump is still your president' projects the user onto the person in the wizard costume by using the possessive pronoun 'your'. This implies that the political authority of Trump belongs to the user, and the person in the costume visually represents this ownership or loyalty. The costume, though absurd, is used to symbolize the user's allegiance to Trump's presidency.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5ffae2f1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
