    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f58775e7",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The text 'I am against gun, violence and discrimination' is mapped onto the smiling Black man in the foreground.",
      "description": "The text explicitly states 'I am against...', which directly projects the speaker's identity (the person who is against these issues) onto the visual entity — the Black man in the foreground. His joyful expression, rainbow lanyard, and presence at a Pride event visually represent his identity as an ally and advocate for the causes mentioned in the text. The mapping is established by the textual 'I' being attributed to the visual subject, making him the embodiment of the message. This is a classic analogical mapping where the visual subject is identified as the speaker of the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cc074793"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9845eedd",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the smiling Black man as the speaker of the message",
      "description": "The text 'I am against gun, violence and discrimination' explicitly projects the user's identity (the speaker) onto the visual entity — the Black man in the foreground. The use of 'I' directly attributes the message to him, making him the embodiment of the statement. The user is thus projected onto this visual material, identifying him as the source of the message. This projection is reinforced by the man's joyful expression, rainbow lanyard, and presence at a Pride event, which visually represent his identity as an ally and advocate for the causes mentioned in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cc074793"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
