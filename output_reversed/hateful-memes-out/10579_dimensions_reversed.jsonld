        "@id": "http://example.org/multimodal-taxonomy#analysis_2936f053"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_02122594",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who hold or are sympathetic to the view that systemic racism is an overblown concept and that blaming an entire racial group for historical actions of a minority is itself racist. This audience likely includes people who are politically or culturally aligned with right-wing or white nationalist ideologies, or those who are skeptical of racial justice movements. The meme is designed to resonate with those who interpret historical statistics as evidence against collective racial blame, and who may use such arguments to dismiss critiques of systemic racism. The confrontational tone and accusatory gesture are intended to appeal to an audience that values individual responsibility over collective identity and may be receptive to arguments that frame racial discourse as inherently racist or divisive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2936f053"
