    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_78cfc14b",
      "@type": "BackgroundKnowledge",
      "instance_name": "propaganda",
      "label": "Propaganda",
      "description": "The deliberate, often biased dissemination of information to influence public opinion. The image of Hitler raising his fist is a classic example of Nazi propaganda, used to project strength and unity. The meme leverages this visual trope to create a false narrative, which requires understanding the historical use of propaganda to be fully comprehended.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_798b0878"
