      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_69c64c90",
      "@type": "BackgroundKnowledge",
      "instance_name": "genocide",
      "label": "Genocide",
      "description": "The deliberate and systematic destruction of a racial, political, or cultural group. The Holocaust is the most infamous example of genocide. The meme's text falsely attributes a justification for genocide to Hitler, which requires background knowledge of the term and its historical application to understand the meme's offensive content.",
      "belongsToAnalysis": {
