    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e393b1eb",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Hitler is mapped as the speaker of the hateful justification",
      "description": "The text 'i could have killed all of them. but i let some of them survive so you know why i killed them.' is overlaid on the image of Adolf Hitler delivering a propagandistic speech. The visual material (Adolf_Hitler in a propagandistic pose) is mapped onto the textual material (the hateful justification) to imply that Hitler is the one who is speaking this fabricated justification. This is an analogical mapping where the visual entity (Adolf_Hitler) is projected as the entity performing the action described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_798b0878"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_39e2e129",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material via deictic pronouns",
      "description": "The meme's text contains the deictic pronouns 'i' and 'you', which directly address the viewer/user. The user is projected onto the textual material (text_chunk_1) as the implied recipient of the message. The text 'i could have killed all of them. but i let some of them survive so you know why i killed them.' uses 'i' to attribute the action to Hitler (as visually projected) and 'you' to address the viewer, making the user the target of the hateful justification. This creates a direct semiotic projection where the user is positioned as the one being addressed by the fictionalized narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_798b0878"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
