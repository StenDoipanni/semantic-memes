      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5ca30ec8",
      "@type": "BackgroundKnowledge",
      "instance_name": "antisemitism",
      "label": "Antisemitism",
      "description": "Discrimination, prejudice, or hostility directed against Jewish people. The meme uses Hitler's image to evoke the historical context of antisemitism and the Holocaust, which is a core component of its hateful message. Understanding antisemitism is crucial to grasp the offensive nature of the meme and the stereotypes it invokes.",
      "belongsToAnalysis": {
