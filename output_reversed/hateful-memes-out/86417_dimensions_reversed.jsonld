    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eac6aace",
      "@type": "VisualMaterial",
      "instance_name": "Adolf_Hitler",
      "label": "historical figure",
      "description": "A man in a military-style uniform with a raised right fist, standing in front of a microphone. He is depicted in a propagandistic pose, looking upward and to the side with an intense expression. This is a well-known historical photograph of Adolf Hitler, the leader of Nazi Germany, who orchestrated the Holocaust and genocide. The image is used here in a meme context with overlaid text that falsely attributes a twisted justification to him, making it deeply offensive and hateful.",
      "belongsToAnalysis": {
