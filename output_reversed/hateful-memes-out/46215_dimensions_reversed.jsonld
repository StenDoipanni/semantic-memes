    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7827d99b",
      "@type": "EmotionExpression",
      "instance_name": "mocking_laughter",
      "label": "mocking and derisive laughter",
      "description": "The three men are laughing heartily while holding cups, their expressions conveying amusement that is clearly mocking or sarcastic, directed at the implied object of the meme (a woman). Their body language and facial expressions suggest they are ridiculing the idea that a woman might find them special, reinforcing the misogynistic tone of the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_506e9b36"
