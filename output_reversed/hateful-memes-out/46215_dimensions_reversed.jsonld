    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_60fb31bf",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The text 'you think that hoe thinks you're special' is mapped onto the laughing friends.",
      "description": "The top text 'you think that hoe thinks you're special' is juxtaposed with the visual of three men laughing together. The laughter and camaraderie of the men are mapped onto the textual claim that a woman (the 'hoe') thinks they are special, implying that the men are mocking the idea that any woman would find them special. The visual of their shared, mocking laughter serves as the visual representation of the text's content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_506e9b36"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_00bac7a8",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the laughing friends scene",
      "description": "The user is projected onto the scene of the three laughing men, as the meme's humor and the text's implication (that the 'hoe' says this to them) create an identification with the men's perspective and their mocking laughter. The user sees themselves as part of the group laughing at the idea of being thought special by a woman.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_506e9b36"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3102f9c5",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Mysogynous",
      "description": "The meme uses the derogatory term 'hoe' to demean women, implying they are sexually promiscuous and unworthy of respect. It mocks the idea that a woman might find the men special, reducing a woman's worth to her sexual behavior and portraying her as foolish or laughable. This reflects a misogynistic attitude by devaluing women through sexist language and stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_506e9b36"
      },
      "extractionMethod": "llm_extraction_huggingface"
