    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_92d8a359",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Human hand is mapped as 'let's end racism' metaphor",
      "description": "The text 'let's end racism' is juxtaposed with the visual of a human hand holding an orangutan's hand. This creates an analogical mapping where the human hand (a symbol of human agency) is implicitly mapped onto the concept of 'ending racism', while the orangutan hand (a symbol of non-human primates) is mapped onto the concept of 'racism' itself. This mapping is problematic as it invokes the harmful anti-Black stereotype of comparing Black people to primates, thereby equating racism with non-human primates. The visual metaphor is used to represent the act of ending racism, but the imagery reinforces a dehumanizing trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75c62fe5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_823e2a2e",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the human hand as an agent of change",
      "description": "The user is projected onto the human hand (visual material) as the active agent who is 'letting's end racism'. The hand is the focal point of human intervention and agency in the meme, symbolizing the user's role in taking action against racism. The user is implicitly positioned as the 'we' or 'I' in the call to action, making the hand the embodied projection of the user's intent to end racism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75c62fe5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
