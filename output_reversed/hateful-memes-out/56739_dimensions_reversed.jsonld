    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b427c9df",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Nancy Pelosi is mapped as the embodiment of the political platform described in the text",
      "description": "The text 'our platform is simple: regain power, destroy the economy, impeach trump' is overlaid on the image of Nancy Pelosi. This creates an analogical mapping where Nancy Pelosi (the visual entity) is being presented as the person or figure who represents or embodies this satirical political platform. The meme implies that Pelosi is the one who is advocating for or responsible for this platform, even though the text is presented as a satirical summary of her actions or motives. The mapping is established through the direct juxtaposition of her image with the text that attributes these specific political goals to her.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c1c8abd1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4fb73413",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the satirical political platform text",
      "description": "The user is projected onto the textual material that outlines the satirical platform ('regain power, destroy the economy, impeach trump'), which is overlaid on the image of Nancy Pelosi. The meme invites the user to identify with or interpret the platform as if it were a genuine political agenda, thereby projecting the user's perspective onto this textual construct. There are no explicit deictic pronouns like 'you' or 'me' in the text, but the framing of the text as 'our platform' implicitly invites the user to adopt the perspective of the group or entity being satirized, making the user a participant in the meme's constructed narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c1c8abd1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_18a07046",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme portrays Nancy Pelosi as advocating for a platform that includes 'destroy the economy,' which is a harmful and economically damaging claim. This framing simplifies complex political actions into a self-serving, destructive agenda, potentially inciting division and hostility toward her or her party. The meme's intent is propagandistic and aims to sway opinion by associating her with negative outcomes, which could be perceived as harmful to democratic discourse or political stability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c1c8abd1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
