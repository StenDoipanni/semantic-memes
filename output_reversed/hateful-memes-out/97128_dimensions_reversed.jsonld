    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a3ab00a6",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype",
      "label": "Anti-Black Stereotype: Black people are hypersensitive to the smell of 'nigger'",
      "description": "This meme relies on a deeply offensive and racist stereotype that falsely claims Black people use air fresheners because they are unable to tolerate the smell of the racial slur 'nigger'. This is a form of racial dehumanization that implies Black people are repelled by their own racial identity, which is a harmful and false generalization. It is part of a broader history of anti-Black racism that uses degrading metaphors and false assumptions to demean Black individuals.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3403afc1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
