    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c6f0c838",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Obama voters are mapped onto chimpanzees",
      "description": "The text 'obama voters' is overlaid on an image of three chimpanzees in a forest. This creates an analogical mapping where the textual entity 'obama voters' is projected onto the visual entity 'chimpanzee'. The mapping implies that Obama voters are equated with chimpanzees, invoking a racist stereotype that dehumanizes and portrays them as primitive or unintelligent. This is a direct visual-textual juxtaposition where the text explicitly labels the visual subject with a derogatory association.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d6e94d38"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
