    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5e8a26c0",
      "@type": "Scene",
      "instance_name": "rhetorical_statement_scene",
      "label": "rhetorical_statement",
      "description": "A scene where a man in a suit is delivering a rhetorical message, visually emphasized by his open-armed gesture and overlaid text that reads: 'everyone talking about protecting minority rights needs to remember there is no smaller minority than the individual.' The scene conveys a philosophical or moral argument about individual rights as the foundational unit of minority protection.",
      "belongsToAnalysis": {
