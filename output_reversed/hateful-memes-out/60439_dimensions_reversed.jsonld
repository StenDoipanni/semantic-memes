      "@id": "http://example.org/multimodal-taxonomy#dimension_a413b0ec",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals who are likely to engage with or share racially charged, historically revisionist content online, particularly those who may be exposed to or propagate false claims about the Civil War and abolitionist movement. The meme is designed to provoke outrage or dismiss the historical context of slavery and abolition, targeting those who might be susceptible to or supportive of distorted historical narratives that promote racial division. The inclusion of the username 'jf16' suggests the meme is intended for a user-generated content platform audience, likely those who consume and share memes that challenge or mock historical narratives, often with a focus on racial or political polarization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a57d3724"
