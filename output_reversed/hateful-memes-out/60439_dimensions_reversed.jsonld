    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_df075b12",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'over 620 000 white people died to free black slaves' is mapped onto the group of diverse women.",
      "description": "The top text claims that white people died to free black slaves, and this statement is visually juxtaposed with the image of a group of diverse women. The mapping implies that the women, who represent different racial backgrounds, are the beneficiaries of the historical sacrifice mentioned in the text. This is a distortion of history, as the text falsely frames the sacrifice of white lives as being made for the benefit of Black people, which is a racist stereotype. The visual material (the group of diverse women) is being used to visually represent the 'black slaves' or the 'beneficiaries' mentioned in the text, creating an analogical mapping where the women are mapped as the recipients of the historical sacrifice.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a57d3724"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f310917c",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the top text 'over 620 000 white people died to free black slaves' which is presented as a false historical claim. The user, as the creator or viewer of the meme, is implicitly positioned as someone who is being asked to accept or engage with this distorted narrative. The text is the focal point of the projection, as it contains the hateful and false claim that the user is being urged to 'cut the bullshit out' of, indicating the user is the target of the meme's rhetorical stance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a57d3724"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
