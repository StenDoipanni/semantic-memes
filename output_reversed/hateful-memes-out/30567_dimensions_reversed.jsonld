    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_830af30b",
      "@type": "EmotionExpression",
      "instance_name": "mocking_joy",
      "label": "mocking and ironic happiness",
      "description": "The drag queens are smiling broadly and posing for a selfie, but their expressions are juxtaposed with a cynical text that dismisses systemic inequality as a result of individual effort. The visual joy contrasts with the critical message, creating an ironic or mocking emotional tone.",
      "belongsToAnalysis": {
