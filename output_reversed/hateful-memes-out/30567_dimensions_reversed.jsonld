    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c31db622",
      "@type": "BackgroundKnowledge",
      "instance_name": "stereotype_of_drag_queens_as_entertainers",
      "label": "Stereotype of Drag Queens as Entertainers",
      "description": "The common perception that drag queens are primarily performers or entertainers, which can be used to dismiss their lived experiences or the systemic issues they may face. This stereotype is implicitly referenced in the meme's juxtaposition of glamour with a cynical message.",
      "belongsToAnalysis": {
