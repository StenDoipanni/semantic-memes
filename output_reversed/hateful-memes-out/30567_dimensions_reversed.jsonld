    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_badcea1d",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_format_of_juxtaposition",
      "label": "Meme Format of Juxtaposition",
      "description": "The common meme technique of placing contrasting visuals or ideas together to create irony or satire. Understanding this format helps interpret the meme's intent to use the glamorous image of drag queens to mock the simplistic economic message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8ecb0f5a"
