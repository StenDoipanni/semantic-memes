    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_63a32242",
      "@type": "BackgroundKnowledge",
      "instance_name": "economic_determinism",
      "label": "Economic Determinism",
      "description": "The belief that economic outcomes are primarily determined by individual effort and choices, ignoring structural factors like wealth distribution, access to education, and systemic discrimination. This is the ideology the meme is mocking.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8ecb0f5a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7b7c9ef9",
      "@type": "BackgroundKnowledge",
      "instance_name": "LGBTQ_community_systemic_barriers",
      "label": "Systemic Barriers Faced by the LGBTQ+ Community",
      "description": "The real-world knowledge that LGBTQ+ individuals, particularly those from marginalized racial or socioeconomic backgrounds, often face systemic discrimination, including employment bias, housing discrimination, and lack of access to healthcare. This context is necessary to understand why the meme's message may be perceived as dismissive or harmful.",
      "belongsToAnalysis": {
