    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f3aa8a1e",
      "@type": "VisualMaterial",
      "instance_name": "three_women",
      "label": "people",
      "description": "Three women posing together at an event, dressed in formal or semi-formal attire. From left to right: a woman in a light pink dress, a woman in a black floral dress, and a woman in a purple top. All are smiling and appear to be at a sponsored event, as indicated by the backdrop.",
