    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1cb174bb",
      "@type": "Scene",
      "instance_name": "women_at_event",
      "label": "Three women posing together at a sponsored event",
      "description": "The scene depicts three women standing side-by-side in front of a branded backdrop, smiling and posing for a photo. The backdrop features logos from sponsors such as 'CBRE', 'BLADE', 'Sotheby's International Realty', and 'Hudson River PK Friends'. The women are dressed in formal or semi-formal attire. The text 'slow cooker' is superimposed at the bottom, creating a meme that juxtaposes their professional appearance with a domestic stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_780682b3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_54975366",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_stereotype_belongs_in_kitchen",
      "label": "Misogynous Stereotype: 'Women Belong in the Kitchen'",
      "description": "This is a longstanding cultural stereotype that implies women are naturally suited for domestic roles, such as cooking and cleaning, and are not suited for professional or public roles. The meme uses this stereotype to mock the women in the image by juxtaposing their professional appearance with the domestic appliance 'slow cooker', implying they are 'out of place' in their public setting.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_780682b3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e1954e71",
      "@type": "BackgroundKnowledge",
      "instance_name": "domestic_appliance_slow_cooker",
      "label": "Domestic Appliance: Slow Cooker",
      "description": "A slow cooker is a kitchen appliance used for preparing meals over a long period. It is a symbol of domesticity and home cooking, often associated with traditional, non-professional, or non-public roles for women. In the meme, it is used as a derogatory metaphor to imply that the women are 'reduced' to a domestic function.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_780682b3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b5e3503a",
      "@type": "BackgroundKnowledge",
      "instance_name": "gender_role_norms",
      "label": "Gender Role Norms",
      "description": "Historical and societal expectations that assign specific roles to men and women based on gender. These norms have often dictated that women should be primarily caregivers and homemakers, while men should be breadwinners and public figures. The meme critiques these outdated norms by mocking the women's presence in a professional setting.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_780682b3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9426d925",
      "@type": "BackgroundKnowledge",
      "instance_name": "professional_setting_event",
      "label": "Professional Setting: Sponsored Event",
      "description": "The backdrop with logos from companies like 'CBRE', 'Sotheby's International Realty', and 'Hudson River PK Friends' indicates a formal, professional, or sponsored event. This context is crucial for understanding the contrast in the meme: the women are dressed for a professional setting, yet are being mocked for being 'out of place' by being associated with a domestic appliance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_780682b3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eb3b7045",
      "@type": "EmotionExpression",
      "instance_name": "mocking_contempt",
      "label": "mocking contempt emotion",
      "description": "The emotion expressed is mocking contempt, conveyed through the juxtaposition of the professionally dressed women with the text 'slow cooker'. This implies a derogatory attitude toward the women, suggesting they are 'out of place' in their professional setting and should be relegated to domestic roles. The emotion is not expressed by the women themselves (who are smiling and appear happy), but by the meme's creator and the underlying stereotype being enforced.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_780682b3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_afe4f6f3",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Women are mapped onto a slow cooker",
      "description": "The text 'slow cooker' is superimposed on the image of three women at a professional event, creating an analogical mapping that equates the women with the domestic appliance. This mapping is based on the misogynous stereotype that women 'belong in the kitchen', reducing their professional presence to a domestic function. The visual material (three_women) is mapped onto the textual material (text_chunk) to imply that the women are 'out of place' in their public setting and should be relegated to domestic roles.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_780682b3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6daa3434",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material 'slow cooker'",
      "description": "The user is projected onto the text 'slow cooker' superimposed on the image. This projection implies that the user is identifying with or being associated with the derogatory stereotype that women 'belong in the kitchen', as the text equates the women in the image with the domestic appliance. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the meme's intent is to project the user's perception onto the text, which functions as a deictic anchor for the misogynistic stereotype being invoked.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_780682b3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
