    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b6b9d266",
      "@type": "VisualMaterial",
      "instance_name": "man",
      "label": "person with Down syndrome",
      "description": "A smiling man with Down syndrome, wearing a dark blue polo shirt, is the central subject of the image. His expression is cheerful and engaging, and he is looking directly at the camera. The text overlay \"the name's todd... retodd\" is superimposed on the image, creating a meme that relies on a phonetic pun involving a derogatory term related to developmental disabilities, which is considered harmful and offensive.",
