    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5965ac4c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'they are the biggest terrorists in the history of the world' is mapped onto the group of people (including David Cameron) in the image.",
      "description": "The top text overlay makes an inflammatory and hateful claim about 'they' (implied to be Muslims or people of Muslim faith) being the biggest terrorists. This claim is analogically mapped onto the visual material, which depicts David Cameron and his supporters in a celebratory political rally. The juxtaposition implies that the group being vilified (Muslims) is being represented by the political figure and his supporters, even though the text is a gross generalization. The celebratory scene is contrasted with the hateful text, creating a mapping where the visual group is the target of the textual accusation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75a5d7ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_afcb7c5a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the celebratory political rally scene",
      "description": "The user is projected onto the scene of David Cameron at a political rally, where the celebratory atmosphere and the visual material of the supporters are juxtaposed with the hateful text. The user is implicitly invited to see themselves as part of the celebratory crowd or as the one who understands the 'data' referenced in the text, even though the text is inflammatory and false. The scene serves as the primary visual anchor for the user's interpretation of the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75a5d7ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
