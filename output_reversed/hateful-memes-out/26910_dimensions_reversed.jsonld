      "instance_name": "sarcastic_reference_to_history_books",
      "label": "Sarcastic Reference to History Books",
      "description": "The phrase 'we have entire history of books showing this data' is a sarcastic or ironic reference to the idea that historical records or academic literature can provide evidence for claims. This is a rhetorical device that implies the claim is so absurd that it is 'proven' by the existence of books, which is a common trope in satirical or hateful memes. This requires external knowledge of rhetorical devices and internet meme culture to be understood.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75a5d7ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
