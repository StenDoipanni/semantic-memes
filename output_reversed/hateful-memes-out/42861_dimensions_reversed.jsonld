    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_11d1ef57",
      "@type": "Scene",
      "instance_name": "confused_question_scene",
      "label": "woman_expressing_confusion_through_rhetorical_question",
      "description": "The scene depicts a woman with a confused or exasperated expression, arms outstretched, against a plain white background. The text overlays pose a rhetorical question: 'if democrats really cared about election interference then why are they so against voter id laws?'. The woman's body language and facial expression are used analogically to convey confusion or disbelief, reinforcing the rhetorical question. The scene is structured to present a political argumentation by framing the issue as one of hypocrisy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bff0f23b"
      },
      "extractionMethod": "llm_extraction_huggingface"
