    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2d3de405",
      "@type": "BackgroundKnowledge",
      "instance_name": "democrats",
      "label": "Democratic Party",
      "description": "The Democratic Party is one of the two major political parties in the United States. It is a political entity whose positions on issues such as election integrity and voter ID laws are central to political discourse and debate. The meme references this party as a specific political actor whose policy positions are being questioned.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bff0f23b"
