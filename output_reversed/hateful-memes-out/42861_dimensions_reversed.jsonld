    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_71b18dda",
      "@type": "EmotionExpression",
      "instance_name": "confusion",
      "label": "confused emotion",
      "description": "The woman's facial expression, with wide eyes and a slightly open mouth, combined with her arms outstretched in a shrugging gesture, conveys a state of bewilderment or disbelief. This is reinforced by the rhetorical question in the text, which frames the viewer to question the Democratic Party's position, thereby invoking a feeling of confusion about the apparent contradiction.",
      "belongsToAnalysis": {
