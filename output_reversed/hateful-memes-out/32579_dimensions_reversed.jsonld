    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aa2c4caa",
      "@type": "EmotionExpression",
      "instance_name": "mocking_condescension",
      "label": "mocking and condescending tone",
      "description": "The meme uses the juxtaposition of Darth Vader, a symbol of evil and authoritarianism, offering 'weed' to Snoop Dogg, a Black cultural icon associated with cannabis, to create a humorous and mocking tone. The text 'come to the dark side, we have weed' implies that the dark side is more appealing because it offers weed, which is a sarcastic and condescending framing of the situation. This tone is conveyed through the visual contrast and the text overlay.",
      "belongsToAnalysis": {
