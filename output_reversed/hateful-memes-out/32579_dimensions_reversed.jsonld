    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7a47c990",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The dark side is represented by Darth Vader and Stormtroopers",
      "description": "The text 'come to the dark side' is mapped onto the visual entities of Darth Vader and the Stormtroopers, who are iconic representations of the dark side in Star Wars. The visual presence of Darth Vader as the recruiter and Stormtroopers as his loyal followers directly embodies the textual concept of 'the dark side'.",
      "belongsToAnalysis": {
