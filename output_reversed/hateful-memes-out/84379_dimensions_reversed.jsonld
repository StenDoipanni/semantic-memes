    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8048eac4",
      "@type": "BackgroundKnowledge",
      "instance_name": "gordon_ramsay_personality",
      "label": "Gordon Ramsay's Public Persona",
      "description": "Gordon Ramsay is a globally recognized celebrity chef known for his fiery temper, dramatic reactions, and confrontational style on television shows like 'Hell's Kitchen' and 'MasterChef'. His public persona is characterized by intense emotional outbursts, often used for comedic effect, which makes his exaggerated expressions in memes highly recognizable and effective for humor. Understanding this persona is essential to interpret the meme’s comedic intent and the hyperbolic nature of the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8a542d15"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3c49b5ca",
      "@type": "BackgroundKnowledge",
      "instance_name": "hyperbolic_humor",
      "label": "Hyperbolic Humor",
      "description": "The meme relies on hyperbolic humor — an exaggerated, absurd, or over-the-top statement used to create comedic effect. The phrase 'I'm buying a horse' is a ridiculous, disproportionate response to the implied theft, which is a common trope in internet memes to signal extreme frustration or disbelief. This requires background knowledge of meme culture and comedic conventions to be understood.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8a542d15"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
