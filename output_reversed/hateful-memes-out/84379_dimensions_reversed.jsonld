    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d3ae3e98",
      "@type": "BackgroundKnowledge",
      "instance_name": "celebrity_chef_culture",
      "label": "Celebrity Chef Culture",
      "description": "The meme draws on the cultural phenomenon of celebrity chefs, particularly Gordon Ramsay, whose public persona and media presence are deeply embedded in popular culture. His confrontational style and dramatic reactions are often parodied or referenced in memes, making his image a recognizable symbol of exaggerated emotion and humor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8a542d15"
