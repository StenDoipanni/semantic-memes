    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c98c5116",
      "@type": "EmotionExpression",
      "instance_name": "frustration",
      "label": "frustrated emotion",
      "description": "Gordon Ramsay's facial expression, characterized by furrowed brows, narrowed eyes, and an open mouth as if shouting or speaking emphatically, conveys intense frustration. This is amplified by his confrontational posture and the context of the meme, which implies a reaction to a perceived injustice or theft.",
      "belongsToAnalysis": {
