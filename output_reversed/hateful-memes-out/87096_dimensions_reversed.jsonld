    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b4efad7a",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_latino_hispanic_stereotypes",
      "label": "Anti-Latino/Hispanic Stereotypes",
      "description": "The meme relies on the stereotype that Latin American countries, particularly Mexico, are only willing to engage in serious diplomatic discussions about immigration when pressured or when it is politically convenient for the United States. This reflects a broader negative stereotype that portrays Latin American nations as opportunistic, untrustworthy, or uncooperative on immigration issues, which is often used to justify hardline U.S. immigration policies or to delegitimize Mexico's position.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdc60d00"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fb0c4d34",
      "@type": "BackgroundKnowledge",
      "instance_name": "mexico_us_immigration_relations",
      "label": "Mexico-U.S. Immigration Relations",
      "description": "The meme references the long-standing and often contentious relationship between Mexico and the United States regarding immigration, particularly border control, asylum, and migrant flows. The implication that Mexico 'suddenly wants to talk about immigration' is a commentary on the perceived hypocrisy or strategic timing in Mexico's diplomatic stance, which is a real-world issue rooted in decades of bilateral negotiations and political tensions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdc60d00"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9707aeb1",
      "@type": "BackgroundKnowledge",
      "instance_name": "mike_pence",
      "label": "Mike Pence",
      "description": "Mike Pence was the 48th Vice President of the United States (2017–2021) under President Donald Trump. The meme references his role as a 'tough president' (though he is not the president) to imply that Mexico's diplomatic posture is contingent on U.S. leadership being assertive or uncompromising. This is a real-world political reference that requires knowledge of Pence's tenure and his public persona as a conservative, hardline figure on immigration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdc60d00"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_108a070c",
      "@type": "BackgroundKnowledge",
      "instance_name": "donald_trump",
      "label": "Donald Trump",
      "description": "The phrase 'tough president' in the bottom text is a direct reference to Donald Trump, who was the 45th President of the United States (2017–2021) and known for his hardline, confrontational approach to immigration policy, including his rhetoric and policies targeting Mexico and Central American migrants. The meme uses Trump as a symbolic figure to represent the 'toughness' that supposedly forces Mexico to engage, which is a real-world political context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdc60d00"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_700a70c6",
      "@type": "BackgroundKnowledge",
      "instance_name": "bilateral_diplomatic_meeting",
      "label": "Bilateral Diplomatic Meeting",
      "description": "The image depicts a formal bilateral meeting between U.S. and Mexican officials, which is a standard diplomatic format. The meme's sarcasm relies on the understanding that such meetings are typically serious and substantive, but the text overlays imply that Mexico is only engaging in immigration talks under duress or when it suits U.S. interests. This requires knowledge of how diplomatic negotiations work and how they are often portrayed in media and political discourse.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdc60d00"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_19750bd6",
      "@type": "BackgroundKnowledge",
      "instance_name": "immigration_policy",
      "label": "Immigration Policy",
      "description": "The meme centers on the topic of immigration policy, specifically the contentious nature of U.S.-Mexico border policies, asylum procedures, and migrant flows. The text 'suddenly mexico wants to talk about immigration' implies that Mexico is only willing to discuss immigration when it is politically expedient for the U.S., which is a real-world issue rooted in decades of policy debates and political rhetoric.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdc60d00"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_43ecee0d",
      "@type": "EmotionExpression",
      "instance_name": "sarcastic_disgust",
      "label": "sarcastic disgust at Mexico's perceived opportunism",
      "description": "The meme expresses sarcastic disdain through the juxtaposition of a formal diplomatic meeting with text implying Mexico is only engaging in immigration talks when pressured by a 'tough president.' The tone suggests contempt for Mexico's diplomatic maneuvering, portraying it as opportunistic or untrustworthy. This emotion is conveyed through the ironic text overlays and the implied criticism of Mexico's stance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdc60d00"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_373e2b72",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Mexico is mapped onto the group of Mexican officials",
      "description": "The top text 'suddenly mexico wants to talk about immigration' is mapped onto the group of Mexican officials seated around the table, implying that Mexico (as a nation) is the entity that is suddenly engaging in immigration talks. The visual group of officials represents the Mexican delegation, and the text attributes the sudden interest in immigration to this group, creating an analogical mapping between the textual entity 'mexico' and the visual entity 'Mexican officials'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdc60d00"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1da99bbc",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material expressing gratitude for a 'tough president'",
      "description": "The user is projected onto the bottom text overlay 'i'm so grateful we have a tough president', which uses first-person plural ('we') to imply the user identifies with or is speaking on behalf of the U.S. perspective. This projection creates an identification with the speaker of the text, who is implicitly the user, and frames the user as someone who benefits from or supports the 'tough president' narrative. The projection is onto the textual material, which serves as the vehicle for this identification.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdc60d00"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1da4bdde",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme portrays Mexico as opportunistic and untrustworthy by implying it only engages in immigration talks when pressured by a 'tough president,' reinforcing negative stereotypes about Mexico's diplomatic behavior. This can contribute to xenophobic or anti-immigrant sentiment by delegitimizing Mexico's position and framing its actions as insincere or self-serving.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdc60d00"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_71c035ee",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who are politically engaged or interested in U.S.-Mexico relations, particularly those who support or sympathize with hardline immigration policies and the political persona of Donald Trump. The meme relies on cultural references to Trump’s 'tough' stance on immigration and the perceived opportunism of Mexico, appealing to audiences who view Mexico as uncooperative or strategically opportunistic in immigration negotiations. It is designed to resonate with those who believe in a confrontational U.S. approach to immigration and who may hold anti-Latino/Hispanic stereotypes, as it reinforces the idea that Mexico only engages when pressured. The audience likely includes conservative political supporters, followers of right-wing media, and individuals who favor strong leadership in foreign policy, particularly regarding immigration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bdc60d00"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
