    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8a111204",
      "@type": "Scene",
      "instance_name": "diplomatic_meeting",
      "label": "formal diplomatic meeting",
      "description": "A formal diplomatic meeting is taking place in a wood-paneled room with bookshelves, featuring U.S. Vice President Mike Pence and several Mexican officials seated in a semi-circle around a coffee table. American and Irish flags are prominently displayed, suggesting a bilateral meeting context. The scene is overlaid with sarcastic text implying Mexico is only engaging on immigration when pressured by a 'tough president.'",
      "belongsToAnalysis": {
