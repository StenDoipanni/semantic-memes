    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f289b4b4",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The man is mapped as the 'Muslim immigrant' who intends to impose Sharia law on America",
      "description": "The top text explicitly states 'I hate everything about america. so i am going to move there to bring it sharia law', which directly maps the visual entity 'man_with_crossed_arms' to the role of a Muslim immigrant with hostile intentions. The bottom text reinforces this by labeling the man as 'the real reason for most Muslim immigration', solidifying the analogical mapping between the visual man and the stereotypical 'Muslim immigrant' figure described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_50432d9d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_00496482",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man with crossed arms as a caricature of a Muslim immigrant",
      "description": "The user is projected onto the visual material of the man with crossed arms, who is explicitly mapped as the 'Muslim immigrant' who intends to impose Sharia law on America. The meme uses the man's stern expression and posture to represent a stereotypical 'threat' figure, and the user is implicitly identifying with or projecting their own hateful or fearful perspective onto this visual representation. The text overlays reinforce this projection by framing the man as the embodiment of the 'real reason for most Muslim immigration' — a false and inflammatory stereotype. The user is not directly addressed with deictic pronouns like 'you' or 'me', but the overall intent and framing of the meme create an implicit projection where the viewer (user) is positioned as the one who holds the hateful belief being expressed — that Muslims are inherently hostile and seek to impose Sharia law. This projection is onto the visual material (man_with_crossed_arms) and the textual material (top_text, bottom_text) that together construct the caricature.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_50432d9d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c2d8f103",
