    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eba05f99",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "Donald Trump is mapped as 'that face you make when you're a bully and just got beat up by a girl'",
      "description": "The textual material 'that face you make when you're a bully and just got beat up by a girl' explicitly maps onto the visual material of Donald Trump. The text describes a specific emotional and behavioral state (a pouting, defiant face in the context of defeat) that is visually embodied by Trump in the image. The meme uses this juxtaposition to create an analogical mapping where Trump is being portrayed as the 'bully' who has been 'beaten up by a girl', and his facial expression is the visual representation of that scenario. This mapping is central to the meme's intent and relies on the visual expression being interpreted through the lens of the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bd7ea7a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_46c75090",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene interpreting Trump's expression as a defeated bully",
      "description": "The user is projected onto the scene (pouting_bully_defeated) where the visual of Donald_Trump making a pouting face is interpreted through the lens of the text ('that face you make when you're a bully and just got beat up by a girl'). The user is invited to imagine themselves as the observer of this scenario, identifying with the perspective of someone witnessing the 'bully's' humiliation. The text implicitly addresses the user as the one who understands or is amused by the scenario, creating a shared experience of mockery. The projection is onto the scene because the user is expected to mentally inhabit the narrative constructed by the visual and textual elements together.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bd7ea7a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
