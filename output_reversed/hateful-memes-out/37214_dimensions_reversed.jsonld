    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8c4d5dc3",
      "@type": "BackgroundKnowledge",
      "instance_name": "Tupac_Shakur_legacy",
      "label": "Tupac Shakur's Cultural Legacy",
      "description": "Tupac Shakur was a highly influential American rapper, actor, and social activist whose life and work became emblematic of resilience, social commentary, and the complexities of fame and loyalty. His image is often invoked in cultural discourse to represent authenticity, struggle, and the duality of public persona versus private life. Using his wax figure in a meme about betrayal leverages his iconic status to anchor a cynical message, which may be interpreted as a contrast between his public persona and the message’s bleak worldview.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_65e3ae95"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_396cec54",
      "@type": "BackgroundKnowledge",
      "instance_name": "Betrayal_in_relationships",
      "label": "Concept of Betrayal in Human Relationships",
      "description": "The meme references the universal human experience of betrayal in personal relationships — friendships, romantic partnerships, or familial bonds. The message 'u gotta be prepared for disloyal sh*t no matter how loyal u are to a person' reflects a cynical perspective on human nature, implying that loyalty is often unreciprocated. This concept is rooted in social psychology and cultural narratives about trust and emotional vulnerability.",
      "belongsToAnalysis": {
