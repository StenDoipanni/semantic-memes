      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cc00a06c",
      "@type": "EmotionExpression",
      "instance_name": "cynicism",
      "label": "cynical emotion",
      "description": "The emotion conveyed by the overlaid text 'u gotta be prepared for disloyal sh*t no matter how loyal u are to a person' expresses a cynical worldview that distrusts human loyalty and promotes emotional detachment as a survival strategy. This emotion is not visually depicted on the wax figure’s face but is strongly communicated through the textual message.",
