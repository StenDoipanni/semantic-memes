    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f6d56d42",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The woman in the image is mapped as the subject of the dyslexia stereotype",
      "description": "The text 'no means no, unless she's dyslexic' explicitly references the woman in the image as the potential subject of the dyslexia stereotype. The visual of the woman, in an intimate context, is juxtaposed with the text to imply that her consent is invalid unless she has dyslexia, thereby mapping her onto the stereotype of a woman with dyslexia who is more sexually available. This is a clear analogical mapping where the visual entity (the woman) is being projected as the entity referred to by the textual material ('she's dyslexic').",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_92bd3222"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
