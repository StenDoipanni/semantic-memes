    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_55aab1a7",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "King Charles III is mapped as 'the one who waited 40 years to be king'",
      "description": "The top text 'when you've waited 40 years to be king,' is directly mapped onto King Charles III. The visual of him, with his solemn and slightly impatient expression, is used to represent the person who has endured a 40-year wait for his coronation. The text explicitly identifies him as the subject of this prolonged waiting period, creating an analogical mapping where the visual entity (King_Charles_III) is the embodiment of the textual description.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7f6431e8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8ef1bcb2",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material expressing impatience",
      "description": "The user is projected onto the text 'but your mother refuses to die', which uses the deictic 'your' to imply the user is the one who has waited 40 years to be king and is frustrated by their mother's prolonged life. This creates a direct identification of the user with the subject of the meme's narrative, making the user feel personally implicated in the scenario described.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7f6431e8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d1416024",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme trivializes the gravity of royal succession, the personal grief of the monarch, and the cultural significance of the monarchy. It also potentially undermines the dignity of the late Queen Elizabeth II by suggesting her continued life was an inconvenience to her son. The tone is mocking and could be perceived as disrespectful and insensitive to the institution and its history, thus carrying potential harm to public perception and respect for the institution.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7f6431e8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cbe4706b",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The meme is designed for an audience familiar with British royal history and the institution of the monarchy, particularly those who understand the succession process and the personal significance of Queen Elizabeth II’s reign and death. The humor relies on cultural knowledge of the monarchy’s ceremonial duties, the long wait for Charles III’s ascension, and the public perception of royal grief. The target audience likely includes individuals who are politically or culturally engaged with the UK or Commonwealth, or who follow royal news, and who may appreciate cynical or sarcastic commentary on institutional norms. The meme’s intent to provoke humor through a mocking lens suggests it targets an audience that finds irony in the personal timing of royal succession, potentially including those who view monarchy as outdated or overly formal.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7f6431e8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
