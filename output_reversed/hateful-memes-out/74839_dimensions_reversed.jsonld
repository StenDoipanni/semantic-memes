    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7033689b",
      "@type": "Scene",
      "instance_name": "king_waiting_scene",
      "label": "King Charles III waiting for his coronation",
      "description": "The scene depicts King Charles III, who has waited 40 years to become king, but his mother refuses to die. The text overlays the image to convey this narrative. The king's solemn expression and the text together create a scene of impatience and frustration with the delay caused by his mother's prolonged life.",
      "belongsToAnalysis": {
