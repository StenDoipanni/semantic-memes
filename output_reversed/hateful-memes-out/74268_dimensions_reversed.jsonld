    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_520c47d1",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Trump supporters are mapped onto the distressed child",
      "description": "The top text 'trump supporters be like' explicitly maps the political group 'trump supporters' onto the visual entity of the child. The child's vulnerable, distressed state (fallen bicycle, sitting on ground, appearing upset) is used as a metaphor to represent the perceived 'childishness' or 'helplessness' of Trump supporters, as per the background knowledge on 'child_as_metaphor'. This is an analogical mapping where the textual entity 'trump supporters' is projected onto the visual entity 'child'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2a22cc2e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6c8aed1b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the child as a metaphor for Trump supporters",
      "description": "The user is projected onto the visual material of the child, who is depicted as distressed and fallen from a bicycle. This projection is implicit through the meme's structure: the text 'trump supporters be like' maps the political group onto the child's vulnerable state. The user, as the viewer, is invited to identify with or project themselves onto the child's experience, thereby internalizing the meme's dehumanizing metaphor that equates Trump supporters with childish helplessness. This is a form of semiotic projection where the user is not explicitly addressed with 'you' or 'me', but the metaphorical alignment creates a psychological projection onto the child figure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2a22cc2e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
