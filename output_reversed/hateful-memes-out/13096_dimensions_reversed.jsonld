    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bf6a40d9",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Virgin sheep are mapped to sheep in racing attire",
      "description": "The top text 'virgin sheep' is mapped onto the visual entity 'sheep' in the image. The sheep, depicted wearing colorful racing vests and running in a race, are metaphorically represented as 'virgin sheep' — implying innocence or purity — which is a textual concept not visually depicted but projected onto the visual sheep through the meme's text. This mapping creates a false analogy where the sheep's vulnerability (due to their racing attire and motion) is equated with the concept of 'virginity' as a metaphor for innocence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9d8b27dd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a4de845c",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material and visual material as the target of the stereotype",
      "description": "The user is not explicitly projected onto a specific deictic pronoun like 'me' or 'you'. However, the meme's structure and hateful intent project the user (or the viewer) as the implied observer of the stereotype being enacted — specifically, the user is positioned as the one who must interpret the false analogy where 'virgin sheep' (a metaphor for innocence) are being chased by 'horny muslims' (a derogatory stereotype). The user is thus projected onto the entire meme as the recipient of the degrading message, with the visual material (sheep running) and textual material (top and bottom text) serving as the vehicle for this projection. The user is not directly addressed, but the entire scene functions as a projection of the viewer's role in consuming and potentially internalizing the hateful stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9d8b27dd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
