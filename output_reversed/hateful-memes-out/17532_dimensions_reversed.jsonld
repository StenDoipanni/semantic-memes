    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e56b6507",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_firefighter_saves_baby",
      "label": "firefighter is the one who saves the baby",
      "description": "The text 'firefighter saves baby' explicitly maps the visual entity 'firefighter' as the agent performing the action of saving the baby. The visual material shows a firefighter holding a baby, and the text frames this action as a heroic rescue, creating an analogical mapping where the firefighter is identified as the savior. This mapping relies on the cultural understanding of firefighters as first responders who save lives, and the baby as a vulnerable subject needing protection. The mapping is established through the juxtaposition of the text with the visual scene, where the firefighter's posture and expression (gentle care) reinforce the narrative of rescue and protection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8c4ad98b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_05493d0c",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the firefighter as a heroic savior",
      "description": "The user is projected onto the firefighter, who is visually depicted as the agent performing the heroic act of saving the baby. This projection is implicit, not explicit (e.g., no 'you' or 'me' text), but is established through the meme's overall intent and the cultural framing of the firefighter as a protector and hero. The user identifies with the role of the protector or hero, seeing themselves in the firefighter's action of care and rescue. The projection is onto the VisualMaterial entity 'firefighter' and reinforced by the TextualMaterial 'firefighter saves baby', which assigns agency and heroism to the firefighter.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8c4ad98b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
