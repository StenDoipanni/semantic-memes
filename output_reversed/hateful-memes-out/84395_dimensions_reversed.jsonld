    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5b3b2a8d",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The act of cleaning is mapped to the act of 'picking up' a girl from Auschwitz",
      "description": "The text 'how to pick up a girl from auschwitz' is juxtaposed with the visual of a person cleaning a floor with a broom and dustpan. This creates an analogical mapping where the mundane, domestic act of cleaning is equated with the grotesque and offensive act of 'picking up' someone from Auschwitz. The visual material (the cleaning action) is mapped onto the textual concept (the pickup line), implying that the only way to approach someone from Auschwitz is to 'clean up' the mess associated with the Holocaust. This is a hateful and offensive analogy that trivializes genocide and reduces human suffering to a crude metaphor for dating.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bb331b35"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fa48999e",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the text 'how to pick up a girl from auschwitz' as the central object of the meme's hateful message. The text explicitly frames the user's potential action (picking up a girl) in relation to the horrific context of Auschwitz, implying the user is the one who must perform this grotesque act. The visual of cleaning is presented as a metaphor for the user's supposed 'solution' to approaching someone from Auschwitz, making the text the primary locus of the user's projected identity and action within the meme's hateful framework.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bb331b35"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
