    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1f81a0ad",
      "@type": "BackgroundKnowledge",
      "instance_name": "auschwitz_concentration_camp",
      "label": "Auschwitz Concentration Camp",
      "description": "Auschwitz was the largest and most infamous Nazi concentration and extermination camp, located in occupied Poland. It was the site of the mass murder of over 1.1 million people, mostly Jews, but also Poles, Roma, Soviet prisoners of war, and others. The camp symbolizes the Holocaust and the industrialized killing of millions. The meme's reference to 'Auschwitz' is a direct and offensive allusion to this site of genocide.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_bb331b35"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2b120f5c",
      "@type": "BackgroundKnowledge",
      "instance_name": "holocaust_denial_minimization",
      "label": "Holocaust Denial/Minimization Themes",
      "description": "This refers to the false or distorted narratives that downplay, distort, or deny the scale and horror of the Holocaust. The meme exemplifies this by trivializing the genocide as a joke about dating, thereby minimizing the suffering of victims and reducing a historical atrocity to a mundane social interaction. This is a form of historical revisionism that is both harmful and hateful.",
      "belongsToAnalysis": {
