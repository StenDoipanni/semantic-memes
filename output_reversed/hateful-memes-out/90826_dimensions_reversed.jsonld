    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d28b18f1",
      "@type": "BackgroundKnowledge",
      "instance_name": "rule_of_the_club_trope",
      "label": "Rule of the Club Trope",
      "description": "A common comedic trope in popular culture where a club or group has a secret rule that members must not discuss the club or its rules. This trope is referenced in the meme's text ('the first rule of deaf club...') to create humor, but it is used here in a way that can be seen as offensive to the deaf community by implying secrecy or exclusivity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_336dcc57"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d17e0fd2",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism",
      "label": "Ableism",
      "description": "The meme's humor is rooted in ableist stereotypes that portray deaf people as secretive or isolated, which is a form of ableism. Ableism is the discrimination or social disadvantage faced by people with disabilities, and this meme reinforces harmful stereotypes that can be offensive to the deaf community.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_336dcc57"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3dbc4829",
      "@type": "BackgroundKnowledge",
      "instance_name": "deaf_community",
      "label": "Deaf Community",
      "description": "The meme references the deaf community, which is a cultural and linguistic group of people who are deaf or hard of hearing and often communicate using sign languages like ASL. Understanding the identity and culture of the deaf community is necessary to interpret the meme's reference to 'deaf club' and the stereotype it perpetuates.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_336dcc57"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_197df56e",
      "@type": "EmotionExpression",
      "instance_name": "mocking",
      "label": "mocking emotion",
      "description": "The emotion expressed is mocking, conveyed through the humorous and stereotypical text overlay that plays on the 'Rule of the Club' trope, implying that deaf people are secretive about their community. This is a form of ableist humor that mocks the deaf community by suggesting they are secretive or exclusive, which is a harmful stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_336dcc57"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cb0fe7fe",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The text 'the first rule of deaf club..' is mapped onto the scene of sign language communication.",
      "description": "The top text 'the first rule of deaf club..' is juxtaposed with the visual of a woman using American Sign Language (ASL) to communicate. This creates an analogical mapping where the text refers to a rule governing the 'deaf club' (the deaf community), and the visual material (the woman signing) represents a member of that club actively engaging in its communication method. The mapping implies that the visual scene is an instance of the 'rule' being enacted or referenced.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_336dcc57"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b0817183",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material conveying the rule of the deaf club",
      "description": "The user is projected onto the bottom text 'nyou nu not nalk amout nef-glub', which directly addresses the viewer with a deictic imperative ('nyou' meaning 'you') instructing them not to talk about the deaf club. This creates a direct address to the user, making them the subject of the rule being enforced. The top text 'the first rule of deaf club..' sets up the context, but the bottom text explicitly engages the user as 'you'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_336dcc57"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
