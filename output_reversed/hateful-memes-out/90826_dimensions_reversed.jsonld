    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_96fcf334",
      "@type": "BackgroundKnowledge",
      "instance_name": "deaf_community_secrecy_stereotype",
      "label": "Deaf Community Secrecy Stereotype",
      "description": "The meme plays on the trope that members of a club or group are secretive about their existence or rules, often humorously referred to as 'the first rule of [club name]... you do not talk about [club name]'. This trope is used here to imply that deaf people are secretive about their community, which is a harmful stereotype as it misrepresents the openness and visibility of the deaf community.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_336dcc57"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fcdeec5d",
      "@type": "BackgroundKnowledge",
      "instance_name": "american_sign_language",
      "label": "American Sign Language (ASL)",
      "description": "The woman in the image is using American Sign Language, a visual language used by many deaf and hard-of-hearing individuals in the United States. Understanding that ASL is a legitimate and complex language is essential to interpreting the communication happening in the image and the joke's context.",
      "belongsToAnalysis": {
