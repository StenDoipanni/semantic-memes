    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5f5db90c",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The visual of people raising hands is mapped onto the textual command to identify racists.",
      "description": "The text 'hands up all racists who support white genocide' directly commands the visual action of people raising their hands. This creates an analogical mapping where the gesture of raising hands (a visual material entity) is being used as a metaphorical or literal mechanism to identify and target individuals based on their race and alleged support for a false conspiracy theory. The visual of collective hand-raising, typically associated with compliance or participation, is being repurposed to signify the act of 'naming' or 'flagging' people as racists, thereby creating a jarring and manipulative contrast between the passive visual and the hateful textual message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0264ca4f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3e4dfbaf",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual command to identify racists",
      "description": "The user is projected onto the textual material 'hands up all racists who support white genocide' because the meme implicitly commands the viewer to perform the action of raising hands (as depicted visually) to identify and condemn individuals based on race and alleged support for a false conspiracy theory. This creates a direct, participatory projection where the viewer is expected to mentally or physically align with the action, making them an active participant in the hateful framing. The deictic nature is implicit in the command structure of the text, which addresses the viewer as the one who should execute the gesture to 'identify' racists.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0264ca4f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
