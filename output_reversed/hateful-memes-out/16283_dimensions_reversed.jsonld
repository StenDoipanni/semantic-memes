      "@id": "http://example.org/multimodal-taxonomy#dimension_132cd581",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Islamophobia",
      "description": "The meme uses the stereotype that Muslims are unclean by juxtaposing the question 'pork is unclean?' with a vulgar insult targeting goats, which are culturally associated with foul smell and uncleanliness. This implicitly mocks religious dietary practices (halal) and equates them with animal-based degradation, which is a form of Islamophobia.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dea7fe22"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
