    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7b2cc329",
      "@type": "BackgroundKnowledge",
      "instance_name": "goat_as_unclean_animal_stereotype",
      "label": "Goat as Unclean Animal Stereotype",
      "description": "In Western culture, goats are often stereotyped as smelly, dirty, and unclean animals. This stereotype is used in the meme to sarcastically imply that if pork is unclean, then goats are even worse, thereby mocking dietary restrictions and using crude animal imagery to degrade religious practices.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dea7fe22"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5bfaafd1",
      "@type": "BackgroundKnowledge",
      "instance_name": "dietary_restrictions",
      "label": "Dietary Restrictions (Halal/Kosher)",
      "description": "The meme references religious dietary laws, specifically the prohibition of pork in Islam (halal) and Judaism (kosher). The text 'pork is unclean?' is a direct reference to these religious practices, and the meme's intent is to mock or question them using vulgar and degrading language.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dea7fe22"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2488f03c",
      "@type": "EmotionExpression",
      "instance_name": "mocking_sarcasm",
      "label": "sarcastic mocking expression",
      "description": "The goat's smug, direct gaze combined with the text 'pork is unclean?' and 'ever smell one of these goat fuckers?' conveys a mocking, sarcastic tone. The visual expression of the goat, paired with the vulgar and degrading text, is intended to ridicule dietary restrictions by implying that if pork is unclean, then goats — which are stereotypically smelly — are even worse, using shock value and crude language to provoke a reaction.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dea7fe22"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ba791241",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Goat as the mapped entity for 'goat fuckers'",
      "description": "The text 'ever smell one of these goat fuckers?' directly refers to the visual entity 'goat' in the image. The meme uses the visual depiction of the goat to represent the entity being insulted in the text, creating an analogical mapping where the goat is mapped onto the textual entity 'goat fuckers'. This is a direct projection of the visual material onto the textual material, where the animal is explicitly named and insulted in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dea7fe22"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_36f6365e",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the goat as the target of the vulgar insult",
      "description": "The user is implicitly projected onto the visual entity 'goat' as the object of the degrading textual insult 'goat fuckers'. The meme uses the goat's smug expression and the vulgar text to create a direct projection where the viewer is positioned as the one who would 'smell' or encounter the goat, thereby being implicated in the crude analogy. This projection is not explicit with deictic pronouns like 'you' or 'me', but the rhetorical structure ('ever smell one of these goat fuckers?') positions the viewer as the potential experiencer of the foulness, making the user the implied subject of the insult.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_dea7fe22"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
