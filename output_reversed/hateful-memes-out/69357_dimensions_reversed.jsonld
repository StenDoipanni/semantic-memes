      "@id": "http://example.org/multimodal-taxonomy#dimension_ccb08e3c",
      "@type": "BackgroundKnowledge",
      "instance_name": "pedophilia_stigma",
      "label": "Pedophilia Stigma",
      "description": "The widespread fear, shame, and social taboo surrounding pedophilia. This stigma is exploited in the meme to create a sense of disgust or shock, as the man's cheerful expression is juxtaposed with the accusation of being a pedophile. The meme uses this stigma to demean and attack the man, making the false accusation more impactful and hateful.",
      "belongsToAnalysis": {
