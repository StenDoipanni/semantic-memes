    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7625a52d",
      "@type": "BackgroundKnowledge",
      "instance_name": "pedophilia_false_association_stereotype",
      "label": "Pedophilia False Association Stereotype",
      "description": "A harmful stereotype that falsely links individuals, particularly those perceived as 'ordinary' or 'harmless' (like the man in the image), with the heinous crime of pedophilia. This is a form of LGBTQ+ discrimination that uses the fear and stigma surrounding pedophilia to demean or attack specific groups or individuals, often by falsely associating them with a severe criminal offense. This stereotype is used to create shock, disgust, or fear, and is inherently hateful as it targets individuals based on protected characteristics.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3efb130f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_981dc5e0",
      "@type": "BackgroundKnowledge",
      "instance_name": "lgbtq_plus_discrimination",
      "label": "LGBTQ+ Discrimination",
      "description": "A broad category of prejudice and hate that targets LGBTQ+ individuals. This includes false accusations, stereotypes, and dehumanizing portrayals. The meme leverages this by falsely associating the man with pedophilia, which is a common tactic in LGBTQ+ discrimination to vilify and attack members of the community, often by exploiting societal fears and stigmas.",
      "belongsToAnalysis": {
