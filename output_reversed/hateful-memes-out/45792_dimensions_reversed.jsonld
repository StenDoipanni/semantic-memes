    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3782dcc4",
      "@type": "BackgroundKnowledge",
      "instance_name": "profanity_in_meme_context",
      "label": "Profanity in Meme Context",
      "description": "The use of the expletive 'fucking' is a form of verbal expression that conveys strong emotion, often frustration or anger. In meme culture, such language is frequently used to heighten the comedic or relatable impact of the situation, even if it is considered offensive or vulgar by some. The meme's humor comes from the juxtaposition of the mundane situation with the exaggerated language.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c272cb6d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_30d21166",
      "@type": "BackgroundKnowledge",
      "instance_name": "appliance_reliability_stereotype",
      "label": "Appliance Reliability Stereotype",
      "description": "There is a common stereotype that household appliances, particularly older or cheaper models, are unreliable and prone to breaking down. This stereotype is often used humorously in memes to express the universal experience of dealing with malfunctioning technology in daily life.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c272cb6d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3a3d9d5a",
      "@type": "EmotionExpression",
      "instance_name": "frustration",
      "label": "frustrated emotion",
      "description": "The emotion of frustration is conveyed through the person's interaction with the dishwasher and the explicit text overlay 'the fucking dishwasher is acting up!'. The use of the expletive 'fucking' strongly indicates anger or exasperation directed at the malfunctioning appliance. The person's posture—reaching into the dishwasher with one hand while the other rests on the countertop—suggests a sense of helplessness or annoyance with the situation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c272cb6d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2615385a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_frustrated_person_with_dishwasher",
      "label": "The person is mapped as 'the fucking dishwasher'",
      "description": "The text 'the fucking dishwasher' is an analogical mapping that projects the visual entity 'person' onto the textual entity 'dishwasher'. The person is depicted interacting with the dishwasher in a frustrated manner, and the text explicitly labels the dishwasher as the source of frustration. This mapping is established through the juxtaposition of the visual scene (person struggling with dishwasher) and the text (focusing on the dishwasher as the 'culprit'), creating a humorous and exaggerated representation of domestic annoyance. The person's action and posture reinforce the mapping, as they are shown trying to fix or retrieve something from the appliance, which is the object of the text's frustration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c272cb6d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b135a444",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the frustrated person with the dishwasher",
      "description": "The user is projected onto the visual entity 'person' who is interacting with the malfunctioning dishwasher. This projection is implied through the relatable and exaggerated frustration expressed in the text 'the fucking dishwasher is acting up!', which invites the viewer to identify with the person's experience. The meme uses the person's action and posture to create a shared emotional experience, making the viewer feel as if they are 'the person' in the scene, experiencing the domestic annoyance. There are no explicit deictic pronouns like 'me' or 'you', but the context and the universal nature of the frustration create an implicit projection of the user onto the person.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c272cb6d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4cc43117",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Abusive",
      "description": "The meme uses vulgar language ('fucking') to express frustration toward an inanimate object (the dishwasher), which constitutes abusive language. This is a form of verbal abuse directed at an appliance, intended to humorously exaggerate a common domestic annoyance. The language is offensive to some audiences and conveys strong anger, fitting the 'Abusive' toxicity category.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c272cb6d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_514f1635",
      "@type": "TargetCommunity",
      "instance_name": "person",
      "label": "domestic frustration audience",
      "description": "The meme targets individuals who experience and relate to common domestic annoyances, particularly with household appliances like dishwashers. The visual of a person struggling with a malfunctioning dishwasher, combined with the text 'the fucking dishwasher is acting up!', is designed to resonate with anyone who has faced similar frustrations in their home. This audience likely includes homeowners, renters, or anyone who regularly uses kitchen appliances and finds them unreliable or inconvenient.",
      "belongsToAnalysis": {
