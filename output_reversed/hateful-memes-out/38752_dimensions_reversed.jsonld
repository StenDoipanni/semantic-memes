    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c7e24d05",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The protestor is mapped as the agent of the hateful statement",
      "description": "The text 'here's to you obama, your transgender agenda helped me fish out all the mentally ill on my friends list' is overlaid on the image. The visual entity 'protestor' (the woman holding the 'OBAMA PRIDE' sign) is positioned as the subject performing the action implied by the text — the 'me' in the statement. The meme uses the protestor's image to represent the speaker of the hateful text, creating an analogical mapping where the protestor is mapped onto the textual agent 'me'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_175792c6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_df3b2637",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the protestor as the speaker of the hateful text",
      "description": "The meme uses the deictic pronoun 'me' in the overlaid text 'helped me fish out all the mentally ill on my friends list' to project the user (the viewer of the meme) onto the protestor (the woman holding the 'OBAMA PRIDE' sign). The protestor is visually positioned as the agent performing the action described in the text, creating an analogical mapping where the user is identified with the protestor as the speaker of the hateful statement. This projection is reinforced by the visual framing of the protestor as the central figure in the scene, making her the implied 'me' in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_175792c6"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
