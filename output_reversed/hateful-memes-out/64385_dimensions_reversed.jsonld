    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_853f93cd",
      "@type": "BackgroundKnowledge",
      "instance_name": "victimization_stereotype",
      "label": "Victimization Stereotype",
      "description": "The meme relies on the cultural stereotype of 'victimhood' — the idea that individuals are unfairly targeted or harmed by external forces, often leading to exaggerated emotional responses. This concept is commonly used in internet humor to express frustration or helplessness in situations perceived as unjust, such as workplace stress, online harassment, or bureaucratic hurdles. The phrase 'this victimizes me' is a self-deprecating or ironic way to frame personal struggles as if they are part of a larger, unfair system.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_145c6cd9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8067ba8a",
      "@type": "BackgroundKnowledge",
      "instance_name": "online_stress_culture",
      "label": "Online Stress Culture",
      "description": "The image and text reference a common modern phenomenon: the overwhelming pressure and frustration experienced when dealing with digital tasks, such as work emails, social media, or complex software. This is often amplified by the 'always-on' nature of digital life, leading to feelings of being overwhelmed or 'victimized' by technology or digital environments. The laptop is a symbol of this digital stress.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_145c6cd9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e63db43c",
      "@type": "BackgroundKnowledge",
      "instance_name": "ironic_self_deprecation",
      "label": "Ironic Self-Deprecation",
      "description": "The meme uses irony to express frustration. The phrase 'there must be some way this victimizes me' is not meant to be taken literally but rather as a humorous exaggeration. It reflects a common internet trope where people mock their own over-the-top emotional reactions to minor inconveniences, often to elicit empathy or shared experience from others. This requires understanding of internet humor conventions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_145c6cd9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5402c577",
      "@type": "BackgroundKnowledge",
      "instance_name": "relatable_meme_format",
      "label": "Relatable Meme Format",
      "description": "The visual of a distressed person looking at a screen with text overlay is a widely recognized meme format used to express frustration, helplessness, or despair. This format is often used to convey situations that are universally relatable, such as dealing with complex tasks, bad news, or frustrating technology. The image is a visual shorthand for 'I am overwhelmed by this situation.'",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_145c6cd9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a1084935",
      "@type": "EmotionExpression",
      "instance_name": "frustration",
      "label": "frustrated emotion",
      "description": "The woman's facial expression, with her eyebrows furrowed and mouth downturned, combined with her hands holding her head, visually conveys intense frustration. This is amplified by the text overlay 'there must be some way this victimizes me,' which humorously exaggerates her feeling of being overwhelmed or unfairly targeted by a situation, likely digital or bureaucratic in nature.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_145c6cd9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d76f7418",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The distressed woman is mapped as the 'victim' in the text",
      "description": "The text 'this victimizes me' implies that the woman in the image is the one being victimized. The visual of her distressed expression and posture (holding her head) is mapped onto the textual concept of 'victim' to convey the meme's ironic self-deprecation about feeling overwhelmed or unfairly targeted by a situation. The mapping is established through the juxtaposition of her emotional state with the text, which explicitly labels her as the victim of the situation depicted on the laptop.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_145c6cd9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a3303fa7",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the distressed woman as the victim",
      "description": "The user is projected onto the visual material of the distressed woman (entity: woman) and the textual material 'this victimizes me' (text_chunk_1), which explicitly uses 'me' to indicate self-identification with the victim role. The user sees themselves in the woman's emotional state and the situation described, making the projection onto the woman and the text. The phrase 'this victimizes me' directly deictically refers to the user as the victim, establishing a strong semiotic projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_145c6cd9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_947e086f",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_2",
      "label": "User projected onto the textual material 'this victimizes me'",
      "description": "The user is projected onto the textual material 'this victimizes me' (text_chunk_1) because it contains the deictic pronoun 'me', which directly refers to the user. The user identifies with the feeling of being victimized by the situation, and the text explicitly frames this as 'me', creating a direct projection of the user's self-perception onto the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_145c6cd9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
