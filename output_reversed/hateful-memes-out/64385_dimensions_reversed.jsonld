      "instance_name": "distressed_woman_at_laptop",
      "label": "woman distressed while using laptop",
      "description": "A woman with blonde hair, wearing a light-colored fuzzy sweater, is seated at a desk, holding her head in her hands while looking at a laptop with a distressed expression. She appears frustrated or overwhelmed by the situation on the screen.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_145c6cd9"
