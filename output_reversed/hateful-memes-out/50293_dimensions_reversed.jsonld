    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b81d426c",
      "@type": "Scene",
      "instance_name": "arm_wrestling_struggle",
      "label": "Arm-wrestling struggle metaphor",
      "description": "A scene depicting two muscular arms locked in an arm-wrestling match, symbolizing a physical struggle or competition. The arms are positioned centrally, taut and exerting force against each other, representing a metaphorical conflict. Text overlays label each arm with 'aids' and 'gays', and a caption at the bottom reads 'it really be like that', implying a false equivalence or rivalry between the two concepts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c7a431c1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_939f2694",
      "@type": "BackgroundKnowledge",
      "instance_name": "false_equivalence_stereotype",
      "label": "False Equivalence Stereotype",
      "description": "The meme relies on the false equivalence stereotype, implying that HIV/AIDS and gay men are in direct opposition or competition, when in reality, HIV/AIDS is a disease that affects people regardless of sexual orientation. This stereotype misrepresents the medical reality and perpetuates harmful discrimination against gay men and people living with HIV/AIDS.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c7a431c1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ccf4a5d0",
      "@type": "BackgroundKnowledge",
      "instance_name": "hiv_aids_medical_fact",
      "label": "HIV/AIDS Medical Fact",
      "description": "HIV/AIDS is a medical condition caused by the Human Immunodeficiency Virus, which attacks the immune system. It does not inherently target any specific sexual orientation or group of people, although it has historically been disproportionately associated with gay men due to social stigma and misinformation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c7a431c1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6c640269",
