    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_55e8165b",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_hiv_stigma",
      "label": "Historical HIV Stigma",
      "description": "In the early years of the HIV/AIDS epidemic, particularly in the 1980s and 1990s, the disease was heavily stigmatized and falsely associated with gay men, intravenous drug users, and other marginalized groups. This association was fueled by misinformation and prejudice, leading to widespread discrimination and social exclusion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c7a431c1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1da82e17",
      "@type": "BackgroundKnowledge",
      "instance_name": "lgbtq_plus_discrimination",
      "label": "LGBTQ+ Discrimination",
      "description": "The meme contributes to LGBTQ+ discrimination by implying that gay men are somehow 'responsible' for or in conflict with HIV/AIDS, which is a harmful and inaccurate narrative. This aligns with the broader category of LGBTQ+ discrimination, which includes false associations and stereotypes that devalue or demonize the community.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c7a431c1"
