      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e26e4a26",
      "@type": "EmotionExpression",
      "instance_name": "hateful_anger",
      "label": "hateful anger emotion",
      "description": "The image expresses a hateful and angry emotion through the visual metaphor of an arm-wrestling struggle between 'aids' and 'gays', implying a false and hostile rivalry. This emotion is rooted in the meme's intent to stigmatize and blame the LGBTQ+ community for HIV/AIDS, which is a harmful and inaccurate narrative. The visual tension and the text 'it really be like that' amplify the aggressive and antagonistic emotional tone.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c7a431c1"
      },
