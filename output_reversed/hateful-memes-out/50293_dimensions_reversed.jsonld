      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_74d61cf0",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the arm-wrestling struggle scene",
      "description": "The user is projected onto the scene of the arm-wrestling struggle, which metaphorically represents a conflict between 'aids' and 'gays'. The user is implicitly positioned as an observer or participant in this false equivalence, as the meme's overall intent is to provoke a simplistic, misleading narrative that the user is expected to internalize or react to. The absence of explicit deictic pronouns like 'me' or 'you' means the projection is indirect, through the metaphorical framing of the scene and the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c7a431c1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_710df066",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme depicts a false equivalence between HIV/AIDS and gay men, implying a direct conflict or competition, which is a harmful and hateful stereotype that stigmatizes and blames the LGBTQ+ community for the disease. This aligns with the broader category of LGBTQ+ discrimination and historical HIV stigma.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c7a431c1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b73d1a38",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience for this meme is individuals who may hold or be exposed to harmful stereotypes about LGBTQ+ communities, particularly gay men, and who may be influenced by misinformation linking HIV/AIDS exclusively to them. The meme is designed to resonate with those who might find the false equivalence between 'aids' and 'gays' amusing or relatable, often through a simplistic, divisive lens. It leverages cultural references to arm-wrestling as a metaphor for conflict, appealing to audiences familiar with this visual trope. The meme's toxicity and hateful intent suggest it is targeted at or intended to provoke those who are either unaware of or dismissive of the medical reality of HIV/AIDS and the historical stigma faced by LGBTQ+ individuals. The audience is likely to include people who may not be directly affected by the stereotype but are part of a broader cultural context where such false equivalences are circulated, often in online spaces where such content is shared for shock value or to reinforce prejudiced views.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c7a431c1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
