    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a3fc9f91",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_immigrant_stereotype",
      "label": "Anti-Immigrant Stereotype",
      "description": "The meme relies on the stereotype that immigrants are 'taking the land' and are therefore undeserving or threatening to the native population. This is a common xenophobic trope used to dehumanize and demonize immigrants, often implying they are economic or cultural threats. It is rooted in historical narratives of land ownership and national identity, and is used to incite fear and hostility toward immigrant communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7acef8ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d52bc939",
      "@type": "BackgroundKnowledge",
      "instance_name": "white_supremacist_rhetoric",
      "label": "White Supremacist Rhetoric",
      "description": "The phrase 'they're taking the land we stole' is a form of white supremacist rhetoric that frames land ownership as a racial or ethnic inheritance, implying that non-white or non-native groups are illegitimate claimants. This rhetoric is used to justify exclusionary policies and to reinforce racial hierarchies by claiming historical victimhood and entitlement to land.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7acef8ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b22ad285",
      "@type": "BackgroundKnowledge",
      "instance_name": "american_flag_symbolism",
      "label": "American Flag Symbolism",
      "description": "The American flag in the image is used as a symbol of national identity and patriotism. In this context, it is juxtaposed with the anti-immigrant message to imply that the speaker is defending the nation or its values. The flag is often used in political and social discourse to evoke feelings of loyalty, belonging, and moral authority, even when used to justify exclusionary or hateful ideologies.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7acef8ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d5ae53fd",
      "@type": "BackgroundKnowledge",
      "instance_name": "assault_rifle_as_symbol_of_militarism",
      "label": "Assault Rifle as Symbol of Militarism",
      "description": "The assault rifle held by the man is a symbol of militarism and aggression. In the context of the meme, it visually reinforces the threat posed by immigrants, suggesting that they are a danger that must be confronted or eliminated. This imagery is often used in political and extremist rhetoric to evoke fear and justify violence or authoritarian control.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7acef8ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_02db252a",
      "@type": "BackgroundKnowledge",
      "instance_name": "xenophobia",
      "label": "Xenophobia",
      "description": "Xenophobia is the fear or hatred of foreigners or strangers. The meme promotes xenophobic views by portraying immigrants as threats to national identity and resources. This is a widespread social phenomenon that has been used throughout history to justify discrimination, exclusion, and violence against immigrant populations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7acef8ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_437dc7c2",
      "@type": "BackgroundKnowledge",
      "instance_name": "racism",
      "label": "Racism",
      "description": "The meme implicitly relies on racist ideologies by framing immigrants as 'taking' land and resources, which is a common racist trope used to dehumanize and justify discrimination against people of color. This rhetoric often assumes that certain racial or ethnic groups are inherently less deserving of resources or land, reinforcing racial hierarchies and exclusionary policies.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7acef8ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_511209e5",
      "@type": "BackgroundKnowledge",
      "instance_name": "land_grabbing_myth",
      "label": "Land Grabbing Myth",
      "description": "The 'land grab' myth is a false narrative that claims immigrants are stealing land from native populations. This myth is often used to justify anti-immigrant policies and to incite fear and hostility toward immigrants. It is rooted in historical narratives of colonization and land ownership, and is used to reinforce the idea that immigrants are economic and cultural threats.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7acef8ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9ad2c0e3",
      "@type": "BackgroundKnowledge",
      "instance_name": "nationalism",
      "label": "Nationalism",
      "description": "Nationalism is the belief in the importance of one's nation and the promotion of national interests. The meme uses nationalist rhetoric to frame immigrants as threats to national identity and resources. This is a common political ideology that can be used to justify exclusionary policies and to promote xenophobia and racism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7acef8ea"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
