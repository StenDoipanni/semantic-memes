    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_67f97897",
      "@type": "AnalogicalMapping",
      "instance_name": "skunk_disgust_mapping",
      "label": "Skunk is mapped as 'so disgusting' entity needing legal protection",
      "description": "The text 'imagine being so disgusting there have to be laws to try to stop normal people from hating you' is mapped onto the skunk. The skunk, as a visual entity, is the subject of this mapping, representing an entity that is inherently disgusting and thus requires legal protection from public hatred. This is an analogical mapping where the skunk is the visual representation of the 'disgusting' entity described in the text.",
      "belongsToAnalysis": {
