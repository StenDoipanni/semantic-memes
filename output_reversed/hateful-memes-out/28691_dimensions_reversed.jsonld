    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c7ad4b16",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Jewish people are mapped onto grilled lobsters",
      "description": "The text 'when the jews found out it really wasn't a shower' maps the Jewish people (as a group targeted by the antisemitic stereotype) onto the visual of grilled lobsters. The visual of the lobsters being cooked on a grill is used as a crude, dehumanizing metaphor to imply that Jewish people were 'cooked' or 'processed' like food, referencing the Holocaust gas chambers. This is an analogical mapping where the textual entity 'the jews' is projected onto the visual entity 'grilled_lobsters' to create a hateful, dehumanizing comparison.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ce6a473d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4dd9f947",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the text 'when the jews found out it really wasn't a shower' as the central point of the meme's message. The text directly addresses 'the jews' as a group, and the user is implicitly positioned as the one who understands or is reacting to this hateful message, even though the text does not contain explicit deictic pronouns like 'you' or 'me'. The projection is onto the textual material because the meme's intent and impact are conveyed through the text, which frames the visual of grilled lobsters as a dehumanizing metaphor for Jewish people during the Holocaust.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ce6a473d"
      },
      "extractionMethod": "llm_extraction_huggingface"
