    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6c32ec09",
      "@type": "EmotionExpression",
      "instance_name": "frustration",
      "label": "frustrated emotion",
      "description": "The emotion of frustration is expressed through the visual of a hand pointing at the toilet flush handle and the accompanying text 'the one piece of shit that just won't flush!'. This conveys intense annoyance and exasperation at a persistent, unresolved problem — a clogged toilet that refuses to flush. The pointing gesture emphasizes the user's focus on the malfunctioning mechanism, while the vulgar language in the text amplifies the emotional intensity of the frustration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a40a6ceb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ccac41a3",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The toilet flush handle is mapped as 'the one piece of shit that just won't flush'",
      "description": "The text 'the one piece of shit that just won't flush!' is an analogical mapping that projects the toilet flush handle (the visual entity) as the object being referred to. The pointing hand directs attention to the flush handle, and the text humorously assigns it the role of a frustrating, inanimate object ('piece of shit') that refuses to function. This mapping is based on the juxtaposition of the pointing gesture and the text, which together create a humorous, hyperbolic identification of the flush handle as the source of the problem.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a40a6ceb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_48e67bbd",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the toilet flush handle via pointing gesture and text",
      "description": "The user is projected onto the visual material of the hand pointing at the flush handle, and the textual material 'the one piece of shit that just won't flush!' which humorously assigns blame to the flush handle. The pointing gesture and the text create a shared experience where the viewer identifies with the frustration, projecting themselves as the person experiencing the clogged toilet problem. The deictic nature of the pointing hand and the accusatory text create an implicit 'you' or 'me' projection onto the flush handle as the source of the annoyance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a40a6ceb"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c6f603c0",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme uses vulgar language ('piece of shit') to express frustration about a clogged toilet, which is directed at an inanimate object. While the language is offensive and potentially harmful in a general sense, it does not target any individual or protected group. The toxicity is low because the insult is hyperbolic and metaphorical, not abusive or hateful toward any person or community. The meme's intent is to create humor through relatable domestic frustration, not to cause harm.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a40a6ceb"
      },
