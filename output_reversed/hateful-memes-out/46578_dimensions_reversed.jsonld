    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6b3884fe",
      "@type": "EmotionExpression",
      "instance_name": "dark_humor",
      "label": "darkly humorous expression",
      "description": "The juxtaposition of Jack Nicholson's cheerful, benign facial expression with the text 'i think ill skip my meds and stir shit up a bit' creates a darkly humorous tone. The contrast between the positive visual cue (smiling face) and the dangerous, self-destructive message generates an unsettling, ironic humor that is potentially harmful.",
      "belongsToAnalysis": {
