    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bf95fd8c",
      "@type": "BackgroundKnowledge",
      "instance_name": "Holocaust",
      "label": "The Holocaust",
      "description": "The Holocaust was the systematic, state-sponsored persecution and murder of six million Jews by Nazi Germany and its collaborators. It is one of the most horrific genocides in human history and demands solemnity and respect. The meme references this event to imply that discussing it causes extreme emotional discomfort, which is a form of trivialization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_570982ec"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_39dcdca6",
      "@type": "BackgroundKnowledge",
      "instance_name": "Holocaust_minimization",
      "label": "Holocaust Minimization",
      "description": "A form of antisemitic trope that involves downplaying or trivializing the Holocaust, often by reducing its gravity to something humorous or mundane. This is considered harmful and offensive as it undermines the suffering of victims and the historical significance of the event.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_570982ec"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_42a8fe3a",
      "@type": "BackgroundKnowledge",
      "instance_name": "History_teacher",
      "label": "History Teacher",
      "description": "A professional educator who teaches history, often covering sensitive and traumatic events such as the Holocaust. The meme implies that the teacher's discussion of the Holocaust is so emotionally overwhelming that it causes physical reactions in students, which is a humorous but harmful trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_570982ec"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0ed132f8",
      "@type": "BackgroundKnowledge",
      "instance_name": "Emotional_distress_in_class",
      "label": "Emotional Distress in Class",
      "description": "A social phenomenon where students experience strong emotional reactions during class discussions, particularly on sensitive historical topics. The meme uses this as a comedic device to exaggerate the emotional impact of learning about the Holocaust.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_570982ec"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e34ec461",
      "@type": "EmotionExpression",
      "instance_name": "distress",
      "label": "emotional distress",
      "description": "Both individuals are covering their mouths with their hands and displaying pained facial expressions, suggesting strong emotional discomfort or nausea. This is a physical manifestation of being overwhelmed or disturbed by the subject matter mentioned in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_570982ec"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_960c52b0",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The emotional distress of students reacting to a history teacher discussing the Holocaust is mapped onto the visual of two people covering their mouths in discomfort.",
      "description": "The text 'when your history teacher starts talking about the holocaust' is mapped onto the visual of two people (a man and a woman) covering their mouths and showing expressions of distress. This mapping suggests that the visual representation of emotional discomfort (distress) is being used to symbolize the overwhelming emotional reaction one might have to learning about the Holocaust in class. The visual material (distressed_people) is being analogically mapped to the textual material (text_chunk) to convey the idea that the subject matter is so emotionally heavy that it causes physical reactions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_570982ec"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0edf84b9",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of distressed people",
      "description": "The user is projected onto the visual scene of two people covering their mouths in distress, as indicated by the textual material 'when your history teacher starts talking about the holocaust.' The phrase 'your history teacher' directly addresses the user, implying that the user is the one experiencing the emotional reaction depicted in the visual material. The user is thus projected onto the scene of emotional distress (distressed_people) as a representation of their own potential reaction to the topic.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_570982ec"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_851d06ba",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme trivializes the Holocaust by reducing its profound historical and emotional gravity to a humorous or comedic trope of exaggerated emotional distress. This minimization can be seen as disrespectful and potentially offensive to victims, survivors, and the broader Jewish community, and it risks normalizing the minimization of genocide.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_570982ec"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_292c2cbf",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "students or history class participants",
      "description": "The meme targets individuals who have experienced or are familiar with the emotional impact of learning about the Holocaust in a history class, particularly students who may feel overwhelmed or distressed during such discussions. The visual of two people covering their mouths in distress, paired with the text 'when your history teacher starts talking about the holocaust,' is designed to resonate with students who have encountered this topic in school, implying a shared, exaggerated emotional reaction. The target community is likely young adults or teenagers who have been exposed to Holocaust education in a formal educational setting.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_570982ec"
      },
