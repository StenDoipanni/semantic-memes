    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ecb0d72f",
      "@type": "Scene",
      "instance_name": "distressed_people",
      "label": "people covering mouths in distress",
      "description": "Two people are sitting side by side, both covering their mouths with their hands, showing expressions of discomfort or distress. The man on the right has his hand over his mouth and appears to be gagging or crying. The woman on the left also covers her mouth and has a pained expression. They are positioned next to each other against a plain background, suggesting a shared emotional reaction.",
      "belongsToAnalysis": {
