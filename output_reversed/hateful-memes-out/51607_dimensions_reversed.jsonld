    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8e765e39",
      "@type": "BackgroundKnowledge",
      "instance_name": "2019_Christchurch_mosque_shootings",
      "label": "2019 Christchurch Mosque Shootings",
      "description": "A mass shooting that occurred on March 15, 2019, at two mosques in Christchurch, New Zealand, during Friday prayers. The perpetrator, Brenton Tarrant, killed 51 people and injured 49 others. The attack was livestreamed on social media and widely condemned globally. The event is referenced in the meme's text and is the central real-world event being depicted. The meme's hateful intent relies on the viewer recognizing this specific, tragic event and associating it with the religious identity of the victims (Muslims) to fuel the stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3834110d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a6e2fa31",
      "@type": "BackgroundKnowledge",
      "instance_name": "Islamophobia",
      "label": "Islamophobia",
      "description": "A form of prejudice, discrimination, or hostility directed against Muslims. The meme relies on this stereotype by implying that Muslims are either insensitive (top panel) or overly emotional (bottom panel) about a mass shooting that occurred at mosques, thereby portraying them as inherently incapable of appropriate emotional response or as being complicit in the violence. This is a core component of the meme's hateful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3834110d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d1d49c86",
      "@type": "BackgroundKnowledge",
      "instance_name": "Terrorism_associations",
      "label": "Terrorism Associations",
      "description": "A common Islamophobic stereotype that links Muslims with terrorism. The meme implicitly uses this by referencing a mass shooting at mosques, which is often associated with terrorism in Western media narratives. The meme's hateful intent is to reinforce this stereotype by portraying Muslims as either indifferent to or overly emotional about such an event, thereby implying a false dichotomy or insensitivity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3834110d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fe73c909",
      "@type": "BackgroundKnowledge",
      "instance_name": "False_dichotomy",
      "label": "False Dichotomy",
      "description": "A logical fallacy that presents two opposing views as the only possibilities, ignoring other alternatives. The meme uses this by contrasting the 'insensitive' Muslim (top) with the 'overly emotional' Muslim (bottom), implying that Muslims must fall into one of these two categories when reacting to the Christchurch shootings. This is a key rhetorical device used to stereotype and demean Muslims.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3834110d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f334c183",
      "@type": "BackgroundKnowledge",
      "instance_name": "Christchurch",
      "label": "Christchurch",
      "description": "A city in New Zealand. The location of the 2019 mosque shootings. The meme's text references this specific location, which is essential for understanding the context of the event. The image does not show the location, but the text requires the viewer to know that Christchurch is a city in New Zealand to understand the event being referenced.",
