    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_af01186e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_top",
      "label": "The text '49 people were killed at christchurch' is mapped onto the smiling man labeled 'muslim'.",
      "description": "The top panel's text '49 people were killed at christchurch' is juxtaposed with the visual of a smiling man labeled 'muslim'. This mapping implies that the man represents or embodies the reaction (or lack thereof) to the event described in the text, specifically portraying him as indifferent or insensitive to the tragedy. The text explicitly labels the event, and the visual material (the man) is mapped onto this event through the label 'muslim', creating an analogical mapping where the man is presented as a representative of the Muslim community's supposed reaction to the Christchurch shootings.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3834110d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e24f3cf5",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_bottom",
      "label": "The text '49 people were killed at christchurch mosques' is mapped onto the crying man labeled 'muslim'.",
      "description": "The bottom panel's text '49 people were killed at christchurch mosques' is juxtaposed with the visual of a crying man labeled 'muslim'. This mapping implies that the man represents or embodies the emotional reaction to the event described in the text, specifically portraying him as overly emotional or grieving. The text explicitly labels the event, and the visual material (the man) is mapped onto this event through the label 'muslim', creating an analogical mapping where the man is presented as a representative of the Muslim community's supposed reaction to the Christchurch mosque shootings.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3834110d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b5d44fbe",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the smiling Muslim man in the top panel",
      "description": "The user is projected onto the visual material of the smiling man labeled 'muslim' in the top panel. The user is expected to see themselves in this figure, interpreting the man's indifference as a representation of how Muslims are supposedly reacting to the Christchurch shootings. This projection is implicit, as the meme does not use explicit deictic pronouns like 'you' or 'me', but the viewer is invited to identify with the figure as a representative of the Muslim community being stereotyped.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3834110d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cfa468d2",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme depicts a stark contrast: the top panel shows a smiling Muslim man seemingly unaware or indifferent to the tragedy, while the bottom panel shows a crying Muslim man reacting to the same event. The text in both panels refers to the 2019 Christchurch mosque shootings, which killed 49 people. The meme's intent is to portray Muslims as either ignorant or overly emotional about a mass shooting that occurred at mosques, implying a false dichotomy or insensitivity. This is a hateful meme because it targets Muslims by associating them with the perpetrators or victims of a specific atrocity, and it uses the emotional reaction of one individual to stereotype an entire religious group. The juxtaposition of the two images is meant to provoke a reaction that reinforces negative stereotypes about Muslims, particularly by implying they are either insensitive or overly dramatic, which is a form of Islamophobia.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3834110d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_90b62783",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "intended audience",
      "description": "The meme is designed for an audience that is familiar with the 2019 Christchurch mosque shootings and holds Islamophobic views. The target audience is likely individuals who are predisposed to stereotypes about Muslims, particularly those who believe Muslims are either insensitive to or overly emotional about acts of violence against them. The meme relies on the audience's recognition of the specific event and its association with Muslims to reinforce negative stereotypes. The visual contrast and the labeling of both men as 'muslim' are intended to provoke a reaction from viewers who are already inclined to view Muslims through a lens of prejudice or fear.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3834110d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
