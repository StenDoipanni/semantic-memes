    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_80352e9e",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_servitude",
      "label": "Anti-Black Stereotype: Servitude or Manual Labor",
      "description": "The meme relies on the harmful stereotype that Black people are inherently suited for menial or servile tasks, such as cleaning or 'fixing up' others. This is implied by using images of Black men in a bathroom to depict the 'next morning' scenario, suggesting they are 'cleaning up' the drunk person, which dehumanizes them and reinforces racist tropes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_26726859"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3755de79",
      "@type": "BackgroundKnowledge",
      "instance_name": "racialized_humor",
      "label": "Racialized Humor",
      "description": "The meme uses racialized humor to mock the consequences of drinking by associating the 'morning after' with Black people performing menial tasks. This type of humor is offensive and damaging because it relies on racial stereotypes to create a punchline, perpetuating systemic racism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_26726859"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_808a8c77",
      "@type": "BackgroundKnowledge",
      "instance_name": "drinking_culture",
      "label": "Drinking Culture and Its Consequences",
      "description": "The meme references the common social phenomenon of heavy drinking and the 'next morning' hangover or 'hair of the dog' scenario, where people are often depicted as needing to be 'cleaned up' or 'fixed up' after a night of drinking. This is a real-world cultural trope used for comedic effect, but here it is weaponized with racist imagery.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_26726859"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_70c0a3f1",
      "@type": "BackgroundKnowledge",
      "instance_name": "stereotype_of_black_men_as_servants",
      "label": "Stereotype: Black Men as Servants or Laborers",
      "description": "The image of Black men in a bathroom, one wrapping a cloth around a person's head, implicitly references the stereotype that Black men are inherently suited for manual labor or servitude. This is a deeply rooted racist trope that dehumanizes Black people and reduces them to a specific role in society.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_26726859"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6beedd87",
      "@type": "BackgroundKnowledge",
      "instance_name": "dehumanizing_portrayal",
      "label": "Dehumanizing Portrayal",
      "description": "The meme dehumanizes Black individuals by reducing them to a visual punchline for a white person's hangover. This portrayal strips them of dignity and agency, reinforcing the idea that their value lies only in performing menial tasks for others, which is a form of racialized dehumanization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_26726859"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
