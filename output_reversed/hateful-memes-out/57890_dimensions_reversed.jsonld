    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b1f79d46",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who hold Islamophobic views and are likely to be politically conservative or right-wing, particularly those who are hostile toward Muslim women in public office. The meme is designed to resonate with people who believe that Muslim political figures are secretly working against American values, and who are receptive to the 'Trojan horse' and 'enemy within' metaphors used to vilify them. The audience is likely to be drawn to the meme's fear-based messaging and its alignment with stereotypes such as incompatibility with Western values, terrorism associations, and oppression of women, which are central to the meme's hateful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b005488c"
      },
      "extractionMethod": "llm_extraction_huggingface"
