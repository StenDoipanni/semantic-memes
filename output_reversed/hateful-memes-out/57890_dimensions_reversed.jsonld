    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dce1fd2c",
      "@type": "Scene",
      "instance_name": "meme_scene",
      "label": "meme_with_three_politicians",
      "description": "A three-panel meme featuring three Muslim women politicians: Ilhan Omar, Linda Sarsour, and Rashida Tlaib. Each panel shows one politician with text overlaying the image. The top panel shows Ilhan Omar with the text 'he enemy within'. The middle panel shows Linda Sarsour with the text 'linda sarsour ocasio-corte'. The bottom panel shows Rashida Tlaib with the text 'the trojan horse is no longer at the gates'. The overall scene is a composite of three separate visual panels arranged vertically, each depicting a different politician with derogatory text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b005488c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d079ec9b",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_trojan_horse_metaphor",
      "label": "Islamophobic Trojan Horse Metaphor",
      "description": "The metaphor of a 'Trojan horse' is used in Islamophobic rhetoric to imply that Muslim individuals or groups are secretly hostile or deceptive, posing a hidden threat to Western societies. This metaphor is often deployed to delegitimize Muslim political figures by suggesting they are infiltrators or traitors, despite their public roles. The phrase 'the trojan horse is no longer at the gates' implies that the perceived threat has moved from being external to being internal, thus intensifying the sense of betrayal and danger.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b005488c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_001e2a3f",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_enemy_within",
      "label": "Islamophobic 'Enemy Within' Stereotype",
      "description": "The phrase 'enemy within' is a common trope in Islamophobic rhetoric, suggesting that Muslim individuals, particularly those in positions of political power, are secretly working against the interests of their host country. This stereotype frames Muslim political figures as traitors or infiltrators, implying they are not loyal to the nation they serve, but rather to a foreign or extremist cause. This concept is used to delegitimize and vilify Muslim politicians by invoking fear and suspicion.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b005488c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_735e915e",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_incompatibility_with_western_values",
      "label": "Islamophobia: Incompatibility with Western Values",
      "description": "This stereotype claims that Islamic culture and religious practices are fundamentally incompatible with Western democratic values, such as individual liberty, secularism, and gender equality. It is often used to justify hostility toward Muslim political figures by suggesting that their presence in public office represents a threat to the foundational principles of Western societies. This concept is central to the meme's framing of the three women as 'the enemy within' and 'the trojan horse'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b005488c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ffb8b0f8",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_sharia_law_fearmongering",
      "label": "Islamophobia: Sharia Law Fearmongering",
      "description": "This stereotype involves the fear that Islamic law (Sharia) will be imposed or influence public policy in Western countries, often leading to the perception that Muslim politicians are advocating for the erosion of secular governance and individual rights. This fear is used to portray Muslim political figures as threats to the social order, reinforcing the meme's message that they are 'the enemy within' and 'the trojan horse'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b005488c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a215f119",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_terrorism_associations",
      "label": "Islamophobia: Terrorism Associations",
      "description": "This stereotype links Muslim individuals, particularly those in public office, to terrorism or extremist ideologies, often without evidence. It is used to delegitimize Muslim political figures by suggesting they are either directly or indirectly connected to violent acts, thereby portraying them as dangerous or untrustworthy. This is a core component of the meme's hateful intent, as it frames the women as 'the enemy within' and 'the trojan horse'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b005488c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8e470d6b",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_oppression_of_women",
      "label": "Islamophobia: Oppression of Women",
      "description": "This stereotype claims that Islamic culture inherently oppresses women, often used to justify hostility toward Muslim women in public office. It is used to portray Muslim women politicians as threats to gender equality and Western feminist values, reinforcing the meme's message that they are 'the enemy within' and 'the trojan horse'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b005488c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
