    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6bd321d3",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Ilhan Omar is mapped as 'he enemy within'",
      "description": "The text 'he enemy within' is positioned directly above the image of Ilhan Omar, creating an analogical mapping where the textual label 'he enemy within' is projected onto the visual entity Ilhan_Omar. This mapping uses the metaphor of an 'enemy within' to vilify her, implying she is a traitor or hidden threat to American values, which is a common Islamophobic trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b005488c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1f481ffb",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the meme scene as the one who perceives the 'enemy within' and 'trojan horse' metaphors",
      "description": "The user is not explicitly projected onto a specific visual or textual element via deictic pronouns like 'me' or 'you'. However, the meme's structure and hateful intent create an implicit projection where the user is positioned as the one who perceives and interprets the derogatory metaphors ('enemy within', 'trojan horse') as true or threatening. The user is thus projected onto the overall meme scene, which functions as a frame for their interpretation of the political figures as threats. The scene itself is the entity onto which the user's perception is projected.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b005488c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
