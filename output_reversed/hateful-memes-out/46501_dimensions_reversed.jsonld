    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cad1fe0a",
      "@type": "BackgroundKnowledge",
      "instance_name": "9_11_Terrorist_Attacks",
      "label": "September 11, 2001 Terrorist Attacks",
      "description": "The catastrophic terrorist attacks on the World Trade Center in New York City, carried out by al-Qaeda, which resulted in the deaths of nearly 3,000 people. This event is the central historical reference in the top panel of the meme and is used to evoke trauma and blame. The meme's hateful intent relies on the viewer's knowledge of this event and its association with Islam.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54df4c61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d1a26e77",
      "@type": "BackgroundKnowledge",
      "instance_name": "Islamophobia",
      "label": "Islamophobia",
      "description": "The fear, hatred, or prejudice against Muslims. This meme explicitly invokes this stereotype by associating Muslims with the 9/11 attacks, which is a core component of Islamophobic rhetoric. The meme uses the traumatic event to stigmatize Muslims and implies they are responsible for the need for homeland security, which is a dangerous and false equivalence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54df4c61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cad5b89b",
      "@type": "BackgroundKnowledge",
      "instance_name": "Homeland_Security",
      "label": "U.S. Department of Homeland Security",
      "description": "A U.S. federal executive department established in 2002 in response to the 9/11 attacks. The meme references this agency as a target for defunding, implying that Muslims are responsible for its existence, which is a false and hateful equivalence. The viewer must understand the agency's purpose and its creation as a direct consequence of 9/11 to grasp the meme's implication.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54df4c61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d88842f8",
      "@type": "BackgroundKnowledge",
      "instance_name": "Muslim_in_Congress_2019",
      "label": "Muslim Woman in Congress in 2019",
      "description": "The image of a Muslim woman in Congress in 2019 is used to contrast with the 9/11 imagery. The viewer must understand that this is a political figure, not a terrorist, to recognize the meme's false equivalence and hateful intent. The meme implies that this person is somehow connected to or responsible for the 9/11 attacks, which is a baseless and dangerous stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54df4c61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fcad1529",
      "@type": "BackgroundKnowledge",
      "instance_name": "Terrorism_Associations",
      "label": "Terrorism Associations",
      "description": "The stereotype that Muslims are inherently associated with terrorism. This is a core component of the meme's hateful intent. The meme uses the 9/11 attacks to imply that all Muslims are responsible for or should be blamed for the attacks, which is a dangerous and false equivalence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54df4c61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c0a3e39b",
      "@type": "BackgroundKnowledge",
      "instance_name": "False_Equivalence",
      "label": "False Equivalence",
      "description": "A logical fallacy where two things are presented as equivalent when they are not. The meme falsely equates the actions of a small group of terrorists with the entire Muslim population and then implies that a Muslim politician in Congress is somehow responsible for the need for homeland security, which is a dangerous and false equivalence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54df4c61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5c7500e6",
      "@type": "EmotionExpression",
      "instance_name": "hateful_anger",
      "label": "hateful anger expression",
      "description": "The meme expresses hateful anger by juxtaposing the 9/11 attacks with a Muslim woman in Congress, implying she is somehow responsible for the attacks or the need for homeland security. The text 'defund homeland security!' reinforces this anger by suggesting a political action based on false equivalence and blame. The overall intent is to stigmatize and demonize Muslims through the lens of trauma and fear.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54df4c61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_95841557",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "muslims in 2001 are mapped onto the 9/11 catastrophe",
      "description": "The text 'muslims in 2001' is positioned directly above the image of the Twin Towers engulfed in flames and smoke, which visually represents the 9/11 attacks. This creates an analogical mapping where the text explicitly identifies the visual material as representing 'muslims in 2001', implying that Muslims are responsible for or associated with the 9/11 attacks. This is a core component of the meme's hateful intent and Islamophobic stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54df4c61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a940d379",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material implying collective blame",
      "description": "The user is projected onto the top textual material 'muslims in 2001' which is visually mapped onto the 9/11 catastrophe scene. This projection implies that the user is being asked to identify with or internalize the hateful stereotype that all Muslims are responsible for the 9/11 attacks. The meme's structure forces the viewer to project their own understanding of the event onto the text and image, creating a false equivalence that stigmatizes Muslims. The user is not explicitly addressed with 'you' or 'me', but the framing of the meme as a call to action ('defund homeland security!') and the juxtaposition of the 9/11 image with a Muslim politician in 2019 creates an implicit projection of responsibility onto the viewer's perception of Muslims.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54df4c61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dc0eb3ce",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks Muslims by associating them with the 9/11 terrorist attacks, invoking the harmful stereotype of Islam being linked to terrorism. It uses the traumatic event to stigmatize and demonize Muslims, which is a clear example of Islamophobia and hateful content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54df4c61"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
