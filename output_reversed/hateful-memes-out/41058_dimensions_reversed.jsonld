    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c134c48c",
      "@type": "BackgroundKnowledge",
      "instance_name": "john_wilkes_booth",
      "label": "John Wilkes Booth",
      "description": "John Wilkes Booth was the actor and Confederate sympathizer who assassinated President Abraham Lincoln on April 14, 1865, at Ford's Theatre in Washington, D.C. His actions triggered national trauma and led to his own death in a chase through Maryland. The meme references his role as the assassin and his subsequent evasion of justice, implying he is delusional or dishonest about Lincoln's death.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7a4d7008"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b109ca5d",
      "@type": "BackgroundKnowledge",
      "instance_name": "abraham_lincoln",
      "label": "Abraham Lincoln",
      "description": "Abraham Lincoln was the 16th President of the United States, known for leading the country through the Civil War and issuing the Emancipation Proclamation. His assassination by John Wilkes Booth was a pivotal and tragic event in American history, symbolizing the nation's deep divisions and the cost of preserving the Union. The meme references his death as a central historical fact.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7a4d7008"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cc7f4750",
      "@type": "BackgroundKnowledge",
      "instance_name": "assassination_of_abraham_lincoln",
      "label": "Assassination of Abraham Lincoln",
      "description": "The assassination of Abraham Lincoln on April 14, 1865, by John Wilkes Booth was a defining moment in American history. It occurred during the final days of the Civil War and led to widespread national mourning, the collapse of the Confederate cause, and the eventual passage of the 13th Amendment. The meme uses this event as its core historical reference point, mocking Booth's actions and implying he is lying or delusional about Lincoln's death.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7a4d7008"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5da26871",
      "@type": "BackgroundKnowledge",
      "instance_name": "historical_tragedy",
      "label": "Historical Tragedy",
      "description": "The assassination of Abraham Lincoln is widely regarded as a profound historical tragedy due to its impact on the nation's unity, the loss of a revered leader, and the resulting national trauma. The meme's use of dark humor to trivialize this event is considered disrespectful and potentially harmful, as it diminishes the gravity of the assassination and the suffering it caused.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7a4d7008"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
