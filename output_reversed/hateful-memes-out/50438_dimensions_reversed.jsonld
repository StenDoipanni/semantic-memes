    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b3b6f45f",
      "@type": "BackgroundKnowledge",
      "instance_name": "aids",
      "label": "AIDS",
      "description": "Acquired Immunodeficiency Syndrome, a chronic, life-threatening condition caused by the Human Immunodeficiency Virus (HIV). It severely weakens the immune system, making the body vulnerable to infections and cancers. The meme uses the term 'AIDS' in a darkly humorous context to imply that cancer is being 'infected' by AIDS, which is a medically inaccurate and offensive comparison.",
      "belongsToAnalysis": {
