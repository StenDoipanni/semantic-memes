    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f098eac0",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The joyful woman is mapped as 'what it looks like when cancer gets aids'",
      "description": "The meme text 'what it looks like when cancer gets aids' is juxtaposed with the visual of a woman smiling joyfully. This creates an analogical mapping where the woman's joyful appearance is being used to represent or symbolize the absurd, grotesque, or darkly humorous scenario described in the text. The mapping is implicit: the visual of the happy woman is being projected as the 'look' or 'appearance' of the fictional scenario where cancer is infected by AIDS. This is a harmful and medically inaccurate analogy that trivializes serious illnesses.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0db55f88"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_57066b60",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the joyful woman scene",
      "description": "The user is projected onto the visual material of the woman smiling broadly while wearing a red hijab and sunglasses. This projection occurs because the meme uses her joyful appearance as a visual representation of the absurd scenario described in the text ('what it looks like when cancer gets aids'), implying the user is seeing or imagining this grotesque analogy. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the framing of the image and text creates an implicit projection where the viewer is positioned as the observer of this darkly humorous and medically inaccurate scenario.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0db55f88"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f1a21170",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme trivializes the suffering associated with both cancer and AIDS, potentially causing distress to those affected. It also risks reinforcing negative stereotypes about people with illnesses by implying their conditions are 'contagious' or 'degrading' in a medically inaccurate way.",
      "belongsToAnalysis": {
