    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c43770b8",
      "@type": "BackgroundKnowledge",
      "instance_name": "administrators",
      "label": "administrators",
      "description": "The term 'admins' refers to individuals who hold administrative roles, typically in online communities, forums, or organizations. These roles involve moderating content, enforcing rules, managing user access, and maintaining order. The meme humorously exaggerates the frustration or exasperation admins feel when dealing with unruly or unreasonable group members, using the crying baby as an analogy for their emotional state. This requires background knowledge of administrative responsibilities and the common challenges faced by moderators in online spaces.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d102b946"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a0df1468",
      "@type": "BackgroundKnowledge",
      "instance_name": "online_groups",
      "label": "online_groups",
      "description": "The phrase 'this my group' implies a reference to online communities, forums, or social media groups where users interact and sometimes behave in ways that challenge moderation. The meme relies on the understanding that such groups can be chaotic or difficult to manage, which is a common experience for administrators. This background knowledge is necessary to interpret the context of the baby's distress as a metaphor for admin frustration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d102b946"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c3299b9b",
      "@type": "BackgroundKnowledge",
      "instance_name": "crying_baby_as_analogy",
      "label": "crying_baby_as_analogy",
      "description": "The use of a crying baby to represent the emotional state of administrators is a form of analogical mapping. This requires understanding that the baby's exaggerated distress is being used humorously to convey the perceived overreaction or emotional intensity of admins. This is a common meme trope where infantile imagery is used to depict adult emotional states, often for comedic effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d102b946"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4ea1064f",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_culture",
      "label": "meme_culture",
      "description": "The meme format 'admins be like' is part of a broader internet meme culture that uses relatable or exaggerated scenarios to create humor. Understanding this context requires knowledge of internet humor, meme tropes, and the conventions of online communities. This background knowledge helps interpret the meme as a humorous, albeit potentially insensitive, commentary on administrative roles.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d102b946"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6cf5cafc",
      "@type": "BackgroundKnowledge",
      "instance_name": "emotional_distress_in_administrators",
      "label": "emotional_distress_in_administrators",
      "description": "The meme humorously portrays the emotional distress experienced by administrators when managing difficult groups. This requires background knowledge of the real-world challenges faced by moderators, including dealing with toxic behavior, rule violations, and user conflicts. The meme's humor stems from the contrast between the baby's vulnerability and the perceived overreaction of admins, which may be seen as demeaning to those in administrative roles.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d102b946"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
