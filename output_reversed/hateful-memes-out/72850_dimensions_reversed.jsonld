    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c00d3cea",
      "@type": "BackgroundKnowledge",
      "instance_name": "holocaust",
      "label": "The Holocaust",
      "description": "A genocide during World War II in which Nazi Germany and its collaborators systematically murdered approximately six million Jews, along with millions of others including Roma, disabled individuals, Poles, Soviet prisoners of war, and others. The crematoriums depicted in the image were part of the Nazi death camps (e.g., Auschwitz-Birkenau) where bodies were incinerated to hide evidence of mass murder. Understanding this historical event is essential to interpret the text overlay's reference to 'the horrors of the Holocaust'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4010c01f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_af15f995",
      "@type": "BackgroundKnowledge",
      "instance_name": "crematorium",
      "label": "Crematorium",
      "description": "A facility designed for the incineration of human remains. In the context of the Holocaust, crematoria were part of Nazi death camps and were used to dispose of the bodies of victims on a massive scale. The image shows a crematorium oven, which is a key piece of infrastructure in the genocide. Knowledge of its function and historical context is necessary to understand the scene.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4010c01f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aa4b80e2",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_semitism",
      "label": "Anti-Semitism",
      "description": "A long-standing prejudice and discrimination against Jewish people, often rooted in religious, cultural, and racial stereotypes. The Holocaust was the culmination of centuries of anti-Semitic persecution in Europe. The meme's reference to 'the horrors of the Holocaust' implicitly invokes this historical and ideological context, which is central to understanding the gravity of the event depicted.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4010c01f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8c5aa344",
      "@type": "BackgroundKnowledge",
      "instance_name": "holocaust_denial_minimization",
      "label": "Holocaust Denial/Minimization",
      "description": "The act of denying, downplaying, or trivializing the Holocaust and its atrocities. The text overlay in the image, which states 'the horrors of the holocaust', is a direct counter to such denial. Understanding this concept is necessary to recognize that the image is meant to convey the gravity of the event, not to be dismissed or minimized.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4010c01f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_89113c26",
      "@type": "BackgroundKnowledge",
      "instance_name": "us_soldier",
      "label": "U.S. Soldier",
      "description": "A member of the United States Armed Forces. The image shows U.S. soldiers observing the aftermath of the Holocaust. Their presence is significant as they were part of the Allied forces that liberated the camps. Knowledge of their role in WWII and the liberation of concentration camps is necessary to understand the context of their actions in the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4010c01f"
      },
      "extractionMethod": "llm_extraction_huggingface"
