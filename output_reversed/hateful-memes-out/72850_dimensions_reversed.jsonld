    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ea680cd2",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of U.S. soldiers observing bodies in a crematorium",
      "description": "The user is projected onto the scene 'observing_bodies_in_crematorium' where U.S. soldiers are depicted looking at bodies in a crematorium oven. This projection is implicit, as the user is invited to identify with the witnessing role, viewing the historical horror through the lens of the soldiers' perspective. The text overlay 'the horrors of the holocaust three u.s. soldiers look at bodies' frames the scene as a collective witness experience, which the user is expected to mentally inhabit.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4010c01f"
      },
