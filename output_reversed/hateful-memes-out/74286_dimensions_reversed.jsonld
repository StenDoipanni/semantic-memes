    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9a8d6b71",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The slogan 'make america great again!!!' is mapped onto Donald Trump as the embodiment of the campaign's message.",
      "description": "The text 'make america great again!!!' is overlaid on the image of Donald Trump, who is depicted in a commanding pose. This creates an analogical mapping where the slogan is not merely text but is projected onto Trump as the personification of the slogan's promise and political agenda. The visual of Trump pointing assertively reinforces the slogan's implied call to action and leadership, mapping the abstract political message onto a specific individual who is visually associated with its delivery.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_592e1d54"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_80d349be",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the political slogan and the visual of Donald Trump",
      "description": "The user is projected onto the textual material 'make america great again!!!' and the visual material of Donald Trump, as the meme invites the viewer to identify with the slogan's message and associate it with Trump's persona. The absence of explicit deictic pronouns like 'you' or 'me' means the projection is implicit, through the rhetorical framing of the slogan and the commanding visual of Trump, which positions the viewer as an active participant in the political narrative. The user is thus projected onto the scene and the textual material as a collective embodiment of the campaign's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_592e1d54"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6b2a5796",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Propaganda",
      "description": "The meme uses the slogan 'make america great again!!!' overlaid on an image of Donald Trump pointing assertively, which is a well-known political slogan associated with his 2016 campaign. The visual and textual elements are designed to evoke strong emotional responses and reinforce support for his political agenda, functioning as political propaganda. This type of content is intended to influence opinions or actions toward a specific goal, which is a form of toxicity under the 'Propaganda' category.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_592e1d54"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
