      "@type": "BackgroundKnowledge",
      "instance_name": "political_propaganda",
      "label": "Political Propaganda",
      "description": "The dissemination of information—often biased or misleading—to promote a political agenda or candidate. The meme's intent, as described in the overall intent, is propagandistic, aiming to reinforce support for Trump by associating him with strength and national rejuvenation through visual and textual cues.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_592e1d54"
