    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_264dadbc",
      "@type": "Scene",
      "instance_name": "demanding_change_scene",
      "label": "man demanding cultural changes",
      "description": "A man with a beard and arms crossed stands in the foreground, conveying a confrontational or assertive posture. Overlaid text states he is thanking the viewer for allowing him into their country and then demands that things need to change to accommodate his beliefs. The scene implies a power dynamic where the man is asserting his demands on the host country's norms.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9fd533a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_21463d05",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia_stereotype",
      "label": "Islamophobia Stereotype",
      "description": "The meme implicitly references the stereotype that Muslims, particularly those who immigrate, demand changes to host country norms to accommodate their religious beliefs, which is a common trope in Islamophobic rhetoric. This stereotype frames religious adherence as incompatible with or superior to local culture, and often implies a threat to national identity or values.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9fd533a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a7560663",
      "@type": "BackgroundKnowledge",
      "instance_name": "sharia_law_fearmongering",
      "label": "Sharia Law Fearmongering",
      "description": "The text 'accommodate my beliefs' implicitly references the fear that religious beliefs, particularly those associated with Sharia law, will override or change host country laws and social norms. This is a common element of Islamophobic discourse, portraying religious law as inherently incompatible with Western legal and social systems.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9fd533a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c90bc7c7",
      "@type": "BackgroundKnowledge",
      "instance_name": "incompatibility_with_western_values",
      "label": "Incompatibility with Western Values",
      "description": "The meme relies on the background knowledge that some people perceive certain religious or cultural practices as fundamentally incompatible with Western democratic, secular, or liberal values. This belief is often used to justify exclusion or resistance to immigration or cultural integration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9fd533a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_42df5614",
      "@type": "BackgroundKnowledge",
      "instance_name": "immigration_status_assumptions",
      "label": "Immigration Status Assumptions",
      "description": "The phrase 'thank you for allowing me into your country' is a common rhetorical device used in anti-immigrant rhetoric to imply that immigrants are unwelcome or that their presence is a burden. It often sets up a false narrative of gratitude while simultaneously implying entitlement or a threat to the host country's values.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9fd533a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b0995b6f",
      "@type": "BackgroundKnowledge",
      "instance_name": "entitlement_to_change",
      "label": "Entitlement to Change",
      "description": "The meme relies on the stereotype that immigrants or outsiders are entitled to demand changes in the host country to accommodate their beliefs, which is a harmful and exclusionary concept. This is often used to justify resistance to integration or to portray immigrants as a threat to national identity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9fd533a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_657149df",
      "@type": "EmotionExpression",
      "instance_name": "confrontational_assertiveness",
      "label": "confrontational and assertive emotion",
      "description": "The man's stern facial expression, direct gaze, and crossed arms convey a confrontational and assertive emotional state, suggesting he is demanding or insisting on something. This posture and expression are used to project authority and resistance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9fd533a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4827154a",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The man is mapped as 'me' in the text",
      "description": "The text 'thank you for allowing me into your country' and 'now we need to talk about the things that need to change around here to accommodate my beliefs' explicitly refers to 'me'. The visual material, the man with the beard and crossed arms, is presented as the entity being referred to as 'me'. The juxtaposition of the text and the visual material creates an analogical mapping where the man is identified as the speaker ('me') in the text. This mapping is reinforced by the confrontational posture and direct gaze, which align with the assertive tone of the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9fd533a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7d9d0e61",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man as 'me' in the text",
      "description": "The user is projected onto the visual material of the man (with beard and crossed arms) because the text explicitly uses 'me' to refer to the speaker. The man is visually mapped as 'me' in the text, creating a direct semiotic projection where the viewer identifies with the speaker. The text 'thank you for allowing me into your country' and 'now we need to talk about the things that need to change around here to accommodate my beliefs' directly addresses the viewer ('you') and refers to the speaker ('me'), which is visually embodied by the man. The user is thus projected onto the man as the 'me' in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9fd533a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b5453fb4",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_2",
      "label": "User projected onto the text as 'you'",
      "description": "The user is projected onto the textual material because the text uses 'your country' and 'your beliefs', which directly address the viewer ('you'). The user is positioned as the recipient of the message, the host country, and the one whose beliefs or norms are being challenged. This creates a semiotic projection where the viewer is identified as 'you' in the text, making them the target of the demand for change.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9fd533a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_94cfeda6",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme explicitly frames the immigrant as entitled to demand changes in the host country to accommodate his beliefs, which is a hateful message targeting immigrants or those with different beliefs. It aligns with Islamophobic stereotypes by implying that religious beliefs should override or change host country norms, which can be interpreted as a threat to the host country's values and culture.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9fd533a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ad274e7e",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is individuals who hold Islamophobic views or are influenced by anti-immigrant rhetoric. The meme is designed to resonate with those who perceive immigrants, particularly those with religious beliefs that may conflict with Western values, as a threat to national identity and culture. It appeals to communities that fear or oppose cultural or legal changes driven by religious adherence, such as Sharia law, and who may support exclusionary policies based on the stereotype that immigrants are entitled to demand changes in host countries to accommodate their beliefs. The visual of the man with a beard and crossed arms, combined with the text, is intended to provoke fear and hostility toward Muslims or those perceived as such, aligning with the 'Islamophobia' category and targeting those who subscribe to 'incompatibility with Western values' and 'entitlement to change' stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9fd533a4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
