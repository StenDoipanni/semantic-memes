    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fa0ecead",
      "@type": "BackgroundKnowledge",
      "instance_name": "nascar",
      "label": "NASCAR",
      "description": "NASCAR (National Association for Stock Car Auto Racing) is a major American auto racing series known for high-speed, high-stakes, and physically demanding races. It is a cultural phenomenon in the United States, associated with athleticism, adrenaline, and competitive motorsport. The meme uses 'NASCAR presents' to mock the idea of an elderly person being associated with such a high-energy, elite sporting event.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_24c3e72a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5bd7498e",
      "@type": "BackgroundKnowledge",
      "instance_name": "wal_mart_500",
      "label": "The Wal-Mart 500",
      "description": "The Wal-Mart 500 is a fictional and satirical race name created for the meme. It is a parody of real NASCAR race names like the 'Daytona 500' or 'Sprint Cup Series' events. The name 'Wal-Mart 500' is a direct reference to the retail giant Walmart, implying a mundane, everyday, or even commercial context for a high-stakes race, thereby creating a humorous and mocking contrast with the image of the elderly woman on a mobility scooter.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_24c3e72a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fabcf84b",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism",
      "label": "Ableism",
      "description": "Ableism is a system of oppression and discrimination against people with disabilities. It often manifests as the assumption that people with disabilities are less capable, less worthy, or less deserving of respect. The meme perpetuates ableist stereotypes by mocking the physical limitations of the elderly woman and associating her with a context (NASCAR) that is not appropriate or respectful, thereby reducing her dignity and capability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_24c3e72a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f881ae21",
      "@type": "BackgroundKnowledge",
      "instance_name": "mobility_scooter",
      "label": "Mobility Scooter",
      "description": "A mobility scooter is a motorized vehicle designed to assist people with mobility impairments in moving around. It is a common assistive device for elderly individuals or those with disabilities. The meme uses the scooter as a symbol of everyday, low-speed, and non-competitive mobility, contrasting it with the high-speed, high-stakes world of NASCAR.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_24c3e72a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f33f821d",
      "@type": "BackgroundKnowledge",
      "instance_name": "stereotype_of_elderly_people_in_motorsport",
      "label": "Stereotype of Elderly People in Motorsport",
      "description": "This is a cultural stereotype that elderly people are not suited for high-speed, physically demanding activities like motorsport. The meme relies on this stereotype to create its satirical and mocking effect, implying that the elderly woman is not capable of participating in or being associated with NASCAR.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_24c3e72a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8cff00e8",
      "@type": "BackgroundKnowledge",
      "instance_name": "satirical_juxtaposition",
      "label": "Satirical Juxtaposition",
      "description": "This is a rhetorical device that involves placing two contrasting or incongruous elements together to create humor or to make a point. In this meme, the juxtaposition of an elderly woman on a mobility scooter with the text 'NASCAR presents the Wal-Mart 500' creates a humorous and mocking contrast, highlighting the absurdity of the comparison and perpetuating stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_24c3e72a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_024fefd8",
      "@type": "EmotionExpression",
      "instance_name": "mocking_contempt",
      "label": "mocking contempt emotion",
      "description": "The emotion expressed is one of mocking contempt, conveyed through the satirical juxtaposition of an elderly woman on a mobility scooter with the text 'NASCAR presents the Wal-Mart 500.' The meme uses this contrast to ridicule the physical limitations of the elderly woman and to imply she is not suited for high-stakes, high-speed activities, thereby reducing her dignity and capability. This emotion is not expressed by the woman herself but is an emotional tone imposed by the meme's creators and conveyed through the visual and textual elements.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_24c3e72a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c44bc2ce",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "NASCAR presents the elderly woman on a mobility scooter",
      "description": "The text 'nascar presents' is mapped onto the visual entity 'elderly_woman_on_scooter', implying that the elderly woman is being presented as if she were a NASCAR driver or participant in a NASCAR event. This creates a satirical and mocking contrast between the high-speed, elite world of NASCAR and the mundane, everyday context of an elderly person using a mobility scooter.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_24c3e72a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8d2205fe",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the elderly woman on the mobility scooter",
      "description": "The user is projected onto the visual material of the elderly woman on the mobility scooter, as the meme uses her as the central subject and satirical target. The user sees themselves in the role of the elderly woman, or at least identifies with the experience or perception being mocked — the idea of being associated with a high-stakes, high-speed event like NASCAR while being in a mundane, low-speed context. The projection is implicit, not deictic, but the user is positioned as the observer of the satirical juxtaposition, and thus, the subject of the meme's commentary.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_24c3e72a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_854c65e1",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "ableism",
      "description": "The meme perpetuates ableist stereotypes by mocking the physical limitations of the elderly woman and associating her with a context (NASCAR) that is not appropriate or respectful, thereby reducing her dignity and capability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_24c3e72a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ffc702da",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience for this meme is individuals familiar with NASCAR culture and American pop culture references, particularly those who understand the satirical juxtaposition of high-speed motorsport with mundane, everyday life. The meme relies on cultural knowledge of NASCAR’s branding (e.g., 'Daytona 500', 'Sprint Cup Series') and the commercial association of Walmart to create humor. The intended audience likely includes fans of NASCAR, internet meme creators and consumers who appreciate absurdist humor, and people who are aware of or have encountered ableist stereotypes in media. The meme’s humor is derived from the incongruity between the image of an elderly woman on a mobility scooter and the text 'NASCAR presents the Wal-Mart 500,' which requires an understanding of both motorsport culture and retail branding. The audience is also likely to be those who are comfortable with or have been exposed to internet memes that use satire and mockery to comment on social norms, including those related to aging and disability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_24c3e72a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
