    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f58523cb",
      "@type": "Scene",
      "instance_name": "elderly_woman_on_scooter",
      "label": "elderly woman riding mobility scooter",
      "description": "An elderly woman is seated on a blue mobility scooter, positioned in the foreground on a paved path. She is the central subject of the image, and the scooter is the vehicle she is operating. The scene is set outdoors in a residential or park-like area with trees, bushes, and a wooden fence visible in the background.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_24c3e72a"
