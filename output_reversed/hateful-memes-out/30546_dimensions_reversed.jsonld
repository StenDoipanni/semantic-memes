    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_802cbbf7",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the meme's textual and visual contrast to identify with the stereotype",
      "description": "The user is projected onto the meme's structure, which uses the text 'white people be like: CHILD'S PLAY' and the visual contrast of Chucky's 'outside' (innocent) and 'inside' (violent) states to imply that the user (or their group) embodies this harmful racial stereotype. The meme invites the user to see themselves as the subject of this dehumanizing comparison, aligning their identity with the projected image of Chucky's transformation. The text 'white people be like' directly addresses the user as part of the group being stereotyped, and the visual contrast reinforces this projection by mapping the user's perceived 'outside' self (innocent) to the top image and their perceived 'inside' self (violent) to the bottom image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_72fb2413"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3489ce8d",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful Racial Stereotype",
      "description": "The meme uses the character Chucky from 'Child's Play' to make a racially charged and harmful comparison, implying that white people are harmless and innocent 'outside' but become violent and dangerous 'inside'. This is a hateful stereotype that dehumanizes and demonizes a racial group by associating them with a violent, demonic figure. The juxtaposition of the two images of Chucky (innocent vs. violent) is used to reinforce a false and harmful narrative about white people, which is a direct attack based on race.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_72fb2413"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
