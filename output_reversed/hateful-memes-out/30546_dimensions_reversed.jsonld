      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bef9855b",
      "@type": "BackgroundKnowledge",
      "instance_name": "chucky_character",
      "label": "Chucky Character",
      "description": "The fictional character Chucky from 'Child's Play', originally a child's toy who becomes a serial killer. The meme uses his visual transformation (innocent to violent) as a metaphor for the racist stereotype. The character is not inherently racist, but is weaponized in this meme to convey a hateful message.",
