    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_13e197c8",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "White people are mapped onto Chucky's innocent appearance",
      "description": "The text 'white people be like: CHILD'S PLAY' maps the group 'white people' onto the visual entity Chucky_doll in its innocent state (top image), suggesting that white people are like the innocent-looking Chucky when viewed from the outside.",
      "belongsToAnalysis": {
