    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0ef7bcf4",
      "@type": "BackgroundKnowledge",
      "instance_name": "Twin_Towers",
      "label": "World Trade Center Twin Towers",
      "description": "The iconic twin skyscrapers located in Lower Manhattan, New York City, which were destroyed during the 9/11 attacks. They are globally symbolic of the event and are central to the visual and emotional impact of the meme.",
