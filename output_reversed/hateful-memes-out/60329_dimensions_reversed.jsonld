      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b181f2fb",
      "@type": "EmotionExpression",
      "instance_name": "grief",
      "label": "collective grief emotion",
      "description": "The image evokes profound sorrow and mourning through its depiction of the burning Twin Towers, a symbol of immense national and global tragedy. The text 'we swore we'd never forget' reinforces the enduring emotional weight of the 9/11 attacks, expressing a deep, shared sorrow for the victims and the lasting trauma of the event.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_515326ab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_84a0b79e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The phrase 'we swore we'd never forget' is mapped onto the burning Twin Towers scene.",
      "description": "The text 'we swore we'd never forget' is positioned above the burning Twin Towers, creating an analogical mapping where the traumatic event (represented by the burning towers) is equated with the concept of a solemn vow to remember. The visual material (burning Twin Towers) is mapped onto the textual promise (we swore we'd never forget), implying that the event itself is the thing being vowed to be remembered. This mapping reinforces the emotional weight of the 9/11 attacks as an enduring, unforgetable trauma.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_515326ab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f42f793f",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the collective memory and solemn vow represented by the text and scene",
      "description": "The user is not explicitly projected onto a specific deictic pronoun like 'me' or 'you'. However, the phrase 'we swore we'd never forget' creates an implicit projection where the viewer (user) is positioned as part of the collective 'we' — the group that made the solemn vow to remember the 9/11 attacks. This projection is onto the textual material ('text_chunk_1') and the scene ('burning_twin_towers_scene'), which together evoke a shared, communal identity bound by the trauma and memory of the event. The user is thus projected onto the collective entity of remembrance, symbolized by the burning towers and the vow.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_515326ab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b587e343",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme depicts the traumatic event of the 9/11 attacks, which resulted in the loss of nearly 3,000 lives. The use of this imagery, combined with the text 'we swore we'd never forget', is intended to evoke strong emotional reactions and collective grief. While not targeting specific groups with hate or abuse, the meme's harmful nature stems from its potential to trigger intense grief, trauma, and distress in viewers who experienced or were affected by the event. It may also be used in contexts that trivialize or exploit the tragedy for shock value or political commentary, which can be deeply offensive and potentially harmful to survivors, families of victims, and the broader public.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_515326ab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a16c76c3",
      "@type": "TargetCommunity",
      "instance_name": "National_Grief",
      "label": "National Grief and Collective Memory",
      "description": "The meme is designed for the broader public, particularly those who experienced or were affected by the 9/11 attacks, as well as the general population of the United States and other nations that share a collective memory of the event. The phrase 'we swore we'd never forget' and the imagery of the burning Twin Towers are intended to evoke shared national grief and reinforce the societal obligation to remember the victims. The target community is defined by their emotional connection to the trauma of 9/11, including survivors, families of victims, and the public at large who have internalized the event as a defining moment in modern history.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_515326ab"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
