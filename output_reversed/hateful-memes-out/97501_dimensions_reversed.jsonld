      "@type": "BackgroundKnowledge",
      "instance_name": "hysterical_labeling",
      "label": "Hysterical Labeling",
      "description": "A derogatory term historically used to describe women's emotional responses, particularly in contexts of stress or crisis, implying irrationality or excessive emotion. This term is used in the meme to mock women's perceived reactions to economic collapse.",
      "belongsToAnalysis": {
