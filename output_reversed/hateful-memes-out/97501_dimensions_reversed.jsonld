    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_635bb248",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "woman is mapped as 'what women think they'll do when the economy collapses'",
      "description": "The text 'what women think they'll do when the economy collapses' is juxtaposed with the visual of the shocked woman, implying that her expression and posture represent the stereotypical, exaggerated, or irrational reaction that women are assumed to have in such a scenario. The visual material (the woman's shocked expression) is being mapped onto the textual concept (the perceived female reaction to economic collapse).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0158a02e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_15e753d5",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual representation of a woman's shocked reaction",
      "description": "The user is projected onto the visual material of the woman (entity: woman) who is depicted with a shocked, fearful expression and hands covering her mouth. This projection is implied by the meme's text, which frames her reaction as a stereotype of how 'women think they'll do' when the economy collapses. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the meme's structure and intent create an implicit identification: the viewer is invited to see themselves as the observer of this stereotypical female reaction, or to identify with the stereotype being portrayed. The projection is onto the visual material (woman) which embodies the textual concept (perceived female reaction to economic collapse).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0158a02e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_86bedf39",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Mysogynous",
      "description": "The meme depicts a woman with a shocked, fearful expression, hands covering her mouth, juxtaposed with the text 'what women think they'll do when the economy collapses vs what they'll actually do.' This visual and textual combination implies that women are irrational, hysterical, or overly emotional in crisis situations, reinforcing a misogynistic stereotype that women are 'crazy' or 'hysterical' when faced with economic hardship. The intent is to mock or belittle women by suggesting their reactions are disproportionate or irrational, fitting within the 'Mysogynous' toxicity category as it targets women based on gendered stereotypes of emotional instability and irrationality.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0158a02e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6027a59b",
      "@type": "TargetCommunity",
      "instance_name": "person",
      "label": "woman",
      "description": "The intended audience is individuals who recognize and engage with gendered stereotypes, particularly those who find humor in mocking perceived female emotional instability during crises. The meme targets a community that accepts or enjoys misogynistic tropes, such as the 'hysterical woman' stereotype, and may be shared within online spaces where such humor is prevalent. The visual of the woman and the text 'what women think they'll do when the economy collapses vs what they'll actually do' are designed to resonate with those who identify with or enjoy reinforcing these stereotypes, often as a form of satire or ridicule directed at women.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0158a02e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
