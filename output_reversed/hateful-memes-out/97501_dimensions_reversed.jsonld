    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1fd5b9d0",
      "@type": "BackgroundKnowledge",
      "instance_name": "gendered_stereotype_of_emotional_instability",
      "label": "Gendered Stereotype of Emotional Instability",
      "description": "A societal stereotype that attributes emotional instability, hysteria, or irrationality to women, particularly in high-stress or crisis situations. This stereotype is often used to undermine women's competence or rationality in public or professional contexts.",
      "belongsToAnalysis": {
