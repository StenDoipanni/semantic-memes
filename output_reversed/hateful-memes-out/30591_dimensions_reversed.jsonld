    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c6a14cf7",
      "@type": "BackgroundKnowledge",
      "instance_name": "snow_removal_stereotype",
      "label": "Snow Removal as Burdensome Labor",
      "description": "The meme relies on the real-world understanding that snow removal is a physically demanding and often tedious task, especially in regions with heavy snowfall. The humor stems from the absurdity of framing snow as an 'invasion' or 'intruder' on one's land, which is a metaphorical exaggeration of the real-world burden of winter maintenance. This stereotype is commonly associated with homeowners and property owners in snowy climates who must invest time and effort into clearing snow.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a33104f9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_18bbe914",
      "@type": "BackgroundKnowledge",
      "instance_name": "property_ownership_stereotype",
      "label": "Property Ownership and Land as Personal Territory",
      "description": "The phrase 'it's white and on my land' implies a sense of territorial ownership, which is a common real-world concept. It references the idea that individuals view their property as their personal domain and are frustrated when external elements (like snow) cover or interfere with it. This is a cultural and legal concept rooted in property rights and personal space, which is not visually depicted but is essential to understanding the meme's punchline.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a33104f9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bf1f3a84",
      "@type": "BackgroundKnowledge",
      "instance_name": "pun_based_humor",
      "label": "Pun-Based Humor and Wordplay",
      "description": "The meme uses a pun on the word 'white' — playing on the color of snow and the idea of 'white' as in 'white space' or 'white land' — to create a humorous and absurd framing. This relies on the audience's understanding of wordplay and the ability to recognize the double meaning. It is a common form of humor in internet culture, often used to create ironic or sarcastic commentary.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a33104f9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_86a2817e",
      "@type": "BackgroundKnowledge",
      "instance_name": "winter_weather_stereotype",
      "label": "Winter Weather as a Burden",
      "description": "The meme implicitly references the real-world stereotype that winter weather, particularly snow, is a nuisance or burden for many people. This is a common cultural perception, especially in regions with cold climates, where snowfall can disrupt daily life, transportation, and property maintenance. The meme exaggerates this perception for comedic effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a33104f9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_699bc638",
      "@type": "BackgroundKnowledge",
      "instance_name": "snow_as_invasion_stereotype",
      "label": "Snow as an 'Invasion' or 'Intruder'",
      "description": "The phrase 'it's white and on my land' is a metaphorical exaggeration that frames snow as an unwanted 'invasion' or 'intruder' on one's property. This is a humorous and absurd stereotype that relies on the audience's understanding of the concept of 'invasion' — typically associated with military or political conflict — being applied to a natural phenomenon. This is a form of hyperbole used for comedic effect.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a33104f9"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c1c522cf",
