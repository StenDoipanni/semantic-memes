    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2f5cf99a",
      "@type": "BackgroundKnowledge",
      "instance_name": "christchurch_mosque_shootings",
      "label": "Christchurch Mosque Shootings",
      "description": "A horrific terrorist attack that occurred on March 15, 2019, in Christchurch, New Zealand, where a gunman killed 51 people and injured 49 others in two mosques during Friday prayers. This event is one of the deadliest acts of terrorism in New Zealand's history and sparked global outrage and solidarity with the Muslim community. The meme references this tragedy by implying the victims' belongings (shoes) are for sale, which is a deeply insensitive and harmful trivialization of the event and its victims.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80107d6f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_735b8f47",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia",
      "label": "Islamophobia",
      "description": "Prejudice, discrimination, or antagonism directed against Muslims. The meme exploits and perpetuates Islamophobic stereotypes by linking the mosque (a sacred place of worship for Muslims) to cheap, disposable goods, thereby dehumanizing and commodifying Muslim victims and their community. This is a form of hate speech that normalizes the vilification of Muslims and contributes to systemic discrimination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80107d6f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a076230e",
      "@type": "BackgroundKnowledge",
      "instance_name": "commodification_of_trauma",
      "label": "Commodification of Trauma",
      "description": "The act of turning traumatic events, suffering, or the belongings of victims into commercial products or commodities for profit or amusement. The meme's implication that the shoes of victims from the Christchurch mosque shootings are 'for sale' is a grotesque example of this, reducing human suffering to a marketable item and thereby desensitizing viewers to the gravity of the tragedy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80107d6f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_665ea115",
      "@type": "BackgroundKnowledge",
      "instance_name": "harmful_content",
      "label": "Harmful Content",
      "description": "Content that causes emotional distress, promotes hate, or incites harm toward a specific group. This meme is classified as harmful because it trivializes a mass murder, exploits the suffering of victims and their families, and normalizes the commodification of trauma. It can incite further disrespect or harm toward the Muslim community and perpetuate Islamophobia.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80107d6f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_33b191da",
      "@type": "EmotionExpression",
      "instance_name": "insensitivity",
      "label": "insensitive emotion",
      "description": "The emotion expressed is a cold, callous disregard for human suffering, conveyed by trivializing the victims of the Christchurch mosque shootings by implying their shoes are for sale. This reflects a profound lack of empathy and moral awareness.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80107d6f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_11dd436d",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "cheap shoes for sale... pick up.... christchurch mosque",
      "description": "The text 'cheap shoes for sale... pick up.... christchurch mosque' is mapped onto the visual material of the shoes, creating an analogical mapping where the shoes are being presented as if they are items for sale, specifically implying they are the shoes of victims from the Christchurch mosque shootings. This mapping is deeply insensitive and harmful, as it trivializes the tragedy by suggesting the victims' belongings are commodities available for purchase.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80107d6f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_97b307b5",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material implying commodification of trauma",
      "description": "The user is projected onto the textual material 'cheap shoes for sale... pick up.... christchurch mosque' which directly addresses the viewer by implying that the shoes (belonging to victims of the Christchurch mosque shootings) are available for purchase. This creates a direct, implicit address to the user, inviting them to imagine themselves as a consumer or participant in this commodification, thereby projecting the user's potential role in the harmful act of trivializing the tragedy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_80107d6f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
