    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6d28f0a7",
      "@type": "BackgroundKnowledge",
      "instance_name": "Hitler_symbolism",
      "label": "Hitler as a symbol of extreme evil and fascism",
      "description": "Adolf Hitler is historically associated with the Nazi regime, genocide (particularly the Holocaust), and fascism. His image, especially in the iconic raised-fist pose, is a potent symbol of hatred, oppression, and mass atrocity. Using his image to express frustration over a mundane expense trivializes the gravity of his crimes and is considered deeply offensive and harmful.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4ff223e2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_73ccaa4f",
      "@type": "BackgroundKnowledge",
      "instance_name": "Gas_bill_context",
      "label": "The concept of a gas bill as a common financial burden",
      "description": "A gas bill represents a recurring utility expense that many people face, often causing frustration or financial stress. The meme uses this relatable, everyday problem to create a humorous or exaggerated reaction by comparing it to the intensity of Hitler's rage, implying the bill is so overwhelming it feels like a historical catastrophe.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4ff223e2"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7902e079",
