      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bfef9b90",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Stroke Patient is mapped to Primal Reaction Scene",
      "description": "The text 'when you ask the stroke patient to smile' is mapped onto the visual of the Black woman's primal reaction. The meme implies that asking a stroke patient to smile results in the exaggerated, animalistic expression shown, thereby equating the medical condition with a primal, aggressive response. This mapping is harmful as it uses a real medical scenario to reinforce racist stereotypes about Black people being inherently primal or aggressive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7f3f80da"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2ba8b142",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of the primal reaction",
      "description": "The user is projected onto the visual scene of the Black woman's exaggerated, primal reaction, which is juxtaposed with the text about asking a stroke patient to smile. The meme implies that the user (or the viewer) is imagining themselves in the position of asking the stroke patient, and the resulting reaction is the grotesque, animalistic expression shown. This projection is part of the shock humor trope, where the viewer is invited to imagine the absurd or shocking outcome, thereby internalizing the stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7f3f80da"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
