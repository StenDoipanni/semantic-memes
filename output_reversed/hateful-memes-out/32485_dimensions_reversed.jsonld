      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fac10f38",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The elderly woman is mapped as the 'passenger' who isn't ready for sudden acceleration.",
      "description": "The text 'when you floor it but your passengers aren't ready' implies that the elderly woman is a passenger who is unprepared for sudden movements. The visual of her falling on the floor, holding her leg, and looking embarrassed is mapped onto this textual role, suggesting she is the 'passenger' who is clumsy or unprepared. This mapping is reinforced by the meme's overall intent to mock older women's physical abilities, which is a form of ageism and misogyny.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75ccde94"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9ee0d7ce",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the elderly woman as the passenger who isn't ready",
      "description": "The user is projected onto the elderly woman (VisualMaterial entity) who is depicted as the 'passenger' in the meme's scenario. The text 'when you floor it but your passengers aren't ready' uses 'your passengers' to imply the user is the driver, and the elderly woman is the passenger. The user identifies with the driver role, projecting themselves onto the scenario where they are causing the sudden movement ('flooring it') that results in the passenger (the elderly woman) falling. This projection is reinforced by the meme's overall intent to mock older women's physical abilities, making the user feel they are the one 'flooring it' while the 'passenger' (the elderly woman) is unprepared.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75ccde94"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_986aa3b8",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Mysogynous",
      "description": "The meme portrays an elderly woman as clumsy and unprepared for sudden movements, reinforcing negative stereotypes about older women's physical competence and stability. This is rooted in misogynous tropes that portray older women as emotionally unstable or physically incapable, contributing to ageist and misogynous attitudes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75ccde94"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fa08d434",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience for this meme is individuals who are familiar with or find humor in ageist and misogynous stereotypes, particularly those who perceive older women as physically clumsy or unprepared for sudden movements. The meme appeals to a community that enjoys mocking or ridiculing older women’s physical abilities, often in the context of driving or everyday mobility. This audience may include younger adults or people who hold ageist or misogynous views, and who find amusement in portraying older women as 'unready' for sudden changes, reinforcing societal biases against older women. The humor is derived from the juxtaposition of the phrase 'when you floor it' (a driving term) with the image of an elderly woman falling, which targets those who accept or enjoy such stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75ccde94"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
