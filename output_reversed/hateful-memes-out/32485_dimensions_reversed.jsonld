      "instance_name": "embarrassment",
      "label": "embarrassed emotion",
      "description": "The elderly woman's facial expression, with her head bowed and eyes looking down, conveys a sense of embarrassment or shame, likely due to having fallen and appearing unprepared or clumsy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75ccde94"
