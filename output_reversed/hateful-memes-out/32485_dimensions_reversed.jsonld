    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b99ea0a6",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogyny",
      "label": "Misogyny",
      "description": "The meme's portrayal of an elderly woman as clumsy or unprepared for sudden movements is rooted in misogynous stereotypes that portray older women as emotionally unstable or physically incapable. This reinforces negative societal attitudes toward older women, contributing to ageist and misogynous discourse.",
      "belongsToAnalysis": {
