    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4e315715",
      "@type": "VisualMaterial",
      "instance_name": "elderly_woman",
      "label": "person",
      "description": "An elderly woman with blonde hair, wearing a pink shirt and white pants, is sitting on the floor in a living room, appearing to have fallen. She is holding her leg and looking down with a pained or embarrassed expression. Her glasses are on the floor near her hand. This is the central visual subject and the focus of the meme's humor and stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75ccde94"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_96fa234d",
      "@type": "Scene",
      "instance_name": "elderly_woman_falling",
      "label": "elderly woman falling on floor",
      "description": "An elderly woman is depicted sitting on the wooden floor in a living room, appearing to have fallen. She is holding her leg, looking down with a pained or embarrassed expression, and her glasses are on the floor near her hand. The scene is framed by household items like a white cabinet, a radiator, and a blue couch in the background. The text overlay 'when you floor it but your passengers aren't ready' contextualizes the scene as a humorous or mocking depiction of clumsiness or lack of preparedness.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75ccde94"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5d57c364",
      "@type": "BackgroundKnowledge",
      "instance_name": "driving_ability_mockery",
      "label": "Driving Ability Mockery",
      "description": "The phrase 'when you floor it' is a driving term meaning to accelerate suddenly. The meme uses this phrase in a context that implies the elderly woman is clumsy or unprepared for sudden movements, which is a common stereotype used to mock older people's physical abilities, particularly in driving contexts. This stereotype is part of broader misogynous and ageist tropes that portray older women as incapable or uncoordinated.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75ccde94"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_560e5fb5",
      "@type": "BackgroundKnowledge",
      "instance_name": "age_appearance_based_value_judgments",
      "label": "Age and Appearance-Based Value Judgments",
      "description": "The meme relies on the stereotype that older women are less physically capable or more prone to clumsiness, which is a form of age-based discrimination. This stereotype reduces the value of older women based on their physical appearance and perceived mobility, reinforcing societal biases that older people are less competent or worthy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_75ccde94"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_67ee7b89",
