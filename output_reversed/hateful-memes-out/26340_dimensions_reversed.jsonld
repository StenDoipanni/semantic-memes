    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_84246318",
      "@type": "AnalogicalMapping",
      "instance_name": "goats_cant_talk_mapping",
      "label": "Goats are mapped onto Muslim men",
      "description": "The top text 'goats can't talk' is mapped onto the visual entity 'crowd_of_men'. The meme uses the visual of a large crowd of men (many raising hands) to represent Muslim men, and analogizes them to goats — implying they are mute or incapable of speaking out, particularly regarding reporting sexual violence. This is a degrading and false analogy rooted in Islamophobic stereotypes.",
      "belongsToAnalysis": {
