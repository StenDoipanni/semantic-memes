    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aa41d88b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "demand for sharia law is mapped onto the shouting man",
      "description": "The text 'we want sharia law!!' is directly associated with the visual of the man shouting, mapping the textual demand onto the visual representation of the person making the demand. The man's angry expression and aggressive posture visually embody the fervent, passionate demand stated in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c3fc2f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0312c83f",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman's dismissive gesture and text",
      "description": "The user is projected onto the woman in the bottom panel, who is gesturing dismissively and speaking with vulgar language ('then go the fuck home'). The user identifies with her stance of rejection and contempt toward the demand for Sharia law, projecting themselves as the one who is exasperated, authoritative, and unwilling to engage with the demand. The gesture and text are the focal point of this projection, as they embody the user's imagined response to the situation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c3fc2f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
