    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3d9ef695",
      "@type": "BackgroundKnowledge",
      "instance_name": "sharia_law",
      "label": "Sharia Law",
      "description": "Sharia law is a system of religious law derived from the Quran and Hadith, governing aspects of life for Muslims, including personal conduct, family law, and criminal law. It is often misunderstood or misrepresented in Western contexts as inherently oppressive or incompatible with modern democratic values, which is a central theme in the meme's hostile intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c3fc2f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4cfe9ce5",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia",
      "label": "Islamophobia",
      "description": "Islamophobia is the fear, hatred, or prejudice against Islam and Muslims. It often manifests as stereotypes portraying Muslims as terrorists, backward, or incompatible with Western values. The meme leverages this by equating Sharia law with backwardness and using aggressive language to reject it, reflecting Islamophobic tropes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c3fc2f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a97ffb3a",
      "@type": "BackgroundKnowledge",
      "instance_name": "western_context",
      "label": "Western Context",
      "description": "The meme implies a Western setting (e.g., office, modern society) as the norm, contrasting it with the perceived 'backwardness' of Sharia law. This reflects a cultural bias that positions Western values as superior and any deviation (like Sharia law) as unwelcome or threatening.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c3fc2f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ddd81f68",
      "@type": "BackgroundKnowledge",
      "instance_name": "sharia_law_fearmongering",
      "label": "Sharia Law Fearmongering",
      "description": "This is a common trope in anti-Islamic rhetoric, where Sharia law is portrayed as a threat to Western values, women's rights, or individual freedoms. The meme uses this fear to justify its hostile response, implying that anyone advocating Sharia law should be excluded from Western society.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c3fc2f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_79104570",
      "@type": "BackgroundKnowledge",
      "instance_name": "dismissive_gesture",
      "label": "Dismissive Gesture",
      "description": "The woman’s hand gesture (palms up, shrugging) is a non-verbal cue often used to express exasperation or dismissal. In this context, it reinforces the aggressive and contemptuous tone of the text, signaling that the speaker finds the demand for Sharia law absurd or unacceptable.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c3fc2f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_50ceaddd",
      "@type": "BackgroundKnowledge",
      "instance_name": "vulgar_language",
      "label": "Vulgar Language",
      "description": "The use of the phrase 'the fuck' is a strong expletive that conveys anger, contempt, and a desire to shut down dialogue. It amplifies the hostile intent of the meme, making the rejection of Sharia law not just political but personal and emotionally charged.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c3fc2f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_72ed5e28",
      "@type": "EmotionExpression",
      "instance_name": "anger",
      "label": "angry expression",
      "description": "The man in the top panel is displaying an angry facial expression with a furrowed brow, wide-open mouth, and intense gaze, conveying aggression and fervent emotion. His posture, pointing forward with clenched fists in the background, reinforces this emotion. The text 'we want sharia law!!' amplifies the intensity of his anger, suggesting a passionate, possibly hostile, demand.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02c3fc2f"
