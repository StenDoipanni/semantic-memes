    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_14239968",
      "@type": "Scene",
      "instance_name": "stereotypical_juxtaposition",
      "label": "Stereotypical Juxtaposition Scene",
      "description": "The scene presents a visual and textual juxtaposition that creates a harmful stereotype. It features an East Asian woman positioned above a close-up of ramen noodles, with overlaid text that falsely claims she has 'English tattoos' and humorously equates this to 'soup' (a play on 'sou' as in 'soup' in English). This composition is designed to mock and stereotype East Asian individuals by linking them to a superficial and inaccurate cultural reference.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d6a67497"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
