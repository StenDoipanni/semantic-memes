    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a53ab0e1",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "what women think they'll do when the economy collapses",
      "description": "The top text 'what women think they'll do when the economy collapses' is mapped onto the visual entity 'woman_with_bow', implying that this woman represents the idealized, self-reliant, prepared response to economic collapse. The visual of her aiming a bow and arrow symbolizes competence, readiness, and survivalist capability as the 'thought' or 'ideal' scenario.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a54c5fe1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1af53c60",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the contrast between idealized and transactional female behavior",
      "description": "The user is projected onto the meme's structure, which presents a false dichotomy: the top image (woman_with_bow) represents the idealized, self-reliant response to economic collapse, while the bottom image (transactional_scene) represents the stereotyped, transactional response. The user is implicitly positioned as someone who perceives or judges this dichotomy, aligning with the meme's misogynistic framing. There are no explicit deictic pronouns like 'me' or 'you', but the meme's structure invites the user to adopt the perspective of the narrator who presents this binary view.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a54c5fe1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e7c4db8c",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Mysogynous",
      "description": "The meme portrays women as morally or practically inferior in crisis situations by reducing their potential actions to transactional or sexualized behavior, reinforcing harmful gender norms and devaluing women's competence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a54c5fe1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e084122d",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who are familiar with and may find humor in misogynistic stereotypes, particularly those who endorse or are exposed to the 'gold digger' and 'self-reliance' dichotomies. The meme is designed to resonate with audiences who perceive women as either overly prepared or morally inferior in crisis situations, often reinforcing harmful gender norms. It appeals to those who enjoy or are entertained by false dichotomies that oversimplify complex human behavior, particularly in the context of economic collapse. The meme's use of visual contrast (preparedness vs. transactional behavior) and its reliance on the 'woman with bow' and 'woman in revealing outfit' imagery targets viewers who recognize and internalize these gendered stereotypes. The audience likely includes individuals who are culturally attuned to internet memes that rely on objectification and reductionist portrayals of women, and who may find amusement in the exaggerated, stereotypical portrayal of female behavior under economic stress.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a54c5fe1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
