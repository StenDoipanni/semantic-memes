      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1349131f",
      "@type": "BackgroundKnowledge",
      "instance_name": "gold_digger_stereotype",
      "label": "Gold Digger Stereotype",
      "description": "The bottom image implies that women will engage in transactional relationships for financial gain, which aligns with the 'gold digger' stereotype. This stereotype suggests that women are primarily motivated by money and will sacrifice their moral or social integrity for financial benefit, reinforcing the idea that women are morally or practically inferior in crisis situations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a54c5fe1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a82a1351",
      "@type": "BackgroundKnowledge",
      "instance_name": "economic_collapse",
      "label": "Economic Collapse",
      "description": "The meme references the concept of 'economic collapse,' a real-world scenario where an economy experiences severe downturns, leading to widespread unemployment, inflation, and resource scarcity. The meme uses this concept to frame a hypothetical scenario where societal norms and survival strategies are tested, implying that women's responses will be judged by a false dichotomy of preparedness versus transactional behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a54c5fe1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fdc41982",
      "@type": "BackgroundKnowledge",
      "instance_name": "self_reliance",
      "label": "Self-Reliance",
      "description": "The top image implies that women will be self-reliant and prepared for survival, a concept often associated with 'prepper' culture or survivalist ideologies. This stereotype suggests that capable individuals will take proactive measures to ensure their safety and well-being during crises, contrasting with the perceived passivity or transactional behavior of women in the bottom image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a54c5fe1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_02cc39a4",
      "@type": "BackgroundKnowledge",
      "instance_name": "transactional_relationships",
      "label": "Transactional Relationships",
      "description": "The bottom image implies that women will engage in transactional relationships, where personal or romantic interactions are based on financial gain or material benefit. This concept is often associated with stereotypes that portray women as morally or practically inferior in crisis situations, reducing their potential actions to sexualized or financially motivated behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a54c5fe1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c514431e",
      "@type": "BackgroundKnowledge",
      "instance_name": "false_dichotomy",
      "label": "False Dichotomy",
      "description": "The meme uses a false dichotomy by presenting only two extreme options for women's behavior during economic collapse: either being self-reliant and prepared or engaging in transactional relationships. This oversimplification ignores the complexity of human behavior and societal responses to crisis, reinforcing the stereotype that women are incapable of nuanced or balanced responses.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_a54c5fe1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b1469ee8",
