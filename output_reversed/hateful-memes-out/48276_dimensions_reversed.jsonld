    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_21c73fd3",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_semitism_nose_caricature",
      "label": "Anti-Semitic Nose Caricature Stereotype",
      "description": "A widely circulated antisemitic stereotype that caricatures Jewish people by emphasizing their nose, often implying inferiority or criminality. This stereotype is historically rooted in European antisemitism and is used to dehumanize and demean Jewish individuals. In this meme, Hitler’s prominent nose is implicitly referenced as part of the visual stereotype that has been used to mock or dehumanize him, even though the image itself does not contain any explicit antisemitic text or imagery.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7d83dd1a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cb723f8a",
      "@type": "BackgroundKnowledge",
      "instance_name": "hitler_nazi_leadership",
      "label": "Hitler as Nazi Leader",
      "description": "Adolf Hitler was the leader of the Nazi Party and Chancellor of Germany from 1933 until his death in 1945. His regime was responsible for the Holocaust, the systematic genocide of six million Jews and millions of others, including Roma, disabled people, and Slavs. His leadership is associated with extreme racism, totalitarianism, and global conflict. This background knowledge is essential to understand the offensive nature of the meme, which uses his image to mock a culinary rating system, thereby trivializing his historical atrocities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7d83dd1a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ee8dfd1e",
      "@type": "BackgroundKnowledge",
      "instance_name": "master_chef_show",
      "label": "MasterChef Television Show",
      "description": "MasterChef is a popular reality television cooking competition show that originated in the United States and has been adapted in many countries. Contestants compete in culinary challenges judged by professional chefs, with ratings and eliminations based on skill and presentation. The meme references this specific cultural phenomenon, using the concept of 'master chef' ratings to create a jarring and offensive juxtaposition with Hitler’s image, implying that even a 'master chef' can be 'low rated' — a twisted analogy that normalizes or trivializes his atrocities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7d83dd1a"
      },
      "extractionMethod": "llm_extraction_huggingface"
