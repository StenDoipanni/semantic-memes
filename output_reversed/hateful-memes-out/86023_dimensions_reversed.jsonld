    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_cc4e53a0",
      "@type": "BackgroundKnowledge",
      "instance_name": "white_settler",
      "label": "White settler",
      "description": "A term used in historical and political discourse to refer to European colonizers who settled in territories outside their home continent, often displacing or subjugating indigenous populations. In contemporary usage, especially in decolonial and anti-racist discourse, it is often used to critique the cultural appropriation and historical injustices committed by white settlers in colonized lands. The meme targets this group by implying their cultural engagement is morally bankrupt.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_12c29a92",
      "@type": "BackgroundKnowledge",
      "instance_name": "cultural_appropriation",
      "label": "Cultural appropriation",
      "description": "The act of taking elements from a culture that is not one's own, often without permission or understanding, and using them in a way that can be seen as disrespectful, exploitative, or commodifying. This concept is central to the meme's message, which accuses white settlers of using other cultures to fill an 'empty soul'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8bfacf9e",
      "@type": "BackgroundKnowledge",
      "instance_name": "empty_soul",
      "label": "Empty soul",
      "description": "A disparaging metaphor implying moral or spiritual deficiency, often used to suggest that a person lacks depth, meaning, or cultural authenticity. In the context of the meme, it is used to devalue the cultural engagement of white settlers, implying their actions are superficial or compensatory for inner voids.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ac43c187",
      "@type": "BackgroundKnowledge",
      "instance_name": "settler_colonialism",
      "label": "Settler colonialism",
      "description": "A form of colonialism in which settlers establish permanent settlements in a territory, often displacing or eradicating indigenous populations, and imposing their own cultural, political, and economic systems. This concept underpins the historical context of 'white settler' and is central to critiques of cultural appropriation in colonized contexts.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f7fa7edf",
      "@type": "BackgroundKnowledge",
      "instance_name": "racially_charged_hate_speech",
      "label": "Racially charged hate speech",
      "description": "Speech that targets individuals or groups based on race or ethnicity, often intended to incite hatred, fear, or violence. The meme is explicitly identified as hateful and racially charged, targeting white settlers by suggesting their cultural engagement is morally deficient and indicative of racial superiority or cultural ownership.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bc167133",
      "@type": "BackgroundKnowledge",
      "instance_name": "cultural_ownership",
      "label": "Cultural ownership",
      "description": "The idea that certain cultures or groups have exclusive rights to their cultural expressions, often used in anti-racist discourse to challenge the notion that cultures can be appropriated or borrowed without permission or understanding. The meme implies that white settlers are claiming ownership of other cultures, which is a central point of contention in decolonial theory.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0724da72",
      "@type": "BackgroundKnowledge",
      "instance_name": "white_supremacist_narrative",
      "label": "White supremacist narrative",
      "description": "A set of beliefs and ideologies that assert the inherent superiority of white people and the inferiority of other races. The meme's message, which implies that white settlers are morally bankrupt for appropriating other cultures, is consistent with white supremacist narratives that seek to justify racial hierarchy and cultural dominance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ad518448",
      "@type": "BackgroundKnowledge",
      "instance_name": "decolonial_theory",
      "label": "Decolonial theory",
      "description": "A body of critical theory that seeks to challenge and dismantle colonial structures and ideologies, including the appropriation of indigenous and non-Western cultures by Western powers. The meme's critique of white settlers' cultural appropriation is rooted in decolonial theory, which views such appropriation as a form of cultural theft and moral failure.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b771e850",
      "@type": "BackgroundKnowledge",
      "instance_name": "cultural_theft",
      "label": "Cultural theft",
      "description": "A term used to describe the act of taking cultural elements from one group and using them without permission or understanding, often in a way that is disrespectful or exploitative. The meme uses this concept to accuse white settlers of stealing other cultures to fill their 'empty souls'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b7e8862e",
      "@type": "BackgroundKnowledge",
      "instance_name": "moral_bankruptcy",
      "label": "Moral bankruptcy",
      "description": "A term used to describe a state of complete moral failure or corruption. The meme uses this concept to accuse white settlers of being morally bankrupt for appropriating other cultures, implying that their actions are inherently unethical and indicative of a deeper moral deficiency.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e5c6bbb8",
      "@type": "EmotionExpression",
      "instance_name": "contempt",
      "label": "contemptuous emotion",
      "description": "The woman's downward gaze and neutral or pensive facial expression, combined with the hateful text overlay, convey a sense of disdain or contempt toward the target group (white settlers) being criticized. The overall visual and textual context frames her as embodying the very thing the meme is condemning, thus expressing contempt for the cultural appropriation it describes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_82fe78be",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The woman is mapped as a representation of a 'white settler' whose cultural engagement is morally bankrupt.",
      "description": "The text 'stop using other's cultures to fill up your empty white settler soul' explicitly targets 'white settlers'. The visual of the woman, with her light skin and casual appearance holding a drum (a cultural artifact), is mapped onto the concept of 'white settler' as the subject of the accusation. The meme implies that the woman (as a visual representation) embodies the 'white settler' being criticized for cultural appropriation, thus creating an analogical mapping where the visual entity (woman) is projected as the textual entity (white settler).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a037ac6d",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message targeting 'white settler' identity",
      "description": "The user is projected onto the textual material of the meme, which directly addresses 'your empty white settler soul'. The phrase 'your' explicitly deictically directs the accusation at the viewer/user, making them the target of the moral judgment. The user is thus projected onto the textual entity that contains the accusatory pronoun 'your', which personalizes the message and implicates the viewer in the described moral failing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e95ad44c",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme delivers a racially charged and culturally insensitive message targeting white settlers by accusing them of moral bankruptcy for cultural appropriation, which is a form of hate speech directed at a specific racial group.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_02ec73a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
