      "@id": "http://example.org/multimodal-taxonomy#dimension_edf3c449",
      "@type": "BackgroundKnowledge",
      "instance_name": "internet_meme_culture",
      "label": "Internet Meme Culture",
      "description": "The meme format — top image with text, bottom image with contrasting scene — is a common structure in internet meme culture. Understanding this cultural context helps interpret the meme as a form of humorous commentary or satire, rather than a literal statement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6074b1c3"
