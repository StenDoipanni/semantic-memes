    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_73a65058",
      "@type": "EmotionExpression",
      "instance_name": "irony",
      "label": "ironic emotion",
      "description": "The emotion expressed is irony, stemming from the humorous contrast between the text 'enjoying in beach' and the visual content showing a desert canyon instead of a beach. The visual pun creates an ironic situation where the expectation of a beach vacation is subverted by a desert landscape, evoking amusement through the misalignment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6074b1c3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4a717fbb",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "Textual description mapped onto visual scene",
      "description": "The text 'enjoying in beach' is mapped onto the visual scene of a woman relaxing on a blue towel in a sandy environment. The mapping is ironic because the visual context (desert canyon landscape in the bottom panel) contradicts the textual claim of being on a beach, creating a visual pun. The text implies a beach vacation experience, which is visually represented by the top image, but the bottom image subverts this expectation by showing a desert, thus the text is analogically mapped onto the top visual scene to create humor through misalignment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6074b1c3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4bc76da3",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the text 'enjoying in beach' as the focal point of the meme's ironic message. The text serves as the primary anchor for the user's interpretation, prompting them to mentally map the visual content (top image of a woman on sand, bottom image of a desert canyon) onto the textual claim, creating the humorous dissonance. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the meme's structure and intent require the user to project themselves as the observer and interpreter of the visual pun, making the text the central point of projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6074b1c3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
