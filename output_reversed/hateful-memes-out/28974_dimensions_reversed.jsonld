      "@id": "http://example.org/multimodal-taxonomy#dimension_db9724e6",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_gorilla",
      "label": "Anti-Black Stereotype: Comparing Black People to Primates",
      "description": "This stereotype, rooted in racist history, dehumanizes Black individuals by likening them to animals, particularly apes or gorillas. It is used to imply inferiority, aggression, or animalistic behavior, and is a core component of systemic racism. The phrase 'gorilla in a fuckin coupe' is a derogatory trope that combines this stereotype with hypersexualization and objectification, often used to demean Black men.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3167fd09"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3fb2af80",
      "@type": "BackgroundKnowledge",
      "instance_name": "text_chunk_4_gorilla_coupe_reaction",
      "label": "Textual Reference: 'Gorilla in a Fuckin Coupe Reaction'",
      "description": "This phrase is a specific, offensive meme template that references the 'gorilla in a coupe' trope, which is a racist caricature. It implies that Black men are hypersexualized, aggressive, and animalistic, often used to mock or demean them. The phrase is not a literal description but a coded, hateful reference to a harmful stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_3167fd09"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c2b2e441",
