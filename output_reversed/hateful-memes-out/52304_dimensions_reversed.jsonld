    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_072f10f5",
      "@type": "BackgroundKnowledge",
      "instance_name": "Pride_Weekend",
      "label": "Pride Weekend",
      "description": "A Pride Weekend refers to a series of LGBTQ+ pride events, including parades, festivals, and celebrations, typically held over a weekend to commemorate LGBTQ+ history and visibility. It is a global cultural phenomenon rooted in the Stonewall Uprising of 1969 and is recognized as a time for community, solidarity, and celebration of LGBTQ+ identities. The term 'Pride Weekend' implies a festive, public gathering that often includes rainbow flags, inclusive messaging, and expressions of joy and resistance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b36a6748"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0791eb7c",
      "@type": "BackgroundKnowledge",
      "instance_name": "LGBTQ_Pride",
      "label": "LGBTQ+ Pride",
      "description": "LGBTQ+ Pride is a global movement and cultural expression celebrating lesbian, gay, bisexual, transgender, queer, and other non-heteronormative identities. It is rooted in historical activism and is often marked by public demonstrations, parades, and festivals. The rainbow flag, visible in the image, is the international symbol of LGBTQ+ Pride, representing diversity and inclusion. The term 'gays' in the text refers to gay men, a subset of the broader LGBTQ+ community.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b36a6748"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0b95e448",
      "@type": "BackgroundKnowledge",
      "instance_name": "Rainbow_Flag",
      "label": "Rainbow Flag",
      "description": "The rainbow flag is the most widely recognized symbol of LGBTQ+ Pride. It was designed by Gilbert Baker in 1969 and has since become an international emblem of LGBTQ+ identity, diversity, and solidarity. Its colors represent different aspects of the community (e.g., red for life, orange for healing, yellow for sunlight, green for nature, blue for harmony, and violet for spirit). Its presence in the image is a direct visual reference to LGBTQ+ Pride culture.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b36a6748"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bbffdcbf",
      "@type": "BackgroundKnowledge",
      "instance_name": "LGBTQ_Discrimination_Stereotype",
      "label": "LGBTQ+ Discrimination Stereotype",
      "description": "This refers to the real-world societal stereotypes and prejudices that LGBTQ+ individuals often face, including being labeled as 'predators,' 'mentally ill,' or 'against nature.' The text 'gays on their way home after pride weekend' implicitly references the broader social context in which LGBTQ+ people may be subject to discrimination, even after celebratory events. The meme's positive intent contrasts with these external societal prejudices.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b36a6748"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_957045c0",
      "@type": "BackgroundKnowledge",
      "instance_name": "LGBTQ_Visibility",
      "label": "LGBTQ+ Visibility",
      "description": "LGBTQ+ visibility refers to the public acknowledgment and celebration of LGBTQ+ identities and experiences. It is a key goal of Pride events and is often framed as a form of resistance against historical erasure and marginalization. The image and text together imply that the subjects are visibly expressing their identity in a public, celebratory context, which is a direct reference to the broader social movement for LGBTQ+ visibility.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b36a6748"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
