    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c1cca694",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The text 'gays' is mapped onto the two women in the foreground.",
      "description": "The text 'gays on their way home after pride weekend' explicitly refers to 'gays' as the subject of the scene. The visual material shows two joyful women at a Pride event, adorned with rainbow symbols and celebrating. Although the text uses the term 'gays' (which specifically refers to gay men), the visual material depicts two women, who are likely LGBTQ+ allies or participants (as inferred from context). The mapping is analogical because the text assigns the identity of 'gays' to the visual subjects, even though the visual subjects may not be gay men. This is a direct textual-to-visual mapping where the text labels the visual entities with a specific identity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b36a6748"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ce7126be",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of two women celebrating at Pride",
      "description": "The user is projected onto the visual scene of two joyful women embracing and celebrating at a Pride event, as indicated by the overall positive and celebratory intent of the meme. The user identifies with or imagines themselves in the context of the scene, sharing in the joy and solidarity depicted. There are no explicit deictic pronouns like 'me' or 'you' in the text, but the implicit projection is onto the scene and its participants, as the user is encouraged to see themselves as part of the community or experience being celebrated.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b36a6748"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
