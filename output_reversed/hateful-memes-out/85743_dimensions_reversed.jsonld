    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a551ddfa",
      "@type": "BackgroundKnowledge",
      "instance_name": "stephen_colbert",
      "label": "Stephen Colbert",
      "description": "The man in the image is widely recognized as Stephen Colbert, a well-known American comedian, television host, and political commentator. His image is frequently used in memes for comedic effect, often to parody or satirize formal or serious contexts. Knowing who he is helps interpret the meme’s tone and intent.",
      "belongsToAnalysis": {
