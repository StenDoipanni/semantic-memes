    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f9f42c03",
      "@type": "AnalogicalMapping",
      "instance_name": "steak_black_mapping",
      "label": "steak is black",
      "description": "The text 'this steak is so black' is mapped onto the visual material of Gordon Ramsay, who is the central figure in the image. The joke implies that the steak (which is not visible) is so dark (overcooked) that it is 'black' — a wordplay that can be interpreted as a racial stereotype. The visual of Gordon Ramsay, known for his harsh criticism, is used to deliver this absurd and potentially offensive joke. The mapping is created by juxtaposing the text with his image, implying that he is the one who is 'black' (in the racial sense) or that the steak is so black it's 'asking' for a cigarette, which is a crude pun. The visual material (Gordon Ramsay) is mapped onto the textual material ('this steak is so black') to create the analogy that the steak is so black it's asking for a Newport cigarette.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7de79901"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5c4c5101",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material via the deictic 'me'",
      "description": "The user is projected onto the textual material 'it asked me for a newport' because the phrase 'me' explicitly refers to the viewer/user. This creates a direct semiotic projection where the user is positioned as the subject of the action described in the text — the one being asked by the steak. The projection is onto the textual material, which contains the deictic pronoun 'me'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_7de79901"
      },
      "extractionMethod": "llm_extraction_huggingface"
