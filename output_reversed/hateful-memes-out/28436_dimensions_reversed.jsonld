    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0b872eb5",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_socialism_bread_line",
      "label": "Socialism is mapped to people lining up for bread",
      "description": "The top text 'socialism.' is juxtaposed with the visual of shelves filled with bread, implying that under socialism, people line up for bread. The visual of the bread on shelves is mapped to the textual concept of 'people lining up waiting for bread' as a representation of socialism's perceived inefficiency or scarcity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_724eca87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f00503c8",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the baker holding bread as a symbol of capitalist efficiency",
      "description": "The user is implicitly projected onto the baker, who is the central visual figure holding bread. The meme frames the baker as the embodiment of the capitalist system's efficiency — where bread (goods) is abundantly produced and readily available, contrasting with the imagined inefficiency of socialism. The user is invited to identify with the baker's role as a provider in a market system, reinforcing the meme's propagandistic message that capitalism is superior because it delivers goods to consumers without requiring queues. The projection is onto the VisualMaterial entity 'baker' and the Scene entity 'baker_holding_bread', which together represent the capitalist ideal.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_724eca87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b9c9108f",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Propaganda",
      "description": "The meme uses a simplified and exaggerated analogy to promote a specific ideological viewpoint (favoring capitalism over socialism), which is a form of ideological propaganda. It aims to influence viewers' opinions by oversimplifying complex economic systems.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_724eca87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a0485042",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "ideological audience",
      "description": "The meme is designed for individuals who are engaged in ideological debates about economic systems, particularly those who hold favorable views toward capitalism and critical views toward socialism. The target audience likely includes politically or economically aware individuals who interpret the meme as a simplified argument for market efficiency over centralized planning. The meme relies on understanding of economic ideologies and uses propaganda techniques to reinforce existing biases, making it most effective for audiences already predisposed to favor capitalism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_724eca87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
