    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_74d11b4f",
      "@type": "BackgroundKnowledge",
      "instance_name": "socialism",
      "label": "Socialism",
      "description": "A political and economic ideology advocating for public or collective ownership of the means of production, distribution, and exchange. In the meme, it is used as a shorthand for a system where resources (like bread) are rationed or distributed through centralized planning, often implying scarcity or inefficiency. This is a real-world concept that requires external knowledge to understand the meme's contrast with capitalism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_724eca87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_eda5f0a2",
      "@type": "BackgroundKnowledge",
      "instance_name": "capitalism",
      "label": "Capitalism",
      "description": "An economic system based on private ownership of the means of production and the creation of goods and services for profit. In the meme, it is used to represent a market-driven system where supply meets demand efficiently, implying abundance and consumer choice. This is a real-world concept that requires external knowledge to understand the meme's contrast with socialism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_724eca87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c4ffa401",
      "@type": "BackgroundKnowledge",
      "instance_name": "economic_system_comparison",
      "label": "Economic System Comparison",
      "description": "The meme relies on a simplified, often misleading, comparison between two complex economic systems. It uses the metaphor of bread distribution to represent broader economic principles, which requires understanding of economic theory and ideological debates. This is a real-world concept that is not visible in the image but is essential to interpret the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_724eca87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_34f472e2",
      "@type": "BackgroundKnowledge",
      "instance_name": "ideological_propaganda",
      "label": "Ideological Propaganda",
      "description": "The meme is designed to promote a specific ideological viewpoint (favoring capitalism over socialism) by using a simplified and often exaggerated analogy. This requires understanding of how propaganda works and how it uses visual and textual elements to influence opinion, which is a real-world concept not visible in the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_724eca87"
