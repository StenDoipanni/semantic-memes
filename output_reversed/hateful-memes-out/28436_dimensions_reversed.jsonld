    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7b3aee78",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: socialism_vs_capitalism_bread_meme; hasOverallIntent: Propaganda; overall-intent-description: The meme uses a visual of a baker holding bread to contrast 'socialism' (people lining up for bread) with 'capitalism' (bread lining up for people), implying capitalism is more efficient. This is a propagandistic simplification of complex economic systems, aiming to influence viewers' opinions by using an oversimplified analogy. The intent is to promote a favorable view of capitalism and a negative view of socialism, potentially reinforcing ideological biases. No specific protected group is targeted, but the meme relies on economic ideology as a form of ideological propaganda.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_724eca87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
