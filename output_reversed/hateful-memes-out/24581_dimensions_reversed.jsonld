    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_372bc392",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Textual warning mapped onto visual pedestrians",
      "description": "The text 'be careful with pedestrians' is mapped onto the visual entity 'men_walking' in the top image. The meme implies that these men, who are walking on a roadside, are the 'pedestrians' that drivers should be cautious of, creating an ironic or darkly humorous contrast with the graphic accident scene below. This mapping is established by the juxtaposition and the text's direct reference to pedestrians, which are visually represented by the men walking.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0e24a4e0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ef0b92c1",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual warning and the visual scene of pedestrians",
      "description": "The user is projected onto the textual material 'be careful with pedestrians' and the visual material of the men walking, as the meme implies the user (or the viewer) is the driver who should be cautious. The projection is not explicit with deictic pronouns like 'you' or 'me', but is implied through the framing of the warning as directed at the viewer (the driver) and the juxtaposition of the pedestrian scene with the accident scene, which the user is expected to interpret as a consequence of ignoring the warning. The user is thus projected onto the act of driving and the responsibility implied by the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0e24a4e0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
