    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0ff07c7f",
      "@type": "BackgroundKnowledge",
      "instance_name": "sanctuary_city_policy",
      "label": "Sanctuary City Policy",
      "description": "A policy adopted by some U.S. cities that limits cooperation with federal immigration enforcement, such as not honoring detainers or not sharing information about undocumented residents with federal authorities. The term 'sanctuary city' is often used in political debates about immigration, and the meme references this policy in a contradictory way — first demanding it, then criticizing it for being 'used' to shelter undocumented individuals. This requires background knowledge of U.S. immigration policy and local government autonomy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02984b4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7419ba49",
      "@type": "BackgroundKnowledge",
      "instance_name": "illegals",
      "label": "Term 'illegals'",
      "description": "A derogatory and dehumanizing term used to refer to undocumented immigrants. It is not a legal term and is considered offensive and inaccurate. The use of this term in the meme reflects a stereotype that portrays undocumented immigrants as criminals or undesirables, which is a common trope in anti-immigrant rhetoric. Understanding this term's connotation is essential to interpreting the meme's tone and intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02984b4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_33f31fec",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_immigrant_rhetoric",
      "label": "Anti-Immigrant Rhetoric",
      "description": "A set of political and social arguments that portray immigrants — particularly undocumented immigrants — as a threat to national security, economic stability, or cultural values. This rhetoric often includes fearmongering, scapegoating, and dehumanizing language. The meme’s use of contradictory text and the term 'illegals' is a form of anti-immigrant rhetoric that aims to provoke a reaction by highlighting perceived contradictions in immigration policy.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02984b4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f8a3a84b",
      "@type": "BackgroundKnowledge",
      "instance_name": "hypocrisy_in_politics",
      "label": "Hypocrisy in Politics",
      "description": "The concept of hypocrisy refers to the practice of pretending to have virtues, moral principles, or beliefs that one does not actually have. The meme uses the contradiction in the text — demanding a sanctuary city and then criticizing it for being 'used' to shelter undocumented individuals — to satirize or criticize political hypocrisy. This requires background knowledge of political discourse and the use of irony or satire in political memes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02984b4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_593aabf8",
      "@type": "BackgroundKnowledge",
      "instance_name": "deportation_policy",
      "label": "Deportation Policy",
      "description": "A policy or legal process by which a government removes a person from its territory, typically for immigration violations. The meme references the idea of 'sending illegals to our sanctuary city,' which implies a contradiction in deportation policy — that sanctuary cities are somehow 'avoiding' responsibility for deporting undocumented individuals. This requires background knowledge of U.S. immigration enforcement and the legal framework surrounding deportation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_f02984b4"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a828758f",
      "@type": "BackgroundKnowledge",
      "instance_name": "stereotype_of_elderly_activists",
      "label": "Stereotype of Elderly Activists",
      "description": "A stereotype that portrays elderly people as being more likely to be involved in activism or protests, often as a symbol of moral authority or passionate civic engagement. The image of an elderly woman holding a protest sign may invoke this stereotype, which is used to frame her as a passionate, morally driven figure. This stereotype is often used in media and political discourse to evoke sympathy or to contrast with other groups.",
      "belongsToAnalysis": {
