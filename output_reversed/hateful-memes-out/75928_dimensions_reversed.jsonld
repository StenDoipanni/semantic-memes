    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5bd8c7a4",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Drake is mapped as 'white people after they put the divider in between your groceries'",
      "description": "The meme text 'white people after they put the divider in between your groceries' is juxtaposed with Drake's image. His satisfied expression and body language are analogically mapped to the implied satisfaction or amusement of 'white people' in the scenario described by the text. This mapping uses Drake's visual representation to stand in for the 'white people' who are supposedly acting in a racially discriminatory manner, thereby projecting the textual concept onto the visual entity. The mapping is hateful as it uses a Black celebrity to represent a stereotype of racial segregation and dehumanization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e76e3977"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6aa24ea4",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material describing racial segregation",
      "description": "The user is projected onto the textual material 'white people after they put the divider in between your groceries' because the phrase uses 'your groceries' which implies a direct address to the viewer (the user) as the recipient of the discriminatory action. The user is positioned as the 'you' in the scenario, experiencing the racial segregation depicted. This projection is hateful as it frames the user as a victim of racial discrimination in a mundane setting, reinforcing anti-Black stereotypes by making the viewer identify with the targeted group.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e76e3977"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
