    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8f70031a",
      "@type": "BackgroundKnowledge",
      "instance_name": "grocery_store_divider",
      "label": "Grocery Store Divider",
      "description": "The phrase 'divider in between your groceries' refers to a physical or policy-based separation in a grocery store, which is a real-world practice that can be used to enforce racial segregation. This is a form of institutionalized racism that has historical roots in the United States and other countries, where Black people were often excluded from certain areas of public spaces. The meme uses this concept to imply that white people are deliberately separating Black people from their groceries, which is a form of racial discrimination.",
      "belongsToAnalysis": {
