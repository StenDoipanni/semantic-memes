    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3a340cfa",
      "@type": "BackgroundKnowledge",
      "instance_name": "stereotype_vocalness_weakness",
      "label": "Stereotype: Vocalness equates to weakness",
      "description": "The meme implies that being loud or outspoken is a sign of weakness, which is a social stereotype that can be harmful. This stereotype may be particularly damaging when applied to marginalized groups, as it can devalue assertiveness or advocacy. The meme's message is not explicitly targeted at a specific group, but the framing risks reinforcing a broader cultural narrative that devalues vocalness, especially in contexts where such traits are associated with marginalized communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1d6573bc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dc3a404e",
      "@type": "BackgroundKnowledge",
      "instance_name": "denzel_washington_public_personality",
      "label": "Denzel Washington's public persona as authoritative and respected",
      "description": "Denzel Washington is widely recognized as a powerful, respected, and authoritative figure in Hollywood, often portrayed as a serious, stoic, and commanding presence. His public image is leveraged in the meme to contrast with the message about vocalness and weakness, creating a juxtaposition that may be interpreted as ironic or sarcastic. The use of his persona to deliver a potentially negative stereotype about vocal individuals is a key element of the meme's impact.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1d6573bc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e5c6dd3f",
      "@type": "BackgroundKnowledge",
      "instance_name": "social_hierarchy_commentary",
      "label": "Social hierarchy commentary",
      "description": "The meme implicitly references social dynamics and hierarchies, suggesting that in certain contexts, those who are most vocal may be perceived as the least capable or powerful. This commentary on social behavior is a common theme in internet memes, but the framing here may be interpreted as subtly reinforcing a hierarchy that devalues assertiveness or outspokenness, particularly in contexts where such traits are associated with marginalized groups.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1d6573bc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3935153d",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism_concept",
      "label": "Ableism concept: Denial of competence based on vocalness",
      "description": "The meme's message can be interpreted as an example of ableism, where being vocal is equated with weakness or incompetence. This is a form of social stigma that can be harmful to individuals who are vocal in their advocacy or expression, particularly if they are perceived as 'too loud' or 'too assertive'. The meme may contribute to a broader cultural narrative that devalues assertiveness or outspokenness, which can be seen as a form of ableism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1d6573bc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ce3678b7",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_formatting_convention",
      "label": "Meme formatting convention: Text overlay on actor image",
      "description": "The meme follows a common internet meme format where a well-known actor or public figure is used as a visual anchor for a text-based message. This format relies on the viewer's recognition of the actor and their public persona to deliver the message. The use of Denzel Washington in this format is a key element of the meme's effectiveness, as his authoritative image contrasts with the message about vocalness and weakness.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_1d6573bc"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
