    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1bb7e0dc",
      "@type": "BackgroundKnowledge",
      "instance_name": "stereotype_innocent_victim",
      "label": "Innocent Victim Stereotype",
      "description": "The meme relies on the stereotype that innocent, vulnerable, or naive individuals (often children or those perceived as 'pure' or 'soft') are easy targets for exploitation or aggression. The baby's cheerful, innocent appearance is used to contrast with the violent threat, implying that someone who appears harmless is being targeted. This stereotype is often used to justify or frame aggressive responses to perceived naivety or vulnerability.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_12748632"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6e9dca48",
      "@type": "BackgroundKnowledge",
      "instance_name": "threatening_language",
      "label": "Threatening Language",
      "description": "The text 'i will stab u in the neck susan' is a direct, violent threat. Understanding the severity and implications of this language requires real-world knowledge about the nature of threats, violence, and the legal and social consequences of such statements. The use of 'stab u in the neck' is a specific, graphic description of violence that is not visually depicted but is understood as a serious and potentially lethal act.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_12748632"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6e3d52e1",
      "@type": "BackgroundKnowledge",
      "instance_name": "personalized_threat",
      "label": "Personalized Threat",
      "description": "The inclusion of the name 'susan' personalizes the threat, making it targeted and specific to an individual. This requires understanding that threats are often more impactful and serious when they are directed at a specific person, as opposed to being general or abstract. The use of a name implies a real-world individual who is being targeted, which adds a layer of personalization and potential harm to the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_12748632"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ec03b8ff",
      "@type": "BackgroundKnowledge",
      "instance_name": "abusive_meme_tone",
      "label": "Abusive Meme Tone",
      "description": "The meme's overall tone is abusive, as it uses a vulnerable image (the baby) to deliver a violent threat. This requires understanding that memes can be used to convey harmful, intimidating, or abusive messages, even if they are presented in a seemingly innocent or humorous way. The juxtaposition of innocence and violence is a common trope in abusive memes, designed to shock or intimidate.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_12748632"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b4aea360",
      "@type": "BackgroundKnowledge",
      "instance_name": "juxtaposition_trope",
      "label": "Juxtaposition Trope",
      "description": "The meme uses the trope of juxtaposition — placing two contrasting elements (innocent baby vs. violent threat) side by side to create a jarring effect. This trope is common in internet culture and requires understanding of how visual and textual elements are combined to create meaning or emotional impact. The contrast is meant to shock the viewer and emphasize the suddenness or irrationality of the threat.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_12748632"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c226b809",
      "@type": "EmotionExpression",
      "instance_name": "innocence",
      "label": "innocent expression",
      "description": "The baby's wide, bright eyes, broad smile showing teeth, and raised clenched fists convey a sense of pure, unguarded joy and innocence. This expression is visually contrasted with the violent text to emphasize the perceived naivety of the target.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_12748632"
