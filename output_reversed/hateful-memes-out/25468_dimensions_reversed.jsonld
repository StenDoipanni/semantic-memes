      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1046194b",
      "@type": "Scene",
      "instance_name": "progressive_standing_sequence",
      "label": "Progressive standing sequence of men in suits",
      "description": "A visual sequence showing four men in suits transitioning from crawling on all fours to standing upright, symbolizing a metaphorical 'evolution' or 'progress'. The men are arranged in a diagonal line from left to right, with each subsequent figure standing progressively more upright than the previous one. This sequence is used to visually represent the meme's text, which claims that 'white people walked on all fours before black people came and showed them how to stand up'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_98862280"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
