    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_370a9bbc",
      "@type": "VisualMaterial",
      "instance_name": "man_in_suit_crawling",
      "label": "man in suit crawling on all fours",
      "description": "A man dressed in a dark suit and tie is positioned on his hands and knees, appearing to crawl. This posture is the starting point of the visual sequence and is used metaphorically to represent 'walking on all fours'. The man's expression is focused, and his body is low to the ground, emphasizing the crawling motion. This figure is the first in a progression that visually represents a 'before' state.",
      "belongsToAnalysis": {
