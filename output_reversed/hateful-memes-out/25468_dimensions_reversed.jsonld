  "dimensions": [
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d1a93e7d",
      "@type": "OverallIntent",
      "instance_name": "overallintent_instance",
      "label": "the overallintent",
      "description": "meme-id: white_people_walked_on_all_fours_before_black_people_came_and_show_them_how_to_stand_up; hasOverallIntent: hateful; overall-intent-description: The image depicts a sequence of men in suits progressively standing up from a crawling position, with text claiming 'white people walked on all fours before black people came and showed them how to stand up.' This meme uses a racist stereotype by comparing Black people to primates, implying inferiority and suggesting that Black people 'civilized' white people. The visual metaphor of 'walking on all fours' is a degrading and offensive comparison to non-human primates, which is a well-documented anti-Black stereotype. The meme's intent is to demean Black people by portraying them as the 'superior' force that 'taught' white people to stand upright, which is both historically inaccurate and deeply offensive. The overall intent is hateful, as it targets Black people based on race and perpetuates harmful racial stereotypes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_98862280"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
