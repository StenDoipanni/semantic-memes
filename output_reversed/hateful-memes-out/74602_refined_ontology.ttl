:fearmongering_parenting rdf:type :BackgroundKnowledge ;
                rdfs:label "Fearmongering in Parenting"@en ;
                rdfs:comment "A rhetorical strategy that uses fear to influence behavior, often by exaggerating the consequences of a particular action or inaction. The meme uses the image of a car accident to instill fear in parents who do not spank, suggesting that their parenting choice leads to dangerous outcomes."@en ;
                :extractionMethod "regex_fallback" ;
