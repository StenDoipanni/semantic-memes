###  http://example.org/multimodal-taxonomy#causal_fallacy
:causal_fallacy rdf:type :BackgroundKnowledge ;
                rdfs:label "Causal Fallacy"@en ;
                rdfs:comment "A logical error that assumes a cause-and-effect relationship between two events when none exists or when the relationship is not established. The meme commits this fallacy by implying that not spanking causes car accidents, which is a non sequitur."@en ;
                :extractionMethod "regex_fallback" ;
