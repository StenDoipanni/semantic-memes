    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d86ba556",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "Woman's seductive gaze is mapped as 'that look'",
      "description": "The textual phrase 'when she gives you that look' explicitly refers to the visual expression of the woman — her coy, seductive gaze with a hand near her head — as the specific 'look' being described. This creates an analogical mapping where the woman's facial expression and body language are identified as the embodiment of the textual concept 'that look'. The mapping is reinforced by the meme's overall misogynous intent, which frames this gaze as inherently suggestive or manipulative, aligning with the stereotype that a woman's gaze is a tool of sexual availability or control.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5027edaf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c7f52896",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the textual material 'you that look' because the phrase 'when she gives you that look' directly addresses the viewer ('you') as the recipient of the woman's gaze. This creates an implicit deictic reference to the user, positioning them as the target of the woman's 'look' and inviting the user to identify with the experience of being looked at in this context. The projection is onto the textual material because the deictic 'you' is embedded in the text, which frames the user's perspective and role in the meme's scenario.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5027edaf"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
