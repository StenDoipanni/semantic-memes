    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2fe20711",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The dog is mapped as the victim of stolen friendship",
      "description": "The text 'and jews stole it and have removed it from me' explicitly attributes the loss of 'friendship' to 'jews' and implies that the speaker (the 'me') is the victim. The visual material, the Shiba Inu dog, is positioned as the focal point and its expression (false victimhood) is used to visually represent this victimized state. The dog is thus analogically mapped as the 'me' in the text, embodying the victimhood described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d1648784"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_777c1b83",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the Shiba Inu dog as the victim",
      "description": "The user is projected onto the Shiba Inu dog, which is visually and textually framed as 'me' in the antisemitic message. The text 'and jews stole it and have removed it from me' explicitly uses 'me' to refer to the speaker, and the dog's expression is used to visually represent this victimized state. The dog is analogically mapped as the 'me' in the text, embodying the victimhood described in the message. This projection leverages the dog's innocent appearance to imply a false sense of victimhood, which is then falsely attributed to Jews in the text, thereby making the hateful content more palatable or shareable.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d1648784"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
