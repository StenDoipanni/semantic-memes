      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0cbae735",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_format",
      "label": "Meme Format: 'Alright Girls! Smiiiiile'",
      "description": "This is a widely circulated internet meme format that uses an image of a group of girls (often from non-Western cultures) with text overlaying them that demands they smile. The format is used to mock or pressure people into conforming to a Western standard of 'appropriate' or 'performative' happiness, often reducing their identities to their facial expressions. The exaggerated 'smiiiiile' text emphasizes the performative nature of the demand.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9c046026"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3efc741e",
      "@type": "BackgroundKnowledge",
      "instance_name": "cultural_appropriation",
      "label": "Cultural Appropriation of Non-Western Expressions",
      "description": "The meme implicitly references the idea that non-Western expressions of joy or emotion are 'other' and must be 'corrected' or 'standardized' to fit Western norms. This reflects a broader pattern of cultural appropriation where Western media or internet culture imposes its own aesthetic or behavioral standards on non-Western subjects, often without context or respect for their cultural authenticity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9c046026"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fd213973",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogyny",
      "label": "Misogyny: Objectification and Emotional Performance",
      "description": "The meme contains a misogynous undertone by reducing the girls' identities to their facial expressions and enforcing a specific emotional performance (smiling). This reflects the broader stereotype that women, especially women of color, are valued primarily for their appearance and emotional compliance, and that their authentic emotions are less valid than those that conform to societal expectations.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9c046026"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_36f5fabd",
      "@type": "BackgroundKnowledge",
      "instance_name": "stereotype_of_non_white_women",
      "label": "Stereotype: Non-White Women as Emotionally Inexpressive or 'Exotic'",
      "description": "The meme implicitly relies on the stereotype that non-white women, particularly those from African or Muslim backgrounds, are either overly emotional or 'exotic' in their expressions, and thus need to be 'corrected' to fit a Western standard of 'appropriate' emotion. This stereotype is often used to justify the imposition of Western norms on non-Western cultures.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9c046026"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_08453d14",
      "@type": "BackgroundKnowledge",
      "instance_name": "western_standard_of_beauty",
      "label": "Western Standard of Beauty and Emotional Expression",
      "description": "The meme implicitly references the Western cultural standard that equates happiness with a specific facial expression (a wide, toothy smile) and that emotional authenticity must be 'performed' for the camera. This standard is often imposed on non-Western subjects, who are expected to conform to it, even if their expressions are genuine or culturally different.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9c046026"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7eab3033",
      "@type": "BackgroundKnowledge",
      "instance_name": "performative_smiling",
      "label": "Performative Smiling as a Social Performance",
      "description": "The meme references the concept of 'performative smiling' — the act of smiling for the camera or in social situations even when one is not genuinely happy. This is often used to create a positive image or to conform to social expectations, and the meme uses this concept to mock or pressure the girls into smiling, even if they are not 'supposed' to.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9c046026"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
