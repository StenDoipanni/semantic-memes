      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a627bf40",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Text demands the girls to smile",
      "description": "The text 'alright girls!' and 'smiiiiiiile' is overlaid on the image of the girls, creating an analogical mapping where the text explicitly commands the visual subjects (the girls) to perform a specific emotional expression (smiling). This mapping is central to the meme's format and intent, as it juxtaposes the text's demand with the girls' genuine or neutral expressions, implying a performative or forced compliance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9c046026"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d0aba808",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual demand for smiling",
      "description": "The user is projected onto the textual material 'smiiiiiiile' and 'alright girls!', which commands the visual subjects to perform a specific emotional expression. This creates an implicit 'you' projection, where the user is positioned as the one issuing the demand or as the one who is expected to comply with the performative smiling standard. The meme format inherently invites the viewer to imagine themselves as the authority figure or the one being addressed, thus projecting the user's identity onto the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9c046026"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
