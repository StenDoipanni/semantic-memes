    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e0cd3e8f",
      "@type": "BackgroundKnowledge",
      "instance_name": "dumb_jock_stereotype",
      "label": "Dumb Jock Stereotype",
      "description": "A cultural stereotype depicting a man who is overly macho, physically imposing, and often portrayed as unintelligent or lacking in sophistication. This stereotype is frequently used in memes to represent someone who is oblivious to social norms or consequences, and is often associated with exaggerated confidence and a dismissive attitude toward criticism. The visual of the man in the green suit with a wide-legged stance and cigarette is a classic representation of this trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d59b15d8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_da4d29d5",
      "@type": "BackgroundKnowledge",
      "instance_name": "offensive_content_dismissal",
      "label": "Dismissal of Offensive Content",
      "description": "The concept that some individuals trivialize or downplay criticism regarding offensive jokes, memes, or content, often by claiming they are 'not that bad' or 'can go lower,' implying that the offense is so minor it's not worth taking seriously. This reflects a broader cultural trend of minimizing social sensitivity and accountability for harmful content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d59b15d8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fbfd21e9",
      "@type": "BackgroundKnowledge",
      "instance_name": "meme_culture",
      "label": "Meme Culture",
      "description": "A social and internet-based phenomenon characterized by the rapid creation, sharing, and modification of humorous or satirical images, often with text overlays. Memes are used to comment on current events, social issues, or to express shared humor, but can also be used to spread offensive or harmful content. The meme in question is a product of this culture, using visual and textual elements to convey a specific attitude.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d59b15d8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_871bf7a5",
      "@type": "BackgroundKnowledge",
      "instance_name": "social_sensitivity",
      "label": "Social Sensitivity",
      "description": "The awareness and consideration of how one's words, actions, or content may affect others, particularly in terms of cultural, racial, gender, or other social identities. The meme's text references the concept of 'heavily offensive' content, which implies a concern for social sensitivity, making the dismissal of such concerns central to the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d59b15d8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d0df6185",
      "@type": "BackgroundKnowledge",
      "instance_name": "harmful_social_norms",
      "label": "Harmful Social Norms",
      "description": "Norms or behaviors that, while perhaps socially accepted or even encouraged in certain contexts, can lead to negative outcomes such as the normalization of offensive or insensitive content, discouraging accountability, and promoting a culture of disregard for social sensitivity. The meme's intent to trivialize criticism of offensive content can be seen as reinforcing such harmful norms.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_d59b15d8"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
