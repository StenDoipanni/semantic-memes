    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f3d13c7f",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The woman is mapped as the 'me' in the text",
      "description": "The text 'If he's marrying me then why's he fucking a goat' explicitly refers to a female subject ('me') who is the victim of betrayal. The visual material shows a woman with an exaggerated expression of shock and disbelief, which is mapped onto this textual 'me'. The woman's emotional state and physical posture (hands on head, open mouth) are used to visually represent the shock and outrage implied by the text, making her the embodied representation of 'me' in the meme's narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c7791d4a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0c214179",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman as 'me' in the text",
      "description": "The user is projected onto the visual material of the woman, who is depicted with an exaggerated expression of shock and disbelief. This projection is explicitly anchored by the textual material 'If he's marrying me then why's he fucking a goat,' where 'me' directly refers to the woman. The user identifies with the woman as the victim of betrayal, making her the embodied representation of 'me' in the meme's narrative. The woman's physical posture and facial expression visually represent the shock and outrage implied by the text, reinforcing the user's identification with her emotional state.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_c7791d4a"
      },
      "extractionMethod": "llm_extraction_huggingface"
