      "@type": "BackgroundKnowledge",
      "instance_name": "social_awareness_campaign",
      "label": "Social Awareness Campaign",
      "description": "A public initiative designed to educate the public about a social issue and encourage action or change. The meme functions as a form of visual propaganda within such a campaign, aiming to evoke empathy and motivate viewers to support or act against domestic abuse.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6215ae78"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b63c4d70",
      "@type": "BackgroundKnowledge",
      "instance_name": "propaganda",
      "label": "Propaganda",
      "description": "The deliberate, often biased dissemination of information to promote a particular political, social, or ideological cause. The meme’s intent to influence public opinion and action against domestic abuse qualifies it as propagandistic, using emotional appeal to motivate viewers.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6215ae78"
      },
