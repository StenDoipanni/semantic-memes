    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2c95a14e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The text 'put an end to domestic abuse!' is mapped onto the visual scene depicting domestic abuse.",
      "description": "The textual message 'put an end to domestic abuse!' directly refers to the visual scene of a man in a suit leaning over a distressed woman on the floor, which is explicitly interpreted as an instance of domestic abuse. The mapping is direct: the text calls for an end to the very situation visually portrayed. The visual material (domestic_abuse_scene) is the target of the call to action expressed in the text (text_chunk).",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6215ae78"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dd4d262f",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the call to action text",
      "description": "The user is implicitly projected onto the textual material 'put an end to domestic abuse!' as the intended audience for the call to action. The text directly addresses the viewer, urging them to take societal action against domestic abuse, thereby positioning the user as the agent of change. This projection is not explicit with deictic pronouns like 'you' or 'me', but is implied through the imperative nature of the message and the visual context of suffering, which demands viewer response.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6215ae78"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_818204e0",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The image depicts a scene of domestic abuse, which can cause psychological and physical harm to victims and may trigger trauma responses in viewers. The visual representation of distress and power imbalance is intended to evoke strong emotional reactions, which, while part of a social awareness campaign, carries inherent potential for harm if not handled sensitively.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6215ae78"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
