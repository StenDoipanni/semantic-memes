      "@type": "BackgroundKnowledge",
      "instance_name": "emotional_appeal",
      "label": "Emotional Appeal",
      "description": "A rhetorical strategy that aims to evoke an emotional response from the audience to influence their attitudes or behaviors. The image uses visual distress and the text’s urgent call to action to trigger empathy and motivate viewers to support the cause of ending domestic abuse.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6215ae78"
