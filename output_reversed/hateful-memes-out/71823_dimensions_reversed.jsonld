    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ef458521",
      "@type": "BackgroundKnowledge",
      "instance_name": "gender_based_violence",
      "label": "Gender-Based Violence",
      "description": "Violence directed against individuals based on their gender, often disproportionately affecting women and girls. Domestic abuse is a primary form of gender-based violence. The meme implicitly references this broader category of violence to frame the issue within a wider social justice context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6215ae78"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
