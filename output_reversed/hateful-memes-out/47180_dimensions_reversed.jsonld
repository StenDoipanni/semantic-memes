    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_421645c6",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'and that's why i gas people' maps onto Adolf Hitler as the perpetrator of genocide.",
      "description": "The textual element 'and that's why i gas people' is an analogical mapping that projects Adolf Hitler (the visual entity) as the cause or reason for the vulgar pun. The text implies that Hitler is responsible for the act of 'gassing' people, equating his historical role in the Holocaust (which involved gas chambers) with a crude, modern slang meaning of 'gas'. This mapping is hateful and offensive, as it trivializes genocide by associating it with a vulgar joke. The visual material (Adolf_Hitler) is mapped onto the textual concept of a genocidal perpetrator whose actions are being mocked.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9e04151e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ed524968",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the hateful joke scene",
      "description": "The user is projected onto the overall hateful joke scene, which combines the visual material of Adolf Hitler with the textual material 'and that's why i gas people'. The meme's structure invites the user to identify with the perpetrator (Hitler) as the source of the vulgar pun, thereby projecting the user's identity onto the genocidal figure and the hateful context. This projection is implicit, as the meme does not use explicit deictic pronouns like 'you' or 'me', but the framing of Hitler as the 'reason' for the joke ('and that's why i gas people') creates a psychological projection where the user is positioned as the one who understands or is responsible for the joke, even if only by association with the perpetrator. The user is thus projected onto the scene as the one who is 'gassing' people, either literally or metaphorically, through the act of trivializing genocide.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_9e04151e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
