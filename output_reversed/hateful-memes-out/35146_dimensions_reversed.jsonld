      "@id": "http://example.org/multimodal-taxonomy#dimension_584ac220",
      "@type": "BackgroundKnowledge",
      "instance_name": "accent_mockery",
      "label": "Accent Mockery",
      "description": "The meme relies on mocking the speaker's accent by using the phrase 'dey call me wong' and 'sum ting wong,' which are phonetic approximations of Cantonese phrases meaning 'they call me wrong' and 'something is wrong.' This is a form of linguistic stereotyping that targets East Asian speakers, implying their speech is incorrect or comical.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ca67a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d227087d",
      "@type": "BackgroundKnowledge",
      "instance_name": "emasculation_of_asian_men",
      "label": "Emasculation of Asian Men",
      "description": "The meme uses the exaggerated, forced laughter and the mocking text to portray the man as foolish or incompetent, reducing his identity to a caricature based on perceived linguistic traits. This aligns with the broader anti-Asian racism trope of emasculation, which seeks to undermine the masculinity and dignity of Asian men.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ca67a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_45be83a6",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_asian_racism",
      "label": "Anti-Asian Racism",
      "description": "The meme is rooted in anti-Asian racism, specifically targeting East Asian individuals through linguistic stereotyping and visual caricature. It perpetuates harmful tropes that associate East Asian people with incompetence, foolishness, or being 'wrong' in a way that is inherently offensive and dehumanizing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ca67a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dc0d4709",
      "@type": "BackgroundKnowledge",
      "instance_name": "cantonese_phrase",
      "label": "Cantonese Phrase",
      "description": "The phrases 'dey call me wong' and 'sum ting wong' are phonetic approximations of Cantonese expressions. 'Dey call me wong' mimics '佢哋叫我去唔到' (they call me wrong), and 'sum ting wong' mimics '有啲嘢唔對' (something is wrong). These phrases are not literal translations but are used to mock the speaker's accent and imply that their speech is incorrect or foolish.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ca67a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c503e8f5",
      "@type": "EmotionExpression",
      "instance_name": "mocking_laughter",
      "label": "mocking and exaggerated laughter",
      "description": "The man's facial expression—eyes squinted shut, mouth wide open showing teeth, and exaggerated grin—conveys a forced, over-the-top laugh. This is not genuine joy but a caricatured expression meant to appear foolish or comical, aligning with the meme’s intent to mock and stereotype. The expression is amplified by the text overlay, which frames his laughter as evidence of being 'wrong' or 'foolish'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ca67a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_94557054",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The person is mapped as 'dey call me wong'",
      "description": "The text 'dey call me wong' is positioned above the person's head, directly mapping the person as the subject of the phrase. The person is visually presented as the entity being referred to by the text, creating an analogical mapping where the individual is identified as 'me' in the phrase 'dey call me wong'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ca67a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c08c752c",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the person in the image",
      "description": "The user is projected onto the visual material of the person (man with glasses and earphones) because the text 'dey call me wong' directly maps the person as 'me', creating an analogical mapping where the viewer identifies with the subject of the phrase. The phrase 'dey call me wong' implies the person is the one being referred to as 'me', thus projecting the user's identity onto the visual entity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_15ca67a3"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
