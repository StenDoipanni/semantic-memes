    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aad2513d",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_infantilization",
      "label": "Anti-Black Stereotype: Infantilization",
      "description": "The meme relies on the harmful stereotype that Black children are cognitively incapable of understanding or following basic instructions, thereby infantilizing them and devaluing their intelligence. This is a form of racialized mockery that implies Black children are 'foolish' or 'dumb' simply because of their race, which is a core component of anti-Black racism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_31390fe5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8d070278",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_cognitive_deficiency",
      "label": "Anti-Black Stereotype: Cognitive Deficiency",
      "description": "The meme implicitly references the stereotype that Black people, particularly children, are less intelligent or less capable of understanding complex instructions. This stereotype is used to justify the child's perceived 'failure' to follow the doctor's advice, reinforcing a racist narrative that Black people are inherently less competent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_31390fe5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b217864b",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_racialized_mockery",
      "label": "Anti-Black Stereotype: Racialized Mockery",
      "description": "The meme's humor is derived from mocking the child's perceived 'foolishness' or 'incompetence', which is framed as a racial trait. This form of mockery targets Black children specifically, using their race as the basis for the joke, which is a hallmark of racist humor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_31390fe5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_88d5f448",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_dehumanization",
      "label": "Anti-Black Stereotype: Dehumanization",
      "description": "By portraying the child as incapable and in need of constant supervision, the meme dehumanizes Black children, reducing them to objects of pity or ridicule rather than recognizing their full humanity and cognitive abilities. This dehumanization is a tool used to justify systemic racism and discrimination.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_31390fe5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c49f93ad",
      "@type": "EmotionExpression",
      "instance_name": "distress",
      "label": "the distressed expression",
      "description": "The child's facial expression, including a tear on the cheek and a somber, downturned mouth, conveys emotional distress, sadness, or confusion. This expression is central to the visual narrative and is used to evoke pity or concern from the viewer.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_31390fe5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8d3f65ca",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The child is mapped as the recipient of the doctor's instruction",
      "description": "The text 'doctor: take this medicine after food' is juxtaposed with the visual of the African child, who is portrayed as the one receiving the instruction. The child's distressed expression and tear are used to imply that he is incapable or foolish for not following the instruction, creating an analogical mapping where the child is the subject of the textual command. This mapping reinforces the stereotype that Black children are cognitively deficient and require constant supervision.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_31390fe5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f77047f6",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the African child as the recipient of the instruction",
      "description": "The user is projected onto the visual material of the African child, who is portrayed as the one receiving the doctor's instruction. The meme implies that the user (or the viewer) is identifying with the child's perceived incompetence or foolishness in following the instruction, thereby internalizing the racist stereotype that Black children are cognitively deficient and incapable of understanding basic medical advice. This projection is reinforced by the child's distressed expression and tear, which are used to evoke pity or mockery, and by the textual command 'doctor: take this medicine after food', which frames the child as the subject of the instruction. The projection is not explicit with deictic pronouns like 'you' or 'me', but it is implicit through the viewer's identification with the child's role in the scene and the meme's overall intent to ridicule the child's perceived 'foolishness'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_31390fe5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_af059384",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme depicts a young African child with a somber, distressed expression, juxtaposed with the text 'doctor: take this medicine after food'. The visual and textual elements together create a harmful and demeaning stereotype, implying that the child is incapable of understanding or following basic instructions, thereby reinforcing negative racial stereotypes. This portrayal is rooted in anti-Black racism, as it infantilizes and devalues the child's cognitive abilities based on race. The meme's intent is to provoke laughter through the perceived 'foolishness' of the child, which is a form of racialized mockery and constitutes a hateful message targeting Black children and communities.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_31390fe5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_69bdc0e4",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "target audience",
      "description": "The meme is designed to target audiences who are familiar with or perpetuate anti-Black racial stereotypes, particularly those who find humor in racialized mockery of Black children's perceived cognitive deficiency. The intended audience likely includes individuals who consume internet memes that rely on dehumanizing and infantilizing imagery of Black people, often for the purpose of reinforcing systemic racism through humor. The meme’s toxicity and hateful intent suggest it is aimed at communities that either endorse or are indifferent to such racist tropes, using the visual of the African child as a symbol of racialized incompetence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_31390fe5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
