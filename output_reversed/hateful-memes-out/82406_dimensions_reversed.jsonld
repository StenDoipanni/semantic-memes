    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e776ae47",
      "@type": "AnalogicalMapping",
      "instance_name": "trans_hunting_mapping",
      "label": "The woman applying makeup is mapped as the subject of 'trans hunting'",
      "description": "The text 'i'm going trans hunting' is juxtaposed with the visual of a woman grooming herself. The meme uses this visual to imply that the woman (or someone like her) is the target or agent of 'trans hunting'. This is an analogical mapping where the visual entity (the woman) is being mapped onto the textual concept of 'trans hunting' as the subject or object of the action. The mapping is hateful and dehumanizing, as it reduces the woman's identity and actions to a stereotype about targeting transgender people.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0a6e1128"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_555a427c",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the text 'i'm going trans hunting' as the agent performing the action. The text explicitly uses first-person pronoun 'I', which directly projects the user's identity onto the speaker of the statement. The user is thus imagined as the one who is 'going trans hunting', aligning their self-perception with the hateful action described in the text. This projection is dehumanizing and hateful, as it equates the user with the perpetrator of a violent and discriminatory trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0a6e1128"
      },
