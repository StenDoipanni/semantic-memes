    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_acc1c167",
      "@type": "BackgroundKnowledge",
      "instance_name": "trans_hunting_stereotype",
      "label": "Trans Hunting Stereotype",
      "description": "The term 'trans hunting' is a derogatory and harmful stereotype that implies targeting transgender individuals with malicious intent, such as harassment, discrimination, or violence. It is often used to dehumanize and vilify transgender people, portraying them as threats or objects of fear. This concept is not visible in the image but is essential to understanding the hateful intent of the meme's text overlay.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0a6e1128"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fe7ea3a8",
      "@type": "BackgroundKnowledge",
      "instance_name": "gender_identity_mockery",
      "label": "Gender Identity Mockery",
      "description": "The meme uses the visual of a woman grooming herself to mock or contrast with the idea of 'hunting' transgender people, which is a dehumanizing trope. This juxtaposition relies on the stereotype that transgender people are somehow 'not real' or 'dangerous' and that their existence is something to be hunted or eliminated. This stereotype is not visible in the image but is required to interpret the meme's offensive message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_0a6e1128"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
