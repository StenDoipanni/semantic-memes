      "instance_name": "social_stigma",
      "label": "Social Stigma",
      "description": "A negative stereotype or label applied to individuals or groups, often leading to discrimination or exclusion. The meme implies that calling someone 'ugly' in high school creates a form of social stigma that may persist.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e8027ef5"
