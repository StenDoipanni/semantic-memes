    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_00d504ca",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The warning 'be careful' is mapped onto the young girl's worried expression.",
      "description": "The top text 'be careful' is visually mapped onto the young girl (top_person) who is depicted with a concerned and fearful expression. Her posture and facial expression (hand on cheek, worried look) serve as the visual embodiment of the warning message, creating an analogical mapping where the girl represents the cautionary subject of the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e8027ef5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_777d9e71",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the warning scene",
      "description": "The user is projected onto the top scene (warning_scene) which visually and textually conveys a cautionary message. The user is implicitly addressed as the one who should heed the warning 'be careful' about making appearance-based judgments in high school. The projection is onto the visual material of the worried girl (top_person) and the textual material 'be careful', which together form the warning scene. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the imperative nature of the text and the visual of the girl looking concerned create an implicit address to the viewer as the one who should be careful.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e8027ef5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
