      "@type": "BackgroundKnowledge",
      "instance_name": "appearance_based_judgment",
      "label": "Appearance-Based Judgment",
      "description": "The concept that people's physical appearance is used to form judgments about their character, intelligence, or worth, which is a common social phenomenon and often leads to bullying or stigma, especially in high school settings. This is the core concept the meme warns against.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e8027ef5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dee34596",
      "@type": "BackgroundKnowledge",
      "instance_name": "high_school_bullying",
      "label": "High School Bullying",
      "description": "A widespread social issue in which adolescents are subjected to harassment, often based on appearance, social status, or perceived differences. The meme references this as the context where harmful judgments occur.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e8027ef5"
