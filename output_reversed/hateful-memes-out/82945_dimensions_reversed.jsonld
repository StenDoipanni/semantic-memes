    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d4f8c3b1",
      "@type": "BackgroundKnowledge",
      "instance_name": "adolescent_identity",
      "label": "Adolescent Identity Formation",
      "description": "The psychological and social process during adolescence where individuals develop their self-concept and identity, often influenced by peer opinions and social feedback. The meme references this as the vulnerable stage where appearance-based judgments can have significant impact.",
