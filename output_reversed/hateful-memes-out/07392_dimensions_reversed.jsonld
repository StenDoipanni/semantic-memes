    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f552641f",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "Black identity is mapped onto the child",
      "description": "The text 'once you go black' is juxtaposed with the visual of a Black child being held by a white woman. The meme implies that the child's Blackness is the defining characteristic that triggers the stereotype of being raised by a single mother, mapping the child's racial identity onto the textual claim about Blackness and single motherhood. This is a harmful analogical mapping that equates Blackness with single motherhood.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_69990505"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ce58a6a4",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual claim and the visual of the Black child",
      "description": "The user is projected onto the textual material 'once you go black ur a single mom!' and the visual material of the Black child being held, as the meme implies that the user (or anyone who becomes Black) is automatically associated with being a single mother. This projection is implicit, using the text to create a direct link between Black identity and single motherhood, which the user is expected to internalize as a universal truth. The child's visual presence reinforces this projection by making the stereotype feel immediate and personal.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_69990505"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
