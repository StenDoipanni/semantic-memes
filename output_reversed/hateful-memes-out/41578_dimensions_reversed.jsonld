    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fe741639",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Sheriff questioning driver is mapped to the authority figure in the scene",
      "description": "The text 'do you know why i pulled you over?' is spoken by the sheriff, who is visually depicted as the authoritative figure questioning the driver. The mapping is direct: the sheriff (visual entity) is the one performing the action described in the text (pulling over the driver). The text explicitly refers to the sheriff's action, establishing an analogical mapping between the textual statement and the visual representation of the sheriff.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ee572fce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bff061bc",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the driver in the scene",
      "description": "The user is projected onto the driver (the person being questioned by the sheriff) through the use of the second-line text 'because you scored low on the asvab?'. The word 'you' directly addresses the driver, creating a deictic reference that positions the viewer as the person being questioned, thereby projecting the user's identity onto the driver's role in the scene. This projection is reinforced by the driver's gesture of defense, which invites the user to imagine themselves in that position.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ee572fce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9a9f772a",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_2",
      "label": "User projected onto the textual punchline",
      "description": "The user is also projected onto the textual material 'because you scored low on the asvab?' through the deictic pronoun 'you'. This text directly addresses the viewer, implying that the viewer is the one who scored low on the ASVAB, thereby projecting the user's potential identity onto the punchline. The humor and the implied judgment are directed at the user, making them the target of the stereotype being mocked.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ee572fce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_28c435a4",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme perpetuates harmful stereotypes by implying that scoring low on the ASVAB test makes someone unworthy or incompetent, which can stigmatize individuals and reinforce negative societal perceptions about intelligence and capability based on standardized test performance. This is harmful because it can contribute to demeaning attitudes and potentially harm self-esteem of those who struggle with such tests.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ee572fce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_83b1b2cb",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who are familiar with the ASVAB test and its role in military recruitment, particularly those who may have taken the test or know someone who did. The meme relies on a cultural reference to standardized testing as a measure of intelligence and suitability for military service, which is most likely to resonate with people who have encountered or studied the ASVAB. The humor is derived from the absurdity of linking a low ASVAB score to a traffic stop, which may appeal to those who understand the test's context and the stereotype it perpetuates. The meme also targets individuals who may have scored poorly on the ASVAB or know someone who did, as it implicitly mocks those who are perceived as unqualified or unintelligent based on their test performance. The target audience is likely to include young adults, especially those in their late teens or early twenties, who are either considering or have considered military service, or who are aware of the ASVAB as a gateway to certain career paths. The meme may also appeal to those who appreciate dark humor or satire that critiques societal norms around standardized testing and intelligence. The target community is not explicitly defined by race, gender, or other protected characteristics, but rather by their familiarity with the ASVAB and the cultural context of military recruitment. The meme's harmful intent is directed at individuals who score poorly on standardized tests, reinforcing ableist stereotypes that deny competence based on test performance, which may be particularly offensive to those who have struggled with such tests and feel stigmatized by them.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ee572fce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
