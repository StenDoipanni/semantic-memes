    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d97789a9",
      "@type": "BackgroundKnowledge",
      "instance_name": "asvab_test",
      "label": "ASVAB Test",
      "description": "The ASVAB (Armed Services Vocational Aptitude Battery) is a standardized test used by the United States military to assess a person's aptitude for various military occupations. Scoring low on the ASVAB is often interpreted as indicating limited suitability for military service, which is the core of the meme's punchline. This knowledge is required to understand the absurdity and potential harm of implying a traffic stop is justified by a low ASVAB score.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ee572fce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e30619e4",
      "@type": "BackgroundKnowledge",
      "instance_name": "military_recruitment_stereotype",
      "label": "Military Recruitment Stereotype",
      "description": "The meme relies on the stereotype that low scores on standardized tests like the ASVAB equate to incompetence or lack of intelligence, which in turn implies a person is unfit for military service. This stereotype is used to frame the joke and is a key element of the meme's underlying message, even though it is socially insensitive and potentially offensive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ee572fce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_77bcfcd4",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism",
      "label": "Ableism",
      "description": "The meme implicitly reinforces ableist stereotypes by mocking individuals who score poorly on standardized tests, suggesting they are unintelligent or unqualified. This is a form of ableism that denies competence to people based on their test performance, which is a harmful social construct.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ee572fce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ba513992",
      "@type": "BackgroundKnowledge",
      "instance_name": "stigmatization_of_low_test_scores",
      "label": "Stigmatization of Low Test Scores",
      "description": "The meme perpetuates the stigmatization of individuals who score poorly on standardized tests, implying they are inferior or unworthy. This is a real-world social phenomenon where low test scores are often used to judge a person's intelligence or capability, which can be demeaning and contribute to negative self-perception.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_ee572fce"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
