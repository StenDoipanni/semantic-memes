    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_38df0dc8",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Morgan Freeman is mapped as condemning slavery",
      "description": "The text 'morgan freeman condemning slavery' is overlaid on the image of Morgan Freeman holding an award. This creates an analogical mapping where the text explicitly projects the emotion and action of 'condemning slavery' onto Morgan Freeman, who is visually depicted in a neutral, award-receiving context. The mapping is false, as the visual material does not show him condemning slavery, but rather presenting an award. This is a harmful misrepresentation that falsely equates his modern persona with historical responsibility.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4e17fe55"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_65c844b8",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material implying false equivalence",
      "description": "The user is projected onto the text 'morgan freeman condemning slavery', which falsely attributes the act of condemning slavery to Morgan Freeman based on his visual presence in the image. This projection creates a misleading narrative that the user is expected to accept or interpret as true, reinforcing the harmful stereotype that contemporary Black figures are somehow responsible for historical slavery. The projection is implicit, relying on the viewer's acceptance of the text's claim without visual evidence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4e17fe55"
      },
      "extractionMethod": "llm_extraction_huggingface"
