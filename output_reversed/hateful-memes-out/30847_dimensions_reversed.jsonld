    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_02a124cb",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The text 'that wasn't me that was patricia' maps to the unfiltered image of Jesse Eisenberg",
      "description": "The bottom text explicitly denies the identity of the person in the unfiltered image, claiming it is not 'me' (the person using the filter) but 'Patricia'. This creates an analogical mapping where the textual entity 'Patricia' is projected onto the visual entity 'Jesse_Eisenberg' in the unfiltered image, implying a humorous identity swap.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8d90e6e5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0c3657c8",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual entity 'that wasn't me that was patricia'",
      "description": "The user is projected onto the textual material 'that wasn't me that was patricia' because this text explicitly denies the identity of the person in the unfiltered image, implying that the user (the person who took the photo or is the subject of the meme) is not the person shown, but rather someone else named Patricia. This creates a direct projection of the user's identity onto the textual claim, making the user the subject of the denial.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_8d90e6e5"
      },
