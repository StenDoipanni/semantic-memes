    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_52b63cf4",
      "@type": "BackgroundKnowledge",
      "instance_name": "racial_slur_nagger",
      "label": "racial slur 'nagger'",
      "description": "The term 'nagger' is a derogatory racial slur historically used against Black people, particularly in the United States. It is not a neutral or descriptive term but a hateful epithet rooted in anti-Black racism. Its use in the meme directly targets the subject, Nelly, based on his race, and is intended to demean and insult him. This slur is part of a broader history of racial epithets used to dehumanize Black individuals.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cfd9ca5c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0ad5ef7e",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype",
      "label": "anti-Black stereotype",
      "description": "The meme leverages the racial slur 'nagger' to perpetuate a harmful anti-Black stereotype. This stereotype reduces Black individuals to a demeaning caricature, implying inferiority or undesirability. The use of such a slur in a meme context is not merely offensive; it is a form of racial hate speech that reinforces systemic racism and prejudice against Black people.",
