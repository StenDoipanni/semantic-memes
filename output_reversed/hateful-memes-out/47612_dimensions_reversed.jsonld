    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c344a97e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_i_see_you_nelly",
      "label": "The text 'i see you' is mapped onto Nelly as the person being observed.",
      "description": "The top text 'i see you' is spatially positioned above Nelly's head, creating an analogical mapping where the text implies direct observation or awareness of Nelly. This mapping projects the textual concept of 'seeing' onto Nelly as the visual entity being observed, establishing a direct link between the text and the person in the image. The mapping is reinforced by the confrontational context of the meme, where the text serves to assert dominance or awareness over Nelly.",
      "belongsToAnalysis": {
