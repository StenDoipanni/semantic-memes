    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_16907339",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who are familiar with or recognize Nelly as a public figure, particularly those who may be engaged in or supportive of racially charged online discourse. The meme leverages Nelly’s public identity as a Black rapper and actor to deliver a racially hateful message, suggesting the audience is likely to understand the reference and the intent to insult him based on his race. The use of the slur 'nagger' indicates the meme is designed for an audience that either uses or understands such racial epithets, or is willing to engage with content that promotes anti-Black racism. The confrontational tone and visual framing imply the audience is expected to interpret the meme as a direct, hostile statement, possibly within online communities that normalize or enjoy hate speech targeting Black individuals.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_cfd9ca5c"
