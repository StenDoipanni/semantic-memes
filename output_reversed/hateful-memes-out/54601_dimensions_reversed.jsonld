    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_85f825ac",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Father Jeffrey is mapped onto the group of people struggling with the hose",
      "description": "The text 'i hope father jeffrey doesnt go in dry today' implies that the group of people (likely Black, based on historical context of the meme) are 'trying to drown' Father Jeffrey (a white person). The visual of the group struggling with the hose while being sprayed with water is mapped onto the textual entity 'father jeffrey', creating an analogical mapping where the group's actions are projected as an attempt to submerge or 'drown' the priest. This is a racist meme template where the visual material (the group) is mapped onto the textual entity (Father Jeffrey) as the target of their 'aggressive' or 'dangerous' behavior.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4f6a0486"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2768a221",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material expressing hope for Father Jeffrey's safety",
      "description": "The user is projecting themselves onto the textual material 'i hope father jeffrey doesnt go in dry today', imagining themselves as the one expressing concern or hope for Father Jeffrey's safety. This projection is implicit, as the meme does not contain explicit deictic pronouns like 'me' or 'you', but the user is engaging with the meme by adopting the perspective of the speaker of the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4f6a0486"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
