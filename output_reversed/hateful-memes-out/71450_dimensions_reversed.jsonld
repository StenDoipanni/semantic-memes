    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ae03d9a3",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material describing a degrading act",
      "description": "The user is projected onto the textual material 'i bit a muslim' and 'i had to lick my ass for an hour to get rid of the taste', which implies the user is the one who performed the act. This is a projection of the user as the perpetrator of the hateful stereotype, using the text to identify themselves as the agent of the offensive action. The text does not contain explicit deictic pronouns like 'me' or 'you', but the first-person narrative ('i bit') creates an implicit projection of the user as the actor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_380ae013"
      },
