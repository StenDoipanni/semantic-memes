    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_10e2ab1e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "Cops are mapped as responding to an armed robber",
      "description": "The text 'when cops see an armed robber' is juxtaposed with the visual of police officers in tactical gear firing weapons. This creates an analogical mapping where the visual material (police officers in action) is understood as representing the scenario described in the text (cops responding to an armed robber). The meme implies that the visual scene is the typical or expected response to the textual scenario, establishing a direct mapping between the text and the visual depiction of police force.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5d1d7e88"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_44d3b629",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of armed police response",
      "description": "The user is projected onto the visual scene of police officers in tactical gear firing weapons, as implied by the text 'when cops see an armed robber'. The user is not explicitly addressed with deictic pronouns like 'you' or 'me', but the meme's framing invites the viewer to imagine themselves as the observer of this scenario — the 'cops' responding to the 'armed robber'. This creates an implicit projection where the user is positioned as the one witnessing or experiencing the depicted police response, thereby internalizing the meme's portrayal of militarized law enforcement action.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5d1d7e88"
      },
      "extractionMethod": "llm_extraction_huggingface"
