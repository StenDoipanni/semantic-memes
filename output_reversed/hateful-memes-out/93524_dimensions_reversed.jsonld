    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9257ec31",
      "@type": "BackgroundKnowledge",
      "instance_name": "use_of_force_spectrum",
      "label": "Concept of the use-of-force spectrum in law enforcement",
      "description": "The meme relies on the implicit understanding of the use-of-force spectrum — the range of force options available to police, from verbal commands to lethal force — and the idea that armed suspects are often perceived as requiring the highest level of force. This concept is not visible in the image but is necessary to interpret the meme’s portrayal of police response as extreme or disproportionate.",
      "belongsToAnalysis": {
