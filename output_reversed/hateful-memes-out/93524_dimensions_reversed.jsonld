    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d7aadf44",
      "@type": "EmotionExpression",
      "instance_name": "aggression",
      "label": "aggressive emotion",
      "description": "The image conveys a strong sense of aggression through the depiction of police officers in tactical gear firing rifles in a coordinated, forceful manner. The muzzle flashes and the officers' focused, intense postures suggest an aggressive, high-stakes response to a perceived threat. This is reinforced by the text overlay 'when cops see an armed robber,' which frames the scene as a justified but extreme escalation of force.",
      "belongsToAnalysis": {
