    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c5bf4fb1",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The text 'muslim strip club' maps onto the woman in ornate attire",
      "description": "The text 'muslim strip club' is overlaid on the image of a woman dressed in belly-dancer-style attire. This creates an analogical mapping where the woman is being labeled or identified as part of a 'muslim strip club'. The mapping is reductive and hateful, projecting a false and offensive stereotype onto the visual subject. The woman's appearance (ornate, performance-style clothing) is used to visually support the text's implication, even though her attire is culturally associated with dance, not necessarily stripping or sexualized commodification. The mapping is spatially direct, with the text positioned above her, framing her identity through the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_48021e9a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6ea5f46b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual label as the source of the stereotype",
      "description": "The user is not explicitly projected onto a specific visual or textual element via deictic pronouns like 'me' or 'you'. However, the meme's structure inherently projects the user's perspective onto the text 'muslim strip club' as the primary interpretive lens. The user is expected to read the text and then project its hateful, reductive meaning onto the visual of the woman, thereby internalizing the stereotype. The text acts as the dominant semiotic anchor that frames the entire scene, making the user's interpretation contingent on accepting the text's premise. The user is thus projected onto the text_chunk as the origin point of the hateful projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_48021e9a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
