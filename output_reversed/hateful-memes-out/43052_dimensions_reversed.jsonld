    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ae1276ed",
      "@type": "BackgroundKnowledge",
      "instance_name": "cat_hygiene_stereotype",
      "label": "Cat hygiene stereotype",
      "description": "The meme relies on the stereotype that cats are inherently unhygienic or 'dirty' creatures, especially in relation to their litterbox habits. The humor comes from the cat's smug expression juxtaposed with the absurd claim that it washed its paws in the toilet after using the litterbox, which is a common trope in pet owner humor and internet memes. This stereotype is not visible in the image but is required to understand the joke.",
      "belongsToAnalysis": {
