    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c54b311f",
      "@type": "Scene",
      "instance_name": "condemnation_scene",
      "label": "condemnation_of_historical_atrocities",
      "description": "A scene depicting the historical figure Adolf_Hitler, visually presented in a Nazi uniform with a swastika armband, as the central subject of a condemnation. The scene is framed by overlaid text that explicitly states 'this man took millions of lives,' creating a direct visual and textual relationship that serves to condemn his actions and legacy. The spatial arrangement places the figure centrally, with the text positioned above and below his image to emphasize the message. The scene's structure is designed to evoke a strong emotional and moral response by juxtaposing the image of the historical figure with the stark, accusatory text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_37a6d23c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_869dad5b",
      "@type": "BackgroundKnowledge",
      "instance_name": "Holocaust",
      "label": "Holocaust",
      "description": "The systematic, state-sponsored persecution and murder of six million Jews by Nazi Germany and its collaborators during World War II. This event is the central historical atrocity referenced in the meme's text 'this man took millions of lives' when applied to Adolf Hitler. The meme relies on the global historical knowledge of the Holocaust to convey the scale and moral weight of Hitler's crimes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_37a6d23c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_297ff777",
      "@type": "BackgroundKnowledge",
      "instance_name": "World_War_II",
      "label": "World War II",
      "description": "A global conflict that lasted from 1939 to 1945, in which Nazi Germany and its allies fought against the Allied Powers. Hitler's leadership of Nazi Germany during this war resulted in the deaths of tens of millions of people, including civilians and soldiers. The meme's condemnation of Hitler implicitly references his role in initiating and directing this global conflict, which led to the Holocaust and other mass atrocities.",
      "belongsToAnalysis": {
