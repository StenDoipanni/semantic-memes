    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7d50ed51",
      "@type": "EmotionExpression",
      "instance_name": "condemnation",
      "label": "moral condemnation emotion",
      "description": "The emotion expressed is one of profound moral condemnation, conveyed through the stark, accusatory text 'this man took millions of lives' overlaid on the image of Adolf Hitler. The emotion is not an expression on Hitler's face, but rather an emotion evoked in the viewer by the image and text combination, which serves to condemn his historical atrocities. The emotion is heavy, somber, and morally charged, intended to shock and warn viewers about the consequences of extreme ideologies and totalitarianism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_37a6d23c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3413bfa2",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Adolf Hitler is mapped as 'this man'",
      "description": "The text 'this man took millions of lives' explicitly identifies the visual entity Adolf_Hitler as 'this man'. The spatial positioning of the text directly above and below the image reinforces this direct analogical mapping, where the textual referent 'this man' is projected onto the visual entity Adolf_Hitler. This mapping is central to the meme's intent, as it directly links the historical figure to the accusation of mass murder.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_37a6d23c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d3b790c1",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the condemnation scene",
      "description": "The user is projected onto the overall condemnation scene, which includes the visual material of Adolf_Hitler and the textual material 'this man took millions of lives'. The scene functions as a direct moral condemnation, and the user is implicitly positioned as the recipient of this condemnation, witnessing the historical atrocity and its attribution to the figure. The projection is not deictic (e.g., 'you' or 'me'), but rather existential and moral — the user is placed in the role of a witness to historical trauma and moral judgment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_37a6d23c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3ad066c3",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme depicts Adolf Hitler, a historical figure responsible for the Holocaust and the deaths of millions, with the text 'this man took millions of lives.' While the message is factually accurate and serves an educational or moral purpose, it is inherently harmful because it reifies the historical trauma associated with Hitler and the Nazi regime. The meme's intent is to shock and warn viewers about the consequences of extreme ideologies and totalitarianism, functioning as a form of historical propaganda aimed at preventing the recurrence of such atrocities. The content is deeply tied to the historical trauma of genocide and war, making it potentially triggering and emotionally charged for survivors and descendants of victims.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_37a6d23c"
      },
