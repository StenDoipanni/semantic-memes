    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9127be6d",
      "@type": "Scene",
      "instance_name": "niqab_inspection_scene",
      "label": "Legal confrontation regarding niqab inspection",
      "description": "A scene depicting a person wearing a niqab, with overlaid text stating a legal scenario where police ask to inspect the niqab but are legally prohibited from doing so. The visual composition focuses on the person's eyes, conveying intensity or defiance, while the text provides context about legal boundaries. The scene is framed to emphasize the tension between personal religious expression and state authority.",
      "belongsToAnalysis": {
