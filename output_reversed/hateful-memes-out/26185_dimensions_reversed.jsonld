    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fab16ad7",
      "@type": "BackgroundKnowledge",
      "instance_name": "niqab",
      "label": "Niqab",
      "description": "A type of Islamic headscarf that covers the entire face except for the eyes. It is worn by some Muslim women as a form of modesty and religious expression. The legal status of niqab inspections by authorities varies by country and jurisdiction, often sparking debates about religious freedom, national security, and gender equality.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b82353f1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_db3c4329",
      "@type": "BackgroundKnowledge",
      "instance_name": "legal_inspection",
      "label": "Legal Inspection of Religious Attire",
      "description": "The concept that law enforcement may or may not be permitted to inspect religious attire, such as the niqab, under specific legal frameworks. This involves constitutional rights, privacy laws, and religious freedom statutes. In some jurisdictions, such inspections may be deemed unconstitutional or illegal if they infringe on personal liberties or religious expression.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b82353f1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d813f3d9",
      "@type": "BackgroundKnowledge",
      "instance_name": "islamophobia",
      "label": "Islamophobia",
      "description": "Prejudice, fear, or discrimination against Muslims. This stereotype often associates Muslims with terrorism, oppression of women, or incompatibility with Western values. The meme's visual framing of a veiled woman can inadvertently reinforce such stereotypes, even if the intent is to highlight a legal point.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_b82353f1"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2beec25f",
      "@type": "BackgroundKnowledge",
      "instance_name": "religious_freedom",
      "label": "Religious Freedom",
      "description": "A fundamental human right that protects individuals' ability to practice their religion without government interference. This concept is central to the legal debate surrounding niqab inspections and is often invoked in legal and political discourse.",
      "belongsToAnalysis": {
