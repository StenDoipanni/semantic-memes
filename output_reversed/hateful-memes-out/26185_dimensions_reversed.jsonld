    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_aec0afa7",
      "@type": "VisualMaterial",
      "instance_name": "person",
      "label": "individual wearing niqab",
      "description": "A person with brown eyes, partially obscured by a black niqab that covers the lower half of the face, leaving only the eyes visible. The individual appears to be looking directly at the viewer with a neutral or slightly intense expression. The niqab is made of a textured fabric, and the lighting highlights the eyes and the fabric's weave. The background is a plain, dark gray gradient, focusing attention on the person's face.",
      "belongsToAnalysis": {
