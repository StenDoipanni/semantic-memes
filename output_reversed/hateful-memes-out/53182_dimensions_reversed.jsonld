    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8c0b007d",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "Fallen officers are remembered forever",
      "description": "The text 'those who die in blue, are remembered forever' is mapped onto the visual of uniformed officers carrying a casket draped in the Nigerian flag. The phrase 'die in blue' refers to law enforcement officers who sacrifice their lives in the line of duty, and the visual of the officers in uniform, solemnly carrying the casket, represents those fallen officers. The text explicitly identifies the officers in the image as the subjects of the phrase 'those who die in blue', creating an analogical mapping between the textual concept and the visual representation of law enforcement officers in a funeral context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5e279222"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2392a088",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User is projected onto the textual message as a collective observer of remembrance",
      "description": "The user is not explicitly projected onto any specific visual material or scene via deictic pronouns like 'me', 'you', or 'your'. However, the textual material 'those who die in blue, are remembered forever' functions as a direct address to the viewer, inviting them to identify with the sentiment of remembrance and honor. The user is projected onto the text_chunk as the implied recipient of the commemorative message, making the text the focal point of the semiotic projection. The solemn visual scene reinforces this projection by grounding the abstract text in a tangible, emotionally resonant context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_5e279222"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fed3a8af",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community is law enforcement officers and their families, as well as the general public in Nigeria who recognize and honor fallen officers. The phrase 'die in blue' is a widely understood tribute to police officers who sacrifice their lives in the line of duty, and the Nigerian flag indicates national mourning, making the message relevant to both the policing community and the broader Nigerian populace. The solemn funeral scene with uniformed officers carrying a casket reinforces the commemorative intent for those who serve and protect.",
      "belongsToAnalysis": {
