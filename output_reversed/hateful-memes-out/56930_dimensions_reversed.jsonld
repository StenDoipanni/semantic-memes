    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ab7ee834",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The person is mapped as the subject of the vulgar joke about bad gas.",
      "description": "The text 'i got such bad gas' is mapped onto the visual entity 'person'. The person's somber expression is juxtaposed with the crude joke, creating an analogical mapping where the person is implicitly the 'one' who experienced the bad gas, even though the context is horrifically inappropriate. This mapping is part of the meme's harmful intent to trivialize trauma.",
      "belongsToAnalysis": {
