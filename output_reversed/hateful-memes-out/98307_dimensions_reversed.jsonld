    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f970c96a",
      "@type": "BackgroundKnowledge",
      "instance_name": "auschwitz_concentration_camp",
      "label": "Auschwitz Concentration Camp",
      "description": "Auschwitz was a network of Nazi concentration and extermination camps in occupied Poland during World War II. It was the largest and most infamous of the camps, where millions of Jews, Poles, Roma, Soviet prisoners of war, and others were systematically murdered. The reference to Auschwitz in the meme is a direct allusion to this genocide.",
