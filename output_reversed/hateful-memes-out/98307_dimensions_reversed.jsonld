    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3335038b",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The act of selecting victims in Auschwitz is mapped onto manual labor using tools",
      "description": "The text 'how to pick chicks in auschwitz' is juxtaposed with the visual of hands using a shovel and broom in an industrial setting. This creates an analogical mapping where the visual material (manual labor scene) is mapped onto the textual concept of 'picking chicks' in Auschwitz, implying that the selection process in the concentration camp is being trivialized as a mundane or sexualized manual task. The mapping is explicit through the text's reference to 'pick chicks' and the visual's depiction of labor tools, which are associated with the selection process in concentration camps.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e86cfb96"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2d60cda9",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the textual material 'how to pick chicks' because the meme uses this phrase to create a dehumanizing and offensive analogy. The user is implicitly invited to imagine themselves as the one 'picking chicks' in Auschwitz, thereby internalizing the hateful metaphor and projecting their own identity onto the act of trivializing genocide. This projection is not explicit with deictic pronouns like 'you' or 'me', but the meme's structure and intent force the viewer to identify with the act described in the text, making the user a participant in the hateful framing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e86cfb96"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
