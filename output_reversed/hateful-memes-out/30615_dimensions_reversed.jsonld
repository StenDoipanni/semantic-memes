    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2ce421a6",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "The future is represented by the joyful drag performer at the Pride parade",
      "description": "The text 'welcome to the future' is overlaid on the image of a vibrant drag performer at a Pride parade. The performer, with their exaggerated joy, colorful costume, and the festive, inclusive atmosphere, is being mapped as the embodiment of the 'future' — a future of celebration, diversity, and social progress. The mapping is established through the juxtaposition of the optimistic text with the visual representation of LGBTQ+ joy and visibility, which is culturally understood as a marker of societal advancement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_01459e24"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_86173582",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the celebratory scene as an observer of social progress",
      "description": "The user is not explicitly projected onto a specific visual, textual, or scene element through deictic pronouns like 'me' or 'you'. However, the meme invites the user to identify with the celebratory scene as a whole — the 'future' being depicted — by framing the joyful drag performer and the Pride parade as a collective vision of hope and inclusion. The user is implicitly invited to see themselves as part of or aligned with this optimistic social narrative. The projection is onto the 'scene_1' (celebratory_parade) as a whole, which represents the 'future' and the user's potential place within it.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_01459e24"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
