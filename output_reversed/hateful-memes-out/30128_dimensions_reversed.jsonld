      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f8094dac",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The 'girl' is mapped onto the woman with dark hair exerting control",
      "description": "The top text 'when your girl is crazy' maps the concept of 'your girl' (the partner) onto the woman with dark hair and leather jacket who is physically dominating the other woman. This mapping is established by the textual reference to 'your girl' and the visual depiction of her as the dominant, controlling figure in the scene. The visual entity represents the 'girl' as described in the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1e4758e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_82b30473",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the 'girl' in the meme",
      "description": "The user is projected onto the 'girl' (the partner) as described in the text 'when your girl is crazy'. The user identifies with the perspective of the person whose partner is reacting violently or possessively to discovering a 'side chick'. The visual entity 'woman_with_red_hair' is the object of the girl's aggression, and the user is positioned as the 'you' in 'your girl'. The projection is onto the dominant figure (the woman with dark hair and leather jacket) who embodies the 'girl' in the scenario, as mapped by the text. The user sees themselves as the person whose partner is 'crazy' and is reacting to the 'side chick'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1e4758e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
