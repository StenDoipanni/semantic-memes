    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_916b8e72",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who engage with or consume internet humor that relies on misogynistic stereotypes, particularly those who find amusement in portraying women as emotionally unstable, irrational, or violent in response to relationship betrayals. The meme appeals to an audience familiar with and possibly desensitized to harmful gender norms, using the trope of the 'crazy girl' to frame a scenario involving a 'side chick' in a way that reinforces toxic masculinity and devalues women's emotional intelligence and agency. The visual and textual elements are designed to resonate with users who enjoy or identify with the exaggerated, negative stereotypes about women's behavior in romantic contexts, often found in online communities that normalize or celebrate such tropes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1e4758e"
      },
      "extractionMethod": "llm_extraction_huggingface"
