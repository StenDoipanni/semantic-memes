    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_df09fc96",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_stereotype_crazy_woman",
      "label": "Misogynous Stereotype: 'Crazy' or 'Hysterical' Woman",
      "description": "This stereotype portrays women as emotionally unstable, irrational, and prone to violent or possessive behavior when confronted with infidelity or perceived betrayal. It is a harmful trope used to devalue women's emotional intelligence and agency, often justifying or dramatizing their behavior in a negative light. The meme relies on this stereotype to frame the 'girl' as dangerous and irrational when she discovers her partner's 'side chick'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1e4758e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_55229e8f",
      "@type": "BackgroundKnowledge",
      "instance_name": "side_chick_concept",
      "label": "Concept of 'Side Chick'",
      "description": "A term used in popular culture and dating discourse to describe a woman who is romantically or sexually involved with a man who is already in a committed relationship with another woman. The term often carries negative connotations, implying that the 'side chick' is less valued or less legitimate than the primary partner. The meme uses this concept to set up the scenario where the 'girl' reacts to the discovery of such an arrangement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1e4758e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c8901089",
      "@type": "BackgroundKnowledge",
      "instance_name": "dominant_control_scene",
      "label": "Dominant Control Scene",
      "description": "The visual depiction of one woman physically controlling another, often used metaphorically or literally to represent power dynamics, jealousy, or possessiveness. In this meme, the scene is used to visually reinforce the textual claim that the 'girl' is 'crazy' and violent in her reaction to discovering the 'side chick'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e1e4758e"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b48e642a",
      "@type": "EmotionExpression",
      "instance_name": "possessive_anger",
      "label": "possessive and angry emotion",
      "description": "The woman with dark hair and leather jacket is depicted exerting physical control over the other woman, gripping her neck and wrist, conveying a sense of possessiveness, aggression, and anger. Her facial expression, though partially obscured, suggests intensity and dominance. This emotion is visually expressed through her physical actions and posture, which dominate the scene.",
      "belongsToAnalysis": {
