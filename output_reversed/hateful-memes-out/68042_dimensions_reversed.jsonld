    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f4b783a8",
      "@type": "BackgroundKnowledge",
      "instance_name": "dishwasher_malfunction_stereotype",
      "label": "Dishwasher malfunction stereotype",
      "description": "The meme relies on the common household experience of a malfunctioning dishwasher, which is often a source of frustration and humor. The exaggerated effort of the man, combined with the steam, implies a comedic take on the difficulty of fixing such appliances, a trope often found in domestic humor and relatable memes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_22b8295a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_017ed56d",
      "@type": "BackgroundKnowledge",
      "instance_name": "domestic_frustration_stereotype",
      "label": "Domestic frustration stereotype",
      "description": "The meme taps into the widespread stereotype of domestic chores being tedious and frustrating, especially when appliances fail. The man’s intense focus and the steam rising from the dishwasher are visual cues that amplify the comedic portrayal of this common household struggle.",
      "belongsToAnalysis": {
