    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_489b4796",
      "@type": "Scene",
      "instance_name": "man_inspecting_dishwasher",
      "label": "man inspecting dishwasher",
      "description": "A man is leaning over an open dishwasher in a kitchen, reaching inside with his right hand while looking intently at the dishes. Steam is rising from the dishwasher, suggesting it may be malfunctioning or recently used. The man's focused expression and posture indicate he is trying to diagnose or fix the appliance. The scene is framed to emphasize his interaction with the dishwasher and the humorous implication that he might have 'almost got it working.'",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_22b8295a"
      },
      "extractionMethod": "llm_extraction_huggingface"
