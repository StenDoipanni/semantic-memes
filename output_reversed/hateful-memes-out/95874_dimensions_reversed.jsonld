    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_90a1f8cc",
      "@type": "BackgroundKnowledge",
      "instance_name": "misogynous_stereotype",
      "label": "Misogynous Stereotype",
      "description": "The meme relies on the stereotype that women, particularly in service roles, are expected to be perpetually cheerful and that their emotional expression is somehow inappropriate or excessive. The phrase 'I thought you left your smile back there' implies that her smile is not genuine or is something she should have left behind, reducing her emotional labor to a performative, superficial trait. This stereotype is rooted in broader misogynous cultural assumptions about women's behavior and emotional expression.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6db14f4b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_21d77db1",
      "@type": "BackgroundKnowledge",
      "instance_name": "emotional_labor_stereotype",
      "label": "Emotional Labor Stereotype",
      "description": "The meme references the concept of emotional labor — the work of managing one's emotions to meet social expectations — and implies that women are expected to perform this labor in service roles. The sarcastic comment about her smile suggests that her emotional expression is not 'natural' or 'authentic,' which is a common misogynous trope that reduces women's emotional labor to a superficial trait.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6db14f4b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_91a1d476",
      "@type": "BackgroundKnowledge",
      "instance_name": "service_industry_gender_stereotype",
      "label": "Service Industry Gender Stereotype",
      "description": "The meme implicitly references the stereotype that women are disproportionately represented in service industries (like coffee shops) and are expected to embody specific traits — such as cheerfulness, friendliness, and emotional availability — that are not expected of men in the same roles. This stereotype is part of broader gendered assumptions about labor and emotional expression.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6db14f4b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0a31bdb5",
      "@type": "BackgroundKnowledge",
      "instance_name": "performative_smile_stereotype",
      "label": "Performative Smile Stereotype",
      "description": "The meme uses the concept of a 'performative smile' — a smile that is not genuine but is instead a social performance — to critique the expectation that women in service roles must always appear happy. The phrase 'I thought you left your smile back there' suggests that her smile is not authentic, which is a common misogynous trope that implies women's emotional expression is inauthentic or excessive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6db14f4b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_afbe4bfe",
      "@type": "EmotionExpression",
      "instance_name": "forced_happiness",
      "label": "the performative smile",
      "description": "The woman's wide, bright smile appears cheerful and professional, but in the context of the meme's text — 'i thought you left your smile back there' — it is interpreted as a forced or performative expression, not a genuine emotion. This suggests the smile is a social performance expected of her in her service role, rather than an authentic emotional state.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6db14f4b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f437388f",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The woman's smile is mapped as a performative smile",
      "description": "The top text 'hello is that everything you need?' initiates a service interaction, while the bottom text 'i thought you left your smile back there' sarcastically implies that the woman's smile is not genuine. This creates an analogical mapping where the visual entity 'woman' (specifically her smile) is mapped onto the textual concept of a 'performative smile' — a smile that is expected but not authentic. The text overlays project the interpretation of her smile as a social performance onto the visual material, aligning with the misogynous stereotype that women in service roles must perform cheerfulness.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6db14f4b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ef442800",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman's smile as a performative entity",
      "description": "The user is projected onto the visual material of the woman's smile, which is interpreted through the textual overlay as a 'performative smile' that should have been 'left back there'. The text 'i thought you left your smile back there' directly addresses the woman's smile as if it were an object she owns or should have left behind, creating a projection where the user sees themselves as the one who might have left their smile behind, or as the one who is judging the woman's smile as inauthentic. This projection is onto the VisualMaterial entity 'woman' specifically through her smile, which is mapped onto the textual concept of a 'performative smile'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6db14f4b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_868f41e6",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Mysogynous",
      "description": "The meme implies that the woman's smile is performative and inauthentic, reducing her emotional labor to a superficial trait expected of women in service roles. This reflects a misogynous stereotype that women must perpetually be cheerful and that their emotional expression is inappropriate or excessive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6db14f4b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4665a1af",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target community for this meme is individuals who are familiar with or sensitive to gendered stereotypes in service industries, particularly those who recognize or have experienced the expectation for women to perform cheerfulness as emotional labor. The meme is designed to resonate with people who understand the performative nature of smiles in customer service roles and who may find humor or critique in the misogynous stereotype that women’s emotional expression is inauthentic or excessive. The audience likely includes those who are aware of or have encountered the 'performative smile' trope, and who may appreciate or be provoked by the sarcastic commentary on gendered expectations in service work.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6db14f4b"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
