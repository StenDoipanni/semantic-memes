    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_10e1dbcf",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_chimpanzee_comparison",
      "label": "Anti-Black Stereotype: Comparing Black People to Primates",
      "description": "The meme relies on the harmful and racist stereotype of equating Black people with apes, which dehumanizes Black individuals by reducing them to a primitive, animalistic state. This stereotype has deep historical roots in racism and is used to justify discrimination and oppression. The text 'Harold, the oldest of all the apes' directly invokes this trope by anthropomorphizing a chimpanzee as if it were a Black person, using the animal as a stand-in for a human group.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2192ebf5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bbb670c0",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_wheelbarrow_pusher",
      "label": "Anti-Black Stereotype: 'Wheelbarrow Pusher' as a Racialized Labor Role",
      "description": "The phrase 'wheelbarrow wheelbarrow pusher' is a degrading and stereotypical reference to Black people being portrayed as only capable of menial, physical labor. This trope is part of a broader pattern of racialized dehumanization that reduces Black individuals to simplistic, demeaning roles, reinforcing systemic racism and economic marginalization. The meme uses this stereotype to mock the idea of a 'wheelbarrow pusher' as a form of escape, which is inherently offensive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2192ebf5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a0cd7432",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_black_stereotype_dehumanization",
      "label": "Anti-Black Stereotype: Dehumanization through Animalization",
      "description": "The meme's humor is built on the dehumanizing trope of portraying Black people as animals, which is a core component of anti-Black racism. By using chimpanzees and calling one 'Harold, the oldest of all the apes,' the meme implicitly equates Black people with apes, reinforcing the idea that they are less than human. This is a harmful and offensive stereotype that has been used historically to justify slavery, segregation, and ongoing systemic racism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2192ebf5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
