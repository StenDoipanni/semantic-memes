    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a2e164f6",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Harold, the oldest of all the apes, is mapped onto a chimpanzee",
      "description": "The text 'harold, the oldest of all the apes' explicitly anthropomorphizes one of the chimpanzees in the image, creating an analogical mapping where the chimpanzee is projected as 'Harold'. This mapping is central to the meme's joke and relies on the harmful anti-Black stereotype of equating Black people with apes.",
      "belongsToAnalysis": {
