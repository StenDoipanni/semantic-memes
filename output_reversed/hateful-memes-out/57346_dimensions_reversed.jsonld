    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_faa6f2ea",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the chimpanzee group scene as the subject of the anthropomorphic narrative",
      "description": "The user is not explicitly projected onto a specific entity via deictic pronouns like 'me' or 'you'. However, the meme's structure invites the user to identify with the fictional narrative and the anthropomorphized chimpanzee 'Harold'. The user is projected onto the scene of the chimpanzee group, specifically onto the role of the 'oldest ape' who escapes, which is a direct analogical mapping onto a human racialized stereotype. The user is invited to imagine themselves as Harold or to identify with the absurdity of the escape scenario, thereby projecting themselves onto the scene and the textual narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_2192ebf5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
