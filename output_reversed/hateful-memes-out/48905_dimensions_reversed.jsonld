      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_19ba4dd3",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the Nazi soldier visual",
      "description": "The user is projected onto the visual of the Nazi soldier, as the meme uses the soldier's image to represent the antisemitic stereotype of 'schwitz' (sweat), and the letter 'u' is superimposed to imply the soldier is 'missing' the 'u' to complete the word. This creates a direct visual and conceptual link between the user and the hateful stereotype being projected. The aggressive pose and weapon of the soldier serve as a deictic marker for the user to associate themselves with the hateful imagery and stereotype.",
      "belongsToAnalysis": {
