      "instance_name": "hand",
      "label": "human hand",
      "description": "A bare hand offering a piece of bread to another hand. The offering hand is positioned on the left side of the image, while the receiving hand is on the right, wearing a knitted glove. The offering hand appears to be of a lighter skin tone, while the receiving hand is partially obscured by the glove, but the visible part suggests a darker skin tone. The gesture is one of giving or sharing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_889addda"
      },
      "extractionMethod": "llm_extraction_huggingface"
