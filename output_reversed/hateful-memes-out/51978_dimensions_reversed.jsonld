    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3f5b854f",
      "@type": "BackgroundKnowledge",
      "instance_name": "compassion",
      "label": "Compassion",
      "description": "The emotional response of sympathy and concern for the suffering of others, often expressed through acts of kindness or charity. The image of offering bread symbolizes this concept, which the text says Jesus values more than memorized scripture.",
      "belongsToAnalysis": {
