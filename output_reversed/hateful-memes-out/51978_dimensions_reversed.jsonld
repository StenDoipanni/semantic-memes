    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1a79e6c6",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "Jesus is mapped onto the act of offering bread",
      "description": "The text refers to 'Jesus' and states that he cares about how people treat others. The visual of a hand offering bread symbolizes compassion and charity, which are core values attributed to Jesus. The mapping is that Jesus (the textual entity) is represented by the act of giving (the visual entity), as the offering of bread is a metaphor for Jesus' teachings on compassion and helping others.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_889addda"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3df662a8",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User is projected onto the receiving hand wearing a knitted glove, symbolizing the recipient of compassion.",
      "description": "The text 'he cares about how you treat people' directly addresses the viewer ('you'), projecting the user onto the role of the person being treated or receiving care, represented visually by the hand in the knitted glove. The user is invited to identify with the recipient of charity, emphasizing the personal responsibility to act compassionately.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_889addda"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fb29d847",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "Christian audience",
      "description": "The meme is designed for individuals who identify as Christian or are familiar with Christian teachings and practices. It references Jesus, the Bible, and religious concepts such as memorizing scripture and practicing compassion, which are central to Christian identity and community. The visual metaphor of bread offering aligns with Christian charitable traditions, making it particularly resonant with this audience.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_889addda"
