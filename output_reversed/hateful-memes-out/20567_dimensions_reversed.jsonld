      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3266dd64",
      "@type": "Scene",
      "instance_name": "damaged_car_scene",
      "label": "damaged_car_scene",
      "description": "A scene depicting a severely damaged silver sedan with a crumpled hood, broken grille, and damaged headlights, isolated against a plain white background. The scene is accompanied by overlaid text that reads 'this is what happens when you don't spank your kids...', using the visual metaphor of the wrecked car to imply a consequence of not using corporal punishment.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e2ec6fa0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fd885067",
      "@type": "BackgroundKnowledge",
      "instance_name": "corporal_punishment_stereotype",
      "label": "Corporal Punishment Stereotype",
      "description": "The meme relies on the outdated and harmful stereotype that physical punishment (spanking) is a necessary or effective method of child discipline, implying that without it, children will become 'out of control' or 'unmanageable' — symbolized by the wrecked car. This stereotype ignores modern child psychology and developmental science that supports non-violent, positive reinforcement methods.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e2ec6fa0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_31d2fa77",
      "@type": "BackgroundKnowledge",
      "instance_name": "parenting_consequence_metaphor",
      "label": "Parenting Consequence Metaphor",
      "description": "The meme uses the metaphor of a car crash to represent the perceived 'consequences' of not using corporal punishment. This is a visual analogy that equates child behavior with mechanical failure, suggesting that without physical discipline, parenting 'fails' catastrophically — a metaphor rooted in fear-based parenting ideologies.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e2ec6fa0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_40b2e7fe",
      "@type": "BackgroundKnowledge",
      "instance_name": "modern_child_development_science",
      "label": "Modern Child Development Science",
      "description": "The meme implicitly contradicts evidence-based child development research that demonstrates physical punishment is ineffective and harmful, leading to increased aggression, anxiety, and poor emotional regulation in children. Understanding this scientific consensus is necessary to recognize the meme's falsehood and harmful intent.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e2ec6fa0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_06265aaa",
      "@type": "BackgroundKnowledge",
      "instance_name": "fear_based_parenting",
      "label": "Fear-Based Parenting",
      "description": "The meme promotes a fear-based approach to parenting, where parents are made to feel guilty or anxious about not using corporal punishment. This is a psychological tactic designed to coerce compliance with outdated practices, using the visual of destruction to evoke fear of 'failure' or 'chaos'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e2ec6fa0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_675b72df",
      "@type": "BackgroundKnowledge",
      "instance_name": "corporal_punishment_myth",
      "label": "Corporal Punishment Myth",
      "description": "The meme perpetuates the myth that corporal punishment is a necessary or effective tool for child discipline. This myth is widely debunked by child psychologists and pediatricians, who argue that non-violent methods are more effective and safer for children's long-term development.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e2ec6fa0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4c0d936f",
      "@type": "EmotionExpression",
      "instance_name": "fear",
      "label": "fear of parental failure",
      "description": "The emotion of fear is expressed through the visual metaphor of a severely damaged car and the accompanying text, which implies that not using corporal punishment leads to catastrophic consequences. This fear is designed to evoke anxiety in parents who do not use physical discipline, suggesting they are failing in their parenting role.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e2ec6fa0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e1192d8e",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The wrecked car is mapped as the consequence of not spanking children",
      "description": "The text 'this is what happens when you don't spank your kids...' explicitly maps the visual entity of the damaged car onto the textual concept of the consequence of not using corporal punishment. The car's severe damage serves as a visual metaphor for the perceived negative outcome, creating an analogical mapping where the car represents the 'result' or 'failure' implied by the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e2ec6fa0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e6b357c9",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message implying personal responsibility for parenting choices",
      "description": "The user is projected onto the textual material 'when you don't spank your kids...' which uses the second-person pronoun 'you'. This directly addresses the viewer, making them the subject of the implied consequence. The user is thus projected onto the textual entity, which frames them as the potential 'culprit' or 'responsible party' for the metaphorical 'car crash' depicted visually. The projection is onto the textual material because the deictic 'you' explicitly targets the user.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e2ec6fa0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d4c35ae7",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme promotes a harmful and outdated parenting ideology that glorifies physical punishment. It normalizes violence as a parenting tool and can influence viewers to adopt punitive measures, potentially causing real-world physical and psychological harm to children. It also perpetuates a dangerous myth that children require physical punishment to be disciplined, ignoring modern, evidence-based child development and psychology research.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e2ec6fa0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fc3427e4",
      "@type": "TargetCommunity",
      "instance_name": "person",
      "label": "parents",
      "description": "The target audience is parents, particularly those who are considering or currently using corporal punishment as a disciplinary method. The meme is designed to evoke fear and guilt in parents who do not spank their children, using the visual metaphor of a wrecked car to suggest that not using physical punishment leads to negative outcomes. The meme relies on the outdated and harmful stereotype that corporal punishment is necessary for effective child discipline, which is a common belief among certain segments of the parenting community that may be influenced by traditional or fear-based parenting ideologies.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e2ec6fa0"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
