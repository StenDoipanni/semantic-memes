    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_ef229590",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The woman is mapped as the target of the abusive insult",
      "description": "The text 'bitch..' at the top and 'shut your ugly crack addict looking, poor white trash ass up' at the bottom directly addresses the woman in the image. The visual of the woman is used as the target onto which the insulting text is projected. Her disdainful expression is juxtaposed with the text to amplify the insult, creating an analogical mapping where the woman is the entity being insulted by the text. The mapping is explicit: the text refers to her as 'bitch' and 'ugly crack addict looking, poor white trash ass', directly mapping her visual appearance and perceived identity to the derogatory labels.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_54a61e0c"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1b97cf3c",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the woman as the target of the abusive insult",
      "description": "The user is projected onto the woman (VisualMaterial entity) as the direct target of the insulting text. The text uses deictic pronouns like 'your' ('your ugly crack addict looking, poor white trash ass') which explicitly directs the insult at the woman, making her the focal point of the user's projection. The user sees themselves as the one delivering the insult, projecting their hostile intent onto the woman's image.",
      "belongsToAnalysis": {
