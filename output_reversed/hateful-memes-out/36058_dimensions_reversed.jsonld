    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_02a5df05",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "love is love mapping to same-sex wedding kiss",
      "description": "The text 'love is love' is overlaid on the image of two women in wedding attire kissing. This mapping equates the romantic and marital expression of love depicted in the visual material (same-sex wedding kiss) with the universal concept of love stated in the text. The meme uses this visual to argue that same-sex love is as valid and worthy of celebration as heterosexual love, thereby mapping the textual affirmation 'love is love' onto the visual representation of same-sex marriage.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_96d11e3d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a628a7d2",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual message affirming equality",
      "description": "The user is projected onto the text 'love is love', which serves as the central rhetorical anchor of the meme. The user is invited to identify with the universal affirmation stated in the text, which is then visually supported by the image of the same-sex wedding kiss. This projection encourages the user to internalize the message of equality and to see the depicted scene as a valid and worthy expression of love, aligning their own perspective with the meme's ideological stance.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_96d11e3d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
