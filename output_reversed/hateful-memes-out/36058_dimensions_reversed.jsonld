    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_08aaf323",
      "@type": "BackgroundKnowledge",
      "instance_name": "LGBTQ_marriage_equality_movement",
      "label": "LGBTQ+ Marriage Equality Movement",
      "description": "The concept of 'love is love' is a slogan and ideological framework used by LGBTQ+ advocates to argue for the equal recognition of same-sex relationships, including marriage, under the law. It is rooted in broader social movements for LGBTQ+ rights and is often used in public discourse to challenge discriminatory laws and societal norms. The meme uses this movement's messaging to equate same-sex marriage with heterosexual marriage, implying moral and legal equivalence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_96d11e3d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_06f5829e",
      "@type": "BackgroundKnowledge",
      "instance_name": "Same_sex_marriage",
      "label": "Same-sex Marriage",
      "description": "The legal and social institution of marriage between two individuals of the same sex. Historically, this was not recognized in many jurisdictions, but has become increasingly accepted and legalized in many countries and U.S. states since the late 20th and early 21st centuries. The image of two women in wedding attire kissing is a visual representation of this institution, which is the central subject of the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_96d11e3d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0d1004d9",
      "@type": "BackgroundKnowledge",
      "instance_name": "Heteronormativity",
      "label": "Heteronormativity",
      "description": "The societal assumption that heterosexuality is the default or 'normal' sexual orientation, and that relationships should be between a man and a woman. The meme implicitly challenges this norm by juxtaposing a same-sex wedding with a heterosexual context (implied by the top image of two men kissing, which may be interpreted as a 'normal' or 'default' romantic scene). The phrase 'love is love' is used to counter heteronormative assumptions.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_96d11e3d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_bb1085d0",
      "@type": "BackgroundKnowledge",
      "instance_name": "LGBTQ_rights_activism",
      "label": "LGBTQ+ Rights Activism",
      "description": "The organized effort by LGBTQ+ individuals and allies to secure equal rights, including legal recognition of same-sex relationships, protection from discrimination, and social acceptance. The meme is a form of visual activism, using imagery and text to promote the message of LGBTQ+ rights and challenge societal stigma. The phrase 'love is love' is a common rallying cry in this movement.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_96d11e3d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_541d3a67",
      "@type": "BackgroundKnowledge",
      "instance_name": "Social_media_activism",
      "label": "Social Media Activism",
      "description": "The use of social media platforms to promote social and political causes, often through memes, hashtags, and viral content. This meme format is a common tool in social media activism, designed to be shareable, emotionally resonant, and to quickly communicate a message to a broad audience. The juxtaposition of images and the slogan 'love is love' are typical of this style of activism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_96d11e3d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_80006f1d",
      "@type": "BackgroundKnowledge",
      "instance_name": "Cultural_representation_of_same_sex_relationships",
      "label": "Cultural Representation of Same-Sex Relationships",
      "description": "The way same-sex relationships are portrayed in media, art, and public life. The image of two women in wedding attire kissing is a positive, celebratory representation that challenges negative or stereotypical portrayals of LGBTQ+ relationships. The meme uses this representation to promote acceptance and normalize same-sex relationships in mainstream culture.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_96d11e3d"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1bad4e02",
      "@type": "BackgroundKnowledge",
      "instance_name": "Meme_as_a_rhetorical_device",
      "label": "Meme as a Rhetorical Device",
      "description": "A meme is a form of communication that uses humor, irony, or juxtaposition to convey a message or argument. In this case, the meme uses the contrast between two images (a casual same-sex kiss and a formal same-sex wedding) to argue that love is inherently equal regardless of gender. The rhetorical device relies on the viewer's understanding of social norms and the symbolic meaning of wedding attire and kissing.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_96d11e3d"
      },
      "extractionMethod": "llm_extraction_huggingface"
