    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_1006070c",
      "@type": "VisualMaterial",
      "instance_name": "two_women_in_wedding_attire",
      "label": "central subjects",
      "description": "Two women, both wearing white wedding dresses and veils, are shown kissing affectionately. Their hair is styled in loose waves, and they are embracing each other. The woman on the left has reddish-brown hair, while the woman on the right has lighter, honey-blonde hair. Their expressions are tender and intimate, suggesting a celebratory or ceremonial context, likely a wedding. They are the focal point of the bottom half of the image.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_96d11e3d"
