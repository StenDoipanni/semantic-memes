    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_8839b899",
      "@type": "AnalogicalMapping",
      "instance_name": "monkey_blood_mapping",
      "label": "monkey is mapped to monkey blood",
      "description": "The text 'monkey blood' is overlaid on the image of a dead monkey with visible blood, creating an analogical mapping where the visual entity (the dead monkey with blood) is explicitly identified or labeled by the textual entity ('monkey blood'). This mapping reinforces the racist trope by equating the visual representation of a dead monkey with the textual label, thereby projecting the concept of 'monkey blood' directly onto the visual material. The mapping is direct and explicit, using the text to categorize or define the visual content.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e893a574"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_dd903a85",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the visual material of the dead monkey",
      "description": "The user is not explicitly projected onto any deictic element (like 'me', 'you') in the text or visual material. However, the meme's overall intent and the visual-textual composition create an implicit projection where the user is positioned as the observer of the disturbing scene, thereby internalizing or being confronted with the hateful stereotype. The user is projected onto the visual material (the dead monkey with blood) as the primary object of the meme's dehumanizing message, which is meant to evoke disgust and reinforce racial prejudice. The user is also implicitly projected onto the textual material ('monkey blood') as the label that categorizes and defines the visual entity, reinforcing the racist trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e893a574"
      },
