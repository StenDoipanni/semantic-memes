    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_a0551b09",
      "@type": "Scene",
      "instance_name": "joke_delivery_scene",
      "label": "man delivering a joke",
      "description": "A man with a cigar in his mouth is positioned centrally, looking directly at the camera, with text overlaid that reads 'you can make jokes about anything, just not illegals that's crossing the border.' The scene interprets the man as the source of the joke, with the text serving as the content of the joke being delivered. The man's serious expression contrasts with the humorous, yet controversial, nature of the text.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aff7e1f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_71ad7306",
      "@type": "BackgroundKnowledge",
      "instance_name": "anti_latino_hispanic_stereotypes",
      "label": "Anti-Latino/Hispanic Stereotypes",
      "description": "The meme relies on the stereotype that Latinos are associated with criminality and illegal immigration, which is a well-documented form of prejudice. The text 'just not illegals that's crossing the border' directly invokes this stereotype, implying that jokes about illegal immigration are taboo, while normalizing the idea that such people are inherently criminal or undesirable. This stereotype is used to provoke a reaction and reinforce a negative narrative about immigrants.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aff7e1f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_efc87e4c",
      "@type": "BackgroundKnowledge",
      "instance_name": "border_crossing_imagery",
      "label": "Border-Crossing Imagery",
      "description": "The phrase 'illegals that's crossing the border' references the common media and political imagery of undocumented immigrants crossing national borders, often depicted as a threat or problem. This imagery is used to evoke fear and reinforce the stereotype that border crossing equals criminality, which is a key element of the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aff7e1f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6e16d2d6",
      "@type": "BackgroundKnowledge",
      "instance_name": "criminality_associations",
      "label": "Criminality Associations",
      "description": "The meme implicitly references the stereotype that immigrants, particularly Latinos, are associated with criminal behavior. This is a common and harmful trope used to justify restrictive immigration policies and to dehumanize immigrant communities. The text 'just not illegals that's crossing the border' implies that these individuals are inherently criminal or dangerous, which is a false and prejudiced assumption.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aff7e1f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_777f2e3c",
      "@type": "BackgroundKnowledge",
      "instance_name": "joke_delivery_scene",
      "label": "Joke Delivery Scene",
      "description": "The scene interprets the man as delivering a joke, which requires understanding the cultural context of humor and satire. The meme uses the juxtaposition of a serious-looking man with a humorous, yet controversial, text to create a comedic effect that is intended to provoke thought or commentary on immigration. The humor is derived from the absurdity of the taboo subject matter, which relies on the audience's knowledge of social norms and political discourse around immigration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aff7e1f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_42353396",
      "@type": "EmotionExpression",
      "instance_name": "sarcasm",
      "label": "sarcastic emotion",
      "description": "The man's serious, slightly surprised facial expression, combined with the juxtaposition of the text 'you can make jokes about anything, just not illegals that's crossing the border,' conveys a sarcastic tone. The humor is derived from the absurdity of the taboo subject matter, implying that the 'joke' is actually a statement of prejudice, and the man's demeanor mocks the idea of a 'joke' being delivered in such a serious context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aff7e1f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_89b3f5fc",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_joke_delivered_by_man",
      "label": "The man is mapped as the source delivering the joke.",
      "description": "The visual entity 'man' is mapped onto the textual entity 'text_chunk_1' (you can make jokes about anything.) as the speaker or source of the joke. The text is presented as if it is being delivered by the man, who is visually positioned as the central figure in the scene. His serious expression and the juxtaposition with the text create an analogical mapping where the man is the 'joke-deliverer' in the context of the meme's narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aff7e1f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_7192c447",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the joke delivery scene",
      "description": "The user is projected onto the scene where the man is delivering the joke, as the meme invites the viewer to imagine themselves in the role of the joke-teller or the audience reacting to the taboo subject matter. The visual of the man with the cigar and the text 'you can make jokes about anything, just not illegals that's crossing the border' creates an implicit address to the viewer, making them part of the joke's context or its intended audience. The humor and provocation are directed at the user's understanding of social norms and political discourse around immigration.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aff7e1f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_945640e9",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme promotes harmful stereotypes by equating illegal immigration with criminality, which can contribute to xenophobia and social division. It normalizes prejudice against immigrant communities, particularly Latinos, by framing jokes about them as taboo, thereby reinforcing a negative, fear-based narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aff7e1f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_d4beb739",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who are familiar with or engaged in political or social discourse surrounding immigration, particularly those who hold or are exposed to anti-Latino/Hispanic stereotypes. The meme is designed to resonate with people who understand the cultural and political context of border-crossing imagery and criminality associations, and who may find humor in the taboo nature of jokes about illegal immigration. The audience is likely to include those who consume internet memes as a form of commentary or satire, and who are aware of the stereotype that Latinos are associated with criminality and illegal immigration. The meme's intent to provoke thought or commentary on immigration suggests that the target audience is politically or socially aware, and may be drawn to the meme for its provocative and inflammatory nature.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_aff7e1f5"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
