    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5cb00e77",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableism_infantilization_stereotype",
      "label": "Ableism Infantilization Stereotype",
      "description": "The stereotype that individuals with developmental disabilities are intellectually limited, childlike, or incapable of complex thought, often leading to infantilizing portrayals in media and society. This is reinforced by the text 'the name's bob... bob', which reduces the person to a repetitive, simplistic self-introduction.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45c5f994"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e75cc262",
      "@type": "BackgroundKnowledge",
      "instance_name": "developmental_disability_reduced_identity",
      "label": "Developmental Disability Reduced Identity Stereotype",
      "description": "The trope that people with developmental disabilities are perceived as lacking individuality or complexity, often portrayed as having names or identities that are repetitive, simplistic, or easily categorized (e.g., 'Bob'). This stereotype reduces their humanity and ignores their capacity for nuanced expression.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45c5f994"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
