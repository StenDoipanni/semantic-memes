    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_96f0d7d4",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Self-identification through infantilizing text",
      "description": "The text 'the name's bob... bob' is mapped onto the visual entity of the man with Down syndrome, creating an analogical mapping where the man is portrayed as a simple, repetitive self-introduction, reinforcing the stereotype of infantilization associated with ableism. The text explicitly labels the visual subject as 'bob', reducing his identity to a simplistic, repetitive name, which is a key element of the ableist trope.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45c5f994"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9ed28705",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the infantilizing self-introduction scene",
      "description": "The user is projected onto the scene where the man with Down syndrome is depicted with the text overlay 'the name's bob... bob', which infantilizes him and reduces his identity to a simplistic, repetitive self-introduction. This creates a semiotic projection where the viewer is implicitly invited to see themselves in the role of the person being infantilized or to perceive the scene as a humorous, simplistic portrayal of disability. The projection is not explicit (e.g., no 'you' or 'me' text), but the framing and the stereotype reinforce a user identification with the infantilized subject or the ableist perspective.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_45c5f994"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
