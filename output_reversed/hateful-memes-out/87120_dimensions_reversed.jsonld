    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4aa066e0",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene through the hateful framing of the meme",
      "description": "The user is not explicitly projected onto a specific visual, textual, or scene element via deictic pronouns like 'you' or 'me'. However, the meme's overall intent and structure create an implicit projection: the viewer is positioned as the recipient of the hateful message, being manipulated into seeing the juxtaposed portraits and text as a coherent, damning narrative about Obama and Islam. The user is thus projected onto the entire scene ('juxtaposed_portraits') as the intended audience for the false equivalence and fear-mongering. The user is implicitly 'you' — the one being shown the 'truth' (according to the meme) that Obama is 'islam's trojan horse' — making the user a passive recipient of the projection.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_42b71f9a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_5ccce553",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Hateful",
      "description": "The meme directly attacks Barack Obama by falsely labeling him as 'islam's trojan horse' and attributing a fabricated quote to him, which is a hateful stereotype that equates Islam with terrorism or extremism. It also falsely equates the Sikh community (represented by the man in the turban) with Islam, using the turban as a visual symbol to reinforce the false association. This is a direct attack on individuals based on their religious identity and political affiliation, promoting Islamophobia and hate.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_42b71f9a"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_264aad3f",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience is individuals who hold or are susceptible to Islamophobic beliefs, particularly those who distrust or fear political figures like Barack Obama, and who may be influenced by conspiracy theories or false narratives about Muslim influence in politics. The meme is designed to appeal to viewers who are already predisposed to view Islam as a threat to Western values, and who may be seeking confirmation of their fears through sensationalized and misleading imagery. The use of the 'Trojan horse' metaphor and the false quote attributed to Obama are intended to resonate with audiences who believe in political deception or hidden agendas. Additionally, the meme may target those who are unfamiliar with Sikh identity or religious symbols, exploiting ignorance to reinforce the false association between Sikhism and Islam. The overall intent is to incite fear and division, particularly among communities that are already politically or culturally polarized.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_42b71f9a"
      },
      "extractionMethod": "llm_extraction_huggingface"
