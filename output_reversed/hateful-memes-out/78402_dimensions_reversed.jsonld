    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e934fb0c",
      "@type": "BackgroundKnowledge",
      "instance_name": "bureaucratic_procedure",
      "label": "Bureaucratic Procedure",
      "description": "The phrase 'state your name for the record' is a standard procedural requirement in formal settings like congressional hearings, legal depositions, or official investigations. The humor arises from the juxtaposition of this serious requirement with the absurd follow-up question 'what page is it on?', implying a person so entrenched in bureaucratic thinking that they forget basic record-keeping. This requires knowledge of how formal proceedings operate and the common expectations around record-keeping.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b7af4fd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_663d8a41",
      "@type": "BackgroundKnowledge",
      "instance_name": "congressional_hearing",
      "label": "Congressional Hearing",
      "description": "The setting and the man's attire, along with the microphone and nameplate ('Hon.') suggest a U.S. congressional hearing. This context is essential to understand the seriousness of the situation and the irony of the question. The meme relies on the viewer recognizing that such hearings are formal, high-stakes events where participants are expected to be knowledgeable and composed.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b7af4fd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_2a229ac8",
      "@type": "BackgroundKnowledge",
      "instance_name": "satirical_juxtaposition",
      "label": "Satirical Juxtaposition",
      "description": "The meme uses satire by placing a serious, formal setting (congressional hearing) with an absurd, bureaucratic question. This requires understanding of satirical humor and the cultural expectation that formal institutions should be efficient and competent, making the character's confusion humorous and critical.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b7af4fd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4c1c8a8c",
      "@type": "BackgroundKnowledge",
      "instance_name": "institutional_competence",
      "label": "Institutional Competence",
      "description": "The meme critiques or mocks perceived incompetence or absurdity in bureaucratic or institutional systems. This requires background knowledge about how institutions are expected to function and the public's tendency to hold them accountable for efficiency and competence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b7af4fd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b205a169",
      "@type": "BackgroundKnowledge",
      "instance_name": "political_figure",
      "label": "Political Figure",
      "description": "The man in the foreground is widely recognized as Robert Mueller, the former special counsel investigating Russian interference in the 2016 U.S. presidential election. His public persona and the context of his hearings (e.g., the Mueller Report) make the meme particularly resonant. The humor stems from the contrast between his serious, authoritative role and the absurdity of the question, which is a commentary on bureaucratic inefficiency or perceived incompetence.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b7af4fd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f0ea0730",
      "@type": "EmotionExpression",
      "instance_name": "bewilderment",
      "label": "bewildered emotion",
      "description": "The man in the foreground displays a facial expression of confusion and bewilderment, with wide eyes and an open mouth as if caught off guard or struggling to comprehend a basic request. This is reinforced by the text overlay asking 'what page is it on?', which humorously implies he is so accustomed to bureaucratic procedures that he forgets the most fundamental record-keeping task.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b7af4fd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_42666d56",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_1",
      "label": "The man in the foreground is mapped as the one who should state his name for the record",
      "description": "The top text 'state your name for the record' is directly addressed to the man in the foreground, who is visually positioned as the speaker at the hearing. The meme implies he is the subject of this procedural request, creating an analogical mapping where the textual instruction is projected onto him as the required actor.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b7af4fd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_77e1a88b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the man in the foreground as the subject of the procedural request",
      "description": "The user is projected onto the man in the foreground (man_in_foreground) because the textual material ('state your name for the record') is directly addressed to him, implying he is the one required to perform the action. The user identifies with the role of the person being asked to comply with the formal procedure, creating a direct projection onto this visual entity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b7af4fd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_df5a83b2",
      "@type": "ToxicityAssessment",
      "instance_name": "toxicity_1",
      "label": "Harmful",
      "description": "The meme humorously implies incompetence or absurdity in bureaucratic or institutional systems, potentially undermining respect for formal processes and authority figures. While not targeting specific protected groups, it could contribute to cynicism or disrespect toward institutional competence, which may be harmful in a societal context.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b7af4fd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fffe0ae2",
      "@type": "TargetCommunity",
      "instance_name": "audience_id",
      "label": "audience description",
      "description": "The target audience consists of individuals familiar with U.S. political processes, particularly congressional hearings, and those who follow or are aware of Robert Mueller's role and the Mueller Report. The meme relies on cultural knowledge of formal bureaucratic procedures and satirical commentary on institutional competence, making it most resonant with viewers who understand the context of high-stakes political hearings and the public perception of bureaucratic inefficiency. The humor is directed at perceived incompetence or absurdity in formal institutions, appealing to an audience that is critical of or cynical toward governmental processes.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_6b7af4fd"
      },
      "extractionMethod": "llm_extraction_huggingface"
    }
  ]
