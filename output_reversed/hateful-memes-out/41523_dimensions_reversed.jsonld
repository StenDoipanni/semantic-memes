    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_64cff566",
      "@type": "BackgroundKnowledge",
      "instance_name": "rock_smoking",
      "label": "Smoking rocks (marijuana)",
      "description": "The phrase 'skip rocks, don't smoke them' implies a misunderstanding or misinterpretation of the word 'rocks'. In real-world context, 'rocks' can refer to the physical stones used in the activity of skipping, but also to marijuana (often called 'pot' or 'weed'), which is commonly smoked. The meme humorously points out the absurdity of someone smoking marijuana instead of skipping stones, using the word 'rocks' as a pun. This requires background knowledge of drug culture and slang terminology.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e9728045"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_005ec633",
      "@type": "BackgroundKnowledge",
      "instance_name": "rock_skipping_activity",
      "label": "The activity of skipping rocks",
      "description": "This is a common recreational activity where people throw flat stones across water to make them skip or bounce. It is a harmless, innocent pastime often associated with childhood or leisure. The meme contrasts this with the more controversial act of smoking marijuana, using the juxtaposition to create humor. Understanding this activity is necessary to interpret the joke.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e9728045"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_0bafbd5c",
