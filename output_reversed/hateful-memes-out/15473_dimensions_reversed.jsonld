    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_3e2e5ff6",
      "@type": "BackgroundKnowledge",
      "instance_name": "ableist_stereotype",
      "label": "Ableist Stereotype",
      "description": "The meme relies on the stereotype that physical disability inherently limits one's capacity for emotional or physical support, which is a harmful ableist trope. This stereotype implies that only able-bodied individuals can meaningfully 'stand by' someone, reinforcing the idea that disability equates to incapacity in supportive roles.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_315f7d87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_82a471a0",
      "@type": "BackgroundKnowledge",
      "instance_name": "inspiration_porn",
      "label": "Inspiration Porn",
      "description": "The meme may be interpreted as perpetuating 'inspiration porn' — a trope that portrays people with disabilities as inspirational solely for their ability to overcome adversity, often in ways that reduce their lived experience to a narrative of pity or admiration rather than recognizing their full humanity and agency.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_315f7d87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b0c6ca8c",
      "@type": "BackgroundKnowledge",
      "instance_name": "pity_narrative",
      "label": "Pity Narrative",
      "description": "The phrase 'I wish I could stand by you!' combined with the visual of a person in a wheelchair may implicitly invoke a pity narrative, where the viewer is encouraged to feel sympathy for the person's physical limitation rather than recognizing their autonomy or the social context of their situation.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_315f7d87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_6650c252",
      "@type": "BackgroundKnowledge",
      "instance_name": "physical_ability_metaphor",
      "label": "Physical Ability as Metaphor for Support",
      "description": "The phrase 'stand by you' is a metaphor for emotional or physical support. The meme uses the literal inability to stand (due to disability) to contrast with the metaphorical meaning, implying that physical ability is a prerequisite for meaningful support — a concept that is not universally true and can be seen as reductive.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_315f7d87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_c702618b",
      "@type": "EmotionExpression",
      "instance_name": "pity",
      "label": "pity emotion",
      "description": "The emotion of pity is conveyed through the juxtaposition of the woman in the wheelchair and the text 'i wish i could stand by you!'. The visual of physical limitation combined with the metaphorical phrase implies a sense of helplessness or sympathy for her inability to provide physical support, potentially invoking a pity narrative.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_315f7d87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_fb339268",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The speaker wishes they could physically support someone, but their disability prevents them from standing.",
      "description": "The text 'i wish i could stand by you!' is mapped onto the visual of the woman in the wheelchair, implying that her physical disability (inability to stand) is the reason she cannot provide the physical support implied by the phrase. This creates an analogical mapping where the woman's physical state is projected as the cause of her inability to fulfill the metaphorical request of 'standing by you'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_315f7d87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_f9eab40b",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the text 'i wish i could stand by you!' which implies a personal, first-person desire. The text directly addresses the viewer as the one who is 'wishing' — creating an implicit 'you' that the user identifies with. The user is thus projected onto the textual material as the speaker of the wish, making the text the focal point of the user's identification with the meme's message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_315f7d87"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
