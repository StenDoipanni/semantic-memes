      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_b70a1a59",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material asserting Native American identity",
      "description": "The user is projected onto the text_chunk 'bitch please i'm native american' because the meme's overall intent is for the user to identify with or adopt the stance expressed in the text — using Native American identity as a shield against criticism. The text explicitly claims 'I'm Native American,' which is a first-person assertion that directly projects the user's identity onto the meme's textual material. The visual material (Native_American_man) serves as a symbolic representation of the identity being claimed, but the projection is semantically anchored in the text, which is the primary site of the user's self-identification in this meme.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_00e42518"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
