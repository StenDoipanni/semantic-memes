    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_50e9f27f",
      "@type": "VisualMaterial",
      "instance_name": "prisoners",
      "label": "people in striped uniforms",
      "description": "A group of individuals wearing striped prison uniforms, characteristic of Nazi concentration camp inmates, standing behind barbed wire. One central figure is gesturing with both hands raised, appearing to be speaking or addressing someone. The group includes men of various ages and physical conditions, some with visible signs of malnutrition or illness. Their expressions range from stoic to slightly amused or defiant. The uniforms are the most salient visual element, immediately signaling the historical context of the Holocaust.",
      "belongsToAnalysis": {
