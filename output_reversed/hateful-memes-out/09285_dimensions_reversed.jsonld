    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_e28d1175",
      "@type": "BackgroundKnowledge",
      "instance_name": "Holocaust_denial_minimization_themes",
      "label": "Holocaust denial/minimization themes",
      "description": "The act of downplaying, denying, or trivializing the Holocaust, often by reducing its gravity to a joke or comparing it to trivial events. The meme's text 'when the squad is about to get lit..' directly equates the suffering of Holocaust victims with a party scenario, which is a form of historical minimization.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4870eb5f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_543bef9d",
      "@type": "BackgroundKnowledge",
      "instance_name": "Dark_humor",
      "label": "Dark humor",
      "description": "Humor derived from morbid, tragic, or taboo subjects. The meme uses dark humor to juxtapose the horrific context of the Holocaust with a casual party scenario, which is offensive and disrespectful to victims.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4870eb5f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_91037701",
      "@type": "BackgroundKnowledge",
      "instance_name": "Historical_revisionism",
      "label": "Historical revisionism",
      "description": "The act of reinterpreting or rewriting history, often to fit a particular narrative or to downplay its significance. The meme represents historical revisionism by equating the suffering of Holocaust victims with a party, thereby distorting the historical record.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4870eb5f"
      },
      "extractionMethod": "llm_extraction_huggingface"
