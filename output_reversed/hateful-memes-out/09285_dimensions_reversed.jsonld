    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_44d45453",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_001",
      "label": "The prisoners are mapped as 'the squad' about to get lit.",
      "description": "The text 'when the squad is about to get lit..' is overlaid on an image of prisoners in striped uniforms. This creates an analogical mapping where the group of prisoners (visual entity) is being equated with 'the squad' (textual entity), and their situation is being humorously likened to a group of friends preparing to party and get intoxicated. This mapping is deeply offensive as it trivializes the horrific historical context of the Holocaust by equating it with a casual social activity.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4870eb5f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_9675af62",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the scene of prisoners waiting behind barbed wire",
      "description": "The user is projected onto the scene of prisoners waiting behind barbed wire, as the meme's text 'when the squad is about to get lit..' implies the user (or their social circle) is about to engage in a party scenario. The visual material of the prisoners is being used as a metaphor for the user's 'squad' preparing to party, creating a semiotic projection where the user identifies with the group of prisoners in the image as their 'squad' about to get lit. This projection is metaphorical and relies on the analogical mapping between the prisoners and the 'squad', without explicit deictic pronouns like 'me' or 'you'.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_4870eb5f"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
