      "@id": "http://example.org/multimodal-taxonomy#dimension_a21d5700",
      "@type": "BackgroundKnowledge",
      "instance_name": "sea_monkeys_stereotype",
      "label": "Sea Monkeys Stereotype",
      "description": "The term 'sea monkeys' refers to a fictional, cartoonish, and often exoticized stereotype that reduces dark-skinned people to an animal-like or non-human identity. This stereotype is used in the meme to demean and dehumanize the children in the image by mislabeling them as 'sea monkeys,' which is a racially charged and offensive trope. The term 'sea monkeys' is not a real biological entity but a cultural reference to a derogatory racial stereotype.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_e2d0b639"
