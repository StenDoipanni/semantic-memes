    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_4fef5889",
      "@type": "AnalogicalMapping",
      "instance_name": "mapping_id_1",
      "label": "Children are mapped as 'sea monkeys'",
      "description": "The overlaid text 'sea monkeys' is directly juxtaposed with the visual of Black children playing in water. This creates an analogical mapping where the children are being equated with 'sea monkeys', a derogatory racial stereotype. The mapping is explicit through the text's placement over the image, visually associating the children's appearance and activity with the offensive term. This is a harmful dehumanizing metaphor rooted in anti-Black racism.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_260a1889"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
    {
      "@id": "http://example.org/multimodal-taxonomy#dimension_66f8d33c",
      "@type": "SemioticProjection",
      "instance_name": "semiotic_projection_1",
      "label": "User projected onto the textual material",
      "description": "The user is projected onto the text 'sea monkeys' as the primary target of the meme's hateful intent. The text explicitly labels the visual scene with a derogatory racial stereotype, forcing the viewer to confront the dehumanizing metaphor. The projection is not deictic (e.g., 'you' or 'me') but rather implicit through the meme's structure: the user is positioned as the one interpreting the harmful mapping between the children and the term 'sea monkeys', thereby internalizing or being confronted with the racist message.",
      "belongsToAnalysis": {
        "@id": "http://example.org/multimodal-taxonomy#analysis_260a1889"
      },
      "extractionMethod": "llm_extraction_huggingface"
    },
