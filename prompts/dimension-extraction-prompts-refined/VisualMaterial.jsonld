{
  "@context": {
    "@vocab": "http://example.org/multimodal-taxonomy#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#"
  },
  "@id": "VisualMaterial",
  "@type": "owl:Class",
  "rdfs:subClassOf": "Dimension",
  "dimensionIndex": 1,
  "rdfs:comment": "Visual Material includes: people, objects, characters, scenes, graphics, and any salient visual elements.",
  "rdfs:label": "Visual Material",
  "promptExtractionText": "Task 1: Identify all recognizable entities in image. Return JSON array: [{\"instance_name\": \"entity_name\", \"label\": \"entity description\", \"description\": \"entity details and saliency\"}]."
}
