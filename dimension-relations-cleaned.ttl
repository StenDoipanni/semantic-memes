@prefix meme: <http://example.org/meme#> .


# ========================================
# CORE DIMENSIONS - Meme frame
# ========================================

meme:Meme meme:hasVisualMaterial meme:VisualMaterial .
meme:Meme meme:hasTextualMaterial meme:TextualMaterial .
meme:Meme meme:hasBackgroundKnowledge meme:BackgroundKnowledge .
meme:Meme meme:hasScene meme:Scene .
meme:Meme meme:hasEmotion meme:Emotion .
meme:Meme meme:hasMetadata meme:Metadata .
meme:Meme meme:hasAnalogicalMapping meme:AnalogicalMapping .
meme:Meme meme:hasOverallIntent meme:OverallIntent .
meme:Meme meme:hasSemioticInterpretation meme:SemioticInterpretation .
meme:Meme meme:hasTargetCommunity meme:TargetCommunity .
meme:Meme meme:hasTemplateStructure meme:TemplateStructure .
meme:Meme meme:hasToxicity meme:Toxicity .
meme:Meme meme:hasColorComposition meme:ColorComposition .


# ========================================
# CORE DIMENSIONS - Foundation
# ========================================

# VisualMaterial relations
meme:VisualMaterial meme:visualComponentOf meme:Meme .
meme:VisualMaterial meme:roleOf meme:Scene .
meme:VisualMaterial meme:hasColor meme:Color .

# TextualMaterial relations
meme:TextualMaterial meme:textualComponentOf meme:Meme .

# BackgroundKnowledge relations
meme:BackgroundKnowledge meme:referredIn meme:VisualMaterial . # example: "the image of Bill Cosby"
meme:BackgroundKnowledge meme:referredIn meme:TextualMaterial . # example: "the text 'when you see Bill Cosby'"
meme:BackgroundKnowledge meme:referredIn meme:Scene . # example: "a man telling another man <<try this bat meat, what could go wrong?>> --> ref to Covid-19"


# Scene relations
meme:Scene meme:hasRole meme:VisualMaterial . # example: "distracted boyfriend situation hasRole boyfriend"
meme:Scene meme:augmentedBy meme:TextualMaterial . # example: "distracted boyfriend situation augmentedBy text <<when you're a Linux user and you see a new distro>>"
meme:Scene meme:refersTo meme:BackgroundKnowledge . # example: Lego reproduction of an existing meme template, or some real-world event happened in the past
meme:Scene meme:expressorOf meme:Emotion . # example: "distracted boyfriend situation expressorOf <<concern>>"

# ========================================
# CORE TO ADDITIONAL DIMENSIONS
# ========================================

# VisualMaterial to Additional
meme:VisualMaterial meme:hasColor meme:Color .
meme:VisualMaterial meme:expresses meme:Emotion .
meme:VisualMaterial meme:roleOf meme:AnalogicalMapping .
meme:VisualMaterial meme:projectedElementOf meme:SemioticInterpretation .
meme:VisualMaterial meme:vehicleOf meme:Toxicity .

# TextualMaterial to Additional
meme:TextualMaterial meme:roleOf meme:AnalogicalMapping .
meme:TextualMaterial meme:projectedElementOf meme:SemioticInterpretation .
meme:TextualMaterial meme:vehicleOf meme:Toxicity .
meme:TextualMaterial meme:expresses meme:Emotion .

# BackgroundKnowledge to Additional
meme:BackgroundKnowledge meme:projectedElementOf meme:SemioticInterpretation .
meme:BackgroundKnowledge meme:roleOf meme:AnalogicalMapping .


# Scene to Additional
meme:Scene meme:expresses meme:Emotion .
meme:Scene meme:settingFor meme:AnalogicalMapping .
meme:Scene meme:conformsTo meme:TemplateStructure .

# ========================================
# ADDITIONAL DIMENSION INTER-RELATIONS
# ========================================

# ColorComposition relations
meme:ColorComposition meme:includesColor meme:Color .
meme:Color meme:colorOf meme:VisualMaterial .
meme:Color meme:colorOf meme:TextualMaterial .
meme:ColorComposition meme:expresses meme:Emotion .
meme:ColorComposition meme:augments meme:TemplateStructure .


# Emotion relations
meme:Emotion meme:expressedsVia meme:VisualMaterial .
meme:Emotion meme:expressedsVia meme:TextualMaterial .
meme:Emotion meme:expressedVia meme:Scene .


# Metadata relations
meme:Metadata meme:providesContext meme:OverallIntent .
meme:Metadata meme:refersTo meme:BackgroundKnowledge .
meme:Metadata meme:augments meme:TextualMaterial .
meme:Metadata meme:augments meme:VisualMaterial .

# AnalogicalMapping relations
meme:AnalogicalMapping meme:hasRole meme:VisualMaterial .
meme:AnalogicalMapping meme:hasRole meme:TextualMaterial .
meme:AnalogicalMapping meme:groundedIn meme:Scene .


# OverallIntent relations
meme:OverallIntent meme:relatedTo meme:BackgroundKnowledge .
meme:OverallIntent meme:relatedTo meme:TargetCommunity .
meme:OverallIntent meme:contains meme:Toxicity .

# SemioticInterpretation relations
meme:SemioticInterpretation meme:hasProjectedEntity meme:VisualMaterial .
meme:SemioticInterpretation meme:hasProjectedEntity meme:TextualMaterial .
meme:SemioticInterpretation meme:hasProjectedEntity meme:Scene .
meme:SemioticInterpretation meme:hasProjectedUser meme:User .
meme:SemioticInterpretation meme:hasProjectedCommunity meme:TargetCommunity .
meme:User meme:progectsOnto owl:Thing .

meme:projectsOnto a owl:ObjectProperty ;
    rdfs:domain meme:User ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (meme:VisualMaterial meme:TextualMaterial meme:Scene)
    ] .

# TargetCommunity relations
meme:TargetCommunity meme:referredIn meme:TextualMaterial .
meme:TargetCommunity meme:referredIn meme:VisualMateria .
meme:TargetCommunity meme:impactedBy meme:OverallIntent .
meme:TargetCommunity meme:projectedElementOf meme:SemioticInterpretation .


# TemplateStructure relations
meme:TemplateStructure meme:organizes meme:VisualMaterial .
meme:TemplateStructure meme:organizes meme:VisualMaterial .
meme:TemplateStructure meme:organizes meme:Scene .
meme:TemplateStructure meme:augmentedBy meme:ColorComposition .


# Toxicity relations
meme:Toxicity meme:expressedsVia meme:VisualMaterial .
meme:Toxicity meme:expressedsVia meme:TextualMaterial .
meme:Toxicity meme:expressedsVia meme:Scene .
meme:Toxicity meme:expressedVia meme:AnalogicalMapping .
meme:Toxicity meme:triggers meme:Emotion .
meme:Toxicity meme:augments meme:OverallIntent .
meme:Toxicity meme:hasTarget meme:TargetCommunity .
